{
  "kind": "tool-rows",
  "record_set": "check-a-public-address-tool-rows",
  "what_this_is": "The Workshop row for the tool in tools/check-a-public-address: asks one public address and judges the answer against the expectations given with it.",
  "records": [
    {
      "id": "package::check-a-public-address::tool::check-a-public-address",
      "address": "package::check-a-public-address::tool::check-a-public-address",
      "path": [
        "current-item",
        "published-record"
      ],
      "payload": {
        "kind": "ai-tool-descriptor",
        "status": "active",
        "id": "tool:check-a-public-address",
        "label": "Check a public address against what it should say",
        "job": "Ask one public HTTP or HTTPS address and say whether its answer meets the expectations given: the status, text that must appear, and a value at a JSON path. Any check that needs a public page or a public JSON answer uses it.",
        "description": "Requests one public address through the public-address guard: a private, loopback, link-local or metadata address is refused before any connection, and every redirect is judged again. Returns the status, content type, body size, a capped text excerpt (2,000 characters), ok, and failed: the list of expectations that did not hold ('status', 'contains:<marker>', 'json_path' when the path is missing or the body is not JSON, 'equals'). A refused or failed request returns ok false, failed ['request'] and the reason in error.",
        "input_schema": {
          "type": "object",
          "required": [
            "url"
          ],
          "additionalProperties": false,
          "properties": {
            "url": {
              "type": "string",
              "minLength": 8
            },
            "expect": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "status": {
                  "type": "integer"
                },
                "contains": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "json_path": {
                  "type": "string",
                  "pattern": "^\\$"
                },
                "equals": {}
              }
            }
          }
        },
        "output_schema": {
          "type": "object",
          "required": [
            "url",
            "status",
            "ok",
            "failed"
          ],
          "properties": {
            "url": {
              "type": "string"
            },
            "status": {
              "type": [
                "integer",
                "null"
              ]
            },
            "content_type": {
              "type": [
                "string",
                "null"
              ]
            },
            "body_bytes": {
              "type": "integer"
            },
            "excerpt": {
              "type": "string"
            },
            "ok": {
              "type": "boolean"
            },
            "failed": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "error": {
              "type": "string"
            }
          }
        },
        "result_selector": "$",
        "invoke": {
          "kind": "container",
          "internet": true,
          "public_read": true,
          "workdir": "/work",
          "stdout": "json",
          "argv": [
            "/usr/local/bin/node",
            "/opt/check-a-public-address-tree/tools/check-a-public-address/do-work/check-a-public-address.mjs"
          ],
          "stdin": {
            "fill": {
              "from": "input"
            }
          },
          "files": {
            "package_files": [
              {
                "package": "run-sql-in-my-database",
                "paths": ["do-work/through-the-run-proxy.mjs"],
                "at": "/opt/check-a-public-address-tree/tools/run-sql-in-my-database"
              },
              {
                "package": "check-a-public-address",
                "paths": [
                  "do-work/check-a-public-address.mjs"
                ],
                "at": "/opt/check-a-public-address-tree/tools/check-a-public-address"
              },
              {
                "package": "http-client",
                "paths": [
                  "do-work/node-public-fetch.mjs",
                  "do-work/resolved-address.mjs",
                  "do-work/resolved-address.json",
                  "do-work/same-origin.mjs"
                ],
                "at": "/opt/check-a-public-address-tree/tools/http-client"
              },
              {
                "package": "refuse-requests-to-private-addresses",
                "paths": [
                  "public-address.mjs",
                  "public-address.json"
                ],
                "at": "/opt/check-a-public-address-tree/tools/refuse-requests-to-private-addresses"
              },
              {
                "packages": [
                  "node_modules/tldts"
                ],
                "at": "/opt/node_modules/tldts"
              },
              {
                "packages": [
                  "node_modules/tldts-core"
                ],
                "at": "/opt/node_modules/tldts-core"
              }
            ]
          }
        },
        "needs": {
          "expected_seconds": 30,
          "network_egress": true,
          "memory_mb": 128
        },
        "licence_class": "licence:maker-own",
        "placements": [
          "placement:small-container"
        ],
        "maker": "maker:check-a-public-address",
        "provenance": {
          "source": "Written for the Workshop: one generic public-address check (status, markers, JSON path) on the existing public-address guard, for any check that reads a public answer"
        },
        "verify": [
          {
            "kind": "sample-run",
            "input": {
              "url": "https://page.example/",
              "expect": {
                "status": 200
              }
            },
            "output_selector": "$.status",
            "contains": "200"
          }
        ]
      }
    }
  ]
}
