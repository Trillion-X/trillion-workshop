        "kind": "ai-tool-descriptor",
        "id": "tool:turn-my-agent-skills-into-workflows",
        "label": "Turn my agent skills into workflows my AI can find and run",
        "status": "active",
        "job": "Take the agent skills I have installed (the rows of my agent-skills list) and make each one a workflow in my own account, leaving out any skill that names a secret key, a folder on my computer, an email address, a phone number or one of my private words",
        "description": "Takes the rows of the person's own agent-skills list (input.records, record:agent-skill; a long file is several rows, joined in order) and answers each clean skill as a workflow. A skill is a folder holding a SKILL.md with a name and a description. Each skill whose text is clean becomes one workflow: a row whose id is workflow: then skill- then the skill's name and one step whose instructions are the skill's, with its text files (smallest first, within a size budget) under files; the answer's workflows hold those rows (a record:workflow-recipe row and a record:workflow-step row each) for the caller's AI to write where the person keeps workflows. A skill whose SKILL.md or shipped files match a secret key, a computer path, an email address, a phone number, or a word in input.private_words stays home, and the answer names it and the kind of reason, never the text. Put the workflow rows already kept (record:workflow-recipe) in input.records too and a workflow made from a skill that is now gone or held back is named under stale. input.folder keeps only skills under that folder. This run reads only the records handed in and keeps nothing. What is screened and the size budget are data (data/skill-import-rules.json), not code.",
        "input_schema": {
          "type": "object",
          "required": ["records"],
          "properties": {
            "records": {
              "type": "array",
              "description": "What the store that holds them returned, each { id, type, value }: the rows of the agent-skills list (record:agent-skill) and, to name workflows whose skill is gone, the workflow rows already kept (record:workflow-recipe). Read them from the store's own tool server; this tool keeps nothing and reads nothing else.",
              "items": { "type": "object", "required": ["id", "type", "value"], "properties": { "id": { "type": "string" }, "type": { "type": "string" }, "value": {} } }
            },
            "private_words": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Words naming your private people, businesses or systems; a skill holding one stays home."
            },
            "folder": {
              "type": "string",
              "description": "Only skills whose folder is under this path (as the skills list records it)."
            }
          }
        },
        "output_schema": {
          "type": "object",
          "required": [
            "made",
            "home",
            "workflows",
            "stale"
          ],
          "properties": {
            "made": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "The workflow ids made (workflow: then skill- then the skill's name)."
            },
            "workflows": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["id", "rows"],
                "properties": {
                  "id": { "type": "string" },
                  "rows": { "type": "array", "description": "The workflow's rows, each { id, type, value }: its step row and its recipe row." }
                }
              },
              "description": "Each workflow made, with the rows that hold it, for the caller's AI to write where the person keeps workflows."
            },
            "home": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "skill": {
                    "type": "string"
                  },
                  "reasons": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              },
              "description": "Skills left out, each with the reasons (never the text)."
            },
            "stale": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Workflows already kept (from the workflow rows handed in) whose skill is gone or held back."
            }
          }
        },
        "invoke": {
          "kind": "container",
          "argv": [
            "node",
            "/opt/workflows/do-work/run-a-function.mjs",
            "/opt/turn-a-folder-of-agent-skills-into-workflows/read-data/skills-into-workflows.mjs",
            "turnSkillsIntoWorkflows"
          ],
          "stdin": {
            "input": {
              "fill": {
                "from": "input"
              }
            }
          },
          "files": {
            "package_files": [
              {
                "package": "turn-a-folder-of-agent-skills-into-workflows",
                "paths": [
                  "read-data/skills-into-workflows.mjs",
                  "data/skill-import-rules.json"
                ],
                "at": "/opt/turn-a-folder-of-agent-skills-into-workflows"
              },
              {
