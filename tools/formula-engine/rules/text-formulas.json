    { "name": "COUNTIF", "aliases": ["COUNT_IF"], "op": "op:core.array_count_if", "input": 0, "args": { "where": { "chain": 1, "binds": ["item_var"] } }, "example": { "text": "COUNTIF(scores, |s| => s >= 5)", "row": { "scores": [3, 5, 8] }, "value": 2 } },
    { "name": "FILTER", "op": "op:core.filter_where", "input": 0, "args": { "predicate": { "chain": 1, "binds": ["item_var"] } }, "example": { "text": "FILTER(people, |p| => p.age > 3)", "row": { "people": [{ "age": 2 }, { "age": 7 }] }, "value": [{ "age": 7 }] } },
