    { "name": "ARRAY_GET", "aliases": ["ARRAYGET", "NTH"], "op": "op:core.array_get", "input": 0, "args": { "index": 1 }, "example": { "text": "ARRAY_GET(tags, 1)", "row": { "tags": ["red", "blue"] }, "value": "blue" } },
