        "kind": "ai-tool-descriptor",
        "id": "tool:keep-measurements-current",
        "label": "Collect current measurement coverage",
        "job": "Discover operation catalogs, source revisions and execution receipts, then return current neutral measurement observations and forecast coverage",
        "description": "Takes the source configuration in the request (config, the measurement_source_config value the caller read from its store), resolves bounded source and receipt roots plus the configured meter book, and collects with a freshly returned provider-qualified price book. Reads and keeps nothing in the person's rows. New operations under those roots are discovered automatically. Receipt content and source, meter and price revisions are pinned. Missing values, unknown meters, failed work, missing prices, unconfigured roots and incomplete discovery stay unknown. The scheduled workflow persists returned history through the measurement-ledger owner.",
        "status": "active",
        "input_schema": {
          "type": "object",
          "required": [
            "action",
            "config"
          ],
          "properties": {
            "action": {
              "type": "string",
              "enum": [
                "collect_from_config"
              ]
            },
            "config": {
              "type": "object",
              "description": "The source configuration (the measurement_source_config value, schema measurement-source-config/1), read by the caller from its store"
            },
            "prices": {
              "type": "object",
              "required": [
                "source_revision",
                "observed_at",
                "prices"
              ],
              "properties": {
                "source_revision": {
                  "type": "string"
                },
                "observed_at": {
                  "type": "string"
                },
                "prices": {
                  "type": "array",
                  "items": {
                    "type": "object"
                  }
                }
              }
            },
            "prior": {
              "type": [
                "object",
                "null"
              ]
            },
            "limits": {
              "type": "object"
            },
            "measure_self": {
              "type": "boolean"
            }
          }
        },
        "output_schema": {
          "type": "object"
        },
        "invoke": {
          "kind": "computer",
          "workdir": "/work",
          "stdout": "json",
          "run": [
            "node",
            "/opt/keep-measurements-current/do-work/keep-measurements-current.mjs",
            {
              "fill": {
                "from": "task",
                "field": "grants.read-a-folder.folder"
              }
            }
          ],
          "stdin": {
            "fill": {
              "from": "input"
            }
          },
          "files": {
            "package_files": [
              {
                "package": "keep-measurements-current",
                "paths": [
                  "do-work",
                  "read-data"
                ],
                "at": "/opt/keep-measurements-current"
              },
              {
                "package": "measurement-ledger",
                "paths": [
                  "read-data/ledger.mjs",
                  "read-data/aggregation.mjs",
                  "do-work/ledger-tool.mjs"
                ],
                "at": "/opt/measurement-ledger"
              },
              {
                "package": "content-identity",
                "paths": [
                  "read-data"
                ],
                "at": "/opt/content-identity"
              },
              {
                "packages": [
                  "node_modules/@noble/hashes"
                ],
                "paths": [
                  "LICENSE",
                  "package.json",
                  "blake3.js",
                  "blake2.js",
                  "_blake.js",
                  "_md.js",
                  "_u64.js",
                  "utils.js"
                ],
                "at": "/opt/node_modules/@noble/hashes"
              },
              {
                "package": "browse-and-upload-my-files",
                "paths": [
                  "built-stored-bytes/content-chunks/content_chunks.js",
                  "do-work/content-chunks.mjs",
                  "do-work/namespace-client.mjs",
                  "do-work/send-a-file-to-a-namespace.mjs",
                  "do-work/send-retry.mjs",
                  "do-work/send-window.mjs",
                  "do-work/shared-file-reference.mjs",
                  "send-settings.json"
                ],
                "at": "/opt/browse-and-upload-my-files"
              },
              {
                "package": "query-and-change-list-rows",
                "paths": [
                  "src/list-aggregates.mjs"
                ],
                "at": "/opt/node_modules/trillion-workshop/tools/query-and-change-list-rows"
              },
              {
                "package": "keep-and-wake-ai-sessions-on-this-computer",
                "paths": [
                  "src/lists.json"
                ],
                "at": "/opt/node_modules/trillion-workshop/tools/keep-and-wake-ai-sessions-on-this-computer"
              },
              {
                "package": "formula-engine",
                "paths": [
                  "rules",
                  "built-stored-bytes/formula-engine"
                ],
                "at": "/opt/node_modules/trillion-workshop/tools/formula-engine"
              }
            ]
          },
          "capabilities": [
            "read-a-folder"
          ]
        },
        "result_selector": "$.result",
        "needs": {
          "expected_seconds": 5,
          "network_egress": false,
          "memory_mb": 128
        },
        "licence_class": "licence:maker-own",
        "placements": [
          "placement:your-computer"
        ],
        "maker": "maker:keep-measurements-current",
        "provenance": {
          "source": "Generic source/package revisions and execution receipts reconciled against current meter and price DATA; content identities use the Workshop BLAKE3 owner."
        },
