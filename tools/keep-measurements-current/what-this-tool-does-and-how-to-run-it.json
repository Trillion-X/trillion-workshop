                },
                "price_book": {
                  "source_tool": "tool:refresh-provider-prices"
                }
              },
              "prices": {
                "source_revision": "made-up-book-1",
                "observed_at": "2026-11-01",
                "prices": []
              }
            },
            "files": [
              {
                "grant": "read-a-folder",
                "path": "source/what-this-tool-does-and-how-to-run-it.json",
                "text": "{\"kind\":\"tool-rows\",\"records\":[{\"payload\":{\"kind\":\"ai-tool-descriptor\",\"id\":\"tool:sample-operation\"}}]}"
              },
              {
                "grant": "read-a-folder",
                "path": "receipts/.keep",
                "text": ""
              }
            ]
          }
        ]
