{
  "kind": "tool-rows",
  "record_set": "pull-from-connected-accounts-tool-rows",
  "what_this_is": "The Workshop rows for pulling a person's messages and saved items from the services they use into their own records, one row per service, all running one mechanism in tools/pull-from-connected-accounts; plus one row that reads back what was pulled. A service is one JSON description in read-data/sources/; the person's token reaches the one process on a private pipe and is never in the request.",
  "records": [
    {
      "payload": {
        "kind": "ai-tool-descriptor",
        "id": "tool:pull-my-discord-messages",
        "label": "Pull the messages from the Discord text channels my bot can read into my own records",
        "job": "Pull the messages from the Discord text channels my bot can read into my own records",
        "description": "Reads the text and announcement channels of every server the bot is in (only those the bot may view and read the history of), newest messages first, and keeps them in your records beside the ones already there: a message pulled twice is kept once, an edited message replaces the older copy, and a renamed channel takes its new title. The bot cannot read anyone's personal direct messages, and a message's text is empty unless the bot has the Message Content setting. Give account (a name for this account, default \"default\"), and optionally limit, most_pages, most_threads. The held Discord bot token (name discord-bot-token) reaches the one process on a private pipe; it is never shown, printed or stored in your records. Answers status (pulled; partial when some requests failed; needs_login when Discord did not accept the token; unreachable), how many new messages or items arrived, the cursor, and any failed requests in errors. Read what was pulled with tool:read-what-i-pulled-from-an-account.",
        "status": "active",
        "input_schema": {
          "type": "object",
          "additionalProperties": false,
          "required": [],
          "properties": {
            "account": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120,
              "description": "A name that tells this account from your other accounts on the same service (for example work). Default: default."
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 500,
              "description": "How many messages or items to ask for in one request."
            },
            "most_pages": {
              "type": "integer",
              "minimum": 1,
              "maximum": 20,
              "description": "How many pages of one conversation or list to read."
            },
            "most_threads": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200,
              "description": "At most this many conversations are read in one pull."
            }
          }
        },
        "output_schema": {
          "type": "object",
          "required": [
            "source",
            "account",
            "status",
            "said"
          ],
          "properties": {
            "source": {
              "type": "string"
            },
            "account": {
              "type": "string"
            },
            "status": {
              "type": "string",
              "enum": [
                "pulled",
                "partial",
                "needs_login",
                "unreachable"
              ]
            },
            "self_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "threads": {
              "type": "integer"
            },
            "items": {
              "type": "integer"
            },
            "new_messages": {
              "type": "integer"
            },
            "new_items": {
              "type": "integer"
            },
            "cursor": {},
            "errors": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "said": {
              "type": "string"
            }
          }
        },
        "invoke": {
          "kind": "container",
          "internet": true,
          "workdir": "/opt/pull-from-connected-accounts",
          "stdout": "json",
          "argv": [
            "node",
            "/opt/records-door/do-work/run-an-export.mjs",
            "/opt/pull-from-connected-accounts/do-work/pull.mjs",
            "pullDiscord"
          ],
          "stdin": {
            "fill": {
              "from": "input"
            }
          },
          "files": {
            "package_files": [
              {
                "package": "pull-from-connected-accounts",
                "paths": [
                  "do-work",
                  "read-data"
                ],
                "at": "/opt/pull-from-connected-accounts"
              },
              {
                "package": "records-door",
                "paths": [
                  "do-work",
                  "read-data"
                ],
                "at": "/opt/records-door"
              },
              {"package": "content-identity", "paths": ["read-data"], "at": "/opt/content-identity"},
              {"module": "@noble/hashes", "paths": ["LICENSE", "package.json", "blake3.js", "blake2.js", "_blake.js", "_md.js", "_u64.js", "utils.js"], "at": "/opt/node_modules/@noble/hashes"}
            ]
          },
          "records": {
            "fd": 3,
            "rights": [
              {
                "kind": "account-snapshot-part",
                "prefix": "account-snapshot:",
                "operations": [
                  "records:list",
                  "records:write"
                ]
              }
            ]
          },
          "credential_mounts": [
            {
              "secret_name": "discord-bot-token",
              "fd": 4
            }
          ]
        },
        "result_selector": "$.result",
        "needs": {
          "expected_seconds": 60,
          "network_egress": true
        },
        "maker": "maker:pull-from-connected-accounts",
        "licence_class": "licence:maker-own",
        "placements": [
          "placement:your-computer"
        ],
        "provenance": {
          "source": "bitfield-packages connector for this service (snapshot fold, cursor, paging), merged into one source description and ported"
        }
      }
    },
