         "utils.js"
        ],
        "at": "/opt/node_modules/@noble/hashes"
       }
      ]
     },
     "workdir": "/opt/check-against-a-persons-rules-and-verdicts",
     "internet": false,
     "stdout": "json",
     "argv": [
