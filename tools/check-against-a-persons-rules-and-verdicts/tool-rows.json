   "payload": {
    "kind": "ai-tool-descriptor",
    "id": "tool:check-against-a-persons-rules-and-verdicts",
    "label": "Check words or anything made against a person's own rules and verdicts",
    "status": "active",
    "job": "Check words, a title, a script line or a plan against a person's own rules and the verdicts they already gave, and say pass, fail or uncertain for each, with why",
    "description": "Give the units to check (each { text, kind } or { view, kind } for JSON such as a plan, with optional facts, field, context and findings you already have), rules (rule rows judge-words runs, and ask rows a model answers), and the person's own rule document (verdict_rules) and stands (stances, as tool:read-where-you-stand gives them), read at run time from their records or files. Their exact stand on a thing decides first: disagree fails, partly holds at review and fails at final, agree passes and clears the generic rules they named. Then their stated rows fail and their inferred rows (at_most uncertain) only hold. Nothing passes on silence: a thing nothing of theirs judges is novel, and an ask row never passes without a calibrated answer. The answer lists the questions a model may answer, by id; send the answers back in answers to use them. Nothing about any person is built in.",
    "input_schema": {
     "type": "object",
     "required": [
      "rules",
      "units"
     ],
     "additionalProperties": false,
     "properties": {
      "rules": {
       "type": "array",
       "minItems": 1,
       "items": {
        "type": "object",
        "required": [
         "id"
        ]
       },
       "description": "Rule rows: judge-words rows (see tool:judge-against-rules), each optionally with held_when ({ path, where } over a unit's facts: its findings there only hold), or ask rows { id, kinds?, says, ask: { question, options, fail, at_most?, calibration: { status, t_pass, t_fail } } }"
      },
      "units": {
       "type": "array",
       "minItems": 1,
       "items": {
        "type": "object",
        "required": [
         "kind"
        ],
        "properties": {
         "text": {
          "type": "string"
         },
         "view": {},
         "kind": {
          "type": "string"
         },
         "field": {
          "type": "string"
         },
         "path": {
          "type": "array"
         },
         "facts": {
          "type": "object",
          "description": "Facts a row's when and held_when read, such as where the words came from"
         },
         "context": {},
         "context_requires_review": {
          "type": "boolean"
         },
         "also_found": {
          "type": "array",
          "items": {
           "type": "object",
           "required": [
            "rule",
            "outcome"
           ]
          },
          "description": "Findings you already have for this unit, each with outcome fail or uncertain"
         },
         "where": {
          "type": "string"
         }
        }
       },
       "description": "The things to check"
      },
      "verdict_rules": {
       "type": "object",
       "description": "The person's rule document: rows (judge-words rule rows; a row with part reads a part of a thing as another kind; a row with ask is a reading row a model answers), fold (how two texts are one text), stage.default (review or final), stance_rule and novel (the ids and words of the findings their stands and silence make) and agree_clears.rules (the generic rules their agree clears)",
       "required": [
        "rows",
        "fold",
        "stage",
        "stance_rule",
        "novel",
        "agree_clears"
       ]
      },
      "stands": {
       "type": "array",
       "items": {
        "type": "object",
        "required": [
         "artifact",
         "stance"
        ],
        "description": "One stand, as tool:read-where-you-stand gives it: kind, artifact (1f: identity), text, contains or view, stance (agree, disagree, partly, or null when taken back), why (their own words) and at",
        "properties": {
         "kind": {
          "type": [
           "string",
           "null"
          ]
         },
         "artifact": {
          "type": "string"
         },
         "text": {
          "type": "string"
         },
         "contains": {
          "type": "string"
         },
         "view": {},
         "stance": {
          "type": [
           "string",
           "null"
          ]
         },
         "why": {
          "type": [
           "string",
           "null"
          ]
         },
         "at": {
          "type": [
           "string",
           "null"
          ]
         }
        }
       },
       "description": "Where the person stands on things already made"
      },
      "stands_as_of": {
       "type": "string",
       "description": "When the stands were read, if they were read from a copy and not live"
      },
      "stage": {
       "type": "string",
       "enum": [
        "review",
        "final"
       ],
       "description": "review holds what final fails; the rule document's stage.default when left out"
      },
      "fields_by_kind": {
       "type": "object",
       "description": "The field a unit of a kind is judged as, when the unit names none"
      },
      "answers": {
       "type": "object",
       "description": "A model's answers by question id: { option: probability }"
      }
     }
    },
    "output_schema": {
     "type": "object",
     "required": [
      "status",
      "passed",
      "results",
      "questions",
      "lines"
     ],
     "properties": {
      "status": {
       "type": "string",
       "enum": [
        "unqualified",
        "failed",
        "uncertain",
        "passed"
       ]
      },
      "passed": {
       "type": "boolean"
      },
      "results": {
       "type": "array",
       "items": {
        "type": "object",
        "required": [
         "verdict",
         "breaks",
         "uncertain",
         "advisory",
         "qualification"
        ]
       }
      },
      "questions": {
       "type": "array",
       "items": {
        "type": "object",
        "required": [
         "id",
         "rule",
         "question",
         "options",
         "text"
        ]
       }
      },
      "lines": {
       "type": "array",
       "items": {
        "type": "string"
       }
      }
     }
    },
    "invoke": {
     "kind": "container",
     "files": {
      "package_files": [
       {
        "package": "check-against-a-persons-rules-and-verdicts",
        "paths": [
