{
  "about": "Files moved here from Trillion-X/trillion by #76 (a9ee2580). Each matched file names its source path and commit and the BLAKE3 identity of its source bytes and of its bytes here. not_matched lists files #76 adapted or renamed, so no source file holds their exact bytes; their sources are under the old capability row's owner paths in sources.",
  "source": "Trillion-X/trillion",
  "package": "trillion-workshop",
  "calls": [
    {
      "id": "a-work-address-made-up",
      "find": "work@gmail\\.com",
      "replace": "work@example.com",
      "means": "An example account address shaped like a real one; made up on example.com."
    },
    {
      "id": "a-personal-address-made-up",
      "find": "personal@gmail\\.com",
      "replace": "personal@example.com",
      "means": "An example account address shaped like a real one; made up on example.com."
    },
    {
      "id": "a-home-folder-made-relative",
      "find": "[/]Users[/]br[i]anakhtar[/]",
      "replace": "",
      "means": "A path in the maker's home folder, written from the home folder instead."
    },
    {
      "id": "owner-home-folder",
      "find": "[/]Users[/]b[r]ianakhtar",
      "replace": "/workspace/the-owner",
      "means": "A person's home folder name in a path, swapped for a made-up one: a public tree holds made-up data only."
    }
  ],
