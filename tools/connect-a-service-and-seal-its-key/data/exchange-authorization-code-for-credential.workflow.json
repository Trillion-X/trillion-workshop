{
  "type": "record",
  "address": "package::service-connections::workflow-action::exchange-authorization-code",
  "address_mode": "identity_text",
  "path": ["current-item", "published-record", "workflow-definition"],
  "payload": {
    "id": "action:exchange-authorization-code-for-credential",
    "kind": "action",
    "is_active": true,
    "name": "exchange-authorization-code-for-credential",
    "description": "Finish a service sign-in after the service returns approval. The app keeps access private and returns only the account name and private access reference.",
    "input_schema": { "required": ["acquire", "code", "redirect_uri_encoded"] },
    "steps": [
      {
        "id": "read_decoder_script",
        "kind": "read",
        "config": { "from": "package::http-client::stored-bytes::decode-http-response-script" }
      },
      {
        "id": "read_client_handle",
        "kind": "ask",
        "config": {
          "name": "slot::credentials-vault",
          "input": {
            "operation": "read",
            "key": {
              "$kind": "binding",
              "select": { "from": "input", "path": "acquire.client_ref" },
              "transform": [{ "op": "op:core.replace", "args": { "find": "credentials-vault::", "replace": "" } }]
            },
            "handle_ttl_seconds": 300
          }
        }
      },
      {
        "id": "resolve_client",
        "kind": "ask",
        "config": {
          "name": "slot::credentials-vault",
          "input": {
            "operation": "resolve_handle",
            "handle": {
              "$kind": "binding",
              "select": { "from": "steps", "key": "read_client_handle", "path": "output.handle" }
            }
          }
        }
      },
      {
        "id": "client_not_configured",
        "kind": "fail",
        "config": {
          "error": "This connector is not configured on this computer."
        }
      },
      {
        "id": "client_no_longer_available",
        "kind": "fail",
        "config": {
          "error": "This connector's saved sign-in setup is no longer available. Reconnect the service to continue."
        }
      },
      {
        "id": "exchange",
        "kind": "ask",
        "config": {
          "name": "slot::http-client",
          "input": {
            "url": {
              "$kind": "binding",
              "select": { "from": "input", "path": "acquire.token_url" },
              "transform": [
                {
                  "op": "op:core.concat",
                  "args": {
                    "values": [
                      { "$kind": "binding", "select": { "from": "input", "path": "acquire.token_url" } },
                      "?grant_type=authorization_code&code=",
                      { "$kind": "binding", "select": { "from": "input", "path": "code" } },
                      "&redirect_uri=",
                      { "$kind": "binding", "select": { "from": "input", "path": "redirect_uri_encoded" } },
                      "&client_id=",
                      {
                        "$kind": "binding",
                        "select": { "from": "steps", "key": "resolve_client", "path": "output.value" },
                        "transform": [
                          { "op": "op:core.json_parse" },
                          { "op": "op:core.get_path", "args": { "path": { "$kind": "binding", "select": { "from": "input", "path": "acquire.client_document_path" } } } },
                          { "op": "op:core.lookup", "args": { "key": "client_id" } }
                        ]
                      },
                      "&client_secret=",
                      {
                        "$kind": "binding",
                        "select": { "from": "steps", "key": "resolve_client", "path": "output.value" },
                        "transform": [
                          { "op": "op:core.json_parse" },
                          { "op": "op:core.get_path", "args": { "path": { "$kind": "binding", "select": { "from": "input", "path": "acquire.client_document_path" } } } },
                          { "op": "op:core.lookup", "args": { "key": "client_secret" } }
                        ]
                      }
                    ]
                  }
                }
              ]
            },
            "method": "POST",
            "headers": { "content-type": "application/x-www-form-urlencoded" },
            "body": [],
            "credential_injections": [],
            "timeout_ms": 20000
          }
        }
      },
      {
        "id": "decode_exchange",
        "kind": "ask",
        "config": {
          "name": "compute.process",
          "input": {
            "argv": ["python3", "do-work/process-scripts/decode-http-response.py", "json", "response.json", "decoded.json"],
            "cwd": null,
            "timeout_ms": 30000,
            "termination_grace_ms": 1000,
            "expected_termination": null,
            "env": {},
            "inputs": [
              {
                "mount_path": "response.json",
                "content_type": "application/json",
                "source": {
                  "kind": "inline",
                  "bytes": {
                    "$kind": "binding",
                    "select": { "from": "steps", "key": "exchange", "path": "output" },
                    "transform": [{ "op": "op:core.stringify", "args": { "format": "json" } }, { "op": "op:core.encode", "args": { "encoding": "base64" } }]
                  }
                }
              },
              {
                "mount_path": "do-work/process-scripts/decode-http-response.py",
                "content_type": "text/x-python",
                "source": {
                  "kind": "blob_ref",
                  "hash": { "$kind": "binding", "select": { "from": "steps", "key": "read_decoder_script", "path": "output.content_hash" } }
                }
              }
            ],
            "input_trees": [],
            "outputs": [{ "mount_path": "decoded.json", "content_type": "application/json" }],
            "containment": { "kind": "leaf" },
            "capture_fds": [1, 2],
            "collected_files": []
          }
        }
      },
      {
        "id": "identity",
        "kind": "ask",
        "config": {
          "name": "slot::http-client",
          "input": {
            "url": { "$kind": "binding", "select": { "from": "input", "path": "acquire.identity.userinfo_url" } },
            "method": "GET",
            "headers": {
              "authorization": {
                "$kind": "binding",
                "select": { "from": "steps", "key": "decode_exchange", "path": "output.outputs.0.bytes.base64" },
                "transform": [
                  { "op": "op:core.decode", "args": { "encoding": "base64" } },
                  { "op": "op:core.json_parse" },
                  { "op": "op:core.lookup", "args": { "key": "access_token" } },
                  { "op": "op:core.concat", "args": { "prefix": "Bearer " } }
                ]
              }
            },
            "body": [],
            "credential_injections": [],
            "timeout_ms": 15000
          }
        }
      },
      {
        "id": "decode_identity",
        "kind": "ask",
        "config": {
          "name": "compute.process",
          "input": {
            "argv": ["python3", "do-work/process-scripts/decode-http-response.py", "json", "response.json", "decoded.json"],
            "cwd": null,
            "timeout_ms": 30000,
            "termination_grace_ms": 1000,
            "expected_termination": null,
            "env": {},
            "inputs": [
              {
                "mount_path": "response.json",
                "content_type": "application/json",
                "source": {
                  "kind": "inline",
                  "bytes": {
                    "$kind": "binding",
                    "select": { "from": "steps", "key": "identity", "path": "output" },
                    "transform": [{ "op": "op:core.stringify", "args": { "format": "json" } }, { "op": "op:core.encode", "args": { "encoding": "base64" } }]
                  }
                }
              },
              {
                "mount_path": "do-work/process-scripts/decode-http-response.py",
                "content_type": "text/x-python",
                "source": {
                  "kind": "blob_ref",
                  "hash": { "$kind": "binding", "select": { "from": "steps", "key": "read_decoder_script", "path": "output.content_hash" } }
                }
              }
            ],
            "input_trees": [],
            "outputs": [{ "mount_path": "decoded.json", "content_type": "application/json" }],
            "containment": { "kind": "leaf" },
            "capture_fds": [1, 2],
            "collected_files": []
          }
        }
      },
      {
        "id": "resource_identity",
        "kind": "ask",
        "config": {
          "name": "slot::http-client",
          "input": {
            "url": { "$kind": "binding", "select": { "from": "input", "path": "acquire.identity.resource_collections.0.url" } },
            "method": "GET",
            "headers": {
              "authorization": {
                "$kind": "binding",
                "select": { "from": "steps", "key": "decode_exchange", "path": "output.outputs.0.bytes.base64" },
                "transform": [
                  { "op": "op:core.decode", "args": { "encoding": "base64" } },
                  { "op": "op:core.json_parse" },
                  { "op": "op:core.lookup", "args": { "key": "access_token" } },
                  { "op": "op:core.concat", "args": { "prefix": "Bearer " } }
                ]
              }
            },
            "body": [],
            "credential_injections": [],
            "timeout_ms": 15000
          }
        }
      },
      {
        "id": "decode_resource_identity",
        "kind": "ask",
        "config": {
          "name": "compute.process",
          "input": {
            "argv": ["python3", "do-work/process-scripts/decode-http-response.py", "json", "response.json", "decoded.json"],
            "cwd": null,
            "timeout_ms": 30000,
            "termination_grace_ms": 1000,
            "expected_termination": null,
            "env": {},
            "inputs": [
              {
                "mount_path": "response.json",
                "content_type": "application/json",
                "source": {
                  "kind": "inline",
                  "bytes": {
                    "$kind": "binding",
                    "select": { "from": "steps", "key": "resource_identity", "path": "output" },
                    "transform": [{ "op": "op:core.stringify", "args": { "format": "json" } }, { "op": "op:core.encode", "args": { "encoding": "base64" } }]
                  }
                }
              },
              {
                "mount_path": "do-work/process-scripts/decode-http-response.py",
                "content_type": "text/x-python",
                "source": {
                  "kind": "blob_ref",
                  "hash": { "$kind": "binding", "select": { "from": "steps", "key": "read_decoder_script", "path": "output.content_hash" } }
                }
              }
            ],
            "input_trees": [],
            "outputs": [{ "mount_path": "decoded.json", "content_type": "application/json" }],
            "containment": { "kind": "leaf" },
            "capture_fds": [1, 2],
            "collected_files": []
          }
        }
      },
      {
        "id": "seal_token",
        "kind": "ask",
        "config": {
          "name": "slot::credentials-vault",
          "input": {
            "operation": "write",
            "key": {
              "$kind": "binding",
              "select": { "from": "steps", "key": "decode_identity", "path": "output.outputs.0.bytes.base64" },
              "transform": [
                { "op": "op:core.decode", "args": { "encoding": "base64" } },
                { "op": "op:core.json_parse" },
                { "op": "op:core.get_path", "args": { "path": { "$kind": "binding", "select": { "from": "input", "path": "acquire.identity.label_path" }, "transform": [{ "op": "op:core.join", "args": { "delimiter": "." } }] } } },
                { "op": "op:core.lower" },
                { "op": "op:core.replace", "args": { "find": "@", "replace": "-at-" } },
                { "op": "op:core.replace", "args": { "find": ".", "replace": "-" } },
                { "op": "op:core.replace", "args": { "find": "+", "replace": "-" } },
                { "op": "op:core.concat", "args": { "prefix": { "$kind": "binding", "select": { "from": "input", "path": "acquire.store.vault_key" }, "transform": [{ "op": "op:core.concat", "args": { "suffix": "--" } }] } } }
              ]
            },
            "value": {
              "$kind": "binding",
              "select": { "from": "steps", "key": "decode_exchange", "path": "output.outputs.0.bytes.base64" },
              "transform": [
                { "op": "op:core.decode", "args": { "encoding": "base64" } },
                { "op": "op:core.concat", "args": { "prefix": "{\"tokens\":", "suffix": "}" } }
              ]
            }
          }
        }
      },
      {
        "id": "done",
        "kind": "return",
        "config": {
          "value": {
            "account_label": {
              "$kind": "binding",
              "select": { "from": "steps", "key": "decode_identity", "path": "output.outputs.0.bytes.base64" },
              "transform": [
                { "op": "op:core.decode", "args": { "encoding": "base64" } },
                { "op": "op:core.json_parse" },
                { "op": "op:core.get_path", "args": { "path": { "$kind": "binding", "select": { "from": "input", "path": "acquire.identity.label_path" }, "transform": [{ "op": "op:core.join", "args": { "delimiter": "." } }] } } }
              ]
            },
            "resource_id": {
              "$kind": "binding",
              "select": { "from": "steps", "key": "decode_resource_identity", "path": "output.outputs.0.bytes.base64" },
              "transform": [
                { "op": "op:core.decode", "args": { "encoding": "base64" } },
                { "op": "op:core.json_parse" },
                { "op": "op:core.get_path", "args": { "path": { "$kind": "binding", "select": { "from": "input", "path": "acquire.identity.resource_collections.0.primary_ref_path" }, "transform": [{ "op": "op:core.join", "args": { "delimiter": "." } }] } } }
              ]
            },
            "credential_handle_ref": {
              "$kind": "binding",
              "select": { "from": "steps", "key": "decode_identity", "path": "output.outputs.0.bytes.base64" },
              "transform": [
                { "op": "op:core.decode", "args": { "encoding": "base64" } },
                { "op": "op:core.json_parse" },
                { "op": "op:core.get_path", "args": { "path": { "$kind": "binding", "select": { "from": "input", "path": "acquire.identity.label_path" }, "transform": [{ "op": "op:core.join", "args": { "delimiter": "." } }] } } },
                { "op": "op:core.lower" },
                { "op": "op:core.replace", "args": { "find": "@", "replace": "-at-" } },
                { "op": "op:core.replace", "args": { "find": ".", "replace": "-" } },
                { "op": "op:core.replace", "args": { "find": "+", "replace": "-" } },
                { "op": "op:core.concat", "args": { "prefix": { "$kind": "binding", "select": { "from": "input", "path": "acquire.store.vault_key" }, "transform": [{ "op": "op:core.concat", "args": { "suffix": "--" } }] } } }
              ]
            }
          }
        }
      }
    ],
    "edges": [
      { "from": "read_decoder_script", "to": "read_client_handle", "kind": "on_result" },
      {
        "from": "read_client_handle",
        "to": "resolve_client",
        "kind": "on_result",
        "config": {
          "$kind": "binding",
          "select": { "from": "input", "path": "output.handle" },
          "transform": [{ "op": "op:core.is_not_null" }]
        }
      },
      {
        "from": "read_client_handle",
        "to": "client_not_configured",
        "kind": "on_result",
        "config": {
          "$kind": "binding",
          "select": { "from": "input", "path": "output.handle" },
          "transform": [{ "op": "op:core.is_null" }]
        }
      },
      {
        "from": "resolve_client",
        "to": "exchange",
        "kind": "on_result",
        "config": {
          "$kind": "binding",
          "select": { "from": "input", "path": "output.success" },
          "transform": [{ "op": "op:core.equals", "args": { "value": true } }]
        }
      },
      {
        "from": "resolve_client",
        "to": "client_no_longer_available",
        "kind": "on_result",
        "config": {
          "$kind": "binding",
          "select": { "from": "input", "path": "output.success" },
          "transform": [{ "op": "op:core.equals", "args": { "value": false } }]
        }
      },
      { "from": "exchange", "to": "decode_exchange", "kind": "on_result" },
      { "from": "decode_exchange", "to": "identity", "kind": "on_result" },
      { "from": "identity", "to": "decode_identity", "kind": "on_result" },
      { "from": "decode_identity", "to": "resource_identity", "kind": "on_result" },
      { "from": "resource_identity", "to": "decode_resource_identity", "kind": "on_result" },
      { "from": "decode_resource_identity", "to": "seal_token", "kind": "on_result" },
      { "from": "seal_token", "to": "done", "kind": "on_result" }
    ]
  },
  "payload_text": null,
  "payload_base64": null,
  "remove": false
}
