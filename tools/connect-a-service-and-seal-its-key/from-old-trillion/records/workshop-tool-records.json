              "items": {
                "type": "string"
              },
              "description": "Counted prices to add to the subscription when it does not carry them yet"
            },
            "report": {
              "type": "array",
              "description": "One day's counts",
              "items": {
                "type": "object",
                "required": [
                  "event_name",
                  "value",
                  "identifier"
                ],
                "additionalProperties": false,
                "properties": {
                  "event_name": {
                    "type": "string",
                    "description": "The meter's event name"
                  },
                  "value": {
                    "type": "integer",
                    "minimum": 1,
                    "description": "Whole units above what the plan includes"
                  },
                  "identifier": {
                    "type": "string",
                    "description": "One identifier per subscription, meter and day, so a day is counted once"
                  },
                  "timestamp": {
                    "type": "integer",
                    "description": "Seconds since 1970 of the day counted"
                  }
                }
              }
            },
            "allocation_offer_id": {
              "type": "string",
              "minLength": 1
            }
          }
        },
