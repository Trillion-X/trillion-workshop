// test/secret-references.test.mjs
//
// A request names a secret that lives elsewhere and the host resolves it just before sending (computer/secret-references.mjs:
// F-0520): a real command and a real local web provider, a memory-only cache with a lifetime, an abortable lookup, and no value
// in any error.
import test from 'node:test';
import assert from 'node:assert/strict';
import http from 'node:http';
import { mkdtempSync, readFileSync } from 'node:fs';
import { tmpdir } from 'node:os';
import { join } from 'node:path';
import { makeSecretResolver, secretSettings } from '../computer/secret-references.mjs';
import { scrubValues } from '../parts/http-client/do-work/request-scopes.mjs';

const VALUE = 'S3CR3T-FROM-ELSEWHERE';
const base = secretSettings();

async function webProvider() {
  let calls = 0;
  const server = http.createServer((request, reply) => {
    calls += 1;
    if (request.headers['x-token'] !== 'tok') return reply.writeHead(403).end();
    if (request.url.endsWith('/slow')) return;
    reply.writeHead(200, { 'content-type': 'application/json' }).end(JSON.stringify({ data: { data: { value: `${VALUE}:${request.url.split('/').pop()}` } } }));
  });
  await new Promise(done => server.listen(0, '127.0.0.1', done));
  return { server, port: server.address().port, calls: () => calls };
}

const settingsWith = (providers, extra = {}) => ({ ...base, providers, ...extra });

test('a command provider runs with the path in its argv and the value is its output, kept in memory for its lifetime only', async () => {
  let clock = 1000;
  const settings = settingsWith([{ id: 'cmd', kind: 'command', argv: [process.execPath, '-e', "process.stdout.write(process.argv[1] + '-value\\n')", '{path}'] }], { cache_ms: 5000 });
  const resolver = makeSecretResolver({ settings, now: () => clock });
  assert.equal(await resolver.resolve('secret://cmd/vault/item'), 'vault/item-value');
  const second = resolver.resolve('secret://cmd/vault/item');
  clock += 4000;
  assert.equal(await second, 'vault/item-value');
  // Count real runs: each run appends one byte to a file.
  const log = join(mkdtempSync(join(tmpdir(), 'secret-runs-')), 'runs');
  const counting = settingsWith([{ id: 'cmd', kind: 'command', argv: [process.execPath, '-e', "require('node:fs').appendFileSync(process.argv[1], 'x'); process.stdout.write('v')", log] }], { cache_ms: 5000 });
  const counted = makeSecretResolver({ settings: counting, now: () => clock });
  await counted.resolve('secret://cmd/a');
  await counted.resolve('secret://cmd/a');
  assert.equal(readFileSync(log, 'utf8'), 'x', 'the second ask came from memory');
  clock += 6000;
  await counted.resolve('secret://cmd/a');
  assert.equal(readFileSync(log, 'utf8'), 'xx', 'after its lifetime it is asked again');
});

test('a web provider is asked with its header from the environment, the secret is read from the answer, and a reference inside a request is replaced and listed for masking', async () => {
  const web = await webProvider();
  try {
    const settings = settingsWith([{ id: 'vault', kind: 'http', url: `http://127.0.0.1:${web.port}/v1/{path}`, headers: { 'x-token': '{env:VAULT_TOKEN_FOR_TEST}' }, extract: 'data.data.value' }]);
    const resolver = makeSecretResolver({ settings, env: { VAULT_TOKEN_FOR_TEST: 'tok' } });
    const { value, placed } = await resolver.resolveAll({ headers: { authorization: 'Bearer secret://vault/db', again: 'secret://vault/db' }, plain: 'unchanged' });
    assert.deepEqual(value, { headers: { authorization: `Bearer ${VALUE}:db`, again: `${VALUE}:db` }, plain: 'unchanged' });
    assert.equal(web.calls(), 1, 'one lookup for the same reference');
    assert.deepEqual(scrubValues(value, placed), { headers: { authorization: 'Bearer [held value]', again: '[held value]' }, plain: 'unchanged' });
    const missing = makeSecretResolver({ settings, env: {} });
    await assert.rejects(missing.resolve('secret://vault/db'), error => /needs the environment variable VAULT_TOKEN_FOR_TEST/.test(error.message) && error.retry === false);
    const refused = makeSecretResolver({ settings, env: { VAULT_TOKEN_FOR_TEST: 'wrong' } });
    await assert.rejects(refused.resolve('secret://vault/db'), error => error.status === 502 && error.retry === true && !error.message.includes('wrong'));
  } finally { web.server.close(); }
});

test('a lookup can be stopped: the call is cancelled, the stop is reported, and nothing is cached from it', async () => {
  const web = await webProvider();
  try {
    const settings = settingsWith([{ id: 'vault', kind: 'http', url: `http://127.0.0.1:${web.port}/{path}`, headers: { 'x-token': 'tok' }, extract: 'data.data.value' }]);
    const resolver = makeSecretResolver({ settings });
    const stop = new AbortController();
    const pending = resolver.resolve('secret://vault/slow', { signal: stop.signal });
    setTimeout(() => stop.abort(), 100);
    await assert.rejects(pending, error => /was stopped/.test(error.message));
    assert.equal(await resolver.resolve('secret://vault/fast'), `${VALUE}:fast`);
    const already = new AbortController(); already.abort();
    await assert.rejects(resolver.resolve('secret://vault/other', { signal: already.signal }), /was stopped/);
  } finally { web.server.closeAllConnections(); web.server.close(); }
});

test('an unknown provider, a malformed reference and an empty answer are refused in words that carry no value', async () => {
  const resolver = makeSecretResolver({ settings: settingsWith([{ id: 'cmd', kind: 'command', argv: [process.execPath, '-e', '0'] }]) });
  await assert.rejects(resolver.resolve('secret://nobody/x'), /no secret provider named nobody/);
  await assert.rejects(resolver.resolve('not a reference'), /not a secret reference/);
  await assert.rejects(resolver.resolve('secret://cmd/x'), /gave nothing/);
  assert.equal(base.providers.length, 0, 'the shipped list is empty');
});
