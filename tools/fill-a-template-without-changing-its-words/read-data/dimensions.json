  "readers": {
    "_what": "Readers turn one measurement file into records. They are the only per-format code; a dimension picks a reader and a field.",
    "transcript_words": {
      "what": "A word-timed transcript JSON: one record per spoken word (text, speaker, duration), plus 'speech-summary' (wpm).",
      "needs": [],
      "detect": {
        "suffix": [
          ".json"
        ],
        "keys": [
          "words"
        ]
      },
      "default_medium": "video"
    },
    "segment_captions": {
      "what": "Timestamped local caption text: [seconds] text, [seconds.fraction] text, or [minutes:seconds] text. Times identify caption segments, not individual word times; speaker identity is not inferred.",
      "needs": [],
      "detect": {
        "suffix": [
          ".txt"
        ]
      },
      "default_medium": "video"
    },
    "json3_captions": {
      "what": "Original JSON3 caption events. Reported text only; event times, display offsets, window metadata and annotations stay in provenance. Overlapping event text is not silently deduplicated; no word timing or speaker identity is inferred.",
      "needs": [],
      "detect": {
        "suffix": [
          ".json3"
        ]
      },
      "default_medium": "video"
    },
    "tsv_rows": {
      "what": "A table with a header row (.tsv): one record per row = one structural unit; every column is a field, plus duration. A row does not by itself prove one physical take or edit. Rows without an id column get ids `<id_prefix>-NN` in order.",
      "needs": [],
      "detect": {
        "suffix": [
          ".tsv"
        ]
      },
      "default_medium": "video",
      "id_prefix": "row"
    },
    "post_json": {
      "what": "A post JSON as a public-post service returns it: paragraphs, links, mentions, hashtags, media, alt text, posting day and hour.",
      "needs": [],
      "detect": {
        "suffix": [
          ".json"
        ],
        "keys": [
          "raw_text"
        ]
      },
      "default_medium": "text-post"
    },
    "ocr_images": {
      "what": "a folder of slide images: tesseract TSV per image; one record per text block (text, box, line height) and one unit record per slide (order, size).",
      "needs": [
        "tesseract"
      ],
      "detect": {
        "dir_of": [
          ".png",
          ".jpg",
          ".jpeg",
          ".webp"
        ]
      },
      "default_medium": "carousel"
    },
    "html_json_records": {
      "what": "Authored records in an explicitly selected inert application/json script block in an HTML source. Records retain ids, fields and optional authored seconds; no scripts execute and no rendered visibility or spoken timing is inferred.",
      "needs": []
    }
  },
  "moment_spans": {
    "_what": "A slot fill whose source is one of the person's recorded moments keeps where that moment plays ({clip, from, to, media} on the fill), so a filled format can be cut from the person's own recordings. A source is a moment when it cites a time range of a word-timed transcript (path@<from>-<to>s; the words spoken inside the range are what the value is checked against, read by transcript_words; the clip is the stem of the media file the transcript names under transcript_media_key), a time range of the recording itself (the file stem is the clip; its words cannot be read here, so the value is marked not checked) or one row of a TSV whose header holds tsv_columns (path:<line>). Any other source (a capability listing line, a URL, a commit) is not a moment and carries no span.",
    "transcript_media_key": "source",
    "tsv_columns": {
      "clip": "clip",
      "from": "start_s",
      "to": "end_s",
      "media": "original_path"
    }
  },
  "slot_rules": {
    "_what": "Automatic slot rules for dimensions with auto_slot_rules. README 'Slot rules' explains each. Explicit spec slots and spec keeps win over these.",
    "auto": [
      {
        "id": "R1-number",
        "type": "NUMBER",
        "note": "a number the creator said or wrote",
        "test": "has_digit_or_number_word"
      },
      {
        "id": "R2-product",
        "type": "PRODUCT",
        "note": "the product's own name (spec product_names)",
        "test": "product_phrase"
      },
      {
        "id": "R4-name",
        "type": "NAME",
        "note": "a capitalised word inside a sentence (a name, place or title); every other occurrence of the same word follows",
        "test": "capital_mid_sentence"
      }
    ],
