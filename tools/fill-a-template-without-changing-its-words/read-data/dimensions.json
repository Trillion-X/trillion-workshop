{
  "schema": "word-template-dimensions@1",
  "_what": "Every dimension a template token can carry. A token is {id, unit, region, t?, dims: {dimension_id: value}, mark: KEEP | SLOT (+ slot, slot_type, slot_note)}. Adding a dimension = adding a row here. make_template.py fills a dimension when one of its 'measure' entries names a reader that has data for the piece; otherwise the dimension is listed as pending with the entry's method as the reason. A measure may set optional_if_reader_not_declared=true; pending is suppressed only when every measure is explicitly optional and each referenced reader is absent from the piece's sources. A declared but unavailable source remains pending (or fails when required); a readable source with no qualifying field values remains pending unless that source separately declares allow_empty=true. drift.py judges a dimension by its value_kind. A dimension or value kind drift.py does not know is reported, never dropped.",
  "value_kinds": {
    "_what": "A value kind is a comparator made from data: pair (how template and target values are lined up: sequence = difflib over the values, order = first with first, time = nearest in time within the dimension's tolerance_s) and test (equal after normalising, or distance with a metric under the dimension's drift.max). A new kind is a new row; a new metric is the only thing that needs code (wt_ops.METRICS).",
    "text": {
      "pair": "sequence",
      "test": "equal",
      "split": "words",
      "what": "words; difflib on normalised words"
    },
    "category": {
      "pair": "sequence",
      "test": "equal",
      "what": "one value from a list or a comma list; difflib on normalised values"
    },
    "number": {
      "pair": "order",
      "test": "distance",
      "metric": "abs_or_rel",
      "what": "a number with a unit; pass when |a-b| <= drift.max (or <= drift.rel x a)"
    },
    "event": {
      "pair": "time",
      "test": "equal_if",
      "what": "a timed event; pass when a target event is within drift.tolerance_s (and has the same value when drift.match_value)"
    },
    "box": {
      "pair": "order",
      "test": "distance",
      "metric": "one_minus_iou",
      "what": "[x, y, w, h] as fractions of the canvas; pass when 1 - IoU <= drift.max"
    },
    "colour": {
      "pair": "order",
      "test": "distance",
      "metric": "cie76",
      "what": "#rrggbb; pass when CIE76 delta-E <= drift.max"
    },
    "vector": {
      "pair": "order",
      "test": "distance",
      "metric": "euclidean",
      "what": "a list of numbers (a taste or smell profile, an embedding); pass when euclidean distance <= drift.max"
    }
  },
  "media": {
