        "label": "Reconcile lines against a statement",
        "job": "Close a set of cleared lines against a statement with any difference explained in words, keep a receipt of each close, find lines changed or removed after they were closed, and undo the last close",
        "description": "action close takes lines { amount_field, closed_in_field? }, row_ids, period, opening_balance, statement_balance, request_key and residual_reason when the lines do not add up to the statement; it marks each line closed in the receipt and keeps the receipt in \"<lines>-reconciliations\". The same request_key returns the same receipt; a line already closed elsewhere is refused. check lists every line that changed or was removed after its close (record: true keeps each as a discrepancy row once). undo reopens the lines of the latest close and marks its receipt undone; the receipt stays.",
        "input_schema": {
          "type": "object",
          "required": [
            "action",
            "list_id",
            "lines_kind"
          ],
          "properties": {
            "action": {
              "type": "string",
              "enum": [
                "close",
                "check",
                "undo"
              ]
            },
            "list_id": {
              "type": "string",
              "minLength": 1,
              "description": "The list in the request: the source (or the lines, or the row's list) when the body leaves its own list_id out."
            },
            "lines_kind": {
              "type": "string",
              "pattern": "^record:[^/]+$",
              "description": "The record kind of the lines list's rows (record:<its row_type>); the run's right is filled from this field."
            }
