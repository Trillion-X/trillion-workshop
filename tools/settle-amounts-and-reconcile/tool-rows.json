              "type": "string",
              "pattern": "^record:[^/]+$",
              "description": "The record kind of the source list's rows (record:<its row_type>); the run's right is filled from this field."
            },
            "target_kind": {
              "type": "string",
              "pattern": "^record:[^/]+$",
              "description": "The record kind of the target list's rows (record:<its row_type>); the run's right is filled from this field."
            }
          },
          "additionalProperties": true
        },
        "output_schema": {
          "type": "object"
        },
