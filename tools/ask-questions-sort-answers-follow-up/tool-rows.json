     "expected_seconds": 10,
     "network_egress": false
    },
    "id": "tool:submit-form-answers",
    "label": "Submit answers to a form",
    "job": "Check a person's answers against a saved form and, when they are all valid, record them with the score and segment they earn and any follow-up the form hands to its owner",
    "description": "Give form_id, respondent_id and answers (questionId to value), and optionally submission_id (for a form answered again and again, so each time is kept) and answered_at. The answers are checked against the saved form as check-form-answers does. If any is invalid nothing is written and the first to fix is returned. Otherwise one write keeps an answer fact for each answer the form asks about, one segment assignment (the score rows and segment rows that apply to this form pick the segment; the segment's follow-up sequence is returned), and one request record for each question whose afterSaved names an owner and action, with the answers filled into its input.",
    "input_schema": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "form_id",
      "respondent_id",
      "answers"
     ],
     "properties": {
      "form_id": {
       "type": "string",
       "minLength": 1,
       "description": "The saved form to answer"
      },
      "respondent_id": {
       "type": "string",
       "minLength": 1,
       "description": "Who is answering; answers of one respondent group together"
      },
      "answers": {
       "type": "object",
       "description": "Each question's answer, keyed by questionId"
      },
      "submission_id": {
       "type": "string",
       "description": "Names this time of answering, so a repeated form keeps every time"
      },
      "answered_at": {
       "type": "string",
       "format": "date-time",
       "description": "When they answered (default: now)"
      }
     }
    },
    "output_schema": {
     "type": "object",
     "required": [
      "accepted"
     ],
     "properties": {
      "accepted": {
       "type": "boolean"
      },
      "first_invalid": {
       "type": [
        "string",
        "null"
       ]
      },
      "questions": {
       "type": "array"
      },
      "decision": {
       "type": "object"
      },
      "follow_up": {
       "type": [
        "object",
        "null"
       ]
      },
      "written": {
       "type": "integer"
      },
      "action_requests": {
       "type": "array"
      },
      "ignored": {
       "type": "array"
      }
     }
    },
    "invoke": {
     "kind": "container",
     "files": {
      "package_files": [
       {
        "package": "ask-questions-sort-answers-follow-up",
        "paths": [
         "do-work",
         "read-data",
         "data"
        ],
        "at": "/opt/ask-questions-sort-answers-follow-up"
       },
       {
        "package": "records-door",
        "paths": [
         "do-work",
         "read-data"
        ],
        "at": "/opt/records-door"
       }
      ]
     },
     "workdir": "/opt/ask-questions-sort-answers-follow-up",
     "internet": false,
     "stdout": "json",
     "argv": [
      "node",
      "/opt/records-door/do-work/run-an-export.mjs",
      "/opt/ask-questions-sort-answers-follow-up/do-work/forms-on-the-records-door.mjs",
      "submitFormAnswers"
     ],
     "stdin": {
      "fill": {
       "from": "input"
      }
     },
     "records": {
      "fd": 3,
      "rights": [
       {
        "kind": "question-sequence",
        "prefix": "question-sequence:",
        "operations": [
         "records:read"
        ]
       },
       {
        "kind": "score-rule",
        "operations": [
         "records:list"
        ]
       },
       {
