    "id": "tool:save-a-form",
    "label": "Save a form",
    "job": "Keep a form, a list of questions people answer, as one of the person's own records so it can be asked and its answers checked",
    "description": "Give a form_id, an optional title and presentation, and the questions. Each question needs a questionId and a questionTypeId (a row in the question-type list: text, long text, number, rating, choice, a reference to a file) and may carry a label, required, options, its own validation rules laid over its type's, and an afterSaved hand-off naming an owner and an action. Saving the same form_id again replaces it. Returns the record id and how many questions were kept.",
    "input_schema": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "form_id",
      "questions"
     ],
     "properties": {
      "form_id": {
       "type": "string",
       "minLength": 1,
       "description": "The form's name, kept in the record id"
      },
      "title": {
       "type": "string",
       "description": "The form's title (default: the form_id)"
      },
      "presentation": {
       "type": "object",
       "description": "How the form is shown: a mode and the words of its Back, Next and Submit buttons"
      },
      "questions": {
       "type": "array",
       "minItems": 1,
       "items": {
        "type": "object",
        "required": [
         "questionId",
         "questionTypeId"
        ]
       },
       "description": "The questions, in order"
      }
     }
    },
    "output_schema": {
     "type": "object",
     "required": [
      "saved",
      "form_id",
      "record_id",
      "question_count"
     ],
     "properties": {
      "saved": {
       "type": "boolean"
      },
      "form_id": {
       "type": "string"
      },
