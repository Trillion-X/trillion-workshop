{
  "records": [
    {
      "payload": {
        "kind": "ai-tool-descriptor",
        "id": "tool:end-computer-grants-left-unused",
        "label": "End computer grants left unused",
        "status": "active",
        "job": "End the computer capabilities I granted my tools once they have gone unused for ninety days, and remind me a week before, so none stays open past my own condition",
        "description": "Reads each tool's computer grants at your door with when each was accepted and when a run last used it, and ends (withdraws) every grant whose later time plus unused_days (90 unless given) has passed by this run's clock (or now, an ISO time to decide at). A week before it would end (remind_days, 7 unless given) it keeps one reminder task in your inbox list, once, and removes that reminder when the grant was used since or ended. The engine keeps no end and reads none: a grant is admitted while it is present, so a grant ends when this withdraws it, and every run that uses a grant moves the time that was last used. A grant that names no time is left alone and counted as waiting. It can only end or read grants, never make one. Switch its wake on (wake:switch) and it runs every six hours; run it once by hand and it does the same.",
        "input_schema": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "now": {
              "type": "string",
              "description": "The time to decide at (ISO); now when left out"
            },
            "unused_days": {
              "type": "number",
              "description": "Days a grant may go unused before it ends; 90 when left out"
            },
            "remind_days": {
              "type": "number",
              "description": "Days before it ends that the reminder is made; 7 when left out"
            }
          }
        },
        "output_schema": {
          "type": "object",
          "required": [
            "ended",
            "reminded",
            "waiting",
            "said"
          ],
          "properties": {
            "ended": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "reminded": {
              "type": "integer"
            },
            "waiting": {
              "type": "integer"
            },
            "said": {
              "type": "string"
            }
          }
        },
