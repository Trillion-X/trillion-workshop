  "source_layout": { "_what": "How a board lays out the records a source draws on it (its `source` input, invariant 10): where the first card goes, each card's size, the room between columns and rows, how many cards it shows before it frames them by group, the room inside each frame, how its lines are routed, and the colour of each kind of line (a kind named in `kinds`, else the next `palette` colour in turn), and the least zoom it opens at when its cards run past the screen (`open_least_zoom`: they are framed whole down to it, and start at the top left below it).", "origin": { "x": 0, "y": 0 }, "card": { "w": 260, "h": 132 }, "gap": { "x": 96, "y": 40 }, "most": 12, "framePadding": 40, "reread_after_ms": 2500, "routing": "curved", "kinds": {}, "palette": ["#6366f1", "#0ea5e9", "#10b981", "#f59e0b", "#ec4899", "#8b5cf6", "#14b8a6", "#f97316"], "open_least_zoom": 0.6 },
