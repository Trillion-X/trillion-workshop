// @vitest-environment jsdom
//
// Adversarial proof for the share-capsule HTML sanitizer — the trust boundary that stops an
// untrusted share LINK from running script in the opener's `innerHTML` sink (XSS). Every known
// injection vector must be neutralized AND every safe formatting construct must survive (a
// shared board still looks like the original). Runs under jsdom so the real DOMParser path is
// exercised (not the no-DOM text-only fallback).

import { describe, expect, it } from 'vitest';
import { sanitizeCapsuleHtml } from './sanitize-capsule-html';

const lower = (s: string) => s.toLowerCase();

describe('sanitizeCapsuleHtml — XSS-neutralization (the share trust boundary)', () => {
  it('strips <img onerror> (the classic innerHTML XSS) — no img, no handler survives', () => {
    const out = sanitizeCapsuleHtml('<img src=x onerror="alert(1)">hi');
    expect(lower(out)).not.toContain('<img');
    expect(lower(out)).not.toContain('onerror');
    expect(out).toContain('hi');
  });

  it('unwraps <script> to inert text — the code never becomes an executable node', () => {
    const out = sanitizeCapsuleHtml('<div>a<script>alert(1)</script>b</div>');
    expect(lower(out)).not.toContain('<script');
    // the script body may remain as visible TEXT, but the tag is gone (text nodes never run)
    expect(out).toContain('a');
    expect(out).toContain('b');
  });

  it('strips <svg onload> and other foreign-content handlers', () => {
    const out = sanitizeCapsuleHtml('<svg onload="alert(1)"><circle/></svg>ok');
    expect(lower(out)).not.toContain('<svg');
    expect(lower(out)).not.toContain('onload');
    expect(out).toContain('ok');
  });

  it('removes javascript:, data:, and vbscript: URLs from <a href> (keeps the link text)', () => {
    for (const bad of ['javascript:alert(1)', 'data:text/html,<script>alert(1)</script>', 'vbscript:msgbox(1)']) {
      const out = sanitizeCapsuleHtml(`<a href="${bad}">click</a>`);
      expect(lower(out), bad).not.toContain('href=');
      expect(lower(out), bad).not.toContain('javascript:');
      expect(lower(out), bad).not.toContain('vbscript:');
      expect(out, bad).toContain('click');
    }
  });

  it('strips on* handlers even off an ALLOWED tag', () => {
    const out = sanitizeCapsuleHtml('<b onclick="steal()" onmouseover="x()">bold</b>');
    expect(lower(out)).not.toContain('onclick');
    expect(lower(out)).not.toContain('onmouseover');
    expect(lower(out)).toContain('<b');
    expect(out).toContain('bold');
  });

  it('sanitizes inline style — drops url()/expression()/javascript:, keeps colour', () => {
    const out = sanitizeCapsuleHtml(
      '<span style="color:red; background:url(javascript:alert(1)); width:expression(alert(1))">t</span>',
    );
    expect(lower(out)).toContain('color:red');
    expect(lower(out)).not.toContain('url(');
    expect(lower(out)).not.toContain('expression(');
    expect(lower(out)).not.toContain('javascript:');
  });

  it('drops <iframe>/<object>/<embed>/<form>/<style>/<link> entirely (unwrapped)', () => {
    const out = sanitizeCapsuleHtml(
      '<iframe src="evil"></iframe><object data="x"></object><embed src="x"><form action="x"></form><style>*{}</style><link rel=stylesheet>ok',
    );
    for (const t of ['<iframe', '<object', '<embed', '<form', '<style', '<link']) {
      expect(lower(out), t).not.toContain(t);
    }
    expect(out).toContain('ok');
  });

  it('fail-closed on empty / whitespace input', () => {
    expect(sanitizeCapsuleHtml('')).toBe('');
  });
});

describe('sanitizeCapsuleHtml — safe formatting SURVIVES (shared board keeps its look)', () => {
  it('keeps bold / italic / underline / mark', () => {
    const out = lower(sanitizeCapsuleHtml('<b>b</b><i>i</i><u>u</u><mark>m</mark>'));
    expect(out).toContain('<b>');
    expect(out).toContain('<i>');
    expect(out).toContain('<u>');
    expect(out).toContain('<mark>');
  });

  it('keeps a colour span (the note-paint fidelity path)', () => {
    const out = lower(sanitizeCapsuleHtml('<span style="color:#e11">red</span>'));
    expect(out).toContain('<span');
    expect(out).toContain('color:#e11');
    expect(out).toContain('red');
  });

  it('keeps lists, headings, blockquote, <br>, and a safe https link', () => {
    const out = lower(sanitizeCapsuleHtml(
      '<h2>Title</h2><ul><li>one</li><li>two</li></ul><blockquote>q</blockquote>line<br>2<a href="https://x.test">go</a>',
    ));
    expect(out).toContain('<h2>');
    expect(out).toContain('<ul>');
    expect(out).toContain('<li>');
    expect(out).toContain('<blockquote>');
    expect(out).toContain('<br>');
    expect(out).toContain('href="https://x.test"');
    expect(out).toContain('go');
  });

  it('keeps a relative and a #anchor href (not active schemes)', () => {
    const out = lower(sanitizeCapsuleHtml('<a href="/board/1">a</a><a href="#top">b</a>'));
    expect(out).toContain('href="/board/1"');
    expect(out).toContain('href="#top"');
  });

  describe('safeStyle — CSS escape + fetch-function bypasses are closed (cont.98 batch-8)', () => {
    it('an ESCAPED url() (u\\72l → url) does not survive — `background` is not allow-listed', () => {
      const out = lower(sanitizeCapsuleHtml('<span style="background:u\\72l(https://attacker.test/x); color:red">t</span>'));
      expect(out).not.toContain('attacker.test');
      expect(out).not.toContain('background'); // the whole fetch-capable declaration is dropped
      expect(out).toContain('color:red'); // safe formatting still survives
    });

    it('the image() fetch function is dropped (background-image is not allow-listed)', () => {
      const out = lower(sanitizeCapsuleHtml('<span style="background-image:image(x); font-weight:bold">t</span>'));
      expect(out).not.toContain('image(');
      expect(out).not.toContain('background-image');
      expect(out).toContain('font-weight:bold');
    });

    it('a legit rgb() colour still survives (a safe function on a safe property)', () => {
      const out = lower(sanitizeCapsuleHtml('<span style="color:rgb(255,0,0); text-align:center">t</span>'));
      expect(out).toContain('rgb(255,0,0)');
      expect(out).toContain('text-align:center');
    });
  });
});
