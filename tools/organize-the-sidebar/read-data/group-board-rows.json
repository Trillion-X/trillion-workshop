                {
                  "id": "instruction",
                  "control": "text",
                  "label": "What should the AI do with this board?",
                  "placeholder": "e.g. reorganize these into themes and fill in the empty notes with good example goals"
                }
              ]
            },
            "input_template": {
              "request_id": {
