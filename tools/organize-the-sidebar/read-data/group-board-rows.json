      "payload": {
        "kind": "action-affordance",
        "version": 1,
        "id": "action-affordance:group:improve-in-place",
        "is_active": true,
        "label": "Improve in place",
        "icon": "Wand",
        "section": "AI",
        "priority": -99,
        "effect": "reconcile",
        "triggers": [
          {
            "id": "board-shelf",
            "channel": "group.add-shelf",
            "event": "invoke",
            "ask": {
              "title": "Improve in place",
              "submit_label": "Run",
              "fields": [
                {
                  "id": "instruction",
                  "control": "text",
                  "label": "How should the AI improve these notes?",
                  "placeholder": "e.g. make each goal specific and measurable, fill in the empty ones"
                }
              ]
            },
            "input_template": {
              "request_id": {
                "$kind": "binding",
                "select": {
                  "from": "run",
                  "path": "id"
                }
              },
              "target_group_ref": {
                "$kind": "binding",
                "select": {
                  "from": "surface",
                  "path": "target_ref"
                }
              },
              "instruction_text": {
                "$kind": "template",
                "parts": [
                  "You are improving a vision board IN PLACE \u2014 keep every note where it is, just make it better. The user's request: ",
                  {
                    "$kind": "binding",
                    "select": {
                      "from": "answers",
                      "path": "instruction"
                    }
                  },
                  "\n\nHere is the current board (one note per line, prefixed with its id in [brackets]):\n",
                  {
                    "$kind": "binding",
                    "select": {
                      "from": "typed",
                      "path": "items_text"
                    }
                  },
                  "\n\nReturn the COMPLETE desired board as a JSON array of notes. For every note you KEEP or EDIT, include its existing id as \"memberId\" (copy the value inside the [brackets]) plus the improved \"text\" \u2014 this keeps the card in its current position. For a genuinely NEW note, omit \"memberId\" and give only \"text\". Rewrite weak, vague, or empty/placeholder notes into strong concrete goals; keep the good ones; you may add a few excellent example goals if the board is sparse. Return ONLY the JSON array, nothing else."
                ]
              },
              "output_kind": "note"
            },
            "presentation": {
              "working_label": "Thinking\u2026",
