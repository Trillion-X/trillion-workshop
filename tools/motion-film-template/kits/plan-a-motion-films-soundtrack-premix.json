  ],
  "worked_examples": [
    {
      "title": "Work out the ffmpeg commands that premix a motion film's soundtrack on a sample input",
      "ask": "Run tool:plan-a-motion-films-soundtrack-premix.",
      "mcp": {
        "server": "trillion",
        "tool": "run_resource_operation",
        "input": {
          "address": "@workshop-tools",
          "method": "tools:run",
          "input": {
            "tool": "tool:plan-a-motion-films-soundtrack-premix",
            "input": {
              "cue_sheet": {
                "DUR": 6,
                "VO": [
                  0.5,
                  2.3
                ],
                "voiced": [
                  [
                    0.6,
                    1.8
                  ],
                  [
                    2.4,
                    3.5
                  ]
                ],
                "cues": [
                  [
                    0,
                    "whoosh",
                    -12
                  ],
                  [
                    1.25,
                    "tick",
                    -18
                  ],
                  [
                    4,
                    "chime",
                    -9
                  ]
                ]
              },
              "film_folder": "films/sample-film",
              "sound_folder": "sound",
              "settings": {
                "music": {
                  "file": "{sound}/music/bed.wav",
                  "start": 2,
                  "fade_out": 1.5,
                  "chain": "aresample=48000,aformat=channel_layouts=stereo,atrim={start:.3f}:{end:.3f},asetpts=PTS-STARTPTS,volume='{gain_expr}':eval=frame,afade=t=out:st={fade_out_at:.3f}:d={fade_out}"
                },
                "gain": {
                  "base": -6,
                  "duck": -8,
                  "windows": [
                    {
                      "name": "a quiet beat",
                      "from": 4,
                      "to": 4.5,
                      "to_inclusive": true,
                      "set": -30
                    }
                  ]
                },
                "after_mix": "loudnorm=I=-14.5:TP=-1.5:LRA=11"
              }
            }
          }
        }
      },
      "hands_back": "An answer with the fields DUR, method, out, counts, premix, measure, gain_segments, settings_from."
    }
  ],
