{
  "kind": "tool-rows",
  "record_set": "admit-attachments-to-a-message-tool-rows",
  "what_this_is": "The Workshop rows of tools/admit-attachments-to-a-message.",
  "records": [
    {
      "payload": {
        "kind": "ai-tool-descriptor",
        "id": "tool:admit-attachments-to-a-message",
        "label": "Admit the files sent with a message",
        "status": "active",
        "job": "Decide how many of the files sent with a message are accepted, and which limit stopped the rest, in words to show the person",
        "description": "Give files ([{ name, size }] in the order offered), and when wanted limits ({ per_turn_cap, absolute_bytes, max_bytes, binding_words }; defaults from src/attachment-admission.json), daily ({ remaining, resets_at } when the plan keeps a daily count) and now (milliseconds). A file over the size ceiling is left out; the first files that fit min(per-turn cap, remaining daily count) are accepted in order. Returns accepted (indexes), left_out ([{ index, because }]), binding (size, per_turn, daily or null), banner (the words naming the limit) and blocked. A null limit does not bind. Pure: reads no clock, plan or network.",
        "input_schema": {
          "type": "object",
          "required": [
            "files"
          ],
          "additionalProperties": false,
          "properties": {
            "files": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "size"
                ],
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "size": {
                    "type": "number",
                    "minimum": 0
                  }
                }
              }
            },
            "limits": {
              "type": "object"
            },
            "daily": {
              "type": [
                "object",
                "null"
              ]
            },
            "now": {
              "type": "number"
            }
          }
        },
        "output_schema": {
          "type": "object",
          "required": [
            "accepted",
            "left_out",
            "binding",
            "banner",
            "blocked"
          ],
          "properties": {
            "accepted": {
              "type": "array"
            },
            "left_out": {
              "type": "array"
            },
            "binding": {
              "type": [
                "string",
                "null"
              ]
            },
            "banner": {
              "type": [
                "string",
                "null"
              ]
            },
            "blocked": {
              "type": "boolean"
            }
          }
        },
        "invoke": {
          "kind": "container",
          "internet": false,
          "workdir": "/opt/admit-attachments-to-a-message",
          "stdout": "json",
          "argv": [
            "node",
            "/opt/records-door/do-work/run-an-export.mjs",
            "/opt/admit-attachments-to-a-message/src/attachment-admission.mjs",
            "admitAttachments"
          ],
          "stdin": {
            "fill": {
              "from": "input"
            }
          },
          "files": {
            "package_files": [
              {
                "package": "admit-attachments-to-a-message",
                "paths": [
                  "src"
                ],
                "at": "/opt/admit-attachments-to-a-message"
              },
              {
                "package": "records-door",
                "paths": [
                  "do-work",
                  "read-data"
                ],
                "at": "/opt/records-door"
              },
              {
                "package": "content-identity",
                "paths": [
                  "read-data"
                ],
                "at": "/opt/content-identity"
              },
              {
                "module": "@noble/hashes",
                "paths": [
                  "LICENSE",
                  "package.json",
                  "blake3.js",
                  "blake2.js",
                  "_blake.js",
                  "_md.js",
                  "_u64.js",
                  "utils.js"
                ],
                "at": "/opt/node_modules/@noble/hashes"
              }
            ]
          }
        },
        "result_selector": "$.result",
        "needs": {
          "expected_seconds": 5,
          "network_egress": false,
          "memory_mb": 128
        },
        "licence_class": "licence:maker-own",
        "placements": [
          "placement:small-container"
        ],
        "maker": "maker:admit-attachments-to-a-message",
        "provenance": {
          "source": "Trillion-X/trillion src/attachment-admission.mjs at b92aa549f23873750ec918e86e7ed3896c9c4c0c, moved (moved-from.json)"
        },
        "verify": [
          {
            "kind": "sample-run",
            "input": {
              "files": [
                {
                  "name": "a.png",
                  "size": 1000
                },
                {
                  "name": "b.png",
                  "size": 1000
                },
                {
                  "name": "c.png",
                  "size": 1000
                }
              ],
              "limits": {
                "per_turn_cap": 2
              }
            },
            "output_selector": "$.banner",
            "contains": "first 2 of 3"
          }
        ]
      }
    }
  ]
}
