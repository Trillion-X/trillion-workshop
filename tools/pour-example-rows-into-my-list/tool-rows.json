{
  "kind": "package-set-records",
  "record_set": "pour-example-rows-into-my-list-tool-rows",
  "what_this_is": "The Workshop row for tools/pour-example-rows-into-my-list: pours an item's kit example rows into a list the person already keeps for the same job.",
  "records": [
    {
      "payload": {
        "kind": "ai-tool-descriptor",
        "id": "tool:pour-example-rows-into-my-list",
        "status": "active",
        "licence_class": "licence:maker-own",
        "maker": "maker:trillion",
        "placements": [
          "placement:small-container"
        ],
        "label": "Pour a kit's example rows into a list I already keep",
        "job": "Put the example rows that come with a workflow or tool into a list I already keep for the same job, matching its fields to mine",
        "description": "Reads one kit list (its fields, each with the names it goes by, and its example rows) and the person's own list (its id, row type and fields). Matches each kit field to one of theirs by the map they give, the same id, the same label or a name it goes by. Under the least share of matched fields (0.8 unless they ask for more) it pours nothing and names the fields with no home. Otherwise it answers the one records:write at @own-records that adds the example rows, with ids <row type>:kit-<example id> so pouring twice changes nothing, leaving out rows already there and any choice value their field does not offer. It writes nothing itself.",
        "input_schema": {
          "type": "object",
          "required": [
            "kit_list",
            "into"
          ],
          "properties": {
            "kit_list": {
              "type": "object",
              "description": "One entry of an item's kit.lists: { list, fields: [{ id, label, alike? }], example_rows: [{ id, values }] }."
            },
            "into": {
              "type": "object",
              "description": "The person's own list: { list: \"list:...\", row_type: \"record:...\", fields: [{ id, label, options? }] }."
            },
            "field_map": {
              "type": "object",
              "description": "{ kit field id: your field id, or null to leave it out }; wins over every other match."
            },
            "least_coverage": {
              "type": "number",
              "minimum": 0.8,
              "maximum": 1,
              "description": "The least share of the kit's fields that must match; 0.8 when not given."
            },
            "already_there": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Row ids the person's list already holds; those rows are left out."
            }
          }
        },
        "output_schema": {
          "type": "object",
          "required": [
            "poured",
            "coverage",
            "matched",
            "unmatched",
            "rows",
            "write",
            "says"
          ],
          "properties": {
            "poured": {
              "type": "boolean"
            },
            "coverage": {
              "type": "number"
            },
            "matched": {
              "type": "array"
            },
            "unmatched": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "left_out": {
              "type": "array"
            },
            "rows": {
              "type": "array"
            },
            "write": {
              "type": [
                "object",
                "null"
              ]
            },
            "says": {
              "type": "string"
            }
          }
        },
        "invoke": {
          "kind": "container",
          "internet": false,
          "workdir": "/work",
          "stdout": "json",
          "argv": [
            "/usr/local/bin/node",
            "/opt/pour-example-rows-into-my-list/do-work/pour.mjs"
          ],
          "stdin": {
            "fill": {
              "from": "input"
            }
          },
          "files": {
            "package_files": [
              {
                "package": "pour-example-rows-into-my-list",
                "paths": [
                  "do-work/pour.mjs"
                ],
                "at": "/opt/pour-example-rows-into-my-list"
              }
            ]
          }
        },
        "verify": [
          {
            "kind": "sample-run",
            "input": {
              "kit_list": {
                "list": "list:reply-templates",
                "fields": [
                  {
                    "id": "match_words",
                    "kind": "tags",
                    "label": "Words that pick it",
                    "alike": [
                      "keywords",
                      "triggers"
                    ]
                  },
                  {
                    "id": "text",
                    "kind": "long-text",
                    "label": "Reply",
                    "alike": [
                      "body",
                      "message"
                    ]
                  }
                ],
                "example_rows": [
                  {
                    "id": "price",
                    "values": {
                      "match_words": [
                        "price",
                        "how much"
                      ],
                      "text": "Hi {from}, it is 49 a month."
                    }
                  },
                  {
                    "id": "hours",
                    "values": {
                      "match_words": [
                        "open",
                        "hours"
                      ],
                      "text": "Hi {from}, we are open 9 to 5."
                    }
                  }
                ]
              },
              "into": {
                "list": "list:saved-replies",
                "row_type": "record:saved-reply",
                "fields": [
                  {
                    "id": "keywords",
                    "label": "Keywords"
                  },
                  {
                    "id": "body",
                    "label": "Body"
                  },
                  {
                    "id": "owner",
                    "label": "Owner"
                  }
                ]
              }
            },
            "output_selector": "$.says",
            "contains": "2 example rows ready for list:saved-replies"
          }
        ],
        "result_selector": "$",
        "needs": {
          "expected_seconds": 5,
          "network_egress": false,
          "memory_mb": 128
        },
        "read_only": true,
        "provenance": {
          "source": "Written for the Workshop: the pour part of every item's kit (tools/workflows/kit-template.json, L082)."
        },
        "kit": {
          "start_here": "Say to your AI: \"Pour the example reply templates from workflow:answer-comments-and-messages into my saved-replies list.\" It reads your list's fields, matches them to the kit's and hands you the one write that adds the examples.",
          "lists": [],
          "no_lists_because": "It keeps no list of its own: it reads a kit's list and the person's list it is given, and answers a write for theirs.",
          "workflows": [],
          "tools": [
            "tool:pour-example-rows-into-my-list"
          ],
          "instructions": [
            "1. Pick the kit list to pour: an item's kit.lists entry (tools/workflows/recipes/workflows.json for a workflow, a tool row's kit for a tool).",
            "2. Read your own list that does the same job with run_resource_operation @own-records records:read { id: \"list:<yours>\" }: its fields and row type go in into; the ids of its rows go in already_there.",
            "3. Run this tool. When it says poured, send its write with run_resource_operation; when it says the match is under 80%, map the fields it names in field_map or make the kit's own list instead."
          ],
          "worked_examples": [
            {
              "title": "Two reply templates poured into a saved-replies list",
              "ask": "Put the example reply templates into my saved replies list.",
              "mcp": {
                "server": "trillion",
                "tool": "run_resource_operation",
                "input": {
                  "address": "@workshop-tools",
                  "method": "tools:run",
                  "input": {
                    "tool": "tool:pour-example-rows-into-my-list",
                    "input": {
                      "kit_list": {
                        "list": "list:reply-templates",
                        "fields": [
                          {
                            "id": "match_words",
                            "kind": "tags",
                            "label": "Words that pick it",
                            "alike": [
                              "keywords",
                              "triggers"
                            ]
                          },
                          {
                            "id": "text",
                            "kind": "long-text",
                            "label": "Reply",
                            "alike": [
                              "body",
                              "message"
                            ]
                          }
                        ],
                        "example_rows": [
                          {
                            "id": "price",
                            "values": {
                              "match_words": [
                                "price",
                                "how much"
                              ],
                              "text": "Hi {from}, it is 49 a month."
                            }
                          },
                          {
                            "id": "hours",
                            "values": {
                              "match_words": [
                                "open",
                                "hours"
                              ],
                              "text": "Hi {from}, we are open 9 to 5."
                            }
                          }
                        ]
                      },
                      "into": {
                        "list": "list:saved-replies",
                        "row_type": "record:saved-reply",
                        "fields": [
                          {
                            "id": "keywords",
                            "label": "Keywords"
                          },
                          {
                            "id": "body",
                            "label": "Body"
                          },
                          {
                            "id": "owner",
                            "label": "Owner"
                          }
                        ]
                      }
                    }
                  }
                }
              },
              "given": "A saved-replies list with the fields keywords, body and owner.",
              "hands_back": "poured true, coverage 1 (match_words to keywords and text to body, each by a name it goes by), and a records:write at @own-records adding record:saved-reply:kit-price and record:saved-reply:kit-hours."
            }
          ]
        }
      }
    }
  ]
}
