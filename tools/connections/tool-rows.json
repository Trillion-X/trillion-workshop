        "placements": [
          "placement:small-container"
        ],
        "needs": {
          "expected_seconds": 3,
          "network_egress": false
        },
        "read_only": true,
        "label": "List connections",
        "job": "List the services this account is connected to, with each connection's status and when it was last checked",
        "description": "List the services this account is connected to, with each connection's status and when it was last checked. Returns connections: one row a connection in connection id order, { connection_id, service, vendor, account_label?, status?, can_send, connected_at?, grant_scopes_known, grant_scopes?, capabilityChoices?, last_checked?, connected_by? }, from the person's own connection records, which you hand in as connection_records (read them from the person's store: records of type connection, each { id, value }); a connection whose values the account holds and that has no record yet is listed from what its held names say (its id, service and vendor), its other facts left out as unknown. Reads only; it reads no store itself, keeps nothing and writes no row; it connects, checks and sends nothing, and shows no secret.",
        "input_schema": {
          "type": "object",
          "required": [
            "connection_records"
          ],
          "additionalProperties": false,
          "properties": {
            "connection_records": {
              "type": "array",
              "description": "The person's connection records, as read from their store: [{ id, value }], id `connection:` + the URL-encoded connection id",
              "items": {
                "type": "object",
                "required": [
                  "id",
                  "value"
                ],
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "value": {
                    "type": "object"
                  }
                }
              }
            }
          }
        },
        "output_schema": {
          "type": "object",
          "required": [
            "connections"
          ],
          "properties": {
            "connections": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "connection_id",
                  "can_send",
                  "grant_scopes_known"
                ],
                "properties": {
                  "connection_id": {
                    "type": "string"
                  },
                  "service": {
                    "type": "string"
                  },
                  "vendor": {
                    "type": "string"
                  },
                  "account_label": {
                    "type": "string"
                  },
                  "status": {
                    "type": "string"
                  },
                  "can_send": {
                    "type": "boolean"
                  },
                  "connected_at": {
                    "type": "string"
                  },
                  "grant_scopes_known": {
                    "type": "boolean"
                  },
                  "grant_scopes": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "capabilityChoices": {
                    "type": "object"
                  },
                  "last_checked": {
                    "type": "object"
                  },
                  "connected_by": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "invoke": {
          "kind": "container",
          "workdir": "/opt/connections",
          "internet": false,
          "stdout": "json",
          "argv": [
            "node",
            "/opt/records-door/do-work/run-an-export.mjs",
            "/opt/connections/do-work/list-connections.mjs",
            "listConnections"
          ],
          "stdin": {
            "fill": {
              "from": "input"
            }
          },
          "files": {
            "package_files": [
              {
                "package": "connections",
                "paths": [
