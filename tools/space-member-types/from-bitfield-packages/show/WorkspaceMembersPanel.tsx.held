/**
 * Purpose: Workspace member evidence interface.
 * Displays member table from the package-owned workspace-members feed.
 *
 * Non-Negotiable Invariants:
 *   - All styling through ui/ components (Card, Container, Text, Badge)
 *   - Zero raw HTML elements
 *   - Read-only because this package publishes no member write workflow definitions
 *   - Member table: name, email, role, status, joined date
 */

import React from 'react';
import { useMemo } from "react";
import { Card } from "../../../ui";
import { Container } from "../../../ui";
import { Text } from "../../../ui";
import { Badge } from "../../../ui";
import { useBitfieldData } from '@bitfield/runtime-kit/react';
import { decodeWorkspaceMembersFeed } from '../read-data/read-workspace-members';

export function WorkspaceMembersPanel() {
  const membersEntry = useBitfieldData();
  const members = useMemo(
    () => decodeWorkspaceMembersFeed(membersEntry),
    [membersEntry],
  );
  const isLoading = membersEntry === null;

  return (
    <Container layout="vertical" gap="lg">
      <Card padding="lg">
        <Container layout="vertical" gap="lg">
          <Text variant="heading">
            Workspace Members
          </Text>
          <Text variant="label" color="faint">
            Read-only membership evidence from the workspace-members feed.
          </Text>

          {isLoading ? (
            <Text color="muted">Loading members...</Text>
          ) : members.length === 0 ? (
            <Text color="muted">No members yet</Text>
          ) : (
            <Container layout="vertical" gap="md">
              {members.map((member) => (
                <Card key={member.id} variant="nested" padding="md">
                  <Container layout="horizontal" gap="md" alignItems="center" justifyContent="between">
                    <Container layout="vertical" gap="xs" flex={1}>
                      <Text weight="bold">{member.name}</Text>
                      <Container layout="horizontal" gap="md" alignItems="center">
                        <Text variant="body-xs" color="muted">
                          {member.email}
                        </Text>
                        <Badge variant="neutral">{member.role}</Badge>
                        <Text variant="body-xs" color="muted">
                          Joined {new Date(member.joinedAt).toLocaleDateString()}
                        </Text>
                      </Container>
                    </Container>

                  </Container>
                </Card>
              ))}
            </Container>
          )}
        </Container>
      </Card>
    </Container>
  );
}
