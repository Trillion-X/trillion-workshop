{
  "records": [
    {
      "payload": {
        "kind": "ai-tool-descriptor",
        "id": "tool:list-connected-drives",
        "label": "Drives on my computers",
        "job": "List the drives connected to this person's computer: each drive's name, where it is mounted, its size and free space, its kind (USB, disk image, internal) and whether it can be ejected",
        "description": "Runs on the person's computer with the drives they granted it to see. Returns devices: each with name, mount, size_bytes, free_bytes, kind, internal, ejectable and state.",
        "status": "active",
        "input_schema": {
          "type": "object",
          "additionalProperties": false,
          "properties": {}
        },
        "output_schema": {
          "type": "object",
          "required": [
            "devices"
          ],
          "properties": {
            "devices": {
              "type": "array"
            }
          }
        },
        "invoke": {
          "kind": "computer",
          "capabilities": [
            "see-connected-drives"
          ],
          "workdir": "/opt/connected-drives",
          "stdout": "json",
          "argv": [
            "node",
            "/opt/records-door/do-work/run-an-export.mjs",
            "/opt/connected-drives/read-data/drives.mjs",
            "listConnectedDrives"
          ],
          "stdin": {
            "fill": {
              "from": "input"
            }
          },
          "files": {
            "package_files": [
              {
                "package": "connected-drives",
                "paths": [
                  "read-data"
                ],
                "at": "/opt/connected-drives"
              },
              {
                "package": "records-door",
                "paths": [
                  "do-work",
                  "read-data"
                ],
                "at": "/opt/records-door"
              }
            ]
          }
        },
        "result_selector": "$.result",
        "needs": {
          "expected_seconds": 5,
          "network_egress": false
        },
        "maker": "maker:connected-drives",
        "licence_class": "licence:maker-own",
        "placements": [
          "placement:your-computer"
        ]
      }
    },
    {
      "payload": {
        "kind": "ai-tool-descriptor",
        "id": "tool:list-a-drive-folder",
        "label": "Look inside a folder on a drive",
        "job": "List the files and folders in one folder on a drive connected to this person's computer, a page at a time",
        "description": "Runs on the person's computer. hidden \"1\" includes hidden files; offset and limit page through a long folder. Returns path, name, parent, mount, entries (name, path, kind, file_kind, bytes, modified_at), total and has_more.",
        "status": "active",
        "input_schema": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "path": {
              "type": "string",
              "description": "A full path on a connected drive, like /Volumes/Drive/DCIM"
            },
            "offset": {
              "type": "integer",
              "minimum": 0
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 500
            },
            "hidden": {
              "type": "string",
              "enum": [
                "1"
              ],
              "description": "\"1\" to include hidden files"
            }
          },
          "required": [
            "path"
          ]
        },
        "output_schema": {
          "type": "object",
          "required": [
            "path",
            "entries"
          ],
          "properties": {
            "path": {
              "type": "string"
            },
            "entries": {
              "type": "array"
            },
            "total": {
              "type": "integer"
            },
            "has_more": {
              "type": "boolean"
            }
          }
        },
        "invoke": {
          "kind": "computer",
          "capabilities": [
            "see-connected-drives"
          ],
          "workdir": "/opt/connected-drives",
          "stdout": "json",
          "argv": [
            "node",
            "/opt/records-door/do-work/run-an-export.mjs",
            "/opt/connected-drives/read-data/drives.mjs",
            "listDriveFolder"
          ],
          "stdin": {
            "fill": {
              "from": "input"
            }
          },
          "files": {
            "package_files": [
              {
                "package": "connected-drives",
                "paths": [
                  "read-data"
                ],
                "at": "/opt/connected-drives"
              },
              {
                "package": "records-door",
                "paths": [
                  "do-work",
                  "read-data"
                ],
                "at": "/opt/records-door"
              }
            ]
          }
        },
        "result_selector": "$.result",
        "needs": {
          "expected_seconds": 5,
          "network_egress": false
        },
        "maker": "maker:connected-drives",
        "licence_class": "licence:maker-own",
        "placements": [
          "placement:your-computer"
        ]
      }
    },
