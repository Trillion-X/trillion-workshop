// The setup contract is DATA, run by the existing workflow and owner APIs. Connecting an AI is the entrance,
// never the completed outcome. start_setup prepares the existing runtime and resumes one durable account run;
// read_setup is a read-only projection. Neither chooses a model, copies another person's data, nor grants authority.
import policy from './setup-policy.json' with { type: 'json' };
import { instructionParagraph } from '../../../shared-code/src/server-instruction-paragraphs.mjs';
import { setupInstalls, nativeHarnessPlacement } from './setup-installs.mjs';
import { lensForSetup, useLens } from 'trillion-workshop/tools/see-a-pursuit-through-the-lens/src/pursuit-lens.mjs';
import lensRows from '../methods/pursuit-lens.json' with { type: 'json' };
import { withoutSecrets } from '../../../learn-a-workflow-from-a-job/src/scheduler.mjs';
import { formerAgentIds } from '../../../shared-code/src/renamed-tools.mjs';
import { entryPointForSetup } from '../../../start-from-any-landing-page/src/entry-points.mjs';
// The pursuit lens (trillion-workshop) reads the lens its caller hands in: the rows kept here.
useLens(lensRows);

const callFor = (tool, args = {}) => ({ tool, arguments: args });
const uniqueCalls = calls => [...new Map(calls.map(call => [JSON.stringify([call.tool, call.arguments]), call])).values()];

export function setupInstructions() {
  return `Setting a person up: call start_setup as soon as the MCP connection works and whenever the person asks to be set up. It prepares the existing defaults, source listeners and scheduler, and starts or resumes the setup workflow; follow its next_call through configuration and independent verification. Read what you find as "Seeing what they pursue" in its full setup guide and apply it to this person's observed context. For repeated status checks use read_setup with {view:"state"}; its guidance_call keeps the full guide available. After admitted discovery changes the required devices, call start_setup again without restart to prepare their current access prerequisites, then follow prerequisites.next_calls. Preserve a stopped setup until the person explicitly requests a restart. The saved workflow, not another checklist, owns the job. ${policy.words.continuation} ${policy.principles.join(' ')}`;
}

/** A saved run and current owner observations are separate: neither instructions nor an admitted output erase a
 * current failure. The recipe names how to discover applicability, delegate work, verify it and recover. */
export function setupPlan({ runtime, known = null, prerequisites = null, native = null, origin, view = 'full' }) {
  if (!['state', 'full'].includes(view)) throw new Error("view must be 'state' or 'full'.");
  const workflow = runtime?.workflow ?? null;
  const continueRun = workflow?.exists && !workflow.withdrawn && workflow.state !== 'finished';
  // An observed not-started run has one actionable continuation. Merely reading
  // diagnostics must not hide it behind several unrelated observation calls.
  // Unknown state, a completed run and a deliberate stop never imply restart.
  const needsStart = workflow?.exists === false && workflow.state === 'not_started'
    && workflow.withdrawn !== true && prerequisites?.setup_paused !== true;
  const next_call = continueRun ? callFor('read_workflow_run', {
    run_id: workflow.run_id, ...(['failed', 'stuck'].includes(workflow.state) ? { resume: true } : {}),
  }) : needsStart ? callFor('start_setup') : null;
  const plan = {
    schema: 'trillion.setup-plan/v1',
    runtime,
    read_call: callFor('read_setup'),
    read_fallback_call: callFor('start_setup', { read_only: true }),
    workflow: { ...policy.workflow, ...workflow },
    ...(next_call ? { next_call } : {}),
    next_calls: uniqueCalls([...(next_call ? [next_call] : runtime?.next_calls ?? []), ...(prerequisites?.next_calls ?? []), ...(known?.connections?.next_call ? [known.connections.next_call] : [])]),
    ...(continueRun ? { controls: { stop: { tool: 'stop_workflow_run', arguments: { run_id: workflow.run_id }, requires: 'Use only for an actual stop request and supply its reason. Stops future workflow steps; already started work may continue.' } } } : {}),
    ...(known ? { known } : {}),
    ...(prerequisites ? { prerequisites } : {}),
  };
  if (view === 'state') return {
    ...plan,
    read_call: callFor('read_setup', { view: 'state' }),
    read_fallback_call: callFor('start_setup', { read_only: true, view: 'state' }),
    guidance_call: callFor('read_setup', { view: 'full' }),
  };
  return {
    ...plan,
    goal: policy.goal,
    policy: { version: policy.version, principles: policy.principles, requirements: policy.requirements },
    install: setupInstalls(origin, native),
    mission: instructionParagraph('mission'),
    keep_trillion_in_your_instructions: instructionParagraph('host-startup'),
    see_what_they_pursue: lensForSetup(),
    ai_instructions: [
      policy.words.continuation,
      'Read the saved run before acting. Reuse its known facts, accepted outputs and pending person actions. Continue independent work while one action waits; do not ask the person to repeat setup or wait in the Trillion screen.',
      'Do the authorized work with the tools available in this conversation and the existing Marketplace owners. A handoff is unfinished until the result is read back. Discover the actual AI hosts, accounts and devices; do not require a device this person does not have.',
      'After admitting discovery that changes the required devices, call start_setup again without restart, then follow prerequisites.next_calls. It prepares current native access through the same account owner as the setup screen; no open browser screen is required. read_setup only reads these prerequisites. A missing mandate needs the person’s explicit access request; never add consent merely to advance setup. A stopped setup stays stopped until the person explicitly requests a restart.',
      'The human supplies direction and observations. Retrieve known facts first. Ask only for a genuinely missing fact, authorization, or an operating-system action the AI cannot perform, with one concrete prepared action in this conversation.',
      'Inspect the local harness installer before applying it, and verify actual hook execution afterward. Preserve unrelated configuration, chosen models, pauses, budgets and permissions. Do not enable paid inference or disable approval safeguards as a side effect of setup.',
      'Use read_setup to verify current owner state. If your cached tool catalog does not expose read_setup, call start_setup with {read_only:true} for the same observation; never combine it with restart. Do not mark a capability complete from an instruction, a configuration entry, an armed alarm, a queued import or a failed read. A large import may continue with its tracked backlog after a verified first arrival and useful result.',
    ],
  };

}

export function setupTools({ call, origin, cameFrom = async () => null }) {
  const readNative = async () => {
    try {
      const answer = await call('/computer-sources');
      if (!Array.isArray(answer?.computers) || !answer.computers.every(row => typeof row?.computer_id === 'string' &&
        /^[A-Za-z0-9][A-Za-z0-9._-]{0,159}$/.test(row.computer_id) && Number.isFinite(Date.parse(row.reported_at))) ||
        new Set(answer.computers.map(row => row.computer_id)).size !== answer.computers.length) throw new Error('The account computer inventory could not be read.');
      const computers = answer.computers.slice(0, 32);
      const idOf = row => `${nativeHarnessPlacement.settings.computer_scope.agent_prefix}${row.computer_id}`;
      // The current agent id is asked first; a computer whose app predates the rename advertises only the former id,
      // so the former ids are asked only when the current answer has no agents.
      const cards = await Promise.allSettled(computers.map(async row => {
        const agent_id = idOf(row);
        let found = await call('/agents/find', { agent_id, limit: 1 }, 'POST');
        for (const former of formerAgentIds(agent_id)) {
          if (found?.agents?.length) break;
          found = await call('/agents/find', { agent_id: former, limit: 1 }, 'POST');
        }
        return found;
      }));
      return { computers, truncated: answer.computers.length > 32, cards: Object.fromEntries(cards.map((result, index) => [idOf(computers[index]),
        result.status === 'fulfilled' ? result.value : { unavailable: withoutSecrets(result.reason) }])) };
    } catch (error) { return { unavailable: withoutSecrets(error) }; }
  };
  const readPrerequisites = async (prepare = false) => {
    try {
      const result = prepare ? await call('/setup/requirements', {}, 'POST') : await call('/setup/requirements');
      if (result?.schema !== 'trillion.setup-prerequisites/v1' || !Array.isArray(result.requirements)
        || !Array.isArray(result.setup_access) || !Array.isArray(result.next_calls)
        || !result.next_calls.every(next => typeof next?.tool === 'string' && next.arguments && typeof next.arguments === 'object' && !Array.isArray(next.arguments))
        || typeof result.setup_complete !== 'boolean' || typeof result.workspace_ready !== 'boolean' || typeof result.setup_paused !== 'boolean') {
        throw new Error('The current account setup prerequisites could not be read.');
      }
      return result;
    } catch (error) { return { unavailable: withoutSecrets(error) }; }
  };
  // Where the person came from (an entry point named in the call, else the page or link recorded when the account was made),
  // so the AI opens setup the way that entry point says (src/entry-points.json). Never required, never a gate.
  const withEntry = async (plan, named) => {
    const entry = entryPointForSetup(named, await cameFrom().catch(() => null));
    return entry ? { ...plan, entry_point: entry } : plan;
  };
  // One projection for current clients and cached catalogs that only expose start_setup.
  const readSetup = async (view = 'full', entry) => {
    const runtime = await call('/setup/runtime');
    return withEntry(setupPlan({ runtime, prerequisites: await readPrerequisites(), native: view === 'full' ? await readNative() : null, origin, view }), entry);
  };
  const readKnown = async () => {
    const entries = [
      ['pursuits', () => call('/pursuits?offset=0&limit=25')],
      ['connections', async () => {
        const page = await call('/connections?limit=25');
        return typeof page?.next_after === 'string' && page.next_after
          ? { ...page, next_call: callFor('list_connections', { after: page.next_after, limit: 25 }) } : page;
      }],
      ['profile', () => call('/network/ensure-profile', {}, 'POST')],
      ['devices', () => call('/setup/devices')],
    ];
    const results = await Promise.allSettled(entries.map(([, read]) => read()));
    return Object.fromEntries(results.map((result, index) => [entries[index][0], result.status === 'fulfilled'
      ? result.value : { unavailable: withoutSecrets(result.reason) }]));
  };
  return [
    {
      name: 'start_setup',
      description: 'Starts or resumes this account’s complete Trillion setup. Call immediately after connecting the MCP, after admitted discovery changes required devices, and whenever the person asks to finish setup. Prepares the existing default rules, authorized source listeners and one scheduler, then starts or resumes the saved setup workflow and prepares current native access only under existing operator policy and a recorded account mandate. Returns known context, required capabilities and access prerequisites, local hook installation and the next workflow call. Continue until applicable capabilities have observed evidence and a useful result can be read back from persisted work. It preserves existing choices and does not choose or start a paid AI. An MCP connection, invitation, installed app or copied prompt alone is not completion. For repeated status checks use read_setup({view:"state"}); use read_setup({view:"full"}) for setup guidance. read_only:true is the compatibility fallback when read_setup is absent from a cached tool catalog.',
      inputSchema: { type: 'object', properties: { entry: { type: 'string', description: 'The id of the entry point the person started from (the page, invite or partner that brought them), when known. Left out, the one recorded when their account was made is used. The answer carries entry_point with its persona and opening message.' }, read_only: { type: 'boolean', description: 'Read current setup without preparing or restarting it. For older catalogs use read_only:true with view:"state" for status or view:"full" for the full setup guide.' }, view: { type: 'string', enum: ['state', 'full'], description: 'For read_only:true only: state gives bounded current status; full includes setup guidance. Omit for compatibility full output.' }, restart: { type: 'boolean', description: 'Restart a stopped setup only when the person explicitly asks to restart it. Ordinary retries preserve a stop.' } }, additionalProperties: false },
      run: async (input = {}) => {
        if (!input || typeof input !== 'object' || Array.isArray(input)
          || (input.read_only !== undefined && typeof input.read_only !== 'boolean')
          || (input.restart !== undefined && typeof input.restart !== 'boolean'))
          throw new Error('read_only and restart, when supplied, must be true or false.');
        if (input.view !== undefined && !['state', 'full'].includes(input.view))
          throw new Error("view must be 'state' or 'full'.");
        if (input.entry !== undefined && typeof input.entry !== 'string') throw new Error('entry, when supplied, must be an entry point id.');
        const { read_only = false, restart = false } = input;
        if (read_only && restart) throw new Error('Read-only setup cannot be combined with restart.');
        if (read_only) return readSetup(input.view ?? 'full', input.entry);
        if (input.view !== undefined) throw new Error('view is only supported with read_only:true.');
        // Runtime authorization and preparation must succeed before optional reads or profile initialization.
        const runtime = await call('/setup/runtime', restart === true ? { restart: true } : {}, 'POST');
        const prerequisites = await readPrerequisites(true);
        return withEntry(setupPlan({ runtime, prerequisites, known: await readKnown(), native: await readNative(), origin }), input.entry);
      },
    },
    {
      name: 'read_setup',
      description: 'Reads the account’s saved setup state and current access prerequisites without starting setup or running work. Use view:"state" for repeated status observations; it preserves readiness, refusals and next calls without expanding generic setup guidance. Use view:"full" when setup instructions, installation guidance or the pursuit lens are needed. Unknown, blocked and pending remain distinct from ready; completion still needs independent owner evidence.',
      inputSchema: { type: 'object', properties: { entry: { type: 'string', description: 'The id of the entry point the person started from (the page, invite or partner that brought them), when known. Left out, the one recorded when their account was made is used. The answer carries entry_point with its persona and opening message.' }, view: { type: 'string', enum: ['state', 'full'], description: 'state returns bounded current status; full includes setup instructions and guidance. Omit for compatibility full output.' } }, additionalProperties: false },
      run: async (input = {}) => {
        if (!input || typeof input !== 'object' || Array.isArray(input) || (input.view !== undefined && !['state', 'full'].includes(input.view)))
          throw new Error("view must be 'state' or 'full'.");
        if (input.entry !== undefined && typeof input.entry !== 'string') throw new Error('entry, when supplied, must be an entry point id.');
        return readSetup(input.view ?? 'full', input.entry);
      },
    },
  ];
}

export const setupAnnotations = {
  start_setup: { title: 'Finish Trillion setup', readOnlyHint: false, destructiveHint: false, idempotentHint: true, openWorldHint: false },
  read_setup: { title: 'Read Trillion setup', readOnlyHint: true, destructiveHint: false, idempotentHint: true, openWorldHint: false },
};
