    "kind": "ai-tool-descriptor",
    "id": "tool:walk-a-new-person-through-first-setup",
    "label": "Walk a new person through first setup",
    "status": "active",
    "job": "Walk a new person through first setup: the apps to install on their devices, the AIs to connect, and the one saved run that resumes where they stopped",
    "description": "Give the setup plan for one person's account from what the caller reads and hands over: the saved setup run and what it does next (its next calls, the workflow's steps), the access prerequisites still open, what the account already has (pursuits, connections, profile, devices), the computers it can reach and their tool cards, the person's pursuit lens and the entry point they came from. Returns the plan: the apps to install on their devices (with the public links or the honest not-yet words), the local harness installer's download, inspect, apply and remove commands per supported AI host, the MCP registration preview commands, the instructions the AI follows, and the setup policy. view 'state' returns the run and its next calls only; view 'full' adds the installs, the policy and the lens. Given database (or credential_name), it reads the toolkits and toolkit_swaps tables there and offers their rows, and a toolkit_choice (the toolkit picked, tool ids dropped from it, tool ids added) answers the tool ids to install. Nothing else is read from storage and nothing is written: starting or resuming the saved run is not yet ported, so next calls that name start_setup are not run by this tool.",
    "input_schema": {
     "type": "object",
     "required": [
      "origin"
     ],
     "additionalProperties": false,
     "properties": {
      "view": {
       "type": "string",
       "enum": [
        "state",
        "full"
       ],
       "description": "state: the run and its next calls; full (default): also the installs, the policy and the pursuit lens"
      },
      "origin": {
       "type": "string",
       "description": "The service address the setup files are served from (an https address serves the harness files)"
      },
      "runtime": {
       "type": "object",
       "description": "The saved setup run: { workflow: { exists, state, run_id?, withdrawn?, failed?, stuck? }, next_calls? }"
      },
      "prerequisites": {
       "type": "object",
       "description": "The account's current access prerequisites: { requirements, setup_access, next_calls, setup_complete, workspace_ready, setup_paused }"
      },
      "known": {
       "type": "object",
       "description": "What the account already has: { pursuits, connections, profile, devices }"
      },
      "native": {
       "type": "object",
       "description": "The account's computers: { computers: [{computer_id, reported_at}], cards: {agent_id: card}, truncated? }"
      },
      "lens": {
       "type": "object",
       "description": "The person's pursuit lens: { opening, parts, closing, rows }"
      },
      "entry": {
       "type": "string",
       "description": "The entry point id the person started from"
      },
      "came_from": {
       "type": "object",
       "description": "The page recorded when the account was made: { from }"
      },
      "database": {
       "type": "string",
       "minLength": 1,
       "description": "The database that keeps the toolkits and toolkit_swaps tables, as this computer names it (the computer picks the login). The tool reads both tables there: toolkits rows { id, value: { title?, description?, items: [marketplace item ids, in the order an account gets them], default?, every_account?, stack?: { slot: [pointer] }, connections?: [{ service, credential: the vault name, why }], facts?: [{ id, question, from? }] }, position }, toolkit_swaps rows { id: toolkit-swap:..., value: { title?, description?, swap: { slot: [pointer] } }, position }; first setup offers them all and fills the cart (toolkits.cart) from the picked toolkit, else from the one marked default"
      },
      "credential_name": {
       "type": "string",
       "minLength": 1,
       "description": "Instead of database: the held name of the connection string of the database that keeps the toolkits and toolkit_swaps tables"
      },
      "row": {
       "type": "string",
       "description": "The id of a toolkits or toolkit_swaps row to pick (a toolkit, or a swap into the default toolkit), unless toolkit_choice is given"
      },
      "toolkit_choice": {
       "type": "object",
       "description": "The person's pick: { toolkit?, drop?, add?, swap? }, the id of one offered toolkit (left out: the default one), tool ids to drop from it, tool ids to add, and swap: { slot: [pointer] }, parts that replace the toolkit's own in those slots (a slot it lacks is added), or the id of one of toolkits.swaps"
      },
      "known_tools": {
       "type": "array",
       "description": "Every tool id that can be installed here; an added tool id outside it is refused (left out: any well-formed tool id is accepted)"
      }
     }
    },
    "output_schema": {
     "type": "object",
     "required": [
      "result"
     ],
     "properties": {
      "result": {
       "type": "object",
       "required": [
        "schema",
        "workflow",
        "read_call"
       ],
       "properties": {
        "schema": {
         "const": "trillion.setup-plan/v1"
        },
        "workflow": {
         "type": "object"
        },
        "read_call": {
         "type": "object"
        },
        "next_calls": {
         "type": "array"
        },
        "install": {
         "type": "object"
        },
        "entry_point": {
         "type": "object"
        },
        "toolkits": {
         "type": "object"
        }
       }
      }
     }
    },
    "result_selector": "$.result",
    "invoke": {
     "kind": "container",
     "credential_mounts": [
      {
       "secret_name_from_input": "credential_name",
       "fd": 3,
       "only_when": {
        "input": "credential_name",
        "present": true
       }
      },
      {
       "secret_name_from_database": "database",
       "held_suffix": "-connection",
       "fd": 3,
       "only_when": {
        "input": "database",
        "present": true
       }
      }
     ],
