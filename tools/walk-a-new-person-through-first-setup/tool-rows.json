    "kind": "ai-tool-descriptor",
    "id": "tool:walk-a-new-person-through-first-setup",
    "label": "Walk a new person through first setup",
    "status": "active",
    "job": "Walk a new person through first setup: the apps to install on their devices, the AIs to connect, and the one saved run that resumes where they stopped",
    "description": "Give the setup plan for one person's account from what the caller reads and hands over: the saved setup run and what it does next (its next calls, the workflow's steps), the access prerequisites still open, what the account already has (pursuits, connections, profile, devices), the computers it can reach and their tool cards, the person's pursuit lens and the entry point they came from. Returns the plan: the apps to install on their devices (with the public links or the honest not-yet words), the local harness installer's download, inspect, apply and remove commands per supported AI host, the MCP registration preview commands, the instructions the AI follows, and the setup policy. view 'state' returns the run and its next calls only; view 'full' adds the installs, the policy and the lens. Nothing is read from storage and nothing is written: starting or resuming the saved run is not yet ported, so next calls that name start_setup are not run by this tool.",
    "input_schema": {
     "type": "object",
     "required": [
      "origin"
     ],
     "additionalProperties": false,
     "properties": {
      "view": {
       "type": "string",
       "enum": [
        "state",
        "full"
       ],
       "description": "state: the run and its next calls; full (default): also the installs, the policy and the pursuit lens"
      },
      "origin": {
       "type": "string",
       "description": "The service address the setup files are served from (an https address serves the harness files)"
      },
      "runtime": {
       "type": "object",
       "description": "The saved setup run: { workflow: { exists, state, run_id?, withdrawn?, failed?, stuck? }, next_calls? }"
      },
      "prerequisites": {
       "type": "object",
       "description": "The account's current access prerequisites: { requirements, setup_access, next_calls, setup_complete, workspace_ready, setup_paused }"
      },
      "known": {
       "type": "object",
       "description": "What the account already has: { pursuits, connections, profile, devices }"
      },
      "native": {
       "type": "object",
       "description": "The account's computers: { computers: [{computer_id, reported_at}], cards: {agent_id: card}, truncated? }"
      },
      "lens": {
       "type": "object",
       "description": "The person's pursuit lens: { opening, parts, closing, rows }"
      },
      "entry": {
       "type": "string",
       "description": "The entry point id the person started from"
      },
      "came_from": {
       "type": "object",
       "description": "The page recorded when the account was made: { from }"
      }
     }
    },
    "output_schema": {
     "type": "object",
     "required": [
      "result"
     ],
     "properties": {
      "result": {
       "type": "object",
       "required": [
        "schema",
        "workflow",
        "read_call"
       ],
       "properties": {
        "schema": {
         "const": "trillion.setup-plan/v1"
        },
        "workflow": {
         "type": "object"
        },
        "read_call": {
         "type": "object"
        },
        "next_calls": {
         "type": "array"
        },
        "install": {
         "type": "object"
        },
        "entry_point": {
         "type": "object"
        }
       }
      }
     }
    },
