    "kind": "ai-tool-descriptor",
    "id": "tool:start-or-resume-the-first-setup",
    "label": "Start or resume the first setup",
    "status": "active",
    "job": "Say what starting or resuming a new person's first setup does next: the ordered owner calls, each with the read-back to make after it",
    "description": "Given the account's saved setup run, its access prerequisites and the Workshop tool ids the caller found, return what starting or resuming the setup does, as an ordered list of steps. Each step names its owner tool and the call the caller makes; a step whose owner is not in available_tools is marked unavailable and is never called. Each called step carries a read_back (tool:read-setup) to run after it; done_steps are the steps already read back. A stopped setup is not restarted unless restart is true; a failed or stuck run resumes with its run_id; a finished run has no steps. Writes nothing: the caller runs the calls. Port of old trillion setup-runtime ensure().",
    "input_schema": {
     "type": "object",
     "required": [
      "account_id",
      "available_tools",
      "runtime"
     ],
     "additionalProperties": false,
     "properties": {
      "account_id": {
       "type": "string",
       "description": "The account whose setup this is"
      },
      "available_tools": {
       "type": "array",
       "items": {
        "type": "string"
       },
       "description": "The Workshop tool ids the caller found in the catalogue"
      },
      "runtime": {
       "type": "object",
       "description": "The saved setup run: { workflow: { exists, state, run_id? } }"
      },
      "prerequisites": {
       "type": "object",
       "description": "The account's access prerequisites; setup_paused true stops the setup"
      },
      "done_steps": {
       "type": "array",
       "items": {
        "type": "string",
        "enum": [
         "defaults",
         "event_intake",
         "workflow",
         "timed_work"
        ]
       },
       "description": "Steps already called and read back"
      },
      "restart": {
       "type": "boolean",
       "description": "true starts a setup the person paused"
      }
     }
    },
    "output_schema": {
     "type": "object",
     "required": [
      "result"
     ],
     "properties": {
      "result": {
       "type": "object",
       "required": [
        "schema",
        "action",
        "steps",
        "next",
        "wrote"
       ],
       "properties": {
        "schema": {
         "const": "trillion.setup-start/v1"
        },
        "action": {
         "enum": [
          "start",
          "resume",
          "stopped",
          "finished"
         ]
        },
        "steps": {
         "type": "array"
        },
        "next": {
         "type": [
          "string",
          "null"
         ]
        },
        "wrote": {
         "const": false
        }
       }
      }
     }
