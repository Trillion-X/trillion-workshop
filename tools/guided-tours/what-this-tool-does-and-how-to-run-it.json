    "status": "active",
    "job": "Decide whether a guided-tour step has met its advance condition: tapped next, touched the highlighted thing, answered, watched enough of a video, waited long enough, finished an embedded form, or a fact someone looked up has the right value",
    "description": "Give the step's advance condition ({ op, args }) and what is known now (signals: next_tapped, target_interacted, answer, media_ratio from 0 to 1, elapsed_ms, surface_completion_refs, owner_readbacks keyed by the fact's ref). Ops: tap-next, target-interacted, answer-given, media-watched (args.min_ratio, default 1), timeout (args.ms), surface-completed (args.completion_ref), owner-readback (args.readback_ref, answer_fact_ref or objective_answer_ref, with required_values_present, required_nonempty, required_answer_values, accepted_states or required_states), and all-of / any-of over a list in args.of, nested as deep as written (an empty all-of is false). Every threshold is in the condition. An op that is not defined answers false, so a typo never pushes a person on; they can still move on by hand.",
    "input_schema": {
     "type": "object",
     "required": ["condition"],
     "additionalProperties": false,
     "properties": {
      "condition": { "type": "object", "required": ["op"], "description": "{ op, args? }" },
      "signals": { "type": "object", "description": "What is known now about the step" }
     }
    },
    "output_schema": {
     "type": "object",
     "required": ["may_advance"],
     "properties": { "may_advance": { "type": "boolean" } }
    },
