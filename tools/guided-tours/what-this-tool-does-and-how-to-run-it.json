    "kind": "ai-tool-descriptor",
    "id": "tool:step-through-a-guided-tour",
    "label": "Move a person through a guided tour, quiz or spotlight",
    "status": "active",
    "job": "Work out where a person is in a guided tour, walkthrough, spotlight or branching quiz after they start, go on, answer, go back, jump to a step or restart",
    "description": "Give the tour (an ordered list of steps with an entry step; a step may route by the person's answer with a branch_map of by_answer routes and a default_next) and one action: start or restart, advance (with the person's answer when the step asks one), back, or jump (with step_id). The cursor from the last answer goes back in with every action but start and restart. The answer is the new cursor (current_step_id, the history of steps visited, and status active or complete), the whole current step exactly as the tour author wrote it (what it shows and where it points are the author's and pass through untouched) and whether the tour has finished. Going on from the last step, or along a route to a step the tour does not have, finishes the tour and the cursor stays on the last step shown. Going back undoes exactly, even across a branch. Nothing is kept between calls; the caller keeps the cursor.",
    "input_schema": {
     "type": "object",
     "required": ["tour", "action"],
     "additionalProperties": false,
     "properties": {
      "tour": { "type": "object", "description": "The tour record: entry_step and steps (each with an id, and optionally a branch_map)" },
      "action": { "type": "string", "enum": ["start", "restart", "advance", "back", "jump"] },
      "cursor": { "type": "object", "description": "The cursor from the last answer: { current_step_id, history, status }; not needed for start or restart" },
      "answer": { "type": "string", "description": "The person's answer, for a step that routes by answer" },
      "step_id": { "type": "string", "description": "The step to go to, for jump" }
     }
    },
    "output_schema": {
     "type": "object",
     "required": ["cursor", "step", "finished"],
     "properties": {
      "cursor": {
       "type": "object",
       "required": ["current_step_id", "history", "status"],
       "properties": {
        "current_step_id": { "type": "string" },
        "history": { "type": "array", "items": { "type": "string" } },
        "status": { "type": "string", "enum": ["active", "complete"] }
       }
      },
      "step": { "type": ["object", "null"], "description": "The current step as written in the tour" },
      "finished": { "type": "boolean" }
     }
    },
    "invoke": {
     "kind": "container",
     "files": { "package_files": { "package": "guided-tours", "paths": ["do-work"], "at": "/opt/guided-tours" } },
     "workdir": "/opt/guided-tours",
     "stdout": "json",
     "run": ["node", "do-work/tours.mjs", "step"],
     "stdin": { "fill": { "from": "input" } }
    },
    "result_selector": "$.result",
    "needs": { "expected_seconds": 1, "network_egress": false, "memory_mb": 128 },
    "licence_class": "licence:maker-own",
    "placements": ["placement:small-container"],
    "maker": "maker:guided-tours",
    "provenance": { "source": "ported from the guided-overlay package (cursor machine and branch resolver)" },
    "verify": [
     {
      "kind": "sample-run",
      "input": {
       "tour": { "entry_step": "hello", "steps": [{ "id": "hello", "branch_map": { "by_answer": { "baker": "oven" }, "default_next": "menu" } }, { "id": "menu" }, { "id": "oven" }] },
       "action": "advance",
       "cursor": { "current_step_id": "hello", "history": [], "status": "active" },
       "answer": "baker"
      },
      "output_selector": "$.cursor.current_step_id",
      "contains": "oven"
     }
    ]
   }
  },
