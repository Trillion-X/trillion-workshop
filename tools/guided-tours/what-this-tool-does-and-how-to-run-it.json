    "kind": "ai-tool-descriptor",
    "id": "tool:find-the-event-that-starts-one-tour",
    "label": "Find the event that starts or replays one guided tour",
    "status": "active",
    "job": "Work out the event a Start or Replay control should send to run one named guided tour on demand",
    "description": "Give the tour records (oldest first) and the id of the tour. Of that tour's triggers, the most specific repeatable one is chosen: a trigger bound to this tour's id and with no once_key first, then one not bound to a tour, then the ones that can be used up. A trigger bound to a different tour is never chosen. The event is the trigger's event kind and its match fields, copied as written, with walkthrough_id set to the tour. Null when the tour has no usable trigger. A tour that is not among the records is refused.",
    "input_schema": {
     "type": "object",
     "required": ["tours", "tour_id"],
     "additionalProperties": false,
     "properties": {
      "tours": { "type": "array", "description": "The tour records, oldest first" },
      "tour_id": { "type": "string", "description": "The tour to start" }
     }
    },
    "output_schema": {
     "type": "object",
     "required": ["event"],
     "properties": { "event": { "type": ["object", "null"] } }
    },
    "invoke": {
     "kind": "container",
     "files": { "package_files": { "package": "guided-tours", "paths": ["do-work"], "at": "/opt/guided-tours" } },
     "workdir": "/opt/guided-tours",
     "stdout": "json",
     "run": ["node", "do-work/tours.mjs", "start-event"],
     "stdin": { "fill": { "from": "input" } }
    },
    "result_selector": "$.result",
    "needs": { "expected_seconds": 1, "network_egress": false, "memory_mb": 128 },
    "licence_class": "licence:maker-own",
    "placements": ["placement:small-container"],
    "maker": "maker:guided-tours",
    "provenance": { "source": "ported from the guided-overlay package (start event for a walkthrough)" },
