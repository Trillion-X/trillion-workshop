    "id": "tool:find-the-tour-an-event-starts",
    "label": "Find which guided tour an event starts",
    "status": "active",
    "job": "Decide which guided tour, if any, should start when something happens in an app (it opened, a page was entered, a replay was asked for), without showing a tour that was already seen",
    "description": "Give the tour records in the order they were written (a later record at the same id replaces an earlier one; one marked status deleted removes it; records that are not tours are skipped), the event ({ event_kind, plus any fields }) and the suppression keys already used up. A trigger fires on one event kind and only when every field in its match equals the event's. The first trigger in the order written, over the tours in id order, whose key is not used up wins. The answer names the tour, the trigger with its reason exactly as written, and the key to record so the tour does not start again (scoped by once_key_fields of the event when the trigger names them, so one person's tour being used up leaves another's); a trigger with no once_key has no key and can fire every time. When nothing fires all three are null.",
    "input_schema": {
     "type": "object",
     "required": ["tours", "event"],
     "additionalProperties": false,
     "properties": {
      "tours": { "type": "array", "description": "The tour records, oldest first" },
      "event": { "type": "object", "required": ["event_kind"], "description": "What happened: { event_kind, ...fields }" },
      "consumed_keys": { "type": "array", "items": { "type": "string" }, "description": "Suppression keys already used up" }
     }
    },
    "output_schema": {
     "type": "object",
     "required": ["tour_id", "trigger", "suppression_key"],
     "properties": {
      "tour_id": { "type": ["string", "null"] },
      "trigger": { "type": ["object", "null"] },
      "suppression_key": { "type": ["string", "null"] }
     }
    },
    "invoke": {
     "kind": "container",
     "files": { "package_files": { "package": "guided-tours", "paths": ["do-work"], "at": "/opt/guided-tours" } },
     "workdir": "/opt/guided-tours",
     "stdout": "json",
     "run": ["node", "do-work/tours.mjs", "find"],
     "stdin": { "fill": { "from": "input" } }
    },
    "result_selector": "$.result",
    "needs": { "expected_seconds": 1, "network_egress": false, "memory_mb": 128 },
    "licence_class": "licence:maker-own",
    "placements": ["placement:small-container"],
    "maker": "maker:guided-tours",
    "provenance": { "source": "ported from the guided-overlay package (trigger intake and tour record fold)" },
    "verify": [
     {
      "kind": "sample-run",
      "input": {
       "tours": [{ "kind": "walkthrough-definition", "id": "tour:welcome", "entry_step": "a", "steps": [{ "id": "a" }], "triggers": [{ "reason": "first-visit", "on_event": { "event_kind": "shop-opened" }, "once_key": "tour:welcome" }] }],
       "event": { "event_kind": "shop-opened" }
      },
      "output_selector": "$.tour_id",
      "contains": "tour:welcome"
     }
    ]
   }
  },
