{
 "kind": "tool-rows",
 "record_set": "decide-with-a-method-tool-rows",
 "what_this_is": "The Workshop rows for the tools in tools/decide-with-a-method: decisions a person's AI makes with a method, kept as the person's own decision records.",
 "records": [
  {
   "payload": {
    "kind": "ai-tool-descriptor",
    "id": "tool:bring-back-similar-decisions",
    "label": "Bring back my similar decisions",
    "job": "When I am about to decide something, show what I decided in similar decisions before, what came next and how each turned out",
    "description": "Reads the person's own decision records. The newest ones are weighed by the words their goals share with the named decision's goal, plus a point for the same method (read-data/decide-with-a-method.json `similar`). The closest are kept, closest first, limit of them (10 when not given, never more than 50). Each comes back with its goal, its method, the option it chose, its next action, its status (from its own current evidence) and its observed and reported results. Only those few are read whole, and nothing leaves the person's account.",
    "status": "active",
    "result_selector": "$.result",
    "input_schema": {
     "type": "object",
     "required": [
      "decision_id"
     ],
     "additionalProperties": false,
     "properties": {
      "decision_id": {
       "type": "string",
       "minLength": 1,
       "description": "The decision about to be made"
      },
      "limit": {
       "type": "integer",
       "minimum": 1,
       "maximum": 50,
       "description": "How many to bring back"
      }
     }
    },
    "output_schema": {
     "type": "object",
     "required": [
      "similar_decisions"
     ],
     "properties": {
      "similar_decisions": {
       "type": "array",
       "items": {
        "type": "object",
        "required": [
         "case_id",
         "goal",
         "method",
         "decision",
         "next_action",
         "status",
         "observed",
         "reported"
        ]
       }
      }
     }
    },
    "invoke": {
     "kind": "container",
     "internet": false,
     "workdir": "/opt/decide-with-a-method",
     "stdout": "json",
     "argv": [
      "node",
      "/opt/records-door/do-work/run-an-export.mjs",
      "/opt/decide-with-a-method/read-data/similar-decisions.mjs",
      "similarDecisions"
     ],
     "stdin": {
      "fill": {
       "from": "input"
      }
     },
     "files": {
      "package_files": [
       {
        "package": "decide-with-a-method",
        "paths": [
         "read-data"
        ],
        "at": "/opt/decide-with-a-method"
       },
       {
        "package": "records-door",
        "paths": [
         "do-work",
         "read-data"
        ],
        "at": "/opt/records-door"
       },
       {
        "package": "content-identity",
        "paths": [
         "read-data"
        ],
        "at": "/opt/content-identity"
       },
       {
        "module": "@noble/hashes",
        "paths": [
         "LICENSE",
         "package.json",
         "blake3.js",
         "blake2.js",
         "_blake.js",
         "_md.js",
         "_u64.js",
         "utils.js"
        ],
        "at": "/opt/node_modules/@noble/hashes"
       }
      ]
     },
     "records": {
      "fd": 3,
      "rights": [
       {
        "kind": "decision",
        "operations": [
         "records:read",
         "records:list"
        ]
       }
      ]
     }
    },
    "needs": {
     "expected_seconds": 20,
     "network_egress": false,
     "memory_mb": 256
    },
    "licence_class": "licence:maker-own",
    "placements": [
     "placement:small-container"
    ],
    "maker": "maker:decide-with-a-method"
   }
  },
