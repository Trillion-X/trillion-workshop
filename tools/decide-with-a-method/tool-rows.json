   "payload": {
    "kind": "ai-tool-descriptor",
    "id": "tool:report-a-decision-result",
    "label": "Report how a decision turned out",
    "job": "Tell Trillion how a decision actually turned out, in my words",
    "description": "Keeps the person's result of a decided decision: result (met, failed or unknown), summary, answered_by \"person\" (ask them). A failed result opens the decision for a new one. The same words again are kept once; source_ref and supersedes correct an earlier report. A claim is kept as the caller's claim; nothing here marks it verified.",
    "status": "active",
    "result_selector": "$.result",
    "input_schema": {
     "type": "object",
     "required": [
      "decision_id",
      "result",
      "summary",
      "answered_by"
     ],
     "additionalProperties": false,
     "properties": {
      "decision_id": {
       "type": "string",
       "minLength": 1
      },
      "result": {
       "type": "string",
       "enum": [
        "met",
        "failed",
        "unknown"
       ]
      },
      "summary": {
       "type": "string",
       "minLength": 1
      },
      "answered_by": {
       "type": "string",
       "const": "person"
      },
      "source_ref": {
       "type": "string",
       "minLength": 1
      },
      "supersedes": {
       "type": "string",
       "minLength": 1
      },
      "observed_at": {
       "type": "string",
       "description": "When it was seen, at or before now"
      },
      "expected_generation": {
       "type": "integer",
       "minimum": 1
      }
     }
    },
    "output_schema": {
     "type": "object",
     "required": [
      "case_id"
     ],
     "properties": {
      "case_id": {
       "type": "string"
      }
     }
