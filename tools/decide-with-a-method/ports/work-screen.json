  }
 ],
 "preserve": [
  "a bounded page carries collection_coverage: its limit and whether more decisions, pursuits or plans exist; full-history statistics are never approximated from a page",
  "a decision summary's status and result come from the current evidence of its current generation; a person's report with no signed-in source never counts as checked",
  "progress counts only the steps the decision's own facts show (decision-progress.json) and names the furthest",
  "a check is revised when a refusal named it or the answer says it changed it, skipped when handled is false, refused while a refusal has no accepted answer",
  "a pursuit's parents and children come from the links and the person's record-scope choice rows; a removed link (not) and a pursuit no longer current are left out",
  "a limited access that does not keep decisions answers free with nothing listed; metadata reads no decision",
  "the optional Space pursuit read is bounded and never holds the screen"
 ],
 "allowed_deltas": [
  "the rows are read through the records door (seeMyDecisions) once, and the moved screen reads them from there",
  "access and allowance are what the caller's place reports (input), not an account owner this folder has no door to",
  "the check questions are the person's own method-check rows, not a checks file",
  "a decision's status and result use decision-outcome.mjs with the decision tools' precedence setting",
  "a checklist kept as { checks } (the decision tools' layout) is read as its list",
  "one bounded page also answers helped_check_text, agent_work and next_before, and each helped item keeps its decision's id, as the engine's copy did"
 ],
 "banned_substitutions": [
  "a second reader of the person's decisions with its own status or outcome rules",
  "a checks file or a words file copied into this folder in place of the person's rows",
  "an allowance or limit invented when the place reports none"
 ],
