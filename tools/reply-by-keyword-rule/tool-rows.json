                "at": "/opt/node_modules/@noble/hashes"
              },
              {
                "package": "browse-and-upload-my-files",
                "paths": [
                  "built-stored-bytes/content-chunks/content_chunks.js",
                  "do-work/content-chunks.mjs",
                  "do-work/namespace-client.mjs",
                  "do-work/send-a-file-to-a-namespace.mjs",
                  "do-work/send-retry.mjs",
                  "do-work/send-window.mjs",
                  "do-work/shared-file-reference.mjs",
                  "send-settings.json"
                ],
                "at": "/opt/browse-and-upload-my-files"
              }
            ]
          },
          "workdir": "/opt/reply-by-keyword-rule",
          "internet": true,
          "stdout": "json",
          "argv": [
            "node",
            "/opt/records-door/do-work/run-an-export.mjs",
            "/opt/reply-by-keyword-rule/do-work/send-a-reply.mjs",
            "sendAReply"
          ],
          "stdin": {
            "fill": {
              "from": "input"
            }
          },
          "connection": {
            "vendor": "instagram",
            "from_input": "account_id"
          },
          "credential_mounts": [
            {
              "field_id": "access_token",
              "fd": 4
            }
          ]
        },
        "result_selector": "$.result",
        "verify": [
          {
            "kind": "sample-run",
            "input": {
              "account_id": "service_connection:instagram:account-one",
              "decision": {
                "place": "reply-place:instagram",
                "action": "send",
                "kind": "dm",
                "key": "msg-1:rule:prices",
                "message_id": "msg-1",
                "recipient": {
                  "id": "visitor-1"
                },
                "reply_text": "Hi, the price list is here.",
                "created_time": "2099-01-01T00:00:00.000Z"
              }
            },
            "held": {
              "access_token": "sample-held-token"
            },
            "replies": [
              {
                "request": {
                  "method": "POST",
                  "url": "https://graph.instagram.com/v21.0/me/messages"
                },
                "status": 200,
                "body": {
                  "recipient_id": "visitor-1",
                  "message_id": "mid-1"
                }
              }
            ],
            "shape_read_at": "2026-11-13"
          }
        ]
      }
    },
