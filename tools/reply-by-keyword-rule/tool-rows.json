        "id": "tool:send-a-reply-on-instagram",
        "label": "Send a reply on Instagram",
        "job": "Send one chosen automatic reply to one Instagram message or comment, once, while its place's window, if it sets one, is still open",
        "description": "Give account_id and one decision from tool:decide-the-replies whose action is send. The place row's request for the decision's channel is sent (read-data/reply-places.json), the window is checked again at the moment of sending: a closed window sends nothing. The reply's reply-kept row is in the answer (`keep`: sent, failed or not-known) for the person's AI to keep, and the rows already held are given in `kept`: a key in them is never sent again; if no answer comes back the reply is not-known for a person to look at, and it is not retried. The account's held token is placed only on the request, only to the place's own hosts, never kept or answered. It posts publicly on the person's account: run it only for replies the person's rules chose.",
        "input_schema": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "account_id",
            "decision"
          ],
          "properties": {
            "account_id": {
              "type": "string",
              "description": "One of the person's Instagram accounts, service_connection:instagram or service_connection:instagram:<account>"
            },
            "decision": {
              "type": "object",
              "description": "One decision from tool:decide-the-replies whose action is send"
            },
            "kept": {
              "type": "array",
              "items": {
                "type": "object"
              },
              "description": "The person's reply-kept rows already held, each { id?, value: { key, place, state } }; a decision whose key is in them is never sent again"
            }
          }
        },
        "output_schema": {
          "type": "object",
          "required": [
            "status",
            "key"
          ],
          "properties": {
            "status": {
              "type": "string"
            },
            "key": {
              "type": "string"
            },
            "keep": {
              "type": "object",
              "description": "The reply-kept row for this reply { id, type, value: { key, place, account_id, state } }, for the person's AI to keep; absent when nothing was sent or tried"
            }
          }
        },
        "invoke": {
          "refresh": {
            "token_url": "https://graph.instagram.com/refresh_access_token",
            "asked": {
              "method": "GET",
              "grant_type": "ig_refresh_token",
              "token_param": "access_token"
            },
            "client_auth": "none",
            "margin_ms": 864000000,
            "when_expiry_unknown": true,
            "access_field": "access_token",
            "token_paths": [
              [
                "access_token"
              ]
            ],
            "expires_path": [
              "expires_in"
            ],
            "refresh": {
              "field": "access_token",
              "token_paths": []
            }
          },
          "kind": "container",
          "files": {
            "package_files": [
              {
                "package": "reply-by-keyword-rule",
                "paths": [
                  "do-work",
                  "read-data"
                ],
                "at": "/opt/reply-by-keyword-rule"
              },
              {
                "package": "formula-engine",
                "paths": [
                  "rules",
                  "built-stored-bytes"
                ],
                "at": "/opt/node_modules/trillion-workshop/tools/formula-engine"
              },
              {
                "package": "reply-templates",
                "paths": [
                  "read-data/expand.mjs"
                ],
                "at": "/opt/reply-templates"
              },
              {
                "package": "pull-from-connected-accounts",
                "paths": [
                  "read-data/snapshot.mjs"
                ],
                "at": "/opt/pull-from-connected-accounts"
              },
              {
                "package": "records-door",
                "paths": [
                  "do-work",
                  "read-data"
                ],
                "at": "/opt/records-door"
              },
              {
                "package": "content-identity",
                "paths": [
                  "read-data"
                ],
