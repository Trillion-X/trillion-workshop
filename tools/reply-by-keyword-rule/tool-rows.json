{
  "kind": "tool-rows",
  "record_set": "reply-by-keyword-rule-tool-rows",
  "what_this_is": "The Workshop rows for automatic replies by keyword rule (tools/reply-by-keyword-rule): decide which reply to send for any place a row names (read-data/reply-places.json), then send it once with that place's send row.",
  "records": [
    {
      "id": "package::reply-by-keyword-rule::tool::decide-the-replies",
      "address": "package::reply-by-keyword-rule::tool::decide-the-replies",
      "path": [
        "current-item",
        "published-record"
      ],
      "payload": {
        "kind": "ai-tool-descriptor",
        "status": "active",
        "licence_class": "licence:maker-own",
        "placements": [
          "placement:small-container"
        ],
        "maker": "maker:reply-by-keyword-rule",
        "needs": {
          "expected_seconds": 20,
          "network_egress": false,
          "memory_mb": 256
        },
        "read_only": true,
        "id": "tool:decide-the-replies",
        "label": "Decide the replies",
        "job": "Say which automatic reply to send now to each message or comment a person received on one of their connected places, by their keyword rules, and which to leave and why",
        "description": "Says for each item of one place whether a rule's reply is to be sent now, from what the request holds: the person's reply rules (their reply-rule rows, in order), the place's row (read-data/reply-places.json: where its items come from, whose words are the person's own, how long a reply is allowed, who it goes to), the items of that place handed in as pulled.<channel id> (a channel with nothing handed in is named under not_pulled), the person's own id at the place (self_id) and the replies already kept (their reply-kept rows). The rule must match, the item must be someone else's, and the place's window, if it sets one, must still be open. A reply already kept is never chosen again. The person's AI reads those rows from their store and gives them; the tool reads nothing, sends nothing and keeps nothing: the place's send row (its send_tool) sends one chosen reply.",
        "input_schema": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "place",
            "rules",
            "self_id"
          ],
          "properties": {
            "place": {
              "type": "string",
              "description": "The place's row id in reply-places.json, for example reply-place:instagram or reply-place:youtube"
            },
            "pulled": {
              "type": "object",
              "description": "The items of the place by channel id. A channel that answers pulled threads gets an array of threads { id, messages: [...] }; a channel that answers a pull tool's answers gets an array of those answers (one per page or video)"
            },
            "now": {
              "type": "string",
              "description": "The time to judge the windows at, an ISO time; default the time now"
            },
            "rules": {
              "type": "array",
              "items": {
                "type": "object"
              },
              "description": "The person's reply-rule rows, each { id?, value: { id, enabled, words, mode, reply, order } }"
            },
            "self_id": {
              "type": "string",
              "description": "The person's own id at the place (their pulled account id, or the field of their connection the place row names); their own words are never answered"
            },
            "kept": {
              "type": "array",
              "items": {
                "type": "object"
              },
              "description": "The person's reply-kept rows already held, each { id?, value: { key, place, state } }; a key in them is never chosen again"
            }
          }
        },
        "output_schema": {
          "type": "object",
          "required": [
            "place",
            "decisions"
          ],
          "properties": {
            "place": {
              "type": "string"
            },
            "decisions": {
              "type": "array"
            },
            "not_pulled": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "invoke": {
          "kind": "container",
          "files": {
            "package_files": [
              {
                "package": "reply-by-keyword-rule",
                "paths": [
                  "do-work",
                  "read-data"
                ],
                "at": "/opt/reply-by-keyword-rule"
              },
              {
                "package": "formula-engine",
                "paths": [
                  "rules",
                  "built-stored-bytes"
                ],
                "at": "/opt/node_modules/trillion-workshop/tools/formula-engine"
              },
              {
                "package": "reply-templates",
                "paths": [
                  "read-data/expand.mjs"
                ],
                "at": "/opt/reply-templates"
              },
              {
                "package": "records-door",
                "paths": [
                  "do-work",
                  "read-data"
                ],
                "at": "/opt/records-door"
              },
              {
                "package": "content-identity",
                "paths": [
                  "read-data"
                ],
                "at": "/opt/content-identity"
              },
              {
                "packages": [
                  "node_modules/@noble/hashes"
                ],
                "paths": [
                  "LICENSE",
                  "package.json",
                  "blake3.js",
                  "blake2.js",
                  "_blake.js",
                  "_md.js",
                  "_u64.js",
                  "utils.js"
                ],
                "at": "/opt/node_modules/@noble/hashes"
              },
              {
                "package": "browse-and-upload-my-files",
                "paths": [
                  "built-stored-bytes/content-chunks/content_chunks.js",
                  "do-work/content-chunks.mjs",
                  "do-work/namespace-client.mjs",
                  "do-work/send-a-file-to-a-namespace.mjs",
                  "do-work/send-retry.mjs",
                  "do-work/send-window.mjs",
                  "do-work/shared-file-reference.mjs",
                  "send-settings.json"
                ],
                "at": "/opt/browse-and-upload-my-files"
              }
            ]
          },
          "workdir": "/opt/reply-by-keyword-rule",
          "internet": false,
          "stdout": "json",
          "argv": [
            "node",
            "/opt/records-door/do-work/run-an-export.mjs",
            "/opt/reply-by-keyword-rule/do-work/decide-the-replies.mjs",
            "decideTheReplies"
          ],
          "stdin": {
            "fill": {
              "from": "input"
            }
          }
        },
        "result_selector": "$.result",
        "verify": [
          {
            "kind": "sample-run",
            "input": {
              "place": "reply-place:instagram",
              "now": "2026-11-12T12:00:00.000Z",
              "self_id": "owner-1",
              "pulled": {
                "dm": [
                  {
                    "id": "thread-1",
                    "title": "thread-1",
                    "messages": [
                      {
                        "id": "msg-1",
                        "from": {
                          "id": "visitor-1"
                        },
                        "created_time": "2026-11-12T11:55:00.000Z",
                        "message": "what is the price"
                      }
                    ]
                  }
                ]
              },
              "rules": [
                {
                  "id": "reply-rule:prices",
                  "type": "reply-rule",
                  "value": {
                    "id": "rule:prices",
                    "enabled": "on",
                    "words": [
                      "price"
                    ],
                    "mode": "any",
                    "reply": "Hi, the price list is here."
                  }
                }
              ]
            }
          }
        ]
      }
    },
