  {
   "payload": {
    "uses_tools": [],
    "kind": "ai-tool-descriptor",
    "id": "tool:read-a-booking-page",
    "label": "Read a booking page",
    "job": "Read one live booking page: its title, time zone, session length, windows and the questions its form asks",
    "description": "Answers the booking page named by page from the pursuit database (booking_pages and the form it names in form_rows): its title, time zone, minutes per session, the windows it offers, how many days ahead and the minimum notice, and its questions in the form's order. A page that is not live, has no windows or has no questions is refused by name. The open times are not read here: the booking routes answer them. The answer is the props of show/BookingPage.tsx.",
    "status": "active",
    "read_only": true,
    "result_selector": "$",
    "input_schema": {
     "type": "object",
     "required": [
      "database",
      "page"
     ],
     "additionalProperties": false,
     "properties": {
      "database": {
       "type": "string",
       "minLength": 1,
       "description": "The name of the pursuit database to read, bound by the trusted caller. The engine opens it with the login its vault holds as that name and -connection; no caller supplies a login."
      },
      "use": {
       "type": "object",
       "additionalProperties": false,
       "required": [
        "purpose",
        "surface"
       ],
       "description": "The use this statement runs for: a recipe step's declared purpose and surface (config.context.use, set by the workflow engine over any use the step's input carried). Given with database, the computer opens the database with its reader login (one that cannot get round the row rules, change a table or read the use binding) instead of the owner's, and hands the run a ticket of this use that it signed; the statement's transaction claims it first, so the database's row rules read this use and the statement cannot change it. A use with credential_name, which has no ticket, is refused. Absent: the owner's own work, read under the database's own purpose_when_unstated.",
       "properties": {
        "purpose": {
         "type": "string",
         "description": "The purpose path, such as publish or coach/review."
        },
        "surface": {
         "type": "string",
         "description": "The surface path, such as social/instagram; empty for any surface."
        }
       }
      },
      "page": {
       "type": "string",
       "minLength": 1,
       "maxLength": 200,
       "description": "The booking page's slug."
      }
     }
    },
    "output_schema": {
     "type": "object",
     "required": [
      "page",
      "title",
      "timezone",
      "duration_minutes",
      "questions"
     ],
     "properties": {
      "page": {
       "type": "string"
      },
      "title": {
       "type": "string"
      },
      "timezone": {
       "type": "string"
      },
      "duration_minutes": {
       "type": "integer"
      },
