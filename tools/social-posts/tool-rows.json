    "label": "Posting calendar",
    "job": "Show what this person is posting between two times, and which drafts have no time yet, so a post can be given a time or moved to another",
    "description": "Give from and to (dates and times with their zone). Returns posts: each post whose scheduled time falls in between (or, sent without a time, when it was sent), earliest first, with at, status, words and can_move; and unscheduled: the drafts and approved posts with no time yet. A post gets a new time through draft_post with post_id and scheduled_for, which makes an approved or scheduled post a draft again to approve. Its screen is the month and hour calendar, where a post is dragged to its time.",
    "input_schema": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "from",
      "to"
     ],
     "properties": {
      "from": {
       "type": "string",
       "format": "date-time",
       "description": "The start of the span, like 2026-10-01T00:00:00-04:00"
      },
      "to": {
       "type": "string",
       "format": "date-time",
       "description": "The end of the span, after from"
      }
     }
    },
    "output_schema": {
     "type": "object",
     "required": [
      "from",
      "to",
      "posts",
      "unscheduled"
     ],
     "properties": {
      "from": {
       "type": "string"
      },
      "to": {
       "type": "string"
      },
      "posts": {
       "type": "array",
       "items": {
        "type": "object"
       }
      },
      "unscheduled": {
       "type": "array",
       "items": {
        "type": "object"
       }
      }
     }
    },
    "invoke": {
     "kind": "container",
     "files": {
      "package_files": [
       {
        "package": "social-posts",
        "paths": [
         "read-data"
        ],
        "at": "/opt/social-posts"
       },
       {
        "package": "records-door",
        "paths": [
         "do-work",
         "read-data"
        ],
        "at": "/opt/records-door"
       }
      ]
     },
     "workdir": "/opt/social-posts",
