      "id": "post-place:beehiiv",
      "send_tool": "tool:send-a-post-to-beehiiv",
      "platform": "beehiiv",
      "label": "beehiiv",
      "adapter": "requests",
      "connection_vendor": "beehiiv",
      "options": {
        "platform": "beehiiv",
        "account": {
          "plain": "publication_id"
        },
        "steps": [
          {
            "id": "created",
            "operation": "beehiiv.posts.create",
            "method": "POST",
            "url": {
              "join": [
                "https://api.beehiiv.com/v2/publications/",
                {
                  "plain": "publication_id"
                },
                "/posts"
              ]
            },
            "headers": {
              "authorization": {
                "join": [
                  "Bearer ",
                  {
                    "held": "api_key"
                  }
                ]
              }
            },
            "body": {
              "title": {
                "setting": "title"
              },
              "subtitle": {
                "setting": "subtitle",
                "optional": true
              },
              "body_html": {
                "post": "words",
                "markup": "html"
              },
              "status": "confirmed"
            },
            "goes_public": true,
            "needs": [
              "data.id"
            ]
          },
          {
            "id": "read",
            "operation": "beehiiv.posts.read",
            "url": {
              "join": [
                "https://api.beehiiv.com/v2/publications/",
                {
                  "plain": "publication_id"
                },
                "/posts/",
                {
                  "step": "created",
                  "at": "data.id"
                }
              ]
            },
            "headers": {
              "authorization": {
                "join": [
                  "Bearer ",
                  {
                    "held": "api_key"
                  }
                ]
              }
            },
            "same": [
              [
                {
                  "step": "read",
                  "at": "data.id"
                },
                {
                  "step": "created",
                  "at": "data.id"
                }
              ]
            ]
          }
        ],
        "post_id": {
          "step": "created",
          "at": "data.id"
        },
        "url": {
          "step": "read",
          "at": "data.web_url"
        }
      },
      "account": {
        "plain": "publication_id"
      },
      "hosts": [
        "api.beehiiv.com"
