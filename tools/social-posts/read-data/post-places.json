        "account": {
          "plain": "site_url"
        },
        "steps": [
          {
            "id": "created",
            "operation": "ghost.posts.create",
            "method": "POST",
            "url": {
              "join": [
                {
                  "plain": "site_url"
                },
                "/ghost/api/admin/posts/?source=html"
              ]
            },
            "headers": {
              "authorization": {
                "join": [
                  "Ghost ",
                  {
                    "held": "admin_api_key",
                    "sign": {
                      "kind": "jwt-hs256",
                      "claims": {
                        "aud": "/admin/"
                      },
                      "seconds": 300
                    }
                  }
                ]
              }
            },
            "body": {
              "posts": [
                {
                  "title": {
                    "setting": "title"
                  },
                  "html": {
                    "post": "words",
                    "markup": "html"
                  },
                  "status": "published",
                  "custom_excerpt": {
                    "setting": "excerpt",
                    "optional": true
                  }
                }
              ]
            },
            "goes_public": true,
            "needs": [
              "posts.0.id"
            ]
          },
          {
            "id": "read",
            "operation": "ghost.posts.read",
            "url": {
              "join": [
                {
                  "plain": "site_url"
                },
                "/ghost/api/admin/posts/",
                {
                  "step": "created",
                  "at": "posts.0.id"
                },
                "/?formats=html"
              ]
            },
            "headers": {
              "authorization": {
                "join": [
                  "Ghost ",
                  {
                    "held": "admin_api_key",
                    "sign": {
                      "kind": "jwt-hs256",
                      "claims": {
                        "aud": "/admin/"
                      },
                      "seconds": 300
                    }
                  }
                ]
              }
            },
            "same": [
              [
                {
                  "step": "read",
                  "at": "posts.0.id"
                },
                {
                  "step": "created",
                  "at": "posts.0.id"
                }
              ]
            ]
          }
        ],
        "post_id": {
          "step": "created",
          "at": "posts.0.id"
        },
        "url": {
          "step": "read",
          "at": "posts.0.url"
        }
