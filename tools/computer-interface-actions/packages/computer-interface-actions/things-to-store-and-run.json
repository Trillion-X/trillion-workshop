      "type": "record",
      "address": "package::computer-interface-actions::rule::a-generic-package-may-not-define-paths-as-constants",
      "path": ["current-item", "source-file-rule"],
      "payload": {
        "kind": "source-file-rule",
        "id": "computer-interface-actions-a-generic-package-may-not-define-paths-as-constants",
        "why": "A module-level constant holding a path is provider configuration welded into generic code. Provider locations belong in DATA or executable discovery, never generic code. The structural pattern catches the class without enumerating machine-specific path prefixes.",
        "scope": {
          "path_matches": "packages/computer-interface-actions/do-work/.*\\.mjs$",
          "path_excludes": "/tests?/"
        },
        "violation": {
          "forbidden": [
            { "pattern": "const\\s+[A-Z_]+\\s*=\\s*['\"][^'\"]*/[^'\"]*['\"]" }
          ]
        },
        "message": "a module-level constant holds a filesystem path; provider locations are DATA, not code — move it to the provider JSON file"
      }
    },
    {
      "type": "record",
      "address": "package::computer-interface-actions::public-source::do-work",
