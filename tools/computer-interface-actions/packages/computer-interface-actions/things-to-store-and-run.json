        "kind": "bitfield-package-public-source",
        "source_path": "do-work",
        "contract": "computer-interface-actions do-work owns bounded computer-interface intent validation, sensitive-action approval, provider DATA planning, task-surface proof gates, and canonical compute.process_session dispatch; provider executables are runtime aliases, never ambient PATH or host paths"
      }
