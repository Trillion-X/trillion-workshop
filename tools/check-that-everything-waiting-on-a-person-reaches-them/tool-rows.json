                "paths": [
                  "src/workshop-looks.json",
                  "src/workspace"
                ],
                "at": "/opt/node_modules/trillion-workshop/tools/keep-and-wake-ai-sessions-on-this-computer"
              }
            ]
          },
          "workdir": "/opt/check-that-everything-waiting-on-a-person-reaches-them",
          "internet": false,
          "stdout": "json",
          "argv": [
            "node",
            "do-work/controls-check.mjs"
          ],
          "stdin": {
            "fill": {
              "from": "input"
            }
          }
        },
        "verify": [
          {
            "kind": "sample-run",
            "input": {
              "sections": [
                {
                  "id": "work",
                  "cards": [
                    {
                      "id": "a",
                      "title": "Allow the camera",
