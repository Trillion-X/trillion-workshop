import { describe, it, expect } from 'vitest';
import { privateObjectView, privateObjectControl } from './private-object-request';

describe('privateObjectView — one user-language state at a time', () => {
  it('null reply (in flight) → opening', () => {
    expect(privateObjectView(null)).toEqual({ kind: 'opening', message: 'Opening…' });
  });

  it('grant with url → ready (renders the player)', () => {
    const v = privateObjectView({ status: 'grant', delivery_url: '/private-material/abc', mime: 'application/pdf' });
    expect(v).toEqual({ kind: 'ready', deliveryUrl: '/private-material/abc', mime: 'application/pdf' });
  });

  it('grant without url → error (never a broken player)', () => {
    expect(privateObjectView({ status: 'grant' } as never).kind).toBe('error');
  });

  it('denied: anonymous → sign-in (authenticate), not upgrade', () => {
    expect(privateObjectView({ status: 'denied', reason: 'anonymous' })).toEqual({ kind: 'sign-in', message: 'Sign in to open this.' });
  });

  it('denied: not-entitled → upgrade (membership/purchase)', () => {
    expect(privateObjectView({ status: 'denied', reason: 'not-entitled' })).toEqual({ kind: 'upgrade', message: 'Included with your membership.' });
  });

  it('unavailable → not-ready (honest, no jargon)', () => {
    expect(privateObjectView({ status: 'unavailable', reason: 'no-bytes' })).toEqual({ kind: 'not-ready', message: 'Not available yet.' });
  });

  it('loading status → opening', () => {
    expect(privateObjectView({ status: 'loading' }).kind).toBe('opening');
  });

  it("'error' sentinel → error", () => {
    expect(privateObjectView('error').kind).toBe('error');
  });

  it('unknown/garbage reply → error (fail closed to a safe message)', () => {
    expect(privateObjectView({} as never).kind).toBe('error');
    expect(privateObjectView({ status: 'weird' } as never).kind).toBe('error');
  });

  it('copy is DATA-overridable without code change', () => {
    const v = privateObjectView({ status: 'denied', reason: 'not-entitled' }, { upgrade: 'Unlock with the full program' });
    expect(v).toEqual({ kind: 'upgrade', message: 'Unlock with the full program' });
  });

  it('no internal vocabulary leaks into any default message', () => {
    const banned = /lease|entitlement|cas|token|object_key|grant|subject|authoriz/i;
    for (const reply of [null, 'error', { status: 'loading' }, { status: 'denied', reason: 'anonymous' }, { status: 'denied', reason: 'x' }, { status: 'unavailable' }] as const) {
      const v = privateObjectView(reply as never);
      if ('message' in v) expect(v.message).not.toMatch(banned);
    }
  });
});

describe('privateObjectControl — the gated surface paints one message + at most one action', () => {
  // Real usage: the same DATA copy threads through both layers — messages are set
  // by the view, action labels by the control.
  const control = (reply: Parameters<typeof privateObjectView>[0], copy?: Parameters<typeof privateObjectControl>[1]) =>
    privateObjectControl(privateObjectView(reply, copy), copy);

  it('opening (in flight) → busy, no action (user just waits)', () => {
    expect(control(null)).toEqual({ kind: 'opening', message: 'Opening…', busy: true });
  });

  it('ready collapses to busy — host swaps in the player, gate never dead-ends', () => {
    const c = control({ status: 'grant', delivery_url: '/private-material/x', mime: 'audio/mpeg' });
    expect(c.busy).toBe(true);
    expect(c.actionKind).toBeUndefined();
  });

  it('not-ready → busy with the honest "not available yet" message, no action', () => {
    expect(control({ status: 'unavailable' })).toEqual({ kind: 'not-ready', message: 'Not available yet.', busy: true });
  });

  it('anonymous → sign-in action', () => {
    expect(control({ status: 'denied', reason: 'anonymous' })).toEqual({
      kind: 'sign-in', message: 'Sign in to open this.', busy: false, actionKind: 'sign-in', actionLabel: 'Sign in',
    });
  });

  it('not-entitled → upgrade action', () => {
    expect(control({ status: 'denied', reason: 'not-entitled' })).toEqual({
      kind: 'upgrade', message: 'Included with your membership.', busy: false, actionKind: 'upgrade', actionLabel: 'Get access',
    });
  });

  it('error → retry action', () => {
    expect(control('error')).toEqual({
      kind: 'error', message: 'Could not open this. Try again.', busy: false, actionKind: 'retry', actionLabel: 'Try again',
    });
  });

  it('action labels are DATA-overridable without code change', () => {
    const c = control({ status: 'denied', reason: 'not-entitled' }, { upgrade: 'Unlock the program', upgradeAction: 'Join now' });
    expect(c.message).toBe('Unlock the program');
    expect(c.actionLabel).toBe('Join now');
  });

  it('no internal vocabulary leaks into any control message or action label', () => {
    const banned = /lease|entitlement|cas|token|object_key|grant|subject|authoriz/i;
    for (const reply of [null, 'error', { status: 'loading' }, { status: 'denied', reason: 'anonymous' }, { status: 'denied', reason: 'x' }, { status: 'unavailable' }] as const) {
      const c = control(reply as never);
      expect(c.message).not.toMatch(banned);
      if (c.actionLabel) expect(c.actionLabel).not.toMatch(banned);
    }
  });
});
