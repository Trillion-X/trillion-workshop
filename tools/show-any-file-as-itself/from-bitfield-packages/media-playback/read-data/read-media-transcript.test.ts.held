import { describe, expect, it } from 'vitest'

import { readMediaTranscriptSegments } from './read-media-transcript'

const transcriptRecords = [{
  kind: 'screen-ready-record',
  id: 'timed-segment-row',
  role: 'transcript-segment',
  screen_ref: 'screen:tennis-library',
  section_ref: 'section:transcripts',
  payload: {
    kind: 'transcript-segment',
    id: 'segment:one',
    transcript_ref: 'transcript:lesson-one',
    text: 'Move through the ball',
    start_ms: 1200,
    end_ms: 2800,
    words: [
      { word: 'Move', start: 1.2, end: 1.5 },
      { word: 'through', start: 1.5, end: 2.1 },
      { word: 'the', start: 2.1, end: 2.3 },
      { word: 'ball', start: 2.3, end: 2.8 },
    ],
  },
}]

describe('media transcript lookup', () => {
  it('reads the published course transcript set directly', () => {
    expect(readMediaTranscriptSegments({ records: [{
      kind: 'transcript-segment', id: 'segment:two',
      transcript_ref: 'transcript:lesson-one', text: 'Finish the swing',
      start_ms: 2800, end_ms: 4000,
    }] }, { id: 'media:lesson-one', transcript_ref: 'transcript:lesson-one' })
      ?.map((segment) => segment.text)).toEqual(['Finish the swing'])
  })
  it('joins the media transcript reference to its timestamped words', () => {
    expect(readMediaTranscriptSegments(transcriptRecords, {
      id: 'media:lesson-one',
      transcript_ref: 'transcript:lesson-one',
    })).toEqual([{
      id: 'segment:one',
      transcript_ref: 'transcript:lesson-one',
      text: 'Move through the ball',
      start_ms: 1200,
      end_ms: 2800,
      words: [
        { word: 'Move', start: 1.2, end: 1.5 },
        { word: 'through', start: 1.5, end: 2.1 },
        { word: 'the', start: 2.1, end: 2.3 },
        { word: 'ball', start: 2.3, end: 2.8 },
      ],
    }])
  })

  it('does not borrow another media item’s transcript', () => {
    expect(readMediaTranscriptSegments(transcriptRecords, {
      id: 'media:other',
      transcript_ref: 'transcript:other',
    })).toBeUndefined()
  })
})
