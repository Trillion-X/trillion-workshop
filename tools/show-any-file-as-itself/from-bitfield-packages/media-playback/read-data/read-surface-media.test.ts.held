import { describe, expect, it } from 'vitest';
import { readSurfaceMedia } from './read-surface-media';

describe('readSurfaceMedia', () => {
  it('returns undefined for nothing playable', () => {
    expect(readSurfaceMedia(undefined)).toBeUndefined();
    expect(readSurfaceMedia(null)).toBeUndefined();
    expect(readSurfaceMedia({})).toBeUndefined();
    expect(readSurfaceMedia('https://x/y.mp4')).toBeUndefined();
    expect(readSurfaceMedia([])).toBeUndefined();
  });

  it('derives id from a bare source_url and defaults kind to video', () => {
    const m = readSurfaceMedia({ source_url: 'https://x/y.mp4' });
    expect(m).toEqual({ id: 'https://x/y.mp4', source_url: 'https://x/y.mp4', source_kind: 'video' });
  });

  it('derives id from embed_url when no id/source_url given (no kind default for embeds)', () => {
    const m = readSurfaceMedia({ embed_url: 'https://youtu.be/abc' });
    expect(m).toEqual({ id: 'https://youtu.be/abc', embed_url: 'https://youtu.be/abc' });
  });

  it('preserves an explicit id and declared kind without overriding', () => {
    const m = readSurfaceMedia({ id: 'clip-1', playback_url: 'https://x/y.m3u8', source_kind: 'audio' });
    expect(m).toEqual({ id: 'clip-1', playback_url: 'https://x/y.m3u8', source_kind: 'audio' });
  });

  it('keeps only string fields and drops unknown/non-string keys', () => {
    const m = readSurfaceMedia({ id: 'c', source_url: 'u', label: 'L', bogus: 42, mime_type: 7 });
    expect(m).toEqual({ id: 'c', source_url: 'u', label: 'L', source_kind: 'video' });
  });
});
