import React, { Profiler } from 'react'
import { act, cleanup, fireEvent, render } from '@testing-library/react'
import { afterEach, describe, expect, it, vi } from 'vitest'

import { FullscreenTimedTextOverlay } from './MediaPlaybackSurface'

const segments = Array.from({ length: 60 }, (_, segmentIndex) => ({
  id: `segment-${segmentIndex}`,
  text: `Transcript segment ${segmentIndex}`,
  start_ms: segmentIndex * 3000,
  end_ms: (segmentIndex + 1) * 3000,
  words: Array.from({ length: 5 }, (_, wordIndex) => ({
    start: segmentIndex * 3 + wordIndex * 0.5,
    end: segmentIndex * 3 + (wordIndex + 1) * 0.5,
    word: `word-${wordIndex}`,
  })),
}))

describe('fullscreen transcript playback performance', () => {
  afterEach(() => {
    cleanup()
    vi.restoreAllMocks()
  })

  it('does not auto-scroll again while playback remains in the same transcript segment', () => {
    vi.stubGlobal('PointerEvent', MouseEvent)
    const scrollIntoView = vi.fn()
    Element.prototype.scrollIntoView = scrollIntoView
    const { rerender } = render(
      <FullscreenTimedTextOverlay
        currentTime={0.1}
        onSeek={vi.fn()}
        segments={segments}
        title="Transcript"
        visible
      />,
    )

    scrollIntoView.mockClear()
    for (let frame = 2; frame <= 6; frame += 1) {
      rerender(
        <FullscreenTimedTextOverlay
          currentTime={frame / 10}
          onSeek={vi.fn()}
          segments={segments}
          title="Transcript"
          visible
        />,
      )
    }

    expect(scrollIntoView).not.toHaveBeenCalled()
  })

  it('keeps transcript resizing to a single React update after pointer movement', () => {
    vi.stubGlobal('PointerEvent', MouseEvent)
    let updateCommits = 0
    let updateDuration = 0
    const onRender: React.ProfilerOnRenderCallback = (_id, phase, actualDuration) => {
      if (phase === 'update') {
        updateCommits += 1
        updateDuration += actualDuration
      }
    }
    const { getByTestId } = render(
      <Profiler id="transcript" onRender={onRender}>
        <FullscreenTimedTextOverlay
          currentTime={0.1}
          onSeek={vi.fn()}
          segments={segments}
          title="Transcript"
          visible
        />
      </Profiler>,
    )
    const resizeHandle = getByTestId('fullscreen-transcript-resize')

    const resizeStart = performance.now()
    act(() => fireEvent.pointerDown(resizeHandle, { clientX: 500, pointerId: 1 }))
    for (let step = 1; step <= 8; step += 1) {
      act(() => {
        fireEvent.pointerMove(resizeHandle, { clientX: 500 - step * 3, pointerId: 1 })
      })
    }
    act(() => fireEvent.pointerUp(resizeHandle, { clientX: 476, pointerId: 1 }))
    const elapsed = performance.now() - resizeStart

    console.info(`fullscreen transcript resize: ${updateCommits} commits, ${updateDuration.toFixed(2)} ms React render time, ${elapsed.toFixed(2)} ms elapsed`)
    expect(updateCommits).toBeLessThanOrEqual(1)
  })
})
