import React, { Profiler } from 'react'
import { act, cleanup, fireEvent, render } from '@testing-library/react'
import { afterEach, describe, expect, it, vi } from 'vitest'

import { TimedTextCaptionOverlay } from './MediaPlaybackSurface'

afterEach(() => {
  cleanup()
  vi.restoreAllMocks()
})

describe('caption dragging', () => {
  it('moves on every pointer event without rerendering timed text', () => {
    vi.stubGlobal('PointerEvent', MouseEvent)
    Element.prototype.scrollIntoView = vi.fn()
    let updateCommits = 0
    const onRender: React.ProfilerOnRenderCallback = (_id, phase) => {
      if (phase === 'update') updateCommits += 1
    }
    const { container, getByRole } = render(
      <Profiler id="captions" onRender={onRender}>
        <TimedTextCaptionOverlay
          controlsVisible={false}
          currentTime={0.25}
          segments={[{
            id: 'segment-1',
            start_ms: 0,
            end_ms: 1000,
            text: 'A timed caption',
            words: [{ start: 0, end: 1, word: 'A timed caption' }],
          }]}
          storageScope="caption-drag-test"
        />
      </Profiler>,
    )
    const positioner = container.querySelector('[data-media-caption-positioner]') as HTMLDivElement
    const handle = getByRole('button', { name: 'Move captions' })
    const initialTransform = positioner.style.transform

    act(() => fireEvent.pointerDown(handle, { clientX: 100, clientY: 100, pointerId: 1 }))
    updateCommits = 0
    for (let step = 1; step <= 8; step += 1) {
      act(() => fireEvent.pointerMove(positioner, { clientX: 100 + step * 10, clientY: 100 + step * 5, pointerId: 1 }))
    }

    expect(positioner.style.transform).not.toBe(initialTransform)
    expect(positioner.dataset.dragging).toBe('true')
    expect(updateCommits).toBe(0)

    act(() => fireEvent.pointerUp(positioner, { clientX: 180, clientY: 140, pointerId: 1 }))
    expect(positioner.dataset.dragging).toBeUndefined()
    expect(updateCommits).toBeLessThanOrEqual(1)
  })
})
