// @vitest-environment jsdom
// A source that has no video but IS text (a written lesson) must open as its
// words. Before this, such a lesson reached the player as a bare title and the
// learner got a "paste a link" box instead of the lesson.
import React from 'react';
import { cleanup, render, screen } from '@testing-library/react';
import { afterEach, describe, expect, it } from 'vitest';
import { MediaPlaybackSurface } from './MediaPlaybackSurface';
import { readSurfaceMedia } from '../read-data/read-surface-media';

afterEach(cleanup);

const WRITTEN = {
  id: 'media:lesson-text',
  kind: 'media-source',
  label: 'A written lesson',
  source_kind: 'text-document',
  body_text: 'The court is the arena.\nGeometry is the constraint.',
};

describe('a written lesson', () => {
  it('keeps its text through the surface input reader', () => {
    expect(readSurfaceMedia(WRITTEN)?.body_text).toBe(WRITTEN.body_text);
  });

  it('renders its words, not the paste-a-link box or "not ready"', () => {
    const { container } = render(<MediaPlaybackSurface media={readSurfaceMedia(WRITTEN)} showFrameChrome={false} />);
    expect(container.querySelector('[data-media-playback-text="media:lesson-text"]')?.textContent).toBe(WRITTEN.body_text);
    expect(screen.queryByLabelText('Media link')).toBeNull();
    expect(container.querySelector('[data-media-playback-unavailable]')).toBeNull();
  });

  it('still plays when the same source also has a video', () => {
    const { container } = render(
      <MediaPlaybackSurface
        allowEmbeddedDocument
        media={readSurfaceMedia({ ...WRITTEN, embed_url: 'https://www.youtube.com/embed/abc' })}
        showFrameChrome={false}
      />,
    );
    expect(container.querySelector('[data-media-playback-text]')).toBeNull();
  });
});
