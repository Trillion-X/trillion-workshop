import { describe, expect, it } from 'vitest';
import { appleMusicEmbedUrl, spotifyEmbedUrl } from './MediaPlaybackSurface';

describe('spotifyEmbedUrl', () => {
  it('builds the embed URL from a spotify: URI', () => {
    expect(spotifyEmbedUrl('spotify:track:4cOdK2wGLETKBW3PvgPWqT')).toBe(
      'https://open.spotify.com/embed/track/4cOdK2wGLETKBW3PvgPWqT',
    );
    expect(spotifyEmbedUrl('spotify:playlist:37i9dQZF1DXcBWIGoYBM5M')).toBe(
      'https://open.spotify.com/embed/playlist/37i9dQZF1DXcBWIGoYBM5M',
    );
  });

  it('builds from a web share link, including locale-prefixed paths', () => {
    expect(spotifyEmbedUrl('https://open.spotify.com/track/4cOdK2wGLETKBW3PvgPWqT')).toBe(
      'https://open.spotify.com/embed/track/4cOdK2wGLETKBW3PvgPWqT',
    );
    expect(spotifyEmbedUrl('https://open.spotify.com/intl-de/album/1ATL5GLyefJaxhQzSPVrLX')).toBe(
      'https://open.spotify.com/embed/album/1ATL5GLyefJaxhQzSPVrLX',
    );
    // an already-embed link still resolves (idempotent extraction by kind name)
    expect(spotifyEmbedUrl('https://open.spotify.com/embed/track/4cOdK2wGLETKBW3PvgPWqT')).toBe(
      'https://open.spotify.com/embed/track/4cOdK2wGLETKBW3PvgPWqT',
    );
  });

  it('returns null for non-Spotify or malformed input', () => {
    expect(spotifyEmbedUrl('https://example.com/track/abc')).toBeNull();
    expect(spotifyEmbedUrl('https://open.spotify.com/user/someone')).toBeNull();
    expect(spotifyEmbedUrl('not a url')).toBeNull();
    expect(spotifyEmbedUrl('spotify:track:')).toBeNull();
  });
});

describe('appleMusicEmbedUrl', () => {
  it('builds the embed URL from a music.apple.com album link', () => {
    expect(appleMusicEmbedUrl('https://music.apple.com/us/album/1989/1440935467')).toBe(
      'https://embed.music.apple.com/us/album/1989/1440935467',
    );
  });

  it('preserves the ?i= song id for a track deep-link', () => {
    expect(
      appleMusicEmbedUrl('https://music.apple.com/gb/album/1989/1440935467?i=1440935468'),
    ).toBe('https://embed.music.apple.com/gb/album/1989/1440935467?i=1440935468');
  });

  it('returns null for non-Apple-Music or malformed input', () => {
    expect(appleMusicEmbedUrl('https://example.com/us/album/x/1')).toBeNull();
    expect(appleMusicEmbedUrl('https://music.apple.com/us/browse')).toBeNull();
    expect(appleMusicEmbedUrl('not a url')).toBeNull();
  });
});
