// @vitest-environment jsdom
import React from 'react'
import { cleanup, fireEvent, render, screen } from '@testing-library/react'
import { afterEach, describe, expect, it, vi } from 'vitest'

vi.mock('@bitfield/runtime-kit/react', () => ({
  useBitfieldData: () => [{
    kind: 'screen-ready-record',
    id: 'transcript-segment-row',
    role: 'transcript-segment',
    screen_ref: 'screen:tennis',
    section_ref: 'section:library',
    payload: {
      kind: 'transcript-segment',
      id: 'segment:one',
      transcript_ref: 'transcript:lesson',
      text: 'Watch the ball',
      start_ms: 0,
      end_ms: 1500,
      words: [
        { start: 0, end: 0.4, word: 'Watch' },
        { start: 0.4, end: 0.9, word: 'the' },
        { start: 0.9, end: 1.5, word: 'ball' },
      ],
    },
  }],
}))

import { MediaPlaybackMaterial } from './mount-media-playback'

afterEach(() => {
  cleanup()
  vi.restoreAllMocks()
})

describe('timed transcript controls', () => {
  it('shows captions and opens the transcript panel without fullscreen', () => {
    Element.prototype.scrollIntoView = vi.fn()
    const { container } = render(
      <MediaPlaybackMaterial
        props={{
          surfaceInput: {
            show_frame_chrome: false,
            media: {
              id: 'media:lesson-video',
              source_url: 'https://cdn.example.test/lesson.mp4',
              mime_type: 'video/mp4',
              transcript_ref: 'transcript:lesson',
            },
          },
        }}
      />,
    )
    fireEvent.mouseEnter(container.querySelector('[data-media-playback-browser-source="media:lesson-video"]')!)

    expect(screen.getByRole('button', { name: 'Show captions' })).toBeTruthy()
    expect(screen.getByRole('button', { name: 'Show transcript' })).toBeTruthy()
    expect(container.querySelector('video')?.controls).toBe(false)

    fireEvent.click(screen.getByRole('button', { name: 'Show captions' }))
    expect(container.querySelector('[data-media-caption-reader="media:lesson-video"]')).toBeTruthy()

    fireEvent.click(screen.getByRole('button', { name: 'Show transcript' }))
    expect(container.querySelector('[data-media-fullscreen-transcript="Transcript"]')).toBeTruthy()
  })
})
