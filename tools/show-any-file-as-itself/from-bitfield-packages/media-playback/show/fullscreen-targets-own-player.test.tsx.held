// @vitest-environment jsdom
import React from 'react'
import { cleanup, fireEvent, render } from '@testing-library/react'
import { afterEach, describe, expect, it, vi } from 'vitest'
import { MediaPlaybackSurface } from './MediaPlaybackSurface'

afterEach(() => {
  cleanup()
  vi.restoreAllMocks()
})

const media = (id: string) => ({ id, source_url: `https://cdn.example.test/${id}.mp4`, mime_type: 'video/mp4' })

describe('player fullscreen', () => {
  it('enlarges the player whose button was pressed, not another player on the page', async () => {
    const requested: Element[] = []
    HTMLElement.prototype.requestFullscreen = vi.fn(function (this: HTMLElement) { requested.push(this); return Promise.resolve() })
    const { container } = render(<>
      <MediaPlaybackSurface media={media('first') as any} showFrameChrome={false} />
      <MediaPlaybackSurface media={media('second') as any} showFrameChrome={false} />
    </>)
    const players = [...container.querySelectorAll('[data-media-playback-browser-source]')] as HTMLElement[]
    expect(players).toHaveLength(2)
    fireEvent.mouseEnter(players[1])
    fireEvent.click(players[1].querySelector('[aria-label="Fullscreen"]')!)
    await Promise.resolve()
    expect(requested).toHaveLength(1)
    expect(players[1].contains(requested[0]) || requested[0].contains(players[1])).toBe(true)
    expect(players[0].contains(requested[0]) || requested[0].contains(players[0])).toBe(false)
  })

  it("falls back to that player's own video when element fullscreen is unavailable", async () => {
    // @ts-expect-error jsdom lacks WebKit video fullscreen; the player reaches it when element fullscreen is refused.
    HTMLElement.prototype.requestFullscreen = undefined
    const entered: Element[] = []
    ;(HTMLVideoElement.prototype as any).webkitEnterFullscreen = vi.fn(function (this: HTMLVideoElement) { entered.push(this) })
    const { container } = render(<>
      <MediaPlaybackSurface media={media('first') as any} showFrameChrome={false} />
      <MediaPlaybackSurface media={media('second') as any} showFrameChrome={false} />
    </>)
    const players = [...container.querySelectorAll('[data-media-playback-browser-source]')] as HTMLElement[]
    fireEvent.mouseEnter(players[1])
    fireEvent.click(players[1].querySelector('[aria-label="Fullscreen"]')!)
    await Promise.resolve()
    expect(entered).toEqual([players[1].querySelector('video')])
  })
})
