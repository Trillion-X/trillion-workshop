// WS-H: the "add media" input path (paste a link → play). Locks source_kind detection
// + embed URL generation so the media player is never a no-input dead-end again.
import { describe, expect, it } from 'vitest';
import { mediaFromPastedUrl } from './MediaPlaybackSurface';

describe('mediaFromPastedUrl (WS-H add-media input path)', () => {
  it('empty / whitespace → null (honest: nothing to add)', () => {
    expect(mediaFromPastedUrl('')).toBeNull();
    expect(mediaFromPastedUrl('   ')).toBeNull();
  });

  it('Spotify link → source_kind spotify + embed_url', () => {
    const m = mediaFromPastedUrl('https://open.spotify.com/track/4cOdK2wGLETKBW3PvgPWqT');
    expect(m?.source_kind).toBe('spotify');
    expect(m?.source_url).toContain('open.spotify.com');
    expect(m?.embed_url).toContain('open.spotify.com/embed/');
  });

  it('Apple Music link → source_kind apple-music + embed_url', () => {
    const m = mediaFromPastedUrl('https://music.apple.com/us/album/1989/1440935467?i=1440935468');
    expect(m?.source_kind).toBe('apple-music');
    expect(m?.embed_url).toContain('embed.music.apple.com');
  });

  it('YouTube link → source_kind youtube', () => {
    const m = mediaFromPastedUrl('https://www.youtube.com/watch?v=dQw4w9WgXcQ');
    expect(m?.source_kind).toBe('youtube');
    expect(m?.source_url).toContain('youtube.com');
  });

  it('unknown URL still becomes playable media (video fallback, no crash)', () => {
    const m = mediaFromPastedUrl('https://example.com/song.mp3');
    expect(m).not.toBeNull();
    expect(m?.source_kind).toBe('video');
    expect(m?.source_url).toBe('https://example.com/song.mp3');
  });
});
