// packages/media-playback/show/the-shared-player-is-the-only-player.test.ts
//
// Purpose: video and audio play in ONE player, MediaPlaybackSurface. A
// `<video controls>` or `<audio controls>` anywhere else draws the browser's
// own controls (skip buttons, AirPlay, a system volume pill) instead of ours,
// which is how a hover preview once showed a stranger's player. This test reads
// every package's source and fails on any element that turns the browser's
// controls on outside this package.
//
// Invariants:
// - Only authored source is judged: built bytes, entry scopes, plans and
//   vendored reference trees are output or evidence, never authored UI.
// - The check is structural (the element and its attribute), not a list of
//   files, so a new package is judged the moment it exists.

import {readdirSync, readFileSync, statSync} from 'node:fs'
import {join, relative, sep} from 'node:path'
import {describe, expect, it} from 'vitest'

const packagesRoot = join(__dirname, '..', '..')
const ownPackage = join(packagesRoot, 'media-playback') + sep
const skippedFolders = new Set(['node_modules', 'dist', 'built-stored-bytes', '.bitfield-entry-scope', 'plans', 'reference', 'vendor', 'coverage'])
const authored = /\.(tsx?|jsx?|mjs)$/

// The element with the attribute, across line breaks inside the tag, or the
// same attribute set from script.
const nativeControls = [
  /<(video|audio)\b[^>]*?\scontrols(\s|=|\/?>)/g,
  /\.controls\s*=\s*true\b/g,
  /setAttribute\(\s*['"]controls['"]/g,
]

function* sourceFiles(folder: string): Generator<string> {
  for (const name of readdirSync(folder)) {
    if (skippedFolders.has(name)) continue
    const path = join(folder, name)
    const stat = statSync(path)
    if (stat.isDirectory()) yield* sourceFiles(path)
    else if (authored.test(name) && !/\.test\.|\.spec\./.test(name)) yield path
  }
}

describe('the shared player is the only player', () => {
  it('no source outside media-playback turns on the browser’s own media controls', () => {
    const found: string[] = []
    for (const file of sourceFiles(packagesRoot)) {
      if (file.startsWith(ownPackage)) continue
      const text = readFileSync(file, 'utf8')
      for (const pattern of nativeControls) {
        for (const match of text.matchAll(pattern)) {
          const line = text.slice(0, match.index).split('\n').length
          found.push(`${relative(packagesRoot, file)}:${line}`)
        }
      }
    }
    expect(found).toEqual([])
  })
})
