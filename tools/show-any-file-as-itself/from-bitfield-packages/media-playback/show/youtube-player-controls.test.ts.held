import { describe, expect, it } from 'vitest'

import { youtubePlayerVars } from './MediaPlaybackSurface'

describe('YouTube player controls', () => {
  it('keeps native controls and native captions disabled when DATA requests them', () => {
    const vars = youtubePlayerVars({
      id: 'youtube-control',
      query_params: [
        { key: 'controls', value: '1' },
        { key: 'cc_load_policy', value: '1' },
        { key: 'start', value: '12' },
      ],
    }, 'video-1')

    expect(vars).toMatchObject({ controls: 0, cc_load_policy: 0, start: 12 })
  })
})
