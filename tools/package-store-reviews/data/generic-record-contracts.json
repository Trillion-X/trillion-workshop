{
  "package": "package-store-reviews",
  "schema": "bitfield.generic_record_action_projection.v1",
  "record_kinds": [
    {
      "id": "user-statement",
      "label": "Review",
      "field_ids": [
        "score-value",
        "headline-text",
        "body-text",
        "subject-ref",
        "actor-ref",
        "created-at",
        "visibility-state",
        "version-context"
      ]
    },
    {
      "id": "owner-response",
      "label": "Developer reply",
      "field_ids": [
        "body-text",
        "actor-ref",
        "created-at",
        "visibility-state"
      ]
    },
    {
      "id": "trust-signal",
      "label": "Trust signal",
      "field_ids": [
        "signal-key",
        "signal-label",
        "subject-ref",
        "actor-ref",
        "created-at"
      ]
    }
  ],
  "fields": [
    {
      "id": "score-value",
      "label": "Rating",
      "value_type": "number",
      "range": {
        "min": 1,
        "max": 5
      }
    },
    {
      "id": "headline-text",
      "label": "Title",
      "value_type": "text"
    },
    {
      "id": "body-text",
      "label": "Body",
      "value_type": "text"
    },
    {
      "id": "subject-ref",
      "label": "Package",
      "value_type": "text"
    },
    {
      "id": "actor-ref",
      "label": "Person",
      "value_type": "text"
    },
    {
      "id": "created-at",
      "label": "Created",
      "value_type": "text"
    },
    {
      "id": "visibility-state",
      "label": "Visibility",
      "value_type": "text",
      "allowed_values": [
        "public",
        "private",
        "pending"
      ]
    },
    {
      "id": "version-context",
      "label": "Package version",
      "value_type": "text"
    },
    {
      "id": "signal-key",
      "label": "Signal key",
      "value_type": "text"
    },
    {
      "id": "signal-label",
      "label": "Signal label",
      "value_type": "text"
    },
    {
      "id": "reason-key",
      "label": "Reason",
      "value_type": "text"
    }
  ],
  "relationships": [
    {
      "id": "statement-about-subject",
      "label": "Statement about package",
      "source_kind": "user-statement",
      "target_role": "subject"
    },
    {
      "id": "response-to-statement",
      "label": "Reply to review",
      "source_kind": "owner-response",
      "target_role": "source-record"
    },
    {
      "id": "signal-for-statement",
      "label": "Signal on review",
      "source_kind": "trust-signal",
      "target_role": "source-record"
    },
    {
      "id": "concern-about-statement",
      "label": "Report review",
      "target_role": "source-record",
      "field_ids": [
        "reason-key"
      ]
    }
  ],
  "rules": [
    {
      "id": "public-visibility",
      "label": "Public list shows public rows",
      "effect": "include",
      "when": {
        "field_id": "visibility-state",
        "equals": "public"
      }
    },
    {
      "id": "private-visibility",
      "label": "Private rows stay out of public lists",
      "effect": "exclude",
      "when": {
        "field_id": "visibility-state",
        "equals": "private"
      }
    },
    {
      "id": "pending-visibility",
      "label": "Pending rows show as processing for the actor",
      "effect": "mark",
      "when": {
        "field_id": "visibility-state",
        "equals": "pending"
      }
    }
  ],
  "actions": [
    {
      "id": "append-statement",
      "label": "Write review",
      "request_kind": "write-batch",
      "operation": "append-record",
      "record_kind": "user-statement",
      "field_ids": [
        "score-value",
        "headline-text",
        "body-text",
        "subject-ref",
        "actor-ref",
        "created-at",
        "visibility-state",
        "version-context"
      ]
    },
    {
      "id": "append-response",
      "label": "Developer reply",
      "request_kind": "write-batch",
      "operation": "append-record",
      "record_kind": "owner-response",
      "relationship_id": "response-to-statement",
      "field_ids": [
        "body-text",
        "actor-ref",
        "created-at",
        "visibility-state"
      ]
    },
    {
      "id": "append-concern",
      "label": "Report review",
      "request_kind": "write-batch",
      "operation": "append-relationship",
      "relationship_id": "concern-about-statement",
      "field_ids": [
        "reason-key",
        "actor-ref",
        "created-at"
      ]
    },
    {
      "id": "append-signal",
      "label": "Mark helpful",
      "request_kind": "write-batch",
      "operation": "append-record",
      "record_kind": "trust-signal",
      "relationship_id": "signal-for-statement",
      "field_ids": [
        "signal-key",
        "signal-label",
        "actor-ref",
        "created-at"
      ]
    },
    {
      "id": "run-external-check",
      "label": "Check review evidence",
      "request_kind": "process-session",
      "process": {
        "argv": [
          "node",
          "-e",
          "process.stdout.write(JSON.stringify({ok:true}))"
        ],
        "timeout_ms": 30000
      }
    }
  ],
  "projections": [
    {
      "id": "public-reader",
      "label": "Public reviews",
      "subject_field_id": "subject-ref",
      "item_record_kind": "user-statement",
      "visibility_rule_id": "public-visibility",
      "score_field_id": "score-value",
      "title_field_id": "headline-text",
      "body_field_id": "body-text",
      "actor_field_id": "actor-ref",
      "time_field_id": "created-at",
      "version_field_id": "version-context",
      "response_relationship_id": "response-to-statement",
      "signal_relationship_id": "signal-for-statement",
      "concern_relationship_id": "concern-about-statement"
    }
  ],
  "readers": [
    {
      "id": "browse-summary",
      "label": "Review summary for browse cards",
      "projection_id": "public-reader",
      "sections": [
        "summary"
      ]
    },
    {
      "id": "package-page",
      "label": "Package page reviews",
      "projection_id": "public-reader",
      "sections": [
        "summary",
        "items",
        "actions"
      ]
    },
    {
      "id": "all-records",
      "label": "All review records",
      "projection_id": "public-reader",
      "sections": [
        "summary",
        "items",
        "filters",
        "actions"
      ]
    }
  ]
}
