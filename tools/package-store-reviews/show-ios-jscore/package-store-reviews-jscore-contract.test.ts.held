import { readFileSync } from 'node:fs';
import { join } from 'node:path';
import { describe, expect, it } from 'vitest';

import { buildOwnerActionRequest } from '../do-work/build-owner-action-request';
import type { GenericRecordContracts } from '../read-data/descriptor-contracts';
import { readGenericRecordProjection } from '../read-data/read-generic-record-projection';

const root = join(process.cwd(), 'packages/package-store-reviews');
const contracts = JSON.parse(readFileSync(join(root, 'data/generic-record-contracts.json'), 'utf8')) as GenericRecordContracts;
const fixtures = JSON.parse(readFileSync(join(root, '__tests__/fixtures/generic-record-events.json'), 'utf8')) as Record<string, unknown[]>;

function consumeJscoreReaderOutput(jsonText: string) {
  const value = JSON.parse(jsonText);
  return {
    state: value.state,
    count: value.summary?.count ?? 0,
    firstAction: value.actions?.[0]?.id ?? '',
  };
}

describe('iOS JSCore consumer contract', () => {
  it('uses the same projection value and action descriptors as browser consumers', () => {
    const projection = readGenericRecordProjection({ contracts, reader_id: 'package-page', events: fixtures.sparse });
    expect(consumeJscoreReaderOutput(JSON.stringify(projection))).toEqual({
      state: 'sparse',
      count: 2,
      firstAction: 'append-statement',
    });

    const request = buildOwnerActionRequest(contracts, {
      action_id: 'append-signal',
      operation_id: 'ios-op-1',
      source_record_ref: 'entry-1',
      input: {
        'signal-key': 'helpful',
        'signal-label': 'Helpful',
        'actor-ref': 'person-ios',
        'created-at': '2026-06-22T12:00:00Z',
      },
    });
    expect(request.errors).toEqual([]);
    expect(request.request?.request_kind).toBe('write-batch');
  });
});
