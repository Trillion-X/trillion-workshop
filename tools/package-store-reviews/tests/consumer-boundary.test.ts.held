import { readFileSync, readdirSync, statSync } from 'node:fs';
import { join, relative } from 'node:path';
import { describe, expect, it } from 'vitest';

const packageRoot = join(process.cwd(), 'packages/package-store-reviews');
const browseRoot = join(process.cwd(), 'packages/bitfield-package-store-browse-surface');
const catalogRoot = join(process.cwd(), 'packages/bitfield-package-store-catalog');

function sourceFiles(dir: string): string[] {
  return readdirSync(dir).flatMap((name) => {
    const path = join(dir, name);
    const stat = statSync(path);
    if (stat.isDirectory()) return sourceFiles(path);
    return /\.(ts|tsx|js|json)$/.test(name) ? [path] : [];
  });
}

function readJson(path: string): any {
  return JSON.parse(readFileSync(path, 'utf8'));
}

describe('package-store review consumer boundary', () => {
  it('declares projection reader contracts for adjacent consumers', () => {
    const contracts = readJson(join(packageRoot, 'data/consumer-reader-contracts.json'));
    expect(contracts.contracts.map((entry: { id: string }) => entry.id)).toEqual([
      'browse-compact-summary',
      'package-page-section',
      'all-records-view',
      'cli-tui-summary',
      'background-index',
    ]);
    expect(JSON.stringify(contracts)).toContain('package::package-store-reviews::reader-output::browse-summary');
  });

  it('wires browse to the finished projection reader output', () => {
    const browse = readJson(join(browseRoot, 'things-to-store-and-run.json'));
    const input = browse.things.find((thing: { address?: string }) => (
      thing.address === 'package::bitfield-package-store-browse-surface::input::package-store-reviews-summary'
    ));
    expect(input?.payload).toMatchObject({
      input_name: 'package-store-reviews-summary',
      kind: 'bitfield-input-descriptor',
      value_address_label: 'package::package-store-reviews::reader-output::browse-summary',
    });
  });

  it('keeps catalog linked to reader output refs without owning source rows', () => {
    const catalog = readJson(join(catalogRoot, 'things-to-store-and-run.json'));
    const link = catalog.things.find((thing: { address?: string }) => (
      thing.address === 'package::bitfield-package-store-catalog::external-reader::package-store-reviews'
    ));
    expect(link?.payload).toMatchObject({
      kind: 'external-reader-output-link',
      owner_package: 'package-store-reviews',
      reader_output_address: 'package::package-store-reviews::reader-output::browse-summary',
    });
  });

  it('does not import owner action or fold internals into catalog and browse packages', () => {
    const forbidden = /from ['"].*package-store-reviews\/(do-work|read-data\/fold-generic-record-events)/;
    const offenders = [...sourceFiles(browseRoot), ...sourceFiles(catalogRoot)]
      .filter((file) => forbidden.test(readFileSync(file, 'utf8')))
      .map((file) => relative(process.cwd(), file));
    expect(offenders).toEqual([]);
  });
});
