import { readFileSync } from 'node:fs';
import { join } from 'node:path';
import { describe, expect, it } from 'vitest';

import type { GenericRecordContracts } from '../read-data/descriptor-contracts';
import { foldGenericRecordEvents } from '../read-data/fold-generic-record-events';
import { readGenericRecordProjection } from '../read-data/read-generic-record-projection';

const root = join(process.cwd(), 'packages/package-store-reviews');
const contracts = JSON.parse(readFileSync(join(root, 'data/generic-record-contracts.json'), 'utf8')) as GenericRecordContracts;
const fixtures = JSON.parse(readFileSync(join(root, '__tests__/fixtures/generic-record-events.json'), 'utf8')) as Record<string, unknown[]>;

describe('generic projection fold', () => {
  it('materializes reader sections selected by descriptor data', () => {
    const summary = readGenericRecordProjection({ contracts, reader_id: 'browse-summary', events: fixtures.sparse });
    expect(summary.summary?.count).toBe(2);
    expect(summary.items).toBeUndefined();
    expect(summary.actions).toBeUndefined();

    const page = readGenericRecordProjection({ contracts, reader_id: 'package-page', events: fixtures.sparse });
    expect(page.summary?.count).toBe(2);
    expect(page.items).toHaveLength(2);
    expect(page.actions).toHaveLength(5);
  });

  it('uses descriptor-owned visibility rules', () => {
    const output = foldGenericRecordEvents(contracts, 'all-records', {
      events: [...fixtures.sparse, ...fixtures.hidden, ...fixtures.offline_pending],
    });
    expect(output.items.map((item) => item.id)).toEqual(['entry-1', 'entry-2']);
    expect(output.summary.count).toBe(2);
  });

  it('returns machine-readable issues for missing readers', () => {
    const output = readGenericRecordProjection({ contracts, reader_id: 'missing-reader', events: fixtures.sparse });
    expect(output.issues).toContainEqual({ code: 'missing-reader', detail: 'missing-reader' });
    expect(output.state).toBe('empty');
  });

  it('keeps backend words out of human-facing values emitted by fixtures', () => {
    const output = readGenericRecordProjection({ contracts, reader_id: 'all-records', events: fixtures.sparse });
    const humanText = JSON.stringify({
      summary: output.summary,
      items: output.items?.map(({ title, body, signals, responses, concerns }) => ({ title, body, signals, responses, concerns })),
    });
    expect(humanText).not.toMatch(/\b(envelope|payload|CAS|slot|EEAF|runtime|debug|source material ref|package boundary file)\b/i);
  });
});
