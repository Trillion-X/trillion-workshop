import { readFileSync } from 'node:fs';
import { join } from 'node:path';
import { describe, expect, it } from 'vitest';

import { validateContracts, type GenericRecordContracts } from '../read-data/descriptor-contracts';
import { readGenericRecordProjection } from '../read-data/read-generic-record-projection';

const root = join(process.cwd(), 'packages/package-store-reviews');
const contracts = JSON.parse(readFileSync(join(root, 'data/generic-record-contracts.json'), 'utf8')) as GenericRecordContracts;
const fixtures = JSON.parse(readFileSync(join(root, '__tests__/fixtures/generic-record-events.json'), 'utf8')) as Record<string, unknown[]>;
const expected = JSON.parse(readFileSync(join(root, '__tests__/fixtures/reader-contract-expected.json'), 'utf8')) as Record<string, Record<string, unknown>>;

describe('generic record contracts', () => {
  it('parses and validates generic descriptor families', () => {
    const result = validateContracts(contracts);
    expect(result).toMatchObject({ ok: true });
    expect(result.counts).toMatchObject({
      fields: 11,
      relationships: 4,
      actions: 5,
      projections: 1,
      readers: 3,
    });
  });

  it('keeps schema keys generic while human words stay inside data labels', () => {
    const forbiddenTopLevel = [
      'reviewEvents',
      'ratingSummary',
      'reportReasons',
      'moderationStates',
      'campaignStages',
    ];
    for (const key of forbiddenTopLevel) expect(Object.hasOwn(contracts, key)).toBe(false);
    expect(Object.keys(contracts)).toEqual(expect.arrayContaining([
      'fields',
      'relationships',
      'actions',
      'rules',
      'projections',
      'readers',
    ]));
    expect(JSON.stringify(contracts)).toContain('Write review');
  });

  it('produces golden empty, sparse, dense, and hidden reader outputs', () => {
    for (const fixtureId of ['empty', 'sparse', 'dense', 'hidden']) {
      const output = readGenericRecordProjection({
        contracts,
        reader_id: 'all-records',
        events: fixtures[fixtureId],
      });
      expect(output.state).toBe(expected[fixtureId].state);
      expect(output.summary?.count).toBe(expected[fixtureId].count);
      if ('score_average' in expected[fixtureId]) {
        expect(output.summary?.score_average).toBe(expected[fixtureId].score_average);
      }
    }
  });

  it('folds linked signals, responses, and concerns without adding new schema families', () => {
    const output = readGenericRecordProjection({
      contracts,
      reader_id: 'all-records',
      events: fixtures.sparse,
    });
    expect(output.items?.[0].signals).toHaveLength(expected.sparse.first_item_signal_count as number);
    expect(output.items?.[0].responses).toHaveLength(expected.sparse.first_item_response_count as number);
    expect(output.items?.[1].concerns).toHaveLength(expected.sparse.second_item_concern_count as number);
  });

  it('terminates deterministic adversarial cycles and duplicate relationships', () => {
    const cyclic = [
      ...fixtures.sparse,
      {
        kind: 'generic-relationship-event',
        operation: 'append-relationship',
        record_id: 'cycle-1',
        relationship_id: 'response-to-statement',
        source_record_ref: 'cycle-1',
        field_values: { 'body-text': 'Self linked', 'actor-ref': 'actor', 'created-at': '2026-06-22T17:00:00Z' },
      },
      {
        kind: 'generic-relationship-event',
        operation: 'append-relationship',
        record_id: 'concern-1',
        relationship_id: 'concern-about-statement',
        source_record_ref: 'entry-2',
        field_values: { 'reason-key': 'duplicate', 'actor-ref': 'person-4', 'created-at': '2026-06-22T17:10:00Z' },
      },
    ];
    const first = readGenericRecordProjection({ contracts, reader_id: 'all-records', events: cyclic });
    const second = readGenericRecordProjection({ contracts, reader_id: 'all-records', events: cyclic });
    expect(first).toEqual(second);
    expect(first.summary?.count).toBe(2);
    expect(first.items?.[1].concerns).toHaveLength(2);
  });
});
