       ]
      },
      "keep": {
       "type": "array",
       "description": "The records that keep what the run found, for the caller to put where the person keeps their rows: { id, type, value, expected } for each record that is new or changed, expected null for a new one",
       "items": {
        "type": "object",
        "required": [
         "id",
         "type",
         "value",
         "expected"
        ]
       }
      },
      "arrivals": {
