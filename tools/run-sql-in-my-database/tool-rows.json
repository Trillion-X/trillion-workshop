{
  "kind": "package-set-records",
  "record_set": "run-sql-in-my-database-tool-rows",
  "what_this_is": "The Workshop row that runs one SQL statement in the person's own Postgres-wire database and answers its columns and rows, or that database's own error text; and the same row's upsert for a step's `row:<list>` output. The connection string is the person's held value, handed to the one process on a private pipe (credential_mounts fd 3).",
  "records": [
    {
      "payload": {
        "kind": "ai-tool-descriptor",
        "id": "tool:run-sql-in-my-database",
        "label": "Run SQL in my database",
        "job": "Run one SQL statement in my own database and see its rows, or keep a step output as a row in it",
        "description": "Runs exactly one SQL statement as written (sql, with params for $1, $2 and so on) in the person's own database, as the login the connection string names: the server refuses text holding more than one command, and a login that may only read (the read connection) cannot write, because the database says so. Give credential_name, the held name of the connection (own-rows-postgres-connection, or own-rows-postgres-read-connection for a share that may only read), and optionally statement_timeout_ms from the cart line. Answers columns, rows and row_count, or the database's own error text. It adds no shape, no list names and no record types. The step-outputs runner calls it with list, id and value instead of sql: that keeps value as the row id in the table named list, made as (id text primary key, value jsonb, updated_at timestamptz) when it is missing. The connection may name any server that speaks the Postgres wire protocol that this computer reaches on a local port it reports as own-rows-postgres.",
        "status": "active",
        "input_schema": {
          "type": "object",
          "required": [
            "credential_name"
          ],
          "additionalProperties": false,
          "properties": {
            "credential_name": {
              "type": "string",
              "enum": [
                "own-rows-postgres-connection",
                "own-rows-postgres-read-connection"
              ],
              "description": "The held name of the connection string."
            },
            "store": {
              "type": "string",
              "description": "The cart line's store, as the step-outputs runner hands it; the connection comes only from credential_name."
            },
            "statement_timeout_ms": {
              "type": "integer",
              "minimum": 1,
              "description": "The statement's time limit in milliseconds, from the cart line; the database's own limit when absent."
            },
            "sql": {
              "type": "string",
              "minLength": 1,
              "description": "One statement, as written."
            },
            "params": {
              "type": "array",
              "description": "The values of $1, $2 and so on."
            },
            "list": {
              "type": "string",
              "minLength": 1,
              "description": "A step output: the table to keep the row in."
            },
            "id": {
              "type": "string",
              "minLength": 1,
              "description": "A step output: the row id."
            },
            "value": {
              "description": "A step output: the row value, kept as jsonb."
            }
          },
          "oneOf": [
            {
              "required": [
                "sql"
              ]
            },
            {
              "required": [
                "list",
                "id",
                "value"
              ]
            }
          ]
        },
        "output_schema": {
          "type": "object",
          "required": [
            "columns",
            "rows",
            "row_count"
          ],
          "properties": {
            "columns": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "rows": {
              "type": "array",
              "items": {
                "type": "object"
              }
            },
            "row_count": {
              "type": "integer"
            }
          }
        },
        "invoke": {
          "kind": "container",
          "internet": false,
          "local_doors": [
            "own-rows-postgres"
          ],
          "workdir": "/opt/run-sql-in-my-database",
          "stdout": "json",
          "argv": [
            "node",
            "/opt/run-sql-in-my-database/do-work/run-sql.mjs"
          ],
          "stdin": {
            "fill": {
              "from": "input"
            }
          },
          "files": {
            "package_files": [
              {
