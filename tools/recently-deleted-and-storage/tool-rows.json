              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": [
                  "name"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "pattern": "^/"
                  },
                  "identity": {
                    "type": "string",
                    "pattern": "^(1f|12):[0-9a-f]{64}$"
                  },
                  "byte_length": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "modified_at_ms": {
                    "type": "integer"
                  }
                }
              }
            },
            "now": {
              "type": "string",
              "format": "date-time"
            },
            "steps": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "op"
                ],
                "properties": {
                  "op": {
                    "type": "string",
                    "enum": [
                      "delete",
                      "archive",
                      "put_back",
                      "keep_for",
                      "sweep"
                    ]
                  },
                  "items": {
                    "type": "array"
                  },
                  "by": {
                    "type": "string"
                  },
                  "after_days": {
                    "type": "object",
                    "additionalProperties": {
                      "type": [
                        "integer",
                        "null"
                      ],
                      "minimum": 0,
                      "maximum": 36500
                    }
                  },
                  "at": {
                    "type": "string",
                    "format": "date-time"
                  }
                }
              }
            }
          }
        },
