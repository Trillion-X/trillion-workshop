        "listed_on": "2026-11-04T00:00:00Z",
        "id": "tool:delete-archive-and-put-back-my-files",
        "placements": [
          "placement:small-container"
        ],
        "needs": {
          "expected_seconds": 2,
          "network_egress": false,
          "memory_mb": 128
        },
        "label": "Delete, archive and put back my files",
        "job": "Delete or archive a person's files and folders into Recently Deleted and Archived, put them back exactly as they were, change how long each keeps things, and say what is due when, with the time left on each",
        "description": "Give files ([{ name, identity?, byte_length?, modified_at_ms? }], names starting with /), now (the ISO time the run starts at) and steps, run in order: { op: delete | archive, items: [{ name } | { identity }] } takes a file or a whole folder out of the person's Files into Recently Deleted or Archived; { op: put_back, items: [label or id] } gives every name back exactly as it was (never over a name another file took since); { op: keep_for, after_days: { deleted?, archived? } } sets how many days each keeps things (null: until put back); { op: sweep, at } moves on what is due by then: an archived thing moves to Recently Deleted, a deleted one's names are gone for good. Answers steps (what each answered, refusals included), set_aside (each item as the screen lists it: label, state, names, bytes, where, due_at, days_left, due_words), names (what Files still shows), gone (the identities whose names went for good) and keep_for. Every step is namespace-set-aside.mjs's own setAsideStore over namespace-store.mjs's tables, in an in-memory SQLite database: no byte is deleted, nothing is kept after the run, no file is written and nothing is sent. Refuses no files, an unknown step and what the store refuses (a name not starting with /, the whole Files, a day count out of range). The screen also releases storage by the person's rules; this run does not.",
        "read_only": true,
        "input_schema": {
          "type": "object",
          "required": [
            "files",
            "now"
          ],
          "additionalProperties": false,
          "properties": {
            "files": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": [
                  "name"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "pattern": "^/"
                  },
                  "identity": {
                    "type": "string",
                    "pattern": "^(1f|12):[0-9a-f]{64}$"
                  },
                  "byte_length": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "modified_at_ms": {
                    "type": "integer"
                  }
                }
              }
            },
            "now": {
              "type": "string",
              "format": "date-time"
            },
            "steps": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "op"
                ],
                "properties": {
                  "op": {
                    "type": "string",
                    "enum": [
                      "delete",
                      "archive",
                      "put_back",
                      "keep_for",
                      "sweep"
                    ]
                  },
                  "items": {
                    "type": "array"
                  },
                  "by": {
                    "type": "string"
                  },
                  "after_days": {
                    "type": "object",
                    "additionalProperties": {
                      "type": [
                        "integer",
                        "null"
                      ],
                      "minimum": 0,
                      "maximum": 36500
                    }
                  },
                  "at": {
                    "type": "string",
                    "format": "date-time"
                  }
                }
              }
            }
          }
        },
        "output_schema": {
          "type": "object",
          "required": [
            "steps",
            "set_aside",
            "names",
            "gone",
            "keep_for"
          ],
          "properties": {
            "steps": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "op"
                ]
              }
            },
            "set_aside": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "id",
                  "label",
                  "state",
                  "names"
                ],
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "label": {
                    "type": "string"
                  },
                  "state": {
                    "type": "string"
                  },
                  "state_label": {
                    "type": "string"
                  },
                  "folder": {
                    "type": "boolean"
                  },
                  "set_aside_at": {
                    "type": "string"
                  },
                  "names": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "name_count": {
                    "type": "integer"
                  },
                  "byte_length": {
                    "type": "integer"
                  },
                  "where": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "after_days": {
                    "type": [
                      "integer",
                      "null"
                    ]
                  },
                  "due_at": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "days_left": {
                    "type": [
                      "integer",
                      "null"
                    ]
                  },
                  "due_words": {
                    "type": "string"
                  }
                }
              }
            },
