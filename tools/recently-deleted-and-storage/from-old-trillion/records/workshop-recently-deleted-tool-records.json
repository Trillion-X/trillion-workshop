                      "string",
                      "null"
                    ]
                  },
                  "set_aside_at": {
                    "type": "string"
                  },
                  "by": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "after_days": {
                    "type": [
                      "integer",
                      "null"
                    ]
                  },
                  "due_at": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "days_left": {
                    "type": [
                      "integer",
                      "null"
                    ]
                  },
                  "due_words": {
                    "type": "string"
                  }
                }
              }
            },
            "refused": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "asked": {
                    "type": "object"
                  },
                  "error": {
                    "type": "string"
                  }
                }
              }
            },
            "said": {
              "type": "string"
            }
          }
        },
        "invoke": {
          "kind": "account-action",
          "action": "set-aside-files"
        },
        "verify": [
          {
            "kind": "sample-run",
