          "expected_seconds": 2,
          "network_egress": false
        },
        "id": "tool:delete-files",
        "listed_on": "2026-09-30T06:40:06Z",
        "label": "Delete files to Recently Deleted",
        "job": "Delete some of this person's files, folders or recordings so they leave Files, Media and search and wait in Recently Deleted, where they can be put back until their keep-for days end",
        "description": "state is \"deleted\"; items is a list of { name } (a file or folder path) or { identity, label? } (a recording or file with every name it has). Each goes to Recently Deleted with the days it has left; after the keep-for days (read-deleted-files-keep-for) its names are gone for good. Bytes are never erased. A file still uploading, or a name that is not there, is refused with why. The same owner as the Files and Media Delete action and the delete_file MCP tool (src/namespace-set-aside.mjs).",
        "input_schema": {
          "type": "object",
          "required": [
            "items",
            "state"
          ],
          "additionalProperties": false,
          "properties": {
            "items": {
              "type": "array",
              "minItems": 1,
              "maxItems": 500,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "name": {
                    "type": "string",
                    "description": "A file or folder's path name, starting with /"
                  },
                  "identity": {
                    "type": "string",
                    "description": "A file's content identity (1f: or 12: then 64 hex): every name it has goes"
                  },
                  "label": {
                    "type": "string",
                    "maxLength": 200
                  }
                }
              }
            },
            "state": {
              "type": "string",
              "const": "deleted",
              "description": "Always \"deleted\""
            }
          }
        },
        "output_schema": {
          "type": "object",
          "required": [
            "set_aside",
            "refused",
            "said"
          ],
          "properties": {
            "set_aside": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "id",
                  "label",
                  "state",
                  "days_left"
                ],
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "label": {
                    "type": "string"
                  },
                  "state": {
                    "type": "string"
                  },
                  "state_label": {
