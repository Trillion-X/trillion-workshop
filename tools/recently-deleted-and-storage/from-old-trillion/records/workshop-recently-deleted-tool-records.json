{
  "kind": "package-set-records",
  "package_set": "trillion",
  "record_set": "workshop-recently-deleted-tool-records",
  "what_this_is": "Recently Deleted and Archived for a person's files as Workshop tools that run inside that person's store (placement:this-account; src/namespace-set-aside.mjs through src/person-store.mjs accountActions): delete or archive files, folders or recordings (they leave Files, Media and search), list them with the days each has left, put them back, and read or change how long each state keeps things. The store's alarm moves each on when its time ends: Archived to Recently Deleted, Recently Deleted gone for good. The list tool's screen is the Recently Deleted screen (entry recently-deleted). The same verbs are MCP tools in src/file-tools.mjs (delete_file, archive_file, list_recently_deleted, put_back_file, read_keep_for, set_keep_for).",
  "records": [
