    "published-record"
   ],
   "payload": {
    "kind": "ai-tool-descriptor",
    "id": "tool:add-a-customer",
    "label": "Add a customer",
    "status": "active",
    "job": "Add a customer or contact to my customer list, with their name, how to reach them and where they came from",
    "description": "Keeps the customer in your own customer records and returns their record with its id, which record-a-customer-step and see-where-each-customer-is use. Give contact_id to change a customer you already added.",
    "input_schema": {
     "type": "object",
     "required": [
      "name"
     ],
     "additionalProperties": false,
     "properties": {
      "name": {
       "type": "string",
       "minLength": 1,
       "description": "The customer's name"
      },
      "contact_id": {
       "type": "string",
       "description": "Optional: the id of a customer you already added, to change them"
      },
      "reach_them_by": {
       "type": "string",
       "description": "Optional: how you reach them, like Email or Instagram"
      },
      "owner": {
       "type": "string",
       "description": "Optional: who looks after them"
      },
      "came_from": {
       "type": "string",
       "description": "Optional: where they came from, like a referral or an ad"
      }
     }
    },
    "output_schema": {
     "type": "object",
     "required": [
      "contact_id",
      "contact_record"
     ],
     "properties": {
      "contact_id": {
       "type": "string",
       "minLength": 1
      },
      "contact_record": {
       "type": "object",
       "required": [
        "kind",
