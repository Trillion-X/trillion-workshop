    "invoke": {
     "kind": "container",
     "files": {
      "package_files": {
       "package": "customer-follow-up",
       "paths": [
        "do-work"
       ],
       "at": "/opt/customer-follow-up",
       "exclude": [
        "__tests__"
       ]
      }
     },
     "workdir": "/opt/customer-follow-up",
     "internet": false,
     "stdout": "json",
     "argv": [
      "node",
      "do-work/add-a-customer.mjs"
     ],
     "stdin": {
      "fill": {
       "from": "input"
      }
     }
    },
    "result_selector": "$.result",
    "needs": {
     "expected_seconds": 20,
     "network_egress": false,
     "memory_mb": 256
    },
    "licence_class": "licence:maker-own",
    "placements": [
     "placement:small-container"
    ],
    "maker": "maker:customer-follow-up",
    "keeps_records": [
     {
      "output_selector": "$.contact_record",
      "type_field": "kind",
      "id_field": "contactId"
     }
    ],
    "provenance": {
     "source": "bitfield-packages packages/customer-follow-up"
    },
    "verify": [
     {
      "kind": "sample-run",
      "input": {
       "name": "Dee Lo",
       "reach_them_by": "Email",
       "came_from": "A referral from Ana"
      },
      "output_selector": "$.contact_record.displayName",
      "contains": "Dee Lo"
     },
     {
      "kind": "output-contains-input",
      "output_selector": "$.contact_record.displayName",
      "input_field": "name"
     }
    ]
   }
