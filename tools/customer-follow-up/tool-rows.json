  {
   "id": "package::customer-follow-up::tool::set-a-customer-target",
   "address": "package::customer-follow-up::tool::set-a-customer-target",
   "path": [
    "current-item",
    "published-record"
   ],
   "payload": {
    "kind": "ai-tool-descriptor",
    "id": "tool:set-a-customer-target",
    "label": "Set a product's customer target",
    "status": "active",
    "job": "Set how many customers I want for a product, so progress toward that target can be tracked",
    "description": "Keeps the target in your own customer records (one per product; setting it again replaces it) and returns it; see-where-each-customer-is counts the product's customers against it.",
    "input_schema": {
     "type": "object",
     "required": [
      "product_id",
      "product_name",
      "customers"
     ],
     "additionalProperties": false,
     "properties": {
      "product_id": {
       "type": "string",
       "minLength": 1,
       "description": "The product's id, as your customer steps name it"
      },
      "product_name": {
       "type": "string",
       "minLength": 1,
       "description": "The product's name"
      },
      "customers": {
       "type": "integer",
       "minimum": 1,
       "description": "How many customers the product aims for"
      },
      "active": {
       "type": "boolean",
       "description": "Optional: false to stop tracking this target"
      }
     }
    },
    "output_schema": {
     "type": "object",
     "required": [
      "target_id",
      "target_record"
     ],
     "properties": {
      "target_id": {
       "type": "string",
       "minLength": 1
      },
      "target_record": {
       "type": "object",
       "required": [
        "kind",
        "targetId",
        "productId",
        "productLabel",
        "targetCount"
       ],
       "properties": {
        "kind": {
         "type": "string",
         "enum": [
          "customer-product-target"
         ]
        },
        "targetCount": {
         "type": "integer",
         "minimum": 1
        }
       }
      }
     }
    },
    "invoke": {
     "kind": "container",
     "files": {
      "package_files": {
       "package": "customer-follow-up",
       "paths": [
        "do-work"
       ],
       "at": "/opt/customer-follow-up",
       "exclude": [
        "__tests__"
       ]
      }
     },
     "workdir": "/opt/customer-follow-up",
     "internet": false,
     "stdout": "json",
     "argv": [
      "node",
      "do-work/set-a-customer-target.mjs"
     ],
     "stdin": {
      "fill": {
       "from": "input"
      }
     }
    },
    "result_selector": "$.result",
    "needs": {
     "expected_seconds": 20,
     "network_egress": false,
     "memory_mb": 256
    },
    "licence_class": "licence:maker-own",
    "placements": [
     "placement:small-container"
    ],
    "maker": "maker:customer-follow-up",
    "keeps_records": [
     {
      "output_selector": "$.target_record",
      "type_field": "kind",
      "id_field": "targetId"
     }
    ],
    "provenance": {
     "source": "bitfield-packages packages/customer-follow-up"
    },
    "verify": [
     {
      "kind": "sample-run",
      "input": {
       "product_id": "product:coaching",
       "product_name": "Coaching",
       "customers": 10
      },
      "output_selector": "$.target_record.productLabel",
      "contains": "Coaching"
     },
     {
      "kind": "output-number-within",
      "output_selector": "$.target_record.targetCount",
      "at_least": {
       "input_field": "customers"
      },
      "at_most": {
       "input_field": "customers"
      }
     }
    ]
   }
