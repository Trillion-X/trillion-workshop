{
  "video/": "<figure class=\"share-item\" id=\"item-{{n}}\" data-n=\"{{n}}\" data-name=\"{{name}}\" data-poster=\"{{form_poster_url}}\" data-media-playback-url=\"{{form_play_url|url}}\" data-media-playback-type=\"{{form_play_type|type}}\" data-media-playback-label=\"{{name}}\" data-media-playback-poster=\"{{form_poster_url}}\"><div class=\"page-media-mount\"><video controls playsinline preload=\"none\" poster=\"{{form_poster_url}}\" src=\"{{form_play_url|url}}\"><track kind=\"captions\" src=\"{{form_captions_url}}\" default></video></div><figcaption><span class=\"share-name\">{{name}}</span><a class=\"share-download\" href=\"{{download_url}}\" download>Download original, {{size}}</a></figcaption></figure>",
  "audio/": "<figure class=\"share-item\" id=\"item-{{n}}\" data-n=\"{{n}}\" data-name=\"{{name}}\" data-poster=\"{{form_poster_url}}\"><audio controls preload=\"none\" src=\"{{form_play_url|url}}\"></audio><figcaption><span class=\"share-name\">{{name}}</span><a class=\"share-download\" href=\"{{download_url}}\" download>Download, {{size}}</a></figcaption></figure>",
  "image/": "<figure class=\"share-item\" id=\"item-{{n}}\" data-n=\"{{n}}\" data-name=\"{{name}}\" data-poster=\"{{form_poster_url|form_play_url|url}}\"><img loading=\"lazy\" alt=\"{{name}}\" src=\"{{form_play_url|url}}\"><figcaption><span class=\"share-name\">{{name}}</span><a class=\"share-download\" href=\"{{download_url}}\" download>Download original, {{size}}</a></figcaption></figure>",
  "": "<figure class=\"share-item share-file\" id=\"item-{{n}}\" data-n=\"{{n}}\" data-name=\"{{name}}\" data-poster=\"{{form_poster_url}}\"><a class=\"share-open\" href=\"{{url}}\">{{name}}</a><figcaption><span class=\"share-name\">{{type}}</span><a class=\"share-download\" href=\"{{download_url}}\" download>Download, {{size}}</a></figcaption></figure>"
}
