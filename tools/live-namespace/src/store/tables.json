{
  "_what": "The tables the person's files keep their names index in (src/store/mod.rs reads this once). Each table mirrors the column list of the archive table of the same name (ns_name, ns_folder, ns_file, ns_chunk, ns_alias, ns_spans), so the account owner's rows copy in with one INSERT ... SELECT: the archive's id and columns, plus `scope` (which scope a row is in: the names of one folder, the one files scope, and so on), `version`, and the two request columns, which a copy fills as the SELECT in README.md shows. A record is one flat object: a field whose value fits its column's kind lives in that column, any other field lives in `extra` (a JSON object), so no record loses a field. A scope no table claims is kept in `generic`.",
  "id_collation": "Ids compare as bytes, in every database, so a page's order is the same everywhere.",
  "tables": [
    {
      "table": "ns_name",
      "prefixes": ["@namespace/names", "@namespace/set-aside/names"],
      "columns": [
        { "name": "byte_length", "kind": "int" },
        { "name": "file", "kind": "text" },
        { "name": "identity", "kind": "text" },
        { "name": "kind", "kind": "text" },
        { "name": "modified_at_ms", "kind": "int" },
        { "name": "name", "kind": "text" },
        { "name": "named_at", "kind": "text" }
      ]
    },
    {
      "table": "ns_folder",
      "prefixes": ["@namespace/folders", "@namespace/set-aside/folders"],
      "columns": [
        { "name": "folder", "kind": "text" },
        { "name": "kind", "kind": "text" }
      ]
    },
    {
      "table": "ns_file",
      "exact": ["@namespace/files"],
      "columns": [
        { "name": "aliases", "kind": "json" },
        { "name": "byte_length", "kind": "int" },
        { "name": "checked_at", "kind": "text" },
        { "name": "key", "kind": "text" },
        { "name": "kind", "kind": "text" },
        { "name": "media_type", "kind": "text" },
        { "name": "names", "kind": "json" },
        { "name": "origin", "kind": "text" },
        { "name": "spans", "kind": "int" },
        { "name": "stored_at", "kind": "text" },
        { "name": "part_bytes", "kind": "int" },
        { "name": "prefix_identity", "kind": "text" },
        { "name": "span_layout", "kind": "text" },
        { "name": "span_set", "kind": "json" }
      ]
    },
    {
      "table": "ns_chunk",
      "exact": ["@namespace/chunks"],
      "columns": [
        { "name": "byte_length", "kind": "int" },
        { "name": "key", "kind": "text" },
        { "name": "kind", "kind": "text" },
        { "name": "origin", "kind": "text" },
        { "name": "stored_at", "kind": "text" }
      ]
    },
    {
      "table": "ns_alias",
      "exact": ["@namespace/aliases"],
      "columns": [
        { "name": "added_at", "kind": "text" },
        { "name": "grade", "kind": "text" },
        { "name": "identity", "kind": "text" },
        { "name": "kind", "kind": "text" }
      ]
    },
    {
      "table": "ns_spans",
      "exact": ["@namespace/spans"],
      "columns": [
        { "name": "kind", "kind": "text" },
        { "name": "spans", "kind": "json" }
      ]
    }
  ],
  "generic": "ns_record",
  "totals": [
    { "total": "namespace-file/origin", "table": "ns_file", "kind": "namespace-file", "group": "origin", "sum": "byte_length" },
    { "total": "namespace-name/all", "table": "ns_name", "kind": "namespace-name" },
    { "total": "namespace-chunk/all", "table": "ns_chunk", "kind": "namespace-chunk", "sum": "byte_length" },
    { "total": "namespace-upload/all", "scope": "@namespace/uploads", "kind": "namespace-upload", "sum": "byte_length" }
  ]
}
