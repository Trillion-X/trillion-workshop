            "description": "First byte to read, 0 by default"
          },
          "length": {
            "type": "integer",
            "description": "Most bytes to read"
          },
          "encoding": {
            "type": "string",
            "enum": [
              "auto",
              "base64"
            ],
            "description": "auto gives text for UTF-8, base64 always gives base64"
          },
