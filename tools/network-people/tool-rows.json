                    "findable": true,
                    "open_to_messages": true,
                    "show_pursuits": true,
                    "pursuits": [
                      "grain milling for bakers"
                    ],
                    "links": [],
                    "written": []
                  }
                }
              ]
            },
            "output_selector": "$.result.subject",
            "contains": false
          }
        ]
      }
    },
