{
  "kind": "tool-rows",
  "record_set": "space-members-tool-rows",
  "what_this_is": "The Workshop rows of tools/network-people: a person changes how they show in the Network, finds people by the words of a need, and sees people on the same pursuits. A profile is a record the caller stores; the rows read and write no store.",
  "records": [
    {
      "id": "package::network-people::tool::network-profile",
      "address": "package::network-people::tool::network-profile",
      "path": [
        "current-item",
        "published-record"
      ],
      "payload": {
        "kind": "ai-tool-descriptor",
        "id": "tool:network-profile",
        "label": "Set how people can find me",
        "status": "active",
        "job": "Change how this person shows in the Network: the name, handle, what they offer and seek, whether they are findable, and their pursuits",
        "description": "Answers the person's record:network-profile row under `keep` for the caller to store, with only the fields sent changed. A field a person wrote is listed under written. A handle is 3 to 30 letters, digits or underscores and is unique among the profiles handed in. A contact is kept on the person's own row and is never answered by this tool or the search tools.",
        "input_schema": {
          "type": "object",
          "required": [
            "subject",
            "records"
          ],
          "additionalProperties": false,
          "properties": {
            "subject": {
              "type": "string",
              "description": "The person, the way the Network names them"
            },
            "records": {
              "type": "array",
              "items": {
                "type": "object"
              },
              "description": "The profile rows the ask reads, as the caller read them from a store ({ id, type, value }). The run keeps nothing except a profile row to store, which comes back as `keep`."
            },
            "findable": {
              "type": "boolean"
            },
            "name": {
              "type": "string"
            },
            "handle": {
              "type": "string"
            },
            "about": {
              "type": "string"
            },
            "offering": {
              "type": "string"
            },
            "seeking": {
              "type": "string"
            },
            "links": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "pursuits": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "open_to_messages": {
              "type": "boolean"
            },
            "show_ais": {
              "type": "boolean"
            },
            "show_counts": {
              "type": "boolean"
            },
            "show_pursuits": {
              "type": "boolean"
            },
            "share_service_names": {
              "type": "boolean"
            },
            "contact": {
              "type": "string",
              "description": "Email, phone or handle; kept on the person's row and never answered by the search tools"
            }
          }
        },
        "output_schema": {
          "type": "object",
          "required": [
            "subject",
            "changed",
            "profile"
          ],
          "properties": {
            "subject": {
              "type": "string"
            },
            "changed": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "profile": {
              "type": "object"
            },
            "keep": {
              "type": "array",
              "items": {
                "type": "object"
              }
            }
          }
        },
        "invoke": {
          "kind": "container",
          "files": {
            "package_files": [
              {
                "package": "network-people",
                "paths": [
                  "do-work",
                  "read-data"
                ],
                "at": "/opt/network-people"
              }
            ]
          },
          "workdir": "/opt/network-people",
          "internet": false,
          "stdout": "json",
          "argv": [
            "node",
            "/opt/network-people/do-work/network-people-run.mjs",
            "networkProfile"
          ],
          "stdin": {
            "fill": {
              "from": "input"
            }
          }
        },
        "needs": {
          "expected_seconds": 3,
          "network_egress": false
        },
        "licence_class": "licence:maker-own",
        "placements": [
          "placement:small-container"
        ],
        "maker": "maker:network-people",
        "result_selector": "$.result",
        "provenance": {
          "source": "the old network_profile (tools/list-and-run-my-tools-for-any-ai/source-baselines/tools.mjs.held:295@a476dd597): the person's own Network profile, shown to other people only when findable"
        },
        "verify": [
          {
            "kind": "sample-run",
            "input": {
              "subject": "person:sample-ana",
              "handle": "sample_ana",
              "offering": "Sourdough baking classes at home",
              "records": [
                {
                  "id": "record:network-profile:person%3Asample-ana",
                  "type": "record:network-profile",
                  "value": {
                    "subject": "person:sample-ana",
                    "handle": "sample_ana",
                    "name": "Sample Ana",
                    "offering": "Sourdough baking classes at home",
                    "seeking": "Pastry sales help",
                    "findable": true,
                    "open_to_messages": true,
                    "show_pursuits": true,
                    "pursuits": [
                      "sourdough bread classes"
                    ],
                    "links": [],
                    "written": []
                  }
                }
              ]
            },
            "output_selector": "$.result.subject",
            "contains": false
          }
        ]
      }
    },
    {
      "id": "package::network-people::tool::find-network-people",
      "address": "package::network-people::tool::find-network-people",
      "path": [
        "current-item",
        "published-record"
      ],
      "payload": {
        "kind": "ai-tool-descriptor",
        "id": "tool:find-network-people",
        "label": "Find people in the Network",
        "status": "active",
        "job": "Find people in the Network whose profiles say what they offer and seek, matched by the words of a need",
        "description": "Answers the findable people whose offering, seeking or about share words with the need, best match first, each by handle and never by contact. A person who labelled the searcher unwanted-requests or unsafe is left out. Matching is by shared words, not by meaning. It replaces the old find_people, which matched by meaning and charged credits; neither is kept here.",
        "input_schema": {
          "type": "object",
          "required": [
            "subject",
            "records",
            "need"
          ],
          "additionalProperties": false,
          "properties": {
            "subject": {
              "type": "string",
              "description": "The person, the way the Network names them"
            },
            "records": {
              "type": "array",
              "items": {
                "type": "object"
              },
              "description": "The profile rows the ask reads, as the caller read them from a store ({ id, type, value }). The run keeps nothing except a profile row to store, which comes back as `keep`."
            },
            "need": {
              "type": "string",
              "description": "What you are looking for, in your own words, 300 characters at most"
            }
          }
        },
        "output_schema": {
          "type": "object",
          "required": [
            "subject",
            "need",
            "people"
          ],
          "properties": {
            "subject": {
              "type": "string"
            },
            "need": {
              "type": "string"
            },
            "people": {
              "type": "array",
              "items": {
                "type": "object"
              }
            }
          }
        },
        "invoke": {
          "kind": "container",
          "files": {
            "package_files": [
              {
                "package": "network-people",
                "paths": [
                  "do-work",
                  "read-data"
                ],
                "at": "/opt/network-people"
              }
            ]
          },
          "workdir": "/opt/network-people",
          "internet": false,
          "stdout": "json",
          "argv": [
            "node",
            "/opt/network-people/do-work/network-people-run.mjs",
            "findNetworkPeople"
          ],
          "stdin": {
            "fill": {
              "from": "input"
            }
          }
        },
        "needs": {
          "expected_seconds": 3,
          "network_egress": false
        },
        "licence_class": "licence:maker-own",
        "placements": [
          "placement:small-container"
        ],
        "maker": "maker:network-people",
        "result_selector": "$.result",
        "provenance": {
          "source": "the old find_people (tools/list-and-run-my-tools-for-any-ai/source-baselines/tools.mjs.held:297@a476dd597): people in the Network found for a need; the meaning match and the credit cost are not in this port"
        },
        "verify": [
          {
            "kind": "sample-run",
            "input": {
              "subject": "person:sample-bo",
              "need": "where can I learn sourdough baking",
              "records": [
                {
                  "id": "record:network-profile:person%3Asample-ana",
                  "type": "record:network-profile",
                  "value": {
                    "subject": "person:sample-ana",
                    "handle": "sample_ana",
                    "name": "Sample Ana",
                    "offering": "Sourdough baking classes at home",
                    "seeking": "Pastry sales help",
                    "findable": true,
                    "open_to_messages": true,
                    "show_pursuits": true,
                    "pursuits": [
                      "sourdough bread classes"
                    ],
                    "links": [],
                    "written": []
                  }
                },
                {
                  "id": "record:network-profile:person%3Asample-bo",
                  "type": "record:network-profile",
                  "value": {
                    "subject": "person:sample-bo",
                    "handle": "sample_bo",
                    "name": "Sample Bo",
                    "offering": "Flour milling",
