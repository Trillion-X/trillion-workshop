{
  "kind": "package-set-records",
  "record_set": "copy-rows-between-databases-tool-rows",
  "what_this_is": "The Workshop row that copies named rows of one table from one of the person's Postgres-wire databases to another inside the tool, answering only counts and each key's version. Both connection strings are the person's held values, handed to the one process on private pipes (credential_mounts fd 3 and fd 4). The process reaches each database by its address through the run's own proxy, which opens only a host the held values may go to.",
  "records": [
    {
      "payload": {
        "kind": "ai-tool-descriptor",
        "id": "tool:copy-rows-between-databases",
        "label": "Copy rows between my databases",
        "job": "Copy named rows of one table from one of my databases to another, and see only how many and each row's version",
        "description": "Copies the rows of one table whose key column holds the keys given, from the database held under source_credential_name to the one held under destination_credential_name, inside the tool: no row's body is in the request, the answer or the run's record, so rows of a megabyte or more are copied as easily as small ones. Each row is carried whole and the destination fills its own table's columns from the names in it, so the destination's table must already exist with the key column unique. on_conflict do_nothing keeps a key the destination already has; update_when_newer replaces it when version_column is smaller there than at the source. All keys are written in one transaction. Answers copied, updated, kept and missing counts, and for each key its result, the source's version and the destination's version after (a version is the md5 of the whole row as JSON, so the same row has the same version in both). A key the source does not have is answered as missing and nothing is written for it. It adds no shape, no list names and no record types.",
        "status": "active",
        "input_schema": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source_credential_name",
            "destination_credential_name",
            "table",
            "key_column",
            "keys"
          ],
          "properties": {
            "source_credential_name": {
              "type": "string",
              "minLength": 1,
              "description": "The held name of the source database's connection string. The login only needs to read the table."
            },
            "destination_credential_name": {
              "type": "string",
              "minLength": 1,
              "description": "The held name of the destination database's connection string. The login must be able to add (and for update_when_newer, change) rows of the table."
            },
            "table": {
              "type": "string",
              "minLength": 1,
              "description": "The table, or schema.table, in both databases."
            },
            "key_column": {
              "type": "string",
              "minLength": 1,
              "description": "The column the keys name; unique in the destination."
            },
            "keys": {
              "type": "array",
              "maxItems": 1000,
              "items": {
                "type": "string"
              },
              "description": "The key values, each as text; at most 1000."
            },
            "on_conflict": {
              "type": "string",
              "enum": [
                "do_nothing",
                "update_when_newer"
              ],
              "description": "A key the destination already has: do_nothing keeps it (the default); update_when_newer replaces it when version_column is smaller there."
            },
            "version_column": {
              "type": "string",
              "description": "The column whose larger value is newer; needed with update_when_newer, refused with do_nothing."
            }
          }
        },
        "output_schema": {
          "type": "object",
          "required": [
            "copied",
            "updated",
            "kept",
            "missing",
            "keys"
          ],
          "properties": {
            "copied": {
              "type": "integer"
            },
            "updated": {
              "type": "integer"
            },
            "kept": {
              "type": "integer"
            },
            "missing": {
              "type": "integer"
            },
            "keys": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "key",
                  "result",
                  "source_version",
                  "destination_version"
                ],
                "properties": {
                  "key": {
                    "type": "string"
                  },
                  "result": {
                    "type": "string",
                    "enum": [
                      "copied",
                      "updated",
                      "kept",
                      "missing"
                    ]
                  },
                  "source_version": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "destination_version": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                }
              }
            }
          }
        },
        "invoke": {
          "kind": "container",
          "internet": true,
          "workdir": "/opt/copy-rows-between-databases",
          "stdout": "json",
          "argv": [
            "node",
            "/opt/copy-rows-between-databases/do-work/copy-rows.mjs"
          ],
          "stdin": {
