          "type": "string"
         },
         "result": {
          "type": "string",
          "enum": [
           "removed",
           "absent",
           "failed"
          ]
         },
         "bytes": {
          "type": "integer"
         },
         "why": {
          "type": "string"
         }
        }
       }
      },
      "removed": {
       "type": "integer"
      },
      "absent": {
       "type": "integer"
      },
      "failed": {
       "type": "integer"
      },
      "prefix": {
       "type": "string"
      },
      "objects": {
       "type": "array",
       "items": {
        "type": "object",
        "properties": {
         "key": {
          "type": "string"
         },
         "size": {
          "type": "integer"
         },
         "last_modified": {
          "type": "string"
         }
        }
       }
      },
      "truncated": {
       "type": "boolean"
      },
      "next_token": {
       "type": [
        "string",
        "null"
       ]
      }
     }
    },
    "invoke": {
     "kind": "container",
     "internet": true,
     "workdir": "/opt/remove-objects-from-an-s3-store",
     "stdout": "json",
     "argv": [
      "node",
      "/opt/remove-objects-from-an-s3-store/do-work/remove-objects.ts"
     ],
     "files": {
      "package_files": [
       {
        "package": "remove-objects-from-an-s3-store",
        "paths": [
         "do-work"
        ],
        "at": "/opt/remove-objects-from-an-s3-store"
       },
       {
        "package": "read-objects-in-an-s3-store",
        "paths": [
         "do-work/read-objects.mjs"
        ],
        "at": "/opt/read-objects-in-an-s3-store"
       },
       {
        "package": "put-an-object-in-an-s3-store",
        "paths": [
         "do-work/put-object.mjs"
        ],
        "at": "/opt/put-an-object-in-an-s3-store"
       },
       {
        "packages": [
         "node_modules/@noble/hashes"
        ],
        "paths": [
         "LICENSE",
         "package.json",
         "blake3.js",
         "blake2.js",
         "_blake.js",
         "_md.js",
         "_u64.js",
         "utils.js"
        ],
        "at": "/opt/node_modules/@noble/hashes"
       }
      ]
     },
     "stdin": {
      "fill": {
       "from": "input"
      }
     },
     "credential_mounts": [
      {
       "secret_name_from_input": "store",
       "held_suffix": "-key-id",
       "fd": 3
      },
