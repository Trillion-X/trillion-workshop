{
  "kind": "tool-rows",
  "record_set": "run-a-typescript-program-with-no-build-tool-rows",
  "what_this_is": "The Workshop row for the run-a-typescript-program-with-no-build folder: one TypeScript program the engine's pinned Node runs as it is, with no build step, so any tool's program may be TypeScript. Runs in the tool container with no network.",
  "records": [
    {
      "id": "package::run-a-typescript-program-with-no-build::tool::run-a-typescript-program-with-no-build",
      "address": "package::run-a-typescript-program-with-no-build::tool::run-a-typescript-program-with-no-build",
      "path": [
        "current-item",
        "published-record"
      ],
      "payload": {
        "kind": "ai-tool-descriptor",
        "id": "tool:run-a-typescript-program-with-no-build",
        "label": "Run a TypeScript program with no build step",
        "status": "active",
        "job": "Show that a tool's program written in TypeScript runs on the engine's own Node with nothing built first",
        "description": "Answers the words it is given, the Node version that ran it and whether that Node strips TypeScript types itself. Its program is a .ts file with a type annotation and an interface, started as it is: the engine's pinned Node strips the types, so nothing is built and no built file is kept. It makes no call and reads nothing.",
        "input_schema": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "words"
          ],
          "properties": {
            "words": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4000,
              "description": "Any words; they come back as they were given."
            }
          }
        },
        "output_schema": {
          "type": "object",
          "required": [
            "words",
            "node",
            "types_stripped"
          ],
          "properties": {
            "words": {
              "type": "string"
            },
            "node": {
              "type": "string",
              "description": "The Node version that ran the program, such as v26.13.0."
            },
            "types_stripped": {
              "type": "boolean",
              "description": "True when that Node strips TypeScript types by default."
            }
          }
        },
        "invoke": {
          "kind": "container",
          "files": {
            "package_files": {
              "package": "run-a-typescript-program-with-no-build",
              "paths": [
                "do-work"
              ],
              "at": "/opt/run-a-typescript-program-with-no-build"
            }
          },
          "workdir": "/opt/run-a-typescript-program-with-no-build",
          "internet": false,
          "stdout": "json",
          "argv": [
            "node",
            "do-work/echo.ts"
          ],
          "stdin": {
            "fill": {
              "from": "input"
            }
          }
        },
        "result_selector": "$.result",
        "needs": {
          "expected_seconds": 2,
          "network_egress": false,
          "memory_mb": 64
        },
        "licence_class": "licence:maker-own",
        "placements": [
          "placement:small-container"
        ],
        "maker": "maker:run-a-typescript-program-with-no-build",
        "provenance": {
          "source": "new: the proof that a tool's program may be TypeScript run by the pinned Node with no build (Nov 25 2026)"
        },
        "verify": [
          {
            "kind": "sample-run",
            "input": {
              "words": "typed and run"
            },
            "output_selector": "$.result.types_stripped",
            "contains": "true"
          }
        ]
      }
    }
  ]
}
