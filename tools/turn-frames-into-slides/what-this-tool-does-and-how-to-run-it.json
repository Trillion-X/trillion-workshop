        "kind": "ai-tool-descriptor",
        "id": "tool:turn-frames-into-slides",
        "label": "Turn frames into slides",
        "status": "active",
        "job": "Turn a board's presentation frames into slides in story order, one page each, as SVG, printable HTML, a PDF and a picture of every page",
        "description": "Give a request file: board (its items: a presentation frame is an item with extra.presentationFrame.order, and every item centred inside it is on that slide), title, look_values and look_css (from tool:resolve-a-look, so any colour or font written as a variable name such as --accent-primary is the look's own), assets (name to file or https address; an item with src asset:<name> draws it, a file carried as its bytes), frames (the frame memberIds to make, in order; absent: every frame) and words_from (a filled word template from tool:fill-a-word-template: its tokens name the item they belong to, and that item's words become the filled ones). Text may show a look value as {{--name}} (a swatch label), so the value is never copied. An item may carry its own type: extra.fontSize, fontWeight, fontFamily, lineHeight, textInset and charWidth, and extra.imageFit contain for a logo. Every frame is one page of the frame's size. Writes slides/NN.svg and deck.html (which keeps the slide words as inert records a word template can be made from); with --pdf the PDF, with --pictures pages/NN.png. A variable the look lacks, an unknown asset or a frame of another size stops the run and says which. The request may be given inline as the step input's request (a workflow step passes { request, out }), or as a file; with keep the PDF is kept in the person's Files under /Slides and pdf names it.",
        "input_schema": {
          "type": "object",
          "required": ["request"],
          "additionalProperties": false,
          "properties": {
            "request": {"type": ["string", "object"], "description": "The request: its JSON object inline, or the path to its JSON file, put where {request} is in the command."},
            "out": {"type": "string", "description": "The folder to write the slides, the document, the PDF and the pictures into. Absent: a deck folder beside the request."}
          }
        },
        "output_schema": {
          "type": "object",
          "required": ["slides", "html"],
          "properties": {
            "slides": {"type": "array", "items": {"type": "object", "required": ["order", "label", "items", "svg"]}},
            "html": {"type": "string"},
            "pdf": {"type": "string", "description": "The PDF's name in the person's Files (kept with keep); its local copy is deck.pdf in the folder"},
            "pictures": {"type": "array", "items": {"type": "string"}}
          }
        },
        "invoke": {
          "kind": "on-your-computer",
          "get_it": ["clone the Workshop repository (package.json repository.url)", "a Chromium for the PDF and the pictures: npx playwright install chromium, or name one with --browser"],
          "run": "node tools/turn-frames-into-slides/do-work/make-slides.mjs {request} --pdf --pictures --keep",
          "needs": ["node", "chromium", "the signed-in command named by WORKSHOP_CLI (to keep the PDF in Files)"],
          "say": "This runs on the person's own computer, from the root of the Workshop checkout. Write the request (out names the folder), run `run`, then open the pictures and look at every page before you say it is done: text cut short ends in an ellipsis, so give that item more room. If the command exits 2, its standard error says what to change. If you cannot run commands, give them these steps."
        },
        "placements": ["placement:your-computer"],
        "licence_class": "licence:maker-own",
        "maker": "maker:turn-frames-into-slides",
        "provenance": {"source": "The group board's deck export: presentation frames in story order through the board's own SVG exporter"}
      }
    },
    {"payload": {"kind": "ai-tool-descriptor", "id": "tool:turn-frames-into-slides-from-a-request", "label": "Turn frames into slides from a request", "status": "active", "job": "Turn a board's presentation frames, or a deck's slides, into slides in story order as SVG and one printable HTML document, from a request given as JSON, and keep them in your files", "description": "The request tool:turn-frames-into-slides reads from a file, given here as JSON in `request`, so a workflow step runs it with no file of its own: board (its items, or {items}: a presentation frame is an item with extra.presentationFrame.order, and every item centred inside it is on that slide) or slides (the deck as slides: kinds words, compare, picture, table), title, look_values (from tool:resolve-a-look, so a colour or font written as a variable name such as --accent-primary is the look's own), assets (name to an https address), frames (the frame memberIds to make, in order; absent: every frame), words_from (a filled word template from tool:fill-a-word-template) and words_rules. The run writes slides/NN.svg and deck.html and keeps every file it wrote in your files (under Made by tools); the answer names each kept file's identity. It makes no PDF and no pictures (no browser runs here): for those, run tool:turn-frames-into-slides on your own computer. A variable the look lacks, an unknown asset, a frame of another size or words a rule refuses stop the run and say which.", "input_schema": {"type": "object", "required": ["request"], "additionalProperties": false, "properties": {"request": {"type": "object", "description": "The request as JSON: {board or slides, title?, look_values?, assets?, frames?, words_from?, words_rules?}, each given inline (a file the request names is not on the computer the run uses, except an https asset)."}}}, "output_schema": {"type": "object", "required": ["slides", "html"], "properties": {"slides": {"type": "array", "items": {"type": "object", "required": ["order", "label", "items", "svg"]}}, "html": {"type": "string"}, "files": {"type": "object", "description": "files.slides: each file the run wrote, kept in your files: {identity, name, bytes, media_type}."}}}, "invoke": {"kind": "container", "max_run_ms": 600000, "workdir": "/opt/turn-frames-into-slides", "stdout": "json", "run": ["node", "/opt/turn-frames-into-slides/do-work/make-slides.mjs", {"from": "request"}, "--out", "/opt/turn-frames-into-slides/out"], "request_file": {"fields": ["request"]}, "outputs": [{"name": "slides", "folder": "/opt/turn-frames-into-slides/out", "keep_in": "files"}], "files": {"package_files": [{"package": "turn-frames-into-slides", "paths": ["do-work", "read-data"], "at": "/opt/turn-frames-into-slides"}]}}, "licence_class": "licence:maker-own", "maker": "maker:turn-frames-into-slides", "provenance": {"source": "tool:turn-frames-into-slides's own program, run by the engine: the request given inline is written into the run's folder (trillion-rust src/tool_runs/tools/request_file.rs) and what it writes is kept in the person's files (output_files.rs). Made Nov 21 2026 so a workflow step can make slides (finding record:calendar-task:finding-tool-runner-inline-request-file-input-20261121)."}}}
  ]
