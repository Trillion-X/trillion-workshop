{
  "kind": "tool-rows",
  "record_set": "put-an-object-in-an-s3-store-tool-rows",
  "what_this_is": "The Workshop row for the tool in tools/put-an-object-in-an-s3-store.",
  "records": [
    {
      "id": "package::put-an-object-in-an-s3-store::tool::put-an-object-in-an-s3-store",
      "address": "package::put-an-object-in-an-s3-store::tool::put-an-object-in-an-s3-store",
      "path": [
        "current-item",
        "published-record"
      ],
      "payload": {
        "kind": "ai-tool-descriptor",
        "status": "active",
        "licence_class": "licence:maker-own",
        "placements": [
          "placement:small-container"
        ],
        "maker": "maker:put-an-object-in-an-s3-store",
        "needs": {
          "expected_seconds": 900,
          "network_egress": true
        },
        "read_only": false,
        "id": "tool:put-an-object-in-an-s3-store",
        "label": "Put a file into an S3-compatible store",
        "job": "Put one file from a folder I granted into one key of a storage bucket I keep the key of, such as a download or an update feed anyone can fetch",
        "description": "Puts one file from the folder the person granted this run (computer.read-a-folder.folder) into one key of an S3-compatible store (Backblaze B2, Cloudflare R2, any store that takes S3 PutObject), replacing what that key held, so a fixed key always answers the newest bytes. `store` names the store's values in the person's vault: <store>-key-id, <store>-secret, <store>-endpoint (an https root), <store>-bucket and <store>-region, such as downloads-store; they reach this run on private pipes, only for the account's owner, and each goes only to the hosts the vault keeps for it. The file is read by stream twice, once for its SHA-256 (the signed payload hash the store checks) and once to send, up to 5 GiB. Answers key, size, sha256, the store's etag and the address the object was put at; never a key value or a signature. A refused key means the store's key in the vault is not current.",
        "input_schema": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "store",
            "file",
            "key",
            "content_type"
          ],
          "properties": {
            "store": {
              "type": "string",
              "description": "The vault name the store's values begin with, such as downloads-store"
            },
            "file": {
              "type": "string",
              "description": "The file's name inside the granted folder, such as App.dmg"
            },
            "key": {
              "type": "string",
              "description": "The object key to put it at, such as App-202611241617.dmg"
            },
            "content_type": {
              "type": "string",
              "description": "The media type the object is served with, such as application/octet-stream"
            },
            "cache_control": {
              "type": "string",
              "description": "The Cache-Control words the object is served with, such as max-age=60"
            },
            "computer": {
              "type": "object",
              "description": "{\"read-a-folder\": {\"folder\": \"/absolute/folder/holding/the/file\"}}"
            }
          }
        },
        "output_schema": {
          "type": "object",
          "required": [
            "store",
            "key",
            "bytes",
            "blake3",
            "sha256",
            "etag"
          ],
          "properties": {
            "store": {
              "type": [
                "string",
                "null"
              ]
            },
            "key": {
              "type": "string"
            },
            "bytes": {
              "type": "integer"
            },
            "blake3": {
              "type": "string",
              "description": "The file's BLAKE3, its content identity"
            },
            "sha256": {
              "type": "string",
              "description": "The file's SHA-256, the payload hash the store signed and checked"
            },
            "etag": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "invoke": {
          "kind": "computer",
          "capabilities": [
            "read-a-folder"
          ],
          "may_reach": [],
          "workdir": "/opt/put-an-object-in-an-s3-store",
          "stdout": "json",
          "run": [
            "node",
            "/opt/put-an-object-in-an-s3-store/do-work/put-object.mjs"
          ],
          "files": {
            "package_files": [
              {
                "package": "put-an-object-in-an-s3-store",
                "paths": [
                  "do-work"
                ],
                "at": "/opt/put-an-object-in-an-s3-store"
              },
              {
                "package": "read-objects-in-an-s3-store",
                "paths": [
                  "do-work/read-objects.mjs"
                ],
                "at": "/opt/read-objects-in-an-s3-store"
              },
              {
                "packages": [
                  "node_modules/@noble/hashes"
                ],
                "paths": [
                  "LICENSE",
                  "package.json",
                  "blake3.js",
                  "blake2.js",
                  "_blake.js",
                  "_md.js",
                  "_u64.js",
                  "utils.js"
                ],
                "at": "/opt/node_modules/@noble/hashes"
              }
            ]
          },
          "stdin": {
            "input": {
              "fill": {
                "from": "input"
              }
            },
            "folder": {
              "fill": {
                "from": "task",
                "field": "grants.read-a-folder.folder"
              }
            }
          },
          "key": [
            {
              "secret_name_from_input": "store",
              "held_suffix": "-key-id",
              "fd": 3
            },
            {
              "secret_name_from_input": "store",
              "held_suffix": "-secret",
              "fd": 4
            },
            {
              "secret_name_from_input": "store",
              "held_suffix": "-endpoint",
              "fd": 5
            },
            {
              "secret_name_from_input": "store",
              "held_suffix": "-bucket",
              "fd": 6
            },
            {
              "secret_name_from_input": "store",
              "held_suffix": "-region",
              "fd": 7
            }
          ]
        },
        "result_selector": "$"
      }
    }
  ]
}
