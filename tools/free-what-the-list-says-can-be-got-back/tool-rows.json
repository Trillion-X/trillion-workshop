        "label": "Move eligible files from my list to Trash",
        "job": "Move files and folders my list says I can get back to recoverable Trash after checking the listed sources and recipes",
        "description": "Give 1 to 100 rows, each { id, value }, and the folder granted for change. Eligibility requires the saved state, no hold, a regular file or folder inside the grant, no top-level link or git-tracked files, at least one source address or recipe, every source answering, every recipe tracked, unchanged and pushed, and no changes within the quiet hours or during the check. A source answering proves availability only, not identical or complete recovery bytes. dry_run defaults to true and moves nothing. A real run asks the native macOS Trash service; it never permanently deletes or empties Trash, and a denied move returns no next_value. Only a confirmed move returns next_value with the moved-to-Trash state. path_bytes and trashed_path_bytes describe observed path allocation, not reclaimed storage; freed_bytes is null because it is unmeasured. The change-a-folder grant may refuse Trash access; this tool never widens it. Field names and state words are DATA in read-data/kept-file-shape.json, overridden by shape.",
        "input_schema": {
          "type": "object",
          "required": [
            "rows"
          ],
          "additionalProperties": false,
          "properties": {
            "rows": {
              "type": "array",
              "minItems": 1,
              "maxItems": 100,
              "items": {
                "type": "object",
                "required": [
                  "id",
                  "value"
                ],
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "value": {
                    "type": "object"
                  }
                }
              },
              "description": "Rows of the person's list of files and how to get them back"
            },
            "dry_run": {
              "type": "boolean",
              "description": "true (the default) moves nothing; false requests recoverable native Trash moves within the current grant"
            },
            "shape": {
              "type": "object",
              "description": "Only the field names, state words or quiet_hours that differ from read-data/kept-file-shape.json"
            }
          }
        },
        "output_schema": {
          "type": "object",
          "required": [
            "dry_run",
            "rows",
            "eligible_count",
            "eligible_path_bytes",
            "trashed_count",
            "trashed_path_bytes",
            "freed_bytes"
          ],
          "properties": {
            "dry_run": {
              "type": "boolean"
            },
            "rows": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "id",
                  "eligible_for_trash",
                  "path_bytes"
                ],
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "eligible_for_trash": {
                    "type": "boolean"
                  },
                  "path_bytes": {
                    "type": [
                      "number",
                      "null"
                    ],
                    "description": "Observed path allocation for eligible paths; null when the path check did not establish it"
                  },
                  "reason": {
                    "type": "string"
                  },
                  "trashed": {
                    "type": "boolean"
                  },
                  "trash_outcome": {
                    "enum": [
                      "moved",
                      "not_started",
                      "unknown"
                    ],
                    "description": "Only moved confirms disposal; unknown stops subsequent disposal without retrying"
                  },
                  "next_value": {
                    "type": "object"
                  }
                }
              }
            },
            "eligible_count": {
              "type": "number"
            },
            "eligible_path_bytes": {
              "type": "number"
            },
            "trashed_count": {
              "type": "number"
            },
            "trashed_path_bytes": {
              "type": "number"
            },
            "freed_bytes": {
              "type": "null",
              "description": "Unmeasured: moving to Trash does not establish physical disk space reclaimed"
            }
          }
        },
        "invoke": {
          "kind": "computer",
          "capabilities": [
            "change-a-folder"
          ],
          "workdir": "/opt/free-what-the-list-says-can-be-got-back",
          "internet": true, "public_read": true,
          "stdout": "json",
          "parent_actions": {
            "fd": 3
          },
          "argv": [
            "node",
            "/opt/workflows/do-work/run-a-function.mjs",
            "/opt/free-what-the-list-says-can-be-got-back/do-work/free-what-the-list-says-can-be-got-back.mjs",
            "freeWhatTheListSays",
            "--parent-actions-fd",
            "3"
          ],
          "stdin": {
            "input": {
              "fill": {
                "from": "input"
              }
            },
            "folder": {
              "fill": {
                "from": "task",
                "field": "grants.change-a-folder.folder"
              }
            }
          },
          "files": {
            "package_files": [
              {
                "package": "free-what-the-list-says-can-be-got-back",
                "paths": [
                  "do-work",
                  "read-data"
                ],
                "at": "/opt/free-what-the-list-says-can-be-got-back"
              },
              {
                "package": "workflows",
                "paths": [
                  "do-work/run-a-function.mjs",
                  "read-data/host-actions.mjs"
                ],
                "at": "/opt/workflows"
              }
            ]
          }
        },
