        "kind": "ai-tool-descriptor",
        "id": "tool:correct-a-message-recorded-as-the-person",
        "label": "Correct a message recorded as the person",
        "status": "active",
        "job": "Correct a message kept as the person's own words when it was really said by a diagnostic, a peer or generated context: the corrected message keeps its text and time, and the false row, its arrivals and its thread row retire",
        "description": "Give the kept message's id, the speaker it really came from (sdk diagnostic, peer or generated context), the evidence, and the rows read from the store ([{ id, type, value }]: the message, its arrival rows and its thread index row when there is one). Answers the correction under `correction` and the rows that change under `keep` ([{ id, type, value, expected }]) for the caller to store. Only a kept person message can be corrected, and the same correction again answers the first one.",
        "input_schema": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "records",
            "message_id",
            "speaker",
            "evidence"
          ],
          "properties": {
            "records": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "id",
                  "type"
                ]
              },
              "description": "The rows the ask reads, as the caller read them from its store: the message, its arrival rows, and its thread index row when one exists."
            },
            "message_id": {
              "type": "string",
              "description": "The kept person message's id."
            },
            "speaker": {
              "type": "string",
              "enum": [
                "sdk diagnostic",
                "peer",
                "generated context"
              ],
              "description": "The speaker the message really came from."
            },
            "evidence": {
              "type": "string",
              "description": "The source evidence (the transcript or source) that shows who said it."
            },
            "now": {
              "type": "string",
              "description": "The time the correction is stamped, as ISO text; left out, the current time."
            }
          }
        },
        "output_schema": {
          "type": "object",
          "required": [
            "correction",
            "keep"
          ],
          "properties": {
            "correction": {
              "type": "object",
              "description": "The correction, kept under message-provenance-correction:<message_id>."
            },
            "keep": {
              "type": "array",
              "items": {
                "type": "object"
              },
              "description": "The rows to change, each { id, type, value, expected }; value null retires the row."
            }
          }
        },
