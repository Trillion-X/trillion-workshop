          "enable",
          "--now",
          "{label}.service"
        ]
      ],
      "proved_on": null
    },
    {
      "id": "quadlet-container",
      "scope": "container",
      "match": {
        "platform": "linux"
      },
      "template": "init-quadlet.container",
      "file": "/etc/containers/systemd/{label}.container",
      "mode": "0644",
      "requires": [
        "image"
      ],
      "escape": [
        [
          "%",
          "%%"
        ]
      ],
      "argument": {
