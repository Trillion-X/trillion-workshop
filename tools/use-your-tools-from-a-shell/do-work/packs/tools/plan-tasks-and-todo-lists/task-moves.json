      "set": {"assignees": {"from": "input", "field": "assignees", "required": true, "format": "assignees"}, "handed_on": {"from": "note", "field": "because"}},
      "clear": ["released", "released_taken_at"]
    },
    {
      "action": "finish", "from": "In progress", "to": "Done",
      "when": {"kind":"group","combinator":"and","negate":false,"rules":[{"kind":"rule","field":"is_taker","operator":"equals","params":{"value":true}}]},
      "set": {"result": {"from": "input", "field": "result", "required": true, "most_chars": 60000}, "summary": {"from": "input", "field": "summary"}, "finished_at": {"from": "now"}, "finished_by": {"from": "as"}, "check": {"from": "input", "field": "check", "required": true, "format": "check"}},
      "clear": ["stuck", "continuation"]
    },
    {
      "action": "fail", "from": "In progress", "to": "Broken",
