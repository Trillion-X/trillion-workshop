    {"key": "Done", "label": "Done", "terminal": true},
    {"key": "Broken", "label": "Could not be done", "terminal": true},
    {"key": "Not needed", "label": "Taken back by whoever gave it", "terminal": true}
  ],
  "read_as": { "Not started": "To do", "Blocked": "Waiting" },
