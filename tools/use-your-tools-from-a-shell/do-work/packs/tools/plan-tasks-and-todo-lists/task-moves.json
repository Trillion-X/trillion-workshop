      "set": {"resumed": {"from": "note", "field": "because", "required": true}},
      "clear": ["taken_by", "taken_at", "stuck"]
    },
    {
      "action": "withdraw", "from": "Waiting", "to": "Not needed",
      "when": {"kind":"group","combinator":"and","negate":false,"rules":[{"kind":"rule","field":"is_sender","operator":"equals","params":{"value":true}}]},
      "set": {"withdrawn": {"from": "note", "field": "because"}},
      "clear": ["continuation"]
    },
    {"action": "edit", "from": "To do", "to": "To do", "when": {"kind":"group","combinator":"and","negate":false,"rules":[{"kind":"rule","field":"is_sender","operator":"equals","params":{"value":true}}]}, "needs_any": ["description", "outcome", "title", "source", "obligations", "assignees", "priority", "acceptance"], "set": {"description": {"from": "input", "field": "description", "most_chars": 20000}, "outcome": {"from": "input", "field": "outcome"}, "title": {"from": "input", "field": "title"}, "source": {"from": "input", "field": "source", "format": "source"}, "obligations": {"from": "input", "field": "obligations", "format": "obligations"}, "assignees": {"from": "input", "field": "assignees", "format": "assignees"}, "priority": {"from": "input", "field": "priority", "format": "priority"}, "acceptance": {"from": "input", "field": "acceptance", "format": "acceptance"}}, "clear": ["released", "released_taken_at"]},
    {"action": "edit", "from": "Waiting", "to": "Waiting", "when": {"kind":"group","combinator":"and","negate":false,"rules":[{"kind":"rule","field":"is_sender","operator":"equals","params":{"value":true}}]}, "needs_any": ["description", "outcome", "title", "source", "obligations", "assignees", "priority", "acceptance"], "set": {"description": {"from": "input", "field": "description", "most_chars": 20000}, "outcome": {"from": "input", "field": "outcome"}, "title": {"from": "input", "field": "title"}, "source": {"from": "input", "field": "source", "format": "source"}, "obligations": {"from": "input", "field": "obligations", "format": "obligations"}, "assignees": {"from": "input", "field": "assignees", "format": "assignees"}, "priority": {"from": "input", "field": "priority", "format": "priority"}, "acceptance": {"from": "input", "field": "acceptance", "format": "acceptance"}}, "clear": ["released", "released_taken_at"]},
