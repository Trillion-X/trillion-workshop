      "set": {"taken_by": {"from": "as"}, "taken_at": {"from": "now"}},
      "clear": ["stuck", "released"]
    },
    {
      "action": "take", "from": "In progress", "to": "In progress",
      "when": {"kind":"group","combinator":"and","negate":false,"rules":[{"kind":"rule","field":"addressed_to_me","operator":"equals","params":{"value":true}},{"kind":"rule","field":"taken_minutes","operator":"at_least","params":{"value":120}}]},
      "set": {"taken_by": {"from": "as"}, "taken_at": {"from": "now"}},
      "clear": ["stuck", "released"]
    },
    {
      "action": "release", "from": "In progress", "to": "To do",
      "when": {"kind":"group","combinator":"or","negate":false,"rules":[{"kind":"rule","field":"is_taker","operator":"equals","params":{"value":true}},{"kind":"rule","field":"taken_minutes","operator":"at_least","params":{"value":120}}]},
      "set": {"released": {"from": "note", "field": "because"}, "continuation": {"from": "input", "field": "continuation", "format": "continuation"}, "released_taken_at": {"from": "job", "field": "taken_at"}},
      "clear": ["taken_by", "taken_at", "stuck"]
    },
    {
      "action": "hand-on", "from": "In progress", "to": "To do",
