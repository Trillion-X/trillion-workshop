      "set": {"assignees": {"from": "input", "field": "assignees", "required": true, "format": "assignees"}, "handed_on": {"from": "note", "field": "because"}, "released_taken_at": {"from": "job", "field": "taken_at"}},
      "clear": ["taken_by", "taken_at", "stuck", "continuation"]
    },
    {
      "action": "hand-on", "from": "To do", "to": "To do",
