  "what_this_is": "The Workshop rows for tools/meaning-search: the package's find-similar-vector and find-similar actions on the person's own index descriptor and vector set, the same question over several descriptors, the words said in a set's lines, and the builders of a vector set.",
  "records": [
    {
      "payload": {
        "kind": "ai-tool-descriptor",
        "id": "tool:find-similar-to-a-vector",
        "label": "Find what is closest to a vector",
        "job": "Find the moments in my recordings, pictures or documents closest in meaning to a query vector, such as the picture vector of some words, and say the file and time of each",
        "description": "Runs meaning-search's find-similar-vector on one of the person's semantic-index-descriptor records: the descriptor's vector set (items and their vectors, two of the person's files) is indexed by the package's own scripts for the run, the ANN index narrows the candidates and the exact cosine ranks them, best first, never padded below the descriptor's min_score. query_vector_base64 is base64 of JSON {\"vector\": [...]} made by the model the descriptor names (tool:words-as-picture-vector gives one for words when the set holds picture vectors). Returns index_id, model_id, model_version, result (items with address, score, revision and payload_hash; considered, skipped, min_score) and points_to (each address's file, start, end and text). With spread ({per_file, seconds_apart}) the answer holds at most per_file items of one file, that far apart, so many neighbouring frames of one take do not fill it.",
        "status": "active",
        "input_schema": {
          "type": "object",
          "required": ["index_id", "query_vector_base64"],
          "additionalProperties": false,
          "properties": {
            "index_id": { "type": "string", "minLength": 1, "description": "The index_id of one of the person's semantic-index-descriptor records" },
            "query_vector_base64": { "type": "string", "minLength": 1, "description": "base64 of JSON {\"vector\": [...]}, made by the model the descriptor names" },
            "limit": { "type": "integer", "minimum": 1, "description": "At most this many items; the descriptor's result_limit caps it" },
            "spread": { "type": "object", "additionalProperties": false, "required": ["per_file"], "description": "Keep one recording from filling the answer: best first, an item is set aside when its file already has per_file items in the answer or one closer than seconds_apart to it (an item with no time counts once per file). The package ranks up to the descriptor's result_limit, then the answer is cut to limit; result.spread says how many were set aside.", "properties": { "per_file": { "type": "integer", "minimum": 1 }, "seconds_apart": { "type": "number", "minimum": 0 } } }
          }
        },
        "output_schema": {
          "type": "object",
          "required": ["index_id", "result", "points_to"],
          "properties": {
            "index_id": { "type": "string" },
            "model_id": { "type": "string" },
            "model_version": { "type": "string" },
            "result": { "type": "object", "required": ["items"], "properties": { "items": { "type": "array" } } },
            "points_to": { "type": "object" }
          }
        },
        "result_selector": "$.result",
