  "workflows": [],
  "tools": [
    "tool:find-faces",
    "tool:keep-who-appeared",
    "tool:who-is-in-this"
  ],
  "instructions": [
    "1. Enrol each person once with tool:enrol-a-voice-or-face, saying who agreed and how; nobody is named who has not.",
    "2. Say \"Run the keep-who-appeared-in-a-recording recipe\" with the recording's identity, and the place and day when you know them.",
    "3. Read the rows it kept with tool:where-someone-appeared, by person or by recording; a voice nobody enrolled is kept as voice-1, voice-2 and so on.",
    "4. Enrol an unknown voice later (tool:enrol-a-voice-or-face with heard_voice) and run the workflow again: its stretches become named rows and the unknown ones are marked superseded."
  ],
  "worked_examples": [
    {
      "title": "Keep who appeared in a recording",
      "ask": "Keep who appeared in a recording",
      "mcp": {
        "server": "trillion",
        "tool": "run_resource_operation",
        "input": {
          "address": "@workshop-tools",
          "method": "tools:run",
          "input": {
            "tool": "tool:keep-who-appeared",
            "input": {
              "recording": "1f:abababababababababababababababababababababababababababababababab",
              "recording_name": "sample-call.wav",
              "people": {
                "sample-one": "people/sample-one"
              },
              "heard": [
                {
                  "start": 0,
                  "end": 12.5,
                  "who": "Ada Example",
                  "person": "sample-one",
                  "me": true,
                  "voice": "sample-one",
                  "score": 0.91,
                  "text": "Welcome to the made-up call."
                }
              ]
            }
          }
        }
      },
      "given": "A recording with one enrolled speaker, named by tool:who-is-in-this for the first 12 seconds, and the person's own row people/sample-one.",
      "hands_back": "{\"list_id\":\"appearances\",\"kept\":1,\"named\":1,\"possible\":0,\"unknown\":0,\"superseded\":0,\"row_ids\":[\"appearances/<recording>:voice:0:sample-one\"]}"
    }
  ],
