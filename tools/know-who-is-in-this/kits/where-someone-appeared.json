  "workflows": [],
  "tools": [
    "tool:where-someone-appeared"
  ],
  "instructions": [
    "1. Fill list:appearances first with the keep-who-appeared-in-a-recording recipe, or pour the two example rows into your own list (see pour).",
    "2. Ask for a person (their id in the voice and face prints), a recording (its identity) or words (a name, a place, a spoken word).",
    "3. Read the rows in recording order, with who and which recordings they name and how many rows each has.",
    "4. Add include_superseded to also see the rows a later keep replaced."
  ],
  "worked_examples": [
    {
      "title": "Where someone appeared",
      "ask": "Where someone appeared",
      "mcp": {
        "server": "trillion",
        "tool": "run_resource_operation",
        "input": {
          "address": "@workshop-tools",
          "method": "tools:run",
          "input": {
            "tool": "tool:where-someone-appeared",
            "input": {
              "person": "sample-one"
            }
          }
        }
      },
      "given": "The two example rows of list:appearances for person sample-one.",
      "hands_back": "{\"appearances\":[{\"subject\":\"Ada Example\",\"how\":\"voice\",\"recording_name\":\"sample-call.wav\",\"start\":0,\"end\":12.5},{\"subject\":\"Ada Example\",\"how\":\"face\",\"recording_name\":\"sample-call.wav\",\"start\":0,\"end\":6}],\"people\":[{\"id\":\"sample-one\",\"label\":\"Ada Example\",\"appearances\":2}],\"recordings\":[{\"id\":\"1f:abababababababababababababababababababababababababababababababab\",\"label\":\"sample-call.wav\",\"appearances\":2}]}"
    }
  ],
