// A STREAMED ANSWER MUST READ LIKE ANY OTHER ANSWER.
//
// Asking for the words as they are written changes the shape of what comes
// back: not one document but a run of them, each carrying the next few words.
// If that difference reaches the rules that read an answer, then streaming and
// structured output and response paths all have to know about each other, and
// turning streaming on for one participant quietly changes what every rule
// downstream is looking at.
//
// So the run is folded back into ONE document shaped exactly like a single
// answer, and nothing after that point learns streaming exists.
import { describe, expect, it } from 'vitest';

import {
  documentsInTheRun,
  oneAnswerFromTheRun,
  wordsInTheRun,
} from '../read-data/an-answer-arriving-in-documents';

const PATH = ['candidates', 0, 'content', 'parts', 0, 'text'];

function event(text: string, extra: Record<string, unknown> = {}) {
  return `data: ${JSON.stringify({ candidates: [{ content: { parts: [{ text }] }, ...extra }] })}\n`;
}

describe('folding a run of documents back into one answer', () => {
  it('produces the same shape a single answer has, with all the words in it', () => {
    const run = event('Trillion ') + event('finds the ') + event('needle mover.');
    expect(oneAnswerFromTheRun(run, PATH)).toEqual({
      candidates: [{ content: { parts: [{ text: 'Trillion finds the needle mover.' }] } }],
    });
  });

  // The closing details only exist on the last document, which is why it is
  // used as the frame rather than the first.
  it('keeps what only the last document knows, such as why it stopped', () => {
    const run = event('Half ') + event('done.', { finishReason: 'STOP' });
    const folded = oneAnswerFromTheRun(run, PATH) as { candidates: { finishReason?: string }[] };
    expect(folded.candidates[0].finishReason).toBe('STOP');
    expect(wordsInTheRun(run, PATH)).toBe('Half done.');
  });

  it('a half written document at the end is skipped, not an error', () => {
    const run = event('Kept') + 'data: {"candidates":[{"content":{"parts":[{"text":"cut';
    expect(documentsInTheRun(run)).toHaveLength(1);
    expect(wordsInTheRun(run, PATH)).toBe('Kept');
  });

  it('an answer that never arrived folds to nothing rather than throwing', () => {
    expect(oneAnswerFromTheRun('', PATH)).toEqual({});
    expect(oneAnswerFromTheRun('data: [DONE]\n', PATH)).toEqual({});
  });

  // WHERE the words sit is the adapter's DATA. Nothing here knows any one
  // provider's shape.
  it('folds a different answer shape from a different declared path', () => {
    const run = `data: ${JSON.stringify({ delta: { chunk: 'A' } })}\n`
      + `data: ${JSON.stringify({ delta: { chunk: 'B' } })}\n`;
    expect(oneAnswerFromTheRun(run, ['delta', 'chunk'])).toEqual({ delta: { chunk: 'AB' } });
  });

  it('a path naming nothing is no words rather than a wrong answer', () => {
    expect(wordsInTheRun(event('x'), ['nowhere'])).toBe('');
    expect(wordsInTheRun(event('x'), [])).toBe('');
  });
});
