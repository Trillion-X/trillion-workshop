// THE WORDS OF A JSON ANSWER STILL BEING WRITTEN.
//
// An answer asked for as structured JSON streams as JSON text. What a person
// should see while it arrives is the VALUE of one field, not the braces around
// it, and the document is not valid JSON until its last byte lands. These
// checks pin the reader that bridges the two, using the shape one real provider
// sends (`step.delta` events whose `delta.text` carries the next few characters
// of the JSON document).
import { describe, expect, it } from 'vitest';

import {
  readUnfinishedJson,
  textSoFarAt,
  wordsInTheRun,
} from '../read-data/an-answer-arriving-in-documents';

const DELTA_TEXT = ['delta', 'text'];

function textDelta(text: string) {
  return `event: step.delta\ndata: ${JSON.stringify({ event_type: 'step.delta', index: 0, delta: { type: 'text', text } })}\n\n`;
}

function thoughtDelta(content: string) {
  return `event: step.delta\ndata: ${JSON.stringify({ event_type: 'step.delta', index: 0, delta: { type: 'thought_summary', content } })}\n\n`;
}

describe('reading a field out of JSON that is still arriving', () => {
  it('shows the words of a field whose closing quote has not arrived', () => {
    expect(textSoFarAt('{"reply":"What I under', ['reply'])).toBe('What I under');
  });

  it('shows nothing while only the key has arrived, never the braces', () => {
    expect(textSoFarAt('{"reply":', ['reply'])).toBe('');
    expect(textSoFarAt('{"rep', ['reply'])).toBe('');
    expect(textSoFarAt('', ['reply'])).toBe('');
  });

  it('decodes escapes, and holds back an escape cut in half', () => {
    expect(textSoFarAt('{"reply":"Line one\\nLine \\"two\\"', ['reply'])).toBe('Line one\nLine "two"');
    expect(textSoFarAt('{"reply":"Half \\', ['reply'])).toBe('Half ');
    expect(textSoFarAt('{"reply":"Caf\\u00e9 and \\u00', ['reply'])).toBe('Café and ');
  });

  it('reads past finished fields to the one being written', () => {
    const text = '{"questions":[{"id":"q-7","text":"Who pays?"}],"count":3,"reply":"Send five';
    expect(textSoFarAt(text, ['reply'])).toBe('Send five');
    expect(readUnfinishedJson(text)).toEqual({
      questions: [{ id: 'q-7', text: 'Who pays?' }],
      count: 3,
      reply: 'Send five',
    });
  });

  // `12` may still become `123`, so a number touching the end is left out
  // rather than shown and then changed.
  it('does not guess a number that may still be growing', () => {
    expect(readUnfinishedJson('{"count":12')).toEqual({});
    expect(readUnfinishedJson('{"count":12,')).toEqual({ count: 12 });
  });

  it('agrees with JSON.parse once the document is complete', () => {
    const whole = { reply: 'Done.\nNext step: ask one buyer.', questions: [{ id: 'a', kinds: ['x', 'y'] }], ok: true, none: null };
    expect(readUnfinishedJson(JSON.stringify(whole))).toEqual(whole);
  });
});

describe('the run a provider sends, read end to end', () => {
  it('takes only text deltas, then reads the reply field out of the joined JSON', () => {
    const run = thoughtDelta('Planning the answer')
      + textDelta('{"re')
      + textDelta('ply":"Send a direct ')
      + textDelta('message to five buyers');
    const joined = wordsInTheRun(run, DELTA_TEXT);
    expect(joined).toBe('{"reply":"Send a direct message to five buyers');
    expect(textSoFarAt(joined, ['reply'])).toBe('Send a direct message to five buyers');
  });

  it('never goes backwards as more of the run arrives', () => {
    const parts = ['{"reply":"', 'Send ', 'a di', 'rect\\n', 'message', '"}'];
    let run = '';
    let previous = '';
    for (const part of parts) {
      run += textDelta(part);
      const now = textSoFarAt(wordsInTheRun(run, DELTA_TEXT), ['reply']);
      expect(now.startsWith(previous)).toBe(true);
      previous = now;
    }
    expect(previous).toBe('Send a direct\nmessage');
  });
});
