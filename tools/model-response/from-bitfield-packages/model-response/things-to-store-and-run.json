                "timeout_ms": 30000,
                "termination_grace_ms": 1000,
                "expected_termination": null,
                "env": {},
                "inputs": [
                  {
                    "mount_path": "materialize-addressed-content-parts.mjs",
                    "content_type": "text/javascript",
                    "executable": true,
                    "source": {
                      "kind": "blob_ref",
                      "hash": {
                        "$kind": "binding",
                        "select": {
                          "from": "steps",
                          "key": "read_materializer",
                          "path": "output.content_hash"
                        }
                      }
                    }
                  },
                  {
                    "mount_path": "content.bin",
                    "content_type": {
                      "$kind": "binding",
                      "select": {
                        "from": "input",
                        "path": "parts.0.mime_type"
                      }
                    },
                    "source": {
                      "kind": "blob_ref",
                      "hash": {
                        "$kind": "binding",
                        "select": {
                          "from": "input",
                          "path": "parts.0.source.hash"
                        }
                      }
                    }
                  },
                  {
                    "mount_path": "request.json",
                    "content_type": "application/json",
                    "source": {
                      "kind": "inline",
                      "bytes": {
                        "$kind": "binding",
                        "select": {
                          "from": "input",
                          "path": ""
                        },
                        "transform": [
                          {
                            "op": "op:core.stringify",
                            "args": {
                              "format": "json"
                            }
                          },
                          {
                            "op": "op:core.encode",
                            "args": {
                              "encoding": "base64"
                            }
                          }
                        ]
                      }
                    }
                  }
                ],
                "input_trees": [],
                "outputs": [
                  {
                    "mount_path": "result.json",
                    "content_type": "application/json",
                    "storage": "inline"
                  }
                ],
                "containment": {
                  "kind": "descendant_effect_contained",
                  "pipe_eof_timeout_ms": 1000,
                  "publications": []
                },
                "capture_fds": [
                  1,
                  2
                ],
                "collected_files": []
              }
            }
          },
          {
            "id": "return_result",
            "kind": "return",
            "join": "any",
            "join_config": null,
            "config": {
              "value": {
                "$kind": "binding",
                "select": {
                  "from": "steps",
                  "key": "run_materializer",
                  "path": "output.outputs.0.bytes.base64"
                },
                "transform": [
                  {
                    "op": "op:core.decode",
                    "args": {
                      "encoding": "base64"
                    }
                  },
                  {
                    "op": "op:core.json_parse"
                  }
                ]
              }
            }
          }
        ],
        "trigger_source": "",
        "trigger_type": "manual",
        "version": 0
