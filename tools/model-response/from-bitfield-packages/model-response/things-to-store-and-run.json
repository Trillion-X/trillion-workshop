        "id": "action:materialize-addressed-content-parts",
        "kind": "action",
        "is_active": true,
        "name": "materialize-addressed-content-parts",
        "description": "Materialize addressed content with this owner's fixed process descriptor. The caller supplies only addressed content part metadata and blob references; executable, mounts, output, target, sandbox, and limits are owner data.",
        "input_schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "required": [
            "parts",
            "policy"
          ],
          "properties": {
            "parts": {
              "type": "array",
              "minItems": 1,
              "maxItems": 1,
              "items": {
                "type": "object",
                "required": [
                  "kind",
                  "address",
                  "content_kind",
                  "mounted_path",
                  "source",
                  "mime_type",
                  "byte_length",
                  "integrity_hash",
                  "delivery"
                ],
                "properties": {
                  "kind": {
                    "const": "addressed-content"
                  },
                  "address": {
                    "type": "string",
                    "minLength": 1
                  },
                  "content_kind": {
                    "type": "string",
                    "minLength": 1
                  },
                  "mounted_path": {
                    "type": "string",
                    "pattern": "^(?!/)(?!.*\\\\)(?!.*\\.\\.)[^\\u0000]+$"
                  },
                  "source": {
                    "type": "object",
                    "required": [
                      "kind",
                      "hash"
                    ],
                    "properties": {
                      "kind": {
                        "const": "blob_ref"
                      },
                      "hash": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "additionalProperties": false
                  },
                  "mime_type": {
                    "type": "string",
                    "pattern": "^[a-z]+/[a-z0-9!#$&^_.+-]+$"
                  },
                  "byte_length": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 20971520
                  },
                  "integrity_hash": {
                    "type": "string",
                    "pattern": "^1f:[0-9a-f]{64}$"
                  },
                  "delivery": {
                    "type": "object",
                    "required": [
                      "kind"
                    ],
                    "properties": {
                      "kind": {
                        "enum": [
                          "inline-base64",
                          "file-recipe"
                        ]
                      },
                      "recipe": {
                        "type": "object",
                        "additionalProperties": true
                      }
                    },
                    "additionalProperties": false
                  }
                },
                "additionalProperties": false
              }
            },
            "policy": {
              "type": "object",
              "required": [
                "accepted_content_kinds",
                "content_kind_wire_types",
                "max_bytes"
              ],
              "properties": {
                "accepted_content_kinds": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string"
                  }
                },
                "content_kind_wire_types": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  }
                },
                "max_bytes": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 20971520
                },
                "max_inline_bytes": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 20971520
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "steps": [
          {
            "id": "read_materializer",
            "kind": "read",
            "join": "any",
            "join_config": null,
            "config": {
              "from": "package::model-response::stored-bytes::materialize-addressed-content-parts"
            }
          },
          {
            "id": "run_materializer",
            "kind": "ask",
            "join": "any",
            "join_config": null,
            "config": {
              "name": "compute.process",
              "input": {
                "argv": [
                  "node",
                  "materialize-addressed-content-parts.mjs",
