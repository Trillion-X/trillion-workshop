import {
  createTrustedRuntimeIdMinter,
  readTrustedRuntimeClockMs,
  sendRequestToBitfieldTarget,
  type BitfieldRuntimeContext,
} from '@bitfield/runtime-kit';
import Ajv2020 from 'ajv/dist/2020.js';
import {
  spendGateAskForModelRequest,
  spendGateApproved,
  spendGateRefusalMessage,
} from './whose-money-pays-for-this';
import { oneAnswerFromTheRun, wordsInTheRun } from '../read-data/an-answer-arriving-in-documents';

type JsonRecord = Record<string, unknown>;

type RequestInput = {
  body?: string;
  content_parts?: unknown[];
  request: JsonRecord;
  thread_ref: string;
};

class ModelResponseError extends Error {
  public readonly publicStatus = 502;
}

const structuredOutputValidator = new Ajv2020({ allErrors: true, strict: true, validateFormats: false });

function rejected(message: string): never {
  throw new ModelResponseError(message);
}

function isRecord(value: unknown): value is JsonRecord {
  return Boolean(value) && typeof value === 'object' && !Array.isArray(value);
}

function requiredRecord(value: unknown, label: string) {
  return isRecord(value) ? value : rejected(`${label} must be an object.`);
}

function requiredString(value: unknown, label: string) {
  return typeof value === 'string' && value.trim() ? value.trim() : rejected(`${label} is required.`);
}

function optionalString(value: unknown) {
  return typeof value === 'string' && value.trim() ? value.trim() : undefined;
}

function positiveInteger(value: unknown, label: string) {
  return Number.isInteger(value) && Number(value) > 0 ? Number(value) : rejected(`${label} is required.`);
}

function nonNegativeInteger(value: unknown, label: string) {
  return Number.isInteger(value) && Number(value) >= 0 ? Number(value) : rejected(`${label} must be a non-negative integer.`);
}

function stringArray(value: unknown, label: string) {
  if (!Array.isArray(value)) return [];
  return value.map((item, index) => requiredString(item, `${label}.${index}`));
}

const inlineReferenceTokenPattern = /\[(citation|source|reference|ref|span):([^\]]+)\]/gi;

function allowedInlineReferenceIds(descriptor: JsonRecord) {
  return new Set([
    ...stringArray(descriptor.citation_refs, 'request.citation_refs'),
    ...stringArray(descriptor.context_refs, 'request.context_refs'),
    ...stringArray(descriptor.allowed_reference_refs, 'request.allowed_reference_refs'),
  ]);
}

function sanitizedResponseText(text: string, descriptor: JsonRecord) {
  const allowed = allowedInlineReferenceIds(descriptor);
  if (allowed.size === 0) return text.replace(inlineReferenceTokenPattern, '').replace(/[ \t]{2,}/g, ' ').trim();
  return text
    .replace(inlineReferenceTokenPattern, (match, _kind: string, id: string) => {
      const ref = id.trim();
      return allowed.has(ref) ? match : '';
    })
    .replace(/[ \t]{2,}/g, ' ')
    .trim();
}

function usedInlineReferenceIds(text: string, descriptor: JsonRecord) {
  const allowed = allowedInlineReferenceIds(descriptor);
  const output = new Set<string>();
  inlineReferenceTokenPattern.lastIndex = 0;
  let match: RegExpExecArray | null;
  while ((match = inlineReferenceTokenPattern.exec(text)) !== null) {
    const ref = match[2]?.trim();
    if (ref && allowed.has(ref)) output.add(ref);
  }
  return Array.from(output);
}

type PathSegment = string | number;

function pathArray(value: unknown, label: string) {
  if (!Array.isArray(value) || value.length === 0) rejected(`${label} is required.`);
  return value.map((item, index) => {
    if (typeof item === 'string' || Number.isInteger(item)) return item as string | number;
    return rejected(`${label}.${index} must be a string or integer.`);
  });
}

function optionalPathArray(value: unknown, label: string) {
  if (value === undefined) return undefined;
  return pathArray(value, label);
}

function pathArrayList(value: unknown, label: string) {
  if (!Array.isArray(value) || value.length === 0) return [];
  return value.map((item, index) => pathArray(item, `${label}.${index}`));
}

function readInput(value: unknown): RequestInput {
  const input = requiredRecord(value, 'model response input');
  return {
    body: optionalString(input.body),
    content_parts: input.content_parts === undefined ? undefined : (Array.isArray(input.content_parts) ? input.content_parts : rejected('content_parts must be an array.')),
    request: requiredRecord(input.request, 'request'),
    thread_ref: requiredString(input.thread_ref, 'thread_ref'),
  };
}

function stringSet(value: unknown, label: string) {
  if (!Array.isArray(value)) rejected(`${label} must be an array.`);
  return new Set(value.map((item, index) => requiredString(item, `${label}.${index}`)));
}

function contentKinds(parts: unknown[]) {
  return parts.flatMap((part, index) => {
    const item = requiredRecord(part, `content_parts.${index}`);
    const kind = requiredString(item.kind, `content_parts.${index}.kind`);
    if (kind === 'text') return [];
    if (kind !== 'addressed-content') rejected(`content_parts.${index}.kind is unsupported.`);
    return [requiredString(item.content_kind, `content_parts.${index}.content_kind`)];
  });
}

function requireContentAdmission(model: JsonRecord, adapter: JsonRecord, parts: unknown[]) {
  const requested = contentKinds(parts);
  if (requested.length === 0) return;
  const modelKinds = stringSet(model.capabilities ?? model.content_kinds, 'resolved model capabilities');
  const adapterKinds = stringSet(adapter.content_kinds, 'resolved adapter content kinds');
  for (const kind of requested) {
    if (!modelKinds.has(kind)) rejected(`model descriptor does not admit content kind ${kind}.`);
    if (!adapterKinds.has(kind)) rejected(`adapter descriptor does not admit content kind ${kind}.`);
  }
}

type CanonicalInvocation = {
  adapter: JsonRecord;
  adapterId: string;
  model: JsonRecord;
  modelId: string;
  providerId: string;
};

async function canonicalInvocations(descriptor: JsonRecord): Promise<CanonicalInvocation[]> {
  for (const forbidden of ['model_descriptor', 'adapter_descriptor', 'adapter_resolver_target', 'http', 'target_slot', 'url', 'headers', 'body_template', 'credential_injections', 'workflow_target', 'workflow_definition_id', 'content_materializer', 'credential_resolver_target', 'credential_key', 'credential_target', 'handle_ttl_seconds', 'argv', 'process', 'sandbox_profile', 'timeout_ms', 'output_mount_path', 'request_mount_path']) {
    if (forbidden in descriptor) rejected(`caller-supplied ${forbidden} is forbidden; owner resolution is required.`);
  }
  const modelId = optionalString(descriptor.model_id);
  const requestedModelRef = optionalString(descriptor.model_ref);
  if (requestedModelRef && modelId && requestedModelRef !== modelId && requestedModelRef !== `ai-model-descriptor:${modelId}`) {
    rejected('model_ref does not identify model_id.');
  }
  const requestedAdapter = optionalString(descriptor.adapter_ref);
  if (Boolean(modelId) !== Boolean(requestedAdapter)) rejected('model_id and adapter_ref must be supplied together.');
  const requiredCapabilities = stringArray(descriptor.required_capabilities, 'request.required_capabilities');
  if (!modelId && requiredCapabilities.length === 0) rejected('request.required_capabilities is required for automatic model selection.');
  const requestedProvider = optionalString(descriptor.provider_ref);
  const launchReply = decodeJsonReply(await sendRequestToBitfieldTarget({
    target: 'slot::workflow',
    payload: { operation: 'execute_definition', definition_id: 'action:resolve-chat-launch', include_output: true, include_steps: false, input: { requested_cli_id: requestedAdapter ?? '', model: modelId ?? '', required_capabilities: requiredCapabilities } },
  }));
  const resolved = requiredRecord(launchReply.output ?? launchReply, 'resolved invocation admission');
  const admissions = Array.isArray(resolved.candidates) ? resolved.candidates : [resolved];
  if (admissions.length === 0) rejected('no model invocation candidates are available.');
  return admissions.map((value, index) => {
  const admission = requiredRecord(value, `resolved invocation admission.${index}`);
  const model = requiredRecord(admission.model_descriptor, 'resolved model descriptor');
  const resolvedModelId = requiredString(model.model_id, 'resolved model model_id');
  if (model.kind !== 'ai-model-descriptor' || model.status !== 'available' || (modelId && resolvedModelId !== modelId)) rejected('requested model is unavailable.');
  const providerId = requiredString(model.provider_ref, 'resolved model provider_ref');
  if (requestedProvider && requestedProvider !== providerId) rejected('provider_ref does not identify the resolved model provider.');
  const launch = requiredRecord(admission.launch, 'resolved adapter launch');
  const adapterId = requiredString(launch.cli_id, 'resolved adapter cli_id');
  const bareAdapterId = adapterId.startsWith('cli:') ? adapterId.slice(4) : adapterId;
  const bareRequestedAdapter = requestedAdapter?.startsWith('cli:') ? requestedAdapter.slice(4) : requestedAdapter;
  if (bareRequestedAdapter && bareAdapterId !== bareRequestedAdapter) rejected('resolved adapter does not match adapter_ref.');
  if (requiredString(launch.model_id, 'resolved adapter model_id') !== resolvedModelId) rejected('resolved adapter does not match model_id.');
  if (launch.provider_id !== null && launch.provider_id !== undefined && launch.provider_id !== providerId) rejected('resolved adapter does not match model provider.');
  if (launch.transport !== 'http') rejected('resolved adapter transport is unsupported.');
  return { adapter: requiredRecord(launch.http, 'resolved adapter http launch'), adapterId, model, modelId: resolvedModelId, providerId };
  });
}

function processMountPath(value: unknown, label: string) {
  const path = requiredString(value, label);
  if (path.includes('..') || path.startsWith('/') || path.includes('\\')) rejected(`${label} is not a safe relative mount path.`);
  return path;
}

function materializerPart(value: unknown, index: number) {
  const part = requiredRecord(value, `content_parts.${index}`);
  if (requiredString(part.kind, `content_parts.${index}.kind`) !== 'addressed-content') return part;
  const source = requiredRecord(part.source, `content_parts.${index}.source`);
  if (requiredString(source.kind, `content_parts.${index}.source.kind`) !== 'blob_ref') rejected(`content_parts.${index}.source must be a blob_ref.`);
  requiredString(source.hash, `content_parts.${index}.source.hash`);
  return { ...part, mounted_path: processMountPath(part.mount_path, `content_parts.${index}.mount_path`) };
}

function ownerMaterializerPart(part: JsonRecord) {
  return {
    kind: requiredString(part.kind, 'content part.kind'),
    address: requiredString(part.address, 'content part.address'),
    content_kind: requiredString(part.content_kind, 'content part.content_kind'),
    mounted_path: 'content.bin',
    source: requiredRecord(part.source, 'content part.source'),
    mime_type: requiredString(part.mime_type, 'content part.mime_type'),
    byte_length: nonNegativeInteger(part.byte_length, 'content part.byte_length'),
    integrity_hash: requiredString(part.integrity_hash, 'content part.integrity_hash'),
    delivery: requiredRecord(part.delivery, 'content part.delivery'),
  };
}

function readStringRecord(value: unknown, label: string) {
  if (!isRecord(value)) return {};
  return Object.fromEntries(
    Object.entries(value).map(([key, item]) => [key, requiredString(item, `${label}.${key}`)]),
  );
}

function decodeJsonReply(value: unknown): JsonRecord {
  const payload = isRecord(value) && 'payload' in value ? value.payload : value;
  if (payload instanceof Uint8Array) {
    const text = new TextDecoder().decode(payload);
    return text.trim() ? requiredRecord(JSON.parse(text), 'reply payload') : {};
  }
  if (Array.isArray(payload) && payload.every((item) => Number.isInteger(item))) {
    const text = new TextDecoder().decode(Uint8Array.from(payload as number[]));
    return text.trim() ? requiredRecord(JSON.parse(text), 'reply payload') : {};
  }
  if (typeof payload === 'string') {
    return payload.trim() ? requiredRecord(JSON.parse(payload), 'reply payload') : {};
  }
  return requiredRecord(payload, 'reply payload');
}

/** The same bytes as text, before anything tries to read them as one
 *  document. A run of documents is not JSON and parsing it is the failure. */
function decodeHttpBodyText(value: unknown): string {
  if (value instanceof Uint8Array) return new TextDecoder().decode(value);
  if (Array.isArray(value) && value.every((item) => Number.isInteger(item))) {
    return new TextDecoder().decode(Uint8Array.from(value as number[]));
  }
  return typeof value === 'string' ? value : '';
}

function decodeHttpBody(value: unknown): unknown {
  if (value instanceof Uint8Array) {
    const text = new TextDecoder().decode(value);
    return text.trim() ? JSON.parse(text) : {};
  }
  if (Array.isArray(value) && value.every((item) => Number.isInteger(item))) {
    const text = new TextDecoder().decode(Uint8Array.from(value as number[]));
    return text.trim() ? JSON.parse(text) : {};
  }
  if (typeof value === 'string') return value.trim() ? JSON.parse(value) : {};
  return value;
}

// A value an adapter offers but no caller has to supply. Declared in DATA as
// `"when_absent": "omit"`, so the field is simply not sent unless someone asks,
// and every caller that says nothing keeps getting the provider's own default.
const OMITTED = Symbol('omitted');

function bindingValue(binding: JsonRecord, bindings: Record<string, unknown>, label: string) {
  const name = requiredString(binding.binding, `${label}.binding`);
  const present = Object.prototype.hasOwnProperty.call(bindings, name) && bindings[name] !== undefined;
  if (!present && binding.when_absent === 'omit') return OMITTED;
  if (!Object.prototype.hasOwnProperty.call(bindings, name)) rejected(`${label} references unknown binding ${name}.`);
  const value = bindings[name];
  return value === undefined ? rejected(`${label} binding ${name} is absent.`) : value;
}

function renderArray(value: unknown[], bindings: Record<string, unknown>, label: string): unknown[] {
  return value.flatMap((item, index) => {
    const itemLabel = `${label}.${index}`;
    if (isRecord(item) && item.$kind === 'template.sequence') {
      const sequence = bindingValue(item, bindings, itemLabel);
      if (!Array.isArray(sequence)) rejected(`${itemLabel} sequence binding must resolve to an array.`);
      if (item.item_fields !== undefined) {
        if (!Array.isArray(item.item_fields) || item.item_fields.some(field => typeof field !== 'string' || !field)) {
          rejected(`${itemLabel}.item_fields must name fields.`);
        }
        return sequence.map((entry, entryIndex) => {
          const record = requiredRecord(entry, `${itemLabel}.${entryIndex}`);
          return Object.fromEntries((item.item_fields as string[])
            .filter(field => record[field] !== undefined).map(field => [field, record[field]]));
        });
      }
      return sequence;
    }
    const rendered = renderValueOrOmitted(item, bindings, itemLabel);
    return rendered === OMITTED ? [] : [rendered];
  });
}

function renderValue(value: unknown, bindings: Record<string, unknown>, label: string): unknown {
  const rendered = renderValueOrOmitted(value, bindings, label);
  return rendered === OMITTED ? undefined : rendered;
}

function renderValueOrOmitted(value: unknown, bindings: Record<string, unknown>, label: string): unknown {
  if (typeof value === 'string') return renderText(value, bindings, label);
  if (Array.isArray(value)) return renderArray(value, bindings, label);
  if (isRecord(value)) {
    if (value.$kind === 'template.value') return bindingValue(value, bindings, label);
    if (value.$kind !== undefined) rejected(`${label} has unknown $kind ${String(value.$kind)}.`);
    const entries = Object.entries(value)
      .map(([key, item]) => [key, renderValueOrOmitted(item, bindings, `${label}.${key}`)] as const);
    const kept = entries.filter(([, item]) => item !== OMITTED);
    // An object made only of omitted fields is itself omitted, so no caller
    // sends an empty settings block it never asked for.
    if (entries.length > 0 && kept.length === 0) return OMITTED;
    return Object.fromEntries(kept);
  }
  return value;
}

function renderText(template: string, bindings: Record<string, unknown>, label: string) {
  return template.replace(/\{\{\s*([A-Za-z0-9_.-]+)\s*\}\}/g, (_match, key: string) => {
    if (!(key in bindings) || typeof bindings[key] !== 'string') rejected(`${label} references unknown text binding ${key}.`);
    return bindings[key] as string;
  });
}

function selectedValues(value: unknown, selector: unknown, label: string): unknown[] {
  const config = requiredRecord(selector, label);
  const from = requiredString(config.from, `${label}.from`);
  const source = readPath(value, [from]);
  if (!Array.isArray(source)) rejected(`${label}.from must point to an array.`);
  const conditions = Array.isArray(config.where) ? config.where : [];
  const filtered = source.filter((item) => conditions.every((condition, index) => {
    const rule = requiredRecord(condition, `${label}.where.${index}`);
    return readPath(item, pathArray(rule.path, `${label}.where.${index}.path`)) === rule.equals;
  }));
  if (config.then !== undefined) return filtered.flatMap((item, index) => selectedValues(item, config.then, `${label}.then.${index}`));
  const selectPath = pathArray(config.select_path, `${label}.select_path`);
  return filtered.map((item) => readPath(item, selectPath));
}

function readPath(value: unknown, path: readonly PathSegment[]) {
  return path.reduce<unknown>((current, segment) => {
    if (typeof segment === 'number') {
      return Array.isArray(current) ? current[segment] : undefined;
    }
    return isRecord(current) ? current[segment] : undefined;
  }, value);
}

function optionalTrimmedText(value: unknown) {
  return typeof value === 'string' && value.trim() ? value.trim() : undefined;
}

function configuredResponseTexts(descriptor: JsonRecord, adapter: JsonRecord, body: unknown) {
  if (adapter.response_extract !== undefined) {
    return selectedValues(body, adapter.response_extract, 'request.adapter_descriptor.response_extract')
      .map(optionalTrimmedText)
      .filter((text): text is string => Boolean(text));
  }
  const itemListPath = optionalPathArray(descriptor.response_text_items_path, 'request.response_text_items_path');
  if (itemListPath) {
    const items = readPath(body, itemListPath);
    if (!Array.isArray(items)) rejected('request.response_text_items_path must point to an array.');
    const itemPath = optionalPathArray(descriptor.response_text_item_path, 'request.response_text_item_path') ?? [];
    const itemTexts = items
      .map((item) => optionalTrimmedText(readPath(item, itemPath)))
      .filter((text): text is string => Boolean(text));
    if (itemTexts.length > 0) return itemTexts;
  }

  const paths = [
    ...pathArrayList(descriptor.response_body_paths, 'request.response_body_paths'),
    ...(descriptor.response_body_path === undefined
      ? []
      : [pathArray(descriptor.response_body_path, 'request.response_body_path')]),
  ];
  if (paths.length === 0) rejected('request.response_body_path is required.');
  return paths
    .map((path, index) => optionalTrimmedText(readPath(body, path)) ?? (index === 0 ? undefined : ''))
    .filter((text): text is string => Boolean(text));
}

function compileStructuredResponseValidator(descriptor: JsonRecord) {
  const adapter = requiredRecord(descriptor.adapter_descriptor, 'request.adapter_descriptor');
  if (adapter.response_structure === undefined) return undefined;
  const responseStructure = requiredRecord(adapter.response_structure, 'request.adapter_descriptor.response_structure');
  if (!['response_text', 'response_object'].includes(String(responseStructure.source)) || responseStructure.format !== 'json') rejected('request.adapter_descriptor.response_structure is unsupported.');
  const schema = requiredRecord(descriptor.response_schema, 'request.response_schema');
  try {
    return structuredOutputValidator.compile(schema);
  } catch {
    return rejected('request.response_schema could not be compiled as JSON Schema Draft 2020-12.');
  }
}

function descriptorString(descriptor: JsonRecord, key: string) {
  return requiredString(descriptor[key], `request.${key}`);
}

// Hand the vault key to the one owner that already resolves it. http-client
// mints the read handle itself when an injection carries `secret_name`, and its
// own type documents that this exists so a caller knowing only the stored
// secret's name never has to pre-mint. This used to pre-mint against a target
// named nowhere else in the package set, so every request that needed a
// credential died before it was sent, and the secret still never passes through
// here either way.
function credentialInjections(http: JsonRecord) {
  const injections = Array.isArray(http.credential_injections) ? http.credential_injections : [];
  return injections.map((item, index) => {
    const injection = requiredRecord(item, `request.http.credential_injections.${index}`);
    return {
      secret_name: requiredString(
        injection.credential_key,
        `resolved adapter credential_injections.${index}.credential_key`,
      ),
      placement: requiredRecord(injection.placement, `request.http.credential_injections.${index}.placement`),
    };
  });
}

async function materializeContentParts(input: RequestInput, canonical: CanonicalInvocation) {
  const parts = (input.content_parts ?? [])
    .map((part, index) => materializerPart(part, index));
  requireContentAdmission(canonical.model, canonical.adapter, parts);
  const output: unknown[] = [];
  for (const part of parts) {
    if (requiredString(part.kind, 'content part.kind') === 'text') {
      output.push({
        type: 'text',
        text: requiredString(part.text, 'content part.text'),
      });
      continue;
    }
    const reply = decodeJsonReply(await sendRequestToBitfieldTarget({ target: 'slot::workflow', payload: { operation: 'execute_definition', definition_id: 'action:materialize-addressed-content-parts', include_output: true, include_steps: false, input: { parts: [ownerMaterializerPart(part)], policy: requiredRecord(canonical.adapter.materialization_policy, 'resolved adapter materialization_policy') } } }));
    const materialized = requiredRecord(reply.output ?? reply, 'owner materializer output');
    if (!Array.isArray(materialized.parts) || materialized.parts.length !== 1) rejected('owner materializer must return one part.');
    output.push(materialized.parts[0]);
  }
  return output;
}

/**
 * Where to send the answer while it arrives, plus WHERE ITS WORDS SIT.
 *
 * The caller names the address and the turn. Only the adapter knows the shape of
 * one streamed document from its provider, so its `text_path` travels with every
 * delivery and the receiver stays free of provider knowledge. An adapter that
 * does not stream has no path to give, and nothing is sent, because parts that
 * cannot be read put nothing on screen and only cost requests.
 */
function partsDelivery(declared: JsonRecord, adapter: JsonRecord, bindings: Record<string, unknown>): unknown {
  const rendered = renderValue(declared, bindings, 'request.deliver_parts_to');
  const run = isRecord(adapter.answer_arrives_as_a_run_of_documents) ? adapter.answer_arrives_as_a_run_of_documents : undefined;
  const textPath = run ? optionalPathArray(run.text_path, 'request.adapter_descriptor.answer_arrives_as_a_run_of_documents.text_path') : undefined;
  if (!isRecord(rendered) || !textPath || textPath.length === 0) return undefined;
  const carried = isRecord(rendered.with) ? rendered.with : {};
  return { ...rendered, with: { ...carried, text_path: textPath } };
}

async function httpRequest(input: RequestInput, canonical: CanonicalInvocation) {
  const descriptor = input.request;
  const http = canonical.adapter;
  const modelId = canonical.modelId;
  const callerBindings = descriptor.template_bindings === undefined
    ? {}
    : requiredRecord(descriptor.template_bindings, 'request.template_bindings');
  for (const reserved of ['body', 'context_text', 'content_parts', 'instruction_text', 'model_id', 'prompt', 'response_schema', 'thread_ref']) {
    if (reserved in callerBindings) rejected(`request.template_bindings.${reserved} is reserved.`);
  }
  const prompt = renderText(descriptorString(descriptor, 'prompt_template'), {
    ...callerBindings,
    body: input.body ?? '',
    context_text: optionalString(descriptor.context_text) ?? '',
    instruction_text: optionalString(descriptor.instruction_text) ?? '',
    model_id: modelId,
    thread_ref: input.thread_ref,
  }, 'request.prompt_template');
  const contentParts = await materializeContentParts(input, canonical);
  const bindings: Record<string, unknown> = {
    ...callerBindings,
    body: input.body ?? '',
    context_text: optionalString(descriptor.context_text) ?? '',
    instruction_text: optionalString(descriptor.instruction_text) ?? '',
    model_id: modelId,
    prompt,
    thread_ref: input.thread_ref,
    content_parts: contentParts,
    response_schema: descriptor.response_schema,
  };
  return {
    target_slot: descriptorString(http, 'target_slot'),
    request: {
      body: Array.from(new TextEncoder().encode(JSON.stringify(renderValue(
        http.body_template,
        bindings,
        'request.adapter_descriptor.body_template',
      )))),
      credential_injections: credentialInjections(http),
      headers: readStringRecord(http.headers, 'request.http.headers'),
      method: descriptorString(http, 'method'),
      timeout_ms: positiveInteger(http.timeout_ms, 'request.http.timeout_ms'),
      url: renderText(descriptorString(http, 'url'), bindings, 'request.http.url'),
      // Where to send the answer as it arrives. The caller says where; this
      // never reads it, and the URL it names is rendered against the same
      // bindings as every other value here so a caller can point at a turn it
      // is about to create. Absent, the whole answer still comes back at the
      // end exactly as it always did.
      ...(isRecord(descriptor.deliver_parts_to)
        ? { deliver_parts_to: partsDelivery(descriptor.deliver_parts_to, http, bindings) }
        : {}),
    },
  };
}

function responseText(descriptor: JsonRecord, adapter: JsonRecord, workflowReply: JsonRecord, validateStructuredResponse?: ReturnType<typeof structuredOutputValidator.compile>) {
  if (workflowReply.status !== 'completed') rejected('model response workflow did not complete.');
  const output = requiredRecord(workflowReply.output, 'workflow output');
  const statusCode = typeof output.status_code === 'number' ? output.status_code : 0;
  if (statusCode < 200 || statusCode >= 300) {
    // Carry the status and what the target said. Without them this reads as
    // "it said no" and every cause looks identical: a wrong key, a wrong URL, a
    // model that does not exist, a quota, a malformed body. The target already
    // explained itself and this used to discard the explanation, which turns a
    // one-line answer into an afternoon of guessing.
    let detail = '';
    try {
      const body = decodeHttpBody(output.body);
      const text = typeof body === 'string' ? body : JSON.stringify(body);
      if (text) detail = `: ${text.slice(0, 600)}`;
    } catch {
      detail = '';
    }
    rejected(`model response target rejected the request with status ${statusCode}${detail}`);
  }
  // AN ANSWER SENT AS IT IS WRITTEN DOES NOT ARRIVE AS ONE DOCUMENT.
  //
  // It arrives as a run of them, each carrying the next few words, and reading
  // that as a single document fails on the second one. The adapter says so and
  // says where its words sit, and the run is folded back into one document
  // shaped exactly like a single answer, so response paths, structured output
  // and every rule after this point keep working without learning that any of
  // this happened.
  const runOfDocuments = isRecord(adapter.answer_arrives_as_a_run_of_documents)
    ? adapter.answer_arrives_as_a_run_of_documents
    : undefined;
  const body = runOfDocuments
    ? oneAnswerFromTheRun(
        decodeHttpBodyText(output.body),
        optionalPathArray(runOfDocuments.text_path, 'request.adapter_descriptor.answer_arrives_as_a_run_of_documents.text_path') ?? [],
      )
    : decodeHttpBody(output.body);
  const responseStructure = adapter.response_structure === undefined ? undefined : requiredRecord(adapter.response_structure, 'request.adapter_descriptor.response_structure');
  let text: string;
  let structured: unknown;
  if (responseStructure?.source === 'response_object' && responseStructure.format === 'json') {
    structured = body;
    text = JSON.stringify(body);
  } else if (runOfDocuments) {
    // The words, joined, ARE the answer's text. Folding them back into a
    // single-answer document only helps when the provider's closing document
    // repeats the whole answer, and at least one does not, which leaves every
    // response path pointing at nothing.
    text = wordsInTheRun(
      decodeHttpBodyText(output.body),
      optionalPathArray(runOfDocuments.text_path, 'request.adapter_descriptor.answer_arrives_as_a_run_of_documents.text_path') ?? [],
    );
  } else {
    text = configuredResponseTexts(descriptor, adapter, body).join('\n\n');
    const structuredPath = optionalPathArray(descriptor.response_object_path, 'request.response_object_path');
    structured = structuredPath ? readPath(body, structuredPath) : undefined;
  }
  if (responseStructure?.source === 'response_text') {
    if (responseStructure.format !== 'json') rejected('request.adapter_descriptor.response_structure is unsupported.');
    const fenced = responseStructure.unwrap_fenced_json === true
      ? /^\s*```(?:json)?\s*\n?([\s\S]*?)\n?```\s*$/.exec(text)
      : null;
    try { structured = JSON.parse(fenced ? fenced[1] : text); } catch { rejected('structured response text is not valid JSON.'); }
  }
  if (responseStructure && !['response_text', 'response_object'].includes(String(responseStructure.source))) rejected('request.adapter_descriptor.response_structure is unsupported.');
  if (responseStructure && (!validateStructuredResponse || !validateStructuredResponse(structured))) rejected('structured response violates request.response_schema.');
  if (structured !== undefined && !isRecord(structured) && !Array.isArray(structured)) rejected('structured response must be an object or array.');
  return { body: sanitizedResponseText(requiredString(text, 'response text'), descriptor), structured_response: structured };
}

export async function requestModelResponse(value: unknown, context?: BitfieldRuntimeContext) {
  const input = readInput(value);
  const mintMessageId = createTrustedRuntimeIdMinter(context);

  // Before any provider is called, and before any candidate is tried, ask
  // whether this spend is allowed. A request that names a spend authority is
  // the operator saying the money is theirs; one that does not is a person
  // using their own key, and there is nothing to stand between.
  //
  // This sits above the candidate loop on purpose. Inside it, a denial would
  // be caught as a failed candidate and the next model would be tried, which
  // is a spend ceiling that shops around.
  const gateAsk = spendGateAskForModelRequest({
    spendAuthorityRef: (input.request as { spend_authority_ref?: unknown }).spend_authority_ref,
    estimatedCostCents: (input.request as { estimated_cost_cents?: unknown }).estimated_cost_cents,
    threadRef: input.thread_ref,
    requestId: `${input.thread_ref}:${mintMessageId()}`,
  });
  if (gateAsk) {
    let gateReply: unknown;
    try {
      gateReply = decodeJsonReply(await sendRequestToBitfieldTarget({
        target: 'slot::workflow',
        payload: {
          definition_id: 'action:budget-gate',
          include_output: true,
          include_steps: false,
          input: gateAsk,
          operation: 'execute_definition',
        },
      }));
    } catch (error) {
      // A gate that cannot answer is a gate that is not limiting anything.
      rejected(`the spend limit could not be checked: ${error instanceof Error ? error.message : String(error)}`);
    }
    if (!spendGateApproved(gateReply)) rejected(spendGateRefusalMessage(gateReply));
  }

  const candidates = await canonicalInvocations(input.request);
  let selected: { canonical: CanonicalInvocation; response: ReturnType<typeof responseText> } | undefined;
  const failures: string[] = [];
  for (const canonical of candidates) {
    try {
      const validateStructuredResponse = compileStructuredResponseValidator({ ...input.request, adapter_descriptor: canonical.adapter });
      const reply = decodeJsonReply(await sendRequestToBitfieldTarget({
        target: 'slot::workflow',
        payload: {
          // This workflow is only the terminal HTTP executor. Public callers
          // use the package target above, which resolves model/adapter DATA
          // before constructing this owner-only request envelope.
          definition_id: 'action:execute-owner-resolved-model-response-http',
          include_output: true,
          include_steps: false,
          input: { http: await httpRequest(input, canonical) },
          operation: 'execute_definition',
        },
      }));
      selected = { canonical, response: responseText(input.request, canonical.adapter, reply, validateStructuredResponse) };
      break;
    } catch (error) {
      failures.push(error instanceof Error ? error.message : String(error));
    }
  }
  if (!selected) rejected(`all model invocation candidates failed: ${failures.join(' | ')}`);
  const { canonical, response } = selected;
  const body = response.body;
  const createdAt = new Date(readTrustedRuntimeClockMs(context)).toISOString();
  return {
    message: {
      body,
      citation_refs: usedInlineReferenceIds(body, input.request),
      context_refs: stringArray(input.request.context_refs, 'request.context_refs'),
      created_at: createdAt,
      // Minted from the request's entropy, not from the clock. The old
      // clock-derived id gave two responses on one thread inside the same
      // millisecond the same id, and a per-request clock would have widened that.
      id: `${input.thread_ref}:response:${mintMessageId()}`,
      model_ref: canonical.modelId,
      provider_ref: canonical.providerId,
      provenance: {
        adapter_ref: canonical.adapterId,
        adapter_revision: optionalString(input.request.adapter_revision),
        model_ref: canonical.modelId,
        provider_ref: canonical.providerId,
        request_template_ref: optionalString(input.request.request_template_ref),
        response_schema_ref: optionalString(input.request.response_schema_ref),
        executed_at: createdAt,
      },
      role: 'responder',
      thread_ref: input.thread_ref,
      ...(response.structured_response === undefined ? {} : { structured_response: { schema_ref: optionalString(input.request.response_schema_ref), value: response.structured_response } }),
    },
  };
}
