// A spend ceiling is only a ceiling if the failures go the right way. These
// check the three that decide whether a bill can run away: silence from the
// gate, a reply that cannot be read, and an authority with nothing to reserve.
//
// The thing this exists to stop was said out loud and is worth keeping: taking
// $20 at signup is revenue, not a limit. Somebody can pay $20 and use $30.

import { describe, expect, it } from 'vitest';
import {
  spendGateAskForModelRequest,
  spendGateApproved,
  spendGateRefusalMessage,
} from './whose-money-pays-for-this';

describe('whether this request has to pass a spend gate', () => {
  it('gates a request whose spend somebody has claimed', () => {
    const ask = spendGateAskForModelRequest({
      spendAuthorityRef: 'spend-authority:trillion-hosted',
      estimatedCostCents: 4,
      threadRef: 'thread:ada',
      requestId: 'thread:ada:7',
    });
    expect(ask).toEqual({
      operation_ref: 'model-response:thread:ada',
      estimated_cost: 4,
      spend_authority_ref: 'spend-authority:trillion-hosted',
      idempotency_key: 'model-response:thread:ada:7',
    });
  });

  it('does not stand between a person and their own provider key', () => {
    // No authority named means nobody claimed this spend. It is their key and
    // their bill with their provider, and a limit here would be an invention.
    for (const nobody of [undefined, null, '', '   ', 42]) {
      expect(spendGateAskForModelRequest({
        spendAuthorityRef: nobody,
        estimatedCostCents: 4,
        requestId: 'r1',
      })).toBeNull();
    }
  });

  it('refuses a claimed spend with nothing to reserve', () => {
    // An authority with no estimate reserves nothing, so every request is
    // approved and the ledger shows a budget that never moves. That reads
    // exactly like a working limit, which is what makes it dangerous.
    for (const missing of [undefined, null, -1, 1.5, '4']) {
      expect(() => spendGateAskForModelRequest({
        spendAuthorityRef: 'spend-authority:x',
        estimatedCostCents: missing,
        requestId: 'r1',
      })).toThrow(/reserve nothing and approve everything/i);
    }
  });

  it('refuses a claimed spend it could not tell apart from another', () => {
    // The gate is idempotent on the key. Without one, two requests share a
    // reservation and the second is free.
    expect(() => spendGateAskForModelRequest({
      spendAuthorityRef: 'spend-authority:x',
      estimatedCostCents: 4,
      requestId: '',
    })).toThrow(/could not tell two requests apart/i);
  });
});

describe('reading the gate answer', () => {
  it('proceeds only on an explicit approval', () => {
    expect(spendGateApproved({ approved: true })).toBe(true);
  });

  it('treats anything else as a denial, including an answer it cannot read', () => {
    // A gate that cannot answer is a gate that is not limiting anything.
    // Treating silence as approval is how a spend ceiling becomes decoration.
    for (const notAnApproval of [
      undefined, null, {}, 'approved', { approved: 'true' }, { approved: 1 },
      { approved: false, reason: 'Daily limit reached.' },
    ]) {
      expect(spendGateApproved(notAnApproval)).toBe(false);
    }
  });

  it('tells the person in their words, never the ledger’s', () => {
    expect(spendGateRefusalMessage({ reason: 'Daily limit reached.' })).toBe('Daily limit reached.');
    for (const wordless of [undefined, null, {}, { reason: '' }, { reason: 7 }]) {
      expect(spendGateRefusalMessage(wordless)).toBe('This account has reached its usage limit.');
    }
  });
});
