import { blake3 } from '@noble/hashes/blake3.js';
import { readFileSync } from 'node:fs';
import { resolve } from 'node:path';
import { afterEach, describe, expect, it, vi } from 'vitest';
import Ajv2020 from 'ajv/dist/2020.js';
import { groupRows, resolveChatLaunch } from '../../ai-cli-launch-adapters/do-work/resolve-chat-launch.mjs';

const send = vi.fn();
// Same contract as the generated exports: both facts come from the context the
// runner handed the target, and neither falls back to a global, so a target that
// forgets to thread its context fails here rather than replaying differently.
vi.mock('@bitfield/runtime-kit', () => ({
  sendRequestToBitfieldTarget: send,
  readTrustedRuntimeClockMs: (context: unknown) => {
    const value = (context as { runtime?: { ambient?: { time_unix_ms?: unknown } } } | undefined)
      ?.runtime?.ambient?.time_unix_ms;
    if (typeof value !== 'number' || !Number.isFinite(value) || value < 0) {
      throw new Error('the runtime supplied no trusted clock');
    }
    return value;
  },
  createTrustedRuntimeIdMinter: (context: unknown) => {
    const value = (context as { runtime?: { ambient?: { entropy_hex?: unknown } } } | undefined)
      ?.runtime?.ambient?.entropy_hex;
    if (typeof value !== 'string' || !/^[0-9a-f]{64}$/.test(value)) {
      throw new Error('the runtime supplied no trusted entropy');
    }
    let ordinal = 0;
    return () => {
      ordinal += 1;
      return `${value.slice(0, 8)}-${value.slice(8, 12)}-${value.slice(12, 16)}-${value.slice(16, 20)}-${String(ordinal).padStart(12, '0')}`;
    };
  },
}));
/** What the runner hands a target. Fixed here, so the whole file is replayable. */
const RUNTIME = {
  runtime: {
    partition_label: 'test',
    ambient: { time_unix_ms: 1_700_000_000_000, entropy_hex: 'ab'.repeat(32) },
  },
};
const { requestModelResponse } = await import('./request-model-response');
const bytes = readFileSync(resolve(process.cwd(), 'tests/emergent-capability-graph/fixtures/multimodal/meal-1x1.png'));
const casAddress = '1f:6dc610828094be1662a705cdf8e2cc1bed1c63b568bc9f91087e2451f2a12b55';
const digest = `1f:${Buffer.from(blake3(new Uint8Array(bytes))).toString('hex')}`;
const adapters = JSON.parse(readFileSync(resolve(process.cwd(), 'packages/ai-cli-launch-adapters/things-to-store-and-run.json'), 'utf8'));
const googleRows = adapters.things.map((thing: any) => thing.payload).filter((payload: any) => payload?.subject_id === 'cli:google');
const launch = { ...resolveChatLaunch({ providers: [], clis: groupRows(googleRows, 'subject_id'), requestedCliId: 'cli:google', model: 'gemini-3.6-flash' }), provider_id: 'ai_provider:google' };
const model = { kind: 'ai-model-descriptor', id: 'ai-model-descriptor:gemini-3.6-flash', model_id: 'gemini-3.6-flash', provider_ref: 'ai_provider:google', capabilities: ['text', 'vision'], status: 'available' };
const schema = { $schema: 'https://json-schema.org/draft/2020-12/schema', type: 'object', required: ['answer'], additionalProperties: false, properties: { answer: { type: 'string' } } };
const part = { kind: 'addressed-content', address: 'evidence:meal-1', content_kind: 'vision', mount_path: 'evidence.png', source: { kind: 'blob_ref', hash: casAddress }, mime_type: 'image/png', byte_length: bytes.length, integrity_hash: digest, delivery: { kind: 'inline-base64' } };
const request = () => ({ model_id: 'gemini-3.6-flash', model_ref: 'gemini-3.6-flash', provider_ref: 'ai_provider:google', adapter_ref: 'google', prompt_template: '{{body}}', response_schema: schema, response_schema_ref: 'schema:answer' });

function successfulTransport(overrides: { ownerModel?: any; ownerOption?: any; ownerLaunch?: any } = {}) {
  send.mockImplementation(async ({ target, payload }: any) => {
    if (target === 'slot::workflow' && payload.definition_id === 'action:resolve-chat-launch') return { payload: { output: { model_descriptor: Object.hasOwn(overrides, 'ownerModel') ? overrides.ownerModel : model, launch: Object.hasOwn(overrides, 'ownerLaunch') ? overrides.ownerLaunch : launch, provenance: {} } } };
    if (target === 'slot::workflow' && payload.definition_id === 'action:materialize-addressed-content-parts') {
      const ownerAction = JSON.parse(readFileSync(resolve(process.cwd(), 'packages/model-response/things-to-store-and-run.json'), 'utf8')).things.find((thing: any) => thing.address === 'package::model-response::workflow-action::materialize-addressed-content-parts');
      expect(ownerAction.payload.steps.find((step: any) => step.id === 'run_materializer').config.input.argv).toEqual(['node', 'materialize-addressed-content-parts.mjs', 'request.json', 'result.json']);
      const { materializeAddressedContentParts } = await import('./materialize-addressed-content-parts.mjs');
      return { payload: { output: materializeAddressedContentParts(payload.input, { readFile: () => bytes }) } };
    }
    if (target === 'credentials-vault.mint-read-handle') return { payload: { success: true, handle: 'credential-handle' } };
    // The Google connection streams, so the reply is a run of `step.delta`
    // documents whose text pieces join into the structured answer.
    if (target === 'slot::workflow') return { payload: { status: 'completed', output: { status_code: 200, body: ['{"answer":', '"ok"}'].map((text) => `event: step.delta\ndata: ${JSON.stringify({ event_type: 'step.delta', delta: { type: 'text', text } })}\n\n`).join('') + `event: interaction.completed\ndata: ${JSON.stringify({ event_type: 'interaction.completed', interaction: { status: 'completed' } })}\n\n` } } };
    throw new Error(`unexpected target ${target}`);
  });
}

afterEach(() => send.mockReset());
describe('requestModelResponse canonical model/adapter admission', () => {
  it('keeps the public identity request on the package target and gives the raw HTTP helper a distinct owner-only identity', () => {
    const manifest = JSON.parse(readFileSync(resolve(process.cwd(), 'packages/model-response/things-to-store-and-run.json'), 'utf8'));
    const workflow = manifest.things.find((thing: any) => thing.address === 'package::model-response::workflow-action::request-model-response');
    expect(workflow).toBeUndefined();
    const helper = manifest.things.find((thing: any) => thing.address === 'package::model-response::workflow-action::execute-owner-resolved-model-response-http').payload;
    expect(helper.id).toBe('action:execute-owner-resolved-model-response-http');
    expect(helper.input_schema.required).toEqual(['http']);
    expect(helper.description).toContain('model-response.request-model-response');
    const target = manifest.things.find((thing: any) => thing.address === 'package::model-response::target::request-model-response').payload;
    expect(target.target).toBe('model-response.request-model-response');
  });

  it('declares one strict owner materializer action with fixed process authority', () => {
    const ownerAction = JSON.parse(readFileSync(resolve(process.cwd(), 'packages/model-response/things-to-store-and-run.json'), 'utf8')).things.find((thing: any) => thing.address === 'package::model-response::workflow-action::materialize-addressed-content-parts').payload;
    const validate = new Ajv2020({ allErrors: true, strict: true }).compile(ownerAction.input_schema);
    const ownerPolicy = { accepted_content_kinds: ['vision'], content_kind_wire_types: { vision: 'image' }, max_bytes: 20 * 1024 * 1024, max_inline_bytes: 20 * 1024 * 1024 };
    const { mount_path: _callerMountPath, ...ownerPart } = part;
    expect(validate({ parts: [{ ...ownerPart, mounted_path: 'content.bin' }], policy: ownerPolicy })).toBe(true);
    expect(validate({ parts: [{ ...ownerPart, mounted_path: 'content.bin' }, { ...ownerPart, mounted_path: 'content.bin' }], policy: ownerPolicy })).toBe(false);
    const run = ownerAction.steps.find((step: any) => step.id === 'run_materializer').config.input;
    expect(run).toMatchObject({
      argv: ['node', 'materialize-addressed-content-parts.mjs', 'request.json', 'result.json'],
      cwd: null,
      timeout_ms: 30000,
      termination_grace_ms: 1000,
      expected_termination: null,
      input_trees: [],
      containment: {
        kind: 'descendant_effect_contained',
        pipe_eof_timeout_ms: 1000,
        publications: [],
      },
      capture_fds: [1, 2],
      collected_files: [],
    });
    expect(JSON.stringify(run)).not.toMatch(/sandbox_profile|capture_stdout|capture_stderr/);
    expect(run.inputs[1].source.hash.select.path).toBe('parts.0.source.hash');
    expect(ownerAction.steps.find((step: any) => step.id === 'return_result').config.value.transform.map((step: any) => step.op)).toEqual(['op:core.decode', 'op:core.json_parse']);
  });

  it('uses the owner-resolved Google launch and sends the exact PNG digest only to its endpoint', async () => {
    successfulTransport();
    launch.http.body_template.input[1].item_fields = ['type', 'mime_type', 'data'];
    const response = await requestModelResponse({ body: 'look', content_parts: [{ ...part, arbitrary_caller_field: 'must-not-reach-owner-action' }], request: request(), thread_ref: 'thread:1' }, RUNTIME);
    const definitionIds = send.mock.calls.filter(([call]) => call.target === 'slot::workflow').map(([call]) => call.payload.definition_id);
    expect(definitionIds.indexOf('action:resolve-chat-launch')).toBeLessThan(definitionIds.indexOf('action:execute-owner-resolved-model-response-http'));
    expect(definitionIds).not.toContain('action:request-model-response');
    const materializerCall = send.mock.calls.find(([call]) => call.target === 'slot::workflow' && call.payload.definition_id === 'action:materialize-addressed-content-parts')[0].payload;
    const ownerAction = JSON.parse(readFileSync(resolve(process.cwd(), 'packages/model-response/things-to-store-and-run.json'), 'utf8')).things.find((thing: any) => thing.address === 'package::model-response::workflow-action::materialize-addressed-content-parts').payload;
    const validateMaterializerInput = new Ajv2020({ allErrors: true, strict: true }).compile(ownerAction.input_schema);
    expect(validateMaterializerInput(materializerCall.input)).toBe(true);
    expect(materializerCall.input.parts[0]).toMatchObject({ mounted_path: 'content.bin', source: part.source });
    expect(materializerCall.input.parts[0]).not.toHaveProperty('mount_path');
    expect(materializerCall.input.parts[0]).not.toHaveProperty('arbitrary_caller_field');
    const http = send.mock.calls.find(([call]) => call.target === 'slot::workflow' && call.payload.definition_id === 'action:execute-owner-resolved-model-response-http')[0].payload.input.http;
    const outbound = JSON.parse(new TextDecoder().decode(Uint8Array.from(http.request.body)));
    expect(http.target_slot).toBe(launch.http.target_slot);
    expect(http.request.url).toBe(launch.http.url);
    expect(outbound.input[1]).toEqual({ type: 'image', mime_type: 'image/png', data: bytes.toString('base64') });
    delete launch.http.body_template.input[1].item_fields;
    expect(Buffer.from(blake3(new Uint8Array(Buffer.from(outbound.input[1].data, 'base64')))).toString('hex')).toBe(digest.slice(3));
    expect(response.message.provenance).toMatchObject({ model_ref: 'gemini-3.6-flash', provider_ref: 'ai_provider:google', adapter_ref: 'cli:google' });
  });

  // A setting the adapter OFFERS is sent only when a caller asks for it, so every
  // caller that says nothing keeps the provider's own default.
  it('sends an offered model setting only when the caller supplies it', async () => {
    const outboundFor = async (templateBindings?: Record<string, unknown>) => {
      send.mockReset();
      successfulTransport();
      await requestModelResponse({ body: 'look', request: { ...request(), ...(templateBindings ? { template_bindings: templateBindings } : {}) }, thread_ref: 'thread:setting' }, RUNTIME);
      const http = send.mock.calls.find(([call]) => call.target === 'slot::workflow' && call.payload.definition_id === 'action:execute-owner-resolved-model-response-http')[0].payload.input.http;
      return JSON.parse(new TextDecoder().decode(Uint8Array.from(http.request.body)));
    };
    const quiet = await outboundFor();
    expect(quiet).not.toHaveProperty('generation_config');
    expect(quiet.stream).toBe(true);
    const asked = await outboundFor({ thinking_level: 'low' });
    expect(asked.generation_config).toEqual({ thinking_level: 'low' });
  });

  it('projects caller text content into the typed adapter wire form without caller fields', async () => {
    successfulTransport();
    await requestModelResponse({ body: 'look', content_parts: [{ kind: 'text', text: 'ground this response', attacker_field: 'drop-me' }], request: request(), thread_ref: 'thread:text' }, RUNTIME);
    const http = send.mock.calls.find(([call]) => call.target === 'slot::workflow' && call.payload.definition_id === 'action:execute-owner-resolved-model-response-http')[0].payload.input.http;
    const outbound = JSON.parse(new TextDecoder().decode(Uint8Array.from(http.request.body)));
    expect(outbound.input[1]).toEqual({ type: 'text', text: 'ground this response' });
    expect(outbound.input[1]).not.toHaveProperty('attacker_field');
  });

  it('denies forged caller descriptors, resolver target, endpoint, and template before transport', async () => {
    successfulTransport();
    for (const [key, value] of Object.entries({ http: { target_slot: 'slot::attacker', request: { url: 'https://attacker.invalid', credential_injections: [{ credential_key: 'secret' }] } }, model_descriptor: { capabilities: ['vision'] }, adapter_descriptor: { ...launch.http, url: 'https://attacker.invalid/exfiltrate', body_template: { stolen: '{{body}}' } }, adapter_resolver_target: 'slot::attacker', url: 'https://attacker.invalid/exfiltrate', content_materializer: { argv: ['sh', '-c', 'evil'] }, argv: ['sh', '-c', 'evil'], workflow_target: 'slot::attacker', workflow_definition_id: 'action:attacker', credential_key: 'steal', credential_target: 'slot::attacker' })) {
      const forged: any = request(); forged[key] = value;
      await expect(requestModelResponse({ body: 'look', content_parts: [part], request: forged, thread_ref: 'thread:1' }, RUNTIME)).rejects.toThrow(`caller-supplied ${key} is forbidden`);
      expect(send).not.toHaveBeenCalled();
    }
  });

  it('denies missing or tombstoned owner model/adapter records before materialization or HTTP', async () => {
    for (const overrides of [{ ownerModel: undefined }, { ownerModel: { ...model, status: 'retired' } }, { ownerLaunch: {} }]) {
      successfulTransport(overrides);
      await expect(requestModelResponse({ body: 'look', content_parts: [part], request: request(), thread_ref: 'thread:1' }, RUNTIME)).rejects.toThrow();
      expect(send.mock.calls.map(([call]) => call.target)).not.toContain('compute.process');
      send.mockReset();
    }
  });

  it('denies identity mismatch and a content kind not in the owner model/adapter intersection', async () => {
    successfulTransport();
    await expect(requestModelResponse({ body: 'look', content_parts: [{ ...part, content_kind: 'audio' }], request: request(), thread_ref: 'thread:1' }, RUNTIME)).rejects.toThrow('model descriptor does not admit content kind audio');
    expect(send.mock.calls.map(([call]) => call.target)).not.toContain('compute.process');
    send.mockReset(); successfulTransport();
    const mismatched: any = request(); mismatched.provider_ref = 'ai_provider:attacker';
    await expect(requestModelResponse({ body: 'look', content_parts: [part], request: mismatched, thread_ref: 'thread:1' }, RUNTIME)).rejects.toThrow('provider_ref does not identify');
  });

  it('tries capability-ranked candidates in order and returns the first valid structured result', async () => {
    const candidate = (id: string) => ({
      model_descriptor: { kind: 'ai-model-descriptor', model_id: id, provider_ref: `provider:${id}`, capabilities: ['typed-state-questions'], status: 'available' },
      launch: {
        cli_id: `cli:${id}`, model_id: id, provider_id: `provider:${id}`, transport: 'http',
        http: {
          target_slot: 'slot::http-client', method: 'POST', url: `https://${id}.invalid`, timeout_ms: 1000,
          headers: { 'content-type': 'application/json' }, content_kinds: ['text'], credential_injections: [],
          body_template: { state: { $kind: 'template.value', binding: 'state' }, questions: { $kind: 'template.value', binding: 'questions' }, model: { $kind: 'template.value', binding: 'model_id' } },
          response_extract: { from: 'answers', select_path: [] }, response_structure: { source: 'response_object', format: 'json' },
        },
      },
      provenance: { model_id: id, provider_id: `provider:${id}`, cli_id: `cli:${id}` },
    });
    let transportCalls = 0;
    send.mockImplementation(async ({ target, payload }: any) => {
      if (target === 'slot::workflow' && payload.definition_id === 'action:resolve-chat-launch') {
        return { payload: { output: { candidates: [candidate('first'), candidate('second')] } } };
      }
      if (target === 'slot::workflow' && payload.definition_id === 'action:execute-owner-resolved-model-response-http') {
        transportCalls += 1;
        if (transportCalls === 1) return { payload: { status: 'completed', output: { status_code: 503, body: '{}' } } };
        return { payload: { status: 'completed', output: { status_code: 200, body: JSON.stringify({ model: 'second', answers: { urgent: { type: 'noul', noul: 0.9 } }, usage: {} }) } } };
      }
      throw new Error(`unexpected target ${target}`);
    });
    const response = await requestModelResponse({
      body: 'judge',
      request: {
        required_capabilities: ['typed-state-questions'], prompt_template: '{{body}}',
        template_bindings: { state: { message: 'now' }, questions: { urgent: { type: 'noul', instructions: 'Is this urgent?' } } },
        response_schema: { type: 'object', required: ['model', 'answers'], properties: { model: { type: 'string' }, answers: { type: 'object' } }, additionalProperties: true },
      },
      thread_ref: 'thread:auto',
    }, RUNTIME);
    expect(transportCalls).toBe(2);
    expect(response.message).toMatchObject({ model_ref: 'second', provider_ref: 'provider:second', structured_response: { value: { model: 'second' } } });
  });
});
