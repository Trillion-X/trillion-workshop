import { blake3 } from '@noble/hashes/blake3.js';
import assert from 'node:assert/strict';
import { mkdtempSync, readFileSync, writeFileSync } from 'node:fs';
import { tmpdir } from 'node:os';
import { join } from 'node:path';
import test from 'node:test';
import { materializeAddressedContentParts } from './materialize-addressed-content-parts.mjs';

const fixture = new URL('../../../tests/emergent-capability-graph/fixtures/multimodal/meal-1x1.png', import.meta.url);
const bytes = readFileSync(fixture);
const digest = `1f:${Buffer.from(blake3(new Uint8Array(bytes))).toString('hex')}`;
const makePart = (overrides = {}) => ({
  kind: 'addressed-content', address: 'evidence:meal-1', content_kind: 'vision', mounted_path: fixture.pathname,
  mime_type: 'image/png', byte_length: bytes.length, integrity_hash: digest, delivery: { kind: 'inline-base64' }, ...overrides,
});
const policy = { accepted_content_kinds: ['vision'], content_kind_wire_types: { vision: 'image' }, max_bytes: 1024, max_inline_bytes: 1024 };

test('materializes the exact mounted fixture bytes into typed inline content', () => {
  const output = materializeAddressedContentParts({ policy, parts: [{ kind: 'text', text: 'identify this' }, makePart({ content_kind: 'vision' })] });
  assert.equal(output.parts[1].data, bytes.toString('base64'));
  assert.equal(output.parts[1].type, 'image');
  assert.equal(Buffer.from(blake3(new Uint8Array(Buffer.from(output.parts[1].data, 'base64')))).toString('hex'), digest.slice(3));
});

for (const [name, mutate] of [
  ['altered bytes', () => ({ mounted_path: (() => { const path = join(mkdtempSync(join(tmpdir(), 'mr-content-')), 'changed.png'); writeFileSync(path, Buffer.concat([bytes, Buffer.from([1])])); return path; })() })],
  ['missing bytes', () => ({ mounted_path: join(tmpdir(), 'model-response-missing-byte-fixture.png') })],
  ['oversize bytes', () => ({ byte_length: bytes.length, delivery: { kind: 'inline-base64' } })],
]) {
  test(`${name} denies before an adapter request can be built`, () => {
    const localPolicy = name === 'oversize bytes' ? { ...policy, max_bytes: bytes.length - 1 } : policy;
    assert.throws(() => materializeAddressedContentParts({ policy: localPolicy, parts: [makePart(mutate())] }), /MR_CONTENT_/);
  });
}

test('MIME, declared integrity, and unsupported kinds deny materialization', () => {
  for (const part of [
    makePart({ content_kind: 'vision', mime_type: 'not a MIME' }),
    makePart({ content_kind: 'vision', integrity_hash: '1f:bad' }),
    makePart({ content_kind: 'audio' }),
  ]) {
    assert.throws(() => materializeAddressedContentParts({ policy, parts: [part] }), /MR_CONTENT_/);
  }
});

test('rejects a BLAKE3 digest mislabeled with a sha256 prefix', () => {
  assert.throws(
    () => materializeAddressedContentParts({
      policy,
      parts: [makePart({ integrity_hash: `sha256:${digest.slice(3)}` })],
    }),
    /MR_CONTENT_0004_INTEGRITY_MISMATCH/,
  );
});
