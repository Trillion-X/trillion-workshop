      "payload": {
        "kind": "reaches-past-the-engine",
        "reach_class": "environment",
        "why": "This package owns the browser session, so it owns where that session's cookie and its sign-in return origin are configured for the deployment it is running in: ACCOUNT_SESSION_COOKIE_SECURE, ACCOUNT_SESSION_COOKIE_NAME and ACCOUNT_SESSION_TTL_SECONDS shape the cookie itself, and ACCOUNT_PUBLIC_URL / NEXT_PUBLIC_ACCOUNT_URL are the public origin a sign-in link must return to. These are per-DEPLOYMENT facts, not per-package DATA: two deployments of the same package set legitimately differ, and a desktop shell legitimately has no public origin at all, which is why the origin is read lazily. Nothing else may set this app's session cookie, so nothing else needs these reads."
      },
      "payload_base64": null,
