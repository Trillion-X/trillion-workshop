        "kind": "action",
        "name": "resend-email-sender-send-templated-email-from-bound-event",
        "description": "Generic email-on-event resolver: read an optional config record (input.config_address) then dispatch resend-email-sender.send-email with the caller-supplied input.request_template. Every email-on-event (onboarding, receipt, refund, reminder, password-reset) is a trigger-rule DATA row that calls this one action — zero per-email logic here. The trigger MUST pass request_template as a literal so its inner {from:steps,key:read_config} binding survives the trigger-engine's eager output_template resolution.",
        "input_schema": {
          "config_address": "string",
          "request_template": "object",
          "event": "object"
        },
        "steps": [
          {
            "id": "read_config",
            "kind": "read",
            "config": {
              "from": {
                "$kind": "binding",
                "select": {
                  "from": "input",
                  "path": "config_address"
                }
              },
              "fallback_output": {}
            }
          },
          {
            "id": "send_email",
            "kind": "ask",
            "config": {
              "name": "resend-email-sender.send-email",
              "input": {
                "$kind": "binding",
                "select": {
                  "from": "input",
                  "path": "request_template"
                }
              }
            }
          },
          {
            "id": "return_result",
            "kind": "return",
            "config": {
              "value": {
                "$kind": "binding",
                "select": {
                  "from": "steps",
                  "key": "send_email",
                  "path": "output"
                }
              }
            }
          }
        ],
        "edges": [],
        "trigger_type": "manual",
        "trigger_source": "",
