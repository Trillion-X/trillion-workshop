{
  "kind": "tool-rows",
  "record_set": "resync-an-elestio-pipeline-tool-rows",
  "what_this_is": "The Workshop row for the tool in tools/resync-an-elestio-pipeline: redeploys one Elestio CI/CD pipeline from its branch and confirms it serves the pushed commit.",
  "records": [
    {
      "id": "package::resync-an-elestio-pipeline::tool::resync-an-elestio-pipeline",
      "address": "package::resync-an-elestio-pipeline::tool::resync-an-elestio-pipeline",
      "path": [
        "current-item",
        "published-record"
      ],
      "payload": {
        "kind": "ai-tool-descriptor",
        "status": "active",
        "id": "tool:resync-an-elestio-pipeline",
        "label": "Resync an Elestio pipeline and confirm it serves the pushed commit",
        "job": "Redeploy one Elestio CI/CD pipeline from its branch after a push (a push alone does not redeploy it) and say whether it now serves the pushed commit. Any site moved onto Elestio deploys a change with it, in one call, with no dashboard clicks.",
        "description": "Trades the vault's Elestio API token (elestio-api-key, bound only to api.elest.io) for a session, reads the pipeline's deployed commit, asks Elestio to resync it (cicd/doActionOnPipeline, action reSyncPipeline: fetch the branch, build again, run the pipeline's Post Deploy command), then reads the pipeline every poll_seconds until its deployedCommit is the given commit, its lastUpdate is after the resync was asked (or after since), its status is deployed and its build success. A failed build ends it at once; after wait_seconds (900 by default) it ends with ok false and the reason. Returns ok, the commit, before and after (deployed commit, status, build status, last update), when it was asked, the seconds it took and the number of reads. It passes on no other field of the pipeline (its details also hold the deploy key and the webhook secret) and never the token or the session. It does not measure the site's own downtime: probe the site's address alongside it for that.",
        "input_schema": {
          "type": "object",
          "required": [
            "email",
            "project_id",
            "vm_id",
            "pipeline_id",
            "commit"
          ],
          "additionalProperties": false,
          "properties": {
            "email": {
              "type": "string",
              "minLength": 3,
              "description": "The Elestio account's email; the token is checked against it."
            },
            "project_id": {
              "type": "string",
              "pattern": "^[0-9]+$"
            },
            "vm_id": {
              "type": "string",
              "pattern": "^[0-9]+$",
              "description": "The CI/CD target's vmID (its provider server id)."
            },
            "pipeline_id": {
              "type": "string",
              "pattern": "^[0-9]+$"
            },
            "commit": {
              "type": "string",
              "pattern": "^[0-9a-fA-F]{7,40}$",
              "description": "The commit pushed to the pipeline's branch, whole or its first 7 or more characters."
            },
            "since": {
              "type": "string",
              "description": "Count the pipeline as redeployed only once its lastUpdate is after this time; the moment the resync is asked by default."
            },
            "wait_seconds": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1800
            },
            "poll_seconds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 60
            }
          }
        },
        "output_schema": {
          "type": "object",
          "required": [
            "ok",
            "pipeline_id",
            "commit",
            "before",
            "after",
            "asked_at",
            "seconds",
            "reads"
          ],
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "pipeline_id": {
              "type": "string"
            },
            "commit": {
              "type": "string"
            },
            "before": {
              "$ref": "#/$defs/state"
            },
            "after": {
              "$ref": "#/$defs/state"
            },
            "asked_at": {
              "type": "string"
            },
            "seconds": {
              "type": "integer"
            },
            "reads": {
              "type": "integer"
            },
            "reason": {
              "type": "string"
            }
          },
          "$defs": {
            "state": {
              "type": "object",
              "properties": {
                "deployed_commit": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "status": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "build_status": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "last_update": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            }
          }
        },
        "result_selector": "$",
        "invoke": {
          "kind": "container",
          "internet": true,
          "workdir": "/opt/resync-an-elestio-pipeline",
          "stdout": "json",
          "argv": [
            "/usr/local/bin/node",
            "/opt/resync-an-elestio-pipeline/do-work/resync-an-elestio-pipeline.mjs"
          ],
          "stdin": {
            "fill": {
              "from": "input"
            }
          },
          "credential_mounts": [
            {
              "secret_name": "elestio-api-key",
              "fd": 4
            }
          ],
          "files": {
            "package_files": [
              {
                "package": "resync-an-elestio-pipeline",
                "paths": [
                  "do-work/resync-an-elestio-pipeline.mjs"
                ],
                "at": "/opt/resync-an-elestio-pipeline"
              }
            ]
          }
        },
        "needs": {
          "expected_seconds": 600,
          "network_egress": true,
          "memory_mb": 128
        },
        "licence_class": "licence:maker-own",
        "placements": [
          "placement:small-container"
        ],
        "maker": "maker:resync-an-elestio-pipeline",
        "provenance": {
          "source": "Written for the Workshop when four sites moved onto Elestio CI/CD (Nov 24-25 2026): a push does not redeploy a pipeline, and the dashboard's Resync was the only road; this is the same action through Elestio's API, with the vault's key"
        },
        "verify": [
          {
            "kind": "sample-run",
            "input": {
              "email": "owner@example.test",
              "project_id": "90000",
              "vm_id": "170000000",
              "pipeline_id": "20000",
              "commit": "e545104",
              "since": "2026-11-25T07:39:00Z",
              "poll_seconds": 1
            },
            "held": {
              "elestio-api-key": "made-up-elestio-token"
            },
            "replies": [
              {
                "request": {
                  "method": "POST",
                  "url": "https://api.elest.io/api/auth/checkAPIToken"
                },
                "status": 200,
                "body": {
                  "status": "OK",
                  "jwt": "made-up-session"
                }
              },
              {
                "request": {
                  "method": "POST",
                  "url": "https://api.elest.io/api/cicd/getPipelineDetails"
                },
                "status": 200,
                "body": {
                  "id": 20000,
                  "pipelineName": "sample-site",
                  "status": "deployed",
                  "buildStatus": "success",
                  "lastUpdate": "2026-11-25T07:42:46.000Z",
                  "deployedCommit": "e54510478825db70e7126c4dd1dabd5f7fb5db54",
                  "webhookSecret": "made-up-webhook-secret"
                }
              },
              {
                "request": {
                  "method": "POST",
                  "url": "https://api.elest.io/api/cicd/doActionOnPipeline"
                },
                "status": 200,
                "body": {
                  "status": "OK"
                }
              }
            ],
            "shape_read_at": "2026-11-25",
            "output_selector": "$.after.deployed_commit",
            "contains": "e54510478825db70e7126c4dd1dabd5f7fb5db54"
          }
        ]
      }
    }
  ]
}
