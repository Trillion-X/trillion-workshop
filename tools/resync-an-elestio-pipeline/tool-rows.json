            },
            "replies": [
              {
                "request": {
                  "method": "POST",
                  "url": "https://api.elest.io/api/auth/checkAPIToken"
                },
                "status": 200,
                "body": {
                  "status": "OK",
                  "jwt": "made-up-session"
                }
              },
              {
                "request": {
                  "method": "POST",
                  "url": "https://api.elest.io/api/cicd/getPipelineDetails"
                },
                "status": 200,
                "body": {
                  "id": 20000,
                  "pipelineName": "sample-site",
                  "status": "deployed",
                  "buildStatus": "success",
                  "deployedCommit": "e54510478825db70e7126c4dd1dabd5f7fb5db54",
                  "webhookSecret": "made-up-webhook-secret"
                }
              },
              {
                "request": {
                  "method": "POST",
                  "url": "https://api.elest.io/api/cicd/doActionOnPipeline"
                },
                "status": 200,
                "body": {
                  "status": "OK",
                  "data": [
                    {
                      "id": 323016,
                      "pipelineID": "20000",
                      "action": "Resync",
                      "status": "Success",
                      "logID": "2026-11-25-07.39.38.205.log",
                      "startTime": "2026-11-25T07:42:36.000Z",
                      "endTime": "2026-11-25T07:42:46.000Z",
                      "commitID": "e54510478825db70e7126c4dd1dabd5f7fb5db54",
                      "commitMessage": "NULL",
                      "creationDate": "2026-11-25T07:39:38.000Z",
                      "errorMessage": null,
                      "duration": 10
                    }
                  ]
                }
              }
            ],
            "shape_read_at": "2026-11-25",
            "output_selector": "$.before.deployed_commit",
            "contains": "e54510478825db70e7126c4dd1dabd5f7fb5db54"
          }
        ]
      }
    }
  ]
