    {
      "id": "package::record-graph::tool::find-how-records-connect",
      "address": "package::record-graph::tool::find-how-records-connect",
      "path": [
        "current-item",
        "published-record"
      ],
      "payload": {
        "kind": "ai-tool-descriptor",
        "id": "tool:find-how-records-connect",
        "label": "Find how records connect",
        "job": "Find how two of the person's records connect through relations and things that happened, or what several records all relate to and who else shares it",
        "description": "With from and to: the paths between them, shortest first, each at most max_length steps (default 4, at most 6), each step one relation or one record to an activity it took part in, with the relation or activity it goes through and the role. With of (or from alone): the hubs every one of them relates to (a group, an organisation, a meeting, a person) with how each holds it, and the members: every other record related to those hubs, most hubs shared first. roles, kinds, activities and ended narrow what is walked. It reads the graph once, bounded (at most 20000 records of each kind, 10 paths); complete false says a bound cut it.",
        "input_schema": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "from": {
              "type": "string",
              "description": "A record id, or me"
            },
            "to": {
              "type": "string",
              "description": "With from: the record to find paths to"
            },
            "of": {
              "type": "array",
              "minItems": 1,
              "maxItems": 20,
              "items": {
                "type": "string"
              },
              "description": "Records to find what they all relate to, and who else shares it"
            },
            "max_length": {
              "type": "integer",
              "minimum": 1,
              "maximum": 6
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000,
              "description": "At most this many hubs and members"
            },
            "roles": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Walk only relations of these roles"
            },
            "kinds": {
              "type": "string",
              "description": "Walk only activities of these kinds, comma separated"
            },
            "activities": {
              "type": "boolean",
              "description": "false leaves activities out of the walk (relations only)"
            },
            "ended": {
              "type": "boolean",
              "description": "Also walk ended relations (alive false)"
            }
          }
        },
        "output_schema": {
          "type": "object",
          "required": [
            "complete"
          ],
          "properties": {
            "from": {
              "type": "string"
            },
            "to": {
              "type": "string"
            },
            "paths": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "length",
                  "records",
