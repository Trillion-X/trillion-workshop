      "payload": {
        "kind": "ai-tool-descriptor",
        "id": "tool:read-the-graph-around-a-record",
        "label": "Read everything one record is connected to",
        "job": "Read everything one of the person's records is connected to: its relations by side and role in order, everything that happened with it and when they were last in touch, and the records a few steps away",
        "description": "Give any record id (or me). relations groups what it is related to by side (subject: the relations it is the subject of; object: the ones naming it as the role) and role, each group in that end's own order with its order keys; side and role narrow it, ended adds ended relations. history is everything that happened with it, newest first, each saying the roles it took (as), with last_contact; history { with, kinds, role, since, until, limit } narrows it, false leaves it out. hops (1 to 4) adds every record within that many steps through relations and activities, nearest first, each with the step that reached it. complete false means a bound cut a part, so what is not shown is not known yet.",
        "input_schema": {
          "type": "object",
          "required": [
            "id"
          ],
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "description": "A record id, or me"
            },
            "side": {
              "type": "string",
              "enum": [
                "subject",
                "object"
              ],
              "description": "Only the relations read from this end"
            },
            "role": {
              "type": "string",
              "description": "Only relations of this role"
            },
            "ended": {
              "type": "boolean",
              "description": "Also ended relations (alive false)"
            },
            "history": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "with": {
                      "type": "string",
                      "description": "Only activities another record (or me) also took part in: a pair's shared history"
                    },
                    "kinds": {
                      "type": "string",
                      "description": "Only these kinds, comma separated: email, call, meeting, message, introduction, note"
                    },
                    "role": {
                      "type": "string",
                      "enum": [
                        "participant",
                        "sender",
                        "recipient",
                        "caller",
                        "attendee",
                        "organiser",
                        "introducer",
                        "introduced"
                      ],
                      "description": "Only activities this record took part in under this role"
                    },
                    "since": {
                      "type": "string",
                      "description": "Only activities at or after this date-time"
                    },
                    "until": {
                      "type": "string",
                      "description": "Only activities at or before this date-time; last_contact is then as of this time"
                    },
                    "limit": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 1000
                    }
                  }
                },
                {
                  "const": false
                }
              ],
              "description": "Narrow the activity history, or false to leave it out"
            },
            "hops": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4,
              "description": "Also the records within this many steps"
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000,
              "description": "At most this many neighbours"
            },
            "roles": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Walk only relations of these roles"
            },
            "kinds": {
              "type": "string",
              "description": "Walk only activities of these kinds, comma separated"
            },
            "activities": {
              "type": "boolean",
              "description": "false leaves activities out of the walk (relations only)"
            }
          }
        },
        "output_schema": {
