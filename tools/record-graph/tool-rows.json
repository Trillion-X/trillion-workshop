    "kind": "ai-tool-descriptor",
    "id": "tool:find-how-records-connect",
    "label": "Find how records connect",
    "job": "Find how two of the person's records connect through relations and things that happened, or what several records all relate to and who else shares it",
    "description": "With from and to: the paths between them, shortest first, each at most max_length steps (default 4, at most 6), each step one relation or one record to an activity it took part in, with the relation or activity it goes through and the role. With of (or from alone): the hubs every one of them relates to (a group, an organisation, a meeting, a person) with how each holds it, and the members: every other record related to those hubs, most hubs shared first. roles, kinds, activities and ended narrow what is walked. It reads the graph once, bounded (at most 20000 records of each kind, 10 paths); complete false says a bound cut it. It works from the rows given as records and reads and keeps nothing.",
    "input_schema": {
     "type": "object",
     "additionalProperties": false,
     "properties": {
      "records": {
       "type": "array",
       "items": {
        "type": "object",
        "required": [
         "id",
         "type",
         "value"
        ],
        "properties": {
         "id": {
          "type": "string"
         },
         "type": {
          "type": "string"
         },
         "value": {
          "type": "object"
         }
        }
       },
       "description": "The relation and activity rows you hold, each { id, type, value } (your AI reads them from your records); the tool reads no store"
      },
      "from": {
       "type": "string",
       "description": "A record id, or me"
      },
      "to": {
       "type": "string",
       "description": "With from: the record to find paths to"
      },
      "of": {
       "type": "array",
       "minItems": 1,
       "maxItems": 20,
       "items": {
        "type": "string"
       },
       "description": "Records to find what they all relate to, and who else shares it"
      },
      "max_length": {
       "type": "integer",
       "minimum": 1,
       "maximum": 6
      },
      "limit": {
       "type": "integer",
       "minimum": 1,
       "maximum": 1000,
       "description": "At most this many hubs and members"
      },
      "roles": {
       "type": "array",
       "items": {
        "type": "string"
       },
       "description": "Walk only relations of these roles"
      },
      "kinds": {
       "type": "string",
       "description": "Walk only activities of these kinds, comma separated"
      },
      "activities": {
       "type": "boolean",
       "description": "false leaves activities out of the walk (relations only)"
      },
      "ended": {
       "type": "boolean",
       "description": "Also walk ended relations (alive false)"
      }
     },
     "required": [
      "records"
     ]
    },
    "output_schema": {
     "type": "object",
     "required": [
      "complete"
     ],
     "properties": {
      "from": {
       "type": "string"
      },
      "to": {
       "type": "string"
      },
      "paths": {
       "type": "array",
       "items": {
        "type": "object",
        "required": [
         "length",
         "records",
         "steps"
        ],
        "properties": {
         "length": {
          "type": "integer"
         },
         "records": {
          "type": "array",
          "items": {
           "type": "string"
          }
         },
         "steps": {
          "type": "array",
          "items": {
           "type": "object",
           "required": [
            "from",
            "to",
            "by",
            "kind",
            "role",
            "side"
           ],
           "properties": {
            "from": {
             "type": "string"
            },
            "to": {
             "type": "string"
            },
            "by": {
             "type": "string",
             "description": "The relation or activity id the step goes through"
            },
            "kind": {
             "type": "string",
             "enum": [
              "relation",
              "activity"
             ]
            },
            "role": {
             "type": "string"
            },
            "side": {
             "type": "string",
             "enum": [
              "subject",
              "object",
              "participant",
              "activity"
             ]
            }
           }
          }
         }
        }
       }
      },
      "of": {
       "type": "array",
       "items": {
        "type": "string"
       }
      },
      "hubs": {
       "type": "array",
       "items": {
        "type": "object",
        "required": [
         "id",
         "held"
        ],
        "properties": {
         "id": {
          "type": "string"
         },
         "held": {
          "type": "array"
         }
        }
       }
      },
      "members": {
       "type": "array",
       "items": {
        "type": "object",
        "required": [
         "id",
         "hubs",
         "through"
        ],
        "properties": {
         "id": {
          "type": "string"
         },
         "hubs": {
          "type": "integer"
         },
         "through": {
          "type": "array"
         }
        }
       }
      },
      "complete": {
       "type": "boolean"
      }
     }
    },
    "invoke": {
     "kind": "container",
     "files": {
      "package_files": [
       {
        "package": "record-graph",
        "paths": [
         "read-data",
         "do-work"
        ],
        "at": "/opt/record-graph"
       },
       {
        "package": "records-door",
        "paths": [
         "do-work",
         "read-data"
        ],
        "at": "/opt/records-door"
       },
       {
        "package": "content-identity",
        "paths": [
         "read-data"
        ],
        "at": "/opt/content-identity"
       },
       {
        "packages": [
         "node_modules/@noble/hashes"
        ],
        "paths": [
         "LICENSE",
         "package.json",
         "blake3.js",
         "blake2.js",
         "_blake.js",
         "_md.js",
         "_u64.js",
         "utils.js"
        ],
        "at": "/opt/node_modules/@noble/hashes"
       },
       {
        "package": "browse-and-upload-my-files",
        "paths": [
         "built-stored-bytes/content-chunks/content_chunks.js",
         "do-work/content-chunks.mjs",
         "do-work/namespace-client.mjs",
         "do-work/send-a-file-to-a-namespace.mjs",
         "do-work/send-retry.mjs",
         "do-work/send-window.mjs",
         "do-work/shared-file-reference.mjs",
         "send-settings.json"
        ],
        "at": "/opt/browse-and-upload-my-files"
       }
      ]
     },
     "workdir": "/opt/record-graph",
     "internet": false,
     "stdout": "json",
     "argv": [
      "node",
      "/opt/records-door/do-work/run-an-export.mjs",
      "/opt/record-graph/read-data/find-connections.mjs",
      "findConnections"
     ],
     "stdin": {
      "fill": {
       "from": "input"
      }
     }
    },
    "needs": {
     "expected_seconds": 30,
     "network_egress": false,
     "memory_mb": 512
    },
    "status": "active",
    "licence_class": "licence:maker-own",
    "placements": [
     "placement:small-container"
    ],
    "maker": "maker:record-graph",
    "result_selector": "$.result",
    "provenance": {
     "source": "Trillion src/record-model-tools.mjs (relate, orderedRelations, contactHistory, the relate_records and read_model tools) over src/record-model.json, ported to read the rows the caller hands in; the graph walks are new"
    },
    "verify": [
     {
      "kind": "sample-run",
      "input": {
       "of": [
        "me"
       ],
       "limit": 1,
       "records": []
      },
      "output_selector": "$.of[0]",
      "contains": "record:person:me"
     }
    ]
   }
  }
 ]
