        "kind": "ai-tool-descriptor",
        "id": "tool:relate-records",
        "label": "Say how things in your records are related",
        "job": "Keep how things in the person's records are related, with the role as data, and what happened between them, as relation and activity records",
        "description": "Each relation says subject is the role of object (\"record:crm:pat\" is the \"dad\" of \"me\"; a contact is a \"member\" of \"organisation:Example Club\"); subject and object are record ids, me, or <kind>:<name> for an organisation, group or place, made once by its name. said keeps the words it was read from. Each end keeps its own order of its relations of one role: a new one goes last on both ends, and order { subject: { after }, object: { after } } places it after another relation of that end (null: first). alive false ends a relation and keeps its places, so relating it again puts it back there. activities are things that happened (kind, at, participants each with a role, optional summary, direction, source, said). Saying the same thing again writes nothing. Returns every relation as kept (id, both order keys, alive), the entities made, and the activities.",
        "input_schema": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "relations": {
              "type": "array",
              "maxItems": 500,
              "items": {
                "type": "object",
                "required": [
                  "subject",
                  "role",
                  "object"
                ],
                "additionalProperties": false,
                "properties": {
                  "subject": {
                    "type": "string",
                    "description": "A record id (a list row is record:<row type>:<row id>), me (the person), or <entity kind>:<name> for a organisation, group, place made once by its name"
                  },
                  "role": {
                    "type": "string",
                    "maxLength": 80,
                    "description": "What subject is of object, in a few words (dad, member, sister)"
                  },
                  "object": {
                    "type": "string",
                    "description": "A record id (a list row is record:<row type>:<row id>), me (the person), or <entity kind>:<name> for a organisation, group, place made once by its name"
                  },
                  "said": {
                    "type": "string",
                    "description": "The words it was read from"
                  },
                  "alive": {
                    "type": "boolean",
                    "description": "false ends it, keeping its places"
                  },
                  "order": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "subject": {
                        "type": "object",
                        "required": [
                          "after"
                        ],
                        "properties": {
                          "after": {
                            "type": [
                              "string",
                              "null"
                            ],
                            "description": "A relation id of the same subject and role to go after, or null for first"
                          }
                        }
                      },
                      "object": {
                        "type": "object",
                        "required": [
                          "after"
                        ],
                        "properties": {
                          "after": {
                            "type": [
                              "string",
                              "null"
                            ],
                            "description": "A relation id of the same object and role to go after, or null for first"
                          }
                        }
                      }
                    }
                  }
                }
              }
            },
            "entities": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "kind",
                  "name"
                ],
                "additionalProperties": false,
                "properties": {
                  "kind": {
                    "type": "string",
                    "enum": [
                      "organisation",
                      "group",
                      "place"
                    ]
                  },
                  "name": {
                    "type": "string"
                  }
                }
              }
            },
            "activities": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "kind",
                  "at",
                  "participants"
                ],
                "additionalProperties": false,
                "properties": {
                  "kind": {
                    "type": "string",
                    "enum": [
                      "email",
                      "call",
                      "meeting",
                      "message",
                      "introduction",
                      "note"
                    ]
                  },
                  "at": {
                    "type": "string",
                    "description": "When it was, a date-time"
                  },
                  "participants": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 50,
                    "items": {
                      "type": "object",
                      "required": [
                        "record"
                      ],
                      "additionalProperties": false,
                      "properties": {
                        "record": {
                          "type": "string",
                          "description": "A record id (a list row is record:<row type>:<row id>), me (the person), or <entity kind>:<name> for a organisation, group, place made once by its name"
                        },
                        "role": {
                          "type": "string",
                          "enum": [
                            "participant",
                            "sender",
                            "recipient",
                            "caller",
                            "attendee",
                            "organiser",
                            "introducer",
                            "introduced"
                          ]
                        }
                      }
                    }
                  },
                  "summary": {
                    "type": "string",
                    "maxLength": 2000
                  },
                  "direction": {
                    "type": "string",
                    "maxLength": 80
                  },
                  "source": {
                    "type": "string"
                  },
                  "said": {
                    "type": "string",
                    "maxLength": 2000
                  }
                }
              }
            }
          }
        },
        "output_schema": {
          "type": "object",
          "required": [
            "relations",
            "entities"
          ],
          "properties": {
            "relations": {
              "type": "array",
