    "kind": "ai-tool-descriptor",
    "id": "tool:read-the-graph-around-a-record",
    "label": "Read everything one record is connected to",
    "job": "Read everything one of the person's records is connected to: its relations by side and role in order, everything that happened with it and when they were last in touch, and the records a few steps away",
    "description": "Give any record id (or me). relations groups what it is related to by side (subject: the relations it is the subject of; object: the ones naming it as the role) and role, each group in that end's own order with its order keys; side and role narrow it, ended adds ended relations. history is everything that happened with it, newest first, each saying the roles it took (as), with last_contact; history { with, kinds, role, since, until, limit } narrows it, false leaves it out. hops (1 to 4) adds every record within that many steps through relations and activities, nearest first, each with the step that reached it. complete false means a bound cut a part, so what is not shown is not known yet. It works from the rows given as records and reads and keeps nothing.",
    "input_schema": {
     "type": "object",
     "required": [
      "records",
      "id"
     ],
     "additionalProperties": false,
     "properties": {
      "records": {
       "type": "array",
       "items": {
        "type": "object",
        "required": [
         "id",
         "type",
         "value"
        ],
        "properties": {
         "id": {
          "type": "string"
         },
         "type": {
          "type": "string"
         },
         "value": {
          "type": "object"
         }
        }
       },
       "description": "The relation and activity rows you hold, each { id, type, value } (your AI reads them from your records); the tool reads no store"
      },
      "id": {
       "type": "string",
       "description": "A record id, or me"
      },
      "side": {
       "type": "string",
       "enum": [
        "subject",
        "object"
       ],
       "description": "Only the relations read from this end"
      },
      "role": {
       "type": "string",
       "description": "Only relations of this role"
      },
      "ended": {
       "type": "boolean",
       "description": "Also ended relations (alive false)"
      },
      "history": {
       "oneOf": [
        {
         "type": "object",
         "additionalProperties": false,
         "properties": {
          "with": {
           "type": "string",
           "description": "Only activities another record (or me) also took part in: a pair's shared history"
          },
          "kinds": {
           "type": "string",
           "description": "Only these kinds, comma separated: email, call, meeting, message, introduction, note"
          },
          "role": {
           "type": "string",
           "enum": [
            "participant",
            "sender",
            "recipient",
            "caller",
            "attendee",
            "organiser",
            "introducer",
            "introduced"
           ],
           "description": "Only activities this record took part in under this role"
          },
          "since": {
           "type": "string",
           "description": "Only activities at or after this date-time"
          },
          "until": {
           "type": "string",
           "description": "Only activities at or before this date-time; last_contact is then as of this time"
          },
          "limit": {
           "type": "integer",
           "minimum": 1,
           "maximum": 1000
          }
         }
        },
        {
         "const": false
        }
       ],
       "description": "Narrow the activity history, or false to leave it out"
      },
      "hops": {
       "type": "integer",
       "minimum": 1,
       "maximum": 4,
       "description": "Also the records within this many steps"
      },
      "limit": {
       "type": "integer",
       "minimum": 1,
       "maximum": 1000,
       "description": "At most this many neighbours"
      },
      "roles": {
       "type": "array",
       "items": {
        "type": "string"
       },
       "description": "Walk only relations of these roles"
      },
      "kinds": {
       "type": "string",
       "description": "Walk only activities of these kinds, comma separated"
      },
      "activities": {
       "type": "boolean",
       "description": "false leaves activities out of the walk (relations only)"
      }
     }
    },
    "output_schema": {
     "type": "object",
     "required": [
      "id",
      "relations",
      "complete"
     ],
     "properties": {
      "id": {
       "type": "string"
      },
      "relations": {
       "type": "array",
       "items": {
        "type": "object",
        "required": [
         "side",
         "role",
         "relations",
         "complete"
        ],
        "properties": {
         "side": {
          "type": "string"
         },
         "role": {
          "type": [
           "string",
           "null"
          ]
         },
         "relations": {
          "type": "array",
          "items": {
           "type": "object",
           "required": [
            "id",
            "subject",
            "role",
            "object",
            "alive",
            "subject_order",
            "object_order"
           ],
           "properties": {
            "id": {
             "type": "string"
            },
            "subject": {
             "type": "string"
            },
            "role": {
             "type": "string"
            },
            "object": {
             "type": "string"
            },
            "alive": {
             "type": "boolean"
            },
            "subject_order": {
             "type": "string"
            },
            "object_order": {
             "type": "string"
            },
            "said": {
             "type": "string"
            }
           }
          }
         },
         "complete": {
          "type": "boolean"
         }
        }
       }
      },
      "history": {
       "type": "object",
       "required": [
        "id",
        "activities",
        "count",
        "last_contact",
        "complete"
       ],
       "properties": {
        "id": {
         "type": "string"
        },
        "activities": {
         "type": "array",
         "items": {
          "type": "object",
          "required": [
           "id",
           "kind",
           "at",
           "participants"
          ],
          "properties": {
           "id": {
            "type": "string"
           },
           "kind": {
            "type": "string"
           },
           "at": {
            "type": "string"
           },
           "participants": {
            "type": "array",
            "items": {
             "type": "object",
             "required": [
              "record",
              "role"
             ],
             "properties": {
              "record": {
               "type": "string"
              },
              "role": {
               "type": "string"
              }
             }
            }
           },
           "summary": {
            "type": "string"
           },
           "direction": {
            "type": "string"
           },
           "said": {
            "type": "string"
           },
           "source": {
            "type": "string"
           },
           "as": {
            "type": "array",
            "items": {
             "type": "string"
            }
           }
          }
         }
        },
        "count": {
         "type": "integer"
        },
        "last_contact": {
         "type": [
          "string",
          "null"
         ]
        },
        "complete": {
         "type": "boolean"
        }
       }
      },
      "neighbours": {
       "type": "object",
       "required": [
        "hops",
        "records",
        "count",
        "complete"
       ],
       "properties": {
        "hops": {
         "type": "integer"
        },
        "records": {
         "type": "array",
         "items": {
          "type": "object",
          "required": [
           "id",
           "distance",
           "via"
          ],
          "properties": {
           "id": {
            "type": "string"
           },
           "distance": {
            "type": "integer"
           },
           "via": {
            "type": "object",
            "required": [
             "from",
             "to",
             "by",
             "kind",
             "role",
             "side"
            ],
            "properties": {
             "from": {
              "type": "string"
             },
             "to": {
              "type": "string"
             },
             "by": {
              "type": "string",
              "description": "The relation or activity id the step goes through"
             },
             "kind": {
              "type": "string",
              "enum": [
               "relation",
               "activity"
              ]
             },
             "role": {
              "type": "string"
             },
             "side": {
              "type": "string",
              "enum": [
               "subject",
               "object",
               "participant",
               "activity"
              ]
             }
            }
           }
          }
         }
        },
        "count": {
         "type": "integer"
        },
        "complete": {
         "type": "boolean"
        }
       }
      },
      "complete": {
       "type": "boolean"
      }
     }
    },
    "invoke": {
     "kind": "container",
     "files": {
      "package_files": [
       {
        "package": "record-graph",
        "paths": [
         "read-data",
         "do-work"
        ],
        "at": "/opt/record-graph"
       },
       {
        "package": "records-door",
        "paths": [
