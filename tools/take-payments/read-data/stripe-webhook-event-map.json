      "stripe_event_type": "payment_intent.succeeded",
      "target_event_kind": "payment.confirmed",
      "attribute_map": {
        "amount_due_today_cents": {
          "path": [
            "data",
            "object",
            "amount_received"
          ]
        },
        "currency": {
          "path": [
            "data",
            "object",
            "currency"
          ]
        },
        "offer_id": {
