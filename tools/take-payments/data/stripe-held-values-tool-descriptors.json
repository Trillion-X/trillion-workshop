                "name": "Authorization",
                "prefix": "Bearer ",
                "suffix": ""
              }
            }
          ]
        },
        "licence_class": "licence:maker-own",
        "placements": [
          "placement:held-values"
        ],
        "provenance": {
          "owner": "package::stripe-payment-provider"
        },
        "output_schema": {
          "type": "object",
