      "payload": {
        "kind": "ai-tool-descriptor",
        "id": "tool:open-purchase-billing",
        "listed_on": "2026-10-03T12:00:00Z",
        "label": "Manage one purchase",
        "job": "Open the secure card, invoice and cancellation page for one verified funding purchase; operator only.",
        "description": "Runs only on this service's operator account, through its Stripe connection: opens Stripe's own page for one subscription a payer holds, where they change its card, read its invoices or cancel it, and answers with that page's address. The payer's Billing screen starts it from a purchase row; the subscription must be one their account paid for.",
        "status": "active",
        "input_schema": {
          "type": "object",
          "required": [
            "subscription_id"
          ],
          "additionalProperties": false,
          "properties": {
            "subscription_id": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "invoke": {
          "kind": "held-values",
          "operation": "open-purchase-billing",
          "connection": "package::service-connections::published-record::stripe",
          "connection_id": "service_connection:stripe",
          "credential_injections": [
            {
              "field_id": "secret_key",
              "placement": {
                "kind": "header",
                "name": "Authorization",
                "prefix": "Bearer ",
                "suffix": ""
              }
            }
          ]
        },
        "licence_class": "licence:maker-own",
        "placements": [
          "placement:held-values"
        ],
        "provenance": {
          "owner": "package::stripe-payment-provider"
        },
        "output_schema": {
          "type": "object",
          "required": [
            "redirect"
          ],
          "properties": {
