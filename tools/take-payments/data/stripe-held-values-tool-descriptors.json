      "payload": {
        "kind": "ai-tool-descriptor",
        "id": "tool:set-up-paid-plan",
        "listed_on": "2026-09-27T07:03:36Z",
        "label": "Set up paid plans",
        "job": "Set up this service's paid plans on its connected Stripe account: one payment link per priced offer, the review codes, the plan page and the payment notices",
        "description": "Runs only on this service's operator account. Uses the operator's Stripe connection, which the request sender places into each request; Stripe's signing secret for payment notices goes straight into the operator's locked box. Run it again after the offers change.",
        "status": "active",
        "input_schema": {
          "type": "object",
          "required": [],
          "additionalProperties": false,
          "properties": {}
        },
        "invoke": {
          "kind": "held-values",
