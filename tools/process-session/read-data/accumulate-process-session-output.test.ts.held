import { describe, expect, it } from '../../../test-helpers/vitest-shim.mjs';
import {
  foldProcessSessionOutput,
  foldSessionProgressGuard,
  createEmptyProcessSessionOutputSnapshot,
  readProcessSessionStreamHandle,
} from './accumulate-process-session-output.ts';

// Minimal byte writer mirroring the Rust codec (see read-process-session-events.test.ts):
// version byte (1 full feed / 2 head / 3 delta); u32/u64 little-endian; length-prefixed strings.
const enc = new TextEncoder();
class W {
  private c: number[] = [];
  u8(v: number) { this.c.push(v & 0xff); return this; }
  u32(v: number) { for (let i = 0; i < 4; i++) this.c.push((v >>> (8 * i)) & 0xff); return this; }
  u64(v: number) { let b = BigInt(v); for (let i = 0; i < 8; i++) { this.c.push(Number(b & 0xffn)); b >>= 8n; } return this; }
  bytes(v: Uint8Array) { this.u32(v.byteLength); for (const x of v) this.c.push(x); return this; }
  str(v: string) { return this.bytes(enc.encode(v)); }
  optI32(v: number | null) { return v == null ? this.u8(0) : this.u8(1).u32(v >>> 0); }
  optStr(v: string | null) { return v == null ? this.u8(0) : this.u8(1).str(v); }
  done() { return Uint8Array.from(this.c); }
}

function delta(sessionId: string, eventNumber: number, text: string): Uint8Array {
  return new W().u8(3).str(sessionId).u64(eventNumber).u64(1_700_000_000_000)
    .u8(0 /* OutputBytes */).u8(1 /* stdout */).bytes(enc.encode(text)).done();
}
function headState(sessionId: string, stateTag: number, exitCode: number | null): Uint8Array {
  return new W().u8(2).str(sessionId).str('1f:aa11')
    .u8(stateTag).u64(5).u64(5).u64(0).optI32(exitCode).optStr(null).done();
}

describe('foldProcessSessionOutput', () => {
  it('APPENDS successive V3 deltas into growing text (token-by-token)', () => {
    let s = createEmptyProcessSessionOutputSnapshot();
    s = foldProcessSessionOutput(s, delta('sess-1', 1, 'Hel'), 'sess-1');
    s = foldProcessSessionOutput(s, delta('sess-1', 2, 'lo wor'), 'sess-1');
    s = foldProcessSessionOutput(s, delta('sess-1', 3, 'ld'), 'sess-1');
    expect(s.outputText).toBe('Hello world');
    expect(s.lastEventNumber).toBe(3);
  });

  it('ignores a stale/replayed delta (event number <= accumulated)', () => {
    let s = createEmptyProcessSessionOutputSnapshot();
    s = foldProcessSessionOutput(s, delta('sess-1', 5, 'abc'), 'sess-1');
    const before = s.outputText;
    s = foldProcessSessionOutput(s, delta('sess-1', 3, 'STALE'), 'sess-1'); // lower number
    expect(s.outputText).toBe(before); // unchanged
  });

  it('is a no-op for a delta belonging to a DIFFERENT session', () => {
    let s = createEmptyProcessSessionOutputSnapshot();
    s = foldProcessSessionOutput(s, delta('sess-1', 1, 'mine'), 'sess-1');
    const ref = s;
    const next = foldProcessSessionOutput(s, delta('sess-OTHER', 2, 'theirs'), 'sess-1');
    expect(next).toBe(ref); // identical object — nothing matched
    expect(next.outputText).toBe('mine');
  });

  it('a state-only head (running→exited) never blanks already-accumulated delta text', () => {
    let s = createEmptyProcessSessionOutputSnapshot();
    s = foldProcessSessionOutput(s, delta('sess-1', 1, 'answer so far'), 'sess-1');
    s = foldProcessSessionOutput(s, headState('sess-1', 1 /* exited */, 0), 'sess-1');
    expect(s.outputText).toBe('answer so far'); // text preserved
    expect(s.state).toBe('exited');
    expect(s.exitCode).toBe(0);
  });

  it('re-folding an UNCHANGED head returns the SAME reference (React #185 render-loop guard)', () => {
    let s = createEmptyProcessSessionOutputSnapshot();
    s = foldProcessSessionOutput(s, delta('sess-1', 1, 'hi'), 'sess-1');
    s = foldProcessSessionOutput(s, headState('sess-1', 1 /* exited */, 0), 'sess-1');
    const settled = s;
    // The store re-delivers the same head bytes with fresh array identity every
    // re-render; the fold MUST return the identical object so setState bails and
    // React does not loop into "Maximum update depth exceeded".
    const again = foldProcessSessionOutput(settled, headState('sess-1', 1, 0), 'sess-1');
    expect(again).toBe(settled);
  });

  it('re-folding an already-applied delta returns the SAME reference (idempotent, no loop)', () => {
    let s = createEmptyProcessSessionOutputSnapshot();
    s = foldProcessSessionOutput(s, delta('sess-1', 1, 'Hel'), 'sess-1');
    s = foldProcessSessionOutput(s, delta('sess-1', 2, 'lo'), 'sess-1');
    const settled = s;
    const again = foldProcessSessionOutput(settled, delta('sess-1', 2, 'lo'), 'sess-1'); // same event #2
    expect(again).toBe(settled);
    expect(again.outputText).toBe('Hello');
  });
});

describe('readProcessSessionStreamHandle', () => {
  it('reads session_id, uses the HEAD/feed for hop1, and captures the stream address for immediate lossless subscription', () => {
    expect(readProcessSessionStreamHandle({
      complete: false, session_id: 's1', event_stream_address: 'stream::s1', event_feed_address: 'head::s1',
    })).toEqual({ sessionId: 's1', liveFeedAddress: 'head::s1', streamAddress: 'stream::s1' });
  });
  it('falls back to the head address when no stream address is present (no streamAddress captured)', () => {
    expect(readProcessSessionStreamHandle({ session_id: 's2', event_feed_address: 'head::s2' }))
      .toEqual({ sessionId: 's2', liveFeedAddress: 'head::s2' });
  });
  it('keys purely off its own fields (no status enum); stream-only ⇒ liveFeedAddress falls back to stream AND streamAddress is captured', () => {
    expect(readProcessSessionStreamHandle({ session_id: 's3', event_stream_address: 'stream::s3' }))
      .toEqual({ sessionId: 's3', liveFeedAddress: 'stream::s3', streamAddress: 'stream::s3' });
  });
  it('returns null when no session/address is named', () => {
    expect(readProcessSessionStreamHandle({ status: 'completed', items: [] })).toBeNull();
    expect(readProcessSessionStreamHandle({ session_id: 's4' })).toBeNull(); // no address
  });
  it('captures the authoritative terminal_output_address when the payload supplies it', () => {
    expect(readProcessSessionStreamHandle({
      session_id: 's5', event_feed_address: 'head::s5', event_stream_address: 'stream::s5',
      terminal_output_address: 'term::s5',
    })).toEqual({ sessionId: 's5', liveFeedAddress: 'head::s5', streamAddress: 'stream::s5', terminalOutputAddress: 'term::s5' });
  });
});

describe('foldSessionProgressGuard — client-reset disappear/stall guard (Bug 1)', () => {
  const START = { sessionId: null as string | null, text: '', complete: false };

  it('retains the full streamed text after a mid-session fold RESET blanks it', () => {
    // Deltas stream in and reach the full answer + completeness.
    let g = foldSessionProgressGuard(START, { sessionId: 's1', text: 'The full answer.', rawComplete: true });
    expect(g.text).toBe('The full answer.');
    expect(g.complete).toBe(true);
    // The store tears down at session end → the fold re-inits → text '' and rawComplete false.
    g = foldSessionProgressGuard(g, { sessionId: 's1', text: '', rawComplete: false });
    // Without the guard the consumer would see a BLANK answer and complete fall back to false,
    // never firing finalize. The guard keeps both: the answer persists, complete stays latched.
    expect(g.text).toBe('The full answer.');
    expect(g.complete).toBe(true);
  });

  it('grows text monotonically and never regresses to a shorter reset artifact', () => {
    let g = foldSessionProgressGuard(START, { sessionId: 's1', text: 'Hel', rawComplete: false });
    g = foldSessionProgressGuard(g, { sessionId: 's1', text: 'Hello wor', rawComplete: false });
    g = foldSessionProgressGuard(g, { sessionId: 's1', text: 'He', rawComplete: false }); // reset blip
    expect(g.text).toBe('Hello wor');
    g = foldSessionProgressGuard(g, { sessionId: 's1', text: 'Hello world!', rawComplete: true });
    expect(g.text).toBe('Hello world!');
    expect(g.complete).toBe(true);
  });

  it('latches complete once reached — a later reset cannot un-fire the finalize gate', () => {
    let g = foldSessionProgressGuard(START, { sessionId: 's1', text: 'Answer', rawComplete: true });
    g = foldSessionProgressGuard(g, { sessionId: 's1', text: 'Answer', rawComplete: false });
    expect(g.complete).toBe(true);
  });

  it('resets fully when the sessionId changes (no cross-session bleed)', () => {
    let g = foldSessionProgressGuard(START, { sessionId: 's1', text: 'Old answer', rawComplete: true });
    g = foldSessionProgressGuard(g, { sessionId: 's2', text: 'New', rawComplete: false });
    expect(g.text).toBe('New');
    expect(g.complete).toBe(false);
  });

  it('never fabricates or truncates — it only refuses to blank progress (empty stays empty pre-output)', () => {
    const g = foldSessionProgressGuard(START, { sessionId: 's1', text: '', rawComplete: false });
    expect(g.text).toBe('');
    expect(g.complete).toBe(false);
  });
});
