{
  "kind": "package-set-records",
  "record_set": "build-and-install-the-public-receptionist-tool-rows",
  "what_this_is": "The Workshop rows for building and installing the public receptionist on its own rented Linux host: prepare the host, read it, build one commit there and install the built file. The host, its port, the administration user, every host path and the Rust toolchain version are inputs; the administration key reaches ssh only as a held file (credential_mounts mount_path). The SSH arguments come from tools/administer-a-rented-host.",
  "records": [
    {
      "payload": {
        "kind": "ai-tool-descriptor",
        "id": "tool:prepare-a-receptionist-build-host",
        "label": "Prepare a receptionist build host",
        "job": "Make my rented Linux server able to build the public receptionist",
        "description": "Installs the build packages given, makes the source folder, adds a swap file if there is none and installs the exact Rust toolchain given, over SSH as the host's administrator with the held key. It sets up no service user, DNS, TLS or public route.",
        "status": "active",
        "input_schema": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "host",
            "source_root",
            "rust",
            "build_packages",
            "swap"
          ],
          "properties": {
            "host": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "address",
                "ssh_port",
                "admin_user",
                "host_key"
              ],
              "description": "The rented Linux host the receptionist is built on.",
              "properties": {
                "address": {
                  "type": "string",
                  "description": "The host's IPv4 address or DNS name, e.g. 192.0.2.10 or build.example.com."
                },
                "ssh_port": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 65535,
                  "description": "The host's SSH port."
                },
                "admin_user": {
                  "type": "string",
                  "description": "The Linux user that administers the host (it needs root rights for prepare)."
                },
                "host_key": {
                  "type": "string",
                  "description": "The host's pinned public SSH key, \"<type> <base64>\"; no other key is accepted."
                }
              }
            },
            "dry_run": {
              "type": "boolean",
              "description": "true answers the ssh arguments and remote command and runs nothing."
            },
            "source_root": {
              "type": "string",
              "pattern": "^/",
              "description": "The folder on the host that holds one folder per built commit."
            },
            "rust": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "toolchain",
                "cargo_home",
                "rustup_home"
              ],
              "description": "The pinned Rust toolchain and where it lives on the host.",
              "properties": {
                "toolchain": {
                  "type": "string",
                  "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
                  "description": "The exact Rust version, e.g. 1.93.0."
                },
                "cargo_home": {
                  "type": "string",
                  "pattern": "^/",
                  "description": "CARGO_HOME on the host."
                },
                "rustup_home": {
                  "type": "string",
                  "pattern": "^/",
                  "description": "RUSTUP_HOME on the host."
                }
              }
            },
            "build_packages": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              },
              "description": "Debian packages the build needs."
            },
            "swap": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "size"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "pattern": "^/",
                  "description": "The swap file on the host."
                },
                "size": {
                  "type": "string",
                  "pattern": "^[1-9][0-9]*[MG]$"
                }
              }
            }
          }
        },
        "output_schema": {
          "type": "object",
          "required": [
            "operation"
          ],
          "properties": {
            "operation": {
              "type": "string",
              "const": "prepare"
            },
            "dry_run": {
              "type": "boolean"
            },
            "ssh": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "remote_command": {
              "type": "string"
            },
            "output": {
              "type": "string"
            },
            "state": {
              "type": "string"
            },
            "commit": {
              "type": "string"
            },
            "directory": {
              "type": "string"
            },
            "executable": {
              "type": "string"
            }
          }
        },
        "invoke": {
          "kind": "computer",
          "workdir": "/opt/build-and-install-the-public-receptionist",
          "stdout": "json",
          "argv": [
            "node",
            "/opt/build-and-install-the-public-receptionist/do-work/receptionist-build.mjs",
            "prepare",
            "/run/held/rented-host-admin-key"
          ],
          "stdin": {
            "fill": {
              "from": "input"
            }
          },
          "files": {
            "package_files": [
              {
                "package": "build-and-install-the-public-receptionist",
                "paths": [
                  "do-work"
                ],
                "at": "/opt/build-and-install-the-public-receptionist"
              },
              {
                "package": "administer-a-rented-host",
                "paths": [
                  "do-work"
                ],
                "at": "/opt/administer-a-rented-host"
              }
            ]
          },
          "credential_mounts": [
            {
              "secret_name": "rented-host-admin-ssh-key",
              "mount_path": "/run/held/rented-host-admin-key"
            }
          ]
        },
        "result_selector": "$.result",
        "needs": {
          "expected_seconds": 240,
          "network_egress": true
        },
        "verify": [
          {
            "kind": "sample-run",
            "input": {
              "host": {
                "address": "192.0.2.10",
                "ssh_port": 22,
                "admin_user": "builder",
                "host_key": "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIExampleExampleExampleExampleExampleExample"
              },
              "dry_run": true,
              "source_root": "/srv/receptionist/source",
              "rust": {
                "toolchain": "1.93.0",
                "cargo_home": "/srv/rust/cargo",
                "rustup_home": "/srv/rust/rustup"
              },
              "build_packages": [
                "ca-certificates",
                "curl",
                "openssl",
                "pkg-config",
                "libssl-dev",
                "build-essential"
              ],
              "swap": {
                "path": "/srv/receptionist/build-swap",
                "size": "4G"
              }
            },
            "output_selector": "$.remote_command",
            "contains": "--default-toolchain 1.93.0"
          }
        ],
        "maker": "maker:build-and-install-the-public-receptionist",
        "licence_class": "licence:maker-own",
        "placements": [
          "placement:your-computer"
        ],
        "provenance": {
          "source": "Trillion-X/trillion scripts/portable-receptionist-build.mjs and scripts/portable-service-host-setup.sh lines 2-4 and 26-35"
        }
      }
    },
