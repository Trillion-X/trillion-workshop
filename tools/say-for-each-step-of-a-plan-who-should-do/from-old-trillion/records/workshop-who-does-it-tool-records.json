   ],
   "payload": {
    "kind": "ai-tool-descriptor",
    "status": "active",
    "licence_class": "licence:maker-own",
    "maker": "maker:trillion",
    "listed_on": "2026-10-06T16:00:00Z",
    "id": "tool:find-nearest-places",
    "placements": [
     "placement:this-worker"
    ],
    "needs": {
     "expected_seconds": 8,
     "network_egress": true
    },
    "label": "Find the nearest stores of a brand",
    "job": "Find the nearest stores or places of a brand or name (the nearest Target, Walmart, FedEx Office, UPS Store) around an address or a point, nearest first, each with its address, distance and route buttons for Apple Maps and Google Maps",
    "description": "Give name (a brand or place name) and near (an address, a place name, or { lat, lon }); radius_km, most and mode when wanted. Reads OpenStreetMap's open address and places services. Returns places nearest first, each { name, address, lat, lon, km, opening_hours, buttons }, the start point and said.",
    "input_schema": {
     "type": "object",
     "required": [
      "name",
      "near"
     ],
     "additionalProperties": false,
     "properties": {
      "name": {
       "type": "string",
       "minLength": 1,
       "x-record": {"from": {"row_types": ["place", "company", "brand"]}, "new": {"list": "places", "label": "place", "list_label": "Places", "title_field": "name"}}
      },
      "near": {
       "description": "An address or place name as words, or { lat, lon }",
       "anyOf": [
        {
         "type": "string",
         "minLength": 1
        },
        {
         "type": "object",
         "properties": {
          "lat": {
           "type": "number"
          },
          "lon": {
           "type": "number"
          },
          "address": {
           "type": "string"
          },
          "name": {
           "type": "string"
          }
         }
        }
       ]
      },
      "radius_km": {
       "type": "number",
       "exclusiveMinimum": 0,
       "maximum": 100
      },
      "most": {
       "type": "integer",
       "minimum": 1,
       "maximum": 20
      },
      "mode": {
       "type": "string"
      }
     }
    },
    "output_schema": {
     "type": "object",
     "required": [
      "places",
      "said"
     ],
     "properties": {
      "places": {
       "type": "array",
       "items": {
        "type": "object",
        "required": [
         "name",
         "lat",
         "lon",
         "km",
         "buttons"
        ],
        "properties": {
         "buttons": {
          "type": "array",
          "items": {
           "type": "object",
           "required": [
            "id",
            "label",
            "url"
           ],
           "properties": {
            "id": {
             "type": "string"
            },
            "label": {
             "type": "string"
            },
            "url": {
             "type": "string"
            }
           }
          }
         }
        }
       }
      },
      "said": {
       "type": "string"
      }
     }
    },
    "invoke": {
     "kind": "worker-module",
