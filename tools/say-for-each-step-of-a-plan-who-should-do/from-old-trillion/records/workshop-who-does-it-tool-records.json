{
 "kind": "package-set-records",
 "package_set": "trillion",
 "record_set": "workshop-who-does-it-tool-records",
 "records": [
  {
   "id": "package::trillion::tool::who-does-each-step",
   "address": "package::trillion::tool::who-does-each-step",
   "path": [
    "current-item",
    "published-record"
   ],
   "payload": {
    "kind": "ai-tool-descriptor",
    "status": "active",
    "licence_class": "licence:maker-own",
    "maker": "maker:trillion",
    "listed_on": "2026-10-06T16:00:00Z",
    "id": "tool:who-does-each-step",
    "placements": [
     "placement:this-worker"
    ],
    "needs": {
     "expected_seconds": 1,
     "network_egress": false
    },
    "label": "Who should do each step of a plan",
    "job": "For each step of my plan, protocol, checklist or workflow, say who should do it instead of me: Trillion itself (a tool, a workflow or my AIs), Trillion after one tap with its price (it spends money or reaches someone), me (only for a reason no one else can meet, with every helping doer attached), or nobody yet (a doer to build, never a to-do), so Trillion does the steps for me. Use it on every plan before telling a person to do anything",
    "description": "Give steps, each { words, needs?: [what the step needs, in a few words each, such as \"print at shelf scale\", \"choose a store\", \"directions\", \"observe shoppers\"], only_a_person_because?: one of the reasons tool:what-can-trillion-do lists, given_in?: the id of the person's own message that already gave the consent the step needs (the step is then Trillion's and never asked again), input?: what the doer would be given }. approved lists doer ids the person already said yes to (then Trillion does them without a tap); past lists { doer, result: met | failed } from earlier runs, so doers that worked rise. Returns each step with who (trillion, one-tap, you, nobody-yet), the doers that do it (each with its tool_id, workflow_id or hand_off, cost, and whether it needs a tap), the needs nothing covers yet, and said in plain words, plus counts. Then run every trillion step's doer, offer every one-tap step as one button with its price, and hand every nobody-yet need to the person's AIs to build. Never send a person a list of things to do or bring: a step that is theirs carries its reason.",
    "input_schema": {
     "type": "object",
     "required": [
      "steps"
     ],
     "additionalProperties": false,
     "properties": {
      "steps": {
       "type": "array",
       "minItems": 1,
       "items": {
        "anyOf": [
         {
          "type": "string",
          "minLength": 1
         },
         {
          "type": "object",
          "required": [
           "words"
          ],
          "properties": {
           "id": {
            "type": "string"
           },
           "words": {
            "type": "string",
            "minLength": 1
           },
           "needs": {
            "type": "array",
            "items": {
             "type": "string",
             "minLength": 1
            }
           },
           "only_a_person_because": {
            "type": "string"
           },
           "given_in": {
            "type": "string",
            "description": "The id of the person's own message that already gave the consent this step needs; such a step is Trillion's, never asked again"
           },
           "input": {
            "type": "object"
           }
          }
         }
        ]
       }
      },
      "approved": {
       "type": "array",
       "items": {
        "type": "string"
       }
      },
      "past": {
       "type": "array",
       "items": {
        "type": "object",
        "required": [
         "doer",
         "result"
        ],
        "properties": {
         "doer": {
          "type": "string"
         },
         "result": {
          "enum": [
           "met",
           "failed",
           "unknown"
          ]
         }
        }
       }
      }
     }
    },
    "output_schema": {
     "type": "object",
     "required": [
      "steps",
      "counts",
      "said"
     ],
     "properties": {
      "steps": {
       "type": "array",
       "items": {
        "type": "object",
        "required": [
         "id",
         "words",
         "who",
         "doers",
         "uncovered",
         "said"
        ],
        "properties": {
         "who": {
          "enum": [
           "trillion",
           "one-tap",
           "you",
           "nobody-yet"
          ]
         }
        }
       }
      },
      "counts": {
       "type": "object"
      },
      "said": {
       "type": "string"
      }
     }
    },
    "invoke": {
     "kind": "worker-module",
     "module": "who-does-it",
     "export": "whoDoesEachStep"
    },
    "provenance": {
     "source": "src/who-does-it.mjs over src/who-does-it.json (doers, reasons only a person can meet, words)"
    },
    "verify": [
     {
      "kind": "sample-run",
      "input": {
       "steps": [
        {
         "words": "Print the packaging at shelf scale",
         "needs": [
          "print at shelf scale"
         ]
        },
        {
         "words": "Pick the nearest Target",
         "needs": [
          "choose a store"
         ]
        },
        {
         "words": "Drive there",
         "needs": [
          "directions"
         ]
        },
        {
         "words": "Reply to Mom",
         "only_a_person_because": "their-own-relationship"
        }
       ]
      },
      "output_selector": "$.steps[1].who",
      "contains": "trillion"
     }
    ]
   }
  },
