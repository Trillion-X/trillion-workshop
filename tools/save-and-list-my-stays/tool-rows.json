        "needs": {
          "expected_seconds": 5,
          "network_egress": false
        },
        "id": "tool:save-a-stay",
        "label": "Save a stay",
        "job": "Offer or change a place a person hosts, in their own database",
        "description": "Saves one stay the person offers: a city or area (never a street address), a price (free, ask, or a per-night amount in cents with a currency) and whether it is active. Give database and person; stay_id changes one of their stays. A person can have at most 6 active stays; an inactive one is always saved. The stay is kept in this database's stays table. Refused when the stay is not the person's.",
        "input_schema": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "database",
            "person",
            "title",
            "where",
            "price"
          ],
          "properties": {
            "database": {
              "type": "string",
              "minLength": 1,
              "description": "The person's own pursuit database that holds their stays table (such as ethos_for_who_runs_it). The computer opens it with the login its vault holds as that name and -connection."
            },
            "person": {
              "type": "string",
              "minLength": 1,
              "description": "The person whose stay this is. Their own database holds it; a stay that is not theirs is refused."
            },
            "stay_id": {
              "type": "string",
              "description": "The stay to change; leave out to create one."
            },
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            },
            "where": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80,
              "description": "City or area, not a street address."
            },
            "about": {
              "type": "string",
              "maxLength": 1500
            },
            "when": {
              "type": "string",
              "maxLength": 300
            },
            "price": {
              "type": "object",
              "required": [
                "kind"
              ],
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": [
                    "free",
                    "per-night",
                    "ask"
                  ]
                },
                "amount_cents": {
                  "type": "integer",
                  "minimum": 1
                },
                "currency": {
                  "type": "string"
                }
              }
            },
            "active": {
              "type": "boolean"
            }
          }
        },
        "output_schema": {
          "type": "object",
          "required": [
            "stay"
          ],
          "properties": {
            "stay": {
              "type": "object",
              "description": "One stay: stay_id, title, where, about, when, price {kind, amount_cents, currency}, active."
            }
          }
        },
