    {
      "payload": {
        "kind": "ai-tool-descriptor",
        "id": "tool:write-a-message-body-from-a-document",
        "label": "Turn a document into a message body (runs on your computer)",
        "job": "Turn a document I wrote (headings, paragraphs, images, a quoted reply) into the HTML and plain-text body of a message, ready to send",
        "description": "Takes a request file { document_nodes: [{ id, kind, props, children, visible }] or one root node, options? } and writes { body_html, body_text, inline_refs, degraded }. Text and heading kinds become paragraphs and headings with a plain-text line each; image and media blocks become inline_refs { cid, fetch_ref, mime } for the sender to attach; blocks marked as a quote become one blockquote with > lines; hidden subtrees are skipped; a block kind it does not know falls back to its text and is listed in degraded, never dropped silently. options.kind_renderers maps your own block kinds to paragraph, heading1 to heading3 or media. It names no mail provider.",
        "status": "active",
        "input_schema": {
          "type": "object",
          "required": ["request", "output"],
          "properties": {
            "request": { "type": "string", "description": "Path of the request JSON file" },
            "output": { "type": "string", "description": "Path to write the result JSON to" }
          }
        },
        "output_schema": {
          "type": "object",
          "description": "Exit 0 and one summary line: the HTML and text sizes, the number of parts and of degraded blocks. The output file holds { body_html, body_text, inline_refs, degraded }."
        },
        "invoke": {
          "kind": "on-your-computer",
          "get_it": ["clone the Workshop repository (package.json repository.url)"],
          "run": "python3 -I tools/send-messages/do-work/composition_mail_serializer.py {request} {output}",
          "needs": ["python"],
          "say": "This runs on the person's own computer, from the root of the Workshop checkout. Write the request file from the document, run `run`, then read the output file. Hand body_html and body_text to the sending tool as html and text. Tell the person about every entry in degraded (a block that could not be shown as itself). If you cannot run commands, give them these steps."
        },
        "maker": "maker:send-messages",
        "licence_class": "licence:maker-own",
        "placements": ["placement:your-computer"],
        "provenance": { "source": "bitfield-packages composition-mail-serializer, ported unchanged" }
      }
    },
