{
  "kind": "tool-rows",
  "record_set": "send-messages-tool-rows",
  "what_this_is": "The Workshop rows for sending a message from the person's AI: an email (Amazon SES or Resend), a text (Twilio) or a Messages message on the person's own Mac, to one person or a list, and turning a document into a message body first. Each provider is one row here and one entry in read-data/message-providers.json; the person's own key reaches the one process on private pipes and is never in the request.",
  "records": [
    {
      "payload": {
        "kind": "ai-tool-descriptor",
        "id": "tool:send-an-email-with-amazon-ses",
        "label": "Send an email with Amazon SES",
        "job": "Send an email, to one person or a list, through my Amazon SES account",
        "description": "Give recipients (a list of addresses; to for one), from (an address verified in SES), region (such as us-east-1), and the words: subject and html (text optional), or template (a template name from read-data/message-templates.json, or your own templates) with variables. Each recipient is sent to on their own and answered on their own: sent holds { recipient, messageId } or { recipient, error }. The held SES keys reach the one process on private pipes; they are never shown and no sender is assumed.",
        "status": "active",
        "input_schema": {
          "type": "object",
          "additionalProperties": false,
          "required": ["from", "region"],
          "properties": {
            "recipients": { "type": "array", "minItems": 1, "items": { "type": "string" } },
            "to": { "type": "string" },
            "from": { "type": "string" },
            "region": { "type": "string" },
            "subject": { "type": "string" },
            "html": { "type": "string" },
            "text": { "type": "string" },
            "template": { "type": "string" },
            "templates": { "type": "array" },
            "variables": { "type": "object" },
            "message": { "type": "object" },
            "headers": { "type": "object" },
            "idempotencyKey": { "type": "string" }
          }
        },
        "output_schema": {
          "type": "object",
          "required": ["provider", "sent", "said"],
          "properties": {
            "provider": { "type": "string" },
            "sent": { "type": "array", "items": { "type": "object", "required": ["recipient"], "properties": { "recipient": { "type": "string" }, "messageId": { "type": "string" }, "error": { "type": "string" } } } },
            "said": { "type": "string" }
          }
        },
        "invoke": {
          "kind": "container",
          "internet": true,
          "workdir": "/opt/send-messages",
          "stdout": "json",
          "argv": ["node", "/opt/send-messages/do-work/send-a-message.mjs", "amazon-ses"],
          "stdin": { "fill": { "from": "input" } },
          "files": {
            "package_files": { "package": "send-messages", "paths": ["do-work", "read-data"], "at": "/opt/send-messages" }
          },
          "credential_mounts": [
            { "secret_name": "amazon-ses-access-key-id", "fd": 3 },
            { "secret_name": "amazon-ses-secret-access-key", "fd": 4 }
          ]
        },
        "result_selector": "$.result",
        "needs": { "expected_seconds": 10, "network_egress": true },
        "maker": "maker:send-messages",
        "licence_class": "licence:maker-own",
        "placements": ["placement:your-computer"],
        "provenance": { "source": "bitfield-packages broadcast-delivery (Amazon SES adapter) and resend-email-sender (templates, headers), ported" }
      }
    },
    {
      "payload": {
