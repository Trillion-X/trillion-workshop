test('does not mistake a same-named final-bundle function declaration for a hook call', () => {
  const analysis = staticReadScopeSelectorAnalysisFromFinalBundle(`
    var read = createUseBitfieldData(scope);
    function read() { return null; }
    read('declared-input');
  `);
  assert.deepEqual(analysis, { selectors: ['declared-input'], unresolved: [], selectorless: [] });
});

test('final read analysis preserves regex literals containing comment delimiters and quotes', () => {
  const source = 'var read = createUseBitfieldData(scope);\nconst pattern = /["/*]/;\nread("actual");';
  assert.deepEqual(staticReadScopeSelectorAnalysisFromFinalBundle(source), {
    selectors: ['actual'], unresolved: [], selectorless: [],
  });
});

test('final read analysis ignores quoted diagnostics but retains real calls and template expressions', () => {
  const source = [
    'var useBitfieldData = createUseBitfieldData(scope);',
    "const message = 'useBitfieldData() without an input handle requires a Bitfield read scope';",
    'const other = "useBitfieldData(\\\"not-an-input\\\")";',
    'const pattern = /useBitfieldData\\(\\)/;',
    '`useBitfieldData() is text ${useBitfieldData("actual-template-input")}`;',
    'useBitfieldData();',
  ].join('\n');
  assert.deepEqual(staticReadScopeSelectorAnalysisFromFinalBundle(source), {
    selectors: ['actual-template-input'], unresolved: [], selectorless: [{ hookName: 'useBitfieldData' }],
  });
  assert.deepEqual(staticReadScopeSelectorAnalysisFromFinalBundle(source.split('\n').slice(0, 4).join('\n')), {
    selectors: [], unresolved: [], selectorless: [],
  });
});

