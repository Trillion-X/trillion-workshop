      packageSetRoot: fixture.root, runtimeKitReactFile: fixture.wrapper,
      metafile: { inputs: {} }, bundleSource: '',
    }),
    /BPS_ENTRY_READ_0101_WRAPPER_APP_IDENTITY/,
  );
});

