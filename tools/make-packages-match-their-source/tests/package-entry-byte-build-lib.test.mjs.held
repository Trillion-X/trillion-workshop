test('rejects static and dynamic reads from a sealed live_read_mode none entry', async (t) => {
  const fixture = await scopeContractFixture(t);
  await writeFile(fixture.wrapper, `export const bitfieldGeneratedLiveReadScopeDescriptor = { live_read_mode: 'none' } as const;`);
  await assert.rejects(
    () => assertFinalEntryReadScopeContract({
      packageName: 'consumer', entryName: 'screen', packageRoot: fixture.packageRoot,
      packageSetRoot: fixture.root, runtimeKitReactFile: fixture.wrapper, metafile: { inputs: {} },
      bundleSource: `var read = createUseBitfieldData(scope); read(); read('static-input'); const selector = getSelector(); read(selector);`,
    }),
    (error) => /BPS_ENTRY_READ_0106_SEALED_ENTRY_LIVE_READ/.test(error.message)
      && error.message.includes('static-input')
      && error.message.includes('read(selector)')
      && error.message.includes('read()'),
  );
});

// The canonical partition resolver must never substitute the SET NAME for the
// PARTITION. Those are two facts. They carry the same string for today's
// single-partition sets, so a substitution is invisible until the first set where
// they differ, which is exactly the set this work exists to make possible.
//
// The legacy branch used to end `requiredPartition(legacy.partition ?? legacy.package_set)`.
// That is the same substitution that caused the 2026-09-03 retraction of 124 live
// group records: the owner looked up an ownership marker under one identity, found
// none, and treated live records as unowned orphans. It was unreachable when
// removed (every present set has package-set-partition.json), which is why it had
// to go: dead code holding a live conflation fires silently for the first set that
// lacks a descriptor.
//
// Every fixture here gives the two facts DIFFERENT values. A fixture that mirrors
// production, where they match, cannot fail when they are conflated.
{
  // This import used to read `./package-entry-byte-build-lib.mjs`, a file that never existed
  // beside the test. The rejection surfaced only after every other test had finished, so the
  // runner reported 41 passes and exit 1, and the block below never registered a single test.
  // Found 2026-09-05 when the file moved under a runner a package declares.
  const { readCanonicalPackageSetPartition } = await import('../do-work/package-entry-byte-build-lib.mjs');

  async function setRoot(t, { descriptor, legacy }) {
    const root = await mkdtemp(path.join(os.tmpdir(), 'package-set-partition-'));
    t.after(() => rm(root, { recursive: true, force: true }));
    if (descriptor) {
      await writeFile(path.join(root, 'package-set-partition.json'), JSON.stringify(descriptor));
    }
    if (legacy) {
      await mkdir(path.join(root, 'what-packages-were-used-and-why'), { recursive: true });
      await writeFile(
        path.join(root, 'what-packages-were-used-and-why', 'what-packages-were-used-and-why.json'),
        JSON.stringify(legacy),
      );
    }
    return root;
  }

  test('the descriptor partition wins and is not confused with the set name', async (t) => {
    const root = await setRoot(t, {
      descriptor: {
        schema: 'bitfield-package-set-partition/declared-partition',
        partition: 'the-partition',
        set_name: 'the-set',
      },
    });
    assert.equal(await readCanonicalPackageSetPartition(root), 'the-partition');
  });

  test('the legacy file states its own partition, distinct from its set name', async (t) => {
    const root = await setRoot(t, {
      legacy: { partition: 'the-partition', package_set: 'the-set' },
    });
    assert.equal(await readCanonicalPackageSetPartition(root), 'the-partition');
  });

  test('a legacy file with only a set name FAILS instead of substituting it', async (t) => {
    const root = await setRoot(t, { legacy: { package_set: 'the-set' } });
    await assert.rejects(
      () => readCanonicalPackageSetPartition(root),
      (error) => {
        assert.match(error.message, /package_set but no partition/);
        assert.match(error.message, /two facts/);
        return true;
      },
      'a missing partition must be an error, never the set name',
    );
  });
}
