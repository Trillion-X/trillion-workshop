    /PACKAGE_RETAINED_LIVE_DATA_PATH_INVALID/);
  await writeRetainedPolicy(folder, [["prop:source"], ["prop:source"]]);
  assert.throws(() => retainedLiveDataPathsFromSelectedSource({ packageSetFolder: folder, packageName: PACKAGE }),
    /PACKAGE_RETAINED_LIVE_DATA_PATH_DUPLICATE/);
});

test("live ownership omitted by the current-version pointer is still retired", async () => {
  const orphanRecord = `1f20${"77".repeat(32)}`;
  const orphanMetadata = metadataAddressWireHexForRecord(orphanRecord);
  const orphanMetadataPayload = {
    schema: "package_record_source_metadata",
    package_set: PACKAGE_SET,
    source_package: PACKAGE,
    source_address: "retired-source-row",
    authority_class_address: "authority-class::impl",
    resolved_address_wire_hex: orphanRecord,
    path: ["retired", "implementation"],
  };
  const engine = new FakeEngine({
    scanEntries: [{ address: orphanMetadata, payload: orphanMetadataPayload }],
  });
  const plan = sourcePlan();
  await seedLivePackage(engine, plan);
  engine.current.set(orphanRecord, liveEntry(Buffer.from("obsolete implementation"), orphanMetadataPayload.path));
  engine.current.set(orphanMetadata, liveEntry(
    Buffer.from(JSON.stringify(orphanMetadataPayload)),
    ["package-record-source-metadata"],
  ));

  const result = await makeOnePackageMatchItsSource({
    packageSetFolder: await identityFolder(),
    packageName: PACKAGE,
    packageLoader: import.meta.filename,
    client: engine.client(),
    execFileAsync: async () => ({ stdout: JSON.stringify(plan) }),
  });

  assert.equal(result.outcome, "applied");
  assert.equal(result.stats.retract_count, 2);
  assert.equal(engine.current.has(orphanRecord), false);
  assert.equal(engine.current.has(orphanMetadata), false);
});

