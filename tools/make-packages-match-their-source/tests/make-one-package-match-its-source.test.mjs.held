test("package source contains no app, customer, founder path, or speculative repair identity", async () => {
  const root = new URL("..", import.meta.url);
  const files = productionPackageFiles(root);
  assert.ok(files.length >= 4);
  const combined = (await Promise.all(files.map(async (file) => [
    file,
    await readFile(file, "utf8"),
  ])));
  for (const [file, text] of combined) {
    assert.equal(/trillion/i.test(text), false, file);
    assert.equal(text.includes("/Users/example"), false, file);
    assert.equal(text.includes("healOrphansBeforeDelta"), false, file);
    assert.equal(text.includes("PACKAGE_DELTA_PRE_SUBMIT_REPAIR"), false, file);
  }
});

async function identityFolder(packageSet = PACKAGE_SET, partition = PARTITION, packageName = PACKAGE) {
  const folder = await mkdtemp(join(tmpdir(), "package-owner-"));
  await writeFile(join(folder, "package-set-partition.json"), JSON.stringify({
    schema: "bitfield-package-set-partition/v1",
    set_name: packageSet,
    partition,
  }));
  const sourceFolder = join(folder, "packages", packageName);
  await mkdir(sourceFolder, { recursive: true });
  await writeFile(join(sourceFolder, "things-to-store-and-run.json"), JSON.stringify({
    package: packageName,
    things: [],
  }));
  return folder;
}

async function writeReactiveSourceDeclaration(folder) {
  const sourcePath = join(folder, "packages", PACKAGE, "things-to-store-and-run.json");
  const source = JSON.parse(await readFile(sourcePath, "utf8"));
  source.things.push({
    type: "record_from_matching_records",
    address: `package::${PACKAGE}::published-records`,
    path: ["engine-owned", "published-record"],
    matching_record_paths: [["current-item", "published-record"]],
  });
  await writeFile(sourcePath, JSON.stringify(source));
}

async function writeRetainedPolicy(folder, paths) {
  const sourcePath = join(folder, "packages", PACKAGE, "things-to-store-and-run.json");
  const source = JSON.parse(await readFile(sourcePath, "utf8"));
  source.things = source.things.filter((thing) => thing?.payload?.kind !== "bitfield-package-retained-live-data-policy");
  source.things.push({
    type: "record", address: `package::${PACKAGE}::retained-live-data-policy`,
    payload: { kind: "bitfield-package-retained-live-data-policy", path_labels: paths },
  });
  await writeFile(sourcePath, JSON.stringify(source));
}

function sourcePlan(writes = [recordWrite(A_RECORD), metadataWrite(A_METADATA)]) {
  return {
    schema: "bitfield.package_delta_source_plan/v1",
    package_set: PACKAGE_SET,
    partition: PARTITION,
    package_name: PACKAGE,
    record_writes: writes,
    stored_byte_writes: [],
    entry_writes: [],
  };
}

function sourcePlanForPackage(packageName) {
  const metadata = metadataWrite(A_METADATA);
  const decoded = JSON.parse(Buffer.from(metadata.payload_base64, "base64").toString("utf8"));
  decoded.source_package = packageName;
  decoded.source_address = `package::${packageName}::record::${A_RECORD}`;
  metadata.payload_base64 = Buffer.from(JSON.stringify(decoded)).toString("base64");
  return {
    ...sourcePlan([recordWrite(A_RECORD), metadata]),
    package_name: packageName,
  };
}

function recordWrite(address = A_RECORD, payload = Buffer.from(`record:${address}`)) {
  return {
    address_label: address,
    address_mode: "multihash-hex",
    path_labels: ["current-item", "published-record", address],
    payload_base64: payload.toString("base64"),
  };
}

function metadataWrite(address = A_METADATA, resolved = A_RECORD, sourceAddress = `package::${PACKAGE}::record::${resolved}`, path = null) {
  const payload = Buffer.from(JSON.stringify({
    schema: "package_record_source_metadata",
    package_set: PACKAGE_SET,
    source_package: PACKAGE,
    authority_class_address: "authority-class::impl",
    resolved_address_wire_hex: resolved,
    path: path ?? ["current-item", "published-record", resolved],
    source_address: sourceAddress,
  }));
  return {
    address_label: address,
    address_mode: "multihash-hex",
    path_labels: ["package-record-source-metadata"],
    payload_base64: payload.toString("base64"),
  };
}

async function seedLivePackage(engine, plan) {
  const writes = [...plan.record_writes, ...plan.stored_byte_writes, ...plan.entry_writes];
  const metadataByResolved = new Map();
  for (const write of writes.filter((candidate) => candidate.path_labels[0] === "package-record-source-metadata")) {
    const metadata = JSON.parse(Buffer.from(write.payload_base64, "base64").toString("utf8"));
    metadataByResolved.set(metadata.resolved_address_wire_hex, write);
  }
  const records = [];
  for (const record of writes.filter((write) => write.path_labels[0] !== "package-record-source-metadata")) {
    const metadata = metadataByResolved.get(record.address_label);
    if (metadata == null) continue;
    records.push({
      record_address_wire_hex: record.address_label,
      metadata_address_wire_hex: metadata.address_label,
      path_labels: record.path_labels,
    });
    engine.current.set(record.address_label, liveEntry(Buffer.from(record.payload_base64, "base64"), record.path_labels));
    engine.current.set(metadata.address_label, liveEntry(Buffer.from(metadata.payload_base64, "base64"), metadata.path_labels));
  }
  const version = Buffer.from(JSON.stringify({
    schema: "bitfield.package_current_version/v1",
    package_set: PACKAGE_SET,
    partition: PARTITION,
    package_ref: PACKAGE,
    proposal_multihash: "old-proposal",
    previous_version_payload_multihash: null,
    records: records.sort((left, right) => left.record_address_wire_hex.localeCompare(right.record_address_wire_hex)),
  }));
  engine.current.set(VERSION_LABEL, liveEntry(version, ["package-current-version", PACKAGE_SET, PACKAGE]));
}

class FakeEngine {
  constructor({ corruptFoldReadback = false, scanEntries = [] } = {}) {
    this.current = new Map();
    this.cursor = 0;
    this.packageDeltaCount = 0;
    this.submittedTargets = [];
    this.corruptFoldReadback = corruptFoldReadback;
    this.packageDeltaHandler = null;
    this.lastPackageDeltaRequest = null;
    this.scanEntries = scanEntries;
  }

  client() {
    return {
      postBytes: async (target, body) => {
        this.submittedTargets.push(target);
        const request = JSON.parse(Buffer.from(body).toString("utf8"));
        if (target === "engine.operation.label-addressed") return response(this.engineOperation(request));
      if (target !== "package-set-runtime-state.apply-package-delta") return response({ error: "unknown target" }, 404);
      this.packageDeltaCount += 1;
      this.lastPackageDeltaRequest = request;
      return response(this.packageDeltaHandler ? this.packageDeltaHandler(request) : this.commit(request));
      },
    };
  }

  engineOperation(request) {
    if (request.operation_label === "engine.operation.current-cursor") return { cursor: this.cursor };
    if (request.operation_label === "engine.operation.scan-current-under-path") {
      return { entries: this.scanEntries, next_cursor: null, hit_limit: false };
    }
    if (request.operation_label !== "engine.operation.read-current") return { error: "unknown operation" };
    const entry = this.current.get(request.address_label);
    return entry == null
      ? { found: false }
      : { found: true, payload_base64: entry.payload_base64.toString("base64") };
  }

  commit(request) {
    const before = this.cursor;
    const versionLabel = packageCurrentVersionAddressLabel(request.partition,
      request.package_ref,
    );
    for (const operation of request.operations) {
      if (!basisMatches(this.current.get(operation.address_wire_hex), operation.basis)) {
        return this.rejected(request, "PACKAGE_DELTA_STALE_BASIS", before);
      }
    }
    const next = new Map(this.current);
    for (const operation of request.operations) {
      if (operation.successor.state === "tombstone") next.delete(operation.address_wire_hex);
      else next.set(operation.address_wire_hex, liveEntry(Buffer.from(operation.successor.payload_base64, "base64"), operation.path_labels));
    }
    const tombstoned = new Set(request.operations
      .filter((operation) => operation.successor.state === "tombstone")
      .map((operation) => operation.address_wire_hex));
    const versionEntry = liveEntry(Buffer.from(JSON.stringify({
      schema: "bitfield.package_current_version/v1",
      package_set: request.package_set,
      partition: request.partition,
      package_ref: request.package_ref,
      proposal_multihash: request.proposal_multihash,
      previous_version_payload_multihash: payloadHash(this.current.get(versionLabel)),
      records: request.ownership_proofs
        .filter((proof) => !tombstoned.has(proof.record_address_wire_hex))
        .map((proof) => ({
          record_address_wire_hex: proof.record_address_wire_hex,
          metadata_address_wire_hex: proof.metadata_address_wire_hex,
          path_labels: JSON.parse(Buffer.from(proof.metadata_payload_base64, "base64").toString("utf8")).path,
        }))
        .sort((left, right) => left.record_address_wire_hex.localeCompare(right.record_address_wire_hex)),
    })), ["package-current-version", request.package_set, request.package_ref]);
    next.set(versionLabel, versionEntry);
    this.current = next;
    this.cursor += 1;
    if (this.corruptFoldReadback) this.current.set(A_RECORD, liveEntry(Buffer.from("wrong bytes"), ["wrong"]));
    return {
      schema: "bitfield.package_delta_receipt/v1",
      outcome: "applied",
      cursor_before: String(before),
      cursor_after: String(this.cursor),
      current_version_payload_multihash: payloadHash(versionEntry),
    };
  }

  rejected(request, reason, cursor) {
    return {
      schema: "bitfield.package_delta_receipt/v1",
      outcome: "rejected",
      reason_code: reason,
      cursor_before: String(cursor),
      cursor_after: String(cursor),
      current_version_payload_multihash: payloadHash(this.current.get(
        packageCurrentVersionAddressLabel(request.partition, request.package_ref),
      )),
    };
  }
}

function clientThatCounts(onPost) {
  return {
    postBytes: async () => {
      onPost();
      return response({ error: "unexpected contact" }, 500);
    },
  };
}

function response(body, status = 200) {
  return {
    ok: status >= 200 && status < 300,
    status,
    text: async () => JSON.stringify(body),
  };
}

function liveEntry(payload, pathLabels) {
  return { payload_base64: payload, path_labels: pathLabels };
}

function basisMatches(entry, basis) {
  if (basis.state === "absent") return entry == null;
  return entry != null && payloadHash(entry) === basis.payload_multihash;
}

function payloadHash(entry) {
  return entry == null ? null : hashCodeHexFromBytes(entry.payload_base64);
}

function packageOperation(request, address) {
  return request.operations.find((operation) => operation.address_wire_hex === address);
}

function packageDeltaStats(request) {
  return request[Symbol.for("bitfield.package_delta.plan_stats")];
}

async function packageFiles(root, prefix = "") {
  const entries = await readdir(new URL(prefix, root), { withFileTypes: true });
  const files = [];
  for (const entry of entries) {
    const relative = prefix ? `${prefix}/${entry.name}` : entry.name;
    if (entry.isDirectory()) {
      if (entry.name === "node_modules" || entry.name === ".git") continue;
      files.push(...await packageFiles(root, relative));
    } else {
      files.push(new URL(relative, root));
    }
  }
  return files;
}

assert.equal(existsSync(import.meta.filename), true);

function productionPackageFiles(root) {
  return [
    new URL("README.md", root),
    new URL("package.json", root),
    new URL("things-to-store-and-run.json", root),
    new URL("do-work/make-one-package-match-its-source.mjs", root),
  ];
}
