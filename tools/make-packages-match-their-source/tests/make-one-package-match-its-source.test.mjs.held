test("live-only ownership recovery is explicit and cannot be combined with source adoption", () => {
  const options = installedConvergenceOptionsFromArgs([
    "--app-id", "fixture-app", "--package", "package-set-records", "--adopt-live-ownership-only",
  ]);
  assert.equal(options.adoptLiveOwnershipOnly, true);
  assert.throws(() => installedConvergenceOptionsFromArgs([
    "--app-id", "fixture-app", "--package", "package-set-records",
    "--adopt-live-ownership-only", "--adopt-unversioned-source-records",
  ]), /choose one explicit adoption mode/);
});

test("live inventory bounds full ownership reads below hash-only record reads", () => {
  assert.equal(LIVE_INVENTORY_FULL_READ_CONCURRENCY, 8);
  assert.ok(LIVE_INVENTORY_READ_CONCURRENCY > LIVE_INVENTORY_FULL_READ_CONCURRENCY);
});

// Two tests stood here for `resolveLivePackageIdentity`, which scanned a
// running app to learn WHICH PACKAGE SET owned a package so a caller could
// scope a delta to whatever name the live rows carried. The set name is no
// longer part of a package's identity, so there is nothing to resolve and
// nothing for a historical name to outrank. Nothing but these tests ever
// called it.



const PACKAGE_SET = "fixture-set";
const PARTITION = "fixture-partition";
const PACKAGE = "alpha";
const VERSION_LABEL = packageCurrentVersionAddressLabel(PARTITION, PACKAGE);

test("source convergence CLI accepts only installed app and package identities", async () => {
  const frontDoor = await readFile(new URL("../do-work/run-make-packages-match-their-source.mjs", import.meta.url), "utf8");
  assert.match(frontDoor, /convergeInstalledPackageSource/);
  assert.doesNotMatch(frontDoor, /["']--(?:package-set-folder|packages-source-root|package-loader|status-file|places|engine|scheme)["']/);
  assert.doesNotMatch(frontDoor, /native-artifact|baseline|signing-key|source-revision|commit-materialized|reviewed-proposal/);
});
const A_RECORD = "11";
const A_METADATA = "22";
const B_RECORD = "33";
const B_METADATA = "44";
const REACTIVE_RECORD = "55";
const REACTIVE_METADATA = "66";

test("root execution environment declares the publisher's direct hash dependency", async () => {
  const repository = JSON.parse(await readFile(new URL("../../../package.json", import.meta.url), "utf8"));
  const owner = JSON.parse(await readFile(new URL("../package.json", import.meta.url), "utf8"));
  const source = await readFile(new URL("../do-work/make-one-package-match-its-source.mjs", import.meta.url), "utf8");
  assert.match(source, /from ["']@noble\/hashes\/blake3\.js["']/);
  assert.equal(repository.dependencies["@noble/hashes"], owner.dependencies["@noble/hashes"]);
});

test("package identity comes only from the descriptor and never from a folder basename", async () => {
  const folder = await identityFolder("stated-set", "stated-partition");
  assert.deepEqual(packageSetIdentityFrom(folder), {
    descriptorPath: join(folder, "package-set-partition.json"),
    package_set: "stated-set",
    partition: "stated-partition",
  });
});

test("an incomplete identity fails before package-loader or running-app contact", async () => {
  const folder = await mkdtemp(join(tmpdir(), "wrong-set-"));
  let loaderRuns = 0;
  let targetRuns = 0;
  await assert.rejects(
    makeOnePackageMatchItsSource({
      packageSetFolder: folder,
      packageName: PACKAGE,
      packageLoader: import.meta.filename,
      client: clientThatCounts(() => { targetRuns += 1; }),
      execFileAsync: async () => {
        loaderRuns += 1;
        return { stdout: "{}" };
      },
    }),
    /PACKAGE_SET_IDENTITY_DESCRIPTOR_MISSING:/,
  );
  assert.equal(loaderRuns, 0);
  assert.equal(targetRuns, 0);
});

test("compiler reply scope mismatch fails before live contact", async () => {
  const folder = await identityFolder();
  const plan = sourcePlan();
  plan.package_set = "different-set";
  let targetRuns = 0;
  await assert.rejects(
    makeOnePackageMatchItsSource({
      packageSetFolder: folder,
      packageName: PACKAGE,
      packageLoader: import.meta.filename,
      client: clientThatCounts(() => { targetRuns += 1; }),
      execFileAsync: async () => ({ stdout: JSON.stringify(plan) }),
    }),
    /PACKAGE_LOADER_REPLY_SCOPE_MISMATCH/,
  );
  assert.equal(targetRuns, 0);
});

test("package-loader is invoked once with both package-set and partition facts", async () => {
  const folder = await identityFolder();
  const plan = sourcePlan();
  const invocations = [];
  const compiled = await compileOnePackageSourcePlan({
    packageSetFolder: folder,
    packageName: PACKAGE,
    packageSet: PACKAGE_SET,
    partition: PARTITION,
    packageLoader: import.meta.filename,
    readFile: () => "import test from 'node:test';",
    execFileAsync: async (command, args) => {
      invocations.push({ command, args });
      return { stdout: JSON.stringify(plan) };
    },
  });
  assert.equal(compiled.package_name, PACKAGE);
  assert.equal(invocations.length, 1);
  // A .mjs loader is not executable on its own, so it is run as `node <loader> ...` and the loader
  // IS the first argument. This assertion used to omit it while the fixture passed
  // `import.meta.filename`, so the test contradicted its own input and failed the moment the
  // two-branch spawn landed. It could contradict itself because it never asserted `command`:
  // checking the arguments while ignoring the program is checking half a spawn, and the half it
  // skipped is the half that decides what the arguments MEAN.
  assert.equal(invocations[0].command, process.execPath);
  assert.deepEqual(invocations[0].args, [
    import.meta.filename,
    "compile-package-delta-source",
    "--source-root", folder,
    "--partition", PARTITION,
    "--package", PACKAGE,
    "--package-set", PACKAGE_SET,
  ]);
});

test("separate BUDAG roots compile without copying packages into the package set", async () => {
  const packageSetOwner = await mkdtemp(join(tmpdir(), "package-set-owner-"));
  const packageOwner = await mkdtemp(join(tmpdir(), "package-source-owner-"));
  const setFolder = join(packageSetOwner, PACKAGE_SET);
  await mkdir(setFolder, { recursive: true });
  await writeFile(join(setFolder, "package-set-partition.json"), JSON.stringify({
    schema: "bitfield-package-set-partition/v1",
    set_name: PACKAGE_SET,
    partition: PARTITION,
  }));
  const packagesSourceRoot = join(packageOwner, "packages");
  await mkdir(join(packagesSourceRoot, PACKAGE), { recursive: true });
  await writeFile(join(packagesSourceRoot, PACKAGE, "things-to-store-and-run.json"), JSON.stringify({
    package: PACKAGE,
    things: [],
  }));
  const invocations = [];
  await compileOnePackageSourcePlan({
    packageSetFolder: setFolder,
    packagesSourceRoot,
    packageName: PACKAGE,
    packageSet: PACKAGE_SET,
    partition: PARTITION,
    packageLoader: import.meta.filename,
    readFile: () => "import test from 'node:test';",
    execFileAsync: async (command, args) => {
      invocations.push({ command, args });
      return { stdout: JSON.stringify(sourcePlan()) };
    },
  });
  const setFlag = invocations[0].args.indexOf("--package-set-source-root");
  const packagesFlag = invocations[0].args.indexOf("--packages-source-root");
  assert.equal(invocations[0].args[setFlag + 1], setFolder);
  assert.equal(invocations[0].args[packagesFlag + 1], packagesSourceRoot);
  assert.equal(invocations[0].args.includes("--source-root"), false);
  assert.equal(existsSync(join(setFolder, "packages")), false, "no copied package tree was created");
});

test("a reusable package can keep its source owner while targeting a migrated package-set identity", async () => {
  const folder = await identityFolder();
  const invocations = [];
  await compileOnePackageSourcePlan({
    packageSetFolder: folder,
    packageName: PACKAGE,
    packageSet: "live-legacy-set",
    sourcePackageSet: PACKAGE_SET,
    partition: PARTITION,
    packageLoader: import.meta.filename,
    readFile: () => "import test from 'node:test';",
    execFileAsync: async (command, args) => {
      invocations.push({ command, args });
      const plan = sourcePlan();
      plan.package_set = "live-legacy-set";
      return { stdout: JSON.stringify(plan) };
    },
  });
  assert.deepEqual(invocations[0].args.slice(1, 7), [
    "compile-package-delta-source",
    "--source-root", folder,
    "--source-package-set", PACKAGE_SET,
    "--partition",
  ]);
});

test("an executable shebang owns dispatch even when its compatibility path ends in .mjs", async () => {
  const folder = await identityFolder();
  const plan = sourcePlan();
  const invocations = [];
  const executableShim = "/tools/package-loader.mjs";
  await compileOnePackageSourcePlan({
    packageSetFolder: folder,
    packageName: PACKAGE,
    packageSet: PACKAGE_SET,
    partition: PARTITION,
    packageLoader: executableShim,
    exists: () => true,
    readFile: () => "#!/bin/bash\nexec /current/package-loader \"$@\"\n",
    execFileAsync: async (command, args) => {
      invocations.push({ command, args });
      return { stdout: JSON.stringify(plan) };
    },
  });
  assert.equal(invocations.length, 1);
  assert.equal(invocations[0].command, executableShim);
  assert.equal(invocations[0].args[0], "compile-package-delta-source");
  assert.ok(!invocations[0].args.includes(executableShim));
});

test("a loader that is NOT javascript is the program itself, and is not repeated as an argument", async () => {
  // The other side of the same branch, which nothing exercised. A test that only ever ran the
  // js-loader path proves nothing about the binary path, and the binary path is the one the real
  // runtime uses, so the covered direction was the rarer one.
  //
  // A directory stands in for a binary because the only thing the code asks of a loader is that it
  // EXISTS and does not end in .mjs or .js. `exists` is not injected here, so this has to be a real
  // path on disk rather than an invented name.
  //
  // The loader and the package-set folder are DELIBERATELY different paths. The first draft used
  // the same value for both, and the "loader is not repeated in args" assertion then matched the
  // legitimate `--package-set-folder` value and failed against correct code. Two facts sharing one
  // value blinds any assertion that cannot tell which one it found.
  const folder = await identityFolder();
  const loaderThatIsNotJavascript = import.meta.dirname;
  const plan = sourcePlan();
  const invocations = [];
  await compileOnePackageSourcePlan({
    packageSetFolder: folder,
    packageName: PACKAGE,
    packageSet: PACKAGE_SET,
    partition: PARTITION,
    packageLoader: loaderThatIsNotJavascript,
    execFileAsync: async (command, args) => {
      invocations.push({ command, args });
      return { stdout: JSON.stringify(plan) };
    },
  });
  assert.equal(invocations.length, 1);
  assert.equal(invocations[0].command, loaderThatIsNotJavascript);
  assert.equal(invocations[0].args[0], "compile-package-delta-source");
  // The loader must not appear as an argument at all. Asserting only args[0] would pass if it were
  // repeated later in the list, which is the shape a copy-paste of the js branch would produce.
  assert.ok(
    !invocations[0].args.includes(loaderThatIsNotJavascript),
    `the loader was repeated as an argument: ${JSON.stringify(invocations[0].args)}`,
  );
});

test("a rejected scope submits no repair request before the package-delta rejection", async () => {
  const folder = await identityFolder();
  const plan = sourcePlan();
  const engine = new FakeEngine();
  engine.packageDeltaHandler = () => ({
    schema: "bitfield.package_delta_receipt/v1",
    outcome: "rejected",
    reason_code: "PACKAGE_DELTA_TARGET_SCOPE_MISMATCH",
    cursor_before: "0",
    cursor_after: "0",
    current_version_payload_multihash: null,
  });
  await assert.rejects(
    makeOnePackageMatchItsSource({
      packageSetFolder: folder,
      packageName: PACKAGE,
      packageLoader: import.meta.filename,
      client: engine.client(),
      execFileAsync: async () => ({ stdout: JSON.stringify(plan) }),
    }),
    /PACKAGE_DELTA_TARGET_SCOPE_MISMATCH/,
  );
  assert.deepEqual(engine.submittedTargets, [
      "engine.operation.label-addressed",
      "engine.operation.label-addressed",
      "engine.operation.label-addressed",
      "engine.operation.label-addressed",
      "engine.operation.label-addressed",
      "engine.operation.label-addressed",
      "engine.operation.label-addressed",
      "package-set-runtime-state.apply-package-delta",
    "engine.operation.label-addressed",
  ]);
  assert.equal(engine.packageDeltaCount, 1);
  assert.equal(engine.cursor, 0);
  assert.equal(engine.current.size, 0);
});

test("first update creates paired ownership, atomic marker, cursor receipt, and fold proof", async () => {
  const folder = await identityFolder();
  const plan = sourcePlan();
  const engine = new FakeEngine();
  const result = await makeOnePackageMatchItsSource({
    packageSetFolder: folder,
    packageName: PACKAGE,
    packageLoader: import.meta.filename,
    client: engine.client(),
    execFileAsync: async () => ({ stdout: JSON.stringify(plan) }),
  });
  assert.equal(result.outcome, "applied");
  assert.equal(result.stats.create_count, 2);
  assert.equal(result.stats.update_count, 0);
  assert.equal(result.stats.retract_count, 0);
  assert.equal(result.verification.all_operations_match, true);
  assert.equal(engine.packageDeltaCount, 1);
  assert.equal(Object.hasOwn(engine.lastPackageDeltaRequest, "package_set"), false);
  assert.ok(engine.current.has(A_RECORD));
  assert.ok(engine.current.has(A_METADATA));
  const version = JSON.parse(engine.current.get(VERSION_LABEL).payload_base64.toString("utf8"));
  assert.equal(version.schema, "bitfield.package_current_version/v1");
  assert.deepEqual(version.records.map((record) => record.record_address_wire_hex), [A_RECORD]);
});

test("a declared failing package check rejects before the live delta", async () => {
  const folder = await identityFolder();
  const manifestPath = join(folder, "packages", PACKAGE, "things-to-store-and-run.json");
  const manifest = JSON.parse(await readFile(manifestPath, "utf8"));
  manifest.things.push({
    type: "record",
    address: `package::${PACKAGE}::checks`,
    payload: { kind: "package-checks-descriptor", checks: ["show/missing-render-check.test.tsx"] },
  });
  await writeFile(manifestPath, JSON.stringify(manifest));
  const engine = new FakeEngine();
  await assert.rejects(makeOnePackageMatchItsSource({
    packageSetFolder: folder,
    packageName: PACKAGE,
    packageLoader: import.meta.filename,
    client: engine.client(),
    execFileAsync: async () => ({ stdout: JSON.stringify(sourcePlan()) }),
  }), /PACKAGE_DECLARED_CHECKS_FAILED:alpha:show\/missing-render-check\.test\.tsx:no_runner/);
  assert.equal(engine.packageDeltaCount, 0);
});

test("completion is derived only from matching active target state and durable behavior evidence", async () => {
  const folder = await identityFolder();
  const plan = sourcePlan();
  const engine = new FakeEngine();
  const accepted = await makeOnePackageMatchItsSource({
    packageSetFolder: folder,
    packageName: PACKAGE,
    packageLoader: import.meta.filename,
    client: engine.client(),
    execFileAsync: async () => ({ stdout: JSON.stringify(plan) }),
  });
  const targetRef = "installed-app:fixture";
  const evidenceAddress = "product-correction-evidence::fixture";
  const evidence = {
    schema: PRODUCT_CORRECTION_EVIDENCE_SCHEMA,
    outcome: "passed",
    target_ref: targetRef,
    package_set: PACKAGE_SET,
    partition: PARTITION,
    package_ref: PACKAGE,
    proposal_multihash: accepted.proposal_multihash,
    active_version_payload_multihash: accepted.receipt.current_version_payload_multihash,
    result_multihash: `1f:${"c".repeat(64)}`,
  };
  engine.current.set(evidenceAddress, liveEntry(Buffer.from(JSON.stringify(evidence)), ["product-correction-evidence"]));

  const completed = await verifyProductCorrectionCompletion({
    client: engine.client(),
    targetRef,
    packageSet: PACKAGE_SET,
    partition: PARTITION,
    packageName: PACKAGE,
    proposalMultihash: accepted.proposal_multihash,
    currentVersionMultihash: accepted.receipt.current_version_payload_multihash,
    evidenceAddress,
  });
  assert.equal(completed.state, "complete");
  assert.equal(completed.active_version_payload_multihash, accepted.receipt.current_version_payload_multihash);
  assert.equal(completed.evidence_revision_multihash, payloadHash(engine.current.get(evidenceAddress)));

  await assert.rejects(
    verifyProductCorrectionCompletion({
      client: engine.client(),
      targetRef: "hosted-app:somewhere-else",
      packageSet: PACKAGE_SET,
      partition: PARTITION,
      packageName: PACKAGE,
      proposalMultihash: accepted.proposal_multihash,
      currentVersionMultihash: accepted.receipt.current_version_payload_multihash,
      evidenceAddress,
    }),
    /PRODUCT_CORRECTION_EVIDENCE_DOES_NOT_MATCH_ACTIVE_CHANGE/,
  );

  plan.record_writes[0] = recordWrite(A_RECORD, Buffer.from("a later accepted revision"));
  const later = await makeOnePackageMatchItsSource({
    packageSetFolder: folder,
    packageName: PACKAGE,
    packageLoader: import.meta.filename,
    client: engine.client(),
    execFileAsync: async () => ({ stdout: JSON.stringify(plan) }),
  });
  assert.notEqual(later.receipt.current_version_payload_multihash, accepted.receipt.current_version_payload_multihash);
  await assert.rejects(
    verifyProductCorrectionCompletion({
      client: engine.client(),
      targetRef,
      packageSet: PACKAGE_SET,
      partition: PARTITION,
      packageName: PACKAGE,
      proposalMultihash: accepted.proposal_multihash,
      currentVersionMultihash: accepted.receipt.current_version_payload_multihash,
      evidenceAddress,
    }),
    /PRODUCT_CORRECTION_ACTIVE_VERSION_MISMATCH/,
  );
});

test("a preview result cannot certify a target that still runs the old package revision", async () => {
  const engine = new FakeEngine();
  const evidenceAddress = "product-correction-evidence::preview";
  engine.current.set(evidenceAddress, liveEntry(Buffer.from(JSON.stringify({
    schema: PRODUCT_CORRECTION_EVIDENCE_SCHEMA,
    outcome: "passed",
