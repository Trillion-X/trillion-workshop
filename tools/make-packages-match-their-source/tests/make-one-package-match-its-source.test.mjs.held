test("an obsolete ownership chain retracts each live address exactly once", () => {
  const plan = sourcePlan();
  const metadataForB = metadataWrite(B_METADATA, B_RECORD);
  const chainTail = metadataWrite(REACTIVE_METADATA, B_METADATA);
  const liveInventory = {
    currentVersion: { payload_multihash: "1f:old-version" },
    currentVersionRecord: {
      schema: "bitfield.package_current_version/v1",
      package_set: PACKAGE_SET,
      partition: PARTITION,
      package_ref: PACKAGE,
      records: [
        {
          record_address_wire_hex: B_METADATA,
          metadata_address_wire_hex: REACTIVE_METADATA,
          path_labels: [],
        },
        {
          record_address_wire_hex: B_RECORD,
          metadata_address_wire_hex: B_METADATA,
          path_labels: ["old-record"],
        },
      ],
    },
    currentByWireHex: new Map([
      [B_RECORD, {
        payload_multihash: hashCodeHexFromBytes(Buffer.from("old record")),
        payload_base64: Buffer.from("old record").toString("base64"),
        path_labels: ["old-record"],
      }],
      [B_METADATA, {
        payload_multihash: hashCodeHexFromBytes(Buffer.from(metadataForB.payload_base64, "base64")),
        payload_base64: metadataForB.payload_base64,
        path_labels: ["package-record-source-metadata"],
      }],
      [REACTIVE_METADATA, {
        payload_multihash: hashCodeHexFromBytes(Buffer.from(chainTail.payload_base64, "base64")),
        payload_base64: chainTail.payload_base64,
        path_labels: ["package-record-source-metadata"],
      }],
    ]),
    adoptingUnversionedSourceRecords: false,
  };

  const request = buildPackageDeltaRequest({
    packageSet: PACKAGE_SET,
    partition: PARTITION,
    packageName: PACKAGE,
    preparedPlan: plan,
    liveInventory,
  });
  const tombstones = request.operations.filter((operation) => operation.successor.state === "tombstone");
  assert.deepEqual(
    tombstones.map((operation) => operation.address_wire_hex).sort(),
    [B_RECORD, B_METADATA, REACTIVE_METADATA].sort(),
  );
  assert.equal(tombstones.filter((operation) => operation.address_wire_hex === B_METADATA).length, 1);
  assert.deepEqual(packageOperation(request, B_METADATA).path_labels, []);
});

