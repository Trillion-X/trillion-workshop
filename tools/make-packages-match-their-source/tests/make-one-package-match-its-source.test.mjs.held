  })), ["product-correction-evidence"]));
  await assert.rejects(
    verifyProductCorrectionCompletion({
      client: engine.client(),
      targetRef: "installed-app:fixture",
      packageSet: PACKAGE_SET,
      partition: PARTITION,
      packageName: PACKAGE,
      proposalMultihash: `1f:${"a".repeat(64)}`,
      currentVersionMultihash: `1f:${"b".repeat(64)}`,
      evidenceAddress,
    }),
    /PRODUCT_CORRECTION_ACTIVE_VERSION_MISMATCH/,
  );
});

test("a package plus package-set DATA correction cannot complete in a half-active state", async () => {
  const plan = sourcePlan();
  const engine = new FakeEngine();
  const accepted = await makeOnePackageMatchItsSource({
    packageSetFolder: await identityFolder(),
    packageName: PACKAGE,
    packageLoader: import.meta.filename,
    client: engine.client(),
    execFileAsync: async () => ({ stdout: JSON.stringify(plan) }),
  });
  const dataPackage = "package-set-records";
  const dataProposal = `1f:${"d".repeat(64)}`;
  const dataVersionLabel = packageCurrentVersionAddressLabel(PARTITION, dataPackage);
  const dataVersion = liveEntry(Buffer.from(JSON.stringify({
    schema: "bitfield.package_current_version/v1",
    package_set: PACKAGE_SET,
    partition: PARTITION,
    package_ref: dataPackage,
    proposal_multihash: dataProposal,
    previous_version_payload_multihash: null,
    records: [],
  })), ["package-current-version", PACKAGE_SET, dataPackage]);
  const changes = [
    {
      packageSet: PACKAGE_SET,
      partition: PARTITION,
      packageName: PACKAGE,
      proposalMultihash: accepted.proposal_multihash,
      currentVersionMultihash: accepted.receipt.current_version_payload_multihash,
    },
    {
      packageSet: PACKAGE_SET,
      partition: PARTITION,
      packageName: dataPackage,
      proposalMultihash: dataProposal,
      currentVersionMultihash: payloadHash(dataVersion),
    },
  ];
  const evidenceAddress = "product-correction-evidence::mixed";
  await assert.rejects(
    verifyProductCorrectionChangeSetCompletion({
      client: engine.client(),
      targetRef: "installed-app:fixture",
      changes,
      evidenceAddress,
    }),
    /PRODUCT_CORRECTION_CHANGE_SET_INCOMPLETE:package-set-records/,
  );

  engine.current.set(dataVersionLabel, dataVersion);
  const activeChanges = changes.map((change) => ({
    package_set: change.packageSet,
    partition: change.partition,
    package_ref: change.packageName,
    proposal_multihash: change.proposalMultihash,
    active_version_payload_multihash: change.currentVersionMultihash,
  }));
  engine.current.set(evidenceAddress, liveEntry(Buffer.from(JSON.stringify({
    schema: PRODUCT_CORRECTION_EVIDENCE_SCHEMA,
    outcome: "passed",
    target_ref: "installed-app:fixture",
    active_changes: activeChanges,
    result_multihash: `1f:${"e".repeat(64)}`,
  })), ["product-correction-evidence"]));
  const completed = await verifyProductCorrectionChangeSetCompletion({
    client: engine.client(),
    targetRef: "installed-app:fixture",
    changes,
    evidenceAddress,
  });
  assert.equal(completed.state, "complete");
  assert.deepEqual(completed.active_changes.map((change) => change.package_ref), [PACKAGE, dataPackage]);
});

test("source retractions apply through the same atomic package delta without a second approval", async () => {
  const folder = await identityFolder();
  const plan = sourcePlan([
    recordWrite(A_RECORD),
    metadataWrite(A_METADATA),
    recordWrite(B_RECORD),
    metadataWrite(B_METADATA, B_RECORD),
  ]);
  const engine = new FakeEngine();
  const invoke = {
    packageSetFolder: folder,
    packageName: PACKAGE,
    packageLoader: import.meta.filename,
    client: engine.client(),
    execFileAsync: async () => ({ stdout: JSON.stringify(plan) }),
  };
  await makeOnePackageMatchItsSource(invoke);
  const afterFirst = engine.packageDeltaCount;

  // The source stops owning B, so convergence removes the source-owned rows in the same
  // atomic request. Exact package ownership and predecessor bases are the safety boundary.
  plan.record_writes = plan.record_writes.filter(
    (write) => write.address_label !== B_RECORD && write.address_label !== B_METADATA,
  );

  const converged = await makeOnePackageMatchItsSource(invoke);
  assert.equal(converged.outcome, "applied");
  assert.equal(converged.stats.retract_count, 2);
  assert.equal(engine.packageDeltaCount, afterFirst + 1);
  assert.equal(engine.current.has(B_RECORD), false);
  assert.equal(engine.current.has(B_METADATA), false);
});

test("matching source and live folds return source-already-current without another delta", async () => {
  const folder = await identityFolder();
  const plan = sourcePlan();
  const engine = new FakeEngine();
  const invoke = {
    packageSetFolder: folder,
    packageName: PACKAGE,
    packageLoader: import.meta.filename,
    client: engine.client(),
    execFileAsync: async () => ({ stdout: JSON.stringify(plan) }),
  };
  await makeOnePackageMatchItsSource(invoke);
  const before = engine.packageDeltaCount;
  const second = await makeOnePackageMatchItsSource(invoke);
  assert.equal(second.outcome, "source-already-current");
  assert.equal(second.stats.unchanged_count, 2);
  assert.equal(engine.packageDeltaCount, before);
});

test("canonical dry-run previews the exact checkout delta without applying it", async () => {
  const folder = await identityFolder();
  const plan = sourcePlan();
  const engine = new FakeEngine();
  const report = await makeOnePackageMatchItsSource({
    packageSetFolder: folder,
    packageName: PACKAGE,
    packageLoader: import.meta.filename,
    client: engine.client(),
    execFileAsync: async () => ({ stdout: JSON.stringify(plan) }),
    dryRun: true,
  });
  assert.equal(report.outcome, "canonical-source-delta-preview");
  assert.equal(report.stats.create_count, 2);
  assert.deepEqual(report.differences.map((row) => row.action), ["create", "create"]);
  assert.equal(engine.packageDeltaCount, 0);
});

test("removed source rows become explicit paired tombstones in one atomic request", async () => {
  const plan = sourcePlan([
    recordWrite(A_RECORD),
    metadataWrite(A_METADATA),
    recordWrite(B_RECORD),
    metadataWrite(B_METADATA, B_RECORD),
  ]);
  const engine = new FakeEngine();
  await seedLivePackage(engine, plan);
  plan.record_writes = plan.record_writes.filter((write) => write.address_label !== B_RECORD && write.address_label !== B_METADATA);
  const inventory = await inventoryLivePackage({
    client: engine.client(),
    packageSet: PACKAGE_SET,
    partition: PARTITION,
    packageName: PACKAGE,
    preparedPlan: plan,
  });
  const request = buildPackageDeltaRequest({
    packageSet: PACKAGE_SET,
    partition: PARTITION,
    packageName: PACKAGE,
    preparedPlan: plan,
    liveInventory: inventory,
  });
  assert.equal(packageOperation(request, B_RECORD).successor.state, "tombstone");
  assert.equal(packageOperation(request, B_METADATA).successor.state, "tombstone");
  assert.equal(packageDeltaStats(request).retract_count, 2);
});

test("no-retraction apply refuses changed source before any live package delta", async () => {
  const prior = sourcePlan([
    recordWrite(A_RECORD), metadataWrite(A_METADATA),
    recordWrite(B_RECORD), metadataWrite(B_METADATA, B_RECORD),
  ]);
  const engine = new FakeEngine();
  await seedLivePackage(engine, prior);
  const updated = sourcePlan([recordWrite(A_RECORD), metadataWrite(A_METADATA)]);
  await assert.rejects(makeOnePackageMatchItsSource({
    packageSetFolder: await identityFolder(), packageName: PACKAGE,
    packageLoader: import.meta.filename, client: engine.client(),
    execFileAsync: async () => ({ stdout: JSON.stringify(updated) }),
    onlyIfNoRetractions: true,
  }), /PACKAGE_DELTA_RETRACTIONS_REFUSED:alpha:2/);
  assert.equal(engine.packageDeltaCount, 0);
  assert.ok(engine.current.has(B_RECORD));
});

test("declared live DATA survives an implementation update byte-for-byte", async () => {
  const retainedPath = ["prop:observed_content:source_descriptor"];
  const prior = sourcePlan([
    recordWrite(A_RECORD), metadataWrite(A_METADATA),
    recordWrite(B_RECORD, Buffer.from("private source configuration")),
    metadataWrite(B_METADATA, B_RECORD, `package::${PACKAGE}::source::legacy`, retainedPath),
  ]);
  const engine = new FakeEngine();
  await seedLivePackage(engine, prior);
  const beforeRecord = engine.current.get(B_RECORD);
  const beforeMetadata = engine.current.get(B_METADATA);
  const updated = sourcePlan([recordWrite(A_RECORD, Buffer.from("changed implementation")), metadataWrite(A_METADATA)]);
  const folder = await identityFolder();
  await writeRetainedPolicy(folder, [retainedPath]);

  const preview = await makeOnePackageMatchItsSource({
    packageSetFolder: folder, packageName: PACKAGE, packageLoader: import.meta.filename,
    client: engine.client(), execFileAsync: async () => ({ stdout: JSON.stringify(updated) }), dryRun: true,
  });
  assert.equal(preview.stats.retract_count, 0);
  assert.equal(preview.stats.retained_live_data_count, 1);
  assert.equal(engine.packageDeltaCount, 0);

  const result = await makeOnePackageMatchItsSource({
    packageSetFolder: folder, packageName: PACKAGE, packageLoader: import.meta.filename,
    client: engine.client(), execFileAsync: async () => ({ stdout: JSON.stringify(updated) }),
  });
  assert.equal(result.stats.retract_count, 0);
  assert.equal(engine.current.get(B_RECORD), beforeRecord);
  assert.equal(engine.current.get(B_METADATA), beforeMetadata);
  assert.ok(engine.lastPackageDeltaRequest.ownership_proofs.some((proof) => proof.record_address_wire_hex === B_RECORD));
});

test("retention policy cannot protect implementation paths or duplicate data paths", async () => {
  const folder = await identityFolder();
