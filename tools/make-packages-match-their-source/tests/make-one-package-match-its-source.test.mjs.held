test("explicit adoption creates ownership for source rows and preserves unknown orphan rows", async () => {
  const plan = sourcePlan();
  const engine = new FakeEngine();
  const originalRecord = Buffer.from(plan.record_writes[0].payload_base64, "base64");
  const originalMetadata = Buffer.from(plan.record_writes[1].payload_base64, "base64");
  engine.current.set(A_RECORD, liveEntry(originalRecord, plan.record_writes[0].path_labels));
  engine.current.set(A_METADATA, liveEntry(originalMetadata, plan.record_writes[1].path_labels));
  engine.current.set(B_RECORD, liveEntry(Buffer.from("unrelated orphan"), ["unknown-product", "row"]));

  const result = await makeOnePackageMatchItsSource({
    packageSetFolder: await identityFolder(),
    packageName: PACKAGE,
    packageLoader: import.meta.filename,
    client: engine.client(),
    execFileAsync: async () => ({ stdout: JSON.stringify(plan) }),
    adoptUnversionedSourceRecords: true,
  });

  assert.equal(result.outcome, "applied");
  assert.equal(result.adopted_unversioned_source_records, true);
  assert.equal(result.stats.retract_count, 0);
  assert.equal(result.stats.update_count, 0);
  assert.equal(result.stats.unchanged_count, 2);
  assert.equal(engine.lastPackageDeltaRequest.operations.length, 0);
  assert.ok(engine.current.has(B_RECORD), "an address absent from source must remain untouched");
  const version = JSON.parse(engine.current.get(VERSION_LABEL).payload_base64.toString("utf8"));
  assert.deepEqual(version.records.map((record) => record.record_address_wire_hex), [A_RECORD]);
});

test("live-ownership-only adoption versions divergent live bytes without applying desired source", async () => {
  const canonicalMetadata = metadataAddressWireHexForRecord(A_RECORD);
  const plan = sourcePlan([recordWrite(A_RECORD), metadataWrite(canonicalMetadata)]);
  const liveRecord = Buffer.from("live content differs from current source");
  const liveMetadata = Buffer.from(plan.record_writes[1].payload_base64, "base64");
  const engine = new FakeEngine({ scanEntries: [{
    address: canonicalMetadata,
    payload: JSON.parse(liveMetadata.toString("utf8")),
  }] });
  engine.current.set(A_RECORD, liveEntry(liveRecord, plan.record_writes[0].path_labels));
  engine.current.set(canonicalMetadata, liveEntry(liveMetadata, plan.record_writes[1].path_labels));
  const input = {
    packageSetFolder: await identityFolder(),
    packageName: PACKAGE,
    packageLoader: import.meta.filename,
    client: engine.client(),
    execFileAsync: async () => ({ stdout: JSON.stringify(plan) }),
    adoptLiveOwnershipOnly: true,
  };
  const preview = await makeOnePackageMatchItsSource({ ...input, dryRun: true });
  assert.equal(preview.outcome, "live-ownership-adoption-preview");
  assert.equal(preview.live_owned_pair_count, 1);
  assert.deepEqual(preview.differences, []);
  const result = await makeOnePackageMatchItsSource(input);
  assert.equal(result.adopted_live_ownership_only, true);
  assert.deepEqual(engine.lastPackageDeltaRequest.operations, []);
  assert.deepEqual(engine.current.get(A_RECORD).payload_base64, liveRecord);
  assert.deepEqual(engine.current.get(canonicalMetadata).payload_base64, liveMetadata);
  assert.ok(engine.current.has(VERSION_LABEL));
});

test("one package-set record set updates without retiring another set's live ownership", () => {
  const selectedMetadata = metadataWrite(A_METADATA);
  const selected = JSON.parse(Buffer.from(selectedMetadata.payload_base64, "base64").toString("utf8"));
  selected.source_package = "package-set-records";
  selected.source_address = "package-set-records::selected";
  selectedMetadata.payload_base64 = Buffer.from(JSON.stringify(selected)).toString("base64");
  const otherMetadata = metadataWrite(B_METADATA, B_RECORD);
  const other = JSON.parse(Buffer.from(otherMetadata.payload_base64, "base64").toString("utf8"));
  other.source_package = "package-set-records";
  other.source_address = "package-set-records::other";
  otherMetadata.payload_base64 = Buffer.from(JSON.stringify(other)).toString("base64");
  const desired = {
    ...sourcePlan([recordWrite(A_RECORD, Buffer.from("selected new")), selectedMetadata]),
    package_name: "package-set-records",
  };
  const current = new Map([
    [A_RECORD, { payload_multihash: hashCodeHexFromBytes(Buffer.from("selected old")), path_labels: recordWrite(A_RECORD).path_labels }],
    [A_METADATA, { payload_multihash: hashCodeHexFromBytes(Buffer.from(selectedMetadata.payload_base64, "base64")), payload_base64: selectedMetadata.payload_base64 }],
    [B_RECORD, { payload_multihash: hashCodeHexFromBytes(Buffer.from("other unchanged")), path_labels: recordWrite(B_RECORD).path_labels }],
    [B_METADATA, { payload_multihash: hashCodeHexFromBytes(Buffer.from(otherMetadata.payload_base64, "base64")), payload_base64: otherMetadata.payload_base64 }],
  ]);
  const request = buildPackageDeltaRequest({
    packageSet: PACKAGE_SET, partition: PARTITION, packageName: "package-set-records",
    selectedRecordSet: "selected", preparedPlan: desired,
    liveInventory: {
      currentByWireHex: current,
      currentVersion: { payload_multihash: "1f:old-version" },
      ownedRecords: [
        { record_address_wire_hex: A_RECORD, metadata_address_wire_hex: A_METADATA, path_labels: recordWrite(A_RECORD).path_labels },
        { record_address_wire_hex: B_RECORD, metadata_address_wire_hex: B_METADATA, path_labels: recordWrite(B_RECORD).path_labels },
      ],
    },
  });
  assert.deepEqual(request.operations.map((operation) => operation.address_wire_hex), [A_RECORD]);
  assert.deepEqual(request.ownership_proofs.map((proof) => proof.record_address_wire_hex), [A_RECORD, B_RECORD]);
});

test("legacy version inventory cannot become the canonical version basis", async () => {
  const originalPlan = sourcePlan();
  const engine = new FakeEngine();
  await seedLivePackage(engine, originalPlan);
  const legacyLabel = `package-current-version::${PACKAGE_SET}::${PARTITION}::${PACKAGE}`;
  engine.current.set(legacyLabel, engine.current.get(VERSION_LABEL));
  engine.current.delete(VERSION_LABEL);
