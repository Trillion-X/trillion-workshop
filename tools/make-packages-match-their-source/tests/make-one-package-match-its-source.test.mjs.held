  assert.deepEqual(engine.lastPackageDeltaRequest.operations.map((operation) => operation.address_wire_hex), [A_RECORD]);
  assert.ok(engine.current.has(legacyLabel), "legacy ownership evidence remains readable");
  assert.ok(engine.current.has(VERSION_LABEL), "the native owner publishes the canonical version");
});

