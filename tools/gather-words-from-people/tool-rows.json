      "row_id": {
       "type": "string",
       "minLength": 1
      },
      "decision": {
       "type": "string",
       "enum": [
        "approve",
        "decline",
        "withdraw"
       ]
      },
      "reviewed_words": {
       "type": "string",
       "description": "The words exactly as the reviewer read them; required to approve"
      }
     }
    },
