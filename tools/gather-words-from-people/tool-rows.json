    },
    "id": "tool:ask-people-for-words",
    "label": "Ask people for their words",
    "job": "Ask people, each after their own good word, to say in their own words how it went, keeping one asked row per person for a case",
    "description": "Writes one asked row in the list for each person who may be asked, and returns each person's draft ({to, subject, body}) from the words the list's gathers.ask holds, with {name} filled in. Sends nothing: the draft goes out through a sending tool the person chose. A person is asked once for a case (the same person and case is skipped as already_asked), and only with `win`, a reference to the person's own positive word that made this the time to ask (otherwise skipped as no_win). The address is in the draft only, never in the kept row. Returns asked ({row_id, person, draft}) and skipped ({person, reason}).",
    "input_schema": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "list",
      "type",
      "case",
      "people"
     ],
     "properties": {
      "list": {
       "type": "string",
       "minLength": 1,
       "description": "The list's id, such as list:praise. Its definition must hold a `gathers` block."
      },
      "type": {
       "type": "string",
       "minLength": 1,
       "description": "The list's row type as record:<row_type>, such as record:praise. It must be the list's own."
      },
      "case": {
       "type": "string",
       "minLength": 1,
       "description": "What the asking is about, such as an order or a course: one ask per person per case"
      },
      "people": {
       "type": "array",
       "minItems": 1,
       "maxItems": 256,
       "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
         "id",
         "name"
        ],
        "properties": {
         "id": {
          "type": "string",
          "minLength": 1,
          "description": "Who the person is in the person's own records"
         },
         "name": {
          "type": "string",
          "minLength": 1
         },
         "address": {
          "type": "string",
          "description": "Where the draft goes; kept out of the row"
         },
         "win": {
          "type": "string",
          "description": "The reference to their own positive word, such as a message id or a record id"
         }
        }
       }
      },
      "now": {
       "type": "string",
       "format": "date-time",
       "description": "When they were asked (default: now)"
      }
     }
    },
    "output_schema": {
     "type": "object",
     "description": "{ asked: [{ row_id, person, draft }], skipped: [{ person, reason }] }"
    },
    "invoke": {
     "kind": "container",
     "files": {
      "package_files": [
       {
