 "kind": "tool-rows",
 "record_set": "gather-words-from-people-tool-rows",
 "what_this_is": "The Workshop rows for gathering words from people into an ordinary list in tools/gather-words-from-people: ask, keep with consent, approve exactly as reviewed, and read back what may be shown.",
 "records": [
  {
   "payload": {
