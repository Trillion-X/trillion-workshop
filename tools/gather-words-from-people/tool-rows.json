    "id": "tool:keep-the-words-a-person-gave",
    "label": "Keep the words a person gave",
    "job": "Keep the words a person gave in reply, with the consent they gave and the words that gave it, as a received row of the list",
    "description": "Keeps words with one of the consents the list declares and consent_note, the person's own words that gave it (or where they are). With row_id it fills the row that asked them; without it, `who` is required and the words become their own row, the same words from the same person always the same row. Sets the row to received and takes away any approval, so changed words are reviewed again. A withdrawn row takes no more words. The same call again changes nothing. Returns row_id, status and changed.",
    "input_schema": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "list",
      "type",
      "words",
      "consent",
      "consent_note"
     ],
     "properties": {
      "list": {
       "type": "string",
       "minLength": 1,
       "description": "The list's id, such as list:praise. Its definition must hold a `gathers` block."
      },
      "type": {
       "type": "string",
       "minLength": 1,
       "description": "The list's row type as record:<row_type>, such as record:praise. It must be the list's own."
      },
      "row_id": {
       "type": "string",
       "description": "The row that asked them"
      },
      "who": {
       "type": "string",
       "description": "The speaker, when no row asked them"
      },
      "words": {
       "type": "string",
       "minLength": 1,
       "description": "Their words, exactly as they gave them"
      },
      "consent": {
       "type": "string",
       "minLength": 1,
       "description": "One of the list's consent ids"
      },
      "consent_note": {
       "type": "string",
       "minLength": 1,
       "description": "Their own words that gave this consent, or where they are kept"
      }
     }
    },
    "output_schema": {
     "type": "object",
     "description": "{ row_id, status, changed }"
    },
