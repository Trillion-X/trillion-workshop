{
  "start_here": "Say to your AI: \"Read the words on list:praise that I may show on my cake page.\" It runs tool:read-words-that-may-show and hands back only the approved words whose consent allows showing and that have not changed since you approved them.",
  "lists": [
    {
      "list": "list:praise",
      "label": "Praise",
      "row_type": "record:praise",
      "holds": "One row per person asked for their own words about a case: the words, the consent they gave, the reason it was the time to ask and where the row stands (asked, received, approved, declined or withdrawn).",
      "fields": [
        {
          "id": "words",
          "kind": "long-text",
          "label": "Words",
          "alike": [
            "quote",
            "testimonial",
            "comment",
            "feedback"
          ]
        },
        {
          "id": "who",
          "kind": "text",
          "label": "Speaker",
          "alike": [
            "name",
            "said by",
            "author"
          ]
        },
        {
          "id": "person",
          "kind": "text",
          "label": "Person id",
          "alike": [
            "customer id",
            "contact id"
          ]
        },
        {
          "id": "consent",
          "kind": "choice",
          "label": "Consent",
          "alike": [
            "permission",
            "okay to show"
          ]
        },
        {
          "id": "consent_note",
          "kind": "long-text",
          "label": "Consent note",
          "alike": [
            "permission note",
            "how they agreed"
          ]
        },
        {
          "id": "status",
          "kind": "choice",
          "label": "State",
          "alike": [
            "stage",
            "progress"
          ]
        },
        {
          "id": "case",
          "kind": "text",
          "label": "Case",
          "alike": [
            "order",
            "project",
            "course"
          ]
        },
        {
          "id": "win",
          "kind": "text",
          "label": "Positive word",
          "alike": [
            "good word",
            "reason to ask",
            "win reference"
          ]
        },
        {
          "id": "asked_at",
          "kind": "date",
          "label": "Asked at",
          "alike": [
            "date asked",
            "requested on"
          ]
        },
        {
          "id": "approved_identity",
          "kind": "text",
          "label": "Approved identity",
          "alike": [
            "approval pin",
            "approved hash"
          ]
        }
      ],
      "example_rows": [
        {
          "id": "cake-sam",
          "values": {
            "words": "The cake was the best part of the day.",
            "who": "Sam Example",
            "person": "p1",
            "consent": "first-name",
