            "person": "p2",
            "status": "asked",
            "case": "cake-2026",
            "win": "message:made-up-2",
            "asked_at": "2026-11-12"
          }
        }
      ],
      "alike": [
        "a testimonials spreadsheet",
        "the reviews list in a help desk",
        "a Notion table of customer quotes"
      ]
    }
  ],
  "workflows": [],
  "tools": [
    "tool:read-words-that-may-show",
    "tool:approve-words-to-show",
    "tool:keep-the-words-a-person-gave",
    "tool:pour-example-rows-into-my-list"
  ],
  "instructions": [
    "1. Pour the two example rows into the testimonials list you already keep (see pour), or make list:praise from the ten fields above and give it a gathers block saying which field is which.",
    "2. Keep each person's words and consent (tool:keep-the-words-a-person-gave), then approve the ones you have read (tool:approve-words-to-show), so a row is approved and pinned.",
    "3. Say \"Read the words on list:praise that I may show\". The AI reads the list's definition and rows from your store, passes them, and may pass limit to keep the first items.",
    "4. Read items (heading, body, row_id) and shown, may_show_total and held_back: a row left out is counted by its reason (not_approved, changed_since_approved or consent_does_not_allow_showing), never returned."
  ],
