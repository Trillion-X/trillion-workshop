  "pour": {
    "tool": "tool:pour-example-rows-into-my-list",
    "least_coverage": 0.8,
    "how": "Name the testimonials list you already keep and its fields. The tool matches each of the ten fields of list:praise to one of yours (the map you give, the same id, the same label, or a name in alike), refuses when fewer than 80% match, and otherwise answers the keep rows that add the two example rows to your list. The list also needs its own gathers block (which field holds the words, the speaker, the consent and the state, the consents and what each state is called) before these tools take it.",
    "example": {
      "kit_list": "list:praise",
      "into": {
        "list": "list:testimonials",
        "row_type": "record:testimonial",
        "fields": [
