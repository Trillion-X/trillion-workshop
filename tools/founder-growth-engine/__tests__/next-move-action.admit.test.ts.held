import { describe, expect, it } from '../../../test-helpers/vitest-shim.mjs';
import { readFileSync } from 'node:fs';
import { fileURLToPath } from 'node:url';
import path from 'node:path';

const PKG = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '..');
const parsed = JSON.parse(readFileSync(path.join(PKG, 'things-to-store-and-run.json'), 'utf8'));
const things = parsed.things as any[];

const ACTION_ID = 'action:score-and-rank-next-moves';
const ACTION_ADDRESS = 'package::founder-growth-engine::workflow-action::score-and-rank-next-moves';

const byAddress = (address: string) => things.find((thing) => thing.address === address);
const action = byAddress(ACTION_ADDRESS)?.payload;

const actionFact = (prop: string) => {
  const record = byAddress(`attribute_fact|${ACTION_ID}|prop:action:${prop}|type:action`);
  if (!record) return undefined;
  const decoded = record.payload_base64
    ? JSON.parse(Buffer.from(record.payload_base64, 'base64').toString('utf8'))
    : record.payload;
  return { record, decoded };
};

const readPath = (source: any, dottedPath?: string) => {
  if (!dottedPath) return source;
  return dottedPath.split('.').reduce((value, key) => {
    if (value == null) return null;
    return Object.prototype.hasOwnProperty.call(value, key) ? value[key] : null;
  }, source);
};

const evalBinding = (binding: any, facts: any): number | null => {
  const selected = binding?.select?.from === 'literal'
    ? binding.select.value
    : readPath(facts, binding?.select?.path);
  let value = selected ?? null;

  for (const transform of binding?.transform ?? []) {
    const op = transform.op;
    const args = transform.args ?? {};
    if (op === 'op:core.multiply') {
      const values = args.values.map((arg: any) => evalValue(arg, facts));
      value = values.some((v: any) => v == null || !Number.isFinite(v))
        ? null
        : values.reduce((product: number, n: number) => product * n, 1);
    } else if (op === 'op:core.divide') {
      const numerator = evalValue(args.numerator, facts);
      const denominator = evalValue(args.denominator, facts);
      value = numerator == null || denominator == null || denominator === 0
        ? null
        : numerator / denominator;
    } else if (op === 'op:core.add') {
      const values = args.values.map((arg: any) => evalValue(arg, facts));
      value = values.some((v: any) => v == null || !Number.isFinite(v))
        ? null
        : values.reduce((sum: number, n: number) => sum + n, 0);
    } else {
      throw new Error(`Unhandled test op ${op}`);
    }
  }

  return value == null || !Number.isFinite(value) ? null : value;
};

const evalValue = (value: any, facts: any): any => {
  if (value?.$kind === 'binding') return evalBinding(value, facts);
  return value;
};

const scoreCandidate = (candidate: any, facts: any) => evalBinding(candidate.score_formula, facts);

const PROVEN_STEP_KINDS = new Set(['action', 'ask', 'loop', 'read', 'return', 'write']);

const flattenSteps = (steps: any[]): any[] => steps.flatMap((step) => [
  step,
  ...(Array.isArray(step?.config?.steps) ? flattenSteps(step.config.steps) : []),
]);

const decodedWorkflowSteps = () => {
  const valueJson = actionFact('workflow_steps')?.decoded.value_json;
  expect(typeof valueJson).toBe('string');
  return JSON.parse(valueJson);
};

describe('D1 next-move score-and-rank action admit contract', () => {
  it('parses and registers the action with the required entity/entity_types/attribute_fact trio', () => {
    expect(Array.isArray(things)).toBe(true);
    expect(action?.id).toBe(ACTION_ID);
    expect(action?.kind).toBe('action');
    expect(action?.is_active).toBe(true);
    expect(byAddress(`entity|${ACTION_ID}`)?.payload).toEqual({ table: 'entity', id: ACTION_ID });
    expect(byAddress(`entity_types|${ACTION_ID}|type:action`)?.payload).toEqual({
      table: 'entity_types',
      entity_id: ACTION_ID,
      type_id: 'type:action',
    });

    for (const prop of ['description', 'is_active', 'slug', 'workflow_steps']) {
      const fact = actionFact(prop);
      expect(fact?.decoded).toMatchObject({
        table: 'attribute_fact',
        subject_id: ACTION_ID,
        property_id: `prop:action:${prop}`,
        type_id: 'type:action',
      });
      if (prop !== 'workflow_steps') {
        expect(fact?.record).not.toHaveProperty('payload_base64');
        expect(fact?.record?.remove).toBe(false);
      }
    }
  });

  it('stores a loop-DAG that finds candidates/facts, loops per candidate, and asks formula-engine from candidate.score_formula DATA', () => {
    const decodedSteps = decodedWorkflowSteps();

    expect(action.steps).toEqual(decodedSteps);
    expect(decodedSteps[0]).toMatchObject({
      id: 'find_candidates',
      kind: 'ask',
      config: {
        name: 'slot::find-current-items',
        input: {
          operation: 'find-current-items',
          in: 'published-record',
          where: { all: [{ field: 'kind', in: ['next-move-candidate'] }] },
        },
      },
    });
    expect(decodedSteps[1]).toMatchObject({
      id: 'find_facts',
      kind: 'ask',
      config: {
        name: 'slot::find-current-items',
        input: {
          operation: 'find-current-items',
          in: 'published-record',
          where: { all: [{ field: 'kind', in: ['next-move-input'] }] },
        },
      },
    });

    const loop = decodedSteps.find((step: any) => step.kind === 'loop');
    expect(loop?.config.source.select).toEqual({ from: 'steps', key: 'find_candidates', path: 'output.items' });
    expect(loop?.config.item_var).toBe('candidate');
    expect(loop?.config.definition_id).toBe('action:founder-growth-engine.score-one-next-move');
    const oneCandidateAction = byAddress(
      'package::founder-growth-engine::workflow-action::score-one-next-move',
    )?.payload;
    const ask = oneCandidateAction.steps.find((step: any) => step.kind === 'ask');
    expect(ask.config.name).toBe('slot::formula-engine');
    expect(ask.config.input.binding.select).toEqual({ from: 'input', path: 'candidate.score_formula' });
    expect(JSON.stringify(ask)).not.toMatch(/ltv|cac|revenue|margin/i);

    const write = oneCandidateAction.steps.find((step: any) => step.kind === 'write');
    const payload = write.config.items[0].payload;
    expect(payload).toHaveProperty('health.severity');
    expect(payload.score.select).toEqual({ from: 'steps', key: 'score', path: 'output.result' });
    expect(payload.verdict.select).toEqual({ from: 'steps', key: 'verdict', path: 'output.result' });
    expect(payload.health.severity.select).toEqual({
      from: 'steps',
      key: 'severity',
      path: 'output.result',
    });
  });

  it('admits only live-proven workflow step grammar', () => {
    const decodedSteps = decodedWorkflowSteps();

    for (const step of flattenSteps(decodedSteps)) {
      expect(PROVEN_STEP_KINDS.has(step.kind), `unproven step kind ${step.kind}`).toBe(true);

      if (step.kind === 'read') {
        expect(typeof step.config?.from, `read step ${step.id ?? '<anonymous>'} must use config.from`).toBe('string');
        expect(step.config.from.length).toBeGreaterThan(0);
        expect(step.config).not.toHaveProperty('input');
        expect(step.config).not.toHaveProperty('as');
      }

      if (step.kind === 'ask' && step.config?.name === 'slot::find-current-items') {
        expect(step.config.input).toMatchObject({
          operation: 'find-current-items',
          in: 'published-record',
        });
        expect(step.config.input.where).toHaveProperty('all');
      }
    }
  });

  it('golden: computes an exact score from a candidate formula and preserves missing input as null', () => {
    const facts = { sessions: 12, conversion_rate: 0.25 };
    const candidate = {
      candidate_id: 'golden',
      score_formula: {
        $kind: 'binding',
        select: { from: 'literal', value: null },
        transform: [{
          op: 'op:core.multiply',
          args: {
            values: [
              { $kind: 'binding', select: { from: 'input', path: 'sessions' } },
              { $kind: 'binding', select: { from: 'input', path: 'conversion_rate' } },
              10,
            ],
          },
        }],
      },
    };
    const missing = {
      ...candidate,
      score_formula: {
        $kind: 'binding',
        select: { from: 'input', path: 'missing_metric' },
      },
    };

    expect(scoreCandidate(candidate, facts)).toBe(30);
    expect(scoreCandidate(missing, facts)).toBeNull();
  });

  it('adversarial: divide by a missing denominator returns null, never NaN, Infinity, or 0', () => {
    const score = scoreCandidate({
      candidate_id: 'bad-denominator',
      score_formula: {
        $kind: 'binding',
        select: { from: 'literal', value: null },
        transform: [{
          op: 'op:core.divide',
          args: {
            numerator: { $kind: 'binding', select: { from: 'input', path: 'revenue' } },
            denominator: { $kind: 'binding', select: { from: 'input', path: 'missing_cost' } },
          },
        }],
      },
    }, { revenue: 500 });

    expect(score).toBeNull();
    expect(score).not.toBe(0);
    expect(Number.isNaN(score)).toBe(false);
  });
});
