import { readFileSync } from 'node:fs';
import path from 'node:path';
import { fileURLToPath } from 'node:url';

import { describe, expect, it } from 'vitest';

import { buildFounderGrowthVisualDatabaseProjection } from '@/packages/founder-growth-engine-screens/read-data/visual-database-projection';
import { extractFieldValue, groupingDescriptorForView, recordGroupValues, recordsForView } from '@/packages/visual-database/read-data/visual-database';
import { recordSurfaceIntentToOpenSurfaceProps } from '@/packages/ui/show/placeable-surface-intent/record-surface-intent';

const PACKAGES = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '..', '..');
const PACKAGE = 'founder-growth-engine-screens';
const PLACEMENT = 'founder-growth-engine-workspace';

function loadThings(packageName: string): Array<Record<string, any>> {
  return JSON.parse(readFileSync(path.join(PACKAGES, packageName, 'things-to-store-and-run.json'), 'utf8')).things;
}

const things = loadThings(PACKAGE);
const placeable = things.filter((thing) => thing.payload?.kind === 'placeable-surface');
const outer = placeable.find((thing) => thing.payload.id === 'founder-growth-engine.workspace')?.payload;
const children = placeable.filter((thing) => thing.payload.placement_labels?.includes(PLACEMENT));
const visualSurfaces = children.map((thing) => thing.payload).filter((surface) => surface.surface_input?.surfaceKind === 'visual-database');

const fixtures: Record<string, Array<Record<string, unknown>>> = {
  'founder-growth-engine.next-moves': [
    { record: { address: 'move:2' }, payload: { kind: 'founder-growth-engine.next-move', id: 'move-2', fields: { title: 'Publish', rank: 2, status: 'ready', reason: 'Ready now' } } },
    { record: { address: 'move:1' }, payload: { kind: 'founder-growth-engine.next-move', id: 'move-1', fields: { title: 'Finish setup', rank: 1, status: 'needs-you', reason: 'Required first', surface_intent: { title: 'Open setup', packageEntry: { packageName: 'screen-arrangement', entryName: 'workspace-shell' } } } } },
  ],
  'founder-growth-engine.operator-actions': [
    { record: { address: 'operator:1' }, payload: { kind: 'action-intent-receipt', id: 'operator-1', fields: { capability: 'Draft post', dispatch_status: 'draft-only-final', artifact: 'Draft copy' } } },
    { record: { address: 'operator:2' }, payload: { kind: 'action-intent-receipt', id: 'operator-2', fields: { capability: 'Send post', dispatch_status: 'live-sent', artifact: 'Receipt' } } },
  ],
  'founder-growth-engine.content-results': [
    { record: { address: 'result:1' }, payload: { kind: 'founder-growth-engine.content-result', id: 'result-1', fields: { title: 'Post A', status: 'monitoring', detail: 'Collecting data' } } },
    { record: { address: 'result:2' }, payload: { kind: 'founder-growth-engine.content-result', id: 'result-2', fields: { title: 'Post B', status: 'published', detail: 'Live' } } },
  ],
  'founder-growth-engine.distribution': [
    { record: { address: 'attempt:1' }, payload: { kind: 'founder-growth-engine.distribution-attempt', id: 'attempt-1', fields: { title: 'Instagram', status: 'failed', detail: 'Reconnect account' } } },
    { record: { address: 'attempt:2' }, payload: { kind: 'founder-growth-engine.distribution-attempt', id: 'attempt-2', fields: { title: 'Newsletter', status: 'published', detail: 'Sent' } } },
  ],
};

async function derive(_target: string, request: Record<string, unknown>) {
  const classified = request.classify_by_rules as { record: { status?: string }; rules: Array<{ key: string; severity?: string; requires: Array<{ value?: unknown }> }> };
  const match = classified.rules.find((rule) => rule.requires[0]?.value === classified.record.status);
  return { result: match ? { key: match.key, severity: match.severity } : null };
}

describe('Founder Growth Engine workspace surface DATA contract', () => {
  it('publishes one searchable top-level Founder thing through the generic workspace shell', () => {
    expect(outer).toMatchObject({
      label: 'Founder Growth Engine', placement_labels: ['main-workspace'],
      package_entry: { package_name: 'screen-arrangement', entry_name: 'workspace-shell' },
      surface_input: { placement_label: PLACEMENT, layout_state_input: 'layout-state-by-address-label', persistence_address: 'founder-growth-engine-workspace-layout-state' },
    });
    expect(placeable.filter((thing) => thing.payload.placement_labels?.includes('main-workspace'))).toHaveLength(1);
  });

  it('keeps all six child tools and moves every data view to the owner adapter over visual-database', () => {
    expect(children.map((thing) => thing.payload.label)).toEqual(['What to do next', 'What your operator is doing', 'See content results', 'Write a post', 'Distribution', 'Connected services']);
    expect(visualSurfaces).toHaveLength(4);
    for (const surface of visualSurfaces) {
      expect(surface.material_target).toBe('component:visual-database');
      expect(surface.package_entry).toEqual({ package_name: PACKAGE, entry_name: 'visual-database-surface' });
      expect(surface.surface_input).toMatchObject({ surfaceKind: 'visual-database', feedInputName: expect.any(String) });
    }
    const inputAddresses = new Map(
      things
        .filter((thing) => thing.payload?.kind === 'bitfield-input-descriptor')
        .map((thing) => [thing.payload.input_name, thing.payload.value_address_label]),
    );
    expect(inputAddresses).toEqual(new Map([
      ['founder-growth-next-moves-feed', 'package::founder-growth-engine::surface-feed::next-moves'],
      ['founder-growth-operator-activity-feed', 'package::founder-growth-engine::surface-feed::operator-activity'],
      ['founder-growth-content-results-feed', 'package::founder-growth-engine::surface-feed::content-results'],
      ['founder-growth-distribution-feed', 'package::founder-growth-engine::surface-feed::distribution-attempts'],
    ]));
  });

  it('materializes every descriptor and preserves ranking, grouping, domains, and attention', async () => {
    for (const surface of visualSurfaces) {
      const projection = await buildFounderGrowthVisualDatabaseProjection(surface.surface_input, fixtures[surface.id], derive);
      expect(projection, surface.id).not.toBeNull();
      const view = projection!.model.views.find((candidate) => candidate.id === projection!.initialViewId)!;
      const visible = recordsForView(view, projection!.model.records, projection!.model.fields);
      expect(visible).toHaveLength(fixtures[surface.id]!.length);
      if (surface.id === 'founder-growth-engine.next-moves') {
        expect(visible.map((record) => record.title)).toEqual(['Finish setup', 'Publish']);
        const attention = projection!.model.fields.find((field) => field.id === 'attention')!;
        expect(extractFieldValue(visible[0]!, attention)).toBe('attention');
      } else {
        const grouping = groupingDescriptorForView(view, projection!.model.fields);
        expect(grouping?.id).toBe('status');
        expect(visible.map((record) => recordGroupValues(record, grouping)[0])).toEqual(fixtures[surface.id]!.map((row: any) => row.payload.fields.dispatch_status ?? row.payload.fields.status));
      }
    }
  });

  it('keeps the distribution attention filter and row-open intent contract', async () => {
    const distribution = visualSurfaces.find((surface) => surface.id === 'founder-growth-engine.distribution')!;
    const projection = await buildFounderGrowthVisualDatabaseProjection(distribution.surface_input, fixtures[distribution.id], derive);
    const attentionView = projection!.model.views.find((view) => view.id.endsWith('distribution-attention'))!;
    expect(recordsForView(attentionView, projection!.model.records, projection!.model.fields).map((record) => record.id)).toEqual(['attempt-1']);

    const nextMoves = visualSurfaces.find((surface) => surface.id === 'founder-growth-engine.next-moves')!;
    const nextProjection = await buildFounderGrowthVisualDatabaseProjection(nextMoves.surface_input, fixtures[nextMoves.id], derive);
    const props = recordSurfaceIntentToOpenSurfaceProps(nextProjection!.model.records[0]!.raw, { intentPath: nextProjection!.openRows!.intentPath, allowList: nextProjection!.openRows!.allowList });
    expect(props).toMatchObject({ label: 'Open setup', payload: { packageEntry: { packageName: 'screen-arrangement', entryName: 'workspace-shell' } } });
  });

  it('references live package entries and keeps screen-arrangement as the workspace owner', () => {
    for (const surface of [outer, ...children.map((thing) => thing.payload)]) {
      const ownerThings = loadThings(surface.package_entry.package_name);
      expect(ownerThings.some((thing) => thing.payload?.kind === 'bitfield-package-entry' && thing.payload?.entry_name === surface.package_entry.entry_name && thing.remove !== true)).toBe(true);
    }
    expect(outer.package_entry).toEqual({ package_name: 'screen-arrangement', entry_name: 'workspace-shell' });
    expect(children.every((thing) => thing.payload.placement_labels?.includes(PLACEMENT))).toBe(true);
  });

  it('keeps Saved links retired and removes the bespoke side-workspace entry', () => {
    const marker = things.find((thing) => thing.address === 'package::founder-growth-engine-screens::placeable-surface::side-workspace');
    expect(marker?.payload?.kind).toBe('retired-placeable-surface');
    expect(marker?.payload?.reason).toContain('unrelated');
    expect(things.some((thing) => thing.payload?.kind === 'bitfield-package-entry' && thing.payload?.entry_name === 'side-workspace' && thing.remove !== true)).toBe(false);
  });
});
