{
  "kind": "tool-rows",
  "record_set": "serve-articles-and-signup-tool-rows",
  "what_this_is": "The site's subscriber audience and one-click links, shared by its signup routes and its newsletter workflow. The caller reads one bounded page from the pursuit's own store; this tool filters it and signs links with the site's held key. It sends nothing and reads no database.",
  "records": [
    {
      "id": "package::ai-tool-catalog::tool::prepare-a-newsletter-audience",
      "address": "package::ai-tool-catalog::tool::prepare-a-newsletter-audience",
      "path": ["current-item", "published-record"],
      "payload": {
        "kind": "ai-tool-descriptor",
        "id": "tool:prepare-a-newsletter-audience",
        "label": "Prepare a newsletter audience",
        "job": "Select confirmed subscribers by their tags and give each their site's own one-click unsubscribe link",
        "description": "Give one page of subscribers read from this pursuit's own store (id, email, status, tags), the site's HTTPS origin and the vault name of its link key. Only confirmed rows matching every required_tags tag and none of excluded_tags are returned. The key is mounted on a private descriptor, never handed back. Links use the same signer as the site's unsubscribe route. Malformed tags or conflicting identities refuse the page; unknown subscriber states are never sent. Nothing is sent here: claim each issue/recipient in the pursuit's send table before using tool:send-an-email.",
        "status": "active",
        "input_schema": {
          "type": "object",
          "additionalProperties": false,
          "required": ["subscribers", "origin", "key_name"],
          "properties": {
            "subscribers": {
              "type": "array",
              "maxItems": 1000,
              "items": {
                "type": "object",
                "required": ["id", "email", "status"],
                "properties": {
                  "id": { "type": "string", "minLength": 1 },
                  "email": { "type": "string", "minLength": 1 },
                  "status": { "type": "string" },
                  "tags": { "type": ["string", "array"], "items": { "type": "string" } }
                }
              }
            },
            "origin": { "type": "string", "pattern": "^https://" },
            "key_name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,62}$" },
            "required_tags": { "type": "array", "items": { "type": "string", "minLength": 1 } },
            "excluded_tags": { "type": "array", "items": { "type": "string", "minLength": 1 } }
          }
        },
        "output_schema": {
          "type": "object",
          "required": ["audience", "count", "excluded"],
          "properties": {
            "audience": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["id", "email", "status", "tags", "unsubscribe_url"],
                "properties": {
                  "id": { "type": "string" },
                  "email": { "type": "string" },
                  "status": { "type": "string" },
                  "tags": { "type": "array", "items": { "type": "string" } },
                  "unsubscribe_url": { "type": "string" }
                }
              }
            },
            "count": { "type": "integer" },
            "excluded": { "type": "integer" }
          }
        },
        "invoke": {
          "kind": "container",
          "internet": false,
          "workdir": "/opt/serve-articles-and-signup",
          "stdout": "json",
          "argv": ["node", "/opt/serve-articles-and-signup/do-work/prepare-audience.mjs"],
          "stdin": { "fill": { "from": "input" } },
          "files": { "package_files": { "package": "serve-articles-and-signup", "paths": ["do-work/prepare-audience.mjs", "do-work/subscriber-audience.mjs"], "at": "/opt/serve-articles-and-signup" } },
          "credential_mounts": [{ "secret_name_from_input": "key_name", "fd": 3 }]
        },
        "result_selector": "$",
        "needs": { "expected_seconds": 1, "network_egress": false },
        "read_only": true,
        "placements": ["placement:your-computer"]
      }
    },
    {
      "id": "package::serve-articles-and-signup::tool::keep-a-newsletter-signup",
      "address": "package::serve-articles-and-signup::tool::keep-a-newsletter-signup",
      "path": [
        "current-item",
        "published-record"
      ],
      "payload": {
        "uses_tools": [],
        "kind": "ai-tool-descriptor",
        "id": "tool:keep-a-newsletter-signup",
        "label": "Keep a newsletter signup",
        "job": "Keep a newsletter signup, its confirmation and its unsubscribe, as a double opt-in",
        "description": "One tool for the three newsletter routes, over the pursuit's subscribers rows. action subscribe keeps a pending signup and answers the confirmation mail to send (to, subject, text, and the link with its button words) with attempt { id, digest }; confirm confirms a pending signup from its link (good for 72 hours, once); unsubscribe ends a subscription from its keyed link, by link or one click; send_failed puts a pending signup back when its mail could not be sent. Answers an outcome word, never a page. Sends no mail and holds no mail key; nobody is mailed anything but the confirmation until the link is used.",
        "status": "active",
        "read_only": false,
        "result_selector": "$",
        "input_schema": {
          "type": "object",
          "required": [
            "database",
            "secret",
            "action",
            "origin"
          ],
          "additionalProperties": false,
          "properties": {
            "database": {
              "type": "string",
              "minLength": 1,
              "description": "The name of the pursuit database to use, bound by the trusted caller. The engine opens it with the login its vault holds as that name and -connection; no caller supplies a login."
            },
            "secret": {
              "type": "string",
              "minLength": 1,
              "description": "The vault name of the key that makes the confirm and unsubscribe digests; the engine mounts its value, which never appears in an answer."
            },
            "action": {
              "type": "string",
              "enum": [
                "subscribe",
                "confirm",
                "unsubscribe",
                "send_failed"
              ]
            },
            "origin": {
              "type": "string",
              "minLength": 1,
              "description": "The site's https address, which the confirmation link starts with."
            },
            "email": {
              "type": "string",
              "description": "subscribe: the address typed."
            },
            "source": {
              "type": "string",
              "description": "subscribe: the page path the form was on."
            },
            "ip": {
              "type": "string",
              "description": "subscribe: the visitor's network address, kept only as a keyed digest."
            },
            "forwarded_for": {
              "type": "string",
              "description": "subscribe: used when ip is not given."
            },
            "signup": {
              "type": "object",
              "description": "subscribe: { consent, confirm: { subject, body, button } }, the site's words."
            },
            "tags": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "subscribe: tags every signup gets."
            },
            "source_tags": {
              "type": "object",
              "description": "subscribe: extra tags by page path."
            },
            "s": {
              "type": "string",
              "description": "confirm and unsubscribe: the subscriber id of the link."
            },
            "t": {
              "type": "string",
              "description": "confirm and unsubscribe: the token of the link."
            },
            "method": {
              "type": "string",
              "description": "unsubscribe: POST for a one-click unsubscribe, else GET."
            },
            "id": {
              "type": "string",
              "description": "send_failed: attempt.id."
            },
            "digest": {
              "type": "string",
              "description": "send_failed: attempt.digest."
            }
          }
        },
        "output_schema": {
          "type": "object",
          "required": [
            "outcome"
          ],
          "properties": {
            "outcome": {
              "type": "string"
            },
            "mail": {
              "type": "object"
            },
            "attempt": {
              "type": "object"
            }
          }
        },
        "invoke": {
          "kind": "container",
          "internet": true,
          "workdir": "/opt/serve-articles-and-signup",
          "stdout": "json",
          "argv": [
            "node",
            "/opt/serve-articles-and-signup/routes/keep-a-newsletter-signup.ts"
          ],
          "stdin": {
            "fill": {
              "from": "input"
            }
          },
          "credential_mounts": [
            {
              "secret_name_from_input": "database",
              "held_suffix": "-connection",
              "fd": 3,
              "only_when": {
                "input": "database",
                "present": true
              }
            },
            {
              "secret_name_from_input": "secret",
              "fd": 4,
              "only_when": {
                "input": "secret",
                "present": true
              }
            }
          ],
