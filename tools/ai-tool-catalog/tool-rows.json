{
  "kind": "tool-rows",
  "record_set": "ai-tool-catalog-protected-setup",
  "what_this_is": "Executable original server setup controller. Native protected ports are attached only by the current admitted request, never this descriptor.",
  "records": [
    {
      "id": "package::ai-tool-catalog::tool::add-a-tool-server",
      "address": "package::ai-tool-catalog::tool::add-a-tool-server",
      "path": [
        "current-item",
        "published-record"
      ],
      "payload": {
        "kind": "ai-tool-descriptor",
        "id": "tool:add-a-tool-server",
        "label": "Add a tool server",
        "status": "active",
        "job": "Add a remote MCP tool server to this account, signing in through its native protected callback when required",
        "input_schema": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "server"
          ],
          "properties": {
            "server": {
              "type": "string",
              "format": "uri"
            },
            "name": {
              "type": "string",
              "x-free-text-because": "The name of the tool server being added."
            },
            "key_intake": {
              "type": "string",
              "description": "Opaque one-use handle from native protected key intake; never the key value."
            },
            "key_header": {
              "type": "string"
            },
            "key_prefix": {
              "type": "string"
            },
            "state": {
              "type": "string",
              "pattern": "^[a-f0-9]{48}$"
            },
            "callback_intake": {
              "type": "string",
              "description": "Opaque native callback handle; no authorization code."
            }
          }
        },
        "invoke": {
          "kind": "container",
          "internet": false,
          "stdout": "json",
          "workdir": "/opt/ai-tool-catalog",
          "argv": [
            "node",
            "/opt/records-door/do-work/run-an-export.mjs",
            "/opt/ai-tool-catalog/do-work/tool-server-native-child.mjs",
            "addToolServerFromNativeTask"
          ],
          "stdin": {
            "fill": {
              "from": "input"
            }
          },
          "files": {
            "package_files": [
              {
                "package": "ai-tool-catalog",
                "paths": [
                  "do-work/tool-server-native-child.mjs",
                  "do-work/tool-server-lifecycle.mjs",
                  "do-work/source-template.mjs",
                  "do-work/sign-in-to-a-tool-server.mjs",
                  "do-work/talk-to-a-tool-server.mjs",
                  "read-data/remote-call-protocol.json",
                  "read-data/tool-server-lifecycle.json"
                ],
                "at": "/opt/ai-tool-catalog"
              },
              {
                "package": "records-door",
                "paths": [
                  "do-work/run-an-export.mjs",
                  "read-data/records-door.mjs",
                  "read-data/byte-pages.mjs"
                ],
                "at": "/opt/records-door"
              },
              {
                "package": "content-identity",
                "paths": [
                  "read-data"
                ],
                "at": "/opt/content-identity"
              },
              {
                "package": "refuse-requests-to-private-addresses",
                "paths": [
                  "public-address.mjs",
                  "public-address.json"
                ],
                "at": "/opt/refuse-requests-to-private-addresses"
              },
              {
                "package": "http-client",
                "paths": [
                  "do-work/same-origin.mjs"
                ],
                "at": "/opt/http-client"
              },
              {
                "module": "@noble/hashes",
                "paths": [
                  "LICENSE",
                  "package.json",
                  "blake3.js",
                  "blake2.js",
                  "_blake.js",
                  "_md.js",
                  "_u64.js",
                  "utils.js"
                ],
                "at": "/opt/node_modules/@noble/hashes"
              },
              {
                "module": "tldts",
                "paths": ["package.json", "LICENSE", "dist"],
                "at": "/opt/node_modules/tldts"
              },
              {
                "module": "tldts-core",
                "paths": ["package.json", "LICENSE", "dist"],
                "at": "/opt/node_modules/tldts-core"
              }
            ]
          },
          "records": {
            "fd": 3,
            "rights": [
              {
                "kind": "tool-server-added",
                "prefix": "tool-server-added:",
                "operations": [
                  "records:read",
                  "records:write"
                ]
              },
              {
                "kind": "tool-server",
                "prefix": "tool-server:",
                "operations": [
                  "records:read",
                  "records:write"
                ]
              },
              {
                "kind": "tool-server-client",
                "prefix": "tool-server-client:",
                "operations": [
                  "records:read",
                  "records:write"
                ]
              },
              {
                "kind": "tool-server-pending",
                "prefix": "tool-server-pending:",
                "operations": [
                  "records:read",
                  "records:write"
                ]
              },
              {
                "kind": "tool-server-claim",
                "prefix": "tool-server-claim:",
                "operations": [
                  "records:read",
                  "records:write"
                ]
              },
              {
                "kind": "tool-server-callback",
                "prefix": "tool-server-callback:",
                "operations": [
                  "records:read",
                  "records:write"
                ]
              },
              {
                "kind": "tool-server-attempt",
                "prefix": "tool-server-attempt:",
                "operations": [
                  "records:read",
                  "records:write"
                ]
              }
            ]
          }
        },
        "needs": {
          "expected_seconds": 20,
          "network_egress": false
        },
        "licence_class": "licence:maker-own",
        "placements": [
          "placement:small-container"
        ],
        "maker": "maker:ai-tool-catalog",
        "result_selector": "$.result",
        "record_model": {
          "kinds": [
            {
              "type": "tool-server-added",
              "stays_on_this_device": false,
              "erasable": [
                "kind",
                "id",
                "label",
                "list",
                "entry",
                "id_prefix",
                "row"
              ],
              "properties": {
                "kind": "text",
                "id": "text",
                "label": "text",
                "list": "object",
                "entry": "object",
                "id_prefix": "text",
                "row": "object"
              }
            },
            {
              "type": "tool-server",
              "stays_on_this_device": false,
              "erasable": [
                "server",
                "found",
                "client_id",
                "expires_at",
                "signed_in_at",
                "refreshed_at",
                "authorization_state"
              ],
              "properties": {
                "server": "text",
                "found": "object",
                "client_id": "text",
                "expires_at": "text",
                "signed_in_at": "text",
                "refreshed_at": "text",
                "authorization_state": "text"
              }
            },
            {
              "type": "tool-server-client",
              "stays_on_this_device": false,
              "erasable": [
                "client_id"
              ],
              "properties": {
                "client_id": "text"
              }
            },
            {
              "type": "tool-server-pending",
              "stays_on_this_device": false,
              "erasable": [
                "server",
                "found",
                "client_id",
                "started_at",
                "redirect_uri"
              ],
              "properties": {
                "server": "text",
                "found": "object",
                "client_id": "text",
                "started_at": "text",
                "redirect_uri": "text"
              }
            },
            {
              "type": "tool-server-claim",
              "stays_on_this_device": false,
              "erasable": [
                "state",
                "pending",
                "request_key",
                "scope_identity",
                "owner_identity"
              ],
              "properties": {
                "state": "text",
                "pending": "object",
                "request_key": "text",
                "scope_identity": "text",
                "owner_identity": "text"
              }
            },
            {
              "type": "tool-server-callback",
              "stays_on_this_device": false,
              "erasable": [
                "state",
                "server",
                "expires_at",
                "request_key",
                "scope_identity",
                "owner_identity"
              ],
              "properties": {
                "state": "text",
                "server": "text",
                "expires_at": "number",
                "request_key": "text",
                "scope_identity": "text",
                "owner_identity": "text"
              }
            },
            {
              "type": "tool-server-attempt",
              "stays_on_this_device": false,
              "erasable": [
                "request_key",
                "started_at",
                "state"
              ],
              "properties": {
                "request_key": "text",
                "started_at": "text",
                "state": "text"
              }
            }
          ]
        },
        "provenance": {
          "source": "Original tool:add-a-tool-server identity and full-URL source facts; product lifecycle runs through the native protected child capability owner. This row alone grants no protected action, intake, vault or credential rights."
        }
      }
    }
  ]
}
