{
  "kind": "ai-tool-descriptor",
  "id": "tool:read-my-api-descriptions",
  "label": "Read my tool sources",
  "status": "active",
  "job": "Read the tools my connected API descriptions and tool servers currently offer",
  "description": "Reads the current native-selected source definitions and templates, derives OpenAPI and MCP tools, and retains conditional-read/backoff metadata in the current account. A source that is pending, unreadable or needs an unavailable connection is named with that state. Tools are DATA, never privately installed copies. The current native owner supplies and rechecks source/configuration, account and connection authority; request input cannot choose them.",
  "input_schema": {"type":"object","additionalProperties":false,"properties":{"need":{"type":["string","boolean"]},"wait":{"type":"boolean"}}},
  "output_schema": {"type":"object","required":["reads","rows","unavailable","configuration_identity"],"properties":{"reads":{"type":"array"},"rows":{"type":"array"},"unavailable":{"type":"array"},"configuration_identity":{"type":"string"}}},
  "invoke": {
    "kind": "container", "internet": true, "stdout": "json", "workdir": "/opt/ai-tool-catalog",
    "argv": ["node","/opt/workflows/do-work/run-a-function.mjs","/opt/ai-tool-catalog/do-work/account-live-sources.mjs","readLiveSourcesFromTask"],
    "stdin": {"input":{"fill":{"from":"input"}},"source_data":{"fill":{"from":"task","field":"source_data"}},"request_key":{"fill":{"from":"task","field":"request_key"}}},
    "files": {"package_files":[
      {"package":"ai-tool-catalog","paths":["do-work/account-live-sources.mjs","do-work/source-template.mjs","do-work/derive-tool-rows-from-sources.mjs","do-work/read-openapi.mjs","do-work/public-post.mjs","read-data/account-live-source-reads.json","read-data/remote-call-protocol.json","read-data/read-ai-tool-catalog.ts","read-data/declared-effects.ts"],"at":"/opt/ai-tool-catalog"},
      {"package":"workflows","paths":["do-work/run-a-function.mjs"],"at":"/opt/workflows"},
      {"package":"content-identity","paths":["read-data"],"at":"/opt/content-identity"},
      {"package":"ui","paths":["read-data/declared-selector.ts"],"at":"/opt/ui"},
      {"package":"refuse-requests-to-private-addresses","paths":["public-address.mjs","public-address.json"],"at":"/opt/refuse-requests-to-private-addresses"},
      {"package":"http-client","paths":["do-work/same-origin.mjs"],"at":"/opt/http-client"},
      {"packages":["node_modules/tldts"],"paths":["package.json","LICENSE","dist"],"at":"/opt/node_modules/tldts"},
      {"packages":["node_modules/tldts-core"],"paths":["package.json","LICENSE","dist"],"at":"/opt/node_modules/tldts-core"},
      {"packages":["node_modules/@noble/hashes"],"paths":["LICENSE","package.json","blake3.js","blake2.js","_blake.js","_md.js","_u64.js","utils.js"],"at":"/opt/node_modules/@noble/hashes"}
    ]}
  },
  "needs":{"expected_seconds":10,"network_egress":true},
  "licence_class":"licence:maker-own","placements":["placement:small-container"],"maker":"maker:ai-tool-catalog","result_selector":"$.result",
  "record_model":{"kinds":[{"type":"tool-source-read","stays_on_this_device":false,"erasable":["entries","held"],"properties":{"source_id":"text","source_key":"text","definition_identity":"text","configuration_identity":"text","request_key":"text","version":"text","entries":"objects","held":"objects","etag":"text","last_modified":"text","read_at":"text","checked_at":"text","error":"text","failures":"number"}}]},
  "provenance":{"source":"Source-first adaptation of the original live source reader, preserving derivation/protocol owners and original source identities; current native supplier and records door replace the retired SQL/runtime."},
  "verify":[{"kind":"sample-run","input":{"wait":false},"task":{"source_data":{"config":{"kinds":{},"sources":[]}},"request_key":"sample-live-source-read"},"output_selector":"$.reads"}]
}
