      "bootstrap": [
        {
          "id": "weather-gov",
          "kind": "openapi",
          "name": "weather.gov",
          "url": "https://api.weather.gov/openapi.json",
          "headers": {
            "User-Agent": "Trillion (https://app.gettrillion.ai)",
            "Accept": "application/geo+json"
          }
        }
      ],
      "withdrawn": []
    },
    {
      "key": "service",
      "file": "records/hosted-mcp-apps.json",
      "pointer": "/service",
      "bootstrap": {
        "id": "service:craft-mcp",
        "site_id": "site:craft-mcp",
        "label": "Craft creative apps as tool servers",
        "host": "craft-mcp.gettrillion.ai",
        "binding": "CRAFT_MCP_SERVICE",
        "class_name": "CraftMcpService",
        "application": "hosted-craft-mcp",
        "instance_type": "standard-2",
        "max_instances": 4,
        "port": 8080,
        "idle_seconds": 600,
        "save_after_write_seconds": 20,
        "base_image": "node:22-bookworm-slim",
        "user": "node",
        "gateway": {
          "max_sessions": 16,
          "session_idle_seconds": 120,
          "session_max_seconds": 1800,
          "request_timeout_seconds": 120,
          "queue_seconds": 15
        }
      },
      "withdrawn": null
    },
