                    "field": "id"
                  }
                },
                "sign_in": {
                  "fill": {
                    "from": "source",
                    "field": "sign_in"
                  }
                },
                "key": {
                  "fill": {
                    "from": "source",
                    "field": "key"
                  }
                }
              },
              "licence_class": {
                "fill": {
                  "from": "source",
                  "field": "licence_class",
                  "default": "licence:maker-own"
                }
              },
              "maker": {
                "fill": {
                  "from": "source",
                  "field": "maker"
                }
              },
              "placements": [
                "placement:public-web-address"
              ],
              "provenance": {
                "api": {
                  "fill": {
                    "from": "source",
                    "field": "name"
                  }
                },
                "server": {
                  "fill": {
                    "from": "source",
                    "field": "url"
                  }
                },
                "licence": {
                  "fill": {
                    "from": "source",
                    "field": "licence"
                  }
                },
                "page": {
                  "fill": {
                    "from": "source",
                    "field": "page"
                  }
                },
                "read_from": "the server's own tools list, read again when it changes"
              }
            }
          }
        }
