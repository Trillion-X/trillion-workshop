              }
            },
            "label": {
              "fill": {
                "from": "source",
                "field": "name"
              }
            },
            "list": {
              "openapi": {
                "url": {
                  "fill": {
                    "from": "source",
                    "field": "url"
                  }
                },
                "headers": {
                  "fill": {
                    "from": "source",
                    "field": "headers"
                  }
                },
                "connection": {
                  "fill": {
                    "from": "source",
                    "field": "connection"
                  }
                },
                "only": {
                  "fill": {
                    "from": "source",
                    "field": "only"
                  }
                }
              }
            },
            "entry": {
              "id": "operation",
              "label": "label",
              "job": "job",
              "input_schema": "input_schema",
              "method": "method",
              "url": "url",
              "query": "query",
              "headers": "headers",
              "body": "body",
              "connection_id": "connection_id",
              "credential_injections": "credential_injections",
              "licence": "licence",
              "api": "api",
              "page": "page"
            },
            "id_prefix": {
              "fill": {
                "from": "source",
                "field": "tool_prefix"
              }
            },
            "row": {
              "invoke": {
                "kind": "http",
                "method": {
                  "fill": {
                    "from": "entry",
                    "field": "method"
                  }
                },
                "url": {
                  "fill": {
                    "from": "entry",
                    "field": "url"
                  }
                },
                "query": {
                  "fill": {
                    "from": "entry",
                    "field": "query"
                  }
                },
                "headers": {
                  "fill": {
                    "from": "entry",
                    "field": "headers"
                  }
                },
                "body": {
                  "fill": {
                    "from": "entry",
                    "field": "body"
                  }
                },
                "connection": {
                  "fill": {
                    "from": "source",
                    "field": "connection_record"
                  }
                },
                "connection_id": {
                  "fill": {
                    "from": "entry",
                    "field": "connection_id"
                  }
                },
                "credential_injections": {
                  "fill": {
                    "from": "entry",
                    "field": "credential_injections"
                  }
                },
                "timeout_ms": 30000
              },
              "licence_class": "licence:maker-own",
              "placements": [
                "placement:public-web-address"
              ],
              "needs": {
                "expected_seconds": 3,
                "network_egress": true
              },
              "provenance": {
                "api": {
                  "fill": {
                    "from": "entry",
                    "field": "api"
                  }
                },
                "licence": {
                  "fill": {
                    "from": "entry",
                    "field": "licence"
                  }
                },
                "page": {
                  "fill": {
                    "from": "entry",
                    "field": "page"
                  }
                },
                "description": {
                  "fill": {
                    "from": "source",
                    "field": "url"
                  }
                },
                "read_from": "the API's own description, read again when it changes"
              }
            }
          }
        },
        "mcp": {
          "label": "A remote tool server",
          "becomes": "tool",
          "source": {
            "kind": "tool-row-source",
            "id": {
              "fill": {
                "from": "source",
                "field": "id"
              }
            },
            "label": {
              "fill": {
                "from": "source",
                "field": "name"
              }
            },
            "about": {
              "fill": {
                "from": "source",
                "field": "about"
              }
            },
            "list": {
              "mcp": {
                "url": {
                  "fill": {
                    "from": "source",
                    "field": "url"
                  }
                },
                "sign_in": {
                  "fill": {
                    "from": "source",
                    "field": "sign_in"
                  }
                },
                "key": {
                  "fill": {
                    "from": "source",
                    "field": "key"
                  }
                }
              }
            },
            "entry": {
              "id": "name",
              "label": "title",
              "job": "description",
              "input_schema": "inputSchema",
              "output_schema": "outputSchema"
            },
            "id_prefix": {
              "fill": {
                "from": "source",
                "field": "tool_prefix"
              }
            },
            "row": {
              "invoke": {
                "kind": "mcp-tool-call",
