{
  "version": 1,
  "publication": {
    "key_prefix": "workshop-projection:",
    "shelf": "tool",
    "manifest": "shelf",
    "point": "item",
    "marker": "published-identity",
    "marker_legacy": "1",
    "marker_published_prefix": "published:",
    "row_kind": "ai-tool-descriptor",
    "active_status": "active",
    "invocation_kinds": [
      "http",
      "container",
      "mcp-tool-call"
    ]
  },
  "consumers": [
    "tool:manage-my-tool-sources",
    "tool:read-my-tool-sources",
    "tool:derive-current-tool-source-rows"
  ],
  "section_keys": {
    "logical_prefix": "source:",
    "item_prefix": "content:",
    "projection_prefix": "marketplace-content:",
    "format": "json",
    "maker_prefix": "maker:",
    "hosted_template": {
      "id": {
        "app": [
          "name"
        ]
      },
      "kind": {
        "literal": "mcp"
      },
      "name": {
        "app": [
          "label"
        ]
      },
      "url": {
        "address": true
      },
      "licence": {
        "app": [
          "licence"
        ],
        "fallback": "licence"
      },
      "licence_class": {
        "document": "licence_class"
      },
      "maker": {
        "app": [
          "maker"
        ],
        "fallback": "maker"
      },
      "page": {
        "app": [
          "page",
          "repo"
        ]
      },
      "about": {
        "app": [
          "about"
        ]
      }
    },
    "hosted_defaults": {
      "licence": "Apache-2.0",
      "licence_class": "licence:permissive",
      "maker": "maker:github.com/storytold"
    }
  },
  "sections": [
    {
