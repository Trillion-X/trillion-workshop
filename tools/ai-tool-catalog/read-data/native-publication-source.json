  "own": {
    "saved": {
      "kind": "tool",
      "prefix": "tool:"
    },
    "sources": {
      "kind": "tool-source",
      "prefix": "tool-source:"
    },
    "max_sources": 256,
    "live_prefix": "tool:",
    "max_snapshot_bytes": 4194304,
    "cache": {
      "kind": "tool-source-read",
      "prefix": "tool-source-read:"
    },
    "built": {
      "kind": "tool-server-added",
      "prefix": "tool-server-added:"
    },
    "sign_ins": {
