        "status": "active",
        "licence_class": "licence:maker-own",
        "placements": [
          "placement:your-computer"
        ],
        "maker": "maker:keep-records-as-long-as-their-keep-rule-says",
        "needs": {
          "expected_seconds": 2,
          "priority": 5,
          "network_egress": false
        },
        "id": "tool:keep-by-its-rule",
        "listed_on": "2026-11-14T16:00:00Z",
        "label": "Apply one of my keep rules",
        "job": "Ask my engine to apply one of my keep rules now: it destroys, restorable for the undo window, the records of one kind that the rule's row says have expired; my own schedule says when",
        "description": "A keep rule is a row of mine (record:keep-rule): which kind of record, when a record of it has expired (the formula engine's rule tree over the record's own values and its age), and how many records one firing may destroy and look at. A wake declaration of mine names this tool with {rule} (the row's id) and its own schedule; the run hands the engine the rule, and the engine reads the row, decides each record with the formula engine and destroys through its restorable erasure. This tool counts no time and removes nothing itself.",
        "input_schema": {
          "type": "object",
          "required": [
            "rule"
          ],
          "properties": {
            "rule": {
              "type": "string",
              "description": "The id of the keep rule's row."
            },
            "resource": {
              "type": "string",
              "description": "The store the rule's row and records are in; my own records when left out."
            }
          }
        },
        "output_schema": {
          "type": "object"
        },
        "invoke": {
          "kind": "computer",
          "workdir": "/opt/keep-records-as-long-as-their-keep-rule-says",
          "stdout": "json",
          "argv": [
            "node",
            "/opt/records-door/do-work/run-an-export.mjs",
