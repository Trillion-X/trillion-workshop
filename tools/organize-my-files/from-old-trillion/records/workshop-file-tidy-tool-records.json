{
  "kind": "package-set-records",
  "package_set": "trillion",
  "record_set": "workshop-file-tidy-tool-records",
  "what_this_is": "Tidying a person's files as Workshop tools that run inside that person's store (placement:this-account; src/file-tidy.mjs through src/person-store.mjs accountActions): their own AI suggests titles and folders grounded in what is known about each file, the person accepts or rejects each on the Tidy up screen (the list tool's screen, entry file-tidy), and the accepted ones are applied as one tidy-up that can be undone. The same verbs are MCP tools in src/file-tools.mjs (propose_file_tidy, list_file_tidy, apply_file_tidy, undo_file_tidy, file_tidy_history).",
  "records": [
    {
      "id": "package::trillion::tool::propose-file-tidy",
      "address": "package::trillion::tool::propose-file-tidy",
      "path": [
        "current-item",
        "published-record"
      ],
      "payload": {
        "kind": "ai-tool-descriptor",
        "status": "active",
        "licence_class": "licence:maker-own",
        "placements": [
          "placement:this-account"
        ],
        "maker": "maker:trillion",
        "needs": {
          "expected_seconds": 2,
          "network_egress": false
        },
        "id": "tool:propose-file-tidy",
        "listed_on": "2026-09-30T06:38:38Z",
        "label": "Suggest titles and folders for files",
        "job": "Suggest a title and a folder for some of this person's files, each grounded in what is already known about the file (its transcript, summary or facts), for the person to accept or reject",
        "description": "items is a list of { name, title?, folder?, evidence, reason? }: name is the file's path, evidence the kinds of results already kept about it that the suggestion comes from. A title (or a new folder) that those results' words do not mention is refused with why, as is a file with nothing kept about it. Nothing changes until the person accepts a suggestion and it is applied. Returns proposed (each suggestion with its id and state review), unchanged, refused ({ index, name, reason }) and said.",
        "input_schema": {
          "type": "object",
          "required": [
            "items"
          ],
          "additionalProperties": false,
          "properties": {
            "items": {
              "type": "array",
              "minItems": 1,
              "maxItems": 200,
              "items": {
                "type": "object",
                "required": [
                  "name",
                  "evidence"
                ],
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "title": {
                    "type": "string",
                    "maxLength": 160
                  },
                  "folder": {
                    "type": "string"
                  },
                  "evidence": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "string"
                    }
                  },
                  "reason": {
                    "type": "string",
                    "maxLength": 1000
                  }
                }
              }
            },
            "produced_by": {
              "type": "string"
            }
          }
        },
        "output_schema": {
          "type": "object",
          "required": [
            "proposed",
            "unchanged",
            "refused",
            "said"
          ],
          "properties": {
            "proposed": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  },
                  "identity": {
                    "type": "string"
                  },
                  "title": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "folder": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "reason": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "evidence": {
                    "type": "array"
                  },
                  "produced_by": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "state": {
                    "type": "string"
                  },
                  "problem": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "proposed_at": {
                    "type": "string"
                  },
                  "tidy_up": {
                    "type": [
                      "object",
                      "null"
                    ]
                  }
                }
              }
            },
            "unchanged": {
              "type": "integer"
            },
            "refused": {
              "type": "array"
            },
            "said": {
              "type": "string"
            }
          }
        },
        "invoke": {
          "kind": "account-action",
          "action": "propose-file-tidy"
        },
        "provenance": {
          "source": "src/file-tidy.mjs (ported from media-workspace/organization-owner.mjs, recording-evidence.mjs and media-titles.mjs)"
        },
        "verify": [
          {
            "kind": "output-number-within",
            "output_selector": "$.unchanged",
            "at_least": 0,
            "at_most": 200
          }
        ]
      }
    },
