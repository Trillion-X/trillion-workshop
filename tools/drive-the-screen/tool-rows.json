        "label": "See what is on the person's computer screen",
        "job": "Read the person's computer screen: the app in front (or one named), its controls from the accessibility tree and the text on its windows from the pixels, with where each is",
        "description": "Returns the app, the displays, and the things on the screen (role, label, centre and size, and the actions each offers) in points from the top left of the main display, never coordinates guessed from a picture. Text from the pixels is kept to the app's own windows. Read-only. Uses this Mac's existing Accessibility and Screen Recording permissions. The person can turn on an optional grant policy in their screen-driving settings folder; calls cannot change that policy.",
        "input_schema": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "app": {
              "type": "string",
              "description": "The running app to read (its name or bundle id); the app in front when left out."
            },
            "sources": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Where to read from: ax (the accessibility tree) and/or ocr (the pixels read as text)."
            },
            "settings_folder": {
              "type": "string",
              "description": "The folder the person keeps their screen-driving settings in (the one holding .trillion/screen-driving: grants, rules, places), granted to this tool as change-a-folder. Left out, the run starts from an empty folder, so only the shipped rules apply."
            }
          }
        },
