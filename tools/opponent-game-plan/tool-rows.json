        "kind": "ai-tool-descriptor",
        "id": "tool:scout-an-opponent",
        "label": "Scout an opponent from the notes on file",
        "status": "active",
        "job": "Look up an opponent: list the people scouted, and pull together everything on file about one (what they are good and weak at, what worked and failed against them, their style and ratings) and which notes are trusted enough to plan from",
        "description": "Give the person's records and an operation. search lists every subject that is not the person themself, with how many reports and profiles are on file and how many tactics worked and failed against them. profile (with subject_id) joins the subject's reports (player-report evidence), profiles (profile-projection) and tactic outcomes into one view: strengths, weaknesses, strategies that worked and failed, style labels, ratings (any name, numbers 0 to 100; a value outside that is left out, not guessed), public and private reports apart, and the outcomes of tactics from earlier plans. It also says which reports a plan may use: the confidence policy is { minimumConfidence, missingConfidenceIsUsable }, given as confidence_policy or as an evidence-confidence-policy record in the rows, and with none no report is usable (every one waits for review). A report's confidence is its source's, else its own. Nothing here names a sport: the words for ratings, styles and facts are the ones in the records.",
        "input_schema": {
          "type": "object",
          "required": ["operation"],
          "additionalProperties": false,
          "properties": {
            "operation": { "type": "string", "enum": ["search", "profile", "record-report", "record-profile"], "description": "What to do" },
            "rows": { "type": "array", "items": { "type": "object" }, "description": "search and profile: the records (subject, evidence, profile-projection, result, evidence-confidence-policy), each as { payload } or the record itself" },
            "subject_id": { "type": "string", "description": "profile: the subject to pull together; record-report and record-profile: the subject the record is about" },
            "confidence_policy": { "type": "object", "description": "{ minimumConfidence: number, missingConfidenceIsUsable: true or false }; replaces a policy record in the rows", "additionalProperties": true },
            "subject_kind": { "type": "string", "description": "Keep only subjects of this subjectKind; record-report and record-profile: the subject's kind (default player)" },
            "profile_kind": { "type": "string", "description": "Keep only profiles of this projectionKind; record-profile: the kind of profile (required)" },
            "subject_label": { "type": "string", "description": "record-report: the subject's name" },
            "is_self": { "type": "boolean", "description": "record-report: true when the subject is the person themself" },
            "facts": { "type": "object", "description": "record-report: facts about the subject (hand, and any other the person names)", "additionalProperties": true },
            "report_id": { "type": "string", "description": "record-report: an id for the report (made when absent)" },
            "author_id": { "type": "string", "description": "record-report: who wrote the report" },
            "visibility": { "type": "string", "description": "record-report: public or private (private when absent)" },
            "style_labels": { "type": "array", "items": { "type": "string" }, "description": "record-report: the style words the person uses" },
            "strengths": { "type": "array", "items": { "type": "string" }, "description": "record-report: strengths, in the person's words" },
            "weaknesses": { "type": "array", "items": { "type": "string" }, "description": "record-report: weaknesses, in the person's words" },
            "strategies_worked": { "type": "array", "items": { "type": "string" }, "description": "record-report: what worked against this subject" },
            "strategies_failed": { "type": "array", "items": { "type": "string" }, "description": "record-report: what did not work against this subject" },
            "notes": { "type": "string", "description": "record-report: free notes" },
            "confidence": { "type": "number", "description": "record-report: how sure the report is; the confidence policy reads it" },
            "source": { "type": "object", "description": "record-profile: where the profile facts came from: { sourceId, visibility? , confidence? }", "additionalProperties": true },
            "payload": { "type": "object", "description": "record-profile: the profile facts; ratings is { name: a number from 0 to 100 }", "additionalProperties": true },
            "profile_id": { "type": "string", "description": "record-profile: an id for the profile (made when absent)" },
            "now": { "type": "string", "description": "record and profile times: an ISO time (the clock when absent)" }
          }
        },
        "output_schema": {
          "type": "object",
          "properties": {
            "opponents": { "type": "array", "items": { "type": "object" }, "description": "search: { subjectId, name, facts, styleLabels, reportCount, profileCount, workedCount, failedCount }" },
            "profile": { "type": "object", "description": "profile: the joined view" },
            "evidence": { "type": "object", "description": "profile: { usable: [report ids], needsReview: [report ids] }" },
            "subject_record": { "type": "object", "description": "record-report: the subject record to write" },
            "report_record": { "type": "object", "description": "record-report: the evidence record to write" },
            "profile_record": { "type": "object", "description": "record-profile: the profile projection record to write" }
          }
        },
        "invoke": {
          "kind": "container",
          "files": { "package_files": { "package": "opponent-game-plan", "paths": ["do-work", "read-data"], "at": "/opt/opponent-game-plan" } },
          "workdir": "/opt/opponent-game-plan",
          "internet": false,
          "stdout": "json",
          "argv": ["node", "do-work/scout-an-opponent.mjs"],
          "stdin": { "fill": { "from": "input" } }
        },
        "result_selector": "$.result",
        "needs": { "expected_seconds": 1, "network_egress": false, "memory_mb": 128 },
        "licence_class": "licence:maker-own",
        "placements": ["placement:small-container"],
        "maker": "maker:opponent-game-plan",
        "provenance": { "source": "ported from the opponent-game-plan package (the profile join, the search list and the confidence split)" },
        "verify": [
          {
            "kind": "sample-run",
            "input": {
              "operation": "search",
              "rows": [
                { "payload": { "kind": "subject", "subjectId": "p:1", "subjectKind": "player", "label": "Alder", "payload": { "isSelf": true }, "createdAt": "2026-01-01T09:00:00.000Z" } },
                { "payload": { "kind": "subject", "subjectId": "p:2", "subjectKind": "player", "label": "Birch", "payload": {}, "createdAt": "2026-01-01T09:00:00.000Z" } }
              ]
            },
            "output_selector": "$.opponents[0].name",
            "contains": "Birch"
          }
        ]
      }
    },
