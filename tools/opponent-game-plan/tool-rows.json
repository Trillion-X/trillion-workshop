        "kind": "ai-tool-descriptor",
        "id": "tool:prepare-a-match-plan",
        "label": "Prepare the notes a match plan is made from, and record the plan",
        "status": "active",
        "job": "Plan a match against an opponent: gather what the trusted notes say about both sides into the brief a plan is written from, then check and record the plan that was written",
        "description": "Calls no model: the AI that reads the brief writes the plan. context takes the person's records, who is self and who is the opponent, who asked, and plan_shape { strategies, tactics_per_strategy } (how many of each the person wants; both required). It returns a plan-request record whose promptText asks for exactly that shape and then lists what only the usable evidence says of each side, one line per fact: names, facts, style, strongest, weakest, strategies that worked and did not work (earlier tactic outcomes included), ratings out of 100 and any other fact in the profile. Missing facts are left out, never written as unknown. It also lists the ids of the public, private and to-be-reviewed reports, the profiles and the tactic results behind the brief. A report is usable only if the confidence policy allows it (confidence_policy, or an evidence-confidence-policy record in the rows); with no policy none is, and every report is listed for review. record-plan takes the written strategies (each { strategyId, name, tactics: [{ tacticId, label, reason? }] }) and returns the match-plan result record only if it has exactly the strategies and tactics asked for. Records come back for the caller to write; nothing is kept here.",
        "input_schema": {
          "type": "object",
          "required": ["operation"],
          "additionalProperties": false,
          "properties": {
            "operation": { "type": "string", "enum": ["context", "record-plan", "record-result", "latest-plan"], "description": "What to do" },
            "plan_shape": { "type": "object", "required": ["strategies", "tactics_per_strategy"], "properties": { "strategies": { "type": "integer", "minimum": 1 }, "tactics_per_strategy": { "type": "integer", "minimum": 1 } }, "description": "How many strategies, and how many tactics in each, the plan has" },
            "rows": { "type": "array", "items": { "type": "object" }, "description": "context: the records, each as { payload } or the record itself" },
            "self_id": { "type": "string", "description": "The subject id of the person's own side" },
            "opponent_id": { "type": "string", "description": "The subject id of the opponent" },
            "requester_id": { "type": "string", "description": "context: who asked for the plan" },
            "confidence_policy": { "type": "object", "description": "context: { minimumConfidence, missingConfidenceIsUsable }; replaces a policy record in the rows", "additionalProperties": true },
            "request_id": { "type": "string", "description": "context: an id for the request (made when absent). record-plan: the request the plan answers" },
            "plan_id": { "type": "string", "description": "record-plan: an id for the plan" },
            "strategies": { "type": "array", "items": { "type": "object" }, "description": "record-plan: the written strategies" },
            "evidence_refs": { "type": "array", "items": { "type": "string" }, "description": "record-plan: the report ids the plan rests on" },
            "subject_kind": { "type": "string" },
            "profile_kind": { "type": "string" },
            "result_id": { "type": "string", "description": "record-result: an id for the result (made when absent)" },
            "outcome": { "type": "string", "enum": ["worked", "failed", "mixed"], "description": "record-result: how the tactic went" },
            "strategy_id": { "type": "string", "description": "record-result: the strategy the tactic belongs to" },
            "tactic_id": { "type": "string", "description": "record-result: the tactic tried" },
            "match_ref": { "type": "string", "description": "record-result: the match it was tried in" },
            "notes": { "type": "string", "description": "record-result: free notes" },
            "now": { "type": "string", "description": "An ISO time for the record (the clock when absent)" }
          }
        },
        "output_schema": {
          "type": "object",
          "properties": {
            "request_record": { "type": "object", "description": "context: the plan-request record, with promptText" },
            "plan_record": { "type": "object", "description": "record-plan: the match-plan result record; latest-plan: the latest plan between the two, or null" },
            "result_record": { "type": "object", "description": "record-result: the tactic-outcome record to write" }
          }
        },
        "invoke": {
          "kind": "container",
          "files": { "package_files": { "package": "opponent-game-plan", "paths": ["do-work", "read-data"], "at": "/opt/opponent-game-plan" } },
          "workdir": "/opt/opponent-game-plan",
          "internet": false,
          "stdout": "json",
          "argv": ["node", "do-work/prepare-a-match-plan.mjs"],
          "stdin": { "fill": { "from": "input" } }
        },
        "result_selector": "$.result",
        "needs": { "expected_seconds": 1, "network_egress": false, "memory_mb": 128 },
        "licence_class": "licence:maker-own",
        "placements": ["placement:small-container"],
        "maker": "maker:opponent-game-plan",
        "provenance": { "source": "ported from the opponent-game-plan package (the match-plan request context and the plan shape check)" },
        "verify": [
          {
            "kind": "sample-run",
            "input": {
              "operation": "context",
              "plan_shape": { "strategies": 2, "tactics_per_strategy": 3 },
              "self_id": "p:1",
              "opponent_id": "p:2",
              "requester_id": "p:1",
              "request_id": "plan-request:sample",
              "now": "2026-01-01T09:00:00Z",
              "rows": [
                { "payload": { "kind": "subject", "subjectId": "p:1", "subjectKind": "player", "label": "Alder", "payload": { "isSelf": true }, "createdAt": "2026-01-01T09:00:00.000Z" } },
                { "payload": { "kind": "subject", "subjectId": "p:2", "subjectKind": "player", "label": "Birch", "payload": {}, "createdAt": "2026-01-01T09:00:00.000Z" } }
              ]
            },
            "output_selector": "$.request_record.promptText",
            "contains": "Create exactly 2 strategies with exactly 3 tactics each."
          }
        ]
      }
    }
