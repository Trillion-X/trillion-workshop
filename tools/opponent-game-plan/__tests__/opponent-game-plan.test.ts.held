import React from 'react';
import { cleanup, fireEvent, render, screen, waitFor } from '@testing-library/react';
import { sendRequestToBitfieldTarget } from '@bitfield/runtime-kit';
import { useBitfieldData } from '@bitfield/runtime-kit/react';
import { afterEach, beforeEach, describe, expect, it, vi } from '../../../test-helpers/vitest-shim.mjs';
import { buildAddCourtZoneProfileInput, normalizeShotRatings } from '../do-work/add-court-zone-profile.ts';
import { buildAddPlayerReportInput } from '../do-work/add-player-report.ts';
import { buildRecordTacticResultInput } from '../do-work/record-tactic-result.ts';
import {
  buildMatchPlanRecord,
  buildRequestMatchPlanInput,
  tactic,
} from '../do-work/request-match-plan.ts';
import {
  profileForPlayer,
  knownShotRatings,
  opponentSearchRows,
  readEvidenceConfidencePolicy,
  readOpponentGamePlanState,
  splitEvidenceByConfidence,
} from '../read-data/read-opponent-game-plan.ts';
import type { TennisPlayerReport } from '../read-data/opponent-game-plan-types.ts';
import { OpponentGamePlanSurface } from '../show/OpponentGamePlanSurface.tsx';

vi.mock('@bitfield/runtime-kit', () => ({
  sendRequestToBitfieldTarget: vi.fn(async () => ({ ok: true })),
}));

vi.mock('@bitfield/runtime-kit/react', () => ({
  useBitfieldData: vi.fn(),
}));

const now = new Date('2026-06-20T12:00:00.000Z');

function seedRows() {
  const selfReport = buildAddPlayerReportInput({
    authorId: 'coach:1',
    hand: 'right',
    isSelf: true,
    playerId: 'player:self',
    playerName: 'Alex',
    reportId: 'evidence:self-report',
    strengths: ['forehand'],
    styleLabels: ['all-court'],
    visibility: 'private',
    now,
  });
  const opponentReport = buildAddPlayerReportInput({
    authorId: 'player:self',
    hand: 'left',
    playerId: 'player:opponent',
    playerName: 'Roger Federer',
    reportId: 'evidence:opponent-report',
    strengths: ['forehand'],
    strategiesFailed: ['Trading pace crosscourt'],
    strategiesWorked: ['Attack second serve'],
    styleLabels: ['all-court'],
    visibility: 'public',
    weaknesses: ['backhand return'],
    now,
  });
  const selfProfile = buildAddCourtZoneProfileInput({
    playerId: 'player:self',
    profileId: 'profile-projection:self-court-zone',
    hand: 'right',
    strongestShot: 'forehand',
    weakestShot: 'backhand',
    playingStyle: 'all-court',
    shotRatings: {
      forehand: 82,
      backhand: undefined,
      volley: null,
    },
    source: { sourceId: 'source:self', visibility: 'private' },
    now,
  });
  const opponentProfile = buildAddCourtZoneProfileInput({
    playerId: 'player:opponent',
    profileId: 'profile-projection:opponent-court-zone',
    hand: 'left',
    strongestShot: 'forehand',
    weakestShot: 'backhand return',
    playingStyle: 'all-court',
    winners: { from: 'B', to: 'D', rallyContext: 'short ball after serve plus one' },
    errors: { from: 'C', rallyContext: 'pressed behind baseline' },
    shotRatings: {
      'first-serve': 91,
      'second-serve': 68,
      forehand: 95,
      backhand: 72,
      speed: 88,
    },
    source: { sourceId: 'source:opponent', visibility: 'public' },
    now,
  });
  const plan = buildMatchPlanRecord({
    planId: 'result:match-plan-1',
    requestId: 'plan-request:match-plan-1',
    selfPlayerId: 'player:self',
    opponentPlayerId: 'player:opponent',
    strategies: [
      {
        strategyId: 'strategy:1',
        name: 'Pressure the second serve',
        tactics: [
          tactic('tactic:1', 'Step in on second serve'),
          tactic('tactic:2', 'Return through the middle'),
          tactic('tactic:3', 'Follow with a forehand pattern'),
        ],
      },
      {
        strategyId: 'strategy:2',
        name: 'Make the backhand pass',
        tactics: [
          tactic('tactic:4', 'Approach to backhand'),
          tactic('tactic:5', 'Cover the line'),
          tactic('tactic:6', 'Make the next volley'),
        ],
      },
    ],
    now,
  });
  return [
    { payload: selfReport.player_record },
    { payload: selfReport.report_record },
    { payload: opponentReport.player_record },
    { payload: opponentReport.report_record },
    { payload: selfProfile.profile_record },
    { payload: opponentProfile.profile_record },
    { payload: plan },
  ];
}

const defaultEvidenceConfidencePolicy = {
  kind: 'evidence-confidence-policy' as const,
  policyId: 'opponent-game-plan.evidence-confidence-policy.default',
  minimumConfidence: 0.5,
  missingConfidenceIsUsable: false,
};

function reportWithConfidence(evidenceId: string, confidence?: number): TennisPlayerReport {
  const input = buildAddPlayerReportInput({
    authorId: 'coach:1',
    playerId: 'player:opponent',
    playerName: 'Roger Federer',
    reportId: evidenceId,
    strengths: [`strength ${evidenceId}`],
    strategiesWorked: [`worked ${evidenceId}`],
    styleLabels: ['all-court'],
    visibility: 'public',
    now,
  });
  const report = input.report_record;
  if (confidence !== undefined) {
    report.source.confidence = confidence;
  }
  return report;
}

describe('opponent-game-plan', () => {
  beforeEach(() => {
    vi.mocked(sendRequestToBitfieldTarget).mockClear();
    vi.mocked(useBitfieldData).mockReset();
  });

  afterEach(() => {
    cleanup();
  });

  it('represents old Strategy Tennis court-zone and shot-rating fields without inventing missing ratings', () => {
    const input = buildAddCourtZoneProfileInput({
      playerId: 'player:opponent',
      profileId: 'profile-projection:old-prompt',
      hand: 'left',
      quadrantMeaning: { A: 'wide forehand', D: 'wide backhand' },
      strongestShot: 'forehand',
      weakestShot: 'backhand return',
      playingStyle: 'all-court',
      winners: { from: 'B', to: 'D', rallyContext: 'short ball after serve plus one' },
      errors: { from: 'C', rallyContext: 'pressed behind baseline' },
      shotRatings: {
        'first-serve': 91,
        'second-serve': 68,
        'forehand-return': undefined,
        volley: null,
      },
      source: { sourceId: 'source:old-prompt', visibility: 'public' },
      now,
    });

    expect(input.profile_record.kind).toBe('profile-projection');
    expect(input.profile_record.projectionKind).toBe('court-zone-profile');
    expect(JSON.stringify(input.profile_record)).not.toContain('tennis-court-zone-profile');
    expect(input.profile_record.payload.winners).toEqual({ from: 'B', to: 'D', rallyContext: 'short ball after serve plus one' });
    expect(input.profile_record.payload.errors).toEqual({ from: 'C', rallyContext: 'pressed behind baseline' });
    expect(input.profile_record.payload.quadrantMeaning).toEqual({ A: 'wide forehand', D: 'wide backhand' });
    expect(knownShotRatings(input.profile_record)).toEqual({
      'first-serve': 91,
      'second-serve': 68,
    });
    expect(() => normalizeShotRatings({ forehand: 101 })).toThrow(/between 0 and 100/);
  });

  it('builds match-plan requests from self plus opponent profiles and enforces 2 strategies with 3 tactics', () => {
    const state = readOpponentGamePlanState(seedRows().concat({
      payload: buildRecordTacticResultInput({
        resultId: 'result:request-context',
        selfPlayerId: 'player:self',
        opponentPlayerId: 'player:opponent',
        planId: 'result:match-plan-1',
        strategyId: 'strategy:1',
        tacticId: 'tactic:1',
        outcome: 'worked',
        now,
      }).result_record,
    }));
    const request = buildRequestMatchPlanInput({
      requesterId: 'player:self',
      selfPlayerId: 'player:self',
      opponentPlayerId: 'player:opponent',
      selfProfile: profileForPlayer(state, 'player:self'),
      opponentProfile: profileForPlayer(state, 'player:opponent'),
      evidenceConfidencePolicy: {
        kind: 'evidence-confidence-policy',
        policyId: 'opponent-game-plan.evidence-confidence-policy.test',
        minimumConfidence: 0,
        missingConfidenceIsUsable: true,
      },
      now,
    });

    expect(request.request_record.promptText).toContain('Create exactly 2 match strategies with exactly 3 tactics each.');
    expect(request.request_record.promptText).toContain('Opponent: Roger Federer');
    expect(request.request_record.promptText).toContain('winner rally context: short ball after serve plus one');
    expect(request.request_record.promptText).toContain('strategies that worked: Attack second serve, Step in on second serve');
    expect(request.request_record.kind).toBe('plan-request');
    expect(request.request_record.requestKind).toBe('match-plan');
    expect(request.request_record.publicEvidenceRefs).toEqual(['evidence:opponent-report']);
    expect(request.request_record.privateEvidenceRefs).toEqual(['evidence:self-report']);
    expect(request.request_record.resultRefs).toEqual(['result:request-context']);
    expect(request.request_record.promptText).not.toContain('unknown');
    expect(request.request_record.promptText).not.toContain('undefined');
    expect(() => buildMatchPlanRecord({
      planId: 'result:bad-match-plan',
      requestId: 'plan-request:bad',
      selfPlayerId: 'player:self',
      opponentPlayerId: 'player:opponent',
      strategies: [
        {
          strategyId: 'strategy:bad-1',
          name: 'Only one tactic',
          tactics: [tactic('tactic:bad-1', 'One')] as never,
        },
        {
          strategyId: 'strategy:bad-2',
          name: 'Three tactics',
          tactics: [tactic('tactic:bad-2', 'One'), tactic('tactic:bad-3', 'Two'), tactic('tactic:bad-4', 'Three')],
        },
      ],
      now,
    })).toThrow(/3 tactics/);
  });

  it('fails closed when no evidence confidence policy is available', () => {
    const reports = [
      reportWithConfidence('evidence:high-confidence', 0.85),
      reportWithConfidence('evidence:low-confidence', 0.2),
    ];

    expect(readEvidenceConfidencePolicy([{ payload: reports[0] }])).toBeNull();
    expect(splitEvidenceByConfidence(reports, null)).toEqual({
      usable: [],
      needsReview: reports,
    });
  });

  it('requires review for missing or below-threshold evidence confidence and allows high confidence', () => {
    const missingConfidence = reportWithConfidence('evidence:missing-confidence');
    const lowConfidence = reportWithConfidence('evidence:low-confidence', 0.2);
    const highConfidence = reportWithConfidence('evidence:high-confidence', 0.85);

    const split = splitEvidenceByConfidence([
      missingConfidence,
      lowConfidence,
      highConfidence,
    ], defaultEvidenceConfidencePolicy);

    expect(split.usable.map((report) => report.evidenceId)).toEqual(['evidence:high-confidence']);
    expect(split.needsReview.map((report) => report.evidenceId)).toEqual([
      'evidence:missing-confidence',
      'evidence:low-confidence',
    ]);
  });

  it('excludes low-confidence review evidence from match-plan context and records review refs', () => {
    const rows = seedRows();
    const selfReport = rows[1]?.payload as TennisPlayerReport;
    const opponentReport = rows[3]?.payload as TennisPlayerReport;
    selfReport.source.confidence = 0.85;
    opponentReport.source.confidence = 0.2;
    const state = readOpponentGamePlanState(rows);

    const request = buildRequestMatchPlanInput({
      requesterId: 'player:self',
      selfPlayerId: 'player:self',
      opponentPlayerId: 'player:opponent',
      selfProfile: profileForPlayer(state, 'player:self'),
      opponentProfile: profileForPlayer(state, 'player:opponent'),
      evidenceConfidencePolicy: defaultEvidenceConfidencePolicy,
      now,
    });

    expect(request.request_record.privateEvidenceRefs).toEqual(['evidence:self-report']);
    expect(request.request_record.publicEvidenceRefs).toEqual([]);
    expect(request.request_record.reviewEvidenceRefs).toEqual(['evidence:opponent-report']);
    expect(request.request_record.promptText).not.toContain('Attack second serve');
    expect(request.request_record.promptText).not.toContain('Trading pace crosscourt');
    expect(request.request_record.promptText).toContain('strongest: forehand');
  });

  it('reads opponent search rows and profiles from package records', () => {
    const state = readOpponentGamePlanState(seedRows().concat([
      {
        payload: buildRecordTacticResultInput({
          resultId: 'result:tactic-1',
          selfPlayerId: 'player:self',
          opponentPlayerId: 'player:opponent',
          planId: 'result:match-plan-1',
          strategyId: 'strategy:1',
          tacticId: 'tactic:1',
          outcome: 'worked',
          now,
        }).result_record,
      },
      {
        payload: buildRecordTacticResultInput({
          resultId: 'result:tactic-2',
          selfPlayerId: 'player:self',
          opponentPlayerId: 'player:opponent',
          planId: 'result:match-plan-1',
          strategyId: 'strategy:1',
          tacticId: 'tactic:2',
          outcome: 'failed',
          now,
        }).result_record,
      },
    ]));

    const rows = opponentSearchRows(state);
    expect(rows).toEqual([expect.objectContaining({
      name: 'Roger Federer',
      reportCount: 1,
      profileCount: 1,
      workedCount: 1,
      failedCount: 1,
    })]);
    const profile = profileForPlayer(state, 'player:opponent');
    expect(profile.strategiesWorked).toEqual(expect.arrayContaining(['Attack second serve', 'Step in on second serve']));
    expect(profile.strategiesFailed).toEqual(expect.arrayContaining(['Trading pace crosscourt', 'Return through the middle']));
  });

  it('renders private scouting submission through the add-report owner action', async () => {
    vi.mocked(useBitfieldData).mockReturnValue(seedRows());

    render(React.createElement(OpponentGamePlanSurface, {
      selfPlayerId: 'player:self',
      userId: 'player:self',
    }));

    fireEvent.change(screen.getByPlaceholderText('Add what worked against this player'), {
      target: { value: 'Attack second serve' },
    });
    fireEvent.click(screen.getByRole('button', { name: 'Save scouting' }));

    await waitFor(() => expect(sendRequestToBitfieldTarget).toHaveBeenCalledTimes(1));
    expect(vi.mocked(sendRequestToBitfieldTarget).mock.calls[0]?.[0]).toMatchObject({
      target: 'slot::workflow',
      payload: {
        operation: 'execute_definition',
        definition_id: 'action:opponent-game-plan.add-report',
        input: {
          player_id: 'player:opponent',
          report_record: {
            kind: 'evidence',
            evidenceKind: 'player-report',
            payload: {
              visibility: 'private',
              strategiesWorked: ['Attack second serve'],
            },
          },
        },
      },
    });
  });

  it('renders match-plan request and tactic result actions', async () => {
    vi.mocked(useBitfieldData).mockReturnValue(seedRows());

    render(React.createElement(OpponentGamePlanSurface, {
      selfPlayerId: 'player:self',
      userId: 'player:self',
    }));

    fireEvent.click(screen.getByRole('button', { name: 'Get match plan' }));
    await waitFor(() => expect(sendRequestToBitfieldTarget).toHaveBeenCalledTimes(1));
    expect(vi.mocked(sendRequestToBitfieldTarget).mock.calls[0]?.[0]).toMatchObject({
      payload: {
        definition_id: 'action:opponent-game-plan.request-plan',
        input: {
          request_record: {
            selfPlayerId: 'player:self',
            opponentPlayerId: 'player:opponent',
          },
        },
      },
    });

    fireEvent.click(screen.getAllByRole('button', { name: 'Worked' })[0]);
    await waitFor(() => expect(sendRequestToBitfieldTarget).toHaveBeenCalledTimes(2));
    expect(vi.mocked(sendRequestToBitfieldTarget).mock.calls[1]?.[0]).toMatchObject({
      payload: {
        definition_id: 'action:opponent-game-plan.record-result',
        input: {
          result_record: {
            kind: 'result',
            resultKind: 'tactic-outcome',
            payload: {
              planId: 'result:match-plan-1',
              tacticId: 'tactic:1',
              outcome: 'worked',
            },
          },
        },
      },
    });
  });
});
