[Unit]
Description={description}
After=network-online.target
Wants=network-online.target

[Service]
# The computer's account key is the vault value {secret_vault_key}: start-a-computer seals it for this computer (systemd-creds)
# at {secret_file}; this unit names only where. The helper reads it from standard input at start (--key-stdin), so the key is
# never in argv, a file the unit writes or a log.
LoadCredentialEncrypted={secret_name}:{secret_file}
Environment=HOME={home}
Environment=PATH={node_bin}:/usr/bin:/bin
Environment=npm_config_cache={workshop}/.npm-cache
Type=simple
User={user}
Group={user}
# The Workshop copy at {workshop} stays between starts: the row's pinned commit {workshop_commit} is fetched into it (only what
# the copy lacks) and checked out. npm ci runs only when that commit's package-lock.json is not the one installed last time,
# whose git id is kept in the copy's .git/npm-lock-id.
ExecStartPre=/bin/sh -c 'test -d {workshop}/.git || git init -q {workshop}'
ExecStartPre=/bin/sh -c 'git -C {workshop} fetch -q --depth 1 {repository} {workshop_commit} && git -C {workshop} checkout -q --detach {workshop_commit}'
ExecStartPre=/bin/sh -c 'lock=$$(git -C {workshop} rev-parse {workshop_commit}:package-lock.json) && if [ "$$(cat {workshop}/.git/npm-lock-id 2>/dev/null)" != "$$lock" ]; then cd {workshop} && npm ci --omit=dev --no-audit --no-fund && echo "$$lock" > {workshop}/.git/npm-lock-id; fi'
ExecStart=/bin/sh -c 'cd {workshop} && cat "$CREDENTIALS_DIRECTORY/{secret_name}" | exec node tools/keep-and-wake-ai-sessions-on-this-computer/harness/wake-sessions.mjs --key-stdin'
Restart=on-failure
RestartSec=3
KillSignal=SIGTERM
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths={writable}
ProtectHome=true
PrivateTmp=true
LimitCORE=0

[Install]
WantedBy=multi-user.target
