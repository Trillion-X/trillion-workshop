        "kind": "ai-tool-descriptor",
        "id": "tool:manage-harness",
        "listed_on": "2026-10-08T00:00:00Z",
        "label": "Set up an AI harness on a computer",
        "job": "Inspect, apply or remove the account's hooks for one chosen AI harness on an exact owned computer",
        "description": "Runs the shared signed-app harness installer on the exact recorded computer. Inspect is observational; apply and remove require authorization. Preserves other settings, disabled hooks, managed policies, models and permissions. A configured hook is not evidence of execution. Codex trust requires explicit review of all current definition hashes and refuses changed definitions before writing. Returns the original typed report with computer attribution. Requires the installed computer host to advertise this tool and its exact computer scope; old or offline hosts remain unavailable. No shell, arbitrary module, download, model launch or personal-file import can be selected. After apply, run inspect again to obtain current evidence.",
        "status": "active",
        "licence_class": "licence:maker-own",
        "maker": "maker:keep-and-wake-ai-sessions-on-this-computer",
        "placements": [
          "placement:your-computer"
        ],
        "needs": {
          "expected_seconds": 45,
          "network_egress": true
        },
        "input_schema": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "computer_id",
            "harness",
            "action"
          ],
          "properties": {
            "computer_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,159}$"
            },
            "harness": {
              "type": "string",
              "enum": [
                "claude-code",
                "codex"
              ]
            },
            "action": {
              "type": "string",
              "enum": [
                "inspect",
                "apply",
                "remove"
              ]
            },
            "trust_hooks": {
              "type": "boolean",
              "description": "Only true for an explicitly authorized Codex apply after reviewing the exact current definitions."
            },
            "reviewed_definition_hashes": {
              "type": "array",
              "minItems": 4,
              "maxItems": 4,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "description": "All current configuration.evidence.hooks definition_hash values from the reviewed inspect report; required only when trust_hooks is true."
            }
          }
        },
        "output_schema": {
          "type": "object",
          "required": [
            "schema",
            "computer_id",
            "scope_id",
            "observed_at",
            "owner_reported_at",
            "verification_basis",
            "report"
          ],
          "properties": {
