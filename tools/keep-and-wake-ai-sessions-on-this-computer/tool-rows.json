          "type": "object",
          "required": ["action", "client"],
          "additionalProperties": false,
          "properties": {
            "action": {"type": "string", "enum": ["mcp-inspect", "mcp-preview", "mcp-register", "mcp-unregister"], "description": "mcp-inspect and mcp-preview read only; mcp-register and mcp-unregister change the apps' config and are run only when the person asks."},
            "client": {"type": "string", "pattern": "^(claude-code|codex|gemini-cli|cursor)(,(claude-code|codex|gemini-cli|cursor))*$", "description": "The AI apps, comma-separated."},
            "reviewed": {"type": "string", "description": "For mcp-register: the review_hash mcp-preview answered, after the person has seen the change."}
          }
        },
        "output_schema": {
          "type": "object",
          "required": ["schema", "action", "results"],
          "properties": {
            "schema": {"type": "string", "const": "trillion.mcp-registration-report/v1"},
            "action": {"type": "string"},
            "review_hash": {"type": "string"},
            "results": {"type": "array", "items": {"type": "object"}}
          }
        },
        "invoke": {
          "kind": "on-your-computer",
          "get_it": ["clone the Workshop repository (package.json repository.url)", "npm ci, from the root of the checkout"],
          "run": "node tools/keep-and-wake-ai-sessions-on-this-computer/harness/setup.mjs --action {action} --client {client}",
          "needs": ["node"],
          "say": "This runs on the person's own computer, from the root of the Workshop checkout. Run mcp-preview, show the person each app's change, and only when they say yes run mcp-register with `--reviewed` and that review_hash added at the end of `run`. Then tell them each result's sign_in step. If you cannot run commands, give them these steps."
