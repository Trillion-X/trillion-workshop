  {
   "kept_as": "generated context",
   "pattern": "^\\s*<(?:hook_prompt\\s+hook_run_id=|(?:system-reminder|trillion-message|environment_context|codex_internal_context|codex_delegation|codex_app\\.send_message_to_thread|heartbeat|user_instructions|skills_instructions|recommended_plugins|permissions instructions|collaboration_mode|INSTRUCTIONS|task-notification|local-command-caveat|local-command-stdout|local-command-stderr|bash-stdout|bash-stderr|turn_aborted|user_shell_command|subagent_notification|channel)\\b)"
  },
  {
   "kept_as": "peer",
   "pattern": "^\\s*<(agent-message|teammate-message|cross-session-message)\\b"
  },
  {
   "kept_as": "peer",
   "pattern": "^\\s*From [^\\n]{0,60}?\\b(?:AI|Claude|Codex|ChatGPT|GPT|Gemini|agent|assistant)\\b[^\\n]{0,30}?\\b(?:session|orchestrator)\\b"
  },
  {
   "kept_as": "peer",
   "pattern": "^\\s*Another Claude session sent a message:\\s*<(teammate-message|cross-session-message|agent-message)\\b"
  },
  {
   "kept_as": "generated context",
   "pattern": "^\\s*# AGENTS\\.md instructions\\b"
  },
  {
   "kept_as": "generated context",
   "pattern": "^\\s*\\[Request interrupted by user"
  },
  {
   "kept_as": "generated context",
   "pattern": "^\\s*\\[Image: source: "
  }
 ],
 "execution_references": {
  "_what": "Only explicitly named identity metadata from a supported tool's structured input/result. Arbitrary typed record kinds are accepted as claims, not verified records; URI schemes, native paths and unqualified provider ids are not identities here. Namespace file identities retain their exact complete hash. No payload, prose or shell parsing. Limits match the execution receipt owner; a refusal retains the transcript cursor. The complete native result already has its own result_source owner: link that identity without duplicating its bytes.",
  "max_references": 201,
  "max_bytes": 524288,
  "identity_patterns": [
   "^(?:file:)?(?:1f|12):[0-9a-f]{64}$",
   "^[a-z][a-z0-9_-]+:[^\\s\\\\]+$"
  ],
