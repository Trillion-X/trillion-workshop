     "tool": "tool:tell-each-ai-what-is-new",
     "input": {
      "reader": "{reader}"
     }
    },
    "list_path": [
     "notices"
    ],
    "said_path": [
     "said"
    ]
   }
  },
  {
   "id": "prompt",
