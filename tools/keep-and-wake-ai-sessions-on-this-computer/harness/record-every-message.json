  "execution_references": {
    "_what": "Only explicitly named identity metadata from a supported tool's structured input/result. Arbitrary typed record kinds are accepted as claims, not verified records; URI schemes, native paths and unqualified provider ids are not identities here. Namespace file identities retain their exact complete hash. No payload, prose or shell parsing. Limits match the execution receipt owner; a refusal retains the transcript cursor. The complete native result already has its own result_source owner: link that identity without duplicating its bytes.",
    "max_references": 201,
    "max_bytes": 524288,
    "identity_patterns": [
      "^(?:file:)?(?:1f|12):[0-9a-f]{64}$",
