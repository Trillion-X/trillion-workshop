{
  "id": "simple-workspace",
  "label": "Simple workspace",
  "inherits": [],
  "rules": [
    {
      "id": "only-the-everyday-controls",
      "label": "Only collapse and resize the sidebar; one screen, with sharing and no tab chrome or comments",
      "subject": "control",
      "effect": "hide",
      "when": {
        "kind": "group",
        "combinator": "and",
        "negate": false,
        "rules": [
          {
            "kind": "rule",
            "field": "within",
            "operator": "has_any_of",
            "params": {
              "values": [
                "sidebar.position",
                "sidebar.undock",
                "sidebar.hide",
                "sidebar.row-preview",
                "arrangement.header.tabs",
                "arrangement.header.actions",
                "arrangement.header.new-tab",
                "arrangement.split",
                "open.open-beside",
                "open.open-as-window",
                "selection.responses",
                "selection.tray",
                "comments",
                "sidebar.list.pin",
                "sidebar.list.unpin",
                "sidebar.list.auto-hide",
                "sidebar.list.add",
                "sidebar.row.actions",
                "sidebar.row.move",
                "sidebar.content",
                "arrangement.header.nav",
                "arrangement.navigation",
                "arrangement.layouts",
                "arrangement.empty.layouts",
                "arrangement.empty.folders",
                "arrangement.empty.open-as",
                "arrangement.empty.start"
              ]
            }
          }
        ]
      }
    },
    {
      "id": "only-the-everyday-screens",
      "label": "Messages, files, media, lists, shared projects, settings and connecting your AI stay in reach",
      "subject": "screen",
      "effect": "change",
      "when": {
        "kind": "group",
        "combinator": "and",
        "negate": false,
        "rules": [
          {
            "kind": "rule",
            "field": "screen",
            "operator": "is_none_of",
            "params": {
              "values": [
                "trillion.messages",
                "trillion.files",
                "trillion.media",
                "trillion.lists",
                "trillion.settings",
                "trillion.ai"
              ]
            }
          },
          {
            "kind": "group",
            "combinator": "or",
            "negate": true,
            "rules": [
              {
                "kind": "rule",
                "field": "list",
                "operator": "is_any_of",
                "params": {
                  "values": [
                    "pursuits"
                  ]
                }
              },
              {
                "kind": "rule",
                "field": "from",
                "operator": "is_any_of",
                "params": {
                  "values": [
                    "pursuit-navigation"
                  ]
                }
              }
            ]
          }
        ]
      },
      "set": [
        {
          "path": [
            "listed"
          ],
          "value": false
        }
      ]
    },
    {
      "id": "everyday-destinations-together",
      "label": "Keep the everyday destinations together",
      "subject": "screen",
      "effect": "change",
      "when": {
        "kind": "group",
        "combinator": "and",
        "negate": false,
        "rules": [
          {
            "kind": "rule",
            "field": "screen",
            "operator": "is_any_of",
            "params": {
              "values": [
                "trillion.messages",
                "trillion.files",
                "trillion.media",
                "trillion.lists",
                "trillion.settings"
              ]
            }
          }
        ]
      },
      "set": [
        {
          "path": [
            "sidebar_collection"
          ],
          "value": "everyday"
        }
      ]
    },
    {
      "id": "one-container-one-tab",
      "label": "One container and one tab in the permitted tiled presentation",
      "subject": "arrangement",
      "effect": "change",
      "when": null,
      "set": [
        {
          "path": [
            "constraints"
          ],
          "value": {
            "max_containers": 1,
            "max_tabs": 1,
            "allowed_surfaces": [
              "tiled"
            ]
          }
        }
      ]
    }
  ]
}
