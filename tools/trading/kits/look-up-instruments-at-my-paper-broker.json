  "worked_examples": [
    {
      "title": "Look up instruments at my paper broker on a sample input",
      "ask": "Run tool:look-up-instruments-at-my-paper-broker.",
      "mcp": {
        "server": "trillion",
        "tool": "run_resource_operation",
        "input": {
          "address": "@workshop-tools",
          "method": "tools:run",
          "input": {
            "tool": "tool:look-up-instruments-at-my-paper-broker",
            "input": {
              "route": {
                "mode": "paper",
                "timeout_ms": 5000,
                "instrument_requests": {
                  "equity": {
                    "url": "https://paper-broker.example.test/v1/orders",
                    "method": "POST",
                    "headers": {
                      "accept": "application/json",
                      "content-type": "application/json"
                    },
                    "body_template": {
                      "symbol": "{instrument.symbol}",
                      "qty": "{qty}",
                      "side": "{side}",
                      "type": "{order_type}",
                      "limit_price": {
                        "from": "limit_price",
                        "optional": true
                      },
                      "time_in_force": "{time_in_force}",
                      "client_order_id": "{order_id}"
                    }
                  }
                },
                "credential_injections": [
                  {
                    "field": "key_id",
                    "placement": {
                      "kind": "header",
                      "name": "X-Sample-Key"
                    }
                  },
                  {
                    "field": "secret",
                    "placement": {
                      "kind": "header",
                      "name": "X-Sample-Secret"
                    }
                  }
                ],
                "response_map": {
                  "broker_order_id": "id",
                  "broker_status": "status",
                  "filled_qty": "filled_qty",
                  "filled_avg_price": "filled_avg_price",
                  "filled_at": "filled_at",
                  "client_order_id": "client_order_id"
                },
                "status_map": {
                  "new": "submitted",
                  "accepted": "submitted",
                  "partially_filled": "partially_filled",
                  "filled": "filled",
                  "canceled": "canceled",
                  "rejected": "rejected",
                  "__default__": "submitted"
                },
                "status_request": {
                  "url": "https://paper-broker.example.test/v1/orders/by-client-id/{order_id}",
                  "method": "GET"
                },
                "open_statuses": [
                  "submitted",
                  "partially_filled"
                ],
                "lookups": {
                  "contracts": {
                    "url": "https://paper-broker.example.test/v1/contracts",
                    "query": {
                      "status": "active",
                      "limit": "100"
                    },
                    "query_names": [
                      "underlying",
                      "type",
                      "status",
                      "limit",
                      "page"
                    ],
                    "items_at": "contracts",
                    "id_field": "symbol",
                    "keep_when": {
                      "tradable": true
                    },
                    "numbers": [
                      "strike",
                      "close_price"
                    ],
                    "whole_numbers": [
                      "open_interest",
                      "size"
                    ],
                    "keep_fields": [
                      "symbol",
                      "tradable",
                      "strike",
                      "expires",
                      "type",
                      "close_price",
                      "open_interest",
                      "size",
                      "underlying"
                    ],
                    "sort_by": {
                      "field": "open_interest",
                      "order": "descending"
                    },
                    "next_at": "next_page"
                  }
                }
              },
              "lookup": "contracts",
              "query": {
                "underlying": "SAMPLE",
                "type": "call",
                "limit": "2"
              }
            }
          }
        }
      },
      "hands_back": "An answer with the fields state, http_status, count, items, next, note."
