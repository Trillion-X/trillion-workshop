                  },
                  "status_map": {
                    "new": "submitted",
                    "accepted": "submitted",
                    "partially_filled": "partially_filled",
                    "filled": "filled",
                    "canceled": "canceled",
                    "rejected": "rejected",
                    "__default__": "submitted"
