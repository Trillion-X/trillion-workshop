            "kind": "ask",
            "config": {
              "name": "slot::http-client",
              "input": {
                "url": {
                  "$kind": "binding",
                  "select": {
                    "from": "steps",
                    "key": "prepare_request",
                    "path": "output.captured_fds.0.bytes.base64"
                  },
                  "transform": [
                    {
                      "op": "op:core.decode",
                      "args": {
                        "encoding": "base64"
                      }
                    },
                    {
                      "op": "op:core.json_parse"
                    },
                    {
                      "op": "op:core.lookup",
                      "args": {
                        "key": "url"
                      }
                    }
                  ]
                },
                "method": {
                  "$kind": "binding",
                  "select": {
                    "from": "steps",
                    "key": "prepare_request",
                    "path": "output.captured_fds.0.bytes.base64"
                  },
                  "transform": [
                    {
                      "op": "op:core.decode",
                      "args": {
                        "encoding": "base64"
                      }
                    },
                    {
                      "op": "op:core.json_parse"
                    },
                    {
                      "op": "op:core.lookup",
                      "args": {
                        "key": "method"
                      }
                    }
                  ]
                },
                "headers": {
                  "$kind": "binding",
                  "select": {
                    "from": "steps",
                    "key": "prepare_request",
                    "path": "output.captured_fds.0.bytes.base64"
                  },
                  "transform": [
                    {
                      "op": "op:core.decode",
                      "args": {
                        "encoding": "base64"
                      }
                    },
                    {
                      "op": "op:core.json_parse"
                    },
                    {
                      "op": "op:core.lookup",
                      "args": {
                        "key": "headers"
                      }
                    }
                  ]
                },
                "body": null,
                "credential_injections": {
                  "$kind": "binding",
                  "select": {
                    "from": "steps",
                    "key": "mint_handles",
                    "path": "output"
                  }
                },
                "timeout_ms": 30000
              }
            }
          },
          {
            "id": "normalize_account",
            "kind": "ask",
            "config": {
              "name": "compute.process",
              "input": {
                "argv": [
                  "python3",
                  "-c",
                  "import json,sys\nout=sys.argv[1]\ntry: resp=json.loads(sys.argv[2])\nexcept Exception: resp={}\nbody=resp.get('body') if isinstance(resp,dict) else None\nif isinstance(body,list):\n    try: body=bytes(body).decode('utf-8')\n    except Exception: body=None\nif isinstance(body,str):\n    try: body=json.loads(body)\n    except Exception: body=None\nacct=body if isinstance(body,dict) else {}\nsc=resp.get('status_code') if isinstance(resp,dict) else None\nok=bool(acct.get('account_number') or acct.get('id'))\nview={'state':'live' if ok else 'error','http_status':sc,'account':{k:acct.get(k) for k in ('account_number','status','currency','cash','portfolio_value','buying_power','equity','long_market_value','short_market_value','daytrade_count','pattern_day_trader') if k in acct},'fetched_at':__import__('datetime').datetime.now(__import__('datetime').timezone.utc).isoformat()}\njson.dump(view,open(out,'w'))\nprint(json.dumps(view))",
