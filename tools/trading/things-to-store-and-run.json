          {
            "id": "prepare_request",
            "kind": "ask",
            "config": {
              "name": "compute.process",
              "input": {
                "argv": [
                  "python3",
                  "-c",
                  "import json,sys\nout=sys.argv[1]; data=json.loads(sys.argv[2])\ncfg=(data.get('payload') if data.get('found') else None) or {}\nreq=cfg.get('request') or {}\nhx=lambda s:''.join(format(b,'02x') for b in s.encode())\ninj=[{'secret_name':'service-connection-'+hx(cfg.get('connection_id',''))+'-field-'+hx(i.get('field_id','')),'placement':i.get('placement')} for i in (req.get('credential_injections') or [])]\nplan={'url':req.get('url',''),'method':req.get('method','GET'),'headers':req.get('headers') or {},'injections':inj,'account_address':cfg.get('account_address'),'config_found':bool(data.get('found'))}\njson.dump(plan,open(out,'w'))\nprint(json.dumps(plan))",
                  "account-plan.json",
                  {
                    "$kind": "binding",
                    "select": {
                      "from": "steps",
                      "key": "read_config",
                      "path": "output.text"
                    }
                  }
                ],
                "cwd": null,
                "timeout_ms": 60000,
                "termination_grace_ms": 1000,
                "expected_termination": null,
                "env": {},
                "inputs": [],
                "input_trees": [],
                "outputs": [
                  {
                    "mount_path": "account-plan.json",
                    "content_type": "application/json"
                  }
                ],
                "containment": {
                  "kind": "descendant_effect_contained",
                  "pipe_eof_timeout_ms": 1000,
                  "publications": []
                },
                "capture_fds": [
                  1,
                  2
                ],
                "collected_files": []
              }
            }
          },
          {
            "id": "mint_handles",
            "kind": "loop",
            "config": {
              "source": {
                "$kind": "binding",
                "select": {
                  "from": "steps",
                  "key": "prepare_request",
                  "path": "output.captured_fds.0.bytes.base64"
                },
                "transform": [
                  {
                    "op": "op:core.decode",
                    "args": {
                      "encoding": "base64"
                    }
                  },
                  {
                    "op": "op:core.json_parse"
                  },
                  {
                    "op": "op:core.lookup",
