    {
      "payload": {
        "kind": "ai-tool-descriptor",
        "id": "tool:cut-a-hostname-over-to-a-new-address",
        "label": "Cut a hostname over to a new address",
        "job": "Point one exact hostname of mine at a new server's address, keeping every other DNS record and route, and roll it back if I ask",
        "description": "Through the DNS row of the person's Service connections list (the current door's, unless `dns_provider` names one): `prepare` reads the zone and keeps a receipt under `cutover` in their Public door receipts list with the one address record or production Worker domain that `hostname` holds now; `activate` points it at `address` and reads it back; `rollback` puts back what prepare read; `status` answers where the cutover stands without asking the provider. Before every change it checks that no other record, route or domain changed since prepare, and refuses when one did. A change whose answer was lost is reconciled from what the provider shows, never sent twice. The DNS key comes from the vault by the row's vault name and is never shown.",
        "status": "active",
        "input_schema": {
          "type": "object",
          "additionalProperties": false,
          "required": ["action", "cutover", "hostname", "address"],
          "properties": {
            "action": { "enum": ["prepare", "activate", "rollback", "status"] },
            "cutover": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,119}$" },
            "hostname": { "type": "string" },
            "address": { "type": "string", "description": "The new server's public IPv4." },
            "dns_provider": { "type": "string" }
          }
        },
        "output_schema": {
