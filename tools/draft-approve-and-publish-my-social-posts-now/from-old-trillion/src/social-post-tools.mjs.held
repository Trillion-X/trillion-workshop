// The MCP tools for a person's posts (src/social-posts.mjs): where they can post, connecting a new place, drafting a
// post, approving it after the person has looked at it, publishing it now or at its time (also from a schedule or a
// rule, as tool:publish-a-post), checking it is ready for each place, reading back where it went, listing posts, and what is on the calendar between two times.
import settings from './social-posts.json' with { type: 'json' };

const postId = { type: 'string', description: 'A post_id from draft_post or list_posts' };

export const socialPostTools = call => [
  { name: 'list_post_destinations', description: 'The accounts this person can post to (each account_id, platform, name and whether it is ready), and for every place they have not connected yet a connect_url to open and connect it. It changes nothing in their posts. Use the account_id values as draft_post destinations.', inputSchema: { type: 'object', properties: {} }, run: () => call('/posts/destinations') },
  { name: 'connect_post_destination', description: 'The link that connects one place to post (platform, as named in list_post_destinations not_connected). Give the link to the person; once they connect it, list_post_destinations shows the new account.', inputSchema: { type: 'object', required: ['platform'], properties: { platform: { type: 'string', description: 'A platform from list_post_destinations' } } }, run: input => call('/posts/connect', input) },
  { name: 'draft_post', description: 'Keeps a post as a draft for the person to look at: caption (the words), media (a video or picture from their files, by file name or identity from list_media), an optional source { kind, id } from shape_into_formats and format_id from content_formats (the source link is checked against this account and saved without copying its words), and optionally destinations (account_id values from list_post_destinations; a draft may be kept going nowhere yet, as when the person has not connected a place to post, but it cannot be approved until it has at least one), caption_by_platform ({ platform: words } where one place needs different words), settings_by_platform ({ platform: { ... } } that place\'s own settings, like a video title), link (an https page, such as where people sign up; it is added after the words, tagged with the post and the place), scheduled_for (a date and time with its zone), time_zone and media_facts. The answer\'s ready says, for each destination, whether that place will take the post and what is missing, as check_post does; for a draft going nowhere it says to pick where it goes, with pick_from (the connected accounts, and the places not connected yet: connect_post_destination gives the link for one). Give post_id to change a draft; changing an approved post, or one set for later that nothing was sent for yet, makes it a draft again. Nothing is posted.', inputSchema: {
    type: 'object',
    properties: {
      post_id: postId,
      caption: { type: 'string' },
      source: { type: 'object', required: ['kind', 'id'], additionalProperties: false, properties: { kind: { type: 'string' }, id: { type: 'string' } }, description: 'A checked source reference from shape_into_formats' },
      format_id: { type: 'string', description: 'A format id from content_formats' },
      media: { type: 'string', description: 'A file name like /Media/clip.mp4, or a file identity' },
      destinations: { type: 'array', items: { type: 'string' }, description: 'account_id values from list_post_destinations' },
      caption_by_platform: { type: 'object', additionalProperties: { type: 'string' } },
      settings_by_platform: { type: 'object', additionalProperties: { type: 'object' } },
      link: { type: 'string', format: 'uri' },
      reaches: { type: 'array', maxItems: settings.first_contact.most, description: 'The people outside Trillion this post contacts first, as tool:find-people-outside-trillion gives them, each with where they were found. A post that lists anyone, or whose words name anyone (@handle), is approved only by the person on their Posts screen.', items: { type: 'object', required: ['handle', 'profile_url', 'provenance'], properties: { network: { type: 'string' }, handle: { type: 'string' }, profile_url: { type: 'string', format: 'uri' }, sought: { type: 'string', description: 'What the person seeks from them, in the person\'s own words, so the person\'s computer can check the message says only what was found and sought' }, provenance: { type: 'array', minItems: 1, maxItems: settings.first_contact.provenance_most, items: { type: 'object', required: ['source', 'url'], properties: { source: { type: 'string' }, url: { type: 'string', format: 'uri' }, title: { type: 'string' }, posted_at: { type: 'string' } } } } } } },
      media_facts: { type: 'object', properties: { duration_seconds: { type: 'number' }, width: { type: 'number' }, height: { type: 'number' } }, description: 'What you know about the video or picture that its file does not say (its length in seconds, width and height), so each place\'s length and shape limits are checked' },
      scheduled_for: { type: 'string', format: 'date-time' },
      time_zone: { type: 'string', description: 'Like America/New_York' },
      hold_seconds: { type: ['integer', 'null'], description: `Optional. Keep the send waiting this many seconds after publish_post (0 to ${settings.hold.max_seconds}), so undo_post can take it back first. null removes it.` },
      abort_on_reply: { type: ['object', 'null'], properties: { conversation_id: { type: 'string' } }, description: 'Optional. { conversation_id } of a conversation (from read_messages): if someone else writes in it after this post was set to go out, the post is not sent and becomes a draft again. null removes it.' },
    },
  }, run: input => call('/posts/draft', input) },
  { name: 'approve_post', description: 'Approves a drafted post after its review, so publish_post may send it. Pass the complete approval_values from the exact post that was reviewed as expected_values: approval refuses if its content, destinations or timing changed. A post going nowhere yet is refused: give it destinations with draft_post first. A post that reaches someone (its words name a @handle, or it lists people in reaches) is approved only by the person, pressing Approve on their Posts screen (show_screen Posts); an AI\'s approval of it is refused. Only an approved post is ever published, exactly as approved.', inputSchema: { type: 'object', required: ['post_id'], properties: { post_id: postId,
    expected_values: { type: 'object', description: 'The complete approval_values object from the reviewed draft_post/read_post post. All outgoing fields are required, including explicit nulls. Omit only for the existing current-draft approval contract.' },
  } }, run: input => call('/posts/approve', input) },
  { name: 'publish_post', description: 'Publishes an approved post to each of its destinations: now, or, when its scheduled_for is still ahead, by a schedule Trillion sets for that time. It refuses a post that is not approved. Calling it again never posts twice: it sends only to places that have not taken the post; a place whose outcome is not known is sent again only when its account_id is in resend, after checking the place. Leave post_id out to publish the approved post that has waited longest. To publish on a schedule or when something happens, use set_schedule or set_rule with then { "tool_id": "tool:publish-a-post", "input": { "post_id": "..." } } (or no post_id, for the next approved post).', inputSchema: { type: 'object', properties: { post_id: postId, resend: { type: 'array', items: { type: 'string' }, description: 'account_id values whose outcome was not known, checked and found missing' } } }, run: input => call('/posts/publish', input) },
  { name: 'undo_post', description: 'Takes back a post that is waiting to go out (held by hold_seconds, or set for later) and has not begun to send: it becomes a draft again and nothing is sent. A post already on its way cannot be taken back.', inputSchema: { type: 'object', required: ['post_id'], properties: { post_id: postId } }, run: input => call('/posts/undo', input) },
  { name: 'check_post', description: 'Whether a post is ready for each place it is going, before it is approved or published: for each destination, ready (true or false), problems (what that place will refuse, in plain words: words too long for it, a video or picture it needs, a kind or size of file it does not take, a setting it needs such as a YouTube title) and not_checked (limits Trillion could not compare, such as a video\'s length it was not told; give media_facts to draft_post to have them checked). Fix a problem with draft_post (caption_by_platform, settings_by_platform or media). It changes nothing.', inputSchema: { type: 'object', required: ['post_id'], properties: { post_id: postId } }, run: input => call('/posts/check', input) },
  { name: 'read_post', description: 'Reads one post, asking the service where each copy is now: its status (draft, approved, scheduled, posted, failed or partial), the address of each published copy (platform_urls), and anything that went wrong, in plain words.', inputSchema: { type: 'object', required: ['post_id'], properties: { post_id: postId } }, run: input => call('/posts/read', input) },
  { name: 'list_post_calendar', description: 'What is on this person\'s posting calendar between from and to (dates and times with their zone, at most a year or so apart): each post whose scheduled time falls in between (or, sent without a time, when it was sent), earliest first, with its status, words and at; and the drafts and approved posts with no time yet (unscheduled). can_move says whether a post can still get a new time: draft_post with post_id and scheduled_for gives it one (or scheduled_for null to take its time away), which makes an approved or scheduled post a draft again to approve. It changes nothing.', inputSchema: { type: 'object', required: ['from', 'to'], properties: { from: { type: 'string', format: 'date-time' }, to: { type: 'string', format: 'date-time' } } }, run: ({ from, to }) => call(`/posts/calendar?from=${encodeURIComponent(from)}&to=${encodeURIComponent(to)}`) },
  { name: 'list_posts', description: 'This person\'s posts, newest first, each with its status, words, video, destinations and published addresses, as last read. Give status to see only draft, approved, scheduled, posted, failed or partial posts. It changes nothing.', inputSchema: { type: 'object', properties: { status: { type: 'string' } } }, run: ({ status } = {}) => call(`/posts${status ? `?status=${encodeURIComponent(status)}` : ''}`) },
  { name: 'read_voice', description: 'How this person writes, to read BEFORE you draft anything for them (a post, an email, a message): the voice profiles saved so far, the person\'s own recent edits to words an AI wrote (each edit has the draft as it was and the words they changed it to), and words they published. Write the way they write; when their edits show something the profile lacks, save it with save_voice. Give kind (like post) to read one kind of writing. It changes nothing.', inputSchema: { type: 'object', properties: { kind: { type: 'string', description: 'A kind of writing, like post or email; leave out for every kind' }, limit: { type: 'integer', description: 'How many recent edits (up to 50)' } } }, run: input => call('/posts/voice/read', input ?? {}) },
  { name: 'save_voice', description: 'Saves what you learned about how this person writes, from read_voice, as the voice profile of one kind of writing (kind, like post or email; leave out for a general one). fields are named by read_voice\'s fields list; a field you give replaces that field, an empty one removes it, and one you leave out stays. Give expected_set_at (the set_at read_voice showed) to refuse the save if the profile was saved again since you read it.', inputSchema: { type: 'object', required: ['fields'], properties: { kind: { type: 'string' }, name: { type: 'string', description: 'A name for this profile, like "Work posts"' }, fields: { type: 'object', description: 'Field id to text, using the ids read_voice lists' }, expected_set_at: { type: 'string' } } }, run: input => call('/posts/voice/save', input) },
  { name: 'forget_voice', description: 'Forgets part of what is kept about how this person writes: one profile (profile_id from read_voice), one edit (edit_id from read_voice), or every edit (all_edits true, with kind to forget only one kind\'s). Say what was forgotten; nothing else changes.', inputSchema: { type: 'object', properties: { profile_id: { type: 'string' }, edit_id: { type: 'string' }, all_edits: { type: 'boolean' }, kind: { type: 'string' } } }, run: input => call('/posts/voice/forget', input) },
  { name: 'list_snippets', description: 'This person\'s snippets: words they send again and again (a reply they give often, an introduction, a sign-off), newest used first, each with its title, words, tags and the blanks it has ({name} in the words). Give query to find by a word of its title or words, or tag. Use one with use_snippet. It changes nothing.', inputSchema: { type: 'object', properties: { query: { type: 'string' }, tag: { type: 'string' }, limit: { type: 'integer' } } }, run: input => call('/posts/snippet/list', input ?? {}) },
  { name: 'save_snippet', description: 'Saves words the person sends again and again as a snippet, or changes one (snippet_id from list_snippets; fields you leave out stay). title is what they call it; text is the words, with {name} where something changes each time; tags are short words. Give expected_set_at (the set_at list_snippets showed) to refuse the change if it was saved again since you read it.', inputSchema: { type: 'object', properties: { snippet_id: { type: 'string' }, title: { type: 'string' }, text: { type: 'string' }, tags: { type: 'array', items: { type: 'string' } }, expected_set_at: { type: 'string' } } }, run: input => call('/posts/snippet/save', input) },
  { name: 'use_snippet', description: 'The words of a snippet with its blanks filled: values is { name: text } for each {name} in it. A blank you give no value for stays as written and is named in left_blank, so fill every one before you send the words. Counts the use; sends nothing.', inputSchema: { type: 'object', required: ['snippet_id'], properties: { snippet_id: { type: 'string' }, values: { type: 'object', additionalProperties: { type: 'string' } } } }, run: input => call('/posts/snippet/use', input) },
  { name: 'remove_snippet', description: 'Removes one snippet by snippet_id (from list_snippets). Words already sent are not touched.', inputSchema: { type: 'object', required: ['snippet_id'], properties: { snippet_id: { type: 'string' } } }, run: input => call('/posts/snippet/remove', input) },
  { name: 'read_thread_summary', description: 'The summary kept of one conversation (conversation_id, and app, as read_messages shows them): the AI-written lines, when it was written, and whether newer messages have come since (stale, newer_messages). Read it before opening a long thread; when it is stale, read only the newer messages and keep an updated summary with save_thread_summary. It changes nothing.', inputSchema: { type: 'object', required: ['conversation_id'], properties: { conversation_id: { type: 'string' }, app: { type: 'string' } } }, run: input => call('/posts/summary/read', input) },
  { name: 'save_thread_summary', description: 'Keeps your summary of one conversation (conversation_id, and app) so the next AI can read a few lines instead of every message. It covers through the newest message the thread has now; the messages themselves stay word for word. Keeping again replaces the summary.', inputSchema: { type: 'object', required: ['conversation_id', 'summary'], properties: { conversation_id: { type: 'string' }, app: { type: 'string' }, summary: { type: 'string' } } }, run: input => call('/posts/summary/save', input) },
  { name: 'remove_thread_summary', description: 'Removes the summary kept of one conversation (conversation_id, and app). The messages are not touched.', inputSchema: { type: 'object', required: ['conversation_id'], properties: { conversation_id: { type: 'string' }, app: { type: 'string' } } }, run: input => call('/posts/summary/remove', input) },
];

export const socialPostAnnotations = {
  list_post_destinations: { title: 'List where I can post', readOnlyHint: true, destructiveHint: false, idempotentHint: true, openWorldHint: true },
  connect_post_destination: { title: 'Get a link to connect a place to post', readOnlyHint: true, destructiveHint: false, idempotentHint: true, openWorldHint: true },
  draft_post: { title: 'Draft a post', readOnlyHint: false, destructiveHint: false, idempotentHint: true, openWorldHint: false },
  approve_post: { title: 'Approve a post', readOnlyHint: false, destructiveHint: false, idempotentHint: true, openWorldHint: false },
  publish_post: { title: 'Publish a post', readOnlyHint: false, destructiveHint: false, idempotentHint: true, openWorldHint: true },
  undo_post: { title: 'Take back a post waiting to go out', readOnlyHint: false, destructiveHint: false, idempotentHint: true, openWorldHint: false },
  check_post: { title: 'Check a post is ready for each place', readOnlyHint: true, destructiveHint: false, idempotentHint: true, openWorldHint: false },
  read_post: { title: 'Read a post and where it went', readOnlyHint: true, destructiveHint: false, idempotentHint: true, openWorldHint: true },
  list_post_calendar: { title: 'Read my posting calendar', readOnlyHint: true, destructiveHint: false, idempotentHint: true, openWorldHint: false },
  list_posts: { title: 'List my posts', readOnlyHint: true, destructiveHint: false, idempotentHint: true, openWorldHint: false },
  list_snippets: { title: 'List my snippets', readOnlyHint: true, destructiveHint: false, idempotentHint: true, openWorldHint: false },
  save_snippet: { title: 'Save a snippet', readOnlyHint: false, destructiveHint: false, idempotentHint: true, openWorldHint: false },
  use_snippet: { title: 'Fill in a snippet', readOnlyHint: false, destructiveHint: false, idempotentHint: false, openWorldHint: false },
  remove_snippet: { title: 'Remove a snippet', readOnlyHint: false, destructiveHint: true, idempotentHint: true, openWorldHint: false },
  read_thread_summary: { title: 'Read a conversation\'s summary', readOnlyHint: true, destructiveHint: false, idempotentHint: true, openWorldHint: false },
  save_thread_summary: { title: 'Keep a conversation\'s summary', readOnlyHint: false, destructiveHint: false, idempotentHint: true, openWorldHint: false },
  remove_thread_summary: { title: 'Remove a conversation\'s summary', readOnlyHint: false, destructiveHint: true, idempotentHint: true, openWorldHint: false },
  read_voice: { title: 'Read how I write', readOnlyHint: true, destructiveHint: false, idempotentHint: true, openWorldHint: false },
  save_voice: { title: 'Save how I write', readOnlyHint: false, destructiveHint: false, idempotentHint: true, openWorldHint: false },
  forget_voice: { title: 'Forget how I write', readOnlyHint: false, destructiveHint: true, idempotentHint: true, openWorldHint: false },
};
