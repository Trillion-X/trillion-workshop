{
 "kind": "tool-rows",
 "record_set": "find-tool-servers-in-a-catalog",
 "what_this_is": "The tool rows of tools/find-tool-servers-in-a-catalog: a published catalog of tool servers searched as data.",
 "records": [
  {
   "id": "tool:find-tool-servers-in-a-catalog",
   "address": "package::find-tool-servers-in-a-catalog::tool::find-tool-servers-in-a-catalog",
   "path": [
    "current-item",
    "published-record"
   ],
   "payload": {
    "kind": "ai-tool-descriptor",
    "id": "tool:find-tool-servers-in-a-catalog",
    "label": "Find tool servers in a catalog",
    "job": "Find tool servers for a job in a published catalog and get the address to call each one at",
    "description": "Searches a published catalog of tool servers (the MCP registry's own list unless another catalog with the same API is named) for every word given, and answers each server's name, what it does, whether it is still active, the headers it asks for, and its address. Give that address to tools:list or tools:run to see and use its tools; a server with no address runs only as a program on a computer. It keeps nothing and sends no key.",
    "status": "active",
    "input_schema": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "words"
     ],
     "properties": {
      "words": {
       "type": "string",
       "minLength": 1,
       "maxLength": 200,
       "description": "What the server should do, like \"email inboxes\". Every word must appear in its name, title or description."
      },
      "catalog": {
       "type": "string",
       "pattern": "^https://",
       "description": "Another catalog with the same API; the MCP registry when left out."
      },
      "limit": {
       "type": "integer",
       "minimum": 1,
       "maximum": 100
      },
      "cursor": {
       "type": "string",
       "description": "The next_cursor a one-word search answered, for its next page."
      }
     }
    },
    "output_schema": {
     "type": "object",
     "required": [
      "servers",
      "next_cursor"
     ],
     "properties": {
      "servers": {
       "type": "array",
       "items": {
        "type": "object",
        "properties": {
         "name": {
          "type": "string"
         },
         "title": {
          "type": [
           "string",
           "null"
          ]
         },
         "description": {
          "type": [
           "string",
           "null"
          ]
         },
         "status": {
          "type": "string"
         },
         "address": {
          "type": [
           "string",
           "null"
          ]
         },
         "transport": {
          "type": [
           "string",
           "null"
          ]
         },
         "asks_for": {
          "type": "array",
          "items": {
           "type": "string"
          }
         },
         "repository": {
          "type": [
           "string",
           "null"
          ]
         },
         "website": {
          "type": [
           "string",
           "null"
          ]
         },
         "version": {
          "type": [
           "string",
           "null"
          ]
         }
        },
        "required": [
         "name",
         "status",
         "address",
         "asks_for"
        ]
       }
      },
      "next_cursor": {
       "type": [
        "string",
        "null"
       ]
      }
     }
    },
    "invoke": {
     "kind": "container",
     "may_reach": [], "public_read": true,
     "workdir": "/work",
     "stdout": "json",
     "run": [
      "/usr/local/bin/node",
      "/opt/find-tool-servers-in-a-catalog/do-work/find-tool-servers.mjs"
     ],
     "stdin": {
      "fill": {
       "from": "input"
      }
     },
     "files": {
      "package_files": [
       {
        "package": "find-tool-servers-in-a-catalog",
        "paths": [
         "do-work/find-tool-servers.mjs",
         "read-data/catalogs.json"
        ],
        "at": "/opt/find-tool-servers-in-a-catalog"
       }
      ]
     }
    },
    "result_selector": "$",
    "needs": {
     "expected_seconds": 10,
     "network_egress": true,
     "memory_mb": 128
    },
    "maker": "maker:find-tool-servers-in-a-catalog",
    "licence_class": "licence:permissive",
    "placements": [
     "placement:small-container"
    ],
    "verify": [
     {
      "kind": "sample-run",
      "input": {
       "words": "inbox",
       "limit": 2
      },
      "output_selector": "$.servers[0].address",
      "contains": "https://inbox.example/mcp",
      "shape_read_at": "2026-11-19",
      "replies": [
       {
        "request": {
         "method": "GET",
         "url": "https://registry.modelcontextprotocol.io/v0/servers?search=inbox&limit=2&version=latest"
        },
        "status": 200,
        "headers": {
         "content-type": "application/json"
        },
        "body": {
         "servers": [
          {
           "server": {
            "name": "example.inbox/mcp",
            "title": "Inbox",
            "description": "Email inboxes for agents (a made-up server).",
            "version": "1.0.0",
            "remotes": [
             {
              "type": "streamable-http",
              "url": "https://inbox.example/mcp",
              "headers": [
               {
                "name": "Authorization",
                "description": "Bearer key"
               }
              ]
             }
            ]
           },
           "_meta": {
            "io.modelcontextprotocol.registry/official": {
             "status": "active"
            }
           }
          }
         ],
         "metadata": {
          "count": 1
         }
        }
       }
      ]
     }
    ]
   }
  }
 ]
}
