export type ViewTask = { id: string; status?: string; collection_id?: string | null; smart_list?: string | null; starts_at?: string | null; due?: string | null; snoozed_until?: string | null; created_at?: string | null; title?: string; [field: string]: unknown };
export type GroupLevelRow = { field: string; bucket?: string };
export type TrayDisplay = { group_by: string; sort_by: string; group_levels?: GroupLevelRow[]; [view: string]: string | boolean | GroupLevelRow[] | undefined };
export type TrayTabRow = { id: string; label: string; icon?: string; builtin: boolean; color?: string | null; count: number };
export type QuickList = { id: string; label: string };
export type GroupLevelRow = { field: string; bucket?: string };

export function localDay(value: unknown): string | null;
export function localInstant(value: unknown): number | null;
export function daysBetween(from: string, to: string): number;
export function addDaysTo(day: string, count: number): string;
export function nowDay(now: number): string;
export function isSnoozed(task: ViewTask, now: number): boolean;
export function inList(task: ViewTask, listId: string, context?: { today?: string; data?: unknown }): boolean;
export function moveTarget(listId: string, data?: unknown): { collection_id: string | null; smart_list: string | null } | null;
export function effectiveListId(task: ViewTask): string;
export function visibleTasks<T extends ViewTask>(tasks: T[], display: TrayDisplay, context: { now: number }): T[];
export function sortTasks<T extends ViewTask>(tasks: T[], sortId: string, data?: unknown): T[];
export function groupLevelsFor(groupId: string, data?: unknown): GroupLevelRow[];
export function levelsOf(display: TrayDisplay, data?: unknown): GroupLevelRow[];
export function displayFrom(saved: unknown, data?: unknown): TrayDisplay;
export function tabsFor(input: { tasks: ViewTask[]; collections: { id: string; title: string; color?: string | null; archived?: boolean }[]; display: TrayDisplay; now: number; data?: unknown }): TrayTabRow[];
export function parseQuickTask(text: string, input: { lists: QuickList[]; now: number; data?: unknown }): { title: string; list: QuickList | null; day: string | null; minute: number | null };
export function instantOf(day: string, minute: number): string;
export function stepId(ids: string[], current: string | null, step: number): string | null;
export function cycleId(ids: string[], current: string | null, step: number): string | null;
export function rangeIds(ids: string[], anchor: string, to: string): string[];
export function deadlineTone(due: unknown, today: string, data?: unknown): string | null;
export function snoozeDay(choice: { days?: number; weekday?: number }, today: string): string;
export function durationWords(minutes: number): string;
export const builtinLists: (data?: unknown) => unknown[];
