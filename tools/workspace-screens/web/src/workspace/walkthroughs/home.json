      "content": {
        "content_kind": "text",
        "payload": {
          "title": "Make Home yours",
          "body": "Point at any part of Home to drag it somewhere else, change its width, swap it for another screen or remove it. Add to Home puts any screen here, including Files or one of your lists."
        }
