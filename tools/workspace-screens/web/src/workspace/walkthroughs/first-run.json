        "content_kind": "interactive-gate",
        "payload": {
          "title": "Pursuits",
          "body": "Switch to any pursuit here. Its messages, files, people and the tools it turned on show under it in your sidebar, and All pursuits lists the groups and projects you share and the ones anyone can join, like the Trillion community, free on every plan."
        }
      },
      "target_ref": {
        "from": "selector",
