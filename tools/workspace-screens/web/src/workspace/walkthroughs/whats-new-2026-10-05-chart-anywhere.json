            "padding": 6,
            "radius": 10
          }
        ]
      },
      "placement": {
        "prefer": "below",
        "auto_flip": true,
        "gap": 14
      },
      "nav": {
        "buttons": [
          {
            "role": "back",
            "label": "Back"
          },
          {
            "role": "advance",
            "label": "Next"
          }
        ]
      }
    },
    {
      "id": "ai",
      "content": {
        "content_kind": "text",
        "payload": {
          "title": "Your AI can place one too",
          "body": "Ask your AI to put a chart of any list or reading on a screen, already on the week or day you want."
        }
      },
      "nav": {
        "buttons": [
          {
            "role": "advance",
            "label": "Got it"
          }
        ]
      }
    }
  ]
