{
  "kind": "walkthrough-definition",
  "id": "media-edit",
  "revision": 2,
  "order": 22,
  "title": "Media edit",
  "summary": "You can play and review the clips you picked in Media.",
  "entry_step": "intro",
  "progress_style": {
    "style": "segmented"
  },
  "triggers": [
    {
      "reason": "screen-first-opened",
      "on_event": {
        "event_kind": "screen-opened",
        "match": {
          "entry": "tool-screen",
          "tool_id": "tool:screen-media-edit"
        }
      },
      "once_key": "media-edit",
      "requires": [
        {
          "once_key": "first-run"
        }
      ]
    },
    {
      "reason": "replay",
      "on_event": {
        "event_kind": "walkthrough-requested",
        "match": {
          "walkthrough_id": "media-edit"
        }
      }
    }
  ],
  "steps": [
    {
      "id": "intro",
      "content": {
        "content_kind": "text",
        "payload": {
          "title": "Review your clips",
          "body": "Play the clips you picked in Media and review them here."
        }
      },
      "target_preparation": {
        "surface": {
          "id": "trillion.media-edit"
        }
      },
      "target_ref": {
        "from": "selector",
        "query": "[data-trillion-screen=\"tool-screen\"]"
      },
      "cutout": {
        "shapes": [
          {
            "shape": "rounded-rect",
            "padding": 6,
            "radius": 10
          }
        ]
      },
      "placement": {
        "prefer": "below",
        "auto_flip": true,
        "gap": 14
      },
      "nav": {
        "buttons": [
          {
            "role": "skip",
            "label": "Skip"
          },
          {
            "role": "advance",
            "label": "Show me"
          }
        ]
      },
      "centered_when_target_missing": true
    },
    {
      "id": "clips",
      "content": {
        "content_kind": "text",
        "payload": {
          "title": "Your clips",
          "body": "These are the clips you chose in Media. Press one to preview it."
        }
      },
      "target_preparation": {
        "surface": {
          "id": "trillion.media-edit"
        }
      },
      "target_ref": {
        "from": "selector",
        "query": "[data-trillion-screen=\"tool-screen\"] section[aria-label=\"Source clips\"]"
      },
      "cutout": {
        "shapes": [
          {
            "shape": "rounded-rect",
            "padding": 6,
            "radius": 10
          }
        ]
      },
      "placement": {
        "prefer": "right",
        "auto_flip": true,
        "gap": 14
      },
      "centered_when_target_missing": true
    },
    {
      "id": "tools",
      "content": {
        "content_kind": "text",
        "payload": {
          "title": "Make your edit",
          "body": "Change the frame, add text, effects or sound, then save the edit or render the video."
        }
      },
      "target_preparation": {
        "surface": {
          "id": "trillion.media-edit"
        }
      },
      "target_ref": {
        "from": "selector",
        "query": "[data-trillion-screen=\"tool-screen\"] [aria-label=\"Editor tools\"]"
      },
      "cutout": {
        "shapes": [
          {
            "shape": "rounded-rect",
            "padding": 6,
            "radius": 10
          }
        ]
      },
      "placement": {
        "prefer": "below",
        "auto_flip": true,
        "gap": 14
      },
      "centered_when_target_missing": true
    }
  ]
}
