{
 "kind": "walkthrough-definition",
 "id": "board",
 "revision": 1,
 "order": 57,
 "title": "Draw",
 "summary": "A board to draw, place pictures and notes, alone or with others.",
 "entry_step": "tools",
 "progress_style": {
  "style": "segmented"
 },
 "triggers": [
  {
   "reason": "screen-first-opened",
   "on_event": {
    "event_kind": "screen-opened",
    "match": {
     "entry": "tool-screen",
     "tool_id": "tool:screen-board"
    }
   },
   "once_key": "board",
   "requires": [
    {
     "once_key": "first-run"
    }
   ]
  },
  {
   "reason": "replay",
   "on_event": {
    "event_kind": "walkthrough-requested",
    "match": {
     "walkthrough_id": "board"
    }
   }
  }
 ],
 "steps": [
  {
   "id": "tools",
   "content": {
    "content_kind": "text",
    "payload": {
     "title": "Pick a tool",
     "body": "Draw, write a note or place a picture. Pick a tool, then press on the board."
    }
   },
   "target_preparation": {
    "surface": {
     "id": "trillion.board"
    }
   },
   "target_ref": {
    "from": "selector",
    "query": "[data-trillion-screen=\"tool-screen\"] [role=\"toolbar\"][aria-label=\"Canvas tools\"]"
   },
   "cutout": {
    "shapes": [
     {
      "shape": "rounded-rect",
      "padding": 6,
      "radius": 10
     }
    ]
   },
   "placement": {
    "prefer": "below",
    "auto_flip": true,
    "gap": 14
   },
   "centered_when_target_missing": true,
   "nav": {
    "buttons": [
     {
      "role": "skip",
      "label": "Skip"
     },
     {
      "role": "advance",
      "label": "Show me"
     }
    ]
   }
  },
  {
   "id": "board",
   "content": {
    "content_kind": "text",
    "payload": {
     "title": "Your board",
     "body": "Drag to move around and pinch or scroll to zoom. Anyone you share it with sees changes live."
    }
   },
   "target_preparation": {
    "surface": {
     "id": "trillion.board"
    }
   },
   "target_ref": {
    "from": "selector",
    "query": "[data-trillion-screen=\"tool-screen\"] [data-canvas-surface]"
   },
   "cutout": {
    "shapes": [
     {
      "shape": "rounded-rect",
      "padding": 6,
      "radius": 10
     }
    ]
   },
   "placement": {
    "prefer": "below",
    "auto_flip": true,
    "gap": 14
   },
   "centered_when_target_missing": true,
   "nav": {
    "buttons": [
     {
      "role": "skip",
      "label": "Skip"
     },
     {
      "role": "back",
      "label": "Back"
     },
     {
      "role": "advance",
      "label": "Next"
     }
    ]
   }
  },
  {
   "id": "find-again",
   "content": {
    "content_kind": "text",
    "payload": {
     "title": "Find Draw again",
     "body": "Draw is always in the sidebar. Press it to come back here."
    }
   },
   "target_ref": {
    "from": "selector",
    "query": "[data-sidebar-surface-id=\"trillion.board\"], [data-sidebar-open-toggle]"
   },
   "placement": {
    "prefer": "right",
    "auto_flip": true,
    "gap": 14
   }
  }
 ]
}
