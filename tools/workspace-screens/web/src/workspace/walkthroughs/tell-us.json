{
  "kind": "walkthrough-definition",
  "id": "tell-us",
  "revision": 1,
  "order": 52,
  "title": "Tell us",
  "summary": "Report a bug, send feedback or share an idea. The people who make Trillion read every one.",
  "entry_step": "where",
  "progress_style": {
    "style": "segmented"
  },
  "triggers": [
    {
      "reason": "screen-first-opened",
      "on_event": {
        "event_kind": "screen-opened",
        "match": {
          "entry": "tool-screen",
          "tool_id": "tool:tell-trillions-makers"
        }
      },
      "once_key": "tell-us",
      "requires": [
        {
          "once_key": "first-run"
        }
      ]
    },
    {
      "reason": "replay",
      "on_event": {
        "event_kind": "walkthrough-requested",
        "match": {
          "walkthrough_id": "tell-us"
        }
      }
    }
  ],
  "steps": [
    {
      "id": "where",
      "content": {
        "content_kind": "text",
        "payload": {
          "title": "Tell us",
          "body": "Tell us is above Start in your sidebar. Open it whenever something comes up. On a phone, press Show sidebar first."
        }
      },
      "target_ref": {
        "from": "selector",
        "query": "[data-sidebar-section-id=\"collection:trillion-tell-us\"], [data-sidebar-open-toggle]"
      },
      "cutout": {
        "shapes": [
          {
            "shape": "rounded-rect",
            "padding": 6,
            "radius": 10
          }
        ]
      },
      "placement": {
        "prefer": "right",
        "auto_flip": true,
        "gap": 14
      },
      "centered_when_target_missing": true
    },
    {
      "id": "kind",
      "content": {
        "content_kind": "text",
        "payload": {
          "title": "Choose what it is",
          "body": "Choose Something went wrong, Something to change or An idea."
        }
      },
      "target_preparation": {
        "surface": {
          "id": "tool:tell-trillions-makers"
        }
      },
      "target_ref": {
        "from": "selector",
        "query": "[data-trillion-screen=\"tool-screen\"] [aria-label=\"What is it\"]"
      },
      "cutout": {
        "shapes": [
          {
            "shape": "rounded-rect",
            "padding": 6,
            "radius": 10
          }
        ]
      },
      "placement": {
        "prefer": "below",
        "auto_flip": true,
        "gap": 14
      },
      "centered_when_target_missing": true
    },
    {
      "id": "send",
      "content": {
        "content_kind": "text",
        "payload": {
          "title": "Write it and send",
          "body": "Say what happened or what you would change. Add a picture if it helps, then press Send. The people who make Trillion read every one."
        }
      },
      "target_preparation": {
        "surface": {
          "id": "tool:tell-trillions-makers"
        }
      },
      "target_ref": {
        "from": "selector",
        "query": "[data-trillion-screen=\"tool-screen\"] textarea[placeholder=\"What you did, what you expected, what happened, or your idea\"]"
      },
      "cutout": {
        "shapes": [
          {
            "shape": "rounded-rect",
            "padding": 6,
            "radius": 10
          }
        ]
      },
      "placement": {
        "prefer": "below",
        "auto_flip": true,
        "gap": 14
      },
      "centered_when_target_missing": true
    }
  ]
}
