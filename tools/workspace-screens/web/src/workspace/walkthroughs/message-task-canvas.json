{
  "kind": "walkthrough-definition",
  "id": "message-task-canvas",
  "revision": 3,
  "order": 28,
  "title": "Task map",
  "summary": "Every message you wrote, as tasks by pursuit and feature, with how much is done.",
  "entry_step": "intro",
  "progress_style": {
    "style": "segmented"
  },
  "triggers": [
    {
      "reason": "screen-first-opened",
      "on_event": {
        "event_kind": "screen-opened",
        "match": {
          "entry": "message-task-canvas"
        }
      },
      "once_key": "message-task-canvas",
      "requires": [
        {
          "once_key": "first-run"
        }
      ]
    },
    {
      "reason": "replay",
      "on_event": {
        "event_kind": "walkthrough-requested",
        "match": {
          "walkthrough_id": "message-task-canvas"
        }
      }
    }
  ],
  "steps": [
    {
      "id": "intro",
      "content": {
        "content_kind": "text",
        "payload": {
          "title": "Your messages, as tasks",
          "body": "Every message you wrote, as tasks by pursuit and feature, with how much is done."
        }
      },
      "target_preparation": {
        "surface": {
          "id": "trillion.message-task-canvas"
        }
      },
      "target_ref": {
        "from": "selector",
        "query": "[data-trillion-screen=\"message-task-canvas\"]"
      },
      "cutout": {
        "shapes": [
          {
            "shape": "rounded-rect",
            "padding": 6,
            "radius": 10
          }
        ]
      },
      "placement": {
        "prefer": "below",
        "auto_flip": true,
        "gap": 14
      },
      "nav": {
        "buttons": [
          {
            "role": "skip",
            "label": "Skip"
          },
          {
            "role": "advance",
            "label": "Show me"
          }
        ]
      },
      "centered_when_target_missing": true
    },
    {
      "id": "map",
      "content": {
        "content_kind": "text",
        "payload": {
          "title": "Tasks by pursuit and feature",
          "body": "Each heading says how much of it is done. Filter by pursuit, state or day, switch to any view, and press a task to read what you wrote."
        }
      },
      "target_preparation": {
        "surface": {
          "id": "trillion.message-task-canvas"
        }
      },
      "target_ref": {
        "from": "selector",
        "query": "[data-trillion-screen=\"message-task-canvas\"] .record-views-bar, [data-trillion-screen=\"message-task-canvas\"] .screen-state"
      },
      "cutout": {
        "shapes": [
          {
            "shape": "rounded-rect",
            "padding": 6,
            "radius": 10
          }
        ]
      },
      "placement": {
        "prefer": "below",
        "auto_flip": true,
        "gap": 14
      },
      "centered_when_target_missing": true
    },
    {
      "id": "find-again",
      "content": {
        "content_kind": "text",
        "payload": {
          "title": "Find Task map again",
          "body": "Open Task map from the menu whenever you need it."
        }
      },
      "target_ref": {
        "from": "selector",
        "query": "[data-sidebar-surface-id=\"trillion.message-task-canvas\"], [data-sidebar-open-toggle]"
      },
      "cutout": {
        "shapes": [
          {
            "shape": "rounded-rect",
            "padding": 6,
            "radius": 10
          }
        ]
      },
      "placement": {
        "prefer": "right",
        "auto_flip": true,
        "gap": 14
      }
    }
  ]
}
