  "steps": [
    {
      "id": "intro",
      "content": {
        "content_kind": "text",
        "payload": {
          "title": "Back, Forward and a calmer …",
          "body": "Every pane remembers what it showed, and its … menu is one short list now."
        }
      },
      "nav": {
        "buttons": [
          {
            "role": "skip",
            "label": "Skip"
          },
          {
            "role": "advance",
            "label": "Show me"
          }
        ]
      }
    },
    {
      "id": "arrows",
      "content": {
        "content_kind": "text",
        "payload": {
          "title": "Go back to what this pane showed",
          "body": "Back and Forward step through everything this pane showed, in order, whichever way it opened. Point at an arrow, or hold it, to see the whole list and jump to any of it."
        }
      },
      "target_ref": {
        "from": "selector",
        "query": "[data-nav-arrows]"
      },
      "centered_when_target_missing": true,
      "cutout": {
        "shapes": [
          {
