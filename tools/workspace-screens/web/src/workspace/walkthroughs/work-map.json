{
 "kind": "walkthrough-definition",
 "id": "work-map",
 "revision": 1,
 "order": 47,
 "title": "Work map",
 "summary": "Everything being worked on, as one map you can zoom into.",
 "entry_step": "map",
 "progress_style": {
  "style": "segmented"
 },
 "triggers": [
  {
   "reason": "screen-first-opened",
   "on_event": {
    "event_kind": "screen-opened",
    "match": {
     "entry": "tool-screen",
     "tool_id": "tool:screen-work-map"
    }
   },
   "once_key": "work-map",
   "requires": [
    {
     "once_key": "first-run"
    }
   ]
  },
  {
   "reason": "replay",
   "on_event": {
    "event_kind": "walkthrough-requested",
    "match": {
     "walkthrough_id": "work-map"
    }
   }
  }
 ],
 "steps": [
  {
   "id": "map",
   "content": {
    "content_kind": "text",
    "payload": {
     "title": "All the work in one picture",
     "body": "Each box is a piece of work, with what it is part of above it. Drag to move around and use + and − to zoom."
    }
   },
   "target_preparation": {
    "surface": {
     "id": "trillion.work-map"
    }
   },
   "target_ref": {
    "from": "selector",
    "query": "[data-trillion-screen=\"tool-screen\"] [data-node-graph]"
   },
   "cutout": {
    "shapes": [
     {
      "shape": "rounded-rect",
      "padding": 6,
      "radius": 10
     }
    ]
   },
   "placement": {
    "prefer": "below",
    "auto_flip": true,
    "gap": 14
   },
   "centered_when_target_missing": true,
