        "match": {
          "walkthrough_id": "tray"
        }
      }
    }
  ],
  "steps": [
    {
      "id": "intro",
      "content": {
        "content_kind": "text",
        "payload": {
          "title": "Everything you pick lands here",
          "body": "Everything you pick anywhere in Trillion lands here, ready to send on."
        }
      },
      "target_preparation": {
        "surface": {
          "id": "trillion.tray"
        }
      },
      "target_ref": {
        "from": "selector",
        "query": "[data-trillion-screen=\"tray\"]"
      },
      "cutout": {
        "shapes": [
