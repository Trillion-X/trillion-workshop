{
  "kind": "walkthrough-definition",
  "id": "tray",
  "revision": 1,
  "order": 51,
  "title": "Your tray",
  "summary": "You can pick anything in Trillion and send it on to your AI, a pursuit or the people who make Trillion.",
  "entry_step": "intro",
  "progress_style": {
    "style": "segmented"
  },
  "triggers": [
    {
      "reason": "screen-first-opened",
      "on_event": {
        "event_kind": "screen-opened",
