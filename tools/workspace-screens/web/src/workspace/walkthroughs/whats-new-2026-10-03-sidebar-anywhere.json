  "steps": [
    {
      "id": "intro",
      "content": {
        "content_kind": "text",
        "payload": {
          "title": "Your sidebar can go anywhere now",
          "body": "Your sidebar can now sit wherever you want, take less room and show only the icons that fit."
        }
      },
      "nav": {
        "buttons": [
          {
            "role": "skip",
            "label": "Skip"
          },
          {
            "role": "advance",
            "label": "Show me"
          }
        ]
      }
    },
    {
      "id": "sidebar-bar",
      "content": {
        "content_kind": "text",
        "payload": {
          "title": "Drag the sidebar by its grip",
          "body": "Drop it on the line between two panes and it turns into a thin bar there, running down or across. Drop it anywhere else and it folds into a small handle that opens it when you need it. Icons that do not fit go under More, where you can also set how many show. Add an Empty space row to push icons apart."
        }
      },
      "target_ref": {
        "from": "selector",
        "query": "[data-sidebar-bar-grip], [data-sidebar-handle], [data-sidebar-open-toggle]"
      },
      "centered_when_target_missing": true,
      "cutout": {
        "shapes": [
          {
