{
  "kind": "walkthrough-definition",
  "id": "workshop",
  "revision": 2,
  "order": 45,
  "title": "Runs",
  "summary": "You can see every tool your AI can use, who made it, where it runs, whether it worked and every run of it.",
  "entry_step": "intro",
  "progress_style": {
    "style": "segmented"
  },
  "triggers": [
    {
      "reason": "screen-first-opened",
      "on_event": {
        "event_kind": "screen-opened",
        "match": {
          "entry": "tool-screen",
          "tool_id": "tool:screen-workshop"
        }
      },
      "once_key": "workshop",
      "requires": [
        {
          "once_key": "first-run"
        }
      ]
    },
    {
      "reason": "replay",
      "on_event": {
        "event_kind": "walkthrough-requested",
        "match": {
          "walkthrough_id": "workshop"
        }
      }
    }
  ],
  "steps": [
    {
      "id": "intro",
      "content": {
        "content_kind": "text",
        "payload": {
          "title": "The tools your AI can use",
          "body": "Every tool your AI can use is here, with who made it, where it runs, whether it worked and each time it ran."
        }
      },
      "target_preparation": {
        "surface": {
          "id": "trillion.workshop"
        }
      },
      "target_ref": {
        "from": "selector",
        "query": "[data-trillion-screen=\"workshop\"]"
      },
      "cutout": {
        "shapes": [
          {
            "shape": "rounded-rect",
            "padding": 6,
            "radius": 10
          }
        ]
      },
      "placement": {
        "prefer": "below",
        "auto_flip": true,
        "gap": 14
      },
      "nav": {
        "buttons": [
          {
            "role": "skip",
            "label": "Skip"
          },
          {
            "role": "advance",
            "label": "Show me"
          }
        ]
      },
      "centered_when_target_missing": true
    },
    {
      "id": "search",
      "content": {
        "content_kind": "text",
        "payload": {
          "title": "Find a run",
          "body": "Type to find a run, and press one to see what it returned and the files it made."
        }
      },
      "target_preparation": {
        "surface": {
          "id": "trillion.workshop"
        }
      },
      "target_ref": {
        "from": "selector",
        "query": "[data-trillion-screen=\"workshop\"] .record-views-search"
      },
      "cutout": {
        "shapes": [
          {
            "shape": "rounded-rect",
            "padding": 6,
            "radius": 10
          }
        ]
      },
      "placement": {
        "prefer": "below",
        "auto_flip": true,
        "gap": 14
      },
      "centered_when_target_missing": true,
      "act": {
        "do": "type",
        "text": "video"
      },
      "nav": {
        "buttons": [
          {
            "role": "skip",
            "label": "Skip"
          },
          {
            "role": "back",
            "label": "Back"
          },
          {
            "role": "advance",
            "label": "Search for me"
          }
        ]
      }
    },
    {
      "id": "views",
      "content": {
        "content_kind": "text",
        "payload": {
          "title": "Choose how they look",
          "body": "See the runs as a table, or as a board by how they ended."
        }
      },
      "target_preparation": {
        "surface": {
          "id": "trillion.workshop"
        }
      },
      "target_ref": {
        "from": "selector",
        "query": "[data-trillion-screen=\"workshop\"] [role=\"radiogroup\"][aria-label=\"View\"]"
      },
      "cutout": {
        "shapes": [
          {
            "shape": "rounded-rect",
            "padding": 6,
            "radius": 10
          }
        ]
      },
      "placement": {
        "prefer": "below",
        "auto_flip": true,
        "gap": 14
      },
      "centered_when_target_missing": true
    },
    {
      "id": "find-again",
      "content": {
        "content_kind": "text",
        "payload": {
          "title": "Find Runs again",
          "body": "Open Runs from the menu whenever you need it. Tools themselves are in the Marketplace."
        }
      },
      "target_ref": {
        "from": "selector",
        "query": "[data-sidebar-surface-id=\"trillion.workshop\"], [data-sidebar-open-toggle]"
      },
      "cutout": {
        "shapes": [
          {
            "shape": "rounded-rect",
            "padding": 6,
            "radius": 10
          }
        ]
      },
      "placement": {
        "prefer": "right",
        "auto_flip": true,
        "gap": 14
      }
    }
  ]
}
