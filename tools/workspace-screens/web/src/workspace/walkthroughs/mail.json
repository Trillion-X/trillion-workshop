    {
      "id": "search",
      "content": {
        "content_kind": "text",
        "payload": {
          "title": "Find a message",
          "body": "Search Gmail using its own query words, then open a message to read it. On a phone, Folders and Back to mail move between the panes."
        }
      },
      "target_preparation": {
        "surface": {
          "id": "trillion.mail"
        }
      },
      "target_ref": {
        "from": "selector",
        "query": "[data-trillion-screen=\"email\"] [data-mail-list]"
      },
      "centered_when_target_missing": true
    },
    {
      "id": "message",
      "content": {
        "content_kind": "text",
        "payload": {
          "title": "Read and manage mail",
          "body": "Open a message to reply, archive it, move it to Trash, or change its read and star status. Open in Gmail shows the original formatting. Drafts with attachments, formatting or extra recipients are edited in Gmail to preserve them."
        }
      },
      "target_preparation": {
        "surface": {
          "id": "trillion.mail"
        }
      },
      "target_ref": {
        "from": "selector",
        "query": "[data-trillion-screen=\"email\"] [data-mail-detail]"
      },
      "centered_when_target_missing": true
    },
    {
      "id": "task",
      "content": {
        "content_kind": "text",
        "payload": {
          "title": "Keep an email as a task",
          "body": "Open a message, enter a task title and press Create task. The task keeps a link to the email. Drafts can be saved separately; Send sends the email from your connected Gmail account."
        }
      },
      "target_preparation": {
        "surface": {
