{
  "kind": "walkthrough-definition",
  "id": "tours",
  "revision": 2,
  "order": 36,
  "title": "Tours",
  "summary": "You can take a short guided tour of each part of Trillion, and take any of them again whenever you like.",
  "entry_step": "intro",
  "progress_style": {
    "style": "segmented"
  },
  "triggers": [
    {
      "reason": "screen-first-opened",
      "on_event": {
        "event_kind": "screen-opened",
