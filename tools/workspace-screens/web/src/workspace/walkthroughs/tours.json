        "event_kind": "walkthrough-requested",
        "match": {
          "walkthrough_id": "tours"
        }
      }
    }
  ],
  "steps": [
    {
      "id": "intro",
      "content": {
        "content_kind": "text",
        "payload": {
          "title": "Take any tour again",
          "body": "There is a short guided tour for each part of Trillion, and you can take any of them again at any time."
        }
      },
      "target_preparation": {
        "surface": {
          "id": "trillion.tours"
        }
      },
      "target_ref": {
        "from": "selector",
        "query": "[data-trillion-screen=\"tours\"]"
