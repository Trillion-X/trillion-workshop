      "centered_when_target_missing": true,
      "cutout": {
        "shapes": [
          {
            "shape": "rounded-rect",
            "padding": 6,
            "radius": 10
          }
        ]
      },
      "placement": {
        "prefer": "left",
        "auto_flip": true,
        "gap": 12
      }
