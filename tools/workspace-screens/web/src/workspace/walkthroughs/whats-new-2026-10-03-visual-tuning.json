  "steps": [
    {
      "id": "intro",
      "content": {
        "content_kind": "text",
        "payload": {
          "title": "Drag, do not type",
          "body": "Looks and page styles are now things you drag, not codes you type. The page changes while you move them."
        }
      },
      "nav": {
        "buttons": [
          {
            "role": "skip",
            "label": "Skip"
          },
          {
            "role": "advance",
            "label": "Show me"
          }
        ]
      }
    },
    {
      "id": "looks",
      "content": {
        "content_kind": "text",
        "payload": {
          "title": "Edit a look",
          "body": "Press Edit under your looks. Each colour is a swatch that opens a wheel, each size a track with a small picture of it, each font drawn in its own face."
        }
      },
      "target_preparation": {
        "surface": {
          "id": "trillion.account"
        }
      },
      "target_ref": {
        "from": "selector",
        "query": "[data-screen-look-choices]"
      },
      "centered_when_target_missing": true,
      "cutout": {
        "shapes": [
          {
            "shape": "rounded-rect",
            "padding": 6,
            "radius": 12
          }
        ]
      },
      "placement": {
        "prefer": "above",
        "auto_flip": true,
        "gap": 12
      }
    },
    {
      "id": "pages",
      "content": {
        "content_kind": "text",
        "payload": {
          "title": "Style a page the same way",
          "body": "In Public apps, choose part of a page: its colours, text size, pursuit inside and corners are the same controls, and the canvas changes as you drag."
        }
