{
  "kind": "walkthrough-definition",
  "id": "activity",
  "revision": 2,
  "order": 26,
  "title": "AI activity",
  "summary": "You can see everything the AIs connected to your Trillion did, including the work they handed off, the tools they ran, the files they saved and what did not work.",
  "entry_step": "intro",
  "progress_style": {
    "style": "segmented"
  },
  "triggers": [
    {
      "reason": "screen-first-opened",
      "on_event": {
        "event_kind": "screen-opened",
        "match": {
          "entry": "activity"
        }
      },
      "once_key": "activity",
      "requires": [
        {
          "once_key": "first-run"
        }
      ]
    },
    {
      "reason": "replay",
      "on_event": {
        "event_kind": "walkthrough-requested",
        "match": {
          "walkthrough_id": "activity"
        }
      }
    }
  ],
  "steps": [
    {
      "id": "intro",
      "content": {
        "content_kind": "text",
        "payload": {
          "title": "See what your AIs did",
          "body": "Every AI connected to your Trillion shows its work here. You see what it handed off, ran and saved, and what did not work."
        }
      },
      "target_preparation": {
        "surface": {
          "id": "trillion.activity"
        }
      },
      "target_ref": {
        "from": "selector",
        "query": "[data-trillion-screen=\"activity\"]"
      },
      "cutout": {
        "shapes": [
          {
            "shape": "rounded-rect",
            "padding": 6,
            "radius": 10
          }
        ]
      },
      "placement": {
        "prefer": "below",
        "auto_flip": true,
        "gap": 14
      },
      "nav": {
        "buttons": [
          {
            "role": "skip",
            "label": "Skip"
          },
          {
            "role": "advance",
            "label": "Show me"
          }
        ]
      },
      "centered_when_target_missing": true
    },
    {
      "id": "search",
      "content": {
        "content_kind": "text",
        "payload": {
          "title": "Find what an AI did",
          "body": "Once an AI uses your Trillion, type here to find a tool it ran, a file it saved or work it handed off."
        }
      },
      "target_preparation": {
        "surface": {
          "id": "trillion.activity"
        }
      },
      "target_ref": {
        "from": "selector",
        "query": "[data-trillion-screen=\"activity\"] .record-views-search"
      },
      "cutout": {
        "shapes": [
          {
            "shape": "rounded-rect",
            "padding": 6,
            "radius": 10
          }
        ]
      },
      "placement": {
        "prefer": "below",
        "auto_flip": true,
        "gap": 14
      },
      "centered_when_target_missing": true,
      "act": {
        "do": "type",
        "text": "Claude"
      },
      "nav": {
        "buttons": [
          {
            "role": "skip",
            "label": "Skip"
          },
          {
            "role": "back",
            "label": "Back"
          },
          {
            "role": "advance",
            "label": "Search for me"
          }
        ]
      }
    },
    {
      "id": "views",
      "content": {
        "content_kind": "text",
        "payload": {
          "title": "Choose how it looks",
          "body": "See the activity as a list, a table, cards or a board."
        }
      },
      "target_preparation": {
        "surface": {
          "id": "trillion.activity"
        }
      },
      "target_ref": {
        "from": "selector",
        "query": "[data-trillion-screen=\"activity\"] [role=\"radiogroup\"][aria-label=\"View\"]"
      },
      "cutout": {
        "shapes": [
          {
            "shape": "rounded-rect",
            "padding": 6,
            "radius": 10
          }
        ]
      },
      "placement": {
        "prefer": "below",
        "auto_flip": true,
        "gap": 14
      },
      "centered_when_target_missing": true
    },
    {
      "id": "find-again",
      "content": {
        "content_kind": "text",
        "payload": {
