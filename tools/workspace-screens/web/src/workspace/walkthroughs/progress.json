{
  "kind": "walkthrough-definition",
  "id": "progress",
  "revision": 2,
  "order": 32,
  "title": "Progress",
  "summary": "You can see what is waiting for your answer, what you are working toward and what helped.",
  "entry_step": "intro",
  "progress_style": {
    "style": "segmented"
  },
  "triggers": [
    {
      "reason": "screen-first-opened",
      "on_event": {
        "event_kind": "screen-opened",
        "match": {
          "entry": "guide",
          "screen": "progress"
        }
      },
      "once_key": "progress",
      "requires": [
        {
          "once_key": "first-run"
        }
      ]
    },
    {
      "reason": "replay",
      "on_event": {
        "event_kind": "walkthrough-requested",
        "match": {
          "walkthrough_id": "progress"
        }
      }
    }
  ],
  "steps": [
    {
      "id": "intro",
      "content": {
        "content_kind": "text",
        "payload": {
          "title": "See how you are doing",
          "body": "Progress shows what is waiting for your answer, what you are working toward and what helped."
        }
      },
      "target_preparation": {
        "surface": {
          "id": "trillion.progress"
        }
      },
      "target_ref": {
        "from": "selector",
        "query": "[data-trillion-screen=\"progress\"]"
      },
      "cutout": {
        "shapes": [
          {
            "shape": "rounded-rect",
            "padding": 6,
            "radius": 10
          }
        ]
      },
      "placement": {
        "prefer": "below",
        "auto_flip": true,
        "gap": 14
      },
      "nav": {
        "buttons": [
          {
            "role": "skip",
            "label": "Skip"
          },
          {
            "role": "advance",
            "label": "Show me"
          }
        ]
      },
      "centered_when_target_missing": true
    },
    {
      "id": "sections",
      "content": {
        "content_kind": "text",
        "payload": {
          "title": "Where you stand",
          "body": "Go through what is waiting for your answer, what you are working toward and what helped, one part at a time."
        }
      },
      "target_preparation": {
        "surface": {
          "id": "trillion.progress"
        }
      },
      "target_ref": {
        "from": "selector",
        "query": "[data-trillion-screen=\"progress\"] .guide-section"
