      "content": {
        "content_kind": "text",
        "payload": {
          "title": "Trillion fits your phone better",
          "body": "A card like this one now blurs the page behind it. Tour cards and previews stay clear of the status bar and the home bar."
        }
      },
      "nav": {
        "buttons": [
          {
            "role": "skip",
            "label": "Skip"
          },
          {
            "role": "advance",
            "label": "Show me"
          }
        ]
      }
    },
