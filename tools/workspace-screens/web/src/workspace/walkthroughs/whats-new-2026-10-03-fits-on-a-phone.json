      "content": {
        "content_kind": "text",
        "payload": {
          "title": "Only the pane you are in has a frame",
          "body": "Tapping a pane no longer leaves a square outline on it, so its own frame is the only mark of where you are. If your notifications cannot load, they say so with Try again instead of showing a blank window."
        }
      },
