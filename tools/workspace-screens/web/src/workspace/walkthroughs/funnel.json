{
  "kind": "walkthrough-definition",
  "id": "funnel",
  "revision": 2,
  "order": 44,
  "title": "Funnel",
  "summary": "You can follow one funnel stage by stage.",
  "entry_step": "intro",
  "progress_style": {
    "style": "segmented"
  },
  "triggers": [
    {
      "reason": "screen-first-opened",
      "on_event": {
        "event_kind": "screen-opened",
        "match": {
          "entry": "tool-screen",
          "tool_id": "tool:screen-funnel"
        }
      },
      "once_key": "funnel",
      "requires": [
        {
          "once_key": "first-run"
        }
      ]
    },
    {
      "reason": "replay",
      "on_event": {
        "event_kind": "walkthrough-requested",
        "match": {
          "walkthrough_id": "funnel"
        }
      }
    }
  ],
  "steps": [
    {
      "id": "intro",
      "content": {
        "content_kind": "text",
        "payload": {
          "title": "Follow one funnel",
          "body": "See this funnel stage by stage, with how many people reached each one."
        }
      },
      "target_preparation": {
        "surface": {
          "id": "trillion.funnel"
        }
      },
      "target_ref": {
        "from": "selector",
        "query": "[data-trillion-screen=\"funnel\"]"
      },
      "cutout": {
        "shapes": [
          {
            "shape": "rounded-rect",
            "padding": 6,
            "radius": 10
          }
        ]
      },
      "placement": {
        "prefer": "below",
        "auto_flip": true,
        "gap": 14
      },
      "nav": {
        "buttons": [
          {
            "role": "skip",
            "label": "Skip"
          },
          {
            "role": "advance",
            "label": "Show me"
          }
        ]
      },
      "centered_when_target_missing": true
    },
    {
      "id": "stages",
      "content": {
        "content_kind": "text",
        "payload": {
          "title": "Its stages",
          "body": "Each stage of this funnel shows how many people reached it."
        }
      },
      "target_preparation": {
        "surface": {
          "id": "trillion.funnel"
        }
      },
      "target_ref": {
        "from": "selector",
        "query": "[data-trillion-screen=\"funnel\"] [data-funnel] > :last-child"
      },
      "cutout": {
        "shapes": [
          {
            "shape": "rounded-rect",
            "padding": 6,
            "radius": 10
          }
        ]
      },
      "placement": {
        "prefer": "above",
        "auto_flip": true,
        "gap": 14
      },
      "centered_when_target_missing": true
    }
  ]
