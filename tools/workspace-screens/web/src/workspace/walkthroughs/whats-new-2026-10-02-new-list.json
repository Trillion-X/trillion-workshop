  "steps": [
    {
      "id": "intro",
      "content": {
        "content_kind": "text",
        "payload": {
          "title": "You can see what is new at a glance",
          "body": "The top of your sidebar now shows what was just added, and you can make lists that show only for a while."
        }
      },
      "nav": {
        "buttons": [
          {
            "role": "skip",
            "label": "Skip"
          },
          {
            "role": "advance",
            "label": "Show me"
          }
        ]
      }
    },
    {
      "id": "new-list",
      "content": {
        "content_kind": "text",
        "payload": {
          "title": "New",
          "body": "This list holds everything added to Trillion in the last two days, newest first, like Sales contracts. Things leave it by themselves as they get older."
        }
      },
      "target_ref": {
        "from": "selector",
        "query": "[data-sidebar-section-id=\"trillion-new\"], [data-sidebar-open-toggle]"
      },
      "centered_when_target_missing": true,
      "cutout": {
        "shapes": [
          {
            "shape": "rounded-rect",
            "padding": 6,
            "radius": 10
          }
        ]
      },
      "placement": {
        "prefer": "right",
        "auto_flip": true,
        "gap": 14
      }
    },
    {
      "id": "when-it-shows",
      "content": {
        "content_kind": "text",
        "payload": {
          "title": "You can make a list show for a while",
          "body": "Open the menu on any list you made and choose When it shows. You can pick 7 days, a date, or a rule, and the list goes away by itself when that time passes. Your AI can set this up too."
        }
      },
      "target_ref": {
        "from": "selector",
        "query": "[aria-label=\"Add a list\"], [data-sidebar-open-toggle]"
      },
      "centered_when_target_missing": true,
      "cutout": {
        "shapes": [
          {
            "shape": "rounded-rect",
            "padding": 6,
            "radius": 10
          }
        ]
      },
      "placement": {
        "prefer": "right",
        "auto_flip": true,
        "gap": 14
      }
    }
  ]
