        "field_families": {
          "mode": "enforce | dry-run (DATA, not code): dry-run records a refusal but still forwards so an operator can read the trail first",
          "deny": "[ { id, predicate } ] evaluated first; a matching deny refuses; a broken deny predicate still denies",
          "allow": "[ { id, predicate } ] evaluated after deny; a broken allow predicate does not permit; absent-and-no-match denies"
        },
        "predicate_contract": "STRUCTURED self-describing predicate trees (machine-readable, no CEL/string DSL): combinators all/any/not and a bounded comparison-op set (equals, not_equals, contains_ci, matches_ci, in, exists) over a field path array. Adding a new context field is DATA; adding a new op would be the only code change (enum-dissolution boundary).",
        "fail_closed_rule": "deny beats allow; an absent rule denies; a malformed predicate throws and is treated per its list (broken deny denies, broken allow does not permit)",
        "data_owner": "package-set-records-or-imported-facts"
      },
      "payload_text": null,
      "payload_base64": null,
