        "kind": "ai-tool-descriptor",
        "id": "tool:check-an-action-policy",
        "label": "Check my AI action policy",
        "status": "active",
        "job": "Check my AI action policy before I rely on it: rules it cannot evaluate, unknown behaviours, repeated ids and rules that can never decide because an earlier rule always does",
        "description": "Takes the fields the policy rules may read from an action and the policy (rules in order, each with an id, an optional `when` rule tree and a `then`). Answers ok and a list of problems, each with the rule id, a problem name (unknown-behaviour, incomplete-when, repeated-id or never-decides) and a sentence saying what is wrong. A rule never decides when another rule with the same `when` always holds first: any rule with the same `when` as a refusing rule, or an earlier rule with the same `when` as it. Nothing is changed; a request that cannot be run is refused with a sentence that says what to send.",
        "input_schema": {
          "type": "object",
          "required": ["fields", "policy"],
          "properties": {
            "fields": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["id", "kind"],
                "properties": {
                  "id": { "type": "string" },
                  "kind": { "type": "string" },
                  "path": { "type": "array", "items": {} }
                }
              }
            },
            "policy": {
              "type": "object",
              "required": ["rules"],
              "properties": {
                "rules": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["id", "then"],
                    "properties": {
                      "id": { "type": "string" },
                      "says": { "type": "string" },
                      "when": { "type": "object" },
                      "then": { "type": "string" }
                    }
                  }
                }
              }
            },
            "operators": { "type": "object", "description": "Comparisons and combinators as rows of data, replacing the built-in ones" }
          }
        },
        "output_schema": {
          "type": "object",
          "required": ["ok", "problems"],
          "properties": {
            "ok": { "type": "boolean" },
            "problems": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["rule", "problem", "says"],
                "properties": {
                  "rule": { "type": "string" },
                  "problem": { "type": "string", "description": "unknown-behaviour, incomplete-when, repeated-id or never-decides" },
                  "says": { "type": "string" }
                }
              }
            }
          }
        },
        "invoke": {
          "kind": "container",
          "files": {
            "package_files": [
              { "package": "decide-agent-actions", "paths": ["do-work", "read-data"], "at": "/opt/decide-agent-actions" },
              { "package": "formula-engine", "paths": ["rules", "built-stored-bytes/formula-engine"], "at": "/opt/node_modules/trillion-workshop/tools/formula-engine" },
              { "package": "content-identity", "paths": ["read-data"], "at": "/opt/content-identity" },
              {
                "packages": ["node_modules/@noble/hashes"],
                "paths": ["LICENSE", "package.json", "blake3.js", "blake2.js", "_blake.js", "_md.js", "_u64.js", "utils.js"],
                "at": "/opt/node_modules/@noble/hashes"
              }
            ]
          },
          "workdir": "/opt/decide-agent-actions",
          "internet": false,
          "stdout": "json",
          "argv": ["node", "do-work/run-request.mjs", "checkAnActionPolicy"],
          "stdin": { "fill": { "from": "input" } }
        },
        "needs": { "expected_seconds": 5, "network_egress": false, "memory_mb": 256 },
        "licence_class": "licence:maker-own",
        "placements": ["placement:small-container"],
        "maker": "maker:decide-agent-actions",
        "result_selector": "$.result",
        "verify": [
          {
            "kind": "sample-run",
            "input": {
              "fields": [{ "id": "tool", "kind": "choice" }],
              "policy": {
                "rules": [
                  { "id": "allow-reads", "when": { "kind": "rule", "field": "tool", "operator": "is_any_of", "params": { "values": ["read-a-file"] } }, "then": "allow" },
                  { "id": "ask-reads", "when": { "kind": "rule", "field": "tool", "operator": "is_any_of", "params": { "values": ["read-a-file"] } }, "then": "ask" }
                ]
              }
            },
            "output_selector": "$.problems[0].problem",
            "contains": "never-decides"
          }
        ],
        "provenance": {
          "source": "written for the Workshop from public reverse-engineering findings on agent approval gates (no third-party code)"
        }
      }
    }
  ]
