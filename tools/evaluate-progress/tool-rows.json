   ],
   "payload": {
    "kind": "ai-tool-descriptor",
    "id": "tool:check-claims-are-grounded",
    "label": "Check claims cite sources that were read",
    "status": "active",
    "job": "Check that each claim in an answer cites a source that was really read, and none cites one that was not",
    "description": "Takes the claims of an answer (each with citations naming a source id) and the ids of the sources that were really retrieved. A claim is grounded when at least one of its citations names a retrieved source. A claim with no citation is not grounded, and a citation to a source that was not retrieved is a fabricated reference that fails the whole answer. The answer is grounded when the share of grounded claims reaches min_grounded_ratio (1 when left out) and nothing was fabricated. An empty answer is never grounded.",
    "input_schema": {
     "type": "object",
     "required": [
      "claims",
      "retrieved_source_ids"
     ],
     "properties": {
      "claims": {
       "type": "array",
       "items": {
        "type": "object",
        "required": [
         "text"
        ],
        "properties": {
         "text": {
          "type": "string"
         },
         "citations": {
          "type": "array",
          "items": {
           "type": "object",
           "required": [
            "source_id"
           ],
           "properties": {
            "source_id": {
             "type": "string"
            },
            "quote": {
             "type": "string"
            }
           }
          }
         }
        }
       }
      },
