{
 "kind": "tool-rows",
 "record_set": "evaluate-progress-tool-rows",
 "what_this_is": "The Workshop rows for tools/evaluate-progress: measures worked out from a person's records and bands, gates and scores over them. Each row runs one function of do-work/requests.mjs on the request given; the records, definitions, rules and words are the person's, none is built in.",
 "records": [
