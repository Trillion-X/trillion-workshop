   ],
   "payload": {
    "kind": "ai-tool-descriptor",
    "id": "tool:work-out-measures",
    "label": "Work out measures from my records",
    "status": "active",
    "job": "Work out measures from my records: counts, totals, ratios, ranks, quantiles, the latest value, groups, or a ranked and packed list",
    "description": "Takes facts (a list of records) and measure definitions, or a pipeline of stages where a later stage reads the rows an earlier stage emitted. Each definition names an op (count, sum, distinct, ratio, bin, band, rank, latest, quantile, angle, rollup, formula, reduce-graph, weighted-rank, derive-spans, constrained-span-pack, relevance-rank, mutual-overlap), the fact windows it reads (a match on fields and a field path) and the op's params. Answers each measure with its value, confidence, the ids of the facts it read and ok. An op that is not known, or that fails, gives ok false and confidence 0, never a made-up number. Nothing is named by the tool: the fields, bands, weights and words are in the definitions.",
    "input_schema": {
     "type": "object",
     "required": [
      "facts"
     ],
     "properties": {
      "facts": {
       "type": "array",
       "items": {
        "type": "object"
       },
       "description": "The records to measure over"
      },
      "measures": {
       "type": "array",
       "items": {
        "type": "object",
        "required": [
         "id",
         "op"
        ],
        "properties": {
         "id": {
          "type": "string"
         },
         "op": {
          "type": "string"
         },
         "inputs": {
          "type": "array",
          "items": {
           "type": "object",
           "properties": {
            "match": {
             "type": "object",
             "description": "Fields a record must equal to be read"
            },
            "field": {
             "type": "array",
             "items": {
              "type": "string"
             },
             "description": "Path to the value in each record"
            }
           }
          }
         },
         "params": {
          "type": "object"
         },
         "window": {},
         "emit": {
          "type": "string"
         },
         "failClosed": {
          "type": "boolean"
         }
        }
       },
       "description": "Definitions to derive over the same facts"
      },
      "measure": {
       "type": "object",
       "description": "One definition, when there is only one"
      },
      "measure_id": {
       "type": "string",
       "description": "Derive only the definition with this id Refused when a pipeline is sent."
      },
      "params_override": {
       "type": "object",
       "description": "Params that replace the same-named params of the chosen definitions for this run Refused when a pipeline is sent."
      },
      "pipeline": {
       "type": "object",
       "required": [
        "stages"
       ],
       "properties": {
        "stages": {
         "type": "array",
         "items": {
          "type": "object",
          "required": [
           "id",
           "def"
          ],
          "properties": {
           "id": {
            "type": "string"
           },
           "def": {
            "type": "object"
           },
           "from": {
            "type": "array",
            "items": {
             "type": "string"
            },
            "description": "Stage ids to read, or \"$facts\" for the raw records (the default)"
           }
          }
         }
        },
        "result": {
         "type": "string",
         "description": "The stage that is the answer (the last one when left out)"
        }
       }
      }
     }
    },
    "output_schema": {
     "type": "object",
     "properties": {
      "measures": {
       "type": "array",
       "items": {
        "type": "object",
        "required": [
         "measureId",
         "value",
         "confidence",
         "basis",
         "ok"
        ]
       }
      },
      "stages": {
       "type": "object"
      },
      "order": {
       "type": "array"
      },
      "result": {}
     }
    },
