  "worked_examples": [
    {
      "title": "Link records into people and stage each on a sample input",
      "ask": "Run tool:stitch-facts-into-people.",
      "mcp": {
        "server": "trillion",
        "tool": "run_resource_operation",
        "input": {
          "address": "@workshop-tools",
          "method": "tools:run",
          "input": {
            "tool": "tool:stitch-facts-into-people",
            "input": {
              "facts": [
                {
                  "member": "m-17",
                  "visit": "first",
                  "source": "flyer",
                  "at": "2026-01-01"
                },
                {
                  "member": "m-17",
                  "visit": "bought",
                  "source": "shop",
                  "at": "2026-01-02"
                }
              ],
              "config": {
                "keyPaths": [
                  [
                    "member"
                  ]
                ],
                "strongKeyPaths": [
                  [
                    "member"
                  ]
                ],
                "stageRules": [
                  {
                    "when": {
                      "field": [
                        "visit"
                      ],
                      "equals": "first"
                    },
                    "stage": "visited",
                    "rank": 1
                  },
                  {
                    "when": {
                      "field": [
                        "visit"
                      ],
                      "equals": "bought"
                    },
                    "stage": "customer",
                    "rank": 2
                  }
                ],
                "sourcePath": [
                  "source"
                ],
                "timePath": [
                  "at"
                ],
                "confidence": {
                  "identified": "known",
                  "anonymous": "unknown"
                }
              }
            }
          }
        }
      },
      "hands_back": "The answer's $.ledger[0].stage contains \"customer\"."
    }
  ]
