        "kind": "ai-tool-descriptor",
        "id": "tool:run-a-poker-table",
        "label": "Run a game of Texas Hold'em at a table",
        "status": "active",
        "job": "Run a game of Texas Hold'em poker for a table of players: open a table, seat players, deal a hand, take each player's action, and deal the next hand",
        "description": "Keep the table's saved state (the room) and send it back with one operation each time. open-table makes a table in its lobby from a list of player names and optional settings (starting chips, blinds, blind mode and increase, most players). seat-player adds a player (only in the lobby) or reconnects one by id or name. configure-table changes the settings. start-game posts the blinds and deals every player two cards and the board. player-action is the turn of the seat to act: fold, checkCall, raise (with an amount) or allIn; a round that is over moves on by itself to the next street and then to the showdown, and the answer says in words what happened. next-hand moves the dealer on, raises the blinds by the table's mode and deals again. kick-player removes a player and deals again if a hand was in play. Every deal takes a seed (any whole number), so the same table and seed always deal the same cards. The room holds every player's cards: give a player only what view-a-poker-table-for-a-player returns. One pot is kept per hand: when a player who is all in has put in less than the others, the showdown still pays the whole pot to the best hand. Refuses an action out of turn, a request that does not fit the table's phase, and a room that is not a saved table.",
        "input_schema": {
          "type": "object",
          "required": ["operation"],
          "additionalProperties": false,
          "properties": {
            "operation": { "type": "string", "enum": ["open-table", "seat-player", "configure-table", "start-game", "player-action", "next-hand", "kick-player"], "description": "What to do to the table" },
            "room_id": { "type": "string", "description": "open-table: the table's name" },
            "players": { "type": "array", "items": { "type": "string" }, "description": "open-table: the names of the first players; the first is the host" },
            "config": { "type": "object", "description": "open-table, configure-table: startingChips, smallBlind, bigBlind, blindMode (fixed or multiplier), blindIncrease, maxPlayers", "additionalProperties": true },
            "room": { "type": "object", "description": "The table's saved state, exactly as the last answer gave it", "additionalProperties": true },
            "name": { "type": "string", "description": "seat-player: the player's name" },
            "player_id": { "type": "string", "description": "seat-player: a returning player's id. player-action: the id of the player acting, checked against whose turn it is. kick-player: the player to remove" },
            "action": { "type": "string", "enum": ["fold", "checkCall", "raise", "allIn"], "description": "player-action: what the seat to act does" },
            "amount": { "type": "integer", "minimum": 0, "description": "player-action raise: chips to raise by (at least the table's minimum raise)" },
            "seed": { "type": "integer", "description": "start-game, next-hand, kick-player: any whole number; the same seed deals the same cards" }
          }
        },
        "output_schema": {
          "type": "object",
          "required": ["operation", "room"],
          "properties": {
            "operation": { "type": "string" },
            "room": { "type": "object", "description": "The table's new saved state" },
            "playerId": { "type": "string", "description": "seat-player: the id of the player seated" },
            "event": { "type": "object", "description": "player-action: what happened, as { kind, actorId, text }" }
          }
        },
        "invoke": {
          "kind": "container",
          "files": { "package_files": { "package": "poker", "paths": ["do-work", "read-data"], "at": "/opt/poker" } },
          "workdir": "/opt/poker",
          "internet": false,
          "stdout": "json",
          "argv": ["node", "do-work/run-a-poker-table.mjs"],
          "stdin": { "fill": { "from": "input" } }
        },
        "result_selector": "$.result",
        "needs": { "expected_seconds": 2, "network_egress": false, "memory_mb": 128 },
        "licence_class": "licence:maker-own",
        "placements": ["placement:small-container"],
        "maker": "maker:poker",
        "provenance": { "source": "ported from the poker-rules package (hold'em rules and room state)" },
        "verify": [
          {
            "kind": "sample-run",
            "input": { "operation": "open-table", "room_id": "room:sample", "players": ["Alder", "Birch"], "config": { "smallBlind": 5, "bigBlind": 10, "startingChips": 200 } },
            "output_selector": "$.room.state.phase",
            "contains": "lobby"
          }
        ]
      }
    },
