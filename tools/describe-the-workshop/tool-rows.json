{
  "kind": "tool-rows",
  "record_set": "describe-the-workshop-tool-rows",
  "what_this_is": "Describe a tool and manage this account's live tool-source definitions. Source defaults arrive only from the native task's current source snapshot; source definitions stay in their original-preserving account records.",
  "records": [
    {
      "id": "package::describe-the-workshop::tool::describe-a-tool",
      "address": "package::describe-the-workshop::tool::describe-a-tool",
      "path": ["current-item", "published-record"],
      "payload": {
        "kind": "ai-tool-descriptor",
        "id": "tool:describe-a-tool",
        "label": "Describe a tool",
        "status": "active",
        "job": "Show me one tool's whole row, so I can see how it is written and how to call it",
        "description": "Give the tool's id and the rows the Workshop answered (tools:list) as shared. Reads your own saved row of that tool (record type tool, id tool:<tool id>), or takes it as saved. Your saved row, unless deleted, replaces the shared row of the same id. Answers the tool's descriptor, who made it (this account or shared), the sample rule of the place it runs (read-only or dry-run samples on a person's own computer, owed until a computer connects), the sample-run checks of your own runnable tool, and the next call to make: save_tool for your own, run_tool for a shared tool that runs, nothing for a screen. A tool there is nothing of to describe answers an error naming find_tool_for_job. It reads one row and changes nothing.",
        "input_schema": {
          "type": "object",
          "additionalProperties": false,
          "required": ["tool_id"],
          "properties": {
            "tool_id": { "type": "string", "description": "The id of the tool to describe" },
            "shared": { "type": "array", "items": { "type": "object" }, "description": "The rows the Workshop answered: ai-tool-descriptor rows, and tool-placement and tool-licence-class rows when known" },
            "saved": { "type": ["object", "null"], "description": "Your saved row of this tool to use instead of reading it; null when you have none" }
          }
        },
        "output_schema": {
          "type": "object",
          "required": ["tool_id", "made_by", "descriptor", "next_call"],
          "properties": {
            "tool_id": { "type": "string" },
            "made_by": { "type": "string" },
            "descriptor": { "type": "object" },
            "sample_rule": { "type": "object" },
            "samples": { "type": "array" },
            "next_call": { "type": ["object", "null"] }
          }
        },
        "invoke": {
          "kind": "container",
          "files": {
            "package_files": [
              {
                "package": "describe-the-workshop",
                "paths": [
                  "do-work",
                  "read-data"
                ],
                "at": "/opt/describe-the-workshop"
              },
              {
                "package": "records-door",
                "paths": [
                  "do-work",
                  "read-data"
                ],
                "at": "/opt/records-door"
              },
              {
                "package": "content-identity",
                "paths": [
                  "read-data"
                ],
                "at": "/opt/content-identity"
              },
              {
                "module": "@noble/hashes",
                "paths": [
                  "LICENSE",
                  "package.json",
                  "blake3.js",
                  "blake2.js",
                  "_blake.js",
                  "_md.js",
                  "_u64.js",
                  "utils.js"
                ],
                "at": "/opt/node_modules/@noble/hashes"
              },
              {
                "package": "browse-and-upload-my-files",
                "paths": [
                  "built-stored-bytes/content-chunks/content_chunks.js",
                  "do-work/content-chunks.mjs",
                  "do-work/namespace-client.mjs",
                  "do-work/send-a-file-to-a-namespace.mjs",
                  "do-work/send-retry.mjs",
                  "do-work/send-window.mjs",
                  "do-work/shared-file-reference.mjs",
                  "send-settings.json"
                ],
                "at": "/opt/browse-and-upload-my-files"
              }
            ]
          },
          "workdir": "/opt/describe-the-workshop",
          "internet": false,
          "stdout": "json",
          "argv": ["node", "/opt/records-door/do-work/run-an-export.mjs", "/opt/describe-the-workshop/do-work/describe.mjs", "describeATool"],
          "stdin": { "fill": { "from": "input" } },
          "records": {
            "fd": 3,
            "rights": [
              { "kind": "tool", "operations": ["records:read"] }
            ]
          }
        },
        "needs": { "expected_seconds": 2, "network_egress": false },
        "licence_class": "licence:maker-own",
        "placements": ["placement:small-container"],
        "maker": "maker:describe-the-workshop",
        "result_selector": "$.result",
        "provenance": { "source": "trillion src/workshop.mjs describeTool (1625-1655) and src/workshop-sample-rules.mjs, moved here; the trillion-rust engine's describe route (GET /work/api/workshop/describe/<id>, src/workshop_describe.rs) deleted when this row took it over" },
        "verify": [
          {
            "kind": "sample-run",
            "input": {
              "tool_id": "tool:sample-screen",
              "shared": [{ "kind": "ai-tool-descriptor", "id": "tool:sample-screen", "label": "Sample screen", "screen": { "kind": "parts" } }],
              "saved": null
            },
            "output_selector": "$.made_by",
            "contains": "shared"
          }
        ]
      }
    },
    {
      "id": "package::describe-the-workshop::tool::manage-my-tool-sources",
      "address": "package::describe-the-workshop::tool::manage-my-tool-sources",
      "path": ["current-item", "published-record"],
      "payload": {
        "kind": "ai-tool-descriptor",
        "id": "tool:manage-my-tool-sources",
        "label": "Manage my tool sources",
        "status": "active",
        "job": "List the sources my tools come from, add an API description or tool server for my account, edit it or remove it",
        "description": "An empty request lists current default sources and this account's own sources. Change one source with add, edit or remove and keep the same request_key when retrying it. Your source definition stays in this account's original tool-source record; edits keep its added_at and removal keeps a tombstone. Defaults come only from the native task's current source configuration. Source reads still pending are named as pending. Connection fields are references, never keys or tokens. This manages source definitions; it does not sign in to a server, fetch a tool list, or grant permission to execute its tools. An unavailable native source owner refuses without writing.",
        "input_schema": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "add": { "type": "object", "required": ["kind", "url"], "description": "A source: id?, kind, https url, name?, nonsecret headers?, connection? {connection_id,field_id}, only?" },
            "edit": { "type": "object", "required": ["id"], "description": "An existing private source id and only the fields to change; null removes optional name, headers, connection or only" },
            "remove": { "type": "string", "description": "An active source this account added, by id" },
            "request_key": { "type": "string", "minLength": 1, "description": "Keep this key unchanged when retrying the same change" }
          }
        },
        "output_schema": {
          "type": "object",
          "required": ["every_account", "yours", "kinds"],
          "properties": { "every_account": { "type": "array" }, "yours": { "type": "array" }, "kinds": { "type": "array" } }
        },
        "invoke": {
          "kind": "container",
          "files": { "package_files": [
            { "package": "describe-the-workshop", "paths": ["do-work", "read-data"], "at": "/opt/describe-the-workshop" },
            { "package": "records-door", "paths": ["do-work", "read-data"], "at": "/opt/records-door" },
            { "package": "content-identity", "paths": ["read-data"], "at": "/opt/content-identity" },
            { "module": "@noble/hashes", "paths": ["LICENSE", "package.json", "blake3.js", "blake2.js", "_blake.js", "_md.js", "_u64.js", "utils.js"], "at": "/opt/node_modules/@noble/hashes" }
          ] },
          "workdir": "/opt/describe-the-workshop",
          "internet": false,
          "stdout": "json",
          "argv": ["node", "/opt/records-door/do-work/run-an-export.mjs", "/opt/describe-the-workshop/do-work/sources.mjs", "accountToolSourcesFromTask"],
          "stdin": { "input": { "fill": { "from": "input" } }, "source_data": { "fill": { "from": "task", "field": "source_data" } } },
          "records": {
            "fd": 3,
            "rights": [
              { "kind": "tool-source", "prefix": "tool-source:", "operations": ["records:read", "records:list", "records:write"] },
              { "kind": "tool-source-change", "prefix": "tool-source-change:", "operations": ["records:read", "records:write"] }
            ]
          }
        },
        "needs": { "expected_seconds": 2, "network_egress": false },
        "licence_class": "licence:maker-own",
        "placements": ["placement:small-container"],
        "maker": "maker:describe-the-workshop",
        "result_selector": "$.result",
        "provenance": { "source": "ports/source-lifecycle.json retains the original source slices and adaptation boundaries" },
        "record_model": {
          "_what": "The original-preserving source definitions and narrow semantic retry receipt this tool writes through the current account records owner. No secret value is a source field.",
          "kinds": [
            {
              "type": "tool-source",
              "stays_on_this_device": false,
              "erasable": ["url", "name", "headers", "connection", "only", "page", "about"],
              "properties": {
                "id": "text", "kind": "text", "url": "text", "name": "text", "headers": "object", "connection": "object", "only": "texts",
                "licence": "text", "licence_class": "text", "maker": "text", "page": "text", "about": "text",
                "added_at": "text", "updated_at": "text", "status": "text", "removed_at": "text"
              }
            },
            {
              "type": "tool-source-change",
              "stays_on_this_device": false,
              "properties": { "command_identity": "text" }
            }
          ]
        },
        "verify": [{ "kind": "sample-run", "input": {}, "task": { "source_data": { "config": { "kinds": {}, "sources": [] }, "reads": [] } }, "output_selector": "$.yours" }]
      }
    },
