{
  "records": [
    {
      "payload": {
        "kind": "ai-tool-descriptor",
        "id": "tool:add-tool-source",
        "label": "Add a source of tools",
        "status": "active",
        "job": "Add a source of tools to my computer from one address: a folder, a git repository at any host or a remote MCP server, and learn which it is without my typing a kind",
        "description": "Takes one address and learns what kind of source it is: a path or a file:// address is a folder, mcp+https:// is a remote MCP server (mcp+http://host:port for one of your own at a private address), git+https:// is a git repository, and an https address of a listed git host (github.com, gitlab.com, codeberg.org) or ending .git is a repository. A bare https address is looked at once: it is an MCP server if it answers an MCP initialize (or asks for sign-in the way MCP servers do), a git repository if it answers a git ref advertisement; one that is neither, or both, is refused with what to write instead. Nothing it sends carries a credential, and a private address is not reached. A repository starts at the commit its server names as HEAD now. It keeps one pending request for you (deleted when you approve or decline it; your sources are the engine's own list, read with tools:sources) and hands back the entry and the call that adds it, tools:add-source at @tools, which only you can make: the source starts with an empty grant, so none of its tools may use your records, credentials or hosts until you say so. It adds nothing itself. A server that asks for a sign-in (a 401 that names its sign-in) is signed in to as the Model Context Protocol describes: it finds where the server's sign-in lives, registers this caller, and answers the address to sign in at; the person signs in there and the sign-in tool's page hands the answer back as `callback`, the code is traded for tokens kept in your vault for the engine to use and refresh, and then the request waits for your approval as for any source.",
        "input_schema": {
          "type": "object",
          "additionalProperties": false,
          "required": [],
          "properties": {
            "address": {
              "type": "string",
              "description": "The source's address: a folder path (/path or ~/path), a git repository's https address or a remote MCP server's https address, optionally with the prefix mcp+ or git+ when it is not plain from the address"
            },
            "label": {
              "type": "string",
              "description": "The name the source goes by in the menu of tools; made from the address when left out"
            },
            "credential": {
              "type": "string",
              "description": "For a server that asks for a sign-in: the name of the secret in your vault its bearer is read from"
            },
            "connection": {
              "type": "object",
              "description": "For a server that asks for a sign-in through a service you connected: {connection_id, field_id} of the field that holds its token",
              "properties": {
                "connection_id": {
                  "type": "string"
                },
                "field_id": {
                  "type": "string"
                }
              },
              "required": [
                "connection_id",
                "field_id"
              ]
            },
            "callback": {
              "type": "object",
              "description": "The answer of a server's sign-in page the person came back from: {state, code} or {state, error}; given by the sign-in tool's page, with no address",
              "properties": {
                "state": {
                  "type": "string"
                },
                "code": {
                  "type": "string"
                },
                "error": {
                  "type": "string"
                }
              },
              "required": [
                "state"
              ]
            }
          }
        },
        "output_schema": {
          "type": "object",
          "required": [
            "source",
            "entry",
            "approve",
            "said"
          ],
          "properties": {
            "source": {
              "type": "object",
              "properties": {
                "label": {
                  "type": "string"
                },
                "kind": {
                  "type": "string"
                },
                "learned": {
                  "type": "string"
                },
                "row": {
                  "type": "string"
                }
              }
            },
            "entry": {
              "type": "object"
            },
            "approve": {
              "type": "object"
            },
            "said": {
              "type": "string"
            },
            "sign_in": {
              "type": "object",
              "description": "The address to sign in at, when the server asks for a sign-in"
            }
          }
        },
        "invoke": {
          "kind": "container",
          "files": {
            "package_files": [
              {
                "package": "add-tool-source",
                "paths": [
                  "do-work",
                  "read-data"
                ],
                "at": "/opt/add-tool-source"
              },
              {
                "package": "records-door",
                "paths": [
                  "do-work",
                  "read-data"
                ],
                "at": "/opt/records-door"
              },
              {
                "package": "content-identity",
                "paths": [
                  "read-data"
                ],
                "at": "/opt/content-identity"
              },
              {
                "module": "@noble/hashes",
                "paths": [
                  "LICENSE",
                  "package.json",
                  "blake3.js",
                  "blake2.js",
                  "_blake.js",
                  "_md.js",
                  "_u64.js",
                  "utils.js"
                ],
                "at": "/opt/node_modules/@noble/hashes"
              },
              {
                "package": "browse-and-upload-my-files",
                "paths": [
                  "built-stored-bytes/content-chunks/content_chunks.js",
                  "do-work/content-chunks.mjs",
                  "do-work/namespace-client.mjs",
                  "do-work/send-a-file-to-a-namespace.mjs",
                  "do-work/send-retry.mjs",
                  "do-work/send-window.mjs",
                  "do-work/shared-file-reference.mjs",
                  "send-settings.json"
                ],
                "at": "/opt/browse-and-upload-my-files"
              },
              {
                "package": "content-identity",
                "paths": [
                  "read-data"
                ],
                "at": "/opt/content-identity"
              },
              {
                "module": "@noble/hashes",
                "paths": [
                  "LICENSE",
                  "package.json",
                  "blake3.js",
                  "blake2.js",
                  "_blake.js",
                  "_md.js",
                  "_u64.js",
                  "utils.js"
                ],
                "at": "/opt/node_modules/@noble/hashes"
              }
