        "kind": "ai-tool-descriptor",
        "id": "tool:trade-a-tool-servers-sign-in-code-for-its-tokens",
        "label": "Trade a tool server's sign-in code for its tokens",
        "status": "active",
        "job": "Trade the code a remote tool server's sign-in page handed back for its access and refresh tokens, kept sealed in the vault",
        "description": "One token request to the server's authorization server at the address its own sign-in documents gave (RFC 6749 section 4.1.3, a public client: the code, the callback address, the PKCE verifier and the client id go in a form body, the server named as the resource). The reply's access_token and refresh_token are kept in the vault as the fields of the connection the sign-in was made for (reply_holds_values) before the reply is read; nothing else is kept. Run by tool:add-tool-source when the person comes back from the sign-in page.",
        "input_schema": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "connection",
            "token_url",
            "code",
            "redirect_uri",
            "code_verifier",
            "client_id",
            "resource"
          ],
          "properties": {
            "connection": {
              "type": "object",
              "required": [
                "connection_id"
              ],
              "additionalProperties": false,
              "properties": {
                "connection_id": {
                  "type": "string",
                  "description": "service_connection:tool-server:<the source's label>"
                }
              }
            },
            "token_url": {
              "type": "string",
              "description": "The authorization server's token address, from its sign-in documents"
            },
            "code": {
              "type": "string",
              "minLength": 1
            },
            "redirect_uri": {
              "type": "string",
              "minLength": 1
            },
            "code_verifier": {
              "type": "string",
              "minLength": 43,
              "maxLength": 128
            },
            "client_id": {
              "type": "string",
              "minLength": 1
            },
            "resource": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "output_schema": {
          "type": "object",
          "description": "The server's token reply, each kept token replaced by the held word"
        },
        "invoke": {
          "kind": "http",
          "url": {
            "fill": {
              "from": "input",
              "field": "token_url"
            }
          },
          "method": "POST",
          "body_encoding": "form",
          "timeout_seconds": 30,
          "headers": {
            "accept": "application/json"
          },
          "body": {
            "grant_type": "authorization_code",
            "code": "{code}",
            "redirect_uri": "{redirect_uri}",
            "code_verifier": "{code_verifier}",
            "client_id": "{client_id}",
            "resource": "{resource}"
          },
          "connection": {
            "vendor": "tool-server",
            "from_input": "connection"
          },
          "reply_holds_values": [
            {
              "from": "access_token",
              "keep_as_field": "access_token",
              "required": true
            },
            {
              "from": "refresh_token",
              "keep_as_field": "refresh_token"
            }
          ]
        },
        "needs": {
          "expected_seconds": 5,
          "network_egress": true
        },
        "licence_class": "licence:maker-own",
        "placements": [
          "placement:public-web-address"
        ],
        "maker": "maker:add-tool-source",
        "result_selector": "$",
        "provenance": {
          "source": "the owner's decision case source:a2VlcC1vbmx5LWJyaWFucy1kYXRhLWFuZC13aXBlLXRoZS1ib3hlcy0yMDI2LTExLTE2; MCP authorization, RFC 6749 and RFC 8707"
        }
      }
    }
  ]
