{
  "records": [
    {
      "payload": {
        "kind": "ai-tool-descriptor",
        "id": "tool:add-tool-source",
        "label": "Add a source of tools",
        "status": "active",
        "job": "Add a source of tools to my computer from one address: a folder, a git repository at any host or a remote MCP server, and learn which it is without my typing a kind",
        "description": "Takes one address and learns what kind of source it is: a path or a file:// address is a folder, mcp+https:// is a remote MCP server (mcp+http://host:port for one of your own at a private address), git+https:// is a git repository, and an https address of a listed git host (github.com, gitlab.com, codeberg.org) or ending .git is a repository. A bare https address is looked at once: it is an MCP server if it answers an MCP initialize (or asks for sign-in the way MCP servers do), a git repository if it answers a git ref advertisement; one that is neither, or both, is refused with what to write instead. Nothing it sends carries a credential, and a private address is not reached. A repository starts at the commit its server names as HEAD now. It keeps one row in your list of tool sources (waiting for your approval) and hands back the entry and the call that adds it, tools:add-source at @tools, which only you can make: the source starts with an empty grant, so none of its tools may use your records, credentials or hosts until you say so. It adds nothing itself.",
        "input_schema": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "address"
          ],
          "properties": {
            "address": {
              "type": "string",
              "description": "The source's address: a folder path (/path or ~/path), a git repository's https address or a remote MCP server's https address, optionally with the prefix mcp+ or git+ when it is not plain from the address"
            },
            "label": {
              "type": "string",
              "description": "The name the source goes by in the menu of tools; made from the address when left out"
            }
          }
        },
        "output_schema": {
          "type": "object",
          "required": [
            "source",
            "entry",
            "approve",
            "said"
          ],
          "properties": {
            "source": {
              "type": "object",
              "properties": {
                "label": {
                  "type": "string"
                },
                "kind": {
                  "type": "string"
                },
                "learned": {
                  "type": "string"
                },
                "row": {
                  "type": "string"
                }
              }
            },
            "entry": {
              "type": "object"
            },
            "approve": {
              "type": "object"
            },
            "said": {
              "type": "string"
            }
          }
        },
        "invoke": {
          "kind": "container",
          "files": {
