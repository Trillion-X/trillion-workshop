        "kind": "ai-tool-descriptor",
        "id": "tool:choose-programs-left-running",
        "label": "Choose the programs left running",
        "job": "Choose which running programs were left behind by a session that ended, judged only by the person's own left-behind and never-stop rule rows",
        "description": "Reads nothing and changes nothing. Give programs and complete as tool:list-running-programs answered them with commands, left_behind (the person's rows saying how a program is left behind: parent_pid and/or session_owner_gone, older_than_minutes, and optionally cpu_share_at_least, command_pattern and name_pattern, every condition holding at once) and never_stop (the person's rows naming a command_pattern and/or name_pattern that is never stopped). A list not given is refused, never read as empty. A program whose session still has an owner, or that the rows cannot be judged on, is always kept. Returns read (how many rows of each list it read), picked (each program to stop with the row that says so and why), kept (the programs a never-stop row kept) and said.",
        "status": "active",
        "input_schema": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "programs",
            "complete",
            "left_behind",
            "never_stop"
          ],
          "properties": {
            "programs": {
              "type": "array",
              "description": "The programs tool:list-running-programs answered, read with commands."
            },
            "complete": {
              "type": "boolean",
              "description": "Whether that list was complete; a list cut short cannot show that a session ended."
            },
            "left_behind": {
              "type": "array",
              "items": {
                "type": "object"
              },
              "description": "The person's left-behind rule rows: id, why, parent_pid, session_owner_gone, older_than_minutes, cpu_share_at_least, command_pattern, name_pattern."
            },
            "never_stop": {
              "type": "array",
              "items": {
                "type": "object"
              },
              "description": "The person's never-stop rule rows: id, why, command_pattern, name_pattern. Required: [] only when the person keeps none."
            }
          }
        },
        "output_schema": {
          "type": "object",
          "required": [
            "read",
            "picked",
            "kept",
            "said"
          ],
          "properties": {
            "read": {
              "type": "object"
            },
            "picked": {
              "type": "array"
            },
            "kept": {
              "type": "array"
            },
