      "payload": {
        "kind": "ai-tool-descriptor",
        "id": "tool:settle-two-versions",
        "label": "Settle two versions",
        "status": "active",
        "job": "Settle a record two of my devices changed apart: keep one version, keep both, or keep a merged one",
        "description": "Writes what you chose for one record kept apart (id, from see-if-my-copies-are-in-step): keep one (side, the id of the version to keep), both (each other version is kept as a record of its own, named after it with -kept- and a number that no record holds yet), or merged (value, the merged record). What you chose is written first and the kept versions are removed in the same write, so every copy takes it like any change. thing_type is the kind of the record. Every write stands only on what was read: a record changed meanwhile answers conflict and nothing is written.",
        "input_schema": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "keep",
            "thing_type",
            "request_key"
          ],
          "properties": {
            "id": {
              "type": "string",
              "description": "The record kept apart, as the read names it"
            },
            "keep": {
              "type": "string",
              "enum": [
                "one",
                "both",
                "merged"
              ]
            },
            "side": {
              "type": "string"
            },
            "value": {},
            "thing_type": {
              "type": "string",
              "description": "The kind of record whose versions to read or settle (one kind per call; other_kinds names the rest)"
            },
            "request_key": {
              "type": "string",
              "description": "Names this change, so sending it again changes nothing twice"
            }
          }
