            "sayHowThisDeviceStands"
          ],
          "stdin": {
            "fill": {
              "from": "input"
            }
          },
          "records": {
            "fd": 3,
            "rights": [
              {
                "kind": "setting",
                "id": "setting:catch_up_devices",
                "operations": [
                  "records:read",
                  "records:write"
                ]
              }
            ]
          }
        },
        "needs": {
          "expected_seconds": 3,
          "network_egress": false
        },
        "licence_class": "licence:maker-own",
        "placements": [
          "placement:small-container"
