        "kind": "ai-tool-descriptor",
        "id": "tool:say-how-this-device-stands",
        "label": "Say how this device stands",
        "status": "active",
        "job": "Keep how this device of mine stands: caught up, offline or still holding changes",
        "description": "Keeps one device's report in your device rows (setting:catch_up_devices): device_id (the id the device keeps for itself), state, waiting (the changes it still holds), at (when its writes last reached your store), title, kind and copy_id (the copy of your records it keeps). The row is written only when what you would see changed, or when its last catch-up moved by more than an hour; at most 40 devices are kept, newest first. One write, only while the rows are still what was read: rows changed meanwhile answer conflict and nothing is written.",
        "input_schema": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "device_id",
            "state",
            "request_key"
          ],
          "properties": {
            "device_id": {
              "type": "string"
            },
            "state": {
              "type": "string"
            },
            "waiting": {
              "type": "integer"
            },
            "at": {
              "type": [
                "string",
                "number"
              ]
            },
            "title": {
              "type": "string"
            },
            "kind": {
              "type": "string"
            },
            "copy_id": {
              "type": "string"
            },
            "request_key": {
              "type": "string",
              "description": "Names this change, so sending it again changes nothing twice"
            },
            "now": {
              "type": "string",
              "description": "The time to report at (ISO); now when left out"
            }
          }
        },
        "output_schema": {
          "type": "object",
          "required": [
            "written"
          ],
          "properties": {
            "written": {
              "type": "boolean"
            },
            "device": {
              "type": "object"
            },
            "conflict": {
              "type": "boolean"
            }
          }
        },
        "invoke": {
