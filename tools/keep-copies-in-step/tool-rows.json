              "type": "string"
            },
            "kind": {
              "type": "string"
            },
            "copy_id": {
              "type": "string"
            },
            "request_key": {
              "type": "string"
            },
            "now": {
              "type": "string"
            }
          }
        },
        "invoke": {
          "kind": "container",
          "files": {
