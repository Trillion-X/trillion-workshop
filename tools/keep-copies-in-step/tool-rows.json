    {
      "id": "package::keep-copies-in-step::tool::settle-two-versions",
      "address": "package::keep-copies-in-step::tool::settle-two-versions",
      "path": [
        "current-item",
        "published-record"
      ],
      "payload": {
        "kind": "ai-tool-descriptor",
        "id": "tool:settle-two-versions",
        "label": "Settle a record kept as two versions",
        "status": "active",
        "job": "Settle a record two of my copies changed apart, as I chose",
        "description": "Settles a record kept as two versions (id from tool:see-copies-in-step, kind its thing's kind): keep \"one\" version (side: its id), keep \"both\" as separate records (each other version is written as a record named after it), or keep a \"merged\" value (value: the whole record as it should be). The choice is written and the kept versions are removed in one write, conditioned on what was read; a record changed meanwhile answers conflict and nothing is written. Settle only as the person chose. request_key makes the same settle safe to send again.",
        "input_schema": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "id",
            "keep",
            "request_key"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "description": "The kind of records whose versions to read or settle, for example note; the run reaches records of this kind only"
            },
            "id": {
              "type": "string"
            },
            "keep": {
              "type": "string",
              "enum": [
                "one",
                "both",
                "merged"
              ]
            },
            "side": {
              "type": "string",
              "description": "With keep one: the id of the version to keep"
            },
            "value": {
              "description": "With keep merged: the record as it should be kept"
            },
            "request_key": {
              "type": "string"
            }
          }
        },
