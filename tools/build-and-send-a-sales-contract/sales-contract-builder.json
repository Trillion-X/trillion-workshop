  "after_payment": {
    "trigger": {
      "recorded": "commercial-event",
      "where": [
        {
          "field": "event",
          "equals": "negotiated_offer_paid"
        }
      ]
    },
    "steps": [
      {
        "id": "welcome-email",
        "label": "Send the welcome email",
        "detail": "Emails them the moment they pay",
        "icon": "MailCheck",
        "on": "paid",
        "chosen": true,
        "then": {
          "tool_id": "tool:send-an-email",
          "input": {
            "to": "{to}",
            "subject": "Welcome to {contract_name}",
            "markdown": "Thank you for joining {contract_name}. Your payment came through, and I will be in touch shortly with your first steps.",
            "preheader": "Your payment came through"
          }
        }
      },
      {
        "id": "tell-me",
        "label": "Tell me when they pay",
        "detail": "A notice for you the moment it is paid",
        "icon": "BellRing",
        "on": "paid",
        "chosen": true,
        "then": {
          "tool_id": "tool:tell-the-person",
          "input": {
            "title": "{to} paid for {contract_name}",
            "key": "paid:{contract_id}"
          }
        }
      },
      {
        "id": "check-in",
        "label": "Check in after 3 days",
        "detail": "Emails them 3 days after you send it, at 10:00",
        "icon": "CalendarClock",
        "on": {
          "after_days": 3,
          "at": "10:00"
        },
        "chosen": true,
        "then": {
          "tool_id": "tool:send-an-email",
          "input": {
            "to": "{to}",
            "subject": "Any questions about {contract_name}?",
            "markdown": "I wanted to check in on the plan we put together. If anything is unclear, reply here and I will help. Your link: {address}",
            "preheader": "Checking in on the plan we put together"
          }
        }
      }
    ],
    "workflow_step": {
      "label": "Run {label}",
      "detail": "Starts your workflow when they pay",
      "icon": "Workflow",
      "on": "paid"
    }
  },
