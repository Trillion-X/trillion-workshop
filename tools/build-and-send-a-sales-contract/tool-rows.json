        "kind": "ai-tool-descriptor",
        "id": "tool:sales-contracts",
        "label": "Sales contracts in my database",
        "job": "Save, list and read sales contracts as rows of a sales_contracts table in one of my pursuit databases",
        "description": "Saves a sales contract (contract with a name and optional primitives), lists one page of them newest first, or reads one by contract_id, in the sales_contracts table of the named pursuit database (the tool makes that table if it is missing). Nothing here fixes a price, a term or a billing period; a removed contract is not read and not revived by a save. Answers the saved or listed contracts with their times, or the database's own error text.",
        "status": "active",
        "input_schema": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "action",
            "database"
          ],
          "properties": {
            "action": {
              "type": "string",
              "enum": [
                "save",
                "list",
                "read"
              ],
              "description": "save a contract (contract, optionally contract_id to change one), list one page of them, or read one by contract_id."
            },
            "database": {
              "type": "string",
              "minLength": 1,
              "description": "The name of the person's pursuit database that holds the sales_contracts table, such as ethos_for_who_runs_it. The computer opens it with the login its vault holds as that name and -connection."
            },
            "credential_name": {
              "type": "string",
              "description": "The vault name of the connection string, when it is not the database's own -connection name."
            },
            "contract": {
              "type": "object",
              "description": "The contract terms: a name (required) and an optional list of primitives. Nothing here fixes a price, a term or a billing period."
            },
            "contract_id": {
              "type": "string",
              "description": "The id of an existing contract (read, or save to change it)."
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "description": "Contracts per list page; 50 when absent."
            },
            "after": {
              "type": "string",
              "description": "The next cursor a list answered, for the next page."
            }
          }
        },
        "output_schema": {
          "type": "object"
        },
