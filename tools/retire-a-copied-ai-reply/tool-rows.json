                    "at": "2026-10-03T05:04:51Z",
                    "source_ref": "msg_final"
                  }
                }
              ],
              "duplicate_id": "message:manual",
              "kept_id": "message:source",
              "evidence": "Transcript msg_final at 05:04:51Z matches the manual copy at 05:04:29Z",
              "now": "2026-10-03T06:00:00Z"
            },
            "output_selector": "$.result.correction.duplicate_id",
            "contains": false
          }
        ]
      }
    }
  ]
}
