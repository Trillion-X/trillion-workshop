    "kind": "ai-tool-descriptor",
    "id": "tool:plan-a-column-fill",
    "label": "Fill a column by asking my sources in order",
    "status": "active",
    "job": "Fill one column of my list row by row by asking my sources in my order until one gives an answer that passes my check, paying only for the sources each row needs: tell me the next calls to run, and turn what they answered into values",
    "description": "Takes rows, where each row's id is, the column (field), the sources in the order to ask them (each a Workshop tool, its input built from the row's fields or fixed values, where the value is in its answer, its cost and its source kind), an accept check (a tools/formulas rule tree over the answer as field value), an optional run_if rule tree over the rows, and the attempts already made with what each answered. Answers the next calls to make, one source at a time per row, each with a request key (the content identity of row, source, tool and input, so a retry is never paid twice); the values found, each as an offer settle-field-values reads; the rows skipped (run_if does not hold, already has a value while keep_existing holds) and the rows out of sources with what each source did. Run it again with the new attempts until done. stop_after_same_failure stops a row whose sources keep giving the same rejected answer; most_calls bounds one run.",
    "input_schema": {
     "type": "object",
     "required": ["records", "id_path", "field", "sources"],
     "properties": {
      "records": { "type": "array", "items": { "type": "object" } },
      "id_path": { "type": "array", "description": "Where each row's id is" },
      "field": { "type": "object", "required": ["id"], "properties": { "id": { "type": "string" }, "path": { "type": "array" } } },
      "sources": { "type": "array", "items": { "type": "object", "required": ["id", "tool"], "properties": { "id": { "type": "string" }, "tool": { "type": "string", "description": "The Workshop tool id to run" }, "input": { "type": "object", "description": "Each input name to { from: [path in the row] } or { value }" }, "answer_path": { "type": "array", "description": "Where the value is in the tool's answer" }, "kind": { "type": "string", "description": "The source kind its values carry; source by default" }, "cost": { "type": "number" } } } },
      "accept": { "type": "object", "required": ["kind", "tree"], "description": "A check the answer must pass: a tools/formulas rule tree over the field value of this kind" },
      "run_if": { "type": "object", "description": "A tools/formulas rule tree over fields: only the rows it keeps are filled" },
      "fields": { "type": "array", "description": "The fields run_if reads: { id, kind, path? }" },
      "keep_existing": { "type": "boolean", "description": "Leave rows that already have a value; true by default" },
      "attempts": { "type": "array", "items": { "type": "object", "required": ["row", "source"], "properties": { "row": { "type": ["string", "integer"] }, "source": { "type": "string" }, "answer": {}, "error": { "type": "string" }, "cost": { "type": "number" } } } },
      "stop_after_same_failure": { "type": "integer", "minimum": 1 },
      "most_calls": { "type": "integer", "minimum": 1 },
      "operators": { "type": "object" }
     }
    },
    "output_schema": {
     "type": "object",
     "required": ["calls", "filled", "skipped", "exhausted", "waiting", "done", "cost"],
     "properties": {
      "calls": { "type": "array", "items": { "type": "object", "required": ["row", "source", "tool", "input", "request_key"] } },
      "filled": { "type": "array", "items": { "type": "object", "required": ["row", "field", "value", "answered_by", "offer"] } },
      "skipped": { "type": "array" },
      "exhausted": { "type": "array" },
      "waiting": { "type": "integer" },
      "done": { "type": "boolean" },
      "cost": { "type": "object", "required": ["spent", "next"] }
     }
    },
    "invoke": {
     "kind": "container",
     "files": { "package_files": [
      { "package": "field-values", "paths": ["do-work", "read-data"], "at": "/opt/field-values" },
      { "package": "formula-engine", "paths": ["rules", "built-stored-bytes/formula-engine"], "at": "/opt/node_modules/trillion-workshop/tools/formula-engine" },
      { "package": "content-identity", "paths": ["read-data"], "at": "/opt/content-identity" },
      { "packages": ["node_modules/@noble/hashes"], "paths": ["LICENSE", "package.json", "blake3.js", "blake2.js", "_blake.js", "_md.js", "_u64.js", "utils.js"], "at": "/opt/node_modules/@noble/hashes" }
     ] },
     "workdir": "/opt/field-values",
     "internet": false,
     "stdout": "json",
     "argv": ["node", "do-work/run-request.mjs", "planColumnFill"],
     "stdin": { "fill": { "from": "input" } }
    },
    "needs": { "expected_seconds": 5, "network_egress": false, "memory_mb": 256 },
    "licence_class": "licence:maker-own",
    "placements": ["placement:small-container"],
    "maker": "maker:field-values",
    "result_selector": "$.result",
    "verify": [
     {
      "kind": "sample-run",
      "input": {
       "records": [{ "id": "p1", "name": "Rye Bakery", "city": "Eastham" }],
       "id_path": ["id"],
       "field": { "id": "website" },
       "sources": [{ "id": "guess", "tool": "tool:guess-a-website", "input": { "name": { "from": ["name"] }, "city": { "from": ["city"] } }, "answer_path": ["site"] }],
       "attempts": [{ "row": "p1", "source": "guess", "answer": { "site": "https://rye.example" } }]
      },
      "output_selector": "$.filled[0].value",
      "contains": "https://rye.example"
     }
    ],
    "provenance": { "source": "written for the Workshop from public reverse-engineering findings on enrichment waterfalls (no third-party code)" }
   }
  }
 ]
