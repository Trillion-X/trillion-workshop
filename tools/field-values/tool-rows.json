    "kind": "ai-tool-descriptor",
    "id": "tool:settle-field-values",
    "label": "Say who set each value and which source wins",
    "status": "active",
    "job": "Say which value each field of my rows keeps when several sources offered one, who set it, and why the others lost: what I typed beats my rules, my rules beat imported sources, and those beat an AI's guess, with the AI's reasons and confidence kept beside its value",
    "description": "Takes offers, each a value for one field of one row with its source (kind, by, at, confidence) and optionally its basis (reasoning, citations). Each field keeps the offer the precedence puts first: source kinds strongest first (person, rule, source, ai by default, or the person's own precedence), then inside one kind the newest, then the most confident, then the order handed in. An offer below its kind's confidence floor never wins and is set aside with the reason. An offer with withdraws: true takes back what that same source offered earlier, so the field falls back to the next offer. as_of answers the value a field held at that time. Every other offer is kept beside the winner with why it lost, and a field whose two best offers tie with different values says contested.",
    "input_schema": {
     "type": "object",
     "required": ["offers"],
     "properties": {
      "offers": { "type": "array", "items": { "type": "object", "required": ["row", "field", "source"], "properties": { "row": { "type": ["string", "integer"] }, "field": { "type": "string" }, "value": {}, "withdraws": { "type": "boolean" }, "basis": { "type": "object", "description": "Why the source gave this value: reasoning, citations" }, "source": { "type": "object", "required": ["kind"], "properties": { "kind": { "type": "string" }, "by": { "type": "string" }, "at": { "type": "string", "format": "date-time" }, "confidence": { "type": ["number", "string"] } } } } } },
      "precedence": { "type": "object", "description": "Source kinds strongest first and how ties break, the shape of read-data/value-sources.json" },
      "as_of": { "type": "string", "format": "date-time", "description": "Answer the values as they stood at this time" }
     }
    },
    "output_schema": {
     "type": "object",
     "required": ["cells", "counts"],
     "properties": {
      "cells": { "type": "array", "items": { "type": "object", "required": ["row", "field", "value", "set_by", "contested", "outranked", "set_aside"] } },
      "counts": { "type": "object", "required": ["offers", "cells", "settled", "contested", "set_aside", "withdrawals"] }
     }
    },
    "invoke": {
     "kind": "container",
     "files": { "package_files": [
      { "package": "field-values", "paths": ["do-work", "read-data"], "at": "/opt/field-values" },
      { "package": "formula-engine", "paths": ["rules", "built-stored-bytes/formula-engine"], "at": "/opt/node_modules/trillion-workshop/tools/formula-engine" },
      { "package": "content-identity", "paths": ["read-data"], "at": "/opt/content-identity" },
      { "packages": ["node_modules/@noble/hashes"], "paths": ["LICENSE", "package.json", "blake3.js", "blake2.js", "_blake.js", "_md.js", "_u64.js", "utils.js"], "at": "/opt/node_modules/@noble/hashes" }
     ] },
     "workdir": "/opt/field-values",
     "internet": false,
     "stdout": "json",
     "argv": ["node", "do-work/run-request.mjs", "settleValues"],
     "stdin": { "fill": { "from": "input" } }
    },
    "needs": { "expected_seconds": 5, "network_egress": false, "memory_mb": 256 },
    "licence_class": "licence:maker-own",
    "placements": ["placement:small-container"],
    "maker": "maker:field-values",
