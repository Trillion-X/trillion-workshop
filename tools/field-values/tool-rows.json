    "kind": "ai-tool-descriptor",
    "id": "tool:set-fields-by-rules",
    "label": "Set fields on the rows my rules match",
    "status": "active",
    "job": "Set fields on the rows my rules match, like coding transactions by merchant and amount: my rule groups in order, the first matching rule sets each field, never over a value I set myself, with a preview of what each rule would change",
    "description": "Takes rows, the fields (an id, a kind and a path into each row), and groups of rules in the order they are tried. A rule is a tools/formulas rule tree (when; left out matches every row) and the fields it sets, each to a value or to another field of the row. For every row the first rule that matches and sets a field decides that field; rules that set different fields all apply, and a later rule setting the same field is listed as shadowed. A field already holding a value from a stronger source (a person, or a source the rows do not record when the precedence says unknown sources hold) is not changed and is answered as held, naming who holds it. When the rows keep who wrote each field (provenance: where, and the keys for the kind and the writer), each change carries the rule as its writer, and a field a rule set that no rule sets now goes back to empty. Nothing is written: the answer holds the changes, each changed row as it would be, and per rule the rows it matches and how many it changes, finds already set, cannot change and shadows. An unfinished rule sets nothing and is named in incomplete.",
    "input_schema": {
     "type": "object",
     "required": ["records", "fields", "groups"],
     "properties": {
      "records": { "type": "array", "items": { "type": "object" }, "description": "The rows" },
      "fields": { "type": "array", "items": { "type": "object", "required": ["id", "kind"], "properties": { "id": { "type": "string" }, "kind": { "type": "string", "description": "Which comparisons the field offers (tools/formulas list-comparisons)" }, "path": { "type": "array", "description": "Keys and positions into a row; the id by default" } } } },
      "groups": { "type": "array", "description": "Rule groups in the order they are tried", "items": { "type": "object", "required": ["id", "rules"], "properties": { "id": { "type": "string" }, "rules": { "type": "array", "items": { "type": "object", "required": ["id", "set"], "properties": { "id": { "type": "string" }, "says": { "type": "string" }, "when": { "type": "object", "description": "A tools/formulas rule tree; left out means every row" }, "set": { "type": "array", "items": { "type": "object", "required": ["field"], "properties": { "field": { "type": "string" }, "value": {}, "from": { "type": "array", "description": "A path in the row to copy the value from" } } } } } } } } } },
      "provenance": { "type": "object", "required": ["path", "kind_key", "by_key"], "description": "Where each row keeps who wrote each field: path to an object keyed by field id, and the keys of the writer's kind and name", "properties": { "path": { "type": "array" }, "kind_key": { "type": "string" }, "by_key": { "type": "string" } } },
      "rule_kind": { "type": "string", "description": "The source kind a rule writes as; rule by default" },
      "precedence": { "type": "object", "description": "Source kinds strongest first and how ties break, the shape of read-data/value-sources.json" },
      "id_path": { "type": "array", "description": "Where each row's id is, to name rows in the answer" },
      "operators": { "type": "object", "description": "Comparisons as rows of data, replacing tools/formulas' built-in ones" }
     }
    },
    "output_schema": {
     "type": "object",
     "required": ["total", "changes", "held", "shadowed", "rows", "rules", "incomplete"],
     "properties": {
      "total": { "type": "integer" },
      "changes": { "type": "array", "items": { "type": "object", "required": ["row", "field", "from", "to", "rule", "reason"] } },
      "held": { "type": "array", "items": { "type": "object", "required": ["row", "field", "value", "held_by", "rule", "would_set"] } },
      "shadowed": { "type": "array", "items": { "type": "object" } },
      "rows": { "type": "array", "items": { "type": "object", "required": ["row", "fields", "record"] } },
      "rules": { "type": "array", "items": { "type": "object", "required": ["group", "rule", "matches", "changes", "held", "already", "shadowed"] } },
      "incomplete": { "type": "array" }
     }
    },
    "invoke": {
     "kind": "container",
     "files": { "package_files": [
      { "package": "field-values", "paths": ["do-work", "read-data"], "at": "/opt/field-values" },
      { "package": "formula-engine", "paths": ["rules", "built-stored-bytes/formula-engine"], "at": "/opt/node_modules/trillion-workshop/tools/formula-engine" },
      { "package": "content-identity", "paths": ["read-data"], "at": "/opt/content-identity" },
      { "packages": ["node_modules/@noble/hashes"], "paths": ["LICENSE", "package.json", "blake3.js", "blake2.js", "_blake.js", "_md.js", "_u64.js", "utils.js"], "at": "/opt/node_modules/@noble/hashes" }
     ] },
     "workdir": "/opt/field-values",
     "internet": false,
     "stdout": "json",
     "argv": ["node", "do-work/run-request.mjs", "setFields"],
     "stdin": { "fill": { "from": "input" } }
    },
    "needs": { "expected_seconds": 5, "network_egress": false, "memory_mb": 256 },
    "licence_class": "licence:maker-own",
    "placements": ["placement:small-container"],
    "maker": "maker:field-values",
    "result_selector": "$.result",
    "verify": [
     {
      "kind": "sample-run",
      "input": {
       "records": [{ "id": "t1", "merchant": "North Flour Mill", "amount": 120 }, { "id": "t2", "merchant": "Oven Parts Co", "amount": 80, "category": "Repairs" }],
       "fields": [{ "id": "merchant", "kind": "text" }, { "id": "category", "kind": "choice" }],
       "groups": [{ "id": "ingredients", "rules": [{ "id": "flour", "when": { "kind": "rule", "field": "merchant", "operator": "contains", "params": { "text": "flour" } }, "set": [{ "field": "category", "value": "Ingredients" }] }] }],
       "id_path": ["id"]
      },
      "output_selector": "$.changes[0].to",
      "contains": "Ingredients"
     }
    ],
    "provenance": { "source": "written for the Workshop from public reverse-engineering findings on bookkeeping and spend-table rule engines (no third-party code)" }
   }
  },
