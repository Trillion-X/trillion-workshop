    {
      "id": "answer",
      "label": "Say how it went",
      "title": "{goal}",
      "section": {
        "id": "answer",
        "step": {
          "needs": [
            "say how it went"
          ],
          "job": "A decision asks how it went ({id}): {title}. {detail} Check the outcome yourself from what is true now (its records, the live service, the screen), record the outcome on the decision, and act on it if it did not work. Never ask the person.",
          "said": "Checking how it went: {title}"
        },
        "title": "Say how it went",
        "action": "Answer",
        "on_home": false,
        "icon": "MessageCircleQuestion"
      },
      "detail": "{outcome_question}",
      "at": "created_at",
      "read": {
        "tool": "tool:see-my-decisions",
        "input": {
          "native_collection_page": true
        },
        "records": "summaries",
        "next": "next_before",
        "cursor": "before",
        "more": "collection_coverage.more_decisions"
      },
      "where": [
        {
          "field": "outcome_question",
          "present": true
        }
      ],
      "card": {
        "address": {
          "value": "/decisions"
        },
        "record_status": "status"
      },
      "id_field": "case_id"
    }
