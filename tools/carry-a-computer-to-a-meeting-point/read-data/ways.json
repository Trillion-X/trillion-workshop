    {
      "id": "ssh-reverse-forward",
      "transport_kind": "reverse_tunnel",
      "relay_host_ref": null,
      "order": 20,
      "requires_awake": true,
      "install": {
        "scope": "user"
      },
      "params": {
        "user": "carry-{short_id}"
      },
      "client": {
        "program": {
          "artifacts": [
            {
              "where": {
                "platform": [
                  "darwin",
                  "linux"
                ]
              },
              "command": "/usr/bin/ssh"
            },
            {
              "where": {
                "platform": "win32"
              },
              "command": "C:\\Windows\\System32\\OpenSSH\\ssh.exe"
            }
          ]
        },
        "files": [
          {
            "name": "identity",
            "mode": "0600",
            "text": "{secret}\n"
          },
          {
            "name": "known_hosts",
            "mode": "0600",
            "text": "[{host}]:{ssh_port} {host_key}\n"
          }
        ],
        "argv": [
          "-N",
          "-T",
          "-i",
          "{dir}/identity",
          "-o",
          "IdentitiesOnly=yes",
          "-o",
          "BatchMode=yes",
          "-o",
          "StrictHostKeyChecking=yes",
          "-o",
          "UserKnownHostsFile={dir}/known_hosts",
          "-o",
          "ExitOnForwardFailure=yes",
          "-o",
          "ServerAliveInterval=30",
          "-o",
          "ServerAliveCountMax=3",
          "-o",
          "ConnectTimeout=10",
          "-p",
          "{ssh_port}",
          "-R",
          "127.0.0.1:{remote_port}:127.0.0.1:{local_port}",
          "{user}@{host}"
        ]
      },
      "server": {
        "steps": [
          {
            "each": [
              {
                "run": [
                  "sh",
                  "-c",
                  "id {user} >/dev/null 2>&1 || useradd --system --create-home --shell /usr/sbin/nologin {user}"
                ]
              },
              {
                "run": [
                  "install",
                  "-d",
                  "-m",
                  "700",
                  "-o",
                  "{user}",
                  "-g",
                  "{user}",
                  "/home/{user}/.ssh"
                ]
              },
              {
                "file": {
                  "path": "/home/{user}/.ssh/authorized_keys",
                  "mode": "0600",
                  "text": "restrict,port-forwarding,permitlisten=\"127.0.0.1:{remote_port}\" {server_value}\n"
                }
              },
              {
                "run": [
                  "chown",
                  "{user}:{user}",
                  "/home/{user}/.ssh/authorized_keys"
                ]
              },
              {
                "file": {
                  "path": "/etc/ssh/sshd_config.d/{user}.conf",
                  "mode": "0644",
                  "text": "Match User {user}\n    AllowTcpForwarding remote\n    GatewayPorts no\n    PermitListen 127.0.0.1:{remote_port}\n    PermitOpen none\n    X11Forwarding no\n    AllowAgentForwarding no\n    PermitTTY no\n    ForceCommand /usr/bin/false\n    PasswordAuthentication no\n    KbdInteractiveAuthentication no\n    MaxSessions 0\n"
                }
              }
            ]
          },
          {
            "run": [
              "/usr/sbin/sshd",
              "-t"
            ]
          },
          {
            "run": [
              "systemctl",
              "reload",
              "ssh"
            ]
          }
        ]
      }
    }
  ]
