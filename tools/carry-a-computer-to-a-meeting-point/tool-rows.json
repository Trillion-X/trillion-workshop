{
  "kind": "tool-rows",
  "record_set": "carry-a-computer-to-a-meeting-point-tool-rows",
  "what_this_is": "The Workshop row for tools/carry-a-computer-to-a-meeting-point: what a meeting point's host runs for the computers carried to it. The computer's own half (a program kept running by the init row for its kind of computer) is `carry-a-computer.mjs install` on that computer; a kept run that reaches this computer's door is not a row.",
  "records": [
    {
      "id": "package::carry-a-computer-to-a-meeting-point::tool::carry-a-computer-to-a-meeting-point",
      "address": "package::carry-a-computer-to-a-meeting-point::tool::carry-a-computer-to-a-meeting-point",
      "path": [
        "current-item",
        "published-record"
      ],
      "payload": {
        "uses_tools": [
          "trillion-workshop/content-identity",
          "trillion-workshop/start-a-computer"
        ],
        "kind": "ai-tool-descriptor",
        "id": "tool:carry-a-computer-to-a-meeting-point",
        "label": "Carry a computer to a meeting point",
        "status": "active",
        "job": "Say what a public host must run so my computers behind a router can be reached through it, and which port each one gets there",
        "description": "Takes the id of a way row (frp, rathole and ssh-reverse-forward are shipped; pass `ways` to use rows of your own), the meeting point's relay host (its hostname and the values the way's text names, such as control_port) and the computers carried to it, each with its id and the value the host needs to admit it (`server_value`: a token, or a public key). Answers the ordered steps the host runs (a file to write with its mode, or a command to run), the arguments of the program that serves the meeting point, and the program's pinned download. Each computer's port at the host is a stable hash of its id into a range held as data; two computers that hash to one port are refused, and one of them is given a `salt`. The computer's own half is kept running by `serve` under the init row for its kind of computer; run the file's `install` on that computer. The tool holds no vendor, operating system or host: each is a row.",
        "input_schema": {
          "type": "object",
          "required": [
            "way_id",
            "relay_host",
            "computers"
          ],
          "additionalProperties": false,
          "properties": {
            "way_id": {
              "type": "string",
              "description": "The way row to render the host half of"
            },
            "ways": {
              "type": "array",
              "items": {
                "type": "object"
              },
              "description": "Way rows of your own; used before the shipped ones"
            },
            "relay_host": {
              "type": "object",
              "required": [
                "id",
                "hostname"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "hostname": {
                  "type": "string"
                },
                "params": {
                  "type": "object",
                  "description": "Values the way's text names, such as control_port, ssh_port, host_key"
                }
              }
            },
            "computers": {
              "type": "array",
              "minItems": 1,
              "maxItems": 1024,
              "items": {
                "type": "object",
                "required": [
                  "id"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "maxLength": 128
                  },
                  "salt": {
                    "type": "string",
                    "maxLength": 64
                  },
                  "server_value": {
                    "type": "string",
                    "maxLength": 1000,
                    "description": "The token or public key the host needs to admit this computer, when the way's host half names one"
                  }
                }
              }
            },
            "values": {
              "type": "object",
              "description": "Values the way's host half names that are not the relay host's, such as config_dir or user"
            },
            "ports": {
              "type": "object",
              "properties": {
                "min": {
                  "type": "integer",
                  "minimum": 1
                },
                "max": {
                  "type": "integer",
                  "maximum": 65535
                }
              },
              "description": "The port range, when not the shipped one"
            }
          }
        },
        "output_schema": {
          "type": "object",
          "required": [
            "steps",
            "argv"
          ],
          "properties": {
            "steps": {
              "type": "array",
              "items": {
                "type": "object"
              }
            },
            "argv": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "program": {
              "type": [
                "object",
                "null"
              ]
            }
          }
        },
        "invoke": {
          "kind": "container",
          "internet": false,
          "max_run_ms": 30000,
          "workdir": "/opt/carry-a-computer-to-a-meeting-point",
          "stdout": "json",
          "argv": [
            "node",
            "/opt/carry-a-computer-to-a-meeting-point/do-work/carry-a-computer.mjs",
            "render-meeting-point"
          ],
          "stdin": {
            "fill": {
              "from": "input"
            }
          },
          "files": {
            "package_files": [
              {
                "package": "carry-a-computer-to-a-meeting-point",
                "paths": [
                  "do-work",
                  "read-data"
                ],
                "at": "/opt/carry-a-computer-to-a-meeting-point"
              },
              {
                "package": "start-a-computer",
                "paths": [
                  "do-work/fill-fields.mjs",
                  "do-work/install-init.mjs",
                  "read-data/init-rows.json",
                  "read-data/unit-templates"
                ],
                "at": "/opt/start-a-computer"
              },
              {
                "module": "@noble/hashes",
                "paths": [
                  "LICENSE",
                  "package.json",
                  "blake3.js",
                  "blake2.js",
                  "_blake.js",
                  "_md.js",
                  "_u64.js",
                  "utils.js"
                ],
                "at": "/opt/node_modules/@noble/hashes"
              }
            ]
          }
        },
        "result_selector": "$",
        "verify": [
          {
            "kind": "sample-run",
            "input": {
              "way_id": "rathole",
              "relay_host": {
                "id": "relay-example",
                "hostname": "relay.example.test",
                "params": {
                  "control_port": 2333
                }
              },
              "computers": [
                {
                  "id": "computer-one",
                  "server_value": "a-synthetic-token"
                }
              ],
              "values": {
                "config_dir": "/etc/example"
              }
            },
            "output_selector": "$.argv[0]",
            "contains": "--server",
            "records": []
          }
        ],
        "needs": {
          "expected_seconds": 1,
          "network_egress": false
        },
        "maker": "maker:carry-a-computer-to-a-meeting-point",
        "licence_class": "licence:maker-own",
        "placements": [
          "placement:small-container"
        ]
      }
    }
  ]
}
