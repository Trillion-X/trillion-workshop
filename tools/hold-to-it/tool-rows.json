    "kind": "ai-tool-descriptor",
    "id": "tool:hold-to-it",
    "label": "Hold a group to what it agreed",
    "status": "active",
    "job": "Work out an agreement a group made, or a session one person planned (a daily meeting, a habit, a deadline): when to remind and check, who kept it, and the scorecard",
    "description": "Reads and keeps nothing: everything it works from comes in with the request and everything it makes comes back in the answer. The caller keeps the agreement and the marks. keep { group, what, agreed_by, cadence?, policy, agreement? } answers the agreement to keep and, when it says a time, its next meeting and the reminder and the check as something to arm (a repeat or one time); with no time it answers needs_time and arms nothing; agreement is the already held one, to merge into. retime { group, agreement, at, policy, ... } answers the agreement with its time given or moved. remind { group, agreement, policy } answers the sentence. check { group, agreement, arranged, evidence, policy, marks? } works out who came to the last meeting from the evidence handed in (speakers heard, members who wrote), marks each person from the policy, answers one mark_record per person, day and rule to keep, and who missed and any run of misses (marks are the ones already held). mark { group, agreement, person, rule, policy } answers one mark_record with its evidence (a newer mark for the same day replaces the older). scorecard { group, marks, policy } answers each person's points. Nothing is sent or booked: whoever runs it arms the wake, books the calendar and tells the group. The marks and their points, the meeting length, the time zone and the reminder and check minutes are the policy handed in; there is no default. Reading who was heard in a call needs a listening owner; until one exists the caller hands in the names it has.",
    "input_schema": {
     "type": "object",
     "required": [
      "operation",
      "group"
     ],
     "additionalProperties": false,
     "properties": {
      "operation": {
       "enum": [
        "keep",
        "retime",
        "remind",
        "check",
        "mark",
        "scorecard"
       ]
      },
      "group": {
       "type": "string",
       "description": "Which group's agreements"
      },
      "what": {
       "type": "string"
      },
      "agreed_by": {
       "type": "array",
       "items": {
        "type": "string"
       }
      },
      "proposed_by": {
       "type": "string"
      },
      "cadence": {
       "type": "object",
       "description": "{ every: day | week | once, at: HH:MM, on?: [weekdays], date?: YYYY-MM-DD for once, minutes?, time_zone? }; no time is never guessed"
      },
      "quote": {
       "type": "string"
      },
      "source_ref": {
       "type": "string"
      },
      "aliases": {
       "type": "object",
       "description": "Other names a person is heard by"
      },
      "agreement": {
       "type": "object",
       "description": "The held agreement, as keep answered it: { agreement_id, group, what, agreed_by, cadence, ... }. retime, remind, check and mark take it; keep takes it to merge into"
      },
      "marks": {
       "type": "array",
       "items": { "type": "object" },
       "description": "check, scorecard: the marks already held, each { group, person, rule, points, miss, agreement, date, at }"
      },
      "at": {
       "type": "string",
       "description": "retime: the new HH:MM"
      },
      "date": {
       "type": "string"
      },
      "time_zone": {
       "type": "string"
      },
      "minutes": {
       "type": "integer"
      },
      "on": {
       "type": "array",
       "items": {
        "type": "string"
       }
      },
      "because": {
       "type": "string"
      },
      "arranged": {
       "type": "boolean",
       "description": "check: whether the meeting was set up on the calendar, read from the calendar by the caller"
      },
      "evidence": {
       "description": "check: [{ name, at }] speakers heard or members who wrote in the meeting's window; mark: the words that show it"
      },
      "heard": {
       "type": "array",
       "description": "check: one row per speaker turn heard, { start, end?, speaker, ... }; the speaker is the name, or text the policy's unnamed_prefixes say is a voice with no name. The caller reads these rows; the tool never reads a call",
       "items": { "type": "object" }
      },
      "read_from": {
       "type": "array",
       "items": {
        "type": "string"
       },
       "description": "check: where the evidence was read"
      },
      "person": {
       "type": "string"
      },
      "rule": {
       "type": "string"
      },
      "area": {
       "type": "string"
      },
      "policy": {
       "type": "object",
       "description": "The group's marks and defaults (required): { marks, defaults: { minutes, time_zone, remind_minutes, check_after_minutes }, evidence_before_minutes?, evidence_after_minutes?, unnamed_prefixes? (names that start with one of these are voices with no name) }"
      }
     }
    },
    "output_schema": {
     "type": "object",
     "description": "keep: { agreement, next, remind, check, said } or { agreement, needs_time, said }; retime the same; remind: { said, people }; check: { date, present, absent, marks, mark_records, said }; mark: { mark_record, said }; scorecard: { people, said }"
    },
    "invoke": {
     "kind": "container",
     "internet": false,
     "workdir": "/opt/hold-to-it",
     "stdout": "json",
     "argv": [
      "node",
      "/opt/records-door/do-work/run-an-export.mjs",
      "/opt/hold-to-it/read-data/hold-to-it.mjs",
      "holdToIt"
     ],
     "stdin": {
      "fill": {
       "from": "input"
      }
     },
     "files": {
      "package_files": [
       {
        "package": "hold-to-it",
        "paths": [
         "read-data"
        ],
        "at": "/opt/hold-to-it"
       },
       {
        "package": "run-work-later-or-on-a-repeat",
        "paths": [
          "do-work/timed-action.mjs",
          "built-stored-bytes/timed-action"
        ],
        "at": "/opt/run-work-later-or-on-a-repeat"
       },
       {
        "package": "records-door",
        "paths": [
         "do-work",
         "read-data"
        ],
        "at": "/opt/records-door"
       },
       {
        "package": "content-identity",
        "paths": [
         "read-data"
        ],
        "at": "/opt/content-identity"
       },
       {
        "packages": ["node_modules/@noble/hashes"],
        "paths": [
         "LICENSE",
         "package.json",
         "blake3.js",
         "blake2.js",
         "_blake.js",
         "_md.js",
         "_u64.js",
         "utils.js"
        ],
        "at": "/opt/node_modules/@noble/hashes"
       },
       {
        "package": "browse-and-upload-my-files",
        "paths": [
         "built-stored-bytes/content-chunks/content_chunks.js",
         "do-work/content-chunks.mjs",
         "do-work/namespace-client.mjs",
         "do-work/send-a-file-to-a-namespace.mjs",
         "do-work/send-retry.mjs",
         "do-work/send-window.mjs",
         "do-work/shared-file-reference.mjs",
         "send-settings.json"
        ],
        "at": "/opt/browse-and-upload-my-files"
       }
      ]
     }
    },
    "result_selector": "$.result",
    "needs": {
     "expected_seconds": 30,
     "network_egress": false,
     "memory_mb": 256
    },
    "licence_class": "licence:maker-own",
    "placements": [
     "placement:small-container"
    ],
    "maker": "maker:hold-to-it",
    "provenance": {
     "source": "the app's hold-to-it action, as records and a pure core; the space, calendar, listening and wake calls it made are the caller's"
    },
    "verify": [{"kind": "sample-run", "input": {"operation": "keep", "group": "bread-club", "what": "Meet every morning", "agreed_by": ["Priya Shah", "Omar Reyes", "Lin"], "cadence": {"every": "day", "at": "09:00", "minutes": 30, "time_zone": "UTC"}, "policy": {"defaults": {"minutes": 30, "time_zone": "UTC", "remind_minutes": 10, "check_after_minutes": 30}, "marks": [{"id": "came", "label": "Came", "points": 1, "when": "present"}, {"id": "missed", "label": "Missed the meeting", "points": -3, "when": "absent", "miss": true}]}}}]
   }
  }
 ]
