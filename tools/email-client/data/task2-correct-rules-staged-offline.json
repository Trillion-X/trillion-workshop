      "address_mode": "identity_text",
      "path_labels": [
        "current-item",
        "published-record",
        "trigger-rule"
      ],
      "payload": {
        "kind": "trigger-rule",
        "id": "trigger:email-classify:receipts",
        "name": "Auto-classify receipts",
        "topic": "data_state",
        "trigger_type": "delta",
        "is_active": true,
        "match_condition": {
          "conditions": [
            {
              "$kind": "binding",
              "select": {
                "from": "change",
                "path": "kind"
              },
              "transform": [
                {
                  "op": "op:core.equals",
                  "args": {
                    "value": "email-message"
                  }
                }
              ]
            },
            {
              "$kind": "binding",
              "select": {
                "from": "change",
                "path": "sender_domain"
              },
              "transform": [
                {
                  "op": "op:core.contains_any",
                  "args": {
                    "values": [
                      "order-confirmation",
                      "receipt",
                      "billing"
                    ]
                  }
                }
              ]
            }
          ]
        },
        "dispatch": {
          "target": "slot::workflow",
          "output_template": {
            "operation": "execute_definition",
            "definition_id": "action:email-classify:add-receipts-label",
            "include_output": false,
            "include_steps": false,
            "input": {
              "message": {
                "$kind": "binding",
                "select": {
                  "from": "change"
                }
              }
            }
          }
        }
      }
