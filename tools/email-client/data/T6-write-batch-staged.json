{
  "basis": {
    "op": "write_batch",
    "app_id": "bitfield-email-into-conversation-w3",
    "partition": "runtime-standard"
  },
  "write_batch": [
    {
      "address": "trigger-rule::email::split-inbox-important",
      "basis_id": "split-inbox-important-v1",
      "content": {
        "kind": "trigger-rule",
        "name": "Auto-classify VIP senders to Important",
        "trigger": {
          "event": "message_received",
          "condition": { "vip_sender_list_id": "vip-team-leads" }
        },
        "action": {
          "operation": "add_label",
          "label_id": "label:important",
          "cascade": "thread"
        }
      },
      "skip_if_exists": true
    },
    {
      "address": "trigger-rule::email::split-inbox-pitches",
      "basis_id": "split-inbox-pitches-v1",
      "content": {
        "kind": "trigger-rule",
        "name": "Auto-classify pitches",
        "trigger": {
          "event": "message_received",
          "condition": { "subject_contains": ["pitch", "proposal", "deck"] }
        },
        "action": {
          "operation": "add_label",
          "label_id": "label:pitches"
        }
      },
      "skip_if_exists": true
    },
    {
      "address": "trigger-rule::email::split-inbox-receipts",
      "basis_id": "split-inbox-receipts-v1",
      "content": {
        "kind": "trigger-rule",
        "name": "Auto-classify receipts",
        "trigger": {
          "event": "message_received",
          "condition": { "sender_domain_contains": ["order-confirmation", "receipt", "billing"] }
        },
        "action": {
          "operation": "add_label",
          "label_id": "label:receipts"
        }
      },
      "skip_if_exists": true
    },
    {
      "address": "trigger-rule::email::split-inbox-newsletters",
      "basis_id": "split-inbox-newsletters-v1",
      "content": {
        "kind": "trigger-rule",
        "name": "Auto-classify newsletters",
        "trigger": {
          "event": "message_received",
          "condition": { "has_list_unsubscribe_header": true }
        },
        "action": {
          "operation": "add_label",
          "label_id": "label:newsletters"
        }
      },
      "skip_if_exists": true
    },
    {
      "address": "trigger-rule::email::split-inbox-team",
      "basis_id": "split-inbox-team-v1",
      "content": {
        "kind": "trigger-rule",
        "name": "Auto-classify internal team",
        "trigger": {
          "event": "message_received",
          "condition": { "sender_domain_literal": "@company.internal" }
        },
        "action": {
          "operation": "add_label",
          "label_id": "label:team"
        }
      },
      "skip_if_exists": true
    },
    {
      "address": "email-account-alias::personal-alias",
      "basis_id": "alias-personal-v1",
      "content": {
        "kind": "source-descriptor",
        "type": "email_account_alias",
        "account_base_id": "gmail-account::primary",
        "alias_email": "alex+personal@example.com",
        "send_as_default": false,
        "display_name": "Personal"
      },
      "skip_if_exists": true
    },
    {
      "address": "email-account-alias::support-alias",
      "basis_id": "alias-support-v1",
      "content": {
        "kind": "source-descriptor",
        "type": "email_account_alias",
