        "inbox_placement": "important",
        "notification_urgency": "critical"
      },
      "skip_if_exists": true
    },
    {
      "address": "email-signature::professional",
      "basis_id": "sig-professional-v1",
      "content": {
        "kind": "ai-instruction-blocks",
