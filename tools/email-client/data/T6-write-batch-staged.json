        "alias_email": "alex+support@example.com",
        "send_as_default": false,
        "display_name": "Support"
      },
      "skip_if_exists": true
    },
    {
      "address": "email-account-alias::noreply-alias",
      "basis_id": "alias-noreply-v1",
      "content": {
        "kind": "source-descriptor",
        "type": "email_account_alias",
        "account_base_id": "gmail-account::primary",
        "alias_email": "noreply@example.com",
        "send_as_default": false,
