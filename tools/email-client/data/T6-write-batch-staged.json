      "address": "vip-sender-list::team-leads",
      "basis_id": "vip-team-leads-v1",
      "content": {
        "kind": "ai-agent-profile",
        "type": "vip_sender_configuration",
        "senders": ["alice@example.com", "bob@example.com", "carol@example.com"],
        "inbox_placement": "important",
        "notification_urgency": "high"
      },
      "skip_if_exists": true
    },
    {
      "address": "vip-sender-list::executives",
      "basis_id": "vip-execs-v1",
      "content": {
        "kind": "ai-agent-profile",
        "type": "vip_sender_configuration",
