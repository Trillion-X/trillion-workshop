    {
      "address": "digest-policy::daily",
      "basis_id": "digest-daily-v1",
      "content": {
        "kind": "ai-instruction-blocks",
        "type": "digest_policy",
        "frequency": "daily",
        "send_time": "09:00",
        "timezone": "America/Los_Angeles",
        "include_labels": ["label:newsletters"],
        "exclude_labels": ["label:important"]
      },
      "skip_if_exists": true
    },
    {
      "address": "digest-policy::weekly",
      "basis_id": "digest-weekly-v1",
      "content": {
        "kind": "ai-instruction-blocks",
        "type": "digest_policy",
        "frequency": "weekly",
        "send_day": "Monday",
        "send_time": "09:00",
        "include_labels": ["label:pitches"]
      },
      "skip_if_exists": true
    },
    {
      "address": "do-not-disturb::evenings",
      "basis_id": "dnd-evenings-v1",
      "content": {
        "kind": "ai-action-guard",
