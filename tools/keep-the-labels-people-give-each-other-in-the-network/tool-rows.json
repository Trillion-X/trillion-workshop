      "payload": {
        "kind": "ai-tool-descriptor",
        "id": "tool:label-a-person",
        "label": "Label a person",
        "job": "Give a person in the network one label (unwanted-requests, unsafe or vouched) in the database named in the input.",
        "description": "Gives a person in the network a label: unwanted-requests, unsafe or vouched. It writes one label row for the labeler, once, and one history row, in the database named by `database`, through the connection the person's vault holds under that name. Enough different labelers hide a listing; this tool only records the label.",
        "status": "active",
        "input_schema": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "database",
            "relay",
            "label",
            "by"
          ],
          "properties": {
            "database": {
              "type": "string",
              "minLength": 1,
              "description": "The name of the person's database, such as shop_for_who_runs_it. The computer opens it with the login its vault holds as that name and -connection."
            },
            "relay": {
              "type": "string",
              "minLength": 1,
              "description": "The person being labelled (their network address)."
            },
            "label": {
              "type": "string",
              "enum": [
                "unwanted-requests",
                "unsafe",
                "vouched"
              ]
            },
            "by": {
              "type": "string",
              "minLength": 1,
              "description": "The labeler: the person giving the label."
            }
          }
        },
        "output_schema": {
          "type": "object",
          "properties": {
            "result": {
              "type": "object",
              "properties": {
                "labelled": {
                  "type": "string"
                },
                "label": {
                  "type": "string"
                },
                "database": {
                  "type": "string"
                }
              }
            },
            "error": {
              "type": "string"
            },
            "status": {
              "type": "integer"
            }
          }
        },
