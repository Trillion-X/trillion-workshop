       }
      },
      "settings_record": {
       "type": "string",
       "pattern": "^record:setting:find-files-in-an-index~",
       "description": "The person's list:settings row for this tool: where their index is and which type and root they look in (any of index_dir, index_file, types_file, type, root, limit, fields, weights, lane_weights). The request's own keys win."
      },
      "settings": {
       "type": "object",
       "description": "Settings for this run, laid over the row's; the same keys."
      }
     }
    },
