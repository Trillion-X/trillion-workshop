      "path": [
        "case_id"
      ],
      "kept_with": "access:decision-kept"
    },
    {
      "from": "result",
      "path": [
        "handoff",
        "case_id"
      ],
      "kept_with": "access:decision-kept"
    }
  ],
  "person_app": "You, in Trillion",
  "failed": {
    "when": [
      { "from": "result", "path": ["state"], "equals": ["failed"] },
      { "from": "result", "path": ["ok"], "equals": [false] }
    ],
    "reason": [
      { "from": "result", "path": ["error", "message"] },
      { "from": "result", "path": ["error"] },
      { "from": "result", "path": ["reason"] }
    ]
  },
