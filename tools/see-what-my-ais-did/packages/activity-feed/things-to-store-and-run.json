    {
      "type": "record",
      "address": "package::activity-feed::trigger-rule::emit-activity-fact-on-ai-result",
      "path": [
        "current-item",
        "published-record",
        "trigger-rule"
      ],
      "payload": {
        "kind": "trigger-rule",
        "id": "trigger:activity-feed:emit-activity-fact-on-ai-result",
        "name": "emit-activity-fact-on-ai-result",
        "description": "WS-A PRODUCER wiring. On an ai-records-producer.result write (an AI worker finished work), dispatch action:activity-feed.emit-activity-fact so the Activity Feed shows the AI's live activity. event_hash bound from envelope content_hash (unique per write). Pure DATA over trigger-engine -> slot::workflow (L136). Arms after the next fold/boot.",
        "is_active": true,
        "version": 0,
        "trigger_type": "delta",
        "match_condition": {
          "conditions": [
            {
              "$kind": "binding",
              "select": {
                "from": "change",
                "path": "kind"
              },
              "transform": [
                {
                  "op": "op:core.equals",
                  "args": {
                    "value": "ai-records-producer.result"
                  }
                }
              ]
            },
            {
              "$kind": "binding",
              "select": {
                "from": "envelope",
                "path": "is_retraction"
              },
              "transform": [
                {
                  "op": "op:core.equals",
                  "args": {
                    "value": false
                  }
                }
              ]
            }
          ]
        },
        "dispatch": {
          "target": "slot::workflow",
          "output_template": {
            "operation": "execute_definition",
            "definition_id": "action:activity-feed.emit-activity-fact",
            "include_output": false,
            "include_steps": false,
            "input": {
              "actor_id": "ai:records-producer",
              "actor_type": "ai-agent",
              "package_id": "ai-records-producer",
              "record_kind": "ai-records-producer.result",
              "action_type": "write",
              "event_hash": {
                "$kind": "binding",
                "select": {
                  "from": "envelope",
                  "path": "content_hash"
                }
              },
              "action_label": "generated",
              "object_label": "records"
            }
          }
        },
        "extra_properties": {}
      }
    },
