              "$kind": "binding",
              "select": {
                "from": "envelope",
                "path": "is_retraction"
              },
              "transform": [
                {
                  "op": "op:core.equals",
                  "args": {
                    "value": false
                  }
                }
              ]
            }
          ]
        },
        "dispatch": {
          "target": "slot::workflow",
          "output_template": {
            "operation": "execute_definition",
            "definition_id": "action:activity-feed.emit-activity-fact",
            "include_output": false,
            "include_steps": false,
            "input": {
              "actor_id": "ai:content-generation",
              "actor_type": "ai-agent",
