        "id": "action:activity-feed.emit-activity-fact",
        "kind": "action",
        "is_active": true,
        "name": "emit-activity-fact",
        "description": "WS-A PRODUCER: write an activity-fact published-record so the Activity Feed shows real live actor activity. actor_id/package_id/record_kind/event_hash from input. NO wall-clock (the workflow+trigger DATA path is timeless by design) — the panel stamps first-seen client-side. Pure DATA over the workflow engine (L136).",
        "input_schema": {
          "type": "object",
          "required": [
            "actor_id",
            "package_id",
            "record_kind",
            "event_hash"
          ],
          "properties": {
            "actor_id": {
              "type": "string"
            },
            "actor_type": {
              "type": "string"
            },
            "package_id": {
              "type": "string"
            },
            "record_kind": {
              "type": "string"
            },
            "action_type": {
              "type": "string"
            },
            "event_hash": {
              "type": "string"
            },
            "action_label": {
              "type": "string"
            },
            "object_label": {
              "type": "string"
            }
          },
          "additionalProperties": true
        },
        "steps": [
          {
            "id": "emit",
            "join": "all",
            "kind": "write",
            "config": {
              "items": [
                {
                  "address": {
                    "$kind": "binding",
                    "select": {
                      "from": "input",
                      "path": "event_hash"
                    },
                    "transform": [
                      {
                        "op": "op:core.concat",
                        "args": {
                          "values": [
                            "activity-fact::",
                            {
                              "$kind": "binding",
                              "select": {
                                "from": "input",
                                "path": "event_hash"
                              }
                            }
                          ]
                        }
                      }
                    ]
                  },
                  "path": [
