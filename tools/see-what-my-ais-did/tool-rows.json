        },
        "id": "tool:read-ai-activity",
        "label": "Read AI activity",
        "job": "Read what an AI did on a person's account, newest first, or trace one item",
        "description": "Reads the activity kept in the person's own database named by database: the newest rows (narrow by app, by the id a call was done for, or to the calls that did not work), or, with item, how that item came about and what came of it. Each step is one kept row with its link (made, used or for). Reads the newest two generations only.",
        "input_schema": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "database"
          ],
          "properties": {
            "database": {
              "type": "string",
              "minLength": 1,
              "description": "The person's own pursuit database (such as ethos_for_who_runs_it). The computer opens it with the login its vault holds as that name and -connection. The activity tables are made there the first time."
            },
            "before": {
              "type": "integer",
              "minimum": 1,
              "description": "The seq of the last row already read."
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 500
            },
            "app": {
              "type": "string",
              "maxLength": 120
            },
            "for": {
              "description": "One id, or a list of ids: the calls done for any of them.",
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              ]
            },
            "failed": {
              "type": "boolean"
            },
            "item": {
              "type": "string",
              "description": "Give item to trace how it came about and what came of it (the steps) instead of the list."
            },
            "depth": {
              "type": "integer",
              "minimum": 0,
              "maximum": 8
            }
          }
        },
        "output_schema": {
          "type": "object",
          "description": "Either { items, next_before } (the list) or { item, steps, coverage } (the trace)."
        },
