        "id": "tool:keep-an-ai-activity-row",
        "label": "Keep an AI activity row",
        "job": "Keep one row of what an AI did on a person's account, in that person's own database",
        "description": "Keeps one activity row in the person's own database named by database. Give row (a finished activity row) or call (one raw tool call an AI made: tool, at, input, result, error, app, description), with access (the access names the person holds) for a call. A call becomes a row by the activity marks; a call that leaves no row answers kept false and why. The tables activity_g<n>, activity_links_g<n> and activity_counts_g<n> and the views activity and activity_links are made there the first time (CREATE TABLE IF NOT EXISTS). The newest generation holds up to 5000 rows; a new one starts when it is full and the older one goes whole.",
        "input_schema": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "database"
          ],
          "properties": {
            "database": {
              "type": "string",
              "minLength": 1,
              "description": "The person's own pursuit database (such as ethos_for_who_runs_it). The computer opens it with the login its vault holds as that name and -connection. The activity tables are made there the first time."
            },
            "row": {
              "type": "object",
              "required": [
                "tool",
                "at"
              ],
              "description": "One activity row, as the activity library makes it: tool, at, app, item, title, label, uses, for, ok and reason. Only ids, short titles and the failure words are kept."
            },
            "call": {
              "type": "object",
              "required": [
                "tool",
                "at"
              ],
              "description": "One raw tool call an AI made: tool, at (ISO text), input, result, error, app, description. The activity marks decide the row it leaves.",
              "properties": {
                "tool": {
                  "type": "string",
                  "minLength": 1
                },
                "at": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "access": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "The access names the person holds (such as access:decision-kept). A row needing one they do not hold is kept without that id."
            }
          },
          "description": "Give row (a finished activity row) or call (a raw tool call); one of them."
        },
        "output_schema": {
          "type": "object",
          "description": "{ generation, seq } when kept; { kept: false, left } when a raw call left no row."
        },
