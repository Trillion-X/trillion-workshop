                  ]
                },
                {
                  "type": "INPUT",
                  "port": "4242",
                  "protocol": "udp",
                  "targets": [
                    "0.0.0.0/0",
                    "::/0"
                  ]
                },
                {
                  "type": "INPUT",
                  "port": "443",
                  "protocol": "tcp",
                  "targets": [
                    "0.0.0.0/0",
                    "::/0"
                  ]
                }
              ]
            },
            "held": {
              "elestio-api-key": "made-up-elestio-token"
            },
            "replies": [
              {
                "request": {
                  "method": "POST",
                  "url": "https://api.elest.io/api/auth/checkAPIToken"
                },
                "status": 200,
                "body": {
                  "status": "OK",
                  "jwt": "made-up-session"
                }
              },
              {
                "request": {
                  "method": "POST",
                  "url": "https://api.elest.io/api/servers/getServerDetails"
                },
                "status": 200,
                "body": {
                  "status": "OK",
                  "serviceInfos": [
                    {
                      "vmID": "170000000",
                      "isFirewallActivated": 0,
                      "firewall_id": null
                    }
                  ]
                }
              }
            ],
            "shape_read_at": "2026-11-25",
            "output_selector": "$.reason",
            "contains": "apply was false"
          }
        ]
      }
