{
  "kind": "tool-rows",
  "record_set": "keep-an-elestio-firewall-tool-rows",
  "what_this_is": "The Workshop row for the tool in tools/keep-an-elestio-firewall: makes one Elestio service's firewall equal a rule set kept as DATA, and reads it back.",
  "records": [
    {
      "id": "package::keep-an-elestio-firewall::tool::keep-an-elestio-firewall",
      "address": "package::keep-an-elestio-firewall::tool::keep-an-elestio-firewall",
      "path": [
        "current-item",
        "published-record"
      ],
      "payload": {
        "kind": "ai-tool-descriptor",
        "status": "active",
        "id": "tool:keep-an-elestio-firewall",
        "label": "Make an Elestio service's firewall equal the rules kept for it",
        "job": "Keep the firewall of one Elestio service (a CI/CD target or any other) equal to the rules its owner keeps as DATA (a computer's row), switching it on when it is off, and say what it opened and closed. With apply false it only reads and says the difference.",
        "description": "Trades the vault's Elestio API token (elestio-api-key, bound only to api.elest.io) for a session, reads whether the service's firewall is on (servers/getServerDetails, isFirewallActivated) and, when on, its rules (servers/DoActionOnServer, action getFirewallRules). When the firewall is off or its rules differ from the given ones (compared as sets: type, port, protocol and sorted targets), it sends the whole set: enableFirewall when off, updateFirewall when on. Both replace every rule, so a port a dashboard tool opened (Tail Logs 18445, VS Code 18345 and the like) is closed unless the rules name it. Then it reads the firewall back every poll_seconds until it is on with exactly the rules, or wait_seconds (300) pass. Before any call it refuses a rule set that does not keep 22/tcp and 4242/udp open to 0.0.0.0/0 and ::/0 (Elestio's automation SSH and its Nebula private network; Elestio accepts no other targets for them), a bad port, protocol or target, or a rule given twice. Returns ok, the action sent (or null), the firewall before and after, the rules it opened and closed, what still differs when not ok, when it asked, the seconds waited and the reads. Never the token or the session. Holding a key, it reaches only api.elest.io, so it cannot test the ports itself: prove which ports answer from outside in a step without a key. The way back from a wrong set is this tool with a corrected set, or Elestio's disableFirewall.",
        "input_schema": {
          "type": "object",
          "required": [
            "email",
            "project_id",
            "vm_id",
            "rules"
          ],
          "additionalProperties": false,
          "properties": {
            "email": {
              "type": "string",
              "minLength": 3,
              "description": "The Elestio account's email; the token is checked against it."
            },
            "project_id": {
              "type": "string",
              "pattern": "^[0-9]+$"
            },
            "vm_id": {
              "type": "string",
              "pattern": "^[0-9]+$",
              "description": "The service's vmID (its provider server id)."
            },
            "rules": {
              "type": "array",
              "minItems": 2,
              "items": {
                "type": "object",
                "required": [
                  "port",
                  "protocol",
                  "targets"
                ],
                "additionalProperties": false,
                "properties": {
                  "type": {
                    "type": "string",
                    "enum": [
                      "INPUT",
                      "OUTPUT",
                      "input",
                      "output"
                    ],
                    "description": "INPUT (the default) or OUTPUT."
                  },
                  "port": {
                    "type": "string",
                    "pattern": "^[0-9]{1,5}(-[0-9]{1,5})?$",
                    "description": "One port, or a range like 8000-8010."
                  },
                  "protocol": {
                    "type": "string",
                    "enum": [
                      "tcp",
                      "udp"
                    ]
                  },
                  "targets": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "string"
                    },
                    "description": "The addresses or CIDR ranges allowed; [\"0.0.0.0/0\", \"::/0\"] is everyone."
                  }
                }
              },
              "description": "Every rule the firewall must hold, and no others."
            },
            "apply": {
              "type": "boolean",
              "description": "false: read and say the difference, change nothing."
            },
            "wait_seconds": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1800
            },
            "poll_seconds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 60
            }
          }
        },
        "output_schema": {
          "type": "object",
          "required": [
            "ok",
            "vm_id",
            "action",
            "before",
            "after",
            "opened",
            "closed",
            "asked_at",
            "seconds",
            "reads"
          ],
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "vm_id": {
              "type": "string"
            },
            "action": {
              "type": [
                "string",
                "null"
              ]
            },
            "before": {
              "$ref": "#/$defs/state"
            },
            "after": {
              "$ref": "#/$defs/state"
            },
            "opened": {
              "type": "array"
            },
            "closed": {
              "type": "array"
            },
            "still_differs": {
              "type": [
                "object",
                "null"
              ]
            },
            "asked_at": {
              "type": [
                "string",
                "null"
              ]
            },
            "seconds": {
              "type": "integer"
            },
            "reads": {
              "type": "integer"
            },
            "reason": {
              "type": "string"
            }
          },
          "$defs": {
            "state": {
              "type": "object",
              "properties": {
                "on": {
                  "type": "boolean"
                },
                "rules": {
                  "type": "array",
                  "items": {
                    "type": "object"
                  }
                }
              }
            }
          }
        },
        "result_selector": "$",
        "invoke": {
          "kind": "container",
          "internet": true,
          "workdir": "/opt/keep-an-elestio-firewall",
          "stdout": "json",
          "argv": [
            "/usr/local/bin/node",
            "/opt/keep-an-elestio-firewall/do-work/keep-an-elestio-firewall.mjs"
          ],
          "stdin": {
            "fill": {
              "from": "input"
            }
          },
          "credential_mounts": [
            {
              "secret_name": "elestio-api-key",
              "fd": 4
            }
          ],
          "files": {
            "package_files": [
              {
                "package": "keep-an-elestio-firewall",
                "paths": [
                  "do-work/keep-an-elestio-firewall.mjs"
                ],
                "at": "/opt/keep-an-elestio-firewall"
              }
            ]
          }
        },
        "needs": {
          "expected_seconds": 120,
          "network_egress": true,
          "memory_mb": 128
        },
        "licence_class": "licence:maker-own",
        "placements": [
          "placement:small-container"
        ],
        "maker": "maker:keep-an-elestio-firewall",
        "provenance": {
          "source": "Written for the Workshop when two Elestio computers were found with their firewall off and no owner for it (Nov 25 2026): the rules become each computer's DATA and this tool makes Elestio equal them, with the same API calls Elestio's own CLI and Terraform provider use"
        },
        "verify": [
          {
            "kind": "sample-run",
            "input": {
              "email": "owner@example.test",
              "project_id": "90000",
              "vm_id": "170000000",
              "apply": false,
              "rules": [
                {
                  "type": "INPUT",
                  "port": "22",
                  "protocol": "tcp",
                  "targets": [
                    "0.0.0.0/0",
                    "::/0"
                  ]
                },
                {
                  "type": "INPUT",
                  "port": "4242",
                  "protocol": "udp",
                  "targets": [
                    "0.0.0.0/0",
                    "::/0"
                  ]
                },
                {
                  "type": "INPUT",
                  "port": "443",
                  "protocol": "tcp",
                  "targets": [
                    "0.0.0.0/0",
                    "::/0"
                  ]
                }
              ]
            },
            "held": {
              "elestio-api-key": "made-up-elestio-token"
            },
            "replies": [
              {
                "request": {
                  "method": "POST",
                  "url": "https://api.elest.io/api/auth/checkAPIToken"
                },
                "status": 200,
                "body": {
                  "status": "OK",
                  "jwt": "made-up-session"
                }
              },
              {
                "request": {
                  "method": "POST",
                  "url": "https://api.elest.io/api/servers/getServerDetails"
                },
                "status": 200,
                "body": {
                  "status": "OK",
                  "serviceInfos": [
                    {
                      "vmID": "170000000",
                      "isFirewallActivated": 0,
                      "firewall_id": null
                    }
                  ]
                }
              }
            ],
            "shape_read_at": "2026-11-25",
            "output_selector": "$.reason",
            "contains": "apply was false"
          }
        ]
      }
    }
  ]
}
