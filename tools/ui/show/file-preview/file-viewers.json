{
  "schema": "ui.file-viewers",
  "about": "Which viewer FilePreview draws a file with. Rows are read in order and the first match wins. A row with `type_prefix` matches a file whose media type (lower case) starts with it; a type that names nothing (empty or application/octet-stream) matches no `type_prefix` row. A row with `extensions` matches a file whose type names nothing and whose name ends in one of them; a named type decides alone. A row naming neither matches every file. `viewer` names an entry of FILE_VIEWERS in FilePreview.tsx; an unknown name draws `file`. A row's `settings` go to its viewer as they are (the table viewer reads `separator`). A new kind of file is one row here, and a new way of showing one is one entry there.",
  "unnamed_types": [
    "",
    "application/octet-stream",
    "binary/octet-stream"
  ],
  "rows": [
    {
      "type_prefix": "video/",
      "viewer": "video"
    },
    {
      "type_prefix": "audio/",
      "viewer": "sound"
    },
    {
      "type_prefix": "image/",
      "viewer": "picture"
    },
    {
      "type_prefix": "application/pdf",
      "viewer": "pdf"
    },
    {
      "type_prefix": "application/vnd.openxmlformats-officedocument.",
      "viewer": "office"
    },
    {
      "type_prefix": "text/csv",
      "viewer": "table",
      "settings": {
        "separator": ","
      }
    },
    {
      "type_prefix": "application/csv",
      "viewer": "table",
      "settings": {
        "separator": ","
      }
    },
    {
