import { afterEach, describe, expect, it, vi } from 'vitest';

vi.mock('@bitfield/runtime-kit', () => ({ sendRequestToBitfieldTarget: vi.fn() }));
import { sendRequestToBitfieldTarget } from '@bitfield/runtime-kit';
import { readItemRecordFeed } from './read-item-record-feed';

afterEach(() => vi.resetAllMocks());

describe('readItemRecordFeed', () => {
  it('uses the public admitted target and returns only rows for the requested subject', async () => {
    vi.mocked(sendRequestToBitfieldTarget).mockResolvedValueOnce({
      status: 'accepted',
      subject_ref: 'community:one',
      rows: [
        { item_ref: 'item:one', scope_ref: 'community:one', target_ref: 'community:one', revision: 1, created_at: '2026-09-24T12:00:00.000Z', fields: { kind: 'post', body: 'Still here', author: 'Julien' } },
        { item_ref: 'item:other', scope_ref: 'community:two', target_ref: 'community:two', revision: 1, fields: { kind: 'post', body: 'Other community' } },
      ],
    });

    const items = await readItemRecordFeed(' community:one ');

    expect(sendRequestToBitfieldTarget).toHaveBeenCalledWith({
      target: 'item-record.read-feed-items',
      payload: { subject_ref: 'community:one', expected_revision: 0 },
    });
    expect(items.map((item) => item.body)).toEqual(['Still here']);
    expect(items[0].author).toBe('Julien');
  });

  it('decodes a transport-wrapped JSON byte reply', async () => {
    vi.mocked(sendRequestToBitfieldTarget).mockResolvedValueOnce({
      payload: new TextEncoder().encode(JSON.stringify({
        status: 'accepted',
        subject_ref: 'community:one',
        rows: [{ item_ref: 'item:one', scope_ref: 'community:one', fields: { kind: 'post', body: 'Saved after reload' } }],
      })),
    });
    await expect(readItemRecordFeed('community:one')).resolves.toMatchObject([{ body: 'Saved after reload' }]);
  });

  it('rejects an empty subject before invoking the runtime', async () => {
    await expect(readItemRecordFeed('  ')).rejects.toThrow('item feed subject is required');
    expect(sendRequestToBitfieldTarget).not.toHaveBeenCalled();
  });
});
