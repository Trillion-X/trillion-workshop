// The MCP tools for what a pursuit holds with other people: its people, its shared things, its rules, its agents
// (src/spaces.mjs, src/person-spaces.mjs). A person sees one thing, the pursuit (src/pursuit-rooms.mjs); its room on
// the network is how it is kept, never a second thing, so every description here says pursuit. The tool names that
// still say space take a pursuit; the pursuit list itself is list_pursuits and archive_pursuit (src/tools.mjs), and the
// former list_spaces and archive_space are answered by them (src/renamed-tools.json operations); each takes a pursuit id (its room is made the first
// time it is needed) or the room's space_id. Each is marked reach "spaces", so a sign-in held to some pursuits' rooms
// (src/reach.mjs) is shown these and nothing else.
import settings from './space-settings.json' with { type: 'json' };
import invitation from '../../../space-invitation/src/space-invitation.json' with { type: 'json' };
import { PALETTE } from '../../../keep-and-wake-ai-sessions-on-this-computer/src/responses.mjs';
import { membershipKinds } from '../../../decide-who-may-do-what-in-a-space/from-old-trillion/src/space-membership-kinds.mjs.held';

const spaceId = { type: 'string', description: 'The pursuit: its id from list_pursuits (pursuit:...), the space_id it carries, or its name (its whole name or one word only it has). A pursuit nobody else is in yet gets its shared place the first time it is used here.' };
const at = id => `/spaces/${encodeURIComponent(id)}`;
const query = input => { const pairs = Object.entries(input).filter(([, value]) => value !== undefined && value !== null); return pairs.length ? `?${new URLSearchParams(pairs.map(([key, value]) => [key, String(value)]))}` : ''; };
const archive = { type: 'object', description: 'One conversation exactly as the chat app exported it (for ChatGPT: the conversation object with title, mapping and current_node), or as it was read off its own page: { conversation_id, title, messages: [{ id: its place on the page, speaker: "person", "ai" or the name the page shows, text: word for word, at: its time when the page shows one, model: the model that wrote it when the page names one }] }.' };

// What a personal key may be given besides its reach (src/personal-keys.mjs).
const keyFacts = {
  name: { type: 'string', description: 'The app, agent or machine it is for, as the person reads it on their account page.' },
  purpose: { type: 'string', description: 'What it is for, in a few words.' },
  expires_in: { type: ['integer', 'null'], minimum: 1, description: 'Seconds from now until it stops working; null for never.' },
  expires_at: { type: ['string', 'null'], description: 'The date and time it stops working (ISO 8601); null for never.' },
};

export function spaceTools(call) {
  const tool = (name, description, inputSchema, run) => ({ name, description, inputSchema, run, reach: 'spaces' });
  return [
    tool('create_space', 'Starts a new pursuit with this person as its first member, gives it its shared place, and invites each person in members the way invite_to_space does (a one-time link, emailed when email is given and texted when phone is given); the same pursuit record_pursuits keeps, so it is one thing everywhere. members_are is team by default; customers lets invited people join without their own Trillion plan. Returns pursuit_id, space_id and, per person, the link and whether each message went out. Only invite people the person asked to invite.', { type: 'object', required: ['name'], properties: { name: { type: 'string', description: 'What the pursuit is called' }, label: { type: 'string', enum: ['project', 'group'], description: 'How people join it: project (by invitation) when left out, group' }, members_are: { type: 'string', enum: membershipKinds().map(kind => kind.id), description: 'team by default; customers lets people join without a Trillion plan' }, members: { type: 'array', items: { type: 'object', properties: { name: { type: 'string' }, email: { type: 'string' }, phone: { type: 'string' } } }, description: 'People to invite into it' } } }, ({ name, label, members_are, members }) => call('/spaces', { title: name, ...(label ? { label } : {}), ...(members_are ? { members_are } : {}), ...(members?.length ? { members } : {}) })),
    tool('open_space', 'One pursuit: its description and picture, its members by the name each shows there (never a contact), how many items of each kind it holds, unread and last_activity_at, and the agents members\' AIs put to work there.', { type: 'object', required: ['space_id'], properties: { space_id: spaceId } }, ({ space_id }) => call(at(space_id))),
    tool('read_space_record', 'Reads one revisioned shared record in the address namespace shared: in a pursuit. Returns found, revision and value; a missing or deleted record has found false. Use the revision exactly as returned when changing or deleting it.', { type: 'object', required: ['space_id', 'address'], properties: { space_id: spaceId, address: { type: 'string', pattern: '^shared:', maxLength: 400 } } }, ({ space_id, address }) => call(`${at(space_id)}/records/${encodeURIComponent(address)}`)),
    tool('write_space_record', 'Creates or changes one shared: record in a pursuit only if expected_revision still matches the current one (null when not yet created). Returns swapped false and the current value on a conflict; read it, preserve both edits, then retry with the current revision. Other members see a successful change live.', { type: 'object', required: ['space_id', 'address', 'expected_revision', 'value'], properties: { space_id: spaceId, address: { type: 'string', pattern: '^shared:', maxLength: 400 }, expected_revision: { type: ['integer', 'null'], minimum: 0 }, value: {} } }, ({ space_id, address, ...body }) => call(`${at(space_id)}/records/${encodeURIComponent(address)}`, body, 'POST')),
    tool('delete_space_record', 'Deletes one shared: record only if expected_revision still matches. The room keeps a revisioned tombstone so older writers cannot silently bring it back; a later explicit write can restore it. Returns swapped false with the current revision on a conflict.', { type: 'object', required: ['space_id', 'address', 'expected_revision'], properties: { space_id: spaceId, address: { type: 'string', pattern: '^shared:', maxLength: 400 }, expected_revision: { type: ['integer', 'null'], minimum: 0 } } }, ({ space_id, address, expected_revision }) => call(`${at(space_id)}/records/${encodeURIComponent(address)}`, { expected_revision }, 'DELETE')),
    tool('mark_space_seen', 'Marks a pursuit as seen by this person, after they (or you, for them) have read it. With nothing else, everything up to now is seen. With through (an item_id), only up to that item is seen, so what arrived after it stays unread; the mark only moves forward, so an older call changes nothing. With unread_from (an item_id), that item and everything after it count as unread again. Returns seen_at and the unread count now.', { type: 'object', required: ['space_id'], properties: { space_id: spaceId, through: { type: 'string', description: 'The item_id of the newest item seen' }, unread_from: { type: 'string', description: 'The item_id to mark unread from, with everything after it' } } }, ({ space_id, ...rest }) => call(`${at(space_id)}/seen`, rest)),
    tool('describe_space', 'Sets a pursuit\'s title, what it is about, its picture and its colour, seen by every member: title is its name (changed, never cleared), description is a few plain sentences, picture is one of this person\'s own picture files (its name or identity), shared into the pursuit so members see it, and colour is the colour its card and title show in. null clears any of them. Needs the private reach to take a picture from their files.', { type: 'object', required: ['space_id'], properties: { space_id: spaceId, title: { type: 'string', description: 'The pursuit\'s new name' }, description: { type: ['string', 'null'] }, picture: { type: ['string', 'null'], description: 'A picture file\'s name (like /logos/brand.png) or identity in this person\'s files' }, colour: { type: ['string', 'null'], enum: [...settings.colours.map(colour => colour.id), null], description: `One of: ${settings.colours.map(colour => `${colour.id} (${colour.label})`).join(', ')}` } } }, ({ space_id, ...about }) => call(`${at(space_id)}/about`, about)),
    tool('read_space_picture', 'Where to read the bytes of a pursuit\'s picture: a short-lived address, for members only.', { type: 'object', required: ['space_id'], properties: { space_id: spaceId } }, ({ space_id }) => call(`${at(space_id)}/picture`)),
    tool('make_space_invite', 'Makes a one-time invite link to a pursuit, for someone who has no Trillion network listing: whoever opens it signed in to Trillion sees the pursuit\'s name and joins. It works once, lasts days (7 unless you say, at most 30), and stops working if revoked or if this person leaves. Give the link only to the person it is for.', { type: 'object', required: ['space_id'], properties: { space_id: spaceId, days: { type: 'number', minimum: 1, maximum: 30 }, email: { type: 'string', description: 'Who it is for: it then also reaches them once their account signs in with this email (nothing is sent)' }, phone: { type: 'string' }, member_type: { type: 'string', description: 'The member type (role) whoever joins with it takes, from read_space_rules member_types' } } }, ({ space_id, ...rest }) => call(`${at(space_id)}/invites`, rest)),
    tool('invite_to_space', 'Invites one person into a pursuit and tells them: makes a one-time invite link, writes the invitation (an email and a short text in this person\'s voice, both with the link, whose preview shows the pursuit, who invited them and who is in it), emails it when email is given, and texts it when phone is given through this person\'s own connected iMessage or WhatsApp (text_through; iMessage when left out). Returns the link, the email and the text as written, and whether each went out; a text that could not go out is returned for you to send. Only invite someone the person asked to invite.', { type: 'object', required: ['space_id'], properties: { space_id: spaceId, name: { type: 'string', description: 'The name of the person invited, as the invitation greets them' }, email: { type: 'string', description: 'Where the invitation email goes' }, phone: { type: 'string', description: 'The number the text goes to' }, text_through: { type: 'string', enum: invitation.text_senders.map(sender => sender.id), description: 'Which of this person\'s connected accounts sends the text' }, days: { type: 'number', minimum: 1, maximum: settings.invites.max_days }, member_type: { type: 'string', description: 'The member type (role) they take when they join, from read_space_rules member_types; the pursuit\'s default when left out' } } }, ({ space_id, ...invite }) => call(`${at(space_id)}/invite-person`, invite)),
    tool('list_space_invites', 'The invite links this person made for a pursuit, each open, used, revoked or expired.', { type: 'object', required: ['space_id'], properties: { space_id: spaceId } }, ({ space_id }) => call(`${at(space_id)}/invites`)),
    tool('revoke_space_invite', 'Revokes an invite link this person made (invite_id from make_space_invite or list_space_invites), so it no longer lets anyone in.', { type: 'object', required: ['space_id', 'invite_id'], properties: { space_id: spaceId, invite_id: { type: 'string' } } }, ({ space_id, invite_id }) => call(`${at(space_id)}/invites/revoke`, { invite_id })),
    tool('join_space', 'Joins a pursuit with an invite link someone gave this person (the whole link, or its code). Only when the person asked to join.', { type: 'object', required: ['invite'], properties: { invite: { type: 'string', description: 'The invite link, or the code in it' } } }, ({ invite }) => call(`/spaces/join/${encodeURIComponent(invite)}`, {})),
    tool('read_space', 'Items in a pursuit, newest first: each with kind, title, body, what it is about, and its provenance (made in the pursuit, shared from a member\'s private Trillion, or brought in from a chat archive; by which member; when). The first page, unfiltered, also carries parts: what each part turned on in the pursuit keeps in its own place (the board\'s pictures, notes and placed files, as records), so you read the whole pursuit, not only its items. Filter by kind; pass next_before as before for older items. With query (words; every word must be in the item) it finds the items whose words contain them, as this person is allowed to read them: a hidden thing the person may not show again is never found by its words, and a page may hold fewer than limit while next_before is not null (go on with it).', { type: 'object', required: ['space_id'], properties: { space_id: spaceId, kind: { type: 'string' }, query: { type: 'string', description: 'Words to find in the items\' titles and bodies; every word must be there' }, before: { type: 'string' }, limit: { type: 'integer', minimum: 1, maximum: 100 } } }, ({ space_id, ...rest }) => call(`${at(space_id)}/items${query(rest)}`)),
    tool('read_space_responses', 'Reads comments and replies attached to records in a pursuit. Give record to read that record\'s exact-part thread in time order; record with all_parts:true reads its critiques across every selected part or timestamp. Leave record out to page through all anchored responses newest first. Each response names its record and selected part when present. Use next_before or next_after as before for the next page.', { type: 'object', required: ['space_id'], properties: { space_id: spaceId, record: { type: 'string' }, part: { type: 'object' }, all_parts: { type: 'boolean', description: 'With record, reads its replies across all parts and timestamps. False or omitted retains the exact-part thread.' }, before: { type: 'string' }, limit: { type: 'integer', minimum: 1, maximum: 100 } } }, ({ space_id, part, ...rest }) => call(`${at(space_id)}/responses${query({ ...rest, ...(part ? { part: JSON.stringify(part) } : {}) })}`)),
    tool('add_to_space', 'Adds items made in the pursuit itself, seen by every current member: a message, a shared pursuit, a decision the group made, a note, or any other kind, in your words (kind is any short word). about links related items of the same pursuit by item_id; reply_to names the one item this answers, and part (with reply_to) the piece of it the words are about. An anchor { record, part? } attaches a response to any record visible in this pursuit, including text ranges; a reply may also name that anchor so every view can find the whole thread.', { type: 'object', required: ['space_id', 'items'], properties: { space_id: spaceId, items: { type: 'array', minItems: 1, maxItems: 100, items: { type: 'object', required: ['kind', 'body'], properties: { kind: { type: 'string' }, title: { type: 'string' }, body: {}, about: { type: 'array', items: { type: 'string' } }, reply_to: { type: 'string' }, anchor: { type: 'object', required: ['record'], properties: { record: { type: 'string' }, part: { type: 'object' } } }, part: { type: 'object', description: 'With reply_to: the piece of that item these words are about; with anchor, the piece of the record.' } } } } } }, ({ space_id, items }) => call(`${at(space_id)}/items`, { items })),
    tool('react_in_space', `Reacts to one item or anchored record in a pursuit, seen by every member: symbol is one of the offered reactions (${PALETTE.map(row => `${row.symbol} ${row.glyph}`).join(', ')}), or glyph is the person's own emoji or an https picture or GIF. Reacting again with the same one changes nothing; on false takes it back. Returns the reactions with who gave each. React only as the person asked.`, { type: 'object', required: ['space_id'], properties: { space_id: spaceId, item_id: { type: 'string' }, record: { type: 'string' }, part: { type: 'object' }, symbol: { type: 'string' }, glyph: { type: 'string' }, on: { type: 'boolean' } } }, ({ space_id, item_id, record, part, on = true, ...rest }) => record ? call(`${at(space_id)}/responses/react`, { ...rest, record, part, on }) : call(`${at(space_id)}/items/${encodeURIComponent(item_id)}/react`, { ...rest, on })),
    tool('resolve_space_response_thread', 'Marks the response thread on a record open or resolved for everyone in the pursuit. This changes the shared thread state without changing the record or its comments.', { type: 'object', required: ['space_id', 'record', 'resolved'], properties: { space_id: spaceId, record: { type: 'string' }, part: { type: 'object' }, resolved: { type: 'boolean' } } }, ({ space_id, ...rest }) => call(`${at(space_id)}/responses/resolve`, rest)),
    tool('share_to_space', 'Shares a selected record or an ordered mixed selection into a pursuit. For one record, use record (file:<identity>, workflow:<id> or a pursuit id); record_id, file and tool remain supported. For several, use records or items: each item can name a record, file, tool, workflow_id, or hold kind link with url, kind text with text, or kind share with code. records go first, then items in their given order. Only shared fields leave the owner; file bytes stay there. Current membership and sharing choices are checked for the selection. Reuse request_key when retrying the same selection; changing it means a new selection. Returns placed in selection order for a batch; repeated sources point to one pursuit item.', {
      type: 'object', required: ['space_id'], properties: {
        space_id: spaceId, record: { type: 'string' }, record_id: { type: 'string' }, file: { type: 'string' }, tool: { type: 'string' },
        records: { type: 'array', items: { type: 'string' }, description: 'Private record references to share, in selection order.' },
        items: { type: 'array', items: { type: 'object', properties: {
          kind: { type: 'string' }, record: { type: 'string' }, file: { type: 'string' }, tool: { type: 'string' }, workflow_id: { type: 'string' },
          url: { type: 'string' }, text: { type: 'string' }, code: { type: 'string' }, title: { type: 'string' },
        } }, description: 'An ordered selection of references, links, words and nested shares. The existing sharing owner validates each kind.' },
        request_key: { type: 'string', minLength: 1, maxLength: 500, description: 'Reuse for an exact selection retry; never reuse it for different items.' },
      },
    }, ({ space_id, ...selection }) => call(`${at(space_id)}/share`, selection)),
    tool('read_tool_access_impact', 'Before adding a tool to a pursuit with grant_space_tool: what adding it would give each member beyond what they already hold (gains), what the tool itself reaches (runs on their computer, sends data off the device, can cost money), the exact tool_version that would be approved, and whether you have to decide it yourself. member_id "*" (the default) is everyone now and whoever joins later. Changes nothing.', { type: 'object', required: ['space_id', 'tool_id'], properties: { space_id: spaceId, tool_id: { type: 'string' }, member_id: { type: 'string' }, operations: { type: 'array', minItems: 1, uniqueItems: true, items: { type: 'string', enum: ['discover', 'describe', 'run', 'read'] } } } }, ({ space_id, operations, ...rest }) => call(`${at(space_id)}/tools/impact${query({ ...rest, operations: operations?.join(',') })}`)),
    tool('grant_space_tool', 'Adds a tool to a pursuit: any tool find_tool_for_job finds that is published in the Marketplace, whoever made it and whenever, including Trillion\'s own (points, a leaderboard, a board, a classroom and the rest are tools like any other). member_id "*" adds it for everyone in the pursuit, now and whoever joins later, and it shows as a place of the pursuit; name one member_id to grant only them; leaving it out grants only yourself. Name operations to limit use; leaving them out grants discover, describe, run and read. It stores a definition reference, never tool code or private connections. Only the person who started the pursuit can grant it.', { type: 'object', required: ['space_id', 'tool_id'], properties: { space_id: spaceId, tool_id: { type: 'string' }, tool_version: { type: 'string' }, member_id: { type: 'string' }, operations: { type: 'array', minItems: 1, uniqueItems: true, items: { type: 'string', enum: ['discover', 'describe', 'run', 'read'] } } } }, ({ space_id, ...grant }) => call(`${at(space_id)}/tools/grant`, grant)),
    tool('list_space_tools', 'Lists the Marketplace tools granted to you in a pursuit, those added for everyone included. The pursuit owner can name another member_id. An operation filters the list. added true lists instead every tool added to the pursuit, for anyone, each with its name, whether it is for everyone and whether you may use it.', { type: 'object', required: ['space_id'], properties: { space_id: spaceId, tool_id: { type: 'string' }, member_id: { type: 'string' }, operation: { type: 'string', enum: ['discover', 'describe', 'run', 'read'] }, added: { type: 'boolean' } } }, ({ space_id, tool_id, member_id, operation, added }) => (added ? call(`${at(space_id)}/tools/added`) : call(`${at(space_id)}/tools${query({ tool_id, member_id, operation })}`))),
    tool('revoke_space_tool', 'Revokes one tool grant (grant_id) so pursuit work can no longer start through it, or takes a tool out of the pursuit for everyone (tool_id): a part such as a leaderboard is turned off and what it held is kept for when it is added again. Only the person who started the pursuit can do either.', { type: 'object', required: ['space_id'], properties: { space_id: spaceId, grant_id: { type: 'string' }, tool_id: { type: 'string' } } }, ({ space_id, grant_id, tool_id }) => (tool_id ? call(`${at(space_id)}/tools/remove`, { tool_id }) : call(`${at(space_id)}/tools/revoke`, { grant_id }))),
    tool('withdraw_from_space', 'Withdraws an item this person put in a pursuit: its words are erased for everyone, and a marker that they withdrew it stays.', { type: 'object', required: ['space_id', 'item_id'], properties: { space_id: spaceId, item_id: { type: 'string' } } }, ({ space_id, item_id }) => call(`${at(space_id)}/withdraw`, { item_id })),
    tool('name_in_space', 'Sets the name this person shows to the other members of one pursuit.', { type: 'object', required: ['space_id', 'name'], properties: { space_id: spaceId, name: { type: 'string' } } }, ({ space_id, name }) => call(`${at(space_id)}/name`, { name })),
    tool('read_shared_file', 'Where to read the bytes of a file shared into a pursuit (item_id of a file item): a short-lived address. The address stops working when the owner takes back the share or the item is withdrawn.', { type: 'object', required: ['space_id', 'item_id'], properties: { space_id: spaceId, item_id: { type: 'string' } } }, ({ space_id, item_id }) => call(`${at(space_id)}/items/${encodeURIComponent(item_id)}/file`)),
    tool('read_shared_file_transcript', 'Reads the words already saved for a recording shared into a pursuit, with their times in seconds. Returns text and segments only; it never starts another transcription. Current membership and the shared file are checked again. With no saved words, text and segments are null.', { type: 'object', required: ['space_id', 'item_id'], properties: { space_id: spaceId, item_id: { type: 'string' } } }, ({ space_id, item_id }) => call(`${at(space_id)}/items/${encodeURIComponent(item_id)}/transcript`)),
    tool('bring_in_chat', 'Brings one earlier chat into Trillion from its exported archive, word for word, with the files its messages carried: into the person\'s private Trillion (leave space_id out) or into one pursuit they name (space_id). Files are found among the person\'s own files and never copied: attachments maps each attachment id in the chat (like file-AbC123) to the name or identity of that file in their files, and attachments_folder names a folder whose files start with those ids, as in an export. In a pursuit, other members can open those files while the person stays in the pursuit. Files that could not be found are listed in missing_attachments; put them in the person\'s files and bring the chat in again to add them. Bringing the same chat in again adds nothing twice. For a whole account export use bring_in_chat_export.', { type: 'object', required: ['conversation'], properties: { conversation: archive, preserve_conversation_id: { type: 'boolean', description: 'Keep an existing complete conversation id unchanged, rather than prefixing the app name; for trusted historical transcripts already recorded in Trillion' }, space_id: spaceId, app: { type: 'string', description: 'The app it came from; ChatGPT when left out' }, attachments: { type: 'object', additionalProperties: { type: 'string' }, description: 'Attachment id to the name (like /chats/file-AbC123-photo.png) or identity of that file in the person\'s files' }, attachments_folder: { type: 'string', description: 'A folder in the person\'s files holding the chat\'s files, named with their ids first' } } }, ({ space_id, ...chat }) => call(space_id ? `${at(space_id)}/import` : chat.preserve_conversation_id ? '/chats/import-history' : '/chats/import', chat)),
    tool('bring_in_chat_export', 'Brings a whole account export of chats (for ChatGPT, conversations.json) into Trillion, from a file already in the person\'s files (file: its name or identity), with the files the chats carried: into their private Trillion, or into the one pursuit they name (space_id). Upload the whole export folder, not just conversations.json: its files are found in the same folder as conversations.json and the folders under it, or in attachments_folder if the person put them elsewhere, and are never copied. In a pursuit, other members can open those files while the person stays in the pursuit. Files that could not be found are listed in missing_attachments; add them to the person\'s files and bring the export in again to add them. A page of conversations per call; call again with offset set to next_offset until it is null. Nothing is brought in twice. Needs the private reach, since the file is private.', { type: 'object', required: ['file'], properties: { file: { type: 'string' }, space_id: spaceId, offset: { type: 'integer', minimum: 0 }, limit: { type: 'integer', minimum: 1, maximum: 100 }, app: { type: 'string' }, attachments_folder: { type: 'string', description: 'The folder in the person\'s files holding the export\'s other files, when it is not the folder conversations.json is in' } } }, input => call('/chats/import-export', input)),
    tool('publish_space_agent', 'Puts this agent to work in one pursuit, so members\' AIs can hand it work there: name, description, skills, and optional capacity { max_concurrent, ttl_minutes }. It sees only that pursuit, never anyone\'s private Trillion. agent_id is yours; in the pursuit it is shown with your member name. Optional delivery { url } is an https address this agent answers on: it is then sent a signed event (handoff.created) when work in the pursuit is handed to it and one (handoff.finished) when work it handed off there is finished, carrying only the handoff id, the job\'s first words and the pursuit id, so it can wait instead of asking. The answer carries delivery_secret once, to check each event\'s trillion-signature; keep it in memory only. Other members never see the secret or the address. delivery null stops events and drops any still waiting; rotate_delivery_secret true makes a new secret.', { type: 'object', required: ['space_id', 'name', 'description'], properties: { space_id: spaceId, agent_id: { type: 'string' }, delivery: { anyOf: [{ type: 'object', required: ['url'], properties: { url: { type: 'string' } } }, { type: 'null' }] }, rotate_delivery_secret: { type: 'boolean' }, name: { type: 'string' }, description: { type: 'string' }, skills: { type: 'array', items: {} }, harness: { type: 'string' }, model: { type: 'string' }, takes_work: { type: 'boolean' }, capacity: { type: 'object', properties: { max_concurrent: { type: 'integer', minimum: 0, maximum: 20 }, ttl_minutes: { type: 'number', minimum: 1, maximum: 1440 } } } } }, ({ space_id, ...card }) => call(`${at(space_id)}/agents/publish`, card)),
    tool('withdraw_space_agent', 'Stops one of this person\'s agents working in a pursuit (agent_id as published there): it takes no more work, work it held goes back up for others, and events still waiting for it are dropped and never sent.', { type: 'object', required: ['space_id', 'agent_id'], properties: { space_id: spaceId, agent_id: { type: 'string' } } }, ({ space_id, agent_id }) => call(`${at(space_id)}/agents/withdraw`, { agent_id })),
    tool('find_space_agents', 'The agents at work in one pursuit that match a job, with which member runs each and whether it is ready now.', { type: 'object', required: ['space_id'], properties: { space_id: spaceId, job: { type: 'string' } } }, ({ space_id, ...rest }) => call(`${at(space_id)}/agents/find`, rest)),
    tool('hand_off_in_space', 'Hands a job to an agent in a pursuit (to_agent from find_space_agents), or to whichever agent there takes it first. Everything in the handoff is seen by every member of the pursuit, so include only what belongs there: case_id may name only an item of this pursuit. request_key is any unique text; repeating it returns the same handoff.', { type: 'object', required: ['space_id', 'job', 'request_key'], properties: { space_id: spaceId, job: { type: 'string' }, request_key: { type: 'string' }, to_agent: { type: 'string' }, input: { type: 'object' }, from_agent: { type: 'string' }, case_id: { type: 'string' }, parent_handoff_id: { type: 'string' }, hold_minutes: { type: 'number', minimum: 1 } } }, ({ space_id, ...job }) => call(`${at(space_id)}/handoffs`, job)),
    tool('take_space_work', 'Takes the oldest job waiting in a pursuit for this agent (agent_id as you published it there), or one handoff_id. request_key is any unique text for this take: sending it again returns the same job instead of taking another. A pending capacity answer needs another call with its request_key. To read remaining held jobs, send held_next as capacity_cursor with the same request_key; this only reads holds and never takes another job.', { type: 'object', required: ['space_id', 'agent_id', 'request_key'], properties: { space_id: spaceId, agent_id: { type: 'string' }, handoff_id: { type: 'string' }, request_key: { type: 'string' }, capacity_cursor: { type: 'object', required: ['collection','after'], properties: { collection: { type: 'string' }, after: { type: 'string' } }, additionalProperties: false } } }, ({ space_id, ...take }) => call(`${at(space_id)}/handoffs/take`, take)),
    tool('finish_space_work', 'Records the result of a job this agent took in a pursuit. Every member of the pursuit sees it; put nothing private in it.', { type: 'object', required: ['space_id', 'handoff_id', 'agent_id', 'result'], properties: { space_id: spaceId, handoff_id: { type: 'string' }, agent_id: { type: 'string' }, result: {}, summary: { type: 'string' } } }, ({ space_id, ...done }) => call(`${at(space_id)}/handoffs/finish`, done)),
    tool('read_space_handoff', 'Reads one handoff in a pursuit (handoff_id), or the newest handoffs there.', { type: 'object', required: ['space_id'], properties: { space_id: spaceId, handoff_id: { type: 'string' } } }, ({ space_id, ...rest }) => call(`${at(space_id)}/handoffs/read`, rest)),
    tool('read_space_rules', 'Who may do what in one pursuit: its rules, each with id, effect (allow or deny), says (what it means), who, actions and when (further conditions, a rule tree over facts), what each covers, the facts, kinds of who and actions a rule can name, the members a rule can name (member_id, name, member_type), and may_change (whether this person may replace them). Every pursuit starts with rules that let its members read, write, share, invite and hand work, let whoever put something there take it back, and let whoever started it change the rules. Changes nothing.', { type: 'object', required: ['space_id'], properties: { space_id: spaceId } }, ({ space_id }) => call(`${at(space_id)}/rules`)),
    tool('set_space_rules', 'Replaces who may do what in one pursuit, for a person its rules let change them (at first, whoever started it). Send the whole list, read_space_rules first and change it: each rule is { id, effect: "allow" or "deny", says: what it means in plain words, refuses?: the words a deny says to the person it stops, who?: { kind: "anyone" } or { kind: "any_member" } or { kind: "anyone_with_link" } or { kind: "member_type", member_type } or { kind: "person", person: a member_id from read_space_rules }, actions?: [action ids] (every action when left out), when?: { kind: "group", combinator: "and" or "or", rules: [conditions or groups] }, until?: a date and time ending this rule }, a condition being { kind: "rule", field: one of the facts, operator: "is_any_of" or "is_none_of", params: { values: [...] } } (is_member, is_owner, holds_link, made_it, maker_is_member and is_community are true or false; action, member_type and person are ids). A rule holds when its who, actions and when all hold. A deny that holds wins; otherwise an allow that holds lets the person act; when none holds they are refused. Who may change the rules is the action change_rules in the same list, and a list that would stop this person changing them again is refused. rules null puts back the rules every pursuit starts with. Every member sees the new rules; say what will change and get the person\'s approval first.', { type: 'object', required: ['space_id', 'rules'], properties: { space_id: spaceId, rules: { anyOf: [{ type: 'array', minItems: 1, maxItems: 100, items: { type: 'object', required: ['id', 'effect', 'says'], properties: { id: { type: 'string' }, effect: { type: 'string', enum: ['allow', 'deny'] }, says: { type: 'string' }, refuses: { type: 'string' }, who: { type: 'object' }, actions: { type: 'array', items: { type: 'string' } }, when: { type: 'object' }, until: { type: 'string', format: 'date-time' } } } }, { type: 'null' }] } } }, ({ space_id, rules }) => call(`${at(space_id)}/rules`, { rules })),
    tool('set_space_members_are', `Says who the people in one pursuit are, for a person its rules let change it (at first, its owner). ${membershipKinds().map(kind => `${kind.id}: ${kind.about}`).join(' ')} Projects and groups start as team, communities as customers; null goes back to that. It decides only who may join from now on: nobody already in the space is put out.`, { type: 'object', required: ['space_id', 'members_are'], properties: { space_id: spaceId, members_are: { type: ['string', 'null'], enum: [...membershipKinds().map(kind => kind.id), null] } } }, ({ space_id, members_are }) => call(`${at(space_id)}/members-are`, { members_are })),
    tool('set_member_type', 'Gives a member of one pursuit another member type (member_id and the type ids from read_space_rules members and member_types), for a person the pursuit\'s rules let give people their type (at first, its owner). A member\'s type is what the pursuit\'s rules name in who: { kind: "member_type" }. A change that would leave nobody able to change who may do what is refused.', { type: 'object', required: ['space_id', 'member_id', 'member_type'], properties: { space_id: spaceId, member_id: { type: 'string' }, member_type: { type: 'string' } } }, ({ space_id, member_id, member_type }) => call(`${at(space_id)}/members/type`, { member_id, member_type })),
    tool('set_space_joining_type', 'Sets the type new people get when they join one pursuit. This is the space-wide starting profile, so only someone its rules let change who may do what can change it. Use a type id from read_space_rules member_types; this does not change a role on any one invitation or member.', { type: 'object', required: ['space_id', 'member_type'], properties: { space_id: spaceId, member_type: { type: 'string', description: 'An existing member type id from read_space_rules' } } }, ({ space_id, member_type }) => call(`${at(space_id)}/members/joining-type`, { member_type })),
    tool('remove_from_space', 'Takes another member out of one pursuit (member_id from read_space_rules members), for a person its rules let take people out (at first, whoever started it). It is the same as their leaving: what they put there stays, their agents there stop, and they come back only with a new invite. Refused for yourself (leave instead) and when nobody left could change who may do what. Say who you will take out and get the person\'s approval first.', { type: 'object', required: ['space_id', 'member_id'], properties: { space_id: spaceId, member_id: { type: 'string' } } }, ({ space_id, member_id }) => call(`${at(space_id)}/members/remove`, { member_id })),
    tool('add_member_type', 'Adds a member type of the pursuit\'s own to one pursuit, by its name (for example "Editor"), for a person its rules let change who may do what. It is offered with the pursuit\'s starting types wherever a type is chosen, and rules can name it by the id read_space_rules returns. inherits optionally names one or more existing types whose permissions it takes, including their inherited types.', { type: 'object', required: ['space_id', 'label'], properties: { space_id: spaceId, label: { type: 'string' }, inherits: { type: 'array', items: { type: 'string' }, description: 'Existing member type ids in this pursuit whose permissions this type inherits.' } } }, ({ space_id, label, inherits }) => call(`${at(space_id)}/member-types`, { label, inherits })),
    tool('update_member_type', 'Renames a pursuit-owned member type or changes the types it inherits. The change is refused if it would leave nobody able to edit the pursuit rules.', { type: 'object', required: ['space_id', 'member_type'], properties: { space_id: spaceId, member_type: { type: 'string' }, label: { type: 'string' }, inherits: { type: 'array', items: { type: 'string' }, description: 'Other existing member type ids in this pursuit.' } } }, ({ space_id, member_type, ...change }) => call(`${at(space_id)}/member-types`, { member_type, ...change }, 'PUT')),
    tool('remove_member_type', 'Removes a member type a pursuit added itself, while nobody holds it and no rule names it.', { type: 'object', required: ['space_id', 'member_type'], properties: { space_id: spaceId, member_type: { type: 'string' } } }, ({ space_id, member_type }) => call(`${at(space_id)}/member-types/remove`, { member_type })),
    tool('set_item_facts', 'Sets small facts on one thing in a pursuit that every member sees and any member may change: who has it (assignee: the name they show in the pursuit or their member id, and the thing then waits on them in their own Waiting on you, with every nudge, until it is done), when it is due (due: a date or a date and time, and it is then on their own Calendar that day), whether it is done (status: done), a label, or any fact of your own naming (lowercase name, text of at most 200 characters, a number or true/false); null takes one away. Its words never change. Use it to give a message to someone, mark it done, or label it.', { type: 'object', required: ['space_id', 'item_id', 'facts'], properties: { space_id: spaceId, item_id: { type: 'string' }, facts: { type: 'object' } } }, ({ space_id, item_id, facts }) => call(`${at(space_id)}/facts`, { item_id, facts })),
    tool('hide_in_space', 'Hides one thing in a pursuit from everyone who may not hide or show it (they see only that it is hidden and by whom), or shows it again with hidden false. Its words stay. Allowed when the pursuit\'s rules let this person hide or show that thing (each thing read with read_space says so in may.hide_item).', { type: 'object', required: ['space_id', 'item_id'], properties: { space_id: spaceId, item_id: { type: 'string' }, hidden: { type: 'boolean' } } }, ({ space_id, item_id, hidden }) => call(`${at(space_id)}/hide`, { item_id, hidden: hidden !== false })),
    tool('make_agent_key', 'Makes a personal key for an agent, a script or a machine that reaches only what the person chooses: reach { private: false, pursuits: [space_id] } for one pursuit and nothing private, { private: false, pursuits: "all" } for every pursuit and nothing private, or { private: true, pursuits: [] } for the private Trillion only. Give it a name (the app or machine), a purpose (what it is for, in words) and, for a key that should stop on its own, expires_in (seconds) or expires_at (a date and time). The key cannot reach further, or last longer, than the sign-in making it. Returns the key once, with its key_id; list_agent_keys, change_agent_key and end_agent_key manage it after.', { type: 'object', required: ['reach'], properties: { reach: { type: 'object', required: ['private'], properties: { private: { type: 'boolean' }, spaces: { anyOf: [{ type: 'string', enum: ['all'] }, { type: 'array', items: { type: 'string' } }] } } }, ...keyFacts } }, ({ reach, name, purpose, expires_in, expires_at }) => call('/spaces/keys', { reach, name, purpose, expires_in, expires_at })),
    tool('list_agent_keys', 'Lists the person\'s personal keys this sign-in may manage, newest first: each key_id with its name, purpose, the last four characters (ending), what it reaches, when it was made, last used and expires (null for never) and whether it has expired. A key itself is never shown after it is made. more is true when there are more keys than one list holds.', { type: 'object', properties: {} }, () => call('/spaces/keys')),
    tool('change_agent_key', 'Renames one personal key (key_id from list_agent_keys), gives it a purpose, or extends, shortens or removes its expiry: expires_in (seconds from now), expires_at (a date and time), or either as null for a key that never expires. An empty name or purpose takes it away. A key cannot be made to last longer than the sign-in changing it, so a key cannot extend itself; the person can, on their account page.', { type: 'object', required: ['key_id'], properties: { key_id: { type: 'string' }, ...keyFacts } }, ({ key_id, name, purpose, expires_in, expires_at }) => call('/spaces/keys/change', { key_id, name, purpose, expires_in, expires_at })),
    tool('end_agent_key', 'Turns one personal key off (key_id from list_agent_keys): its next call is refused and anything open with it closes. It cannot be turned back on; make a new key instead. Say which key you will turn off and get the person\'s approval first.', { type: 'object', required: ['key_id'], properties: { key_id: { type: 'string' } } }, ({ key_id }) => call('/spaces/keys/end', { key_id })),
  ];
}

