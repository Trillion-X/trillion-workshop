  "what_this_is": "The three Workshop rows that let a learner's own AI (Claude, ChatGPT or another) read the lessons the learner holds in a school's courses through the school's engine. The engine admits the caller through a team share grant with identity self and fills grant_person with the caller's id. Each row runs do-work/run.mjs, which reads the school's settings from the access database and opens the three held connections on descriptors 3, 4 and 5. Generic code; the school's values are only in the school's own settings row.",
  "records": [
    {
      "payload": {
        "kind": "ai-tool-descriptor",
        "id": "tool:list-the-lessons-i-hold",
        "label": "List the lessons I hold",
        "job": "See the courses and lessons my school's access opens for me: title, video link and whether there is a transcript",
        "description": "Answers the open courses of the caller, each with its id and title, and its lessons with id, title, video link and whether the lesson has a transcript. Only the courses whose access refs the caller holds are answered. The caller is the school's own person, admitted by the engine through a team share grant with identity self: grant_person is the caller's id, which the engine fills in and you do not type. Refuses in plain words when the caller is not from this school, is not a known person, has an unverified email, or does not hold the school's AI coach access. Reads only, in read-only transactions, from the sign-in, runs and content databases the settings name; nothing is written, kept or sent.",
        "status": "active",
        "input_schema": {
          "type": "object",
          "required": ["grant_person"],
          "additionalProperties": false,
          "properties": {
            "grant_person": {
              "type": "string",
              "description": "The caller's id, <issuer tag>_<sub>, filled in by the engine from the team share grant (identity self). Not typed by the learner."
            }
          }
        },
        "output_schema": {
          "type": "object",
          "required": ["courses"],
          "properties": {
            "courses": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["course_id", "title", "lessons"],
                "properties": {
                  "course_id": { "type": "string" },
                  "title": { "type": "string" },
                  "lessons": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": ["lesson_id", "title", "video_link", "has_transcript"],
                      "properties": {
                        "lesson_id": { "type": "string" },
                        "title": { "type": "string" },
                        "video_link": { "type": ["string", "null"] },
                        "has_transcript": { "type": "boolean" }
                      }
                    }
                  }
                }
              }
            }
          }
        },
