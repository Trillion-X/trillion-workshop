    {
      "payload": {
        "kind": "ai-tool-descriptor",
        "id": "tool:search-what-my-coach-teaches",
        "label": "Search what my coach teaches",
        "job": "Search the lessons my school's access opens for me, and the school's published articles, for a word or a phrase",
        "description": "Finds the text in the caller's open lessons (their titles, passages, timed transcript lines and transcript segments) and in the school's published articles. Each match names its kind, the lesson it belongs to (none for an article), a snippet around the text, and the start second in the video when the match is spoken. Only the caller's open courses are searched; articles are searched only once published. Answers at most most matches (default from the settings, capped there too). The caller is admitted as the list tool admits them: grant_person is filled in by the engine from the team share grant (identity self) and is not typed. Reads only, in read-only transactions; nothing is written, kept or sent.",
        "status": "active",
        "input_schema": {
          "type": "object",
          "required": ["grant_person", "query"],
          "additionalProperties": false,
          "properties": {
