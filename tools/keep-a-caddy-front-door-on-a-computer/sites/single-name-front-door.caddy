# Front door of one computer, at {{door_host}} only. Caddy keeps the certificate for that name itself; no shared store, no
# attached names, no program in front of the engine. The pages are the caller's own folder (pages_root), the sign-in routes are
# the row's routes, and a row that names the route `engine` (engine_paths, engine_listen) sends those paths to an engine on this computer.
{
	admin localhost:2019
	# A reload of this file lets calls in flight finish for this long before it ends them.
	grace_period {{grace_period}}
	# A pool's idle slot is not running, so its health page fails every health_interval; one line per failure was 40% of this
	# computer's journal (25,133 of 63,137 lines in the hour to 8:20 AM CST Nov 20 2026) and pushed out the lines worth keeping.
	# Health-check lines are not kept; a running slot that stops answering shows as the requests it fails, which are kept.
	log default {
		exclude http.handlers.reverse_proxy.health_checker.active
	}
}

{{door_host}} {
	# A raw upload (application/octet-stream, the engine's X-Call road) may be as long as upload_max; every other body request_max.
	# Each matcher excludes the other, because two body limits on one request nest and the smaller would win.
	@upload header Content-Type application/octet-stream
	@not_upload not header Content-Type application/octet-stream
	request_body @upload {
		max_size {{upload_max}}
	}
	request_body @not_upload {
		max_size {{request_max}}
	}
	# One line per request in the journal: its method, its address without the query, its status and how long it took; no header,
	# no client address, no cookie, no query value.
	log {
		output stdout
		format filter {
			wrap json
			fields {
				request>uri regexp "\?.*" ""
				request>headers delete
				request>tls delete
				request>remote_ip delete
				request>remote_port delete
				request>client_ip delete
				resp_headers delete
			}
		}
	}

{{routes}}
	handle /healthz {
		respond "tls-ready
" 200
	}
	# A screen's address under its route_prefix is answered by that prefix's page: a copy of the workspace page named for the
	# prefix's one or two segments (workspace-pages.mjs makes each), so /file/<id> gets file.prefix.html and /record/about/<id>
	# gets record.about.prefix.html. A page the path names exactly wins, and a bare prefix (/file, /file/) names no page, so it
	# still answers 404. A prefix deeper than two segments has no rule here and no page. These rules rewrite the path before the
	# routes above it are matched, so the first segment of a prefix must not be the first segment of an engine or sign-in route.
	@prefix_deep {
		path_regexp ^/[^/]+/[^/]+/[^/]
		not file {
			root {{pages_root}}
			try_files {path} {path}.html
		}
		file {
			root {{pages_root}}
			try_files /{http.request.uri.path.0}.{http.request.uri.path.1}.prefix.html
		}
	}
	rewrite @prefix_deep /{http.request.uri.path.0}.{http.request.uri.path.1}.prefix.html
	@prefix_one {
		path_regexp ^/[^/]+/[^/]
		not file {
			root {{pages_root}}
			try_files {path} {path}.html
		}
		file {
			root {{pages_root}}
			try_files /{http.request.uri.path.0}.prefix.html
		}
	}
	rewrite @prefix_one /{http.request.uri.path.0}.prefix.html
	@page file {
		root {{pages_root}}
		try_files {path} {path}.html
	}
	handle @page {
		@not_read not method GET HEAD
		respond @not_read 403
		# A page is sent compressed, and a file under a `named/` folder is content-named (a changed file gets a new name), so a
		# browser keeps it and never asks for it again; any other page is asked again after 300 s. On Nov 20 2026 the Mac app's
		# window took about 4 s to draw /workspace: its 720 KB stylesheet came uncompressed in 2.7 s, and each of its 120
		# content-named parts was asked for again on every open after five minutes.
		encode zstd gzip
		@named path */named/*
		@not_named not path */named/*
		header @named Cache-Control "public, max-age=31536000, immutable"
		header @not_named Cache-Control "public, max-age=300"
		root * {{pages_root}}
		rewrite @page {file_match.relative}
		file_server
	}
{{engine_routes}}
	handle {
		respond "Not found" 404
	}
	handle_errors 502 503 504 {
		header Retry-After 5
		header Cache-Control no-store
		header Content-Type "text/html; charset=utf-8"
		respond "<!doctype html><meta charset=utf-8><title>Trillion</title><p>One moment, Trillion is reconnecting. Refresh in a few seconds.</p>" 503
	}
}
{{refuse_other_hosts}}
