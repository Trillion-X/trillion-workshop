# Every name this computer is asked for that has a folder of its own under {{pages_root}} (pages_root/<name>/, or the bare name
# for www.<name>, which is sent on to it) is answered from that folder, read-only, with a certificate Caddy gets the first time
# the name is asked for; a name with no folder gets no certificate. A request no page answers goes to the site's own program
# when it has one: a program listening on the socket {{programs_root}}/<name>/http.sock (a unit of the computer's row, whose folder is <name>) gets it
# whole, any method. While that program restarts (its socket is gone or refuses), a request waits for it, trying again every
# 250 ms for up to 15 s, so a restart drops no request that has not reached the old program. The computer's own address {{door_host}} keeps its certificate (ACME profile {{certificate_profile}}) and
# answers 404. So this file and the computer's row name no site: a site is a folder, and a program of its own is its folder under programs_root.
# The site's `routes` (absent or empty: none, and no line) go first, before any page or program, for a route that must answer some
# paths of some names itself (the engine's door at a site's own name, tools/keep-an-engine-on-a-computer/caddy-route-engine-at-names.caddy).
# A name the row's `site_sockets` lists (absent: none, and no line) is sent to each of its program's sockets instead, the first
# that takes the call (routes/site-sockets.fragment): two slots of one program, each on its own socket, so one restarts while
# the other serves (Nov 21 2026: a site program restarted in place made its names wait up to 1.5 s).
# A name the row's `www_first_names` lists (absent: none, and no line) is answered at www.<name> instead, and its bare name is
# sent there (routes/www-first-name.fragment), for a bare name that also answers at an address this computer does not hold.
# A name the row's `served_elsewhere` lists (`{ to, names }`; absent: none, and no line) is a site that moved to another computer:
# every request for it goes there whole, with its own Host and its own name for TLS (routes/served-elsewhere.fragment), so a
# visitor or crawler whose DNS still points here gets the live site's answer, not a stale copy (Nov 25 2026: a site
# moved to another host and the old copy here answered a page with 503). Such a name keeps its certificate here and is never redirected.
{
	admin localhost:2019
	grace_period {{grace_period}}
	on_demand_tls {
		ask http://127.0.0.1:5601/
	}
}

# The question Caddy asks before getting a certificate for a name: 200 when the name (or, for www.<name>, the bare name) has
# its folder, or a program of its own (a site whose program answers its first page itself has pages but no index.html), its
# socket folder or its slots' socket folder (<name>-slots, give-a-site-program-slots.mjs), 404 otherwise. Loopback only.
http://127.0.0.1:5601 {
	bind 127.0.0.1
{{served_elsewhere_ask}}
	map {query.domain} {site} {
		~^www\.(.+)$ ${1}
		default {query.domain}
	}
	@has_folder file {{pages_root}}/{site}/index.html
	respond @has_folder 200
	@has_program file {
		root {{programs_root}}
		try_files /{site}/ /{site}-slots/
	}
	respond @has_program 200
	respond 404
}

{{door_host}} {
	tls {
		issuer acme {
			profile {{certificate_profile}}
		}
	}
	respond 404
}

https:// {
	tls {
		on_demand
	}
	# {site} is the bare name, for www.<name> too, so both answer from one folder and one program. {canonical} is the name that
	# answers, <name> (or www.<name> for a listed name, whose lines go first), and the other is sent there with a 308 that keeps
	# the path and query.
	map {host} {site} {canonical} {
{{served_elsewhere_names}}
{{www_first_names}}
		~^www\.(.+)$ ${1} ${1}
		default {host} {host}
	}
	@not_canonical expression {host} != {canonical}
	redir @not_canonical https://{canonical}{uri} 308
	# Every answer, a page or a program's, is sent compressed when the browser takes it (Nov 21 2026: a 15.3 MB members
	# script went whole, 3.4 MB as gzip, on a phone that waited 79 s).
	encode zstd gzip
	# The site's request log, when the row asks for it (access_log): one JSON line per request, to the journal and to a file of
	# its own when the row names one. Absent: no line.
{{access_log}}
{{served_elsewhere}}
{{routes}}
	# A screen's address under its route_prefix is answered by that prefix's page in this name's folder: a copy of the workspace
	# page named for the prefix's one or two segments (workspace-pages.mjs makes each), so /file/<id> gets file.prefix.html and
	# /record/about/<id> gets record.about.prefix.html. A page the path names exactly wins, and a bare prefix (/file, /file/) names
	# no page, so it still answers 404. A prefix deeper than two segments has no rule here and no page. These rules rewrite the
	# path before the program's route is matched, so the first segment of a prefix must not be the first segment of a program's path.
	@prefix_deep {
		path_regexp ^/[^/]+/[^/]+/[^/]
		not file {
			root {{pages_root}}/{site}
			try_files {path} {path}.html {path}/index.html
		}
		file {
			root {{pages_root}}/{site}
			try_files /{http.request.uri.path.0}.{http.request.uri.path.1}.prefix.html
		}
	}
	rewrite @prefix_deep /{http.request.uri.path.0}.{http.request.uri.path.1}.prefix.html
	@prefix_one {
		path_regexp ^/[^/]+/[^/]
		not file {
			root {{pages_root}}/{site}
			try_files {path} {path}.html {path}/index.html
		}
		file {
			root {{pages_root}}/{site}
			try_files /{http.request.uri.path.0}.prefix.html
		}
	}
	rewrite @prefix_one /{http.request.uri.path.0}.prefix.html
	@page {
		method GET HEAD
		file {
			root {{pages_root}}/{site}
			try_files {path} {path}.html {path}/index.html
		}
	}
	@program file {
		root {{programs_root}}
		try_files /{site}/
	}
	handle @page {
		header Cache-Control "public, max-age=300"
		root * {{pages_root}}/{site}
		rewrite @page {file_match.relative}
		file_server
	}
{{site_sockets}}
	handle @program {
		reverse_proxy unix/{{programs_root}}/{site}/http.sock {
			lb_try_duration 15s
			lb_try_interval 250ms
		}
	}
	handle {
		respond "Not found" 404
	}
}
