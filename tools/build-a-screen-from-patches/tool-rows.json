        "id": "tool:make-a-view-patch",
        "listed_on": "2026-11-03T12:00:00Z",
        "label": "Send only what changed in an answer",
        "job": "Turn the next JSON answer a screen will read into just the changes from the answer it already holds, when that is smaller",
        "description": "Give previous and next, each the JSON text of one answer. Returns the next answer as { status, content_type, identity, patch: { from, to, ops } } (ops are RFC 6902 add, remove and replace; from and to are the BLAKE3 identities of the canonical JSON before and after) when the patch is under 0.6 of the whole; otherwise the whole answer with its text (and its identity). An answer under 2000 or over 400000 characters, or one that is not JSON, is answered whole without an identity. Text that is not a string is refused.",
        "input_schema": {
          "type": "object",
          "required": [
            "previous",
            "next"
          ],
          "additionalProperties": false,
          "properties": {
            "previous": {
              "type": "string"
            },
            "next": {
              "type": "string"
            }
          }
        },
        "output_schema": {
          "type": "object",
          "properties": {
            "status": {
              "type": "integer"
            },
            "content_type": {
              "type": "string"
            },
            "identity": {
              "type": "string"
            },
            "text": {
              "type": "string"
            },
            "patch": {
              "type": "object",
              "properties": {
                "from": {
                  "type": "string"
                },
                "to": {
                  "type": "string"
                },
                "ops": {
                  "type": "array"
                }
              }
            }
          }
        },
        "invoke": {
          "kind": "container",
          "files": {
            "package_files": [
              {
                "package": "build-a-screen-from-patches",
                "paths": [
                  "read-data"
                ],
                "at": "/opt/build-a-screen-from-patches"
              },
              {
                "package": "records-door",
                "paths": [
                  "do-work",
                  "read-data"
                ],
                "at": "/opt/records-door"
              },
              {
                "package": "content-identity",
                "paths": [
                  "read-data"
                ],
                "at": "/opt/content-identity"
              },
              {
                "module": "@noble/hashes",
