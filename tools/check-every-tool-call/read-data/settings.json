{
  "what_this_is": "The settings check_switches.py run uses when the session names none (CHECK_LIST_SETTINGS). CHECK_LIST_READER is a JSON argument list naming the person's existing authorized list reader. It receives {type, limit, where?, after?} on stdin and returns {records, next}; the reader opens its own database. This runner reads no key and owns no table layout. Without a reader every tool call says check list unreachable. The check rows (record:check, read with where {kind: check}, kept as checks) are judged by check_rows.judge on each call; only rows whose kinds name the call's unit kind are kept.",
  "rows_from": {
    "command_from": {
      "env": "CHECK_LIST_READER"
    },
    "page": 200,
    "timeout_seconds": 30
  },
  "types": [
    {
      "type": "record:hook-guard",
      "id_prefix": "record:hook-guard:"
    },
    {
      "type": "record:check",
      "id_prefix": "record:check:"
    },
    {
      "type": "record:check",
      "where": {
        "kind": "check"
      },
      "id_prefix": "record:check:",
      "into": "checks"
    }
  ],
  "field": "on",
  "off_value": "Off",
  "detail_fields": [
    "why_off",
    "switched_by",
    "switched_at"
  ],
  "snapshot": {
    "file": "check-switches.json",
    "refresh_seconds": 60
  },
  "honour_off": false,
  "harness": "claude",
  "scope": "every-repository",
  "check_rows": {
    "events": [
      "PreToolUse"
    ],
    "unit_kinds": [
      {
        "kind": "git-commit",
        "acts_on": {
          "tools": "Bash",
          "fields": [
            "command"
          ],
          "matches": "\\bgit\\b[^\\n]*\\bcommit\\b"
        }
      },
      {
        "kind": "git-push",
        "acts_on": {
          "tools": "Bash",
          "fields": [
            "command"
          ],
          "matches": "\\bgit\\b[^\\n]*\\bpush\\b"
        }
      }
    ],
    "otherwise": "tool-call",
    "fixtures_field": "fixtures",
    "judge": [
      "node",
      "{tools}/check-every-tool-call/do-work/judge-check-rows.mjs",
      "hook",
      "--root",
      "{repository}",
      "--kind",
      "{kind}"
    ],
    "timeout_seconds": 120
  }
}
