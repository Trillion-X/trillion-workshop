    "kind": "ai-tool-descriptor",
    "id": "tool:record-a-web-demo",
    "listed_on": "2026-09-29T20:38:25Z",
    "label": "Record a demo of a web page",
    "status": "active",
    "job": "Record a web page as a demo video with a large clear pointer, click ripples and zoom, plus marked screenshots of each step for an article or post",
    "description": "Opens the address in a browser in the cloud and plays your steps on it the way a person would: the pointer travels to each target, clicks, types, scrolls. Returns an MP4 and a GIF with a large drawn pointer, a ripple at every click and the view easing in toward each step, a cover picture at the first click, and one picture per step with its target ringed, an arrow pointing at it and the step's caption. Pauses longer than a second are shortened. Works on any public page, and on a signed-in page when cookies are given; nothing needs installing.",
    "input_schema": {
     "type": "object",
     "required": [
      "url",
      "steps"
     ],
     "additionalProperties": false,
     "properties": {
      "url": {
       "type": "string",
       "format": "uri",
       "description": "The page to open first, like https://gettrillion.ai/"
      },
      "steps": {
       "type": "array",
       "maxItems": 40,
       "description": "What to do on the page, in order. Each step: {\"do\": \"click\" | \"hover\" | \"type\" | \"press\" | \"scroll\" | \"wait\" | \"go\", \"target\": {\"text\": \"visible words\"} or {\"selector\": \"css selector\"}, \"caption\": \"words shown on this step's picture\"}. type needs \"text\" (and a target to click first); press needs \"key\" (Enter, Tab, Escape, arrows or one character); scroll takes \"by\" in pixels (default most of a screen); wait takes \"seconds\"; go takes \"url\". Any step may set \"pause\", the seconds to hold after it (default 0.8), and \"timeout\", the seconds to wait for its target (default 6). A step with \"optional\": true is left out when its target does not show within its timeout (default 2), for a notice or banner that may or may not appear. A step with a target or a caption gets its own picture.",
       "items": {
        "type": "object",
        "required": [
         "do"
        ],
        "properties": {
         "do": {
          "type": "string"
         },
         "target": {
          "type": "object",
          "properties": {
           "text": {
            "type": "string"
           },
           "selector": {
            "type": "string"
           }
          }
         },
         "caption": {
          "type": "string"
         },
         "text": {
          "type": "string"
         },
         "key": {
          "type": "string"
         },
         "by": {
          "type": "number"
         },
         "seconds": {
          "type": "number",
          "minimum": 0,
          "maximum": 20
         },
         "url": {
          "type": "string"
         },
         "pause": {
          "type": "number",
          "minimum": 0,
          "maximum": 10
         },
         "timeout": {
          "type": "number",
          "minimum": 0,
          "maximum": 60
         },
         "optional": {
          "type": "boolean"
         }
        }
       }
      },
      "width": {
       "type": "integer",
       "minimum": 320,
       "maximum": 2560,
       "description": "Page width in pixels, as a browser window (default 1280; 390 for a phone)"
      },
      "height": {
       "type": "integer",
       "minimum": 320,
       "maximum": 1600,
       "description": "Page height in pixels (default 720; 844 for a phone)"
      },
      "output_width": {
       "type": "integer",
       "minimum": 320,
       "maximum": 3840,
       "description": "Video width in pixels; the height follows the page's shape (default 1920)"
      },
      "fps": {
       "type": "integer",
       "minimum": 15,
       "maximum": 60,
       "description": "Video frames per second (default 60)"
      },
      "cursor_size": {
       "type": "integer",
       "minimum": 16,
       "maximum": 200,
       "description": "Pointer height in video pixels (default 72)"
      },
      "zoom": {
       "type": "number",
       "minimum": 1,
       "maximum": 3,
       "description": "How far the view eases in toward each step's target; 1 keeps the whole page in view (default 1.6)"
      },
      "gif_width": {
       "type": "integer",
       "minimum": 200,
       "maximum": 1600,
       "description": "GIF width in pixels (default 800)"
      },
      "cookies": {
       "type": "array",
       "maxItems": 50,
       "description": "Cookies set before the first page opens, so a signed-in page can be recorded: each {\"name\", \"value\", \"url\" (or \"domain\" and \"path\"), \"secure\", \"httpOnly\"}. Use a sign-in that ends after the recording (a disposable account), since the run keeps its input.",
       "items": {
        "type": "object",
        "required": [
         "name",
         "value"
        ],
        "properties": {
         "name": {
          "type": "string"
         },
