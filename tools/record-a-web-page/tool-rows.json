         },
         "httpOnly": {
          "type": "boolean"
         }
        }
       }
      },
      "look": {
       "type": "object",
       "description": "Colours as #rrggbb: accent (ripples, rings, arrows), ink (pointer and caption words), paper (caption card), pointer_edge; and font_file, a font in the container for captions",
       "properties": {
        "accent": {
