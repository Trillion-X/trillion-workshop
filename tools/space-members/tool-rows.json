{
  "kind": "tool-rows",
  "record_set": "space-members-tool-rows",
  "what_this_is": "The Workshop rows for tools/space-members: a person joins a shared space by a join row that holds for them now, leaves it, shows a name in it, and anyone asks whether a person is a member now. Whether a member still counts is worked out on every ask from the space's join rows and what the person holds, never stored.",
  "records": [
    {
      "id": "package::space-members::tool::join-a-space",
      "address": "package::space-members::tool::join-a-space",
      "path": [
        "current-item",
        "published-record"
      ],
      "payload": {
        "kind": "ai-tool-descriptor",
        "id": "tool:join-a-space",
        "label": "Join a space",
        "status": "active",
        "job": "Let a person join a shared space by the way its join rows allow: free, or by holding the access a row names",
        "description": "Reads the space's record:space row and the person's record:space-member row. A person already in is answered with their type and how they came in, and nothing is written. Otherwise the space's config.join rows decide, as data: a row {free:true} lets anyone in, a row {access:\"<ref>\"} lets in a person who holds that access now (worked out by the paid-access reader over your payment events, offers and grants), and a space with no join rows is joined only by invitation (a person gets in by accepting one). A person who left may join again; a person a host put out stays out. The new member gets the type the space's label starts joiners with (or config.joins_as) and may give the name they will show with name. Answers whether they joined, their type and which row let them in; a refusal says how the space is joined, in the space's own words (config.words) or the standard ones.",
        "input_schema": {
          "type": "object",
          "required": [
            "space",
            "subject"
          ],
          "additionalProperties": false,
          "properties": {
            "space": {
              "type": "string",
              "description": "The space's id, the last part of its record:space row id"
            },
            "subject": {
              "type": "string",
              "description": "The person, the way the space and your access rules name them"
            },
            "name": {
              "type": "string",
              "description": "The name other members read for this person in this space (at most 80 characters)"
            }
          }
        },
        "output_schema": {
          "type": "object",
          "required": [
            "space",
            "subject",
            "joined",
            "state"
          ],
          "properties": {
            "space": {
              "type": "string"
            },
            "subject": {
              "type": "string"
            },
            "joined": {
              "type": "boolean"
            },
            "state": {
              "type": "string"
            },
            "member_type": {
              "type": "string"
            },
            "how": {
              "type": "string"
            }
          }
        },
        "invoke": {
          "kind": "container",
          "files": {
            "package_files": [
              {
                "package": "space-members",
                "paths": [
                  "do-work",
                  "read-data"
                ],
