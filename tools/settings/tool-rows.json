{
  "kind": "package-set-records",
  "record_set": "settings-tool-rows",
  "what_this_is": "The one row that reads a tool's settings from the person's list:settings; tools on the person's computer use read-data/read_setting.py on the record it answers.",
  "records": [
    {
      "payload": {
        "kind": "ai-tool-descriptor",
        "id": "tool:read-a-tools-settings",
        "label": "Read one tool's settings from my settings list",
        "job": "Read the settings a tool keeps for me, a film, a piece or my account from my settings list, checked, ready to hand to that tool",
        "status": "active",
        "description": "Give id, the settings row record:setting:<workshop-folder>~<scope_kind>~<scope_id> (scope_kind person, film, piece or account), and optionally tool, the Workshop folder that will use it. Reads that one row from the person's list:settings through their door and answers found, its tool, scope, name, from, status and settings (parsed), plus record: the row exactly as the door read it, to pass as settings_record to a tool that runs on the person's computer. A row of another tool, a retired row, or settings that are not a JSON object are refused with what to fix. Changes nothing.",
        "input_schema": {
          "type": "object",
          "required": [
            "id"
          ],
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^record:setting:[a-z0-9][a-z0-9._-]*~(person|film|piece|account)~[a-z0-9][a-z0-9._-]*$",
              "description": "The settings row: record:setting:<workshop-folder>~<scope_kind>~<scope_id>."
            },
            "tool": {
              "type": "string",
              "description": "The Workshop folder that will use the settings; a row of another folder is refused."
            }
          }
        },
        "output_schema": {
          "type": "object",
          "required": [
            "id",
            "found",
            "record"
          ],
          "properties": {
            "id": {
              "type": "string"
            },
            "found": {
              "type": "boolean"
            },
            "tool": {
              "type": "string"
            },
            "scope_kind": {
              "type": "string"
            },
            "scope_id": {
              "type": "string"
            },
            "name": {
              "type": [
                "string",
                "null"
              ]
            },
            "from": {
              "type": [
                "string",
                "null"
              ]
            },
            "status": {
              "type": [
                "string",
                "null"
              ]
            },
            "settings": {
              "type": "object"
            },
            "record": {
              "type": "object",
              "required": [
                "id",
                "type",
                "value"
              ]
            }
          }
        },
        "invoke": {
          "kind": "container",
          "workdir": "/opt/settings",
          "internet": false,
          "stdout": "json",
          "argv": [
            "node",
            "/opt/records-door/do-work/run-an-export.mjs",
            "/opt/settings/read-data/setting.mjs",
            "read"
          ],
          "stdin": {
            "fill": {
              "from": "input"
            }
          },
          "records": {
            "fd": 3,
            "rights": [
              {
                "kind": "record:setting",
                "id": {
                  "fill": {
                    "from": "input",
                    "field": "id"
                  }
                },
                "operations": [
                  "records:read"
                ]
              }
            ]
          },
          "files": {
            "package_files": [
              {
                "package": "settings",
                "paths": [
                  "read-data"
                ],
                "at": "/opt/settings"
              },
              {
                "package": "records-door",
                "paths": [
                  "do-work",
                  "read-data"
                ],
                "at": "/opt/records-door"
              },
              {
                "package": "content-identity",
                "paths": [
                  "read-data"
                ],
                "at": "/opt/content-identity"
              },
              {
                "module": "@noble/hashes",
                "paths": [
                  "LICENSE",
                  "package.json",
                  "blake3.js",
                  "blake2.js",
                  "_blake.js",
                  "_md.js",
                  "_u64.js",
                  "utils.js"
                ],
                "at": "/opt/node_modules/@noble/hashes"
              }
            ]
          }
        },
        "result_selector": "$.result",
        "verify": [
          {
            "kind": "sample-run",
            "input": {
              "id": "record:setting:sort-a-pantry~person~sample-cook",
              "tool": "sort-a-pantry"
            },
            "records": [
              {
                "id": "record:setting:sort-a-pantry~person~sample-cook",
                "type": "record:setting",
                "value": {
                  "name": "pantry sort",
                  "tool": "sort-a-pantry",
                  "scope_kind": "person",
                  "scope_id": "sample-cook",
                  "settings": "{\"shelves\": 3}",
                  "from": "tools/pantry/settings.json@0000000",
                  "status": "active"
                }
              }
            ]
          }
        ],
        "maker": "maker:trillion",
        "licence_class": "licence:maker-own",
        "placements": [
          "placement:small-container"
        ],
        "provenance": {
          "source": "Ported from old trillion's setting record kind (src/decision-store.mjs before 4ffa1dc4a2, lines 8 and 751-754: setting(name) answers the value or nothing) to one row per tool and scope in the person's list:settings"
        }
      }
    }
  ]
}
