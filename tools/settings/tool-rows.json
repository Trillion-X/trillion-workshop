        "kind": "ai-tool-descriptor",
        "id": "tool:read-a-tool-setting",
        "label": "Read the settings a person keeps for a tool, for one person, film, piece or their whole account (runs on your computer)",
        "job": "Read the settings a person keeps for one of their tools, choosing the row for this piece, else this film, else this person, else their whole account, or make the settings row to write",
        "description": "A tool's settings are rows of the person's settings table (owner-places role settings) (record:setting:<workshop-folder>~<scope_kind>~<scope_id>; fields name, tool, scope_kind, scope_id, settings as JSON, from, status). read: give the records your AI read from the person's own store (or the path of the file holding them), the tool's folder and the scopes to try, most specific first; the answer is the settings of the first scope that has an active row, or the default given when none does. A row id given as settings_record is looked up in the rows handed in stored.records; with settings_record left out, the setting rows in stored.records are read. make: give the folder, scope, settings, name, tool and where the values came from, and the current rows in stored.records when they exist; the answer is keep: the row your AI keeps in the person's own store, with the the settings table row when asked, each with expected (the row as handed, or null when it was not there), so the store refuses a write made from a stale read. The same reader is a library for Python (read-data/settings.py) and JavaScript (read-data/settings.mjs) tools.",
        "status": "active",
        "input_schema": {
          "type": "object",
          "properties": {
            "settings_record": {
              "description": "A record:setting as the person's own store gives it, its value, a list of them, the path of a JSON file holding them, or a row id found in stored.records."
            },
            "stored": {
              "type": "object",
              "description": "{records: [{id, type, value}]}: the rows your AI read from the person's own store. A row id in settings_record is looked up here; for make, the rows as they are now, so each kept row says what it expected."
            },
            "folder": {
              "type": "string",
              "description": "The Workshop folder whose settings to read, e.g. make-a-frame-contact-sheet-of-a-video-section."
            },
            "scopes": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "kind": {
                    "enum": [
                      "piece",
                      "film",
                      "person",
                      "account"
                    ]
                  },
                  "id": {
                    "type": "string"
                  }
                },
                "required": [
                  "kind",
                  "id"
                ]
              },
              "description": "Most specific first."
            },
            "default": {
              "description": "What to answer when no row matches."
            },
            "tool": {
              "type": "string",
              "description": "Refuse a row written for another tool."
            },
            "make": {
              "type": "object",
              "description": "{folder, scope_kind, scope_id, settings, name, tool, from, status?}: make the row instead of reading one."
            }
          }
        },
        "output_schema": {
          "type": "object",
          "description": "The last line printed: {\"result\": {found, id, settings}} for read, {\"result\": {keep}} for make, each kept row with expected; {\"error\": ...} with exit 2 when the request cannot be read."
        },
        "invoke": {
          "kind": "on-your-computer",
          "repository": "https://github.com/Trillion-X/trillion-workshop",
          "get_it": [
            "git clone https://github.com/Trillion-X/trillion-workshop.git"
          ],
          "run": "python3 -I trillion-workshop/tools/settings/do-work/read_setting.py < {input}",
          "needs": [
            "python"
          ],
          "say": "Read the person's settings table (owner-places role settings) rows for the tool from the person's own store (the rows of the settings table, or the row record:setting:<folder>~<scope_kind>~<scope_id>), and hand them in as stored.records (or write them to a file and pass that file as settings_record) with the folder and the scopes to try. A tool that takes settings_record in its own request reads it with read-data/settings.py or read-data/settings.mjs itself."
        },
        "maker": "maker:settings",
        "licence_class": "licence:maker-own",
        "placements": [
          "placement:your-computer"
        ],
        "provenance": {
          "source": "Ported from old Trillion's setting record kind: Trillion-X/trillion src/decision-store.mjs before 4ffa1dc4a2, lines 8 and 751-754 (setting(name) gives the value or null; setSetting writes { id: setting:<name>, type: setting })."
        }
      }
    }
  ]
