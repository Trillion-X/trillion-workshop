    {
      "payload": {
        "kind": "ai-tool-descriptor",
        "id": "tool:read-price-bars-from-my-market-data-account",
        "label": "Read price bars from my market-data account",
        "job": "Read recent price bars (open, high, low, close, volume) and the latest price for symbols from my own market-data account",
        "description": "Give feed (how your market-data account is read: url, its default query and the query names it allows, where each held field goes as credential_injections, where the bars are as bars_at, and what each bar field is called as fields with at least timestamp and close) and query (such as the symbols and the bar size, by the feed's own names). Answers bars (symbol, timestamp in milliseconds, open, high, low, close, volume), latest (each symbol's newest close, ready as the prices a trading policy's market orders need) and status (live or error with the HTTP status). An error answer carries no bars, never invented ones. The held market-data-credentials (a JSON object of named fields) reach only the request and are never shown.",
        "status": "active",
        "input_schema": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "feed": { "type": "object", "description": "{ url, query?, query_names?, headers?, credential_injections: [{ field, placement: { kind: header or query, name, prefix? } }], bars_at?, fields: { timestamp, close, open?, high?, low?, volume?, symbol? }, timeout_seconds? }" },
            "query": { "type": "object", "description": "The request's query by the feed's names, on top of the feed's defaults" }
          }
        },
        "output_schema": {
          "type": "object",
          "required": ["bars", "latest", "status"],
          "properties": {
            "bars": { "type": "array", "items": { "type": "object" } },
            "latest": { "type": "object" },
            "status": {
              "type": "object",
              "required": ["state", "bar_count"],
              "properties": {
                "state": { "type": "string" },
                "bar_count": { "type": "integer" },
                "http_status": {},
                "fetched_at": { "type": "string" },
                "note": { "type": "string" }
              }
            }
          }
        },
        "invoke": {
          "kind": "container",
          "internet": true,
          "workdir": "/opt/live-market-prices",
          "stdout": "json",
          "argv": ["python3", "/opt/live-market-prices/do-work/read-market-prices.py", "bars"],
          "stdin": { "fill": { "from": "input" } },
          "files": {
            "package_files": { "package": "live-market-prices", "paths": ["do-work", "sources"], "at": "/opt/live-market-prices" }
          },
          "credential_mounts": [{ "secret_name": "market-data-credentials", "fd": 3 }]
        },
        "result_selector": "$",
        "needs": { "expected_seconds": 15, "network_egress": true, "memory_mb": 256 },
        "maker": "maker:live-market-prices",
        "licence_class": "licence:maker-own",
        "placements": ["placement:your-computer"],
        "provenance": { "source": "bitfield-packages packages/market-data-feed (the pull-market-bars request and bar normalizer), ported" },
