        "kind": "ai-tool-descriptor",
        "id": "tool:list-public-prediction-markets",
        "label": "List public prediction markets",
        "job": "See which prediction markets are open right now, what each asks, its outcomes, their prices and its trading volume",
        "description": "Reads the public prediction-market list (no account, no key) and gives each market's question, outcomes, outcome prices (the market's own odds), outcome token ids, volume, liquidity, whether it is open and when it ends. The busiest markets come first. Give limit (1 to 100, default 20). The answer's status says live or error with the HTTP status; an error returns no markets and never invented ones. Use a market's token id with tool:read-prediction-market-order-book.",
        "status": "active",
        "input_schema": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "limit": { "type": "integer", "minimum": 1, "maximum": 100, "description": "How many markets to read (default 20)" }
          }
        },
        "output_schema": {
          "type": "object",
          "required": ["markets", "status"],
          "properties": {
            "markets": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {},
                  "question": {},
                  "slug": {},
                  "condition_id": {},
                  "outcomes": { "type": "array" },
                  "outcome_prices": { "type": "array" },
                  "token_ids": { "type": "array" },
                  "volume": {},
                  "liquidity": {},
                  "active": {},
                  "closed": {},
                  "accepting_orders": {},
                  "end_date": {},
                  "start_date": {},
                  "min_tick_size": {},
                  "min_order_size": {},
                  "image": {}
                }
              }
            },
            "status": {
              "type": "object",
              "required": ["state", "market_count"],
              "properties": {
                "state": { "type": "string" },
                "market_count": { "type": "integer" },
                "http_status": {},
                "fetched_at": { "type": "string" },
                "note": { "type": "string" }
              }
            }
          }
        },
        "invoke": {
          "kind": "container",
          "internet": true,
          "workdir": "/opt/live-market-prices",
          "stdout": "json",
          "argv": ["python3", "/opt/live-market-prices/do-work/read-market-prices.py", "markets"],
          "stdin": { "fill": { "from": "input" } },
          "files": {
            "package_files": { "package": "live-market-prices", "paths": ["do-work", "sources"], "at": "/opt/live-market-prices" }
