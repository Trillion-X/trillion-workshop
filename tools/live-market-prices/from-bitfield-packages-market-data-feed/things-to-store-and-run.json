            "id": "normalize_bars",
            "kind": "ask",
            "config": {
              "name": "compute.process",
              "input": {
                "argv": [
                  "python3",
                  "-c",
                  "import json\nout='bars-normalized.json'\ntry: resp=json.loads(open('http-response.json').read())\nexcept Exception: resp={}\nbody=resp.get('body') if isinstance(resp,dict) else None\nif isinstance(body,list):\n    try: body=bytes(body).decode('utf-8')\n    except Exception: body=None\nif isinstance(body,str):\n    try: body=json.loads(body)\n    except Exception: body=None\ndata=body if body is not None else resp\nbars=[]\ndef add(sym,b):\n    if not isinstance(b,dict): return\n    ts=b.get('t') if 't' in b else b.get('timestamp')\n    if isinstance(ts,str):\n        try: ts=int(__import__('datetime').datetime.fromisoformat(ts.replace('Z','+00:00')).timestamp()*1000)\n        except Exception: pass\n    bars.append({'symbol':sym or b.get('S') or b.get('symbol'),'timestamp':ts,'open':b.get('o') if 'o' in b else b.get('open'),'high':b.get('h') if 'h' in b else b.get('high'),'low':b.get('l') if 'l' in b else b.get('low'),'close':b.get('c') if 'c' in b else b.get('close'),'volume':b.get('v') if 'v' in b else b.get('volume')})\nnode=data.get('bars') if isinstance(data,dict) else data\nif isinstance(node,dict):\n    for sym,arr in node.items():\n        for b in (arr or []): add(sym,b)\nelif isinstance(node,list):\n    for b in node: add(None,b)\nsc=resp.get('status_code') if isinstance(resp,dict) else None\nstatus={'state':'live' if bars else 'error','bar_count':len(bars),'http_status':sc,'fetched_at':__import__('datetime').datetime.now(__import__('datetime').timezone.utc).isoformat()}\njson.dump({'bars':bars,'status':status},open(out,'w'))\nprint(json.dumps({'bars':bars,'status':status}))"
