      "payload": {
        "kind": "ai-tool-descriptor",
        "id": "tool:read-setup",
        "label": "Read my setup",
        "status": "active",
        "job": "Gather what my account's setup is made of and draw the Get started screen from it",
        "description": "The one read of the Get started screen (tool:get-started). It asks the account files door for this account's setup facts (setup_facts: sign-ins and their app grants, notification devices, the AI connection, computers, the setup runtime, device releases, the last setup snapshot) for the asking browser, reads the account's own show rules (show-rules) and setup context (setup-context), and runs tool:see-what-is-left-to-set-up with them and the page's account id, answering the screen it draws. A source it could not read is left unknown, so the screen is not ready rather than opened on a guess. It writes nothing.",
        "input_schema": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "account_id"
          ],
          "properties": {
            "account_id": {
              "type": "string",
              "description": "The page's own account"
            },
            "user_agent": {
              "type": "string",
              "description": "The asking browser's user agent"
            },
            "origin": {
              "type": "string",
              "description": "The address the screen is opened at; the service's own when it is not a web address"
            },
            "now": {
              "type": "string",
              "description": "The time to decide at (ISO); now when left out"
            }
          }
        },
        "output_schema": {
          "type": "object",
          "required": [
            "title",
            "ready",
            "requirements"
          ],
          "properties": {
            "title": {
              "type": "string"
            },
            "ready": {
              "type": "boolean"
            },
            "requirements": {
              "type": "array"
            }
          }
        },
        "result_selector": "$.result",
        "invoke": {
          "kind": "container",
          "files": {
