  "words": { "turn_back_on": "Show again: {label}", "nothing_yet": "Nothing is silenced or hidden. Use the bell on any notice, tour or layout, or add a rule here.", "add": "Add a rule", "heading": "When things show", "always": "Always", "until": "Until {time}", "starting": "Everyone starts with this", "given": "Set for you: {from}", "profiles": "Profiles you keep" },
  "sharing": { "_what": "Sharing a kept preset with people (src/workspace/show-rules-admin-screen.tsx): the preset is copied whole, with the presets it inherits, into its own workspace record labelled record_prefix + <preset id> = { label, types }, and src/record-sharing.json door_grant keeps who may read that record. The people a preset is shared with are its group; one person is one account. `words` are the screen's.", "record_prefix": "show-types-shared:", "words": { "heading": "Account visibility", "about": "Choose one of the presets you keep and share it with the people who should see Trillion that way.", "loading": "Loading your presets", "failed": "Your presets could not be read", "preset": "Preset", "none": "You keep no presets yet. Keep one in Settings, under Profiles you keep, then share it here.", "preview": "What they get", "rules": "Rules", "inherits": "Includes", "invite": "Share", "placeholder": "Person or account", "access": "Shared with", "remove": "Stop sharing", "added": "Shared with {principal}. Copy their share key now; it is not shown again.", "copy": "Copy share key", "copied": "Share key copied for {principal}", "share_failed": "The preset could not be shared", "already": "Already shared with {principal}" } },
