        "kind": "ai-tool-descriptor",
        "id": "tool:read-setup",
        "label": "Read my setup",
        "status": "active",
        "job": "Gather what my account's setup is made of and draw the Get started screen from it",
        "description": "The one read of the Get started screen (tool:get-started). It is handed this account's setup facts as setup_facts (sign-ins and their app grants, notification devices, the AI connection, computers, the setup runtime, device releases, the last setup snapshot: what the caller can read of them, since no one owner answers them now), is handed the account's own show rules (show-rules) and setup context (setup-context) as the caller read them from the person's own store, in stored.workspace, and draws the screen with tool:see-what-is-left-to-set-up's own function from them and the page's account id, in the same run. The setup run is handed in as setup_run (the status tool:run-workflow-definition answered and the answers so far), since no tool keeps a run. A source it could not read is left unknown, so the screen is not ready rather than opened on a guess. It writes nothing.",
        "input_schema": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "account_id",
            "origin"
          ],
          "properties": {
            "account_id": {
              "type": "string",
              "description": "The page's own account"
            },
            "user_agent": {
              "type": "string",
              "description": "The asking browser's user agent"
            },
            "origin": {
              "type": "string",
              "description": "The address the screen is opened at (a web address, https://...)"
            },
            "now": {
              "type": "string",
              "description": "The time to decide at (ISO); now when left out"
            },
            "setup_run": {
              "type": "object",
              "required": ["status"],
              "properties": {
                "status": { "type": "string", "description": "The status tool:run-workflow-definition answered for the setup recipe's run: paused, completed or failed" },
                "answers": { "type": "object", "description": "The answers given so far, by step id" }
              },
              "description": "The setup run, as the caller keeps it in the person's own database; left out, the setup was never started"
            },
            "setup_facts": {
              "type": "object",
              "description": "What the caller can read of the account's setup: { facts?, signed_in?: { names }, system?, shared_rules?, context?, setup_access?, installs? }. What is left out is unknown, never none, so the screen is not ready rather than opened on a guess."
            },
            "stored": {
              "type": "object",
              "description": "The person's own settings, read by the caller from where the person keeps them and handed in: { workspace: { label: value } } for show-rules and setup-context. A label handed in as null is read and not there; a label left out could not be read and is unknown, never none. The run reads and writes no store.",
              "additionalProperties": false,
              "properties": {
                "workspace": {
                  "type": "object"
                }
              }
            }
          }
        },
        "output_schema": {
          "type": "object",
          "required": [
            "title",
            "ready",
            "requirements"
          ],
          "properties": {
            "title": {
              "type": "string"
            },
            "ready": {
              "type": "boolean"
            },
            "requirements": {
              "type": "array"
            }
          }
        },
        "result_selector": "$.result",
        "invoke": {
          "kind": "container",
          "files": {
            "package_files": [
