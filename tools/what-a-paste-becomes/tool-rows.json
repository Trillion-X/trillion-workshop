{
 "kind": "tool-rows",
 "record_set": "what-a-paste-becomes-tool-rows",
 "what_this_is": "The Workshop row for tools/what-a-paste-becomes: what a paste into a composer becomes (insert, a named text attachment, or attached images).",
 "records": [
  {
   "id": "package::what-a-paste-becomes::tool::decide-what-a-paste-becomes",
   "address": "package::what-a-paste-becomes::tool::decide-what-a-paste-becomes",
   "path": ["current-item", "published-record"],
   "payload": {
    "kind": "ai-tool-descriptor",
    "id": "tool:decide-what-a-paste-becomes",
    "label": "Decide what a paste becomes",
    "status": "active",
    "job": "Decide what a paste into a message or note becomes: a normal insert for short text, a named text file for a long paste, or attached images when the clipboard's markup has no words of its own, with the words the person reads beside the attachment",
    "description": "Give clipboard ({ text, html, files: [{ type, name }] }) and, optionally, now (an ISO time for the attachment's name). Returns action insert, attach_text (name, text, media_type, said) or attach_images (files, said). Text over 5,000 characters becomes a file; an image attaches only when the markup carries no text of its own (style and script bodies are not words).",
    "input_schema": {
     "type": "object",
     "required": ["clipboard"],
     "additionalProperties": false,
     "properties": {
      "clipboard": {
       "type": "object",
       "properties": {
        "text": { "type": "string" },
        "html": { "type": "string" },
        "files": { "type": "array", "items": { "type": "object", "properties": { "type": { "type": "string" }, "name": { "type": "string" } } } }
       }
      },
      "now": { "type": "string", "description": "ISO time the attachment's name is stamped with; the run's time when left out" }
     }
    },
    "output_schema": {
     "type": "object",
     "required": ["action"],
     "properties": {
      "action": { "type": "string", "enum": ["insert", "attach_text", "attach_images"] },
      "name": { "type": "string" },
      "text": { "type": "string" },
      "media_type": { "type": "string" },
      "files": { "type": "array" },
      "said": { "type": "string" }
     }
    },
    "invoke": {
     "kind": "container",
     "files": { "package_files": [ { "package": "what-a-paste-becomes", "paths": ["read-data"], "at": "/opt/what-a-paste-becomes" } ] },
     "workdir": "/opt/what-a-paste-becomes",
     "internet": false,
     "stdout": "json",
     "argv": ["node", "read-data/paste-policy.mjs"],
     "stdin": { "fill": { "from": "input" } }
    },
    "result_selector": "$.result",
    "needs": { "expected_seconds": 2, "network_egress": false, "memory_mb": 128 },
    "licence_class": "licence:maker-own",
    "placements": ["placement:small-container"],
    "maker": "maker:what-a-paste-becomes",
    "provenance": { "source": "moved from Trillion-X/trillion parts/chat/read-data/paste-policy.mjs and paste-policy.json, with its tests" },
    "verify": [
     {
      "kind": "sample-run",
      "input": { "clipboard": { "text": "" }, "now": "2026-10-19T09:05:07Z" },
      "output_selector": "$.name",
      "contains": "Pasted text 2026-10-19-09-05-07.txt"
     }
    ]
   }
  }
 ]
}
