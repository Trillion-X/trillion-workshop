        "maker": "maker:copy-a-file-into-a-storage-place",
        "id": "tool:copy-a-file-into-a-storage-place",
        "label": "Copy a file into a storage place",
        "job": "Copy one of the person's files, any size, into a folder of a storage place they were given, or say plainly that they may not add files there",
        "description": "Asks the storage place whether the person's account may add a file to the folder; when it may not, answers that in words with the folder's name and copies nothing. Otherwise opens one resumable upload with the account's connection and sends the file to it one piece at a time, each piece read by byte range from the file's address (a share link of the person's files), so memory holds one piece whatever the file's size. The places are DATA (read-data/storage-places.json: Google Drive and OneDrive today; a new kind is an entry). The account's key arrives on descriptor 4 and goes only to the place's own host, or to Composio when the account was connected there; the upload's own address is never answered.",
        "input_schema": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "from",
            "to",
            "via"
          ],
          "properties": {
            "from": {
              "type": "object",
              "required": [
                "url",
                "byte_length"
              ],
              "additionalProperties": false,
              "description": "The file to copy: an https address that answers byte ranges (a share link of the person's files) and its size",
              "properties": {
                "url": {
                  "type": "string"
                },
                "byte_length": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            },
            "to": {
              "type": "object",
              "required": [
                "place",
                "folder",
                "name"
              ],
              "additionalProperties": false,
              "description": "Where: the kind of place (a key of read-data/storage-places.json), the folder's id there, the new file's name and type",
              "properties": {
                "place": {
                  "type": "string"
                },
                "folder": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "media_type": {
                  "type": "string"
                }
              }
            },
            "via": {
              "type": "string",
              "description": "How the account was connected: google-account, microsoft-account (its own token) or composio"
            },
            "account": {
              "type": "string",
              "description": "With via composio: the connected account's id"
            },
            "connection": {
              "type": "object",
              "description": "With via google-account or microsoft-account: the account's handle (connection_id), as the person's connections list it",
              "additionalProperties": true,
              "properties": {
                "connection_id": {
                  "type": "string"
                }
              }
            },
            "piece_bytes": {
              "type": "integer",
              "description": "How many bytes one piece holds (rounded down to the place's unit); 8 MiB when absent"
            }
          }
        },
        "output_schema": {
          "type": "object",
          "required": [
            "copied",
            "said"
          ],
          "properties": {
            "copied": {
              "type": "boolean"
            },
            "said": {
              "type": "string"
            },
            "folder": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "id": {
              "type": [
                "string",
                "null"
              ]
            },
            "byte_length": {
              "type": "integer"
            },
            "pieces": {
              "type": "integer"
            }
          }
        },
        "invoke": {
          "kind": "container",
          "workdir": "/opt/copy-a-file-into-a-storage-place",
          "internet": true,
          "stdout": "json",
          "argv": [
            "node",
            "/opt/workflows/do-work/run-a-function.mjs",
            "/opt/copy-a-file-into-a-storage-place/do-work/copy-a-file-into-a-storage-place.mjs",
            "copyAFileIntoAStoragePlace"
          ],
          "stdin": {
            "fill": {
              "from": "input"
            }
          },
          "credential_mounts": [
            {
              "field_id": "access_token",
              "fd": 4
            }
          ],
          "by_input": {
            "input": "via",
            "variants": {
              "google-account": {
                "connection": {
                  "vendor": "google-account",
                  "from_input": "connection"
                },
                "refresh": {
                  "token_url": "https://oauth2.googleapis.com/token",
                  "asked": {
                    "method": "POST",
                    "grant_type": "refresh_token",
                    "token_param": "refresh_token"
                  },
                  "client_auth": "form",
                  "client": {
                    "id": {
                      "name": "google-sign-in-client-id"
                    },
                    "secret": {
                      "name": "google-sign-in-client-secret"
                    }
                  },
                  "access_field": "access_token",
                  "token_paths": [
                    [
                      "access_token"
                    ]
                  ],
                  "expires_path": [
                    "expires_in"
                  ],
                  "refresh": {
                    "field": "refresh_token",
                    "token_paths": [
                      [
                        "refresh_token"
                      ]
                    ]
                  },
                  "when_expiry_unknown": true
                }
              },
              "microsoft-account": {
                "connection": {
                  "vendor": "microsoft-account",
                  "from_input": "connection"
                },
                "refresh": {
                  "token_url": "https://login.microsoftonline.com/common/oauth2/v2.0/token",
                  "asked": {
                    "method": "POST",
                    "grant_type": "refresh_token",
                    "token_param": "refresh_token"
                  },
                  "client_auth": "form",
                  "client": {
                    "id": {
                      "name": "microsoft-sign-in-client-id"
                    },
                    "secret": {
                      "name": "microsoft-sign-in-client-secret"
                    }
                  },
                  "access_field": "access_token",
                  "token_paths": [
                    [
                      "access_token"
                    ]
                  ],
                  "expires_path": [
                    "expires_in"
                  ],
                  "refresh": {
                    "field": "refresh_token",
                    "token_paths": [
                      [
                        "refresh_token"
                      ]
                    ]
                  },
                  "when_expiry_unknown": true
                }
              },
              "composio": {
                "connection": null,
                "credential_mounts": [
                  {
                    "secret_name": "composio-api-key",
                    "fd": 4
                  }
                ]
              }
            }
          },
          "files": {
            "package_files": [
              {
                "package": "copy-a-file-into-a-storage-place",
                "paths": [
                  "do-work",
                  "read-data"
                ],
