              },
              {
                "package": "workflows",
                "paths": [
                  "do-work/run-a-function.mjs"
                ],
                "at": "/opt/workflows"
              }
            ]
          }
        },
        "needs": {
          "expected_seconds": 600,
          "network_egress": true
        },
        "placements": [
          "placement:small-container"
        ],
        "result_selector": "$",
        "provenance": {
          "source": "Made for share-anything (Nov 19 2026): the resumable-session copy proven live into a Google Drive folder (md5 equal) and the refusal read for a folder whose owner gave no right to add"
        }
