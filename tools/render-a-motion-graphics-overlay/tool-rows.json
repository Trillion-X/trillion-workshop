        "kind": "ai-tool-descriptor",
        "id": "tool:render-an-overlay-insert-for-a-cut",
        "status": "active",
        "label": "Render a correction insert for a film cut: its overlay, the voice and music stems, freeze plates and a preview in context",
        "job": "Make everything I need to cut a narrated correction into my film: the overlay, the narrator voice and the music and sound stem lined up with it, freeze frames from the camera clip and from my graded export, and a preview with a few seconds of my cut before and after, after checking its claims",
        "description": "For each shot (a spec with plate {source, frame}, graded_frame {export, cut_frame}, cut_insert_s and optional preview_before_end_s / preview_after_start_s), first runs tool:check-every-claim-against-its-facts-and-sources on it and refuses a shot whose claims fail; then writes into out/<shot id>/: <id>-overlay-prores4444.mov (ProRes 4444 with alpha), <id>-narrator.wav (the voice padded so 0 s is the overlay's first frame), <id>-sfx-music.wav (the music bed from the look's recipe.sound.music and every placed sound effect, same alignment), <id>-plate-slog3-prores422hq.mov (the camera frame held, ungraded), <id>-plate-graded-prores422hq.mov (the same moment from the graded export, held, to sit above the editor's adjustment layer), <id>-preview.mp4 (3 s of the graded export, the insert, 3 s after) and <id>-timeline.json. mode quick writes only the two stems and a 540p preview with the overlay piped in; audio_only re-renders the stems and preview against the existing overlay; stills writes frames over the shot's cut-out picture. A shot without duration_s lasts until its exit's light leak and its last word are done. specs renders a batch one after another under one lock; copy_previews_to copies each preview into a picker folder under a given name. The look is the person's look row (as for tool:render-a-motion-graphics-overlay); its insert section can give claim_check and preview_encoder.",
        "input_schema": {
          "type": "object",
          "required": [
            "assets",
            "out"
          ],
          "properties": {
            "settings_record": {
              "type": "object",
              "description": "The person's look row of list:settings as { id, type, value } (id record:setting:render-a-motion-graphics-overlay~<scope_kind>~<scope_id>, usually ~film~<film>), as your AI read it from your list; the tool reads no store"
            },
            "settings": {
              "type": "object",
              "description": "The look, or changes laid over the row's: recipe, look, look3, frame, faces, sound_layers and named sections"
            },
            "settings_files": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "JSON files of a look kept on this computer, laid under settings in order"
            },
            "spec": {
              "type": "object",
              "required": [
                "id",
                "events"
              ],
              "description": "One shot: a spec (id, events, voice {wav, words, start_s}, cutout?, canvas?, duration_s?) with plate {source, frame}, graded_frame {export, cut_frame}, cut_insert_s, preview_before_end_s?, preview_after_start_s? (null: the film ends with the insert)"
            },
            "assets": {
              "type": "string",
              "description": "The folder the look's relative file names (faces, textures, recordings) are read from"
            },
            "root": {
              "type": "string",
              "description": "The folder a spec's relative file names (voice, clips, pictures, mattes) are read from; default assets"
            },
            "out": {
              "type": "string",
              "description": "The folder the overlay, sound, timeline and the render's scratch are written to"
            },
            "stills": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "description": "Seconds: write those frames over each shot's cut-out picture (cutout.image) instead of the videos"
            },
            "lock": {
              "type": "object",
              "properties": {
                "file": {
                  "type": "string"
                },
                "wait_while": {
                  "type": "object"
                }
              },
              "required": [
                "file"
              ],
              "description": "One render at a time on this computer: an exclusive lock on this file, held for the whole batch, at the lowest CPU priority; wait_while {file, says, poll_s, max_s} waits first while a flag file says so"
            },
            "specs": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "id",
                  "events"
                ]
              },
              "description": "A batch of shots, rendered one after another under one lock, each into out/<shot id>/"
            },
            "mode": {
              "enum": [
                "full",
                "quick",
                "audio_only"
              ],
              "description": "full (default): overlay, stems, plates, preview; quick: the stems and a 540p preview with the overlay piped in; audio_only: the stems and preview against the overlay a full render wrote"
            },
            "preview_encoder": {
              "type": "string",
              "description": "The H.264 encoder of this computer for the preview: h264_videotoolbox on a Mac (the default), libx264 elsewhere; else the look's insert.preview_encoder"
            },
            "claim_check": {
              "type": "object",
              "description": "tool:check-every-claim-against-its-facts-and-sources's request without shots (lane_dir, sources, frames_root, world_dir, hedge_phrases, settings_record, the claim check's settings row itself as { id, type, value }), or {\"skip\": \"<why the shot makes no claim>\"}; default the look's insert.claim_check"
            },
            "copy_previews_to": {
              "type": "object",
              "required": [
                "folder"
              ],
              "properties": {
                "folder": {
                  "type": "string"
                },
                "names": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  }
                }
              },
              "description": "A picker folder each preview is also copied to, as <names[shot id] or shot id>.mp4"
            }
          }
        },
        "output_schema": {
          "type": "object",
          "required": [
            "inserts"
          ],
          "properties": {
            "inserts": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "id",
                  "frames",
                  "duration_s",
                  "timeline",
                  "claim_check"
                ],
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "frames": {
                    "type": "integer"
                  },
                  "duration_s": {
                    "type": "number"
                  },
                  "timeline": {
                    "type": "string"
                  },
                  "claim_check": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "overlay": {
                    "type": "string"
                  },
                  "narrator": {
                    "type": "string"
                  },
                  "sfx_music": {
                    "type": "string"
                  },
                  "plate": {
                    "type": "string"
                  },
                  "plate_graded": {
                    "type": "string"
                  },
                  "preview": {
                    "type": "string"
                  },
                  "copied_to": {
                    "type": "string"
                  },
                  "stills": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        "invoke": {
          "kind": "container",
          "files": {
            "package_files": [
              {
                "package": "render-a-motion-graphics-overlay",
