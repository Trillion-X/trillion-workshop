        "kind": "ai-tool-descriptor",
        "id": "tool:render-a-motion-graphics-overlay",
        "status": "active",
        "label": "Draw a motion-graphics overlay for a video from a timed list of paper cut-outs, type, cards, charts and marks",
        "job": "Draw the animated graphics that go over a piece of my video (paper cut-outs, typed words, cards, charts, marker marks) as a see-through overlay with its sound, from a list of what appears when",
        "description": "Draws one spec, a list of timed events ({type, at, ...}: torn paper strips and cards, typed and kinetic words, count-ups, charts and labels, marker circles and underlines, cut-out photos, footage insets, endcards and many more, one module per event type in do-work/overlay/events/), into overlay.mov (ProRes 4444 with alpha), its sound stem sound.wav (every placed sound, plus the voice when the spec mixes one; sfx-only.wav then holds the sounds alone) and timeline.json (every element, sound and placed box with its time), or, with stills, single frames over the spec's still background. The look (colours, faces, paper textures, motion, sound table, title-safe margin) is the person's settings: a row of their list:settings named by settings_record, or settings, or settings_files. The spec is the request's spec (a piece row's settings.spec, which your AI reads from your list). Times are seconds from the overlay's first frame, or [word, offset] against the voice's word times. A render stops, saying where, when an element leaves the title-safe area or the last frame still shows something. The crumple exit needs Blender; a citation card read by OCR needs tesseract.",
        "input_schema": {
          "type": "object",
          "required": [
            "assets",
            "out"
          ],
          "properties": {
            "settings_record": {
              "type": "object",
              "description": "The person's look row of list:settings as { id, type, value } (id record:setting:render-a-motion-graphics-overlay~<scope_kind>~<scope_id>, usually ~film~<film>), as your AI read it from your list; the tool reads no store"
            },
            "settings": {
              "type": "object",
              "description": "The look, or changes laid over the row's: recipe, look, look3, frame, faces, sound_layers and named sections"
            },
            "settings_files": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "JSON files of a look kept on this computer, laid under settings in order"
            },
            "spec": {
              "type": "object",
              "required": [
                "id",
                "duration_s",
                "events"
              ],
              "description": "The spec: id, duration_s, events [{type, at, ...}], and optionally voice {wav, words, start_s}, canvas [w, h], still_bg, still_format, qscale, sound_trim_db, subtitles"
            },
            "assets": {
              "type": "string",
              "description": "The folder the look's relative file names (faces, textures, recordings) are read from"
            },
            "root": {
              "type": "string",
              "description": "The folder a spec's relative file names (voice, clips, pictures, mattes) are read from; default assets"
            },
            "out": {
              "type": "string",
              "description": "The folder the overlay, sound, timeline and the render's scratch are written to"
            },
            "stills": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "description": "Seconds: write those frames over the spec's still_bg instead of the video"
            },
            "lock": {
              "type": "object",
              "properties": {
                "file": {
                  "type": "string"
                },
                "wait_while": {
                  "type": "object"
                }
              },
              "required": [
                "file"
              ],
              "description": "One render at a time on this computer: an exclusive lock on this file"
            }
          }
        },
        "output_schema": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "frames": {
              "type": "integer"
            },
            "duration_s": {
              "type": "number"
            },
            "overlay": {
              "type": "string"
            },
            "sound": {
              "type": "string"
            },
            "sfx_only": {
              "type": "string"
            },
            "timeline": {
              "type": "string"
            },
            "stills": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "id"
          ]
        },
        "invoke": {
          "kind": "container",
          "files": {
            "package_files": [
              {
                "package": "render-a-motion-graphics-overlay",
                "paths": [
                  "do-work",
                  "read-data"
                ],
                "at": "/opt/render-a-motion-graphics-overlay",
                "exclude": [
                  "__pycache__"
                ]
              },
              {
                "package": "settings",
                "paths": [
                  "read-data"
                ],
                "at": "/opt/settings"
              },
              {
                "package": "content-identity",
                "paths": [
                  "read-data"
                ],
                "at": "/opt/content-identity"
              },
              {
                "packages": [
                  "node_modules/@noble/hashes"
                ],
                "paths": [
                  "LICENSE",
