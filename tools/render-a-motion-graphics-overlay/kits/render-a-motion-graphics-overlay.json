  "instructions": [
    "1. Say to your AI: \"Run tool:render-a-motion-graphics-overlay\", and give it assets, out.",
    "2. The AI calls run_resource_operation at @workshop-tools with method tools:run, tool tool:render-a-motion-graphics-overlay and its input (the worked example shows one).",
    "3. Read what comes back: An answer with the fields id, frames, duration_s, overlay, sound, sfx_only, timeline, stills."
  ],
  "worked_examples": [
    {
      "title": "Draw a motion-graphics overlay for a video from a timed list of paper cut-outs, type, cards, charts and marks on a sample input",
      "ask": "Run tool:render-a-motion-graphics-overlay.",
      "mcp": {
        "server": "trillion",
        "tool": "run_resource_operation",
        "input": {
          "address": "@workshop-tools",
          "method": "tools:run",
          "input": {
            "tool": "tool:render-a-motion-graphics-overlay",
            "input": {
              "settings_files": [
                "read-data/example-look/look.json"
              ],
              "assets": "read-data/example-look",
              "out": "out/sample-strip",
              "spec": {
                "id": "sample-strip",
                "duration_s": 2,
                "canvas": [
                  640,
                  360
                ],
                "events": [
                  {
                    "type": "strip",
                    "id": "line",
                    "text": "made-up words",
                    "font": "typewriter",
                    "size": 34,
                    "paper": "white",
                    "pos": [
                      160,
                      150
                    ],
                    "at": 0.2
                  },
                  {
                    "type": "exit",
                    "at": 1.2
                  }
                ]
              }
            }
          }
        }
      },
      "hands_back": "An answer with the fields id, frames, duration_s, overlay, sound, sfx_only, timeline, stills."
    }
  ],
