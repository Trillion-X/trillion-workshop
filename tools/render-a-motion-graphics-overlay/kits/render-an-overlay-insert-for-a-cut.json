  "worked_examples": [
    {
      "title": "Render a correction insert for a film cut: its overlay, the voice and music stems, freeze plates and a preview in context on a sample input",
      "ask": "Run tool:render-an-overlay-insert-for-a-cut.",
      "mcp": {
        "server": "trillion",
        "tool": "run_resource_operation",
        "input": {
          "address": "@workshop-tools",
          "method": "tools:run",
          "input": {
            "tool": "tool:render-an-overlay-insert-for-a-cut",
            "input": {
              "settings_files": [
                "read-data/example-look/look.json"
              ],
              "assets": "read-data/example-look",
              "out": "out/sample-insert",
              "stills": [
                0.2
              ],
              "claim_check": {
                "skip": "a made-up shot that makes no claim"
              },
              "spec": {
                "id": "sample-insert",
                "canvas": [
                  256,
                  256
                ],
                "cutout": {
                  "image": "paper.png"
                },
                "plate": {
                  "source": "none.mp4",
                  "frame": 0
                },
                "graded_frame": {
                  "export": "none.mp4",
                  "cut_frame": 0
                },
                "cut_insert_s": 0,
                "events": [
                  {
                    "type": "pause",
                    "at": 0
                  },
                  {
                    "type": "exit",
                    "at": 0.6
                  }
                ]
              }
            }
          }
        }
      },
      "hands_back": "An answer with the fields inserts."
    }
  ],
