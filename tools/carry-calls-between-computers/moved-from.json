  "calls": [
    {
      "id": "name-of-the-person-in-a-readme-sentence",
      "find": "\\w+(?=, Nov 13 2026: sign-in is Better Auth)",
      "replace": "The person",
      "means": "A real person's first name, matched by its place (the sentence that names the date and the sign-in decision), becomes a made-up role word."
    },
    {
      "id": "example-email-shape-in-a-url-test",
      "find": "(?<=https://user)@(?:door|site)\\.example\\.test",
      "replace": "@example.com",
      "means": "A URL with user information on a made-up .test host reads as a real email address to the public push check; the same test on the example.com host keeps its meaning (user information is refused)."
    },
    {
      "id": "certificate-header-literal-in-a-test-string",
      "find": "b\"-{5}BEGIN CERTIFICATE-{5}\\\\nnot base64",
      "replace": "b\"\\x2d----BEGIN CERTIFICATE-----\\nnot base64",
      "means": "The test's header literal is written with its first dash as a byte escape, so the string holds the same bytes at run time and the source holds no whole certificate header."
    }
  ],
