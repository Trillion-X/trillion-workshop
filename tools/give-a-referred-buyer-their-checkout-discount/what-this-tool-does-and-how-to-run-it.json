   "payload": {
    "uses_tools": [],
    "kind": "ai-tool-descriptor",
    "id": "tool:give-a-referred-buyer-their-checkout-discount",
    "label": "Give a referred buyer their checkout discount",
    "job": "Read the referral code a buyer came with and, when it is someone else's live code, give the friend's discount to their checkout",
    "description": "Reads the code a buyer came with (code, such as a site's referral cookie) against the pursuit database's referral_codes, referral_reward_rules and the referral_code_target row named target, with the referral-codes-and-rewards rules. When it is a live code of someone else, answers checkoutCode, adjustments (the friend's discount as the take-payments checkout takes it) and metadata { referral_code } for the session; otherwise (no code, a malformed, unknown or withdrawn code, the buyer's own code given buyer_email, or rules with no friend reward) answers nothing, so the checkout is the normal one. A rule row the referral rules refuse, or no target row, is refused by name. The buyer's own code is found by calling the pursuit's own_code(code, email) function (sql/own-code.sql), so the reader login holds no right on referral_codes.email. No email is in the answer. Changes nothing.",
    "status": "active",
    "read_only": true,
    "result_selector": "$",
    "input_schema": {
     "type": "object",
     "required": [
      "database",
      "target"
     ],
     "additionalProperties": false,
     "properties": {
      "database": {
       "type": "string",
       "minLength": 1,
       "description": "The name of the pursuit database to read, bound by the trusted caller. The engine opens it with the login its vault holds as that name and -connection; no caller supplies a login."
      },
      "use": {
       "type": "object",
       "additionalProperties": false,
       "required": [
        "purpose",
        "surface"
       ],
       "description": "The use this statement runs for: a recipe step's declared purpose and surface (config.context.use, set by the workflow engine over any use the step's input carried). Given with database, the computer opens the database with its reader login (one that cannot get round the row rules, change a table or read the use binding) instead of the owner's, and hands the run a ticket of this use that it signed; the statement's transaction claims it first, so the database's row rules read this use and the statement cannot change it. A use with credential_name, which has no ticket, is refused. Absent: the owner's own work, read under the database's own purpose_when_unstated.",
       "properties": {
        "purpose": {
         "type": "string",
         "description": "The purpose path, such as publish or coach/review."
        },
        "surface": {
         "type": "string",
         "description": "The surface path, such as social/instagram; empty for any surface."
        }
       }
      },
      "code": {
       "type": "string",
       "description": "The referral code the buyer came with, as it was typed or kept (a site's referral cookie); absent or empty is a normal checkout."
      },
      "buyer_email": {
       "type": "string",
       "description": "The signed-in buyer's email, when there is one, so their own code gives them nothing."
      },
      "target": {
       "type": "string",
       "minLength": 1,
       "description": "The name of the referral_code_target row the codes point at."
      }
     }
    },
