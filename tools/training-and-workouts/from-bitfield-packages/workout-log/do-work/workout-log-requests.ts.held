// package-set://bitfield-studio/packages/workout-log/do-work/workout-log-requests.ts

import { sendRequestToBitfieldTarget } from '@bitfield/runtime-kit';
import {
  appendWorkoutEvidence,
  buildWorkoutCorrectionAtom,
  buildWorkoutReviewDecisionAtom,
  encodeWorkoutLogState,
  type WorkoutEvidenceSubject,
  type WorkoutEvidenceAtom,
  type WorkoutEvidenceSource,
  type WorkoutEvidenceValue,
  type WorkoutLogLike,
  type WorkoutLogState,
  type WorkoutRawArtifact,
  type WorkoutReviewOperation,
} from '@/packages/workout-log/read-data/workout-log';

export const WORKOUT_LOG_WRITE_ACTION = 'action:workout-log:write';

export function buildWorkoutLogWriteRequest(input: unknown) {
  return {
    target: 'slot::workflow' as const,
    payload: {
      operation: 'execute_definition',
      definition_id: WORKOUT_LOG_WRITE_ACTION,
      include_steps: false,
      include_output: false,
      input,
    },
  };
}

export function buildWorkoutEvidenceWriteState(input: {
  log: WorkoutLogLike;
  atom: WorkoutEvidenceAtom;
  rawArtifact?: WorkoutRawArtifact;
  evidenceRefs?: unknown[];
}): WorkoutLogState {
  return appendWorkoutEvidence(input.log, {
    ...input.atom,
    evidenceRefs: input.evidenceRefs ?? input.atom.evidenceRefs,
  }, input.rawArtifact);
}

export function buildWorkoutReviewDecisionWriteState(input: {
  log: WorkoutLogLike;
  targetAtom: WorkoutEvidenceAtom;
  operation: Extract<WorkoutReviewOperation, 'confirm' | 'discard'>;
  observedAt: string;
  source?: WorkoutEvidenceSource;
  note?: string;
}): WorkoutLogState {
  return appendWorkoutEvidence(input.log, buildWorkoutReviewDecisionAtom(input));
}

export function buildWorkoutCorrectionWriteState(input: {
  log: WorkoutLogLike;
  targetAtom: WorkoutEvidenceAtom;
  additionalTargetAtoms?: WorkoutEvidenceAtom[];
  operation?: Extract<WorkoutReviewOperation, 'correct' | 'split' | 'merge'>;
  descriptorId?: string;
  observedAt: string;
  source?: WorkoutEvidenceSource;
  subject?: WorkoutEvidenceSubject;
  dimensions: Record<string, WorkoutEvidenceValue>;
  rawArtifactRefs?: string[];
  rawArtifact?: WorkoutRawArtifact;
  note?: string;
}): WorkoutLogState {
  return appendWorkoutEvidence(input.log, buildWorkoutCorrectionAtom(input), input.rawArtifact);
}

export function buildWorkoutStateReplacement(input: Partial<WorkoutLogState>): WorkoutLogState {
  return encodeWorkoutLogState(input);
}

export function writeWorkoutLogState(state: WorkoutLogState): Promise<unknown> {
  return sendRequestToBitfieldTarget(buildWorkoutLogWriteRequest(state));
}

export function writeWorkoutEvidence(input: {
  log: WorkoutLogLike;
  atom: WorkoutEvidenceAtom;
  rawArtifact?: WorkoutRawArtifact;
}): Promise<unknown> {
  return writeWorkoutLogState(buildWorkoutEvidenceWriteState(input));
}

export function writeWorkoutEvidenceConfirmation(input: {
  log: WorkoutLogLike;
  targetAtom: WorkoutEvidenceAtom;
  observedAt: string;
  source?: WorkoutEvidenceSource;
  note?: string;
}): Promise<unknown> {
  return writeWorkoutLogState(buildWorkoutReviewDecisionWriteState({ ...input, operation: 'confirm' }));
}

export function writeWorkoutEvidenceDiscard(input: {
  log: WorkoutLogLike;
  targetAtom: WorkoutEvidenceAtom;
  observedAt: string;
  source?: WorkoutEvidenceSource;
  note?: string;
}): Promise<unknown> {
  return writeWorkoutLogState(buildWorkoutReviewDecisionWriteState({ ...input, operation: 'discard' }));
}

export function writeWorkoutEvidenceCorrection(input: {
  log: WorkoutLogLike;
  targetAtom: WorkoutEvidenceAtom;
  additionalTargetAtoms?: WorkoutEvidenceAtom[];
  operation?: Extract<WorkoutReviewOperation, 'correct' | 'split' | 'merge'>;
  descriptorId?: string;
  observedAt: string;
  source?: WorkoutEvidenceSource;
  subject?: WorkoutEvidenceSubject;
  dimensions: Record<string, WorkoutEvidenceValue>;
  rawArtifactRefs?: string[];
  rawArtifact?: WorkoutRawArtifact;
  note?: string;
}): Promise<unknown> {
  return writeWorkoutLogState(buildWorkoutCorrectionWriteState(input));
}
