// package-set://bitfield-studio/packages/workout-log/read-data/workout-log.ts

import type {
  TimeseriesChartBucket,
  TimeseriesChartSummary,
} from '@/packages/ui/show/timeseries-chart/InteractiveTimeseriesChart';

export type WorkoutStatus = string;
export type WorkoutReviewOperation = 'confirm' | 'correct' | 'split' | 'merge' | 'discard';

export interface WorkoutSession {
  id: string;
  plannedSessionRef?: string;
  startedAt: string;
  endedAt?: string;
  status: WorkoutStatus;
  journalNoteRef?: string;
}

export interface SetResult {
  id: string;
  movementResultId: string;
  sequence: number;
  quantity: Record<string, unknown>;
  load: Record<string, unknown>;
  effort: Record<string, unknown>;
}

export interface WorkoutEvidenceValue {
  value: unknown;
  unit?: string;
  role?: string;
  label?: string;
  confidence?: number;
}

export interface WorkoutEvidenceSource {
  kind: string;
  label?: string;
  ref?: string;
}

export interface WorkoutEvidenceSubject {
  kind: string;
  id?: string;
  label?: string;
}

export interface WorkoutEvidenceLink {
  role: string;
  targetId: string;
  targetKind?: string;
  order?: number;
}

export interface WorkoutEvidenceConfidence {
  state: string;
  score?: number;
  missingDimensions?: string[];
  reviewReason?: string;
}

export interface WorkoutEvidenceAtom {
  id: string;
  schema: string;
  observedAt: string;
  recordedAt?: string;
  source: WorkoutEvidenceSource;
  subject: WorkoutEvidenceSubject;
  dimensions: Record<string, WorkoutEvidenceValue>;
  links: WorkoutEvidenceLink[];
  confidence?: WorkoutEvidenceConfidence;
  rawArtifactRefs: string[];
  evidenceRefs: unknown[];
}

export interface WorkoutRawArtifact {
  id: string;
  kind: string;
  capturedAt: string;
  text?: string;
  ref?: string;
  source?: string;
}

export interface WorkoutCapturePrompt {
  headline: string;
  subhead?: string;
  primaryActionLabel: string;
  secondaryActionLabels?: string[];
  inputMode: string;
}

export interface WorkoutCaptureDimension {
  key: string;
  label: string;
  inputKind: string;
  unitOptions?: string[];
  required?: boolean;
  quickValues?: unknown[];
}

export interface WorkoutGroupingRule {
  groupKind: string;
  orderDimension?: string;
  allowNested?: boolean;
}

export interface WorkoutProjectionQuery {
  subjectKinds?: string[];
  dimensionKeys?: string[];
  linkRoles?: string[];
  window?: string;
  comparator?: string;
}

export interface WorkoutCaptureDescriptor {
  id: string;
  label: string;
  intent: string;
  priority?: number;
  prompt: WorkoutCapturePrompt;
  acceptedDimensions: WorkoutCaptureDimension[];
  defaultSource?: WorkoutEvidenceSource;
  grouping?: WorkoutGroupingRule;
  previousValueQuery?: WorkoutProjectionQuery;
  submitAction: string;
}

export interface WorkoutProjectionOutput {
  kind: string;
  primaryMetric?: string;
  secondaryMetrics?: string[];
  groupBy?: string[];
}

export interface WorkoutProjectionLens {
  id: string;
  label: string;
  intent: string;
  atomQuery: WorkoutProjectionQuery;
  output: WorkoutProjectionOutput;
  prominence?: string;
}

export interface WorkoutActiveCaptureState {
  mode: string;
  descriptorId?: string;
  focusAtomId?: string;
  groupId?: string;
}

export interface WorkoutExportRow {
  atomId: string;
  observedAt: string;
  subjectKind: string;
  subjectId?: string;
  subjectLabel?: string;
  dimensions: Record<string, unknown>;
  confidenceState?: string;
  rawArtifactRefs: string[];
  evidenceRefs: unknown[];
}

export interface WorkoutLensOutput {
  lensId: string;
  kind: string;
  label: string;
  items: WorkoutEvidenceAtom[];
  primaryAtom?: WorkoutEvidenceAtom;
  primaryText?: string;
  metric?: {
    label: string;
    value: number;
    detail?: string;
  };
  rows?: WorkoutExportRow[];
  unavailableReason?: string;
}

export interface WorkoutProgressChart {
  metricKey: string;
  title: string;
  metric: string;
  unit?: string;
  valueDecimals: number;
  buckets: TimeseriesChartBucket[];
  summary: TimeseriesChartSummary;
}

export interface WorkoutLogState {
  sessions?: WorkoutSession[];
  sets?: SetResult[];
  evidenceAtoms?: WorkoutEvidenceAtom[];
  rawArtifacts?: WorkoutRawArtifact[];
  captureDescriptors?: WorkoutCaptureDescriptor[];
  projectionLenses?: WorkoutProjectionLens[];
  activeCapture?: WorkoutActiveCaptureState;
}

export interface WorkoutLog {
  sessions: WorkoutSession[];
  sets: SetResult[];
  evidenceAtoms: WorkoutEvidenceAtom[];
  canonicalEvidenceAtoms: WorkoutEvidenceAtom[];
  rawArtifacts: WorkoutRawArtifact[];
  captureDescriptors: WorkoutCaptureDescriptor[];
  projectionLenses: WorkoutProjectionLens[];
  activeCapture: WorkoutActiveCaptureState;
  activeDescriptor?: WorkoutCaptureDescriptor;
  lensOutputs: WorkoutLensOutput[];
  reviewQueue: WorkoutEvidenceAtom[];
  exportRows: WorkoutExportRow[];
  diagnostics: string[];
}

export type WorkoutLogLike = Partial<WorkoutLog> & {
  sessions?: WorkoutSession[];
  sets?: SetResult[];
};

function object(value: unknown): Record<string, unknown> {
  return value && typeof value === 'object' && !Array.isArray(value) ? value as Record<string, unknown> : {};
}

function array(value: unknown): unknown[] {
  return Array.isArray(value) ? value : [];
}

function string(value: unknown): string {
  return typeof value === 'string' ? value : '';
}

function optionalString(value: unknown): string | undefined {
  const text = string(value).trim();
  return text ? text : undefined;
}

function number(value: unknown): number {
  const parsed = Number(value);
  return Number.isFinite(parsed) ? parsed : 0;
}

function optionalNumber(value: unknown): number | undefined {
  const parsed = Number(value);
  return Number.isFinite(parsed) ? parsed : undefined;
}

function bool(value: unknown): boolean | undefined {
  return typeof value === 'boolean' ? value : undefined;
}

function decodeStatus(value: unknown): WorkoutStatus {
  return optionalString(value) ?? 'needs_review';
}

function isCompletedStatus(status: WorkoutStatus): boolean {
  return status === 'completed';
}

function statusNeedsReview(status: WorkoutStatus): boolean {
  return status === 'needs_review' || status === 'unknown' || status === 'unconfirmed';
}

function decodeEvidenceValue(value: unknown): WorkoutEvidenceValue {
  const row = object(value);
  if ('value' in row) {
    return {
      value: row.value,
      ...(optionalString(row.unit) ? { unit: string(row.unit) } : {}),
      ...(optionalString(row.role) ? { role: string(row.role) } : {}),
      ...(optionalString(row.label) ? { label: string(row.label) } : {}),
      ...(optionalNumber(row.confidence) != null ? { confidence: number(row.confidence) } : {}),
    };
  }
  return { value };
}

function decodeDimensions(value: unknown): Record<string, WorkoutEvidenceValue> {
  return Object.fromEntries(
    Object.entries(object(value))
      .filter(([key]) => key.trim())
      .map(([key, entry]) => [key, decodeEvidenceValue(entry)]),
  );
}

function decodeSource(value: unknown, fallbackKind: string): WorkoutEvidenceSource {
  const row = object(value);
  return {
    kind: optionalString(row.kind) ?? fallbackKind,
    ...(optionalString(row.label) ? { label: string(row.label) } : {}),
    ...(optionalString(row.ref) ? { ref: string(row.ref) } : {}),
  };
}

function decodeSubject(value: unknown, fallbackKind: string): WorkoutEvidenceSubject {
  const row = object(value);
  return {
    kind: optionalString(row.kind) ?? fallbackKind,
    ...(optionalString(row.id) ? { id: string(row.id) } : {}),
    ...(optionalString(row.label) ? { label: string(row.label) } : {}),
  };
}

function decodeLink(value: unknown): WorkoutEvidenceLink | null {
  const row = object(value);
  const role = optionalString(row.role);
  const targetId = optionalString(row.targetId ?? row.target_id);
  if (!role || !targetId) return null;
  return {
    role,
    targetId,
    ...(optionalString(row.targetKind ?? row.target_kind) ? { targetKind: string(row.targetKind ?? row.target_kind) } : {}),
    ...(optionalNumber(row.order) != null ? { order: number(row.order) } : {}),
  };
}

function decodeConfidence(value: unknown): WorkoutEvidenceConfidence | undefined {
  const row = object(value);
  const state = optionalString(row.state);
  if (!state) return undefined;
  return {
    state,
    ...(optionalNumber(row.score) != null ? { score: number(row.score) } : {}),
    ...(array(row.missingDimensions ?? row.missing_dimensions).length > 0
      ? { missingDimensions: array(row.missingDimensions ?? row.missing_dimensions).map(string).filter(Boolean) }
      : {}),
    ...(optionalString(row.reviewReason ?? row.review_reason) ? { reviewReason: string(row.reviewReason ?? row.review_reason) } : {}),
  };
}

function decodeAtom(value: unknown): WorkoutEvidenceAtom | null {
  const row = object(value);
  const id = optionalString(row.id);
  const observedAt = optionalString(row.observedAt ?? row.observed_at);
  if (!id || !observedAt) return null;
  return {
    id,
    schema: optionalString(row.schema) ?? 'workout-evidence-atom',
    observedAt,
    ...(optionalString(row.recordedAt ?? row.recorded_at) ? { recordedAt: string(row.recordedAt ?? row.recorded_at) } : {}),
    source: decodeSource(row.source, 'unknown'),
    subject: decodeSubject(row.subject, 'workout_evidence'),
    dimensions: decodeDimensions(row.dimensions),
    links: array(row.links).map(decodeLink).filter((link): link is WorkoutEvidenceLink => Boolean(link)),
    ...(decodeConfidence(row.confidence) ? { confidence: decodeConfidence(row.confidence) } : {}),
    rawArtifactRefs: array(row.rawArtifactRefs ?? row.raw_artifact_refs).map(string).filter(Boolean),
    evidenceRefs: array(row.evidenceRefs ?? row.evidence_refs),
  };
}

function decodeRawArtifact(value: unknown): WorkoutRawArtifact | null {
  const row = object(value);
  const id = optionalString(row.id);
  const capturedAt = optionalString(row.capturedAt ?? row.captured_at);
  if (!id || !capturedAt) return null;
  return {
    id,
    kind: optionalString(row.kind) ?? 'raw_text',
    capturedAt,
    ...(optionalString(row.text) ? { text: string(row.text) } : {}),
    ...(optionalString(row.ref) ? { ref: string(row.ref) } : {}),
    ...(optionalString(row.source) ? { source: string(row.source) } : {}),
  };
}

function decodePrompt(value: unknown): WorkoutCapturePrompt {
  const row = object(value);
  return {
    headline: optionalString(row.headline) ?? 'Log workout',
    ...(optionalString(row.subhead) ? { subhead: string(row.subhead) } : {}),
    primaryActionLabel: optionalString(row.primaryActionLabel ?? row.primary_action_label) ?? 'Save',
    secondaryActionLabels: array(row.secondaryActionLabels ?? row.secondary_action_labels).map(string).filter(Boolean),
    inputMode: optionalString(row.inputMode ?? row.input_mode) ?? 'structured',
  };
}

function decodeCaptureDimension(value: unknown): WorkoutCaptureDimension | null {
  const row = object(value);
  const key = optionalString(row.key);
  const label = optionalString(row.label);
  if (!key || !label) return null;
  return {
    key,
    label,
    inputKind: optionalString(row.inputKind ?? row.input_kind) ?? 'text',
    unitOptions: array(row.unitOptions ?? row.unit_options).map(string).filter(Boolean),
    ...(bool(row.required) != null ? { required: Boolean(row.required) } : {}),
    quickValues: array(row.quickValues ?? row.quick_values),
  };
}

function decodeGrouping(value: unknown): WorkoutGroupingRule | undefined {
  const row = object(value);
  const groupKind = optionalString(row.groupKind ?? row.group_kind);
  if (!groupKind) return undefined;
  return {
    groupKind,
    ...(optionalString(row.orderDimension ?? row.order_dimension) ? { orderDimension: string(row.orderDimension ?? row.order_dimension) } : {}),
    ...(bool(row.allowNested ?? row.allow_nested) != null ? { allowNested: Boolean(row.allowNested ?? row.allow_nested) } : {}),
  };
}

function decodeQuery(value: unknown): WorkoutProjectionQuery {
  const row = object(value);
  return {
    subjectKinds: array(row.subjectKinds ?? row.subject_kinds).map(string).filter(Boolean),
    dimensionKeys: array(row.dimensionKeys ?? row.dimension_keys).map(string).filter(Boolean),
    linkRoles: array(row.linkRoles ?? row.link_roles).map(string).filter(Boolean),
    ...(optionalString(row.window) ? { window: string(row.window) } : {}),
    ...(optionalString(row.comparator) ? { comparator: string(row.comparator) } : {}),
  };
}

function decodeCaptureDescriptor(value: unknown): WorkoutCaptureDescriptor | null {
  const row = object(value);
  const id = optionalString(row.id);
  const label = optionalString(row.label);
  const submitAction = optionalString(row.submitAction ?? row.submit_action);
  if (!id || !label || !submitAction) return null;
  return {
    id,
    label,
    intent: optionalString(row.intent) ?? 'capture',
    ...(optionalNumber(row.priority) != null ? { priority: number(row.priority) } : {}),
    prompt: decodePrompt(row.prompt),
    acceptedDimensions: array(row.acceptedDimensions ?? row.accepted_dimensions)
      .map(decodeCaptureDimension)
      .filter((dimension): dimension is WorkoutCaptureDimension => Boolean(dimension)),
    ...(Object.keys(object(row.defaultSource ?? row.default_source)).length > 0
      ? { defaultSource: decodeSource(row.defaultSource ?? row.default_source, 'manual') }
      : {}),
    ...(decodeGrouping(row.grouping) ? { grouping: decodeGrouping(row.grouping) } : {}),
    previousValueQuery: decodeQuery(row.previousValueQuery ?? row.previous_value_query),
    submitAction,
  };
}

function decodeLens(value: unknown): WorkoutProjectionLens | null {
  const row = object(value);
  const id = optionalString(row.id);
  const label = optionalString(row.label);
  const output = object(row.output);
  const kind = optionalString(output.kind);
  if (!id || !label || !kind) return null;
  return {
    id,
    label,
    intent: optionalString(row.intent) ?? 'project',
    atomQuery: decodeQuery(row.atomQuery ?? row.atom_query),
    output: {
      kind,
      ...(optionalString(output.primaryMetric ?? output.primary_metric) ? { primaryMetric: string(output.primaryMetric ?? output.primary_metric) } : {}),
      secondaryMetrics: array(output.secondaryMetrics ?? output.secondary_metrics).map(string).filter(Boolean),
      groupBy: array(output.groupBy ?? output.group_by).map(string).filter(Boolean),
    },
    ...(optionalString(row.prominence) ? { prominence: string(row.prominence) } : {}),
  };
}

function workoutMetricLabel(label: string | undefined, fallback: string): string {
  switch ((label ?? '').toLowerCase()) {
    case 'confirmed evidence':
    case 'matched evidence':
      return 'saved entries';
    case 'recent evidence':
      return 'recent entries';
    case 'latest comparable evidence':
      return 'last similar entry';
    case 'review items':
      return 'to check';
    default:
      return label ?? fallback;
  }
}

function decodeActiveCapture(value: unknown, firstDescriptorId?: string): WorkoutActiveCaptureState {
  const row = object(value);
  return {
    mode: optionalString(row.mode) ?? 'capture',
    descriptorId: optionalString(row.descriptorId ?? row.descriptor_id) ?? firstDescriptorId,
    ...(optionalString(row.focusAtomId ?? row.focus_atom_id) ? { focusAtomId: string(row.focusAtomId ?? row.focus_atom_id) } : {}),
    ...(optionalString(row.groupId ?? row.group_id) ? { groupId: string(row.groupId ?? row.group_id) } : {}),
  };
}

function decodeSessions(value: unknown): WorkoutSession[] {
  return array(value).map((entry) => {
    const row = object(entry);
    return {
      id: string(row.id),
      startedAt: string(row.startedAt ?? row.started_at),
      status: decodeStatus(row.status),
      ...(optionalString(row.plannedSessionRef ?? row.planned_session_ref) ? { plannedSessionRef: string(row.plannedSessionRef ?? row.planned_session_ref) } : {}),
      ...(optionalString(row.endedAt ?? row.ended_at) ? { endedAt: string(row.endedAt ?? row.ended_at) } : {}),
      ...(optionalString(row.journalNoteRef ?? row.journal_note_ref) ? { journalNoteRef: string(row.journalNoteRef ?? row.journal_note_ref) } : {}),
    };
  }).filter((session) => session.id);
}

function decodeSets(value: unknown): SetResult[] {
  return array(value).map((entry) => {
    const row = object(entry);
    return {
      id: string(row.id),
      movementResultId: string(row.movementResultId ?? row.movement_result_id),
      sequence: number(row.sequence),
      quantity: object(row.quantity),
      load: object(row.load),
      effort: object(row.effort),
    };
  }).filter((set) => set.id);
}

function dimension(key: string, value: unknown, role: string, label = key): [string, WorkoutEvidenceValue] {
  return [key, { value, role, label }];
}

function flattenMetricObject(prefix: string, value: Record<string, unknown>): Record<string, WorkoutEvidenceValue> {
  return Object.fromEntries(
    Object.entries(value)
      .filter(([key]) => key.trim())
      .map(([key, entry]) => dimension(`${prefix}.${key}`, entry, prefix, key)),
  );
}

function sessionToAtom(session: WorkoutSession): WorkoutEvidenceAtom {
  return {
    id: `legacy:${session.id}`,
    schema: 'workout-evidence-atom',
    observedAt: session.startedAt,
    ...(session.endedAt ? { recordedAt: session.endedAt } : {}),
    source: { kind: 'legacy_session_record', label: 'Session record' },
    subject: { kind: 'workout_session', id: session.id, label: session.plannedSessionRef ?? session.id },
    dimensions: {
      status: { value: session.status, role: 'status', label: 'Status' },
      ...(session.endedAt ? { ended_at: { value: session.endedAt, role: 'time', label: 'Ended' } } : {}),
      ...(session.plannedSessionRef ? { planned_session_ref: { value: session.plannedSessionRef, role: 'link', label: 'Plan' } } : {}),
      ...(session.journalNoteRef ? { journal_note_ref: { value: session.journalNoteRef, role: 'link', label: 'Journal' } } : {}),
    },
    links: [
      ...(session.plannedSessionRef ? [{ role: 'planned_session', targetId: session.plannedSessionRef, targetKind: 'training_plan_session' }] : []),
      ...(session.journalNoteRef ? [{ role: 'journal_note', targetId: session.journalNoteRef, targetKind: 'journal_note' }] : []),
    ],
    confidence: statusNeedsReview(session.status)
      ? { state: 'needs_review', missingDimensions: ['status'], reviewReason: 'Session status was missing or unknown.' }
      : { state: 'confirmed' },
    rawArtifactRefs: [],
    evidenceRefs: [],
  };
}

function sessionIdFromMovementResult(movementResultId: string): string | undefined {
  const parts = movementResultId.split(':');
  return parts.length > 2 ? parts.slice(0, 2).join(':') : undefined;
}

function movementLabelFromResult(movementResultId: string): string {
  const parts = movementResultId.split(':');
  return parts.length > 2 ? parts.slice(2).join(':') : movementResultId;
}

function setToAtom(set: SetResult): WorkoutEvidenceAtom {
  const sessionId = sessionIdFromMovementResult(set.movementResultId);
  return {
    id: `legacy:${set.id}`,
    schema: 'workout-evidence-atom',
    observedAt: '',
    source: { kind: 'legacy_set_record', label: 'Set result' },
    subject: { kind: 'movement_result', id: set.movementResultId, label: movementLabelFromResult(set.movementResultId) },
    dimensions: {
      sequence: { value: set.sequence, role: 'order', label: 'Set' },
      ...flattenMetricObject('quantity', set.quantity),
      ...flattenMetricObject('load', set.load),
      ...flattenMetricObject('effort', set.effort),
    },
    links: [
      { role: 'movement_result', targetId: set.movementResultId, targetKind: 'movement_result', order: set.sequence },
      ...(sessionId ? [{ role: 'session', targetId: sessionId, targetKind: 'workout_session' }] : []),
    ],
    confidence: { state: 'confirmed' },
    rawArtifactRefs: [],
    evidenceRefs: [],
  };
}

function mergeAtoms(primary: WorkoutEvidenceAtom[], secondary: WorkoutEvidenceAtom[]): WorkoutEvidenceAtom[] {
  const byId = new Map<string, WorkoutEvidenceAtom>();
  for (const atom of [...primary, ...secondary]) {
    byId.set(atom.id, atom);
  }
  return [...byId.values()];
}

function atomConfirmed(atom: WorkoutEvidenceAtom): boolean {
  return !atom.confidence || atom.confidence.state === 'confirmed';
}

function atomNeedsReview(atom: WorkoutEvidenceAtom): boolean {
  return Boolean(atom.confidence && atom.confidence.state !== 'confirmed');
}

function atomIsReviewDecision(atom: WorkoutEvidenceAtom): boolean {
  return atom.subject.kind === 'workout_review_decision';
}

interface WorkoutAtomDecisionIndex {
  confirmedTargetIds: Set<string>;
  replacedTargetIds: Set<string>;
  reviewDecisionAtomIds: Set<string>;
}

const CONFIRMING_LINK_ROLES = new Set(['confirms']);
const REPLACEMENT_LINK_ROLES = new Set(['corrects', 'supersedes', 'discards', 'split_from', 'merge_input']);

function buildDecisionIndex(atoms: WorkoutEvidenceAtom[]): WorkoutAtomDecisionIndex {
  const confirmedTargetIds = new Set<string>();
  const replacedTargetIds = new Set<string>();
  const reviewDecisionAtomIds = new Set<string>();
  for (const atom of atoms) {
    if (atomIsReviewDecision(atom)) reviewDecisionAtomIds.add(atom.id);
    if (!atomConfirmed(atom)) continue;
    for (const link of atom.links) {
      if (CONFIRMING_LINK_ROLES.has(link.role)) confirmedTargetIds.add(link.targetId);
      if (REPLACEMENT_LINK_ROLES.has(link.role)) replacedTargetIds.add(link.targetId);
    }
  }
  return { confirmedTargetIds, replacedTargetIds, reviewDecisionAtomIds };
}

function atomIsCanonical(atom: WorkoutEvidenceAtom, decisionIndex: WorkoutAtomDecisionIndex): boolean {
  return !decisionIndex.reviewDecisionAtomIds.has(atom.id) && !decisionIndex.replacedTargetIds.has(atom.id);
}

function atomEffectivelyConfirmed(atom: WorkoutEvidenceAtom, decisionIndex: WorkoutAtomDecisionIndex): boolean {
  return atomConfirmed(atom) || decisionIndex.confirmedTargetIds.has(atom.id);
}

function canonicalAtoms(atoms: WorkoutEvidenceAtom[], decisionIndex: WorkoutAtomDecisionIndex): WorkoutEvidenceAtom[] {
  return atoms.filter((atom) => atomIsCanonical(atom, decisionIndex));
}

function canonicalConfirmedAtoms(atoms: WorkoutEvidenceAtom[], decisionIndex: WorkoutAtomDecisionIndex): WorkoutEvidenceAtom[] {
  return canonicalAtoms(atoms, decisionIndex).filter((atom) => atomEffectivelyConfirmed(atom, decisionIndex));
}

function atomTime(atom: WorkoutEvidenceAtom): number {
  const parsed = Date.parse(atom.observedAt);
  return Number.isFinite(parsed) ? parsed : 0;
}

function latestFirst(atoms: WorkoutEvidenceAtom[]): WorkoutEvidenceAtom[] {
  return [...atoms].sort((left, right) => atomTime(right) - atomTime(left));
}

function earliestFirst(atoms: WorkoutEvidenceAtom[]): WorkoutEvidenceAtom[] {
  return [...atoms].sort((left, right) => atomTime(left) - atomTime(right));
}

function atomMatchesQuery(atom: WorkoutEvidenceAtom, query: WorkoutProjectionQuery): boolean {
  if (query.subjectKinds && query.subjectKinds.length > 0 && !query.subjectKinds.includes(atom.subject.kind)) return false;
  if (query.dimensionKeys && query.dimensionKeys.length > 0 && !query.dimensionKeys.some((key) => key in atom.dimensions)) return false;
  if (query.linkRoles && query.linkRoles.length > 0 && !query.linkRoles.some((role) => atom.links.some((link) => link.role === role))) return false;
  return true;
}

export function describeEvidenceValue(value: WorkoutEvidenceValue): string {
  const text = value.value == null ? '' : String(value.value);
  return value.unit ? `${text} ${value.unit}` : text;
}

export function describeAtom(atom: WorkoutEvidenceAtom): string {
  const values = Object.values(atom.dimensions)
    .filter((value) => value.role !== 'link' && value.role !== 'status')
    .slice(0, 3)
    .map(describeEvidenceValue)
    .filter(Boolean);
  return [atom.subject.label ?? atom.subject.id ?? atom.subject.kind, ...values].filter(Boolean).join(' · ');
}

function atomToExportRow(atom: WorkoutEvidenceAtom): WorkoutExportRow {
  return {
    atomId: atom.id,
    observedAt: atom.observedAt,
    subjectKind: atom.subject.kind,
    ...(atom.subject.id ? { subjectId: atom.subject.id } : {}),
    ...(atom.subject.label ? { subjectLabel: atom.subject.label } : {}),
    dimensions: Object.fromEntries(Object.entries(atom.dimensions).map(([key, value]) => [key, value.value])),
    confidenceState: atom.confidence?.state,
    rawArtifactRefs: atom.rawArtifactRefs,
    evidenceRefs: atom.evidenceRefs,
  };
}

function runLens(
  lens: WorkoutProjectionLens,
  atoms: WorkoutEvidenceAtom[],
  reviewQueue: WorkoutEvidenceAtom[],
  decisionIndex: WorkoutAtomDecisionIndex,
): WorkoutLensOutput {
  const canonicalMatched = canonicalAtoms(atoms, decisionIndex).filter((atom) => atomMatchesQuery(atom, lens.atomQuery));
  if (lens.output.kind === 'previous-value') {
    const primaryAtom = latestFirst(canonicalMatched.filter((atom) => atomEffectivelyConfirmed(atom, decisionIndex)))[0];
    return {
      lensId: lens.id,
      kind: lens.output.kind,
      label: lens.label,
      items: primaryAtom ? [primaryAtom] : [],
      ...(primaryAtom ? { primaryAtom, primaryText: describeAtom(primaryAtom) } : { unavailableReason: 'No similar saved entry yet.' }),
    };
  }
  if (lens.output.kind === 'review-queue') {
    return {
      lensId: lens.id,
      kind: lens.output.kind,
      label: lens.label,
      items: reviewQueue,
      metric: { label: 'to check', value: reviewQueue.length },
    };
  }
  if (lens.output.kind === 'progress-summary') {
    const confirmed = canonicalMatched.filter((atom) => atomEffectivelyConfirmed(atom, decisionIndex));
    const latest = latestFirst(confirmed)[0];
    return {
      lensId: lens.id,
      kind: lens.output.kind,
      label: lens.label,
      items: confirmed,
      ...(latest ? { primaryAtom: latest, primaryText: describeAtom(latest) } : {}),
      metric: { label: workoutMetricLabel(lens.output.primaryMetric, 'saved entries'), value: confirmed.length, detail: latest ? `Latest: ${describeAtom(latest)}` : 'No saved entries yet.' },
    };
  }
  if (lens.output.kind === 'export-rows') {
    const exportable = canonicalMatched.filter((atom) => atomEffectivelyConfirmed(atom, decisionIndex));
    return {
      lensId: lens.id,
      kind: lens.output.kind,
      label: lens.label,
      items: exportable,
      rows: exportable.map(atomToExportRow),
      metric: { label: 'saved rows', value: exportable.length },
    };
  }
  return {
    lensId: lens.id,
    kind: lens.output.kind,
    label: lens.label,
    items: canonicalMatched,
    metric: { label: workoutMetricLabel(lens.output.primaryMetric, 'saved entries'), value: canonicalMatched.length },
  };
}

export function decodeWorkoutLog(raw: unknown): WorkoutLog {
  const root = object(raw);
  const sessions = decodeSessions(root.sessions);
  const sets = decodeSets(root.sets);
  const explicitAtoms = array(root.evidenceAtoms ?? root.evidence_atoms)
    .map(decodeAtom)
    .filter((atom): atom is WorkoutEvidenceAtom => Boolean(atom));
  const legacyAtoms = [
    ...sessions.map(sessionToAtom),
    ...sets.map(setToAtom).map((atom) => ({
      ...atom,
      observedAt: sessions.find((session) => session.id === atom.links.find((link) => link.role === 'session')?.targetId)?.startedAt ?? '',
    })),
  ];
  const evidenceAtoms = mergeAtoms(explicitAtoms, legacyAtoms);
  const rawArtifacts = array(root.rawArtifacts ?? root.raw_artifacts)
    .map(decodeRawArtifact)
    .filter((artifact): artifact is WorkoutRawArtifact => Boolean(artifact));
  const captureDescriptors = array(root.captureDescriptors ?? root.capture_descriptors)
    .map(decodeCaptureDescriptor)
    .filter((descriptor): descriptor is WorkoutCaptureDescriptor => Boolean(descriptor))
    .sort((left, right) => (left.priority ?? 0) - (right.priority ?? 0));
  const projectionLenses = array(root.projectionLenses ?? root.projection_lenses)
    .map(decodeLens)
    .filter((lens): lens is WorkoutProjectionLens => Boolean(lens));
  const activeCapture = decodeActiveCapture(root.activeCapture ?? root.active_capture, captureDescriptors[0]?.id);
  const activeDescriptor = captureDescriptors.find((descriptor) => descriptor.id === activeCapture.descriptorId) ?? captureDescriptors[0];
  const decisionIndex = buildDecisionIndex(evidenceAtoms);
  const canonicalEvidenceAtoms = canonicalAtoms(evidenceAtoms, decisionIndex);
  const confirmedEvidenceAtoms = canonicalConfirmedAtoms(evidenceAtoms, decisionIndex);
  const reviewQueue = latestFirst(evidenceAtoms.filter((atom) => (
    atomNeedsReview(atom)
    && atomIsCanonical(atom, decisionIndex)
    && !decisionIndex.confirmedTargetIds.has(atom.id)
  )));
  const lensOutputs = projectionLenses.map((lens) => runLens(lens, evidenceAtoms, reviewQueue, decisionIndex));
  return {
    sessions,
    sets,
    evidenceAtoms,
    canonicalEvidenceAtoms,
    rawArtifacts,
    captureDescriptors,
    projectionLenses,
    activeCapture,
    ...(activeDescriptor ? { activeDescriptor } : {}),
    lensOutputs,
    reviewQueue,
    exportRows: confirmedEvidenceAtoms.map(atomToExportRow),
    diagnostics: [
      ...(captureDescriptors.length === 0 ? ['The ways to log are missing.'] : []),
      ...(projectionLenses.length === 0 ? ['The summary views are missing.'] : []),
    ],
  };
}

const NON_CHART_DIMENSION_ROLES = new Set([
  'link',
  'status',
  'raw',
  'note',
  'order',
  'review_operation',
  'correction',
]);

interface WorkoutNumericChartPoint {
  atomId: string;
  timestamp: number;
  value: number;
}

interface WorkoutNumericChartSeries {
  key: string;
  subjectLabel: string;
  metricLabel: string;
  unit?: string;
  points: WorkoutNumericChartPoint[];
}

function readChartNumber(value: unknown): number | undefined {
  if (typeof value === 'number') return Number.isFinite(value) ? value : undefined;
  if (typeof value !== 'string') return undefined;
  const trimmed = value.trim();
  if (!/^[-+]?\d+(?:\.\d+)?$/u.test(trimmed)) return undefined;
  const parsed = Number(trimmed);
  return Number.isFinite(parsed) ? parsed : undefined;
}

function decimalPlaces(value: number): number {
  const text = String(value);
  if (text.includes('e')) return 2;
  return Math.min(2, text.split('.')[1]?.length ?? 0);
}

function metricLabelFromDimension(key: string, dimension: WorkoutEvidenceValue): string {
  return optionalString(dimension.label) ?? optionalString(dimension.role) ?? key;
}

function chartSubjectLabel(atom: WorkoutEvidenceAtom): string {
  return atom.subject.label ?? atom.subject.id ?? atom.subject.kind;
}

function chartAtoms(log: WorkoutLog): WorkoutEvidenceAtom[] {
  const progressAtoms = log.lensOutputs.find((output) => output.kind === 'progress-summary')?.items ?? [];
  return mergeAtoms(log.canonicalEvidenceAtoms.filter(atomConfirmed), progressAtoms);
}

function buildSeriesKey(atom: WorkoutEvidenceAtom, key: string, dimension: WorkoutEvidenceValue): string {
  return [
    atom.subject.kind,
    atom.subject.id ?? atom.subject.label ?? atom.subject.kind,
    key,
    dimension.unit ?? '',
  ].join('::');
}

function buildNumericChartSeries(log: WorkoutLog): WorkoutNumericChartSeries[] {
  const groups = new Map<string, WorkoutNumericChartSeries>();
  for (const atom of earliestFirst(chartAtoms(log))) {
    const timestamp = atomTime(atom);
    if (timestamp <= 0) continue;
    for (const [key, dimension] of Object.entries(atom.dimensions)) {
      if (dimension.role && NON_CHART_DIMENSION_ROLES.has(dimension.role)) continue;
      const value = readChartNumber(dimension.value);
      if (value == null) continue;
      const seriesKey = buildSeriesKey(atom, key, dimension);
      const current = groups.get(seriesKey) ?? {
        key: seriesKey,
        subjectLabel: chartSubjectLabel(atom),
        metricLabel: metricLabelFromDimension(key, dimension),
        ...(dimension.unit ? { unit: dimension.unit } : {}),
        points: [],
      };
      current.points.push({ atomId: atom.id, timestamp, value });
      groups.set(seriesKey, current);
    }
  }
  return [...groups.values()];
}

function selectProgressSeries(series: WorkoutNumericChartSeries[]): WorkoutNumericChartSeries | undefined {
  return series
    .filter((candidate) => candidate.points.length > 0)
    .sort((left, right) => {
      const countDiff = right.points.length - left.points.length;
      if (countDiff !== 0) return countDiff;
      const leftLatest = left.points[left.points.length - 1]?.timestamp ?? 0;
      const rightLatest = right.points[right.points.length - 1]?.timestamp ?? 0;
      const recentDiff = rightLatest - leftLatest;
      return recentDiff !== 0 ? recentDiff : left.key.localeCompare(right.key);
    })[0];
}

function seriesBuckets(points: WorkoutNumericChartPoint[]): TimeseriesChartBucket[] {
  return points.map((point, index) => {
    const previousValue = points[index - 1]?.value ?? point.value;
    return {
      timestamp: point.timestamp,
      open: previousValue,
      high: Math.max(previousValue, point.value),
      low: Math.min(previousValue, point.value),
      close: point.value,
      accumulated: point.value,
      volume: 1,
    };
  });
}

function seriesSummary(points: WorkoutNumericChartPoint[]): TimeseriesChartSummary {
  const values = points.map((point) => point.value);
  const total = values[values.length - 1] ?? 0;
  const sum = values.reduce((current, value) => current + value, 0);
  return {
    total,
    average: values.length > 0 ? sum / values.length : 0,
    min: Math.min(...values),
    max: Math.max(...values),
    count: values.length,
  };
}

export function buildWorkoutProgressChart(log: WorkoutLog): WorkoutProgressChart | null {
  const series = selectProgressSeries(buildNumericChartSeries(log));
  if (!series) return null;
  const buckets = seriesBuckets(series.points);
  const title = series.subjectLabel === series.metricLabel
    ? series.metricLabel
    : `${series.subjectLabel} ${series.metricLabel.toLowerCase()}`;
  return {
    metricKey: series.key,
    title,
    metric: series.metricLabel,
    ...(series.unit ? { unit: series.unit } : {}),
    valueDecimals: Math.max(...series.points.map((point) => decimalPlaces(point.value)), 0),
    buckets,
    summary: seriesSummary(series.points),
  };
}

export function ensureWorkoutLogProjection(log: WorkoutLogLike | unknown): WorkoutLog {
  const candidate = object(log);
  if (Array.isArray(candidate.evidenceAtoms) && Array.isArray(candidate.captureDescriptors) && Array.isArray(candidate.projectionLenses)) {
    return decodeWorkoutLog(encodeWorkoutLogState(candidate as Partial<WorkoutLog>));
  }
  return decodeWorkoutLog(log);
}

export function encodeWorkoutLogState(log: Partial<WorkoutLog>): WorkoutLogState {
  return {
    sessions: log.sessions ?? [],
    sets: log.sets ?? [],
    evidenceAtoms: log.evidenceAtoms ?? [],
    rawArtifacts: log.rawArtifacts ?? [],
    captureDescriptors: log.captureDescriptors ?? [],
    projectionLenses: log.projectionLenses ?? [],
    activeCapture: log.activeCapture ?? { mode: 'capture', descriptorId: log.captureDescriptors?.[0]?.id },
  };
}

export function workoutCompletionRate(log: Pick<WorkoutLogLike, 'sessions'>): number {
  const sessions = log.sessions ?? [];
  if (sessions.length === 0) return 0;
  return sessions.filter((session) => isCompletedStatus(session.status)).length / sessions.length;
}

function stableSuffix(value: unknown): string {
  return JSON.stringify(value)
    .replace(/[^a-zA-Z0-9]+/g, '-')
    .replace(/^-+|-+$/g, '')
    .slice(0, 48) || 'evidence';
}

export function buildWorkoutEvidenceAtom(input: {
  id?: string;
  descriptorId: string;
  observedAt: string;
  source: WorkoutEvidenceSource;
  subject: WorkoutEvidenceSubject;
  dimensions: Record<string, WorkoutEvidenceValue>;
  links?: WorkoutEvidenceLink[];
  confidence?: WorkoutEvidenceConfidence;
  rawArtifactRefs?: string[];
  evidenceRefs?: unknown[];
}): WorkoutEvidenceAtom {
  return {
    id: input.id ?? `evidence:${input.descriptorId}:${stableSuffix([input.observedAt, input.subject, input.dimensions])}`,
    schema: 'workout-evidence-atom',
    observedAt: input.observedAt,
    recordedAt: input.observedAt,
    source: input.source,
    subject: input.subject,
    dimensions: input.dimensions,
    links: input.links ?? [],
    confidence: input.confidence ?? { state: 'confirmed' },
    rawArtifactRefs: input.rawArtifactRefs ?? [],
    evidenceRefs: input.evidenceRefs ?? [],
  };
}

export function buildWorkoutReviewDecisionAtom(input: {
  id?: string;
  operation: Extract<WorkoutReviewOperation, 'confirm' | 'discard'>;
  targetAtom: WorkoutEvidenceAtom;
  observedAt: string;
  source?: WorkoutEvidenceSource;
  note?: string;
}): WorkoutEvidenceAtom {
  return buildWorkoutEvidenceAtom({
    id: input.id,
    descriptorId: `review:${input.operation}`,
    observedAt: input.observedAt,
    source: input.source ?? { kind: 'manual_review', label: 'Manual review' },
    subject: {
      kind: 'workout_review_decision',
      id: `${input.operation}:${input.targetAtom.id}`,
      label: input.operation === 'confirm' ? 'Looks right' : 'Remove entry',
    },
    dimensions: {
      'review.operation': { value: input.operation, role: 'review_operation', label: 'Review operation' },
      'review.target': { value: input.targetAtom.id, role: 'link', label: 'Saved entry' },
      ...(input.note ? { 'review.note': { value: input.note, role: 'note', label: 'Review note' } } : {}),
    },
    links: [
      {
        role: input.operation === 'confirm' ? 'confirms' : 'discards',
        targetId: input.targetAtom.id,
        targetKind: input.targetAtom.subject.kind,
      },
    ],
    confidence: { state: 'confirmed' },
    rawArtifactRefs: [],
    evidenceRefs: [],
  });
}

export function buildWorkoutCorrectionAtom(input: {
  id?: string;
  operation?: Extract<WorkoutReviewOperation, 'correct' | 'split' | 'merge'>;
  descriptorId?: string;
  targetAtom: WorkoutEvidenceAtom;
  additionalTargetAtoms?: WorkoutEvidenceAtom[];
  observedAt: string;
  source?: WorkoutEvidenceSource;
  subject?: WorkoutEvidenceSubject;
  dimensions: Record<string, WorkoutEvidenceValue>;
  rawArtifactRefs?: string[];
  evidenceRefs?: unknown[];
  note?: string;
}): WorkoutEvidenceAtom {
  const operation = input.operation ?? 'correct';
  const targetAtoms = [input.targetAtom, ...(input.additionalTargetAtoms ?? [])];
  const targetRole = operation === 'split' ? 'split_from' : operation === 'merge' ? 'merge_input' : 'corrects';
  return buildWorkoutEvidenceAtom({
    id: input.id,
    descriptorId: input.descriptorId ?? `review:${operation}`,
    observedAt: input.observedAt,
    source: input.source ?? { kind: 'manual_review', label: 'Manual review' },
    subject: input.subject ?? input.targetAtom.subject,
    dimensions: {
      ...input.dimensions,
      'review.operation': { value: operation, role: 'review_operation', label: 'Review operation' },
      ...(input.note ? { 'review.note': { value: input.note, role: 'note', label: 'Review note' } } : {}),
    },
    links: targetAtoms.map((targetAtom, order) => ({
      role: targetRole,
      targetId: targetAtom.id,
      targetKind: targetAtom.subject.kind,
      order,
    })),
    confidence: { state: 'confirmed' },
    rawArtifactRefs: input.rawArtifactRefs ?? input.targetAtom.rawArtifactRefs,
    evidenceRefs: input.evidenceRefs ?? input.targetAtom.evidenceRefs,
  });
}

export function buildWorkoutRawArtifact(input: {
  id?: string;
  kind: string;
  capturedAt: string;
  text?: string;
  ref?: string;
  source?: string;
}): WorkoutRawArtifact {
  return {
    id: input.id ?? `raw:${input.kind}:${stableSuffix([input.capturedAt, input.text ?? input.ref ?? 'artifact'])}`,
    kind: input.kind,
    capturedAt: input.capturedAt,
    ...(input.text ? { text: input.text } : {}),
    ...(input.ref ? { ref: input.ref } : {}),
    ...(input.source ? { source: input.source } : {}),
  };
}

export function appendWorkoutEvidence(log: WorkoutLogLike, atom: WorkoutEvidenceAtom, rawArtifact?: WorkoutRawArtifact): WorkoutLogState {
  const projection = ensureWorkoutLogProjection(log);
  const evidenceAtoms = mergeAtoms(projection.evidenceAtoms, [atom]);
  const rawArtifacts = rawArtifact
    ? [...projection.rawArtifacts.filter((artifact) => artifact.id !== rawArtifact.id), rawArtifact]
    : projection.rawArtifacts;
  return encodeWorkoutLogState({
    ...projection,
    evidenceAtoms,
    rawArtifacts,
  });
}
