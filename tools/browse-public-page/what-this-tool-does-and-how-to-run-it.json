       "type": "object",
       "required": [
        "origin",
        "pages",
        "videos",
        "remaining_pages"
       ],
       "properties": {
        "origin": {
         "type": "string"
        },
        "pages": {
         "type": "array",
         "items": {
          "type": "string"
         }
        },
        "videos": {
