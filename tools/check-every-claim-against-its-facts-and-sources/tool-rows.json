        "kind": "ai-tool-descriptor",
        "id": "tool:check-every-claim-against-its-facts-and-sources",
        "label": "Check every claim my narrator makes, spoken or on screen, against my facts and sources before it is voiced (runs on your computer)",
        "job": "Check every sentence my narrator says and every text on screen against the facts I keep and the sources I cite, and tell me which claims fail and why",
        "description": "Reads a run's shots (shots/<id>.json: the voice script and the on-screen events), their claims files (claims/<id>.json: one entry per spoken sentence and per on-screen text, each citing world facts, source wordings, transcript quotes or saved frames), the person's world rows (lists.json, rows/<list>.json, relations.json: entities, facts and relations) and their sources file with its plain-text extracts. The world's own check runs first (row shapes, links, roles, every fact's words at its transcript second or file line); then each shot fails a claim that: is not covered (script or screen text without an entry, or an entry for nothing); is about the subject but has no support said by someone other than the narrator; ignores a world fact on one of its topics; quotes a source or transcript that does not hold the words; is stronger than its source on a strength scale; says a number not derived from its cited numbers or outside its qualifier; breaks a bound a world fact sets; makes a comparison the numbers do not hold; counts a number in another container than its source; says something is visible without a saved frame; uses a private, believed, past or planned fact without saying so, a claim not recorded as its speaker's statement, or a conflicting fact it has not weighed; or carries a hedge or attribution phrase. Every rule word (strength scales, qualifiers, subject words, labels, tense markers, quantity units) is the person's settings, and the hedge phrases are their no-hedge check row's words. Prints each shot's report lines to standard error and one JSON answer.",
        "status": "active",
        "input_schema": {
          "type": "object",
          "required": [
            "request"
          ],
          "properties": {
            "request": {
              "type": "string",
              "description": "The request JSON file, put where {request} is in the command: {shots, lane_dir, sources, frames_root, world_dir, hedge_phrases, settings_record, settings?, path_map?, check_world?, quiet?}. settings_record is the person's list:settings row record:setting:check-every-claim-against-its-facts-and-sources~<scope_kind>~<scope_id> as selected from the person's database ({ id, type, value }) or its value, handed in as the row itself (the tool reads no rows itself); its settings hold rules, subject_name, narrator_name and hedge_row, and the request's own settings object lays over them. README.md: Request and Rules."
            }
          }
        },
        "output_schema": {
          "type": "object",
          "description": "Last line {\"result\": {\"ok\", \"shots\": [{\"id\", \"ok\", \"fails\", \"notes\", \"lines\"}], \"world\": {\"ok\", \"lines\"}}} with exit 0 when every shot passes and 1 when one fails, or {\"error\": \"what to change\"} with exit 2."
        },
        "invoke": {
          "kind": "on-your-computer",
          "get_it": [
            "clone the Workshop repository (package.json repository.url)"
          ],
          "run": "python3 -I tools/check-every-claim-against-its-facts-and-sources/do-work/check_claims.py < {request}",
          "needs": [
            "python",
            "node",
            "the person's world rows, sources, shots and claims files"
          ],
          "say": "This runs on the person's own computer, from the root of the Workshop checkout. Write the request with the folders of the shots and claims to check, the person's world rows and sources file, the words of their no-hedge check row as hedge_phrases, and their settings row (as selected from the person's database) as settings_record. Run `run` and read the last line: each failing shot lists what fails and why. A failing claim is cut or rewritten with real support; never fix it by adding a hedge or an attribution. Render or voice a line only when its shot passes."
        },
        "maker": "maker:check-every-claim-against-its-facts-and-sources",
        "licence_class": "licence:maker-own",
        "placements": [
          "placement:your-computer"
        ],
        "provenance": {
          "source": "Moved from a film repository's films/<film>/narrator/tools/fact_gate.py and test_fact_gate.py, with the parts of library/world/world.py it used; the rules, names and hedge list became the person's settings and rows"
        }
      }
    },
