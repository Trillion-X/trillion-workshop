        "kind": "ai-tool-descriptor",
        "id": "tool:make-plain-text-extracts-of-claim-sources",
        "label": "Make the plain-text copy of every source my claims cite, from the files I saved (runs on your computer)",
        "job": "Turn every source I saved for fact checking (a web page, a FoodData Central food, an edit plan, a text) into the plain text my claims are checked against",
        "description": "Reads a sources file ({\"sources\": {id: {raw, extract, text}}}) and writes each source's plain-text extract beside it: html (scripts and styles dropped, tags removed, entities decoded, spaces joined), fdc-json (a FoodData Central food as one line per nutrient amount per 100 g), new-order (an edit plan's new_order rows as one line each) or copy. A kind made by its own tool (a word-timed transcript, a text) keeps its extract and is refused when it is missing. Run it after adding or re-fetching a source; tool:check-every-claim-against-its-facts-and-sources checks quotes against these extracts.",
        "status": "active",
        "input_schema": {
          "type": "object",
          "required": [
            "request"
          ],
          "properties": {
            "request": {
              "type": "string",
              "description": "The request JSON file, put where {request} is: {\"sources\": the sources file}. Raw and text paths are relative to its folder or absolute."
            }
          }
        },
        "output_schema": {
          "type": "object",
