  "worked_examples": [
    {
      "title": "Work out a recipe's nutrients from USDA FoodData Central on a sample input",
      "ask": "Run tool:work-out-a-recipes-nutrients-from-fooddata-central.",
      "mcp": {
        "server": "trillion",
        "tool": "run_resource_operation",
        "input": {
          "address": "@workshop-tools",
          "method": "tools:run",
          "input": {
            "tool": "tool:work-out-a-recipes-nutrients-from-fooddata-central",
            "input": {
              "id": "made-up-smoothie",
              "title": "Made-up smoothie",
              "built": "2026-01-01T00:00:00+00:00",
              "datasets": {
                "made_up": {
                  "food_nutrient": "id,fdc_id,nutrient_id,amount\n1,101,1008,60\n2,101,1003,3\n3,101,1087,120\n4,102,2047,90\n5,102,1003,1\n6,102,1093,\n",
                  "food_portion": "id,fdc_id,seq_num,amount,measure_unit_id,portion_description,modifier,gram_weight\n1,101,1,1,1,,cup,240\n",
                  "food": "fdc_id,description\n101,Made-up drink\n102,Made-up fruit\n"
                }
              },
              "ingredients": [
                {
                  "id": "drink",
                  "name": "Made-up drink",
                  "amount": "1 cup",
                  "fdc_id": "101",
                  "dataset": "made_up",
                  "portion": {
                    "unit_contains": "cup",
                    "count": 1
                  },
                  "base": true
                },
                {
                  "id": "fruit",
                  "name": "Made-up fruit",
                  "amount": "100 g",
                  "fdc_id": "102",
                  "dataset": "made_up",
                  "grams": 100
                }
              ]
            }
          }
        }
      },
      "hands_back": "The answer's $.profile.mix_mass_g contains \"340\"."
    }
  ],
