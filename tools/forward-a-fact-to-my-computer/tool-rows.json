{
  "kind": "package-set-records",
  "record_set": "forward-a-fact-to-my-computer-tool-rows",
  "what_this_is": "The Workshop row that tells a fact this computer heard to another of the person's own computers (the door's wake:arrive through the gateway, pinned to the computer its wake's input names), so a fact only this computer can see is handled where the person's work runs. Its key is a held value made for wake:arrive alone and kept with the gateway's host alone, handed to the one process on descriptor 3.",
  "records": [
    {
      "payload": {
        "kind": "ai-tool-descriptor",
        "id": "tool:forward-a-fact-to-my-computer",
        "label": "Forward a fact to my computer",
        "job": "Tell a fact this computer heard to another of my computers, so the work it starts runs there",
        "description": "Woken by a fact one of its wakes hears (one wake per kind, each switched on with the computer to tell it to as `to`), it calls the gateway's door with that fact as wake:arrive, pinned to `to`, under the request key fact:<event id>. The far computer takes it as told by a sender and admits it once per event id, so a retry is safe. Answers what the far computer said: kept, how many of its wakes hear it, or that none does (no_wake_hears, an answer, never asked again). A refused key (401), a gateway or far computer that does not answer, or a computer the meeting point does not carry fails the run with words that say which; the wake's retry asks again and, once spent, the wake is failed with that cause. This tool's own failures are never forwarded. The gateway's door is your own address, given beside `to` in each wake's input as `door`, and each fact carries the input's `forwarded_from` in its payload, so the far wake hears only forwarded facts. Nothing is told while a wake of another tool on this computer still hears the same kind from the same teller: the work would run on both computers. No wake is on until it is switched on, one kind at a time, when that kind's work moves. The key is forward-facts-to-my-computer-key: made by the sign-in tool for wake:arrive alone and kept with your gateway's host as its only host, so the run reaches that host and no other.",
        "status": "active",
        "input_schema": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "to",
            "door",
            "forwarded_from"
          ],
          "properties": {
            "to": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9_-]+$",
              "description": "The computer to tell each fact to: one of your computers' names as the meeting point carries it."
            },
            "door": {
              "type": "string",
              "minLength": 9,
              "pattern": "^https://",
              "description": "Your gateway's door, the https address your AIs reach your account at (https://<your gateway>/mcp): the call to `to` is made there."
            },
            "forwarded_from": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]{0,63}$",
              "description": "The label every forwarded fact carries in its payload as forwarded_from (for example mac), so the far computer's wake hears only forwarded facts by matching it."
            }
          }
        },
        "output_schema": {
          "type": "object",
          "required": [
            "to",
            "kind",
            "event_id"
          ],
          "properties": {
            "to": {
              "type": "string"
            },
            "computer": {
              "type": "string"
            },
            "kind": {
              "type": "string"
            },
            "event_id": {
              "type": "string"
            },
            "request_key": {
              "type": "string"
            },
            "kept": {
              "type": "boolean"
            },
            "heard_by": {
              "type": "integer"
            },
            "starts": {
              "type": "string"
            },
            "not_heard": {
              "type": "object"
            },
            "forwarded": {
              "type": "boolean"
            },
            "why": {
              "type": "string"
            }
          }
        },
        "result_selector": "$",
        "invoke": {
          "kind": "container",
          "internet": true,
          "workdir": "/opt/forward-a-fact-tree/tools/forward-a-fact-to-my-computer",
          "stdout": "json",
          "argv": [
            "node",
            "/opt/forward-a-fact-tree/tools/forward-a-fact-to-my-computer/do-work/forward-a-fact.mjs"
          ],
          "stdin": {
            "input": {
              "fill": {
                "from": "input"
              }
            },
            "fact": {
              "fill": {
                "from": "task",
                "field": "cause.detail"
              }
            }
          },
          "credential_mounts": [
            {
              "secret_name": "forward-facts-to-my-computer-key",
              "fd": 3
            }
          ],
          "records": {
            "fd": 4,
            "rights": [
              {
                "at": "@own-records",
                "id": "something-showed-up",
                "operations": [
                  "wake:list"
                ]
              },
              {
                "at": "@own-records",
                "id": "ai-connected",
                "operations": [
                  "wake:list"
                ]
              },
              {
                "at": "@own-records",
                "id": "asked-from-an-app",
                "operations": [
                  "wake:list"
                ]
              },
              {
                "at": "@own-records",
                "id": "tool-ran",
                "operations": [
                  "wake:list"
                ]
              },
              {
                "at": "@own-records",
                "id": "wake-failed",
                "operations": [
                  "wake:list"
                ]
              },
              {
                "at": "@own-records",
                "id": "something-changed",
                "operations": [
                  "wake:list"
                ]
              }
            ]
          },
          "files": {
            "package_files": [
              {
                "package": "forward-a-fact-to-my-computer",
                "paths": [
                  "do-work",
                  "read-data"
                ],
                "at": "/opt/forward-a-fact-tree/tools/forward-a-fact-to-my-computer"
              },
              {
                "package": "content-identity",
                "paths": [
                  "read-data/identity.mjs",
                  "read-data/blake3.mjs"
                ],
                "at": "/opt/forward-a-fact-tree/tools/content-identity"
              },
              {
                "package": "http-client",
                "paths": [
                  "do-work/node-public-fetch.mjs",
                  "do-work/resolved-address.mjs",
                  "do-work/resolved-address.json",
                  "do-work/same-origin.mjs"
                ],
                "at": "/opt/forward-a-fact-tree/tools/http-client"
              },
              {
                "package": "refuse-requests-to-private-addresses",
                "paths": [
                  "public-address.mjs",
                  "public-address.json"
                ],
                "at": "/opt/forward-a-fact-tree/tools/refuse-requests-to-private-addresses"
              },
              {
                "package": "run-sql-in-my-database",
