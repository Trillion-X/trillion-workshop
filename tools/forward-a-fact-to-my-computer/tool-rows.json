                ],
                "at": "/opt/node_modules/tldts-core"
              }
            ]
          }
        },
        "needs": {
          "expected_seconds": 30,
          "network_egress": true,
          "memory_mb": 128
        },
        "maker": "maker:forward-a-fact-to-my-computer",
        "licence_class": "licence:maker-own",
        "placements": [
          "placement:your-computer"
        ],
        "provenance": {
          "source": "Written for the Workshop: one fact told to another of the person's computers through the gateway's door, on the existing public fetch (http-client) and request-key identity (content-identity); Nov 25 2026, so facts only one computer sees are handled on the computer that now holds the person's databases"
        },
        "verify": [
          {
            "kind": "needs-a-machine",
            "requires": "a key made for wake:arrive held as forward-facts-to-my-computer-key, the person's gateway door, and the computer named by `to` carried there (a made-up key cannot answer it)",
            "proved_on": null
          }
        ],
        "wakes": [
          {
            "id": "forward-something-showed-up",
            "needs_input": [
              "to",
              "door",
              "forwarded_from"
            ],
            "on": {
