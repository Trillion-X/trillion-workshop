{
  "records": [
    {
      "id": "package::sync-files-between-my-computers::tool::say-where-file-sync-stands",
      "address": "package::sync-files-between-my-computers::tool::say-where-file-sync-stands",
      "path": [
        "current-item",
        "published-record"
      ],
      "payload": {
        "kind": "ai-tool-descriptor",
        "id": "tool:say-where-file-sync-stands",
        "label": "Say where file sync stands",
        "status": "active",
        "job": "Say where the sync of a person's files on one computer stands: starting, synced, syncing, offline, conflict or error, why Trillion was not reached, and how many saves are still moving",
        "description": "Gives one typed sync status record from what the computer's change feed and write journal observed. The state is the first DATA row (sync-files.json sync_status) whose every condition holds; a failed ask is filed under the cause its answer status names (no_network, signed_out, storage_full, busy, trillion_unavailable, else refused). A feed that was never answered is starting, never read as empty or synced. Names, file identities and keys never enter the record: only counts, a cause and a status.",
        "input_schema": {
          "type": "object",
          "required": [
            "feed"
          ],
          "additionalProperties": false,
          "properties": {
            "feed": {
              "type": "object",
              "required": [
                "version",
                "reached_at",
                "failure"
              ],
              "properties": {
                "version": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "description": "The change count read up to"
                },
                "reached_at": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "description": "When Trillion last answered, in ms since 1970; null when never"
                },
                "failure": {
                  "type": [
                    "object",
                    "null"
                  ],
                  "properties": {
                    "status": {
                      "type": "integer"
                    },
                    "at": {
                      "type": "number"
                    }
                  },
                  "description": "The last failed ask: its answer status (left out when no answer came) and when, in ms"
                }
              }
            },
            "writes": {
              "type": [
                "object",
                "null"
              ],
              "properties": {
                "owing": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "size": {
                        "type": "integer"
                      }
                    }
                  }
                },
                "conflicts": {
                  "type": "array"
                },
                "failed": {
                  "type": "array"
                }
              },
              "description": "The write journal's status: saves still moving, kept aside as conflicts, and failed. Null when nothing is written from this computer"
            }
          }
        },
        "output_schema": {
          "type": "object",
          "required": [
            "state",
            "said"
          ],
          "properties": {
            "state": {
              "type": "string"
            },
            "version": {
              "type": [
                "integer",
                "null"
              ]
            },
            "network": {
              "type": "object"
            },
            "error": {
              "type": [
                "object",
                "null"
              ]
            },
            "moving": {
              "type": "object"
            },
            "conflicts": {
              "type": "integer"
            },
            "failed": {
              "type": "integer"
            },
            "said": {
              "type": "string"
            }
          }
        },
        "invoke": {
          "kind": "container",
          "files": {
            "package_files": [
              {
                "package": "sync-files-between-my-computers",
                "paths": [
                  "do-work"
                ],
                "at": "/opt/sync-files-between-my-computers"
              },
              {
                "package": "records-door",
                "paths": [
                  "do-work",
                  "read-data"
                ],
                "at": "/opt/records-door"
              },
              {
                "package": "content-identity",
                "paths": [
                  "read-data"
                ],
                "at": "/opt/content-identity"
              },
              {
                "module": "@noble/hashes",
                "paths": [
                  "LICENSE",
                  "package.json",
                  "blake3.js",
                  "blake2.js",
                  "_blake.js",
                  "_md.js",
                  "_u64.js",
                  "utils.js"
                ],
                "at": "/opt/node_modules/@noble/hashes"
              }
            ]
          },
          "workdir": "/opt/sync-files-between-my-computers",
          "internet": false,
          "stdout": "json",
          "argv": [
            "node",
            "/opt/records-door/do-work/run-an-export.mjs",
            "/opt/sync-files-between-my-computers/do-work/drive-sync-status.mjs",
            "sayWhereFileSyncStands"
          ],
          "stdin": {
            "fill": {
              "from": "input"
            }
          }
        },
        "needs": {
          "expected_seconds": 1,
          "network_egress": false
        },
        "licence_class": "licence:maker-own",
        "placements": [
          "placement:small-container"
        ],
        "maker": "maker:sync-files-between-my-computers",
        "result_selector": "$.result",
        "provenance": {
          "source": "Trillion-X/trillion computer/drive-sync-status.mjs at 3d6dc7f9e^ (deleted from origin/main by 3d6dc7f9e)"
        },
        "verify": [
          {
            "kind": "sample-run",
            "input": {
              "feed": {
                "version": 7,
                "reached_at": 1792404000000,
                "failure": null
              },
              "writes": {
                "owing": [
                  {
                    "size": 10
                  },
                  {
                    "size": 5
                  }
                ],
                "conflicts": [],
                "failed": []
              }
            },
            "output_selector": "$.state",
            "contains": "syncing"
          }
        ]
      }
    },
    {
      "id": "package::sync-files-between-my-computers::tool::keep-a-local-file-in-my-files",
      "address": "package::sync-files-between-my-computers::tool::keep-a-local-file-in-my-files",
      "path": [
        "current-item",
        "published-record"
      ],
      "payload": {
        "kind": "ai-tool-descriptor",
        "id": "tool:keep-a-local-file-in-my-files",
        "label": "Keep a file from my computer in my Files",
        "status": "active",
        "job": "Keep files from the person's computer in their Files under names they choose: one file or a list of files, each kept in order; a small file in pieces, a large one over the lease road",
        "description": "Runs on the person's computer with the drives they granted it to see and the folder changes they granted. Keeps one regular file (not a link, not a folder) or a list of them (at most DATA most_files, keep-a-local-file.json) into the person's Files under the names given. A small file is written in pieces that each fit one request; a file above the whole-file threshold goes over the lease road in chunks. A file that is refused or fails is named in refused with its reason, and the others are still kept. Returns kept (name, bytes, media_type, finished) and refused. Deletes and moves nothing.",
        "input_schema": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "path": {
              "type": "string",
              "description": "The file's full path on this computer"
            },
            "name": {
              "type": "string",
              "description": "The name in Files: folders by slash; letters, digits, dots, dashes and underscores only"
            },
            "media_type": {
              "type": "string",
              "description": "A type like video/mp4; application/octet-stream when left out"
            },
            "files": {
              "type": "array",
              "minItems": 1,
              "maxItems": 256,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "path",
                  "name"
                ],
                "properties": {
                  "path": {
                    "type": "string",
                    "description": "The file's full path on this computer"
                  },
                  "name": {
                    "type": "string",
                    "description": "The name in Files: folders by slash; letters, digits, dots, dashes and underscores only"
                  },
                  "media_type": {
                    "type": "string",
                    "description": "A type like video/mp4; application/octet-stream when left out"
                  }
                }
              },
              "description": "A list of files kept in order; use this instead of path and name"
            }
          }
        },
        "output_schema": {
          "type": "object",
          "required": [
            "kept",
            "refused"
          ],
          "properties": {
            "kept": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "name",
                  "bytes",
                  "media_type",
                  "finished"
                ],
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "bytes": {
                    "type": "integer"
                  },
                  "media_type": {
                    "type": "string"
                  },
                  "finished": {
                    "type": "object"
                  }
                }
              }
            },
            "refused": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "path",
                  "name",
                  "code",
                  "reason"
                ],
                "properties": {
                  "path": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "name": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "code": {
                    "type": "string"
                  },
                  "reason": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "invoke": {
          "kind": "computer",
          "capabilities": [
            "see-connected-drives",
            "change-a-folder"
          ],
          "workdir": "/opt/sync-files-between-my-computers",
          "stdout": "json",
          "argv": [
            "node",
            "/opt/records-door/do-work/run-an-export.mjs",
            "/opt/sync-files-between-my-computers/do-work/keep-a-local-file.mjs",
            "keepALocalFile"
          ],
          "stdin": {
            "fill": {
              "from": "input"
            }
          },
          "files": {
            "package_files": [
              {
                "package": "sync-files-between-my-computers",
                "paths": [
                  "do-work"
                ],
                "at": "/opt/sync-files-between-my-computers"
              },
              {
                "package": "records-door",
                "paths": [
                  "do-work",
                  "read-data"
                ],
                "at": "/opt/records-door"
              },
              {
                "package": "browse-and-upload-my-files",
                "paths": [
                  "do-work",
                  "built-stored-bytes",
                  "send-settings.json"
                ],
                "at": "/opt/browse-and-upload-my-files"
              },
              {
                "package": "content-identity",
                "paths": [
                  "read-data"
                ],
                "at": "/opt/content-identity"
              },
              {
                "module": "@noble/hashes",
                "paths": [
                  "LICENSE",
                  "package.json",
                  "blake3.js",
                  "blake2.js",
                  "_blake.js",
                  "_md.js",
                  "_u64.js",
                  "utils.js"
                ],
                "at": "/opt/node_modules/@noble/hashes"
              }
            ]
          }
        },
        "result_selector": "$.result",
        "needs": {
          "expected_seconds": 3600,
          "network_egress": false
        },
        "maker": "maker:sync-files-between-my-computers",
        "licence_class": "licence:maker-own",
        "placements": [
          "placement:your-computer"
        ]
      }
    }
  ]
}
