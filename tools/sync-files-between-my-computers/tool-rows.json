        "kind": "ai-tool-descriptor",
        "id": "tool:keep-a-local-file-in-my-files",
        "label": "Keep a file from my computer in my Files",
        "status": "active",
        "job": "Keep files from the person's computer in their Files under names they choose: one file or a list of files, each kept in order; a small file in pieces, a large one over the lease road",
        "description": "Runs on the person's computer with the drives they granted it to see and the folder changes they granted. Keeps one regular file (not a link, not a folder) or a list of them (at most DATA most_files, keep-a-local-file.json) into the person's Files under the names given. A small file is written in pieces that each fit one request; a file above the whole-file threshold goes over the lease road in chunks. A file that is refused or fails is named in refused with its reason, and the others are still kept. Returns kept (name, bytes, media_type, finished) and refused. Deletes and moves nothing.",
        "input_schema": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "path": {
              "type": "string",
              "description": "The file's full path on this computer"
            },
            "name": {
              "type": "string",
              "description": "The name in Files: folders by slash; letters, digits, dots, dashes and underscores only"
            },
            "media_type": {
              "type": "string",
              "description": "A type like video/mp4; application/octet-stream when left out"
            },
            "files": {
              "type": "array",
              "minItems": 1,
              "maxItems": 256,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "path",
                  "name"
                ],
                "properties": {
                  "path": {
                    "type": "string",
                    "description": "The file's full path on this computer"
                  },
                  "name": {
                    "type": "string",
                    "description": "The name in Files: folders by slash; letters, digits, dots, dashes and underscores only"
                  },
                  "media_type": {
                    "type": "string",
                    "description": "A type like video/mp4; application/octet-stream when left out"
                  }
                }
              },
              "description": "A list of files kept in order; use this instead of path and name"
            },
            "stored": {
              "type": "object",
              "description": "What this run reads of the person's own things, read by the caller from where the person keeps them (the engine keeps none) and given here: files: {name: text or {base64}} under /, as this row's `stored` lists. What is not given is not there."
            }
          }
        },
        "output_schema": {
          "type": "object",
          "required": [
            "kept",
            "refused"
          ],
          "properties": {
            "kept": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "name",
                  "bytes",
                  "media_type",
                  "finished"
                ],
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "bytes": {
                    "type": "integer"
                  },
                  "media_type": {
                    "type": "string"
                  },
                  "finished": {
                    "type": "object"
                  }
                }
              }
            },
            "refused": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "path",
                  "name",
                  "code",
                  "reason"
                ],
                "properties": {
                  "path": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "name": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "code": {
                    "type": "string"
                  },
                  "reason": {
                    "type": "string"
                  }
                }
              }
            },
            "keep": {
              "type": "array",
              "description": "What the run made, for the caller to keep where the person keeps it: rows {id, type, value} (value null removes), settings {label, value}, files {file, base64}. The run itself writes nothing."
            }
          }
        },
        "invoke": {
          "kind": "computer",
          "capabilities": [
            "see-connected-drives",
            "read-a-folder"
          ],
          "workdir": "/opt/sync-files-between-my-computers",
          "stdout": "json",
          "argv": [
            "node",
            "/opt/workflows/do-work/run-a-function.mjs",
            "/opt/sync-files-between-my-computers/do-work/keep-a-local-file.mjs",
            "keepALocalFile"
          ],
          "stdin": {
            "fill": {
              "from": "input"
            }
          },
          "files": {
            "package_files": [
              {
                "package": "sync-files-between-my-computers",
                "paths": [
                  "do-work"
                ],
                "at": "/opt/sync-files-between-my-computers"
              },
              {
 "package": "workflows",
 "paths": [
   "do-work/run-a-function.mjs",
   "read-data/host-actions.mjs",
   "read-data/whole-file.mjs",
   "read-data/large-file.json"
 ],
 "at": "/opt/workflows"
},
              {
                "package": "browse-and-upload-my-files",
                "paths": [
                  "do-work",
                  "built-stored-bytes",
                  "send-settings.json"
                ],
                "at": "/opt/browse-and-upload-my-files"
              },
              {
                "package": "content-identity",
                "paths": [
                  "read-data"
                ],
                "at": "/opt/content-identity"
              },
              {
                "packages": ["node_modules/@noble/hashes"],
                "paths": [
                  "LICENSE",
                  "package.json",
                  "blake3.js",
                  "blake2.js",
                  "_blake.js",
                  "_md.js",
                  "_u64.js",
                  "utils.js"
                ],
                "at": "/opt/node_modules/@noble/hashes"
              }
            ]
          }
        },
        "verify": [
          {
            "kind": "sample-run",
            "input": {
              "path": "{grant:read-a-folder}/clips/sample-note.txt",
              "name": "/clips/sample-note.txt",
              "media_type": "text/plain"
            },
            "files": [
              {
                "grant": "read-a-folder",
                "path": "clips/sample-note.txt",
                "text": "A made-up note kept in Files.\n"
              }
            ]
          }
        ],
        "result_selector": "$.result",
        "needs": {
          "expected_seconds": 3600,
          "network_egress": false
        },
        "maker": "maker:sync-files-between-my-computers",
        "licence_class": "licence:maker-own",
        "placements": [
          "placement:your-computer"
        ],
        "stored": [
          {
            "files": "/",
            "operations": [
              "write_file_start",
              "write_file_piece",
              "write_file_finish"
            ]
          }
        ]
      }
    }
  ]
}
