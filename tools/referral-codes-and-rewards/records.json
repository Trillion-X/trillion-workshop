   ],
   "payload": {
    "kind": "ai-tool-descriptor",
    "id": "tool:work-out-referral-codes",
    "label": "Work out referral codes",
    "status": "active",
    "job": "See which referral codes are live, what a friend who types one gets, and what each sale earns under my referral reward rules",
    "description": "Reads the referral events a person saved (a code made, a code withdrawn, a signup that named a referrer) and works out the codes: who made each one, what it points at, and whether it is still live. The first account to make a code keeps it, in any order the events arrive; only the account that made a code can withdraw it. The rules are the person's own rows in their referral reward rules list (one row per rule: who earns, the kind of reward, its terms, which codes and sales it applies to), given in `rules`; nothing about a price, a product or an amount is in the tool. Give it the codes buyers typed and it says for each which live code that is and what the rules give the friend who typed it; give it sales too and it says for each pair whether the sale earns the code and what every rule gives: a whole-cent share, a discount (a checkout code that take-payments takes off a price) a customer credit for the referrer (given through take-payments' giveACustomerCredit), or access (a grant). It adds up only: it moves no money, reads nothing and keeps nothing. tool:give-referral-rewards gives the discount and access rows and names the customer credits.",
    "input_schema": {
     "type": "object",
     "required": [
      "events",
      "rules"
     ],
     "properties": {
      "events": {
       "type": "array",
       "items": {
        "type": "object"
       },
       "description": "The referral events: { kind?, subject, material: { event_type?, referral_code?, target?, referrer_account_id?, occurred_at } }"
      },
      "codes": {
       "type": "array",
       "items": {
        "type": "string"
       },
       "description": "Codes buyers typed, to check"
      },
      "sales": {
       "type": "array",
       "items": {
        "type": "object"
       },
       "description": "Sale records; each typed code is checked against each sale. A sale has the attributes codes point at, the amount fields shares read, and for a discount or access reward an id (and occurred_at_ms for access that lasts days)"
      },
      "account": {
       "type": "string",
       "description": "Count this account's newest code and accepted referrals"
      },
      "rules": {
       "type": "array",
       "items": {
        "type": "object"
       },
       "description": "The person's referral reward rule rows, each { id, type?, value }, as read from their referral reward rules list (their AI reads them; this tool reads and keeps nothing)"
      }
     },
     "additionalProperties": false
    },
    "output_schema": {
     "type": "object",
     "required": [
      "codes",
      "rules_used",
      "rules_refused"
     ],
     "properties": {
      "codes": {
       "type": "array"
      },
      "typed": {
       "type": "array"
      },
      "checked": {
       "type": "array"
      },
      "state": {
       "type": "object"
      },
      "rules_used": {
       "type": "array",
       "items": {
        "type": "string"
       }
      },
      "rules_refused": {
       "type": "array",
       "description": "Active rule rows that were skipped, each with why"
      }
     }
    },
    "invoke": {
     "kind": "container",
     "files": {
      "package_files": [
       {
        "package": "formula-engine",
        "paths": [
         "rules",
         "built-stored-bytes"
        ],
        "at": "/opt/node_modules/trillion-workshop/tools/formula-engine"
       },
       {
        "package": "referral-codes-and-rewards",
        "paths": [
