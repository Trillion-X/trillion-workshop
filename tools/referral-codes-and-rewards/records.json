    "kind": "ai-tool-descriptor",
    "id": "tool:give-referral-rewards",
    "label": "Give referral rewards",
    "status": "active",
    "job": "Give the rewards my referral reward rules say a code earns: a discount code, or access, written once",
    "description": "Works out the codes exactly as tool:work-out-referral-codes does, from the person's own referral reward rules, then writes what the rules give as the records the existing tools already read. A discount is a checkout-code-adjustment row, so take-payments takes it off a price like any other checkout code: for the friend it is the referral code itself (typed at checkout, for as long as the rule says), for the referrer it is a checkout code of its own named from the rule and the sale (given back in the answer). Access is an access-grant row, written the way tool:grant-paid-access-to-people writes it. Every reward has an id made from the rule and the code or sale, so running the same request again writes nothing and counts it as already; a reward already kept with different terms stays as it was and is refused with why. A share is not written: its whole-cent amount is in the answer for the person to pay however they pay people. This tool sends nothing and moves no money.",
    "input_schema": {
     "type": "object",
     "required": [
      "events"
     ],
     "properties": {
      "events": {
       "type": "array",
       "items": {
        "type": "object"
       },
       "description": "The referral events: { kind?, subject, material: { event_type?, referral_code?, target?, referrer_account_id?, occurred_at } }"
      },
      "codes": {
       "type": "array",
       "items": {
        "type": "string"
       },
       "description": "Codes buyers typed, to check"
      },
      "sales": {
       "type": "array",
       "items": {
        "type": "object"
       },
       "description": "Sale records; each typed code is checked against each sale. A sale has the attributes codes point at, the amount fields shares read, and for a discount or access reward an id (and occurred_at_ms for access that lasts days)"
