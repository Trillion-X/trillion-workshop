         "type": "string"
        },
        "value": {
         "type": "string"
        }
       },
       "description": "The sale attribute and the value a sale must have to earn this code"
      },
      "prefix": {
       "type": "string",
       "description": "Letters the made code starts with"
      },
      "code": {
       "type": "string",
       "description": "A code you chose, 4 to 32 letters, digits or dashes"
      },
      "occurred_at": {
       "type": "string",
       "description": "When it was made; now when absent"
      }
     },
