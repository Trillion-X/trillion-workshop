       "type": "string",
       "description": "Count this account's newest code and accepted referrals"
      }
     },
     "additionalProperties": false
    },
    "output_schema": {
     "type": "object",
     "required": [
      "codes",
      "rules_used",
      "rules_refused",
      "given"
     ],
     "properties": {
      "codes": {
       "type": "array"
      },
      "typed": {
       "type": "array"
      },
      "checked": {
       "type": "array"
      },
      "state": {
       "type": "object"
      },
      "rules_used": {
       "type": "array"
      },
      "rules_refused": {
       "type": "array"
      },
