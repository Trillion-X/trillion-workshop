    "kind": "ai-tool-descriptor",
    "id": "tool:make-a-referral-code",
    "label": "Make a referral code",
    "status": "active",
    "job": "Make a referral code that earns what my referral reward rules give, and give back the event to save",
    "description": "Makes a short readable code (letters and digits, no I, L, O or U, so it survives being read aloud) or checks the one you chose, and gives back the event that makes it live once the person saves it. You say what the code points at: the sale attribute and the value it must have. A code may point only at an attribute one of the person's active referral reward rules names, because a code no rule applies to earns nothing; with no active rule it says to add one first. A code someone else already made stays theirs when the events are read. Nothing is kept by the tool.",
    "input_schema": {
     "type": "object",
     "required": [
      "referrer",
      "target"
     ],
     "properties": {
      "referrer": {
       "type": "string",
