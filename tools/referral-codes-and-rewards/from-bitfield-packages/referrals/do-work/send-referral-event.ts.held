// packages/referrals/do-work/send-referral-event.ts
//
// Sign a referral lifecycle event and admit it through the signed event authority.

import { sendRequestToBitfieldTarget } from '@bitfield/runtime-kit';

const SIGNED_EVENT_AUTHOR_TARGET = 'signed-event-author.sign-event';
const SIGNED_EVENT_ADMISSION_TARGET = 'signed-event-authority.admit-event';

function decodeTargetReply<TResponse>(payload: Uint8Array): TResponse {
  const text = new TextDecoder().decode(payload);
  return (text.trim() ? JSON.parse(text) : {}) as TResponse;
}

export interface ReferralEventInput {
  accountId: string;
  eventType: 'referral_code_created' | 'referral_code_applied';
  eventId: string;
  occurredAt: string;
  referralCode: string;
  requestId?: string;
}

export async function sendReferralEvent<TResponse>(
  input: ReferralEventInput,
): Promise<TResponse> {
  const signedEvent = decodeTargetReply<Record<string, unknown>>((await sendRequestToBitfieldTarget({
    target: SIGNED_EVENT_AUTHOR_TARGET,
    payload: {
      payload: {
        event_id: input.eventId,
        occurred_at: input.occurredAt,
        idempotency_key: input.requestId ?? input.eventId,
        supersedes: [],
        facts: [{
          fact_id: `${input.eventId}:referral`,
          subject: input.accountId,
          relation: 'referral.lifecycle',
          object: input.eventType,
          attributes: {
            event_type: input.eventType,
            occurred_at: input.occurredAt,
            referral_code: input.referralCode,
          },
        }],
      },
    },
  })).payload);
  const reply = await sendRequestToBitfieldTarget({
    target: SIGNED_EVENT_ADMISSION_TARGET,
    payload: input.requestId
      ? { body: { events: [signedEvent] }, request_id: input.requestId }
      : { body: { events: [signedEvent] } },
  });
  return decodeTargetReply<TResponse>(reply.payload);
}

export function makeReferralCode(accountId: string, prefix = 'REF') {
  const suffix = accountId.replace(/[^a-z0-9]/gi, '').slice(-6).toUpperCase();
  const random = Math.random().toString(36).slice(2, 6).toUpperCase();
  const normalizedPrefix = prefix.replace(/[^a-z0-9]/gi, '').toUpperCase().slice(0, 24) || 'REF';
  return `${normalizedPrefix}-${suffix}${random}`;
}
