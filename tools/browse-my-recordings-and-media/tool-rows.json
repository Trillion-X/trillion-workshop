        ],
        "needs": {
          "expected_seconds": 2,
          "network_egress": false,
          "memory_mb": 128
        },
        "label": "List my recordings and media",
        "job": "List a person's recordings and the videos, sounds and pictures their tools made or they saved, newest first, each with what is known about it, as the Media screen shows a page",
        "description": "Give files ([{ name, identity, byte_length?, modified_at_ms? }], names starting with /), results kept about them ([{ identity, kind, value }]: kind library-entry makes a recording row from its value { name?, path?, media_kind? }; title, summary, organization, facts, transcript and the other kinds media-library.json joins add to a row), optionally set_aside (files or folders to delete first, as Recently Deleted does) and page ({ limit? (1 to 60), origin? (recording, made or file), unused? }). The files are named in the namespace (namespace-store.mjs, from tools/recently-deleted-and-storage) and the results laid in a namespace_results table as old trillion's namespace-results.mjs made it, in an in-memory SQLite database; then media-library.mjs's own mediaLibraryPage reads the page. Answers rows (identity, origin, name, path, media_kind, media_type, stored, captured_ms, title, duration, facts, edits, words), next_after, origin_labels and revision. A file that is not video, sound or a picture is no row, and a file set aside with no name left is none either. No bytes are held, so every row says stored: false; nothing is kept after the run, no file is written and nothing is sent. Refuses no files, a result without identity, kind and value, and what the page refuses. The screen also plays a row, suggests the next edit and searches for a spoken or seen moment; this run does none of that.",
        "read_only": true,
        "input_schema": {
          "type": "object",
          "required": [
            "files"
          ],
          "additionalProperties": false,
          "properties": {
            "files": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": [
                  "name",
                  "identity"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "pattern": "^/"
                  },
                  "identity": {
                    "type": "string",
                    "pattern": "^(1f|12):[0-9a-f]{64}$"
                  },
                  "byte_length": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "modified_at_ms": {
                    "type": "integer"
                  }
                }
              }
            },
            "results": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "identity",
                  "kind",
                  "value"
                ],
                "properties": {
                  "identity": {
                    "type": "string"
                  },
                  "kind": {
                    "type": "string"
                  },
                  "value": {}
                }
              }
            },
            "set_aside": {
