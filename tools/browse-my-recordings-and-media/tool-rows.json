              "additionalProperties": false,
              "properties": {
                "limit": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 60
                },
                "origin": {
                  "type": "string",
                  "enum": [
                    "recording",
                    "made",
                    "file"
                  ]
                },
                "unused": {
                  "type": "boolean"
                }
              }
            }
          }
