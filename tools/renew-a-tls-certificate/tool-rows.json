{
  "kind": "tool-rows",
  "record_set": "renew-a-tls-certificate-tool-rows",
  "what_this_is": "The Workshop rows for tools/renew-a-tls-certificate: a rented server's public certificate by DNS-01 (issue, renew, read), the server's certificate owner (set up, update, check on the server), the public host's paths and its receptionist. Every row runs one process on the person's computer that reaches the server as root over SSH with its pinned key, through the engine's proxy; the server's administration key is a file the engine mounts for the run and the DNS key (issue and renew) arrives on descriptor 3. Every fact about the server is the input; the renewal schedule is a wake the person declares for tool:renew-a-tls-certificate.",
  "records": [
    {
      "id": "package::renew-a-tls-certificate::tool::renew-a-tls-certificate",
      "address": "package::renew-a-tls-certificate::tool::renew-a-tls-certificate",
      "path": ["current-item", "published-record"],
      "payload": {
        "kind": "ai-tool-descriptor",
        "id": "tool:renew-a-tls-certificate",
        "label": "Renew a server's TLS certificate",
        "job": "Renew the certificate of my server's public address before it runs out, and check every DNS record stayed as it was",
        "description": "Asks the server's certificate owner (installed by tool:set-up-a-servers-tls-owner) to renew the certificate of `hostname` by DNS-01 with the person's DNS key: certbot renews only when the certificate is due, every DNS record is read before and after and any change fails the run, and a changed certificate restarts the receptionist (checked through public TLS) and reloads the public host. `dryRun: true` renews against the certificate authority's staging server and changes no certificate. Answers the certificate as the server verified it (present, trusted for the name, valid from and until in local time, issuer, serial, key mode), whether it changed and whether this was a dry run. Declare a wake for this row (every 6 hours) with the server's facts as its input to keep the address renewed. The DNS key reaches the server only on the SSH process's private input; no error carries it.",
        "status": "active",
        "input_schema": {
          "type": "object",
          "required": ["hostname", "address", "knownHost", "host"],
          "additionalProperties": false,
          "properties": {
            "hostname": { "type": "string", "maxLength": 253, "description": "The server's public address, like app.example.com" },
            "address": { "type": "string", "maxLength": 15, "description": "The server's IPv4 address" },
            "knownHost": { "type": "string", "maxLength": 200, "description": "The server's pinned SSH key: \"<address> ssh-ed25519 <key>\"" },
            "host": { "type": "object", "description": "The server's layout: owner, state, downloads, ingress, receptionist, site (see this folder's README)" },
            "remotePort": { "type": "integer", "minimum": 1, "maximum": 65535 },
            "receptionistBinary": { "type": "string", "maxLength": 300 },
            "connectionDiagnostics": { "type": "boolean" },
            "tokenField": { "type": "string", "maxLength": 64, "description": "When the DNS key is held as fields, the one that holds the token (default token)" },
            "dryRun": { "type": "boolean", "description": "Renew against the staging server and change no certificate" }
          }
        },
        "output_schema": {
          "type": "object",
          "required": ["hostname", "certificate_present"],
          "properties": {
            "hostname": { "type": "string" }, "certificate_present": { "type": "boolean" },
            "system_trust_and_hostname_verified": { "type": "boolean" }, "not_before_local": { "type": "string" }, "not_after_local": { "type": "string" },
            "issuer": { "type": "string" }, "serial": { "type": "string" }, "private_key_mode": { "type": "string" },
            "preexisting_dns_records_unchanged": { "type": "boolean" }, "certificate_changed": { "type": "boolean" }, "dry_run": { "type": "boolean" }
          }
        },
        "invoke": {
          "kind": "container",
          "internet": true,
          "max_run_ms": 660000,
          "workdir": "/opt/renew-a-tls-certificate",
          "stdout": "json",
          "argv": ["node", "/opt/renew-a-tls-certificate/do-work/renew-a-tls-certificate.mjs", "renew", "/held/server-administration-key"],
          "stdin": { "fill": { "from": "input" } },
          "files": { "package_files": { "package": "renew-a-tls-certificate", "paths": ["do-work"], "at": "/opt/renew-a-tls-certificate" } },
          "credential_mounts": [
            { "secret_name": "cloudflare-api-token", "fd": 3 },
            { "secret_name": "server-administration-ssh-key", "mount_path": "/held/server-administration-key" }
          ]
        },
        "result_selector": "$",
        "needs": { "expected_seconds": 90, "network_egress": true },
        "maker": "maker:renew-a-tls-certificate",
        "licence_class": "licence:maker-own",
        "placements": ["placement:your-computer"]
      }
    },
