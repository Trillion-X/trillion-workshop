// test/local-mcp-bridge.test.mjs
//
// The local MCP bridge (computer/local-mcp-bridge.mjs) on real loopback sockets with a real upstream server standing in for the
// account's /mcp: the token is checked first and in constant time, the account key goes upstream and never back, a web page's
// Origin and a foreign Host are refused, JSON-RPC and the event stream pass through, and the opt-in tool list narrows.
import test from 'node:test';
import assert from 'node:assert/strict';
import http from 'node:http';
import { mkdtempSync, readFileSync, statSync } from 'node:fs';
import { tmpdir } from 'node:os';
import { join } from 'node:path';
import { bridgeSettings, bridgeToken, bridgeTools, makeBridge, tokenMatches } from '../computer/local-mcp-bridge.mjs';

const KEY = 'account-key-for-the-test';
async function upstream() {
  const seen = [];
  const server = http.createServer((request, response) => {
    const parts = [];
    request.on('data', chunk => parts.push(chunk));
    request.on('end', () => {
      seen.push({ method: request.method, authorization: request.headers.authorization, session: request.headers['mcp-session-id'], body: Buffer.concat(parts).toString() });
      if (request.method === 'GET') {
        response.writeHead(200, { 'content-type': 'text/event-stream', 'mcp-session-id': 's1' });
        response.write('data: {"hello":1}\n\n');
        setTimeout(() => response.end('data: {"bye":2}\n\n'), 20);
        return;
      }
      const message = JSON.parse(Buffer.concat(parts).toString());
      const result = message.method === 'tools/list' ? { tools: [{ name: 'look_at_the_screen' }, { name: 'erase_record' }] } : { content: [{ type: 'text', text: `called ${message.params?.name}` }] };
      response.writeHead(200, { 'content-type': 'application/json', 'mcp-session-id': 's1' }).end(JSON.stringify({ jsonrpc: '2.0', id: message.id, result }));
    });
  });
  await new Promise(resolve => server.listen(0, '127.0.0.1', resolve));
  return { seen, origin: `http://127.0.0.1:${server.address().port}`, close: () => { server.closeAllConnections(); server.close(); } };
}
const call = (address, { token, host, origin, method = 'POST', body, path = '/mcp' } = {}) => new Promise((resolve, reject) => {
  const url = new URL(address.url);
  const headers = { ...(token ? { authorization: `Bearer ${token}` } : {}), ...(host ? { host } : {}), ...(origin ? { origin } : {}), 'content-type': 'application/json', accept: 'application/json, text/event-stream' };
  const request = http.request({ host: url.hostname, port: url.port, path, method, headers }, response => {
    const parts = [];
    response.on('data', chunk => parts.push(chunk));
    response.on('end', () => resolve({ status: response.statusCode, headers: response.headers, text: Buffer.concat(parts).toString() }));
  });
  request.on('error', reject);
  if (body) request.write(typeof body === 'string' ? body : JSON.stringify(body));
  request.end();
});
const rpc = (method, params, id = 1) => ({ jsonrpc: '2.0', id, method, params });

async function running(extra = {}) {
  const account = await upstream();
  const settings = { ...bridgeSettings(), ...extra };
  const bridge = makeBridge({ settings, origin: account.origin, key: KEY, token: 'test-token' });
  const address = await bridge.start();
  return { account, bridge, address, close: async () => { await bridge.stop(); account.close(); } };
}

test('a request without the right token is refused before anything else is read, and nothing reaches the account', async () => {
  const mac = await running();
  try {
    for (const token of [undefined, 'wrong', 'test-toke']) assert.equal((await call(mac.address, { token, body: rpc('tools/list') })).status, 401);
    assert.equal((await call(mac.address, { path: '/health', method: 'GET' })).status, 401, 'even health needs the token');
    assert.equal(mac.account.seen.length, 0);
    assert.equal(tokenMatches('a', 'a'), true);
    assert.equal(tokenMatches('a', 'ab'), false);
  } finally { await mac.close(); }
});

test('with the token, JSON-RPC passes through carrying the account key upstream and the session back; the key is never in an answer', async () => {
  const mac = await running();
  try {
    const answer = await call(mac.address, { token: 'test-token', body: rpc('tools/call', { name: 'look_at_the_screen' }) });
    assert.equal(answer.status, 200);
    assert.match(answer.text, /called look_at_the_screen/);
    assert.equal(answer.headers['mcp-session-id'], 's1');
    assert.equal(mac.account.seen[0].authorization, `Bearer ${KEY}`);
    assert.doesNotMatch(JSON.stringify(answer), new RegExp(KEY));
    const stream = await call(mac.address, { token: 'test-token', method: 'GET' });
    assert.match(stream.text, /hello[\s\S]*bye/);
    assert.equal(stream.headers['content-type'], 'text/event-stream');
  } finally { await mac.close(); }
});

test('a web page (Origin), a foreign Host and an unknown path or method are refused', async () => {
  const mac = await running();
  try {
    assert.equal((await call(mac.address, { token: 'test-token', origin: 'https://evil.example', body: rpc('tools/list') })).status, 403);
    assert.equal((await call(mac.address, { token: 'test-token', host: 'rebind.example', body: rpc('tools/list') })).status, 403);
    assert.equal((await call(mac.address, { token: 'test-token', path: '/other', body: rpc('tools/list') })).status, 404);
    assert.equal((await call(mac.address, { token: 'test-token', method: 'PUT', body: '{}' })).status, 404);
    assert.equal(mac.account.seen.length, 0);
  } finally { await mac.close(); }
});

test('tools.allow is an opt-in narrowing: the list and the calls are cut to it; null offers all', async () => {
  const narrow = await running({ tools: { allow: ['look_at_the_screen'] } });
  try {
    const list = JSON.parse((await call(narrow.address, { token: 'test-token', body: rpc('tools/list') })).text);
    assert.deepEqual(list.result.tools, [{ name: 'look_at_the_screen' }]);
    const refused = JSON.parse((await call(narrow.address, { token: 'test-token', body: rpc('tools/call', { name: 'erase_record' }, 7) })).text);
    assert.equal(refused.id, 7);
    assert.match(refused.error.message, /does not offer the tool erase_record/);
    assert.equal(narrow.account.seen.length, 1, 'only the list went upstream');
  } finally { await narrow.close(); }
  assert.equal(bridgeSettings().tools.allow, null);
  const open = await running();
  try { assert.equal(JSON.parse((await call(open.address, { token: 'test-token', body: rpc('tools/list') })).text).result.tools.length, 2); } finally { await open.close(); }
});

test('an oversize body is refused, an unreachable account is a 502 in words, and the token is made once in a private file', async () => {
  const mac = await running({ max_body_bytes: 100 });
  try { assert.equal((await call(mac.address, { token: 'test-token', body: 'x'.repeat(500) })).status, 413); } finally { await mac.close(); }
  const down = makeBridge({ origin: 'http://127.0.0.1:1', key: KEY, token: 'test-token' });
  const address = await down.start();
  try {
    const answer = await call(address, { token: 'test-token', body: rpc('tools/list') });
    assert.equal(answer.status, 502);
    assert.match(answer.text, /did not answer/);
  } finally { await down.stop(); }
  const file = join(mkdtempSync(join(tmpdir(), 'bridge-')), 'token');
  const settings = { ...bridgeSettings(), token_file: file };
  const first = bridgeToken(settings);
  assert.match(first, /^[0-9a-f]{64}$/);
  assert.equal(bridgeToken(settings), first);
  assert.equal(statSync(file).mode & 0o777, 0o600);
  assert.equal(readFileSync(file, 'utf8').trim(), first);
});

test('the tool refuses to start without the account key from the helper, and stopping what is not running is fine', async () => {
  await assert.rejects(bridgeTools.bridge({ on: true }, {}), error => error.status === 409);
  assert.equal((await bridgeTools.bridge({ on: false })).on, false);
  assert.equal((await bridgeTools.bridge({})).on, false);
});

test('the Mac host reaches the bridge through its tool table, and refuses a run without the account key', async () => {
  const { runHere, settingsOf } = await import('../computer/mac-tools.mjs');
  const answer = await runHere(settingsOf(), { tool_id: 'tool:local-mcp-bridge', input: { on: true } }, {});
  assert.match(String(answer.error), /./);
  assert.equal((await runHere(settingsOf(), { tool_id: 'tool:local-mcp-bridge', input: { on: false } }, {})).on, false);
});
