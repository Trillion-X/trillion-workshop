        "kind": "ai-tool-descriptor",
        "id": "tool:install-a-tool-source",
        "label": "Install a tool source my rows name",
        "status": "active",
        "job": "Install on this computer the tool source one of my rows names (its label, the https archive of its tool folders and the pin of their files), or take it away when the row was removed, so every computer of mine runs the tools my own rows say and none needs a hand step",
        "description": "One step of the person's own workflow that keeps each of their computers on what their rows say each tool source is. Given {source, address, files_blake3} it installs that archive as the source of that label through the engine's tools:update at the Workshop's address (a new label becomes a new source; the same label moves to the new pin); given {source, removed: true} it takes the source away. The source may be any https archive of tool folders, a teammate's as well as the Workshop's. The run may install only because its row declares the right {at: \"@tools\", id: \"*\", operations: [\"tools:update\"]}, which the person grants by switching on the wake that runs it. It answers the engine's answer with the label: changed, files_blake3, previous, removed, switch_again.",
        "input_schema": {
          "type": "object",
          "required": [
            "source"
          ],
          "properties": {
            "source": {
              "type": "string",
              "description": "The label of one tool source: lowercase letters, digits, dot, dash or underscore."
            },
            "address": {
              "type": "string",
              "description": "The https address of a gzip tar archive of the source's tool folders."
            },
            "files_blake3": {
              "type": "string",
              "description": "The pin of the archive's files: 64 hex, as tools/workflows/do-work/pin-a-commit-by-its-files.mjs computes it."
            },
            "removed": {
              "const": true,
              "description": "Take the source away instead; name only the source."
            }
          }
        },
        "output_schema": {
          "type": "object",
          "required": [
            "source"
          ],
          "properties": {
            "source": {
              "type": "string"
            },
            "changed": {
              "type": "boolean"
            },
            "files_blake3": {
              "type": "string"
            },
            "previous": {},
            "removed": {
              "type": "boolean"
            },
            "switch_again": {}
          }
        },
        "invoke": {
          "kind": "container",
          "files": {
            "package_files": [
              {
                "package": "install-a-tool-source",
                "paths": [
                  "do-work"
                ],
                "at": "/opt/install-a-tool-source"
              },
              {
                "package": "records-door",
                "paths": [
                  "do-work",
                  "read-data"
                ],
                "at": "/opt/records-door"
              },
              {
                "package": "content-identity",
                "paths": [
                  "read-data"
                ],
                "at": "/opt/content-identity"
              },
              {
                "packages": [
                  "node_modules/@noble/hashes"
                ],
                "paths": [
                  "LICENSE",
                  "package.json",
                  "blake3.js",
                  "blake2.js",
                  "_blake.js",
                  "_md.js",
                  "_u64.js",
                  "utils.js"
                ],
                "at": "/opt/node_modules/@noble/hashes"
              }
            ]
          },
          "workdir": "/opt/install-a-tool-source",
          "internet": false,
          "stdout": "json",
          "argv": [
            "node",
            "/opt/records-door/do-work/run-an-export.mjs",
            "/opt/install-a-tool-source/do-work/install-a-tool-source.mjs",
            "installToolSource"
          ],
          "stdin": {
            "fill": {
              "from": "input"
            }
          },
          "records": {
            "fd": 3,
            "rights": [
              {
                "at": "@tools",
                "id": "*",
                "operations": [
                  "tools:update"
                ]
              }
            ]
          }
        },
        "result_selector": "$.result",
        "needs": {
          "expected_seconds": 120,
          "network_egress": false,
          "memory_mb": 256
        },
        "licence_class": "licence:maker-own",
        "placements": [
          "placement:small-container"
        ],
        "maker": "maker:install-a-tool-source",
        "provenance": {
          "source": "New, Nov 20 2026: a person's tool sources are their own rows, the same on every computer (research_files tool-sources-are-the-persons-rows/gauntlet-and-plan); the engine's tools:update grantable by label (trillion-rust 282e8d086, 6ec976889)."
        }
      }
    }
