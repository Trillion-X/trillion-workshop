{
  "kind": "tool-rows",
  "record_set": "keep-ai-provider-limits-tool-rows",
  "what_this_is": "The Workshop row for tools/keep-ai-provider-limits: a due-time wake runs one tiny call through the local AI proxy and writes the rate-limit headers it returns as provider_limits rows, only when no row of that provider was read in the quiet window. The store, the proxy address and the model come from the wake row's input.",
  "records": [
    {
      "payload": {
        "kind": "ai-tool-descriptor",
        "status": "active",
        "licence_class": "licence:maker-own",
        "maker": "maker:keep-ai-provider-limits",
        "id": "tool:keep-ai-provider-limits",
        "placements": [
          "placement:your-computer"
        ],
        "needs": {
          "expected_seconds": 60,
          "network_egress": false
        },
        "label": "Keep an AI subscription's limit rows current",
        "job": "Send at most one tiny call per quiet window through the local AI proxy and write the subscription's rate-limit headers as provider_limits rows.",
        "description": "Reads the store, proxy address, model and account from its input (the person's wake row names them). Sends nothing while a row of the provider was read inside the quiet window.",
        "input_schema": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "store",
            "provider",
            "proxy_address",
            "model",
            "account",
            "quiet_minutes"
          ],
          "properties": {
            "store": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "credential_name"
              ],
              "properties": {
                "credential_name": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "provider": {
              "type": "string",
              "minLength": 1
            },
            "proxy_address": {
              "type": "string",
              "minLength": 1
            },
            "model": {
              "type": "string",
              "minLength": 1
            },
            "account": {
              "type": "string",
              "minLength": 1
            },
            "quiet_minutes": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "output_schema": {
          "type": "object",
          "required": [
            "sent",
            "reason",
            "rows"
          ],
          "properties": {
            "sent": {
              "type": "boolean"
            },
            "reason": {
              "type": "string"
            },
            "rows": {
              "type": "array"
            }
          }
        },
        "invoke": {
          "kind": "computer",
          "workdir": "/opt/keep-ai-provider-limits",
          "internet": false,
          "stdout": "json",
          "argv": [
            "node",
            "--no-warnings",
            "/opt/keep-ai-provider-limits/do-work/keep-ai-provider-limits.mjs"
          ],
          "stdin": {
            "fill": {
              "from": "input"
            }
          },
          "credential_mounts": [
            {
              "credential_name": "claude-proxy-client-key",
              "descriptor": 4
            }
          ],
          "records": {
            "fd": 3,
            "rights": [
              {
                "at": "@own-records",
                "id": "provider-limits",
                "operations": [
                  "tools:run"
                ]
              }
            ],
            "runs": [
              "tool:run-sql-in-my-database"
            ]
          },
          "files": {
            "package_files": [
              {
                "package": "keep-ai-provider-limits",
                "paths": [
                  "do-work"
                ],
                "at": "/opt/keep-ai-provider-limits"
              },
              {
                "package": "records-door",
                "paths": [
                  "read-data"
                ],
                "at": "/opt/records-door"
              },
              {
                "package": "keep-and-wake-ai-sessions-on-this-computer",
                "paths": [
                  "harness/claude-limits.mjs",
                  "harness/claude-limits.json"
                ],
                "at": "/opt/keep-and-wake-ai-sessions-on-this-computer"
              }
            ]
          },
          "capabilities": [],
          "hosts": [
            "127.0.0.1"
          ]
        },
        "result_selector": "$",
        "wakes": [
          {
            "id": "every-fifteen-minutes",
            "on": {
              "fact": {
                "kind": "due-time",
                "from": [
                  "run"
                ],
                "fold": true,
                "match": {
                  "schedule_id": "schedule:tool:keep-ai-provider-limits:every-fifteen-minutes"
                },
                "watch": {
                  "schedules": [
                    {
                      "schedule_id": "schedule:tool:keep-ai-provider-limits:every-fifteen-minutes",
                      "source_generation": 1,
                      "schedule_revision": 1,
                      "timezone": "UTC",
                      "start_local_date": "1970-01-01",
                      "local_window": {
                        "start": "00:00",
                        "duration_minutes": 1
                      },
                      "dst": {
                        "gap": "next-valid",
                        "fold": "earlier"
                      },
                      "action": {
                        "operation": "tell-the-engine",
                        "owner_ref": "tool:keep-ai-provider-limits",
                        "owner_dispatch": {
                          "name": "tool:keep-ai-provider-limits",
                          "input": {}
                        },
                        "completion": {
                          "mode": "synchronous-owner-return"
                        }
                      },
                      "cadence": {
                        "unit": "minute",
                        "interval": 15
                      }
                    }
                  ]
                }
              }
            },
            "budget": {
              "steps": 1,
              "wall_ms": 300000
            }
          }
        ],
        "provenance": {
          "source": "Written for the Workshop: the Claude limit reader's idle fallback. The proxy passes Anthropic's rate-limit headers back only on a response, so a quiet-window call keeps the rows current when no other call has."
        }
      }
    }
  ]
}
