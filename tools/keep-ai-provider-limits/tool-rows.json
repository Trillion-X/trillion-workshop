        "kind": "ai-tool-descriptor",
        "status": "active",
        "licence_class": "licence:maker-own",
        "maker": "maker:keep-ai-provider-limits",
        "id": "tool:keep-ai-provider-limits",
        "placements": [
          "placement:your-computer"
        ],
        "needs": {
          "expected_seconds": 60,
          "network_egress": false
        },
        "label": "Keep an AI subscription's limit rows current",
        "job": "Send at most one tiny call per quiet window through the local AI proxy and write the subscription's rate-limit headers as provider_limits rows.",
        "description": "Reads the store, proxy address, model and account from its input (a workflow recipe's step names them; the store is filled from the account's default account_stores row). Sends nothing while a row of the provider was read inside the quiet window.",
        "input_schema": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "store",
            "provider",
            "proxy_address",
            "model",
            "account",
            "quiet_minutes"
          ],
          "properties": {
            "store": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "credential_name"
              ],
              "properties": {
                "credential_name": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "provider": {
              "type": "string",
              "minLength": 1
            },
            "proxy_address": {
              "type": "string",
              "minLength": 1
            },
            "model": {
              "type": "string",
              "minLength": 1
            },
            "account": {
              "type": "string",
              "minLength": 1
            },
            "quiet_minutes": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "output_schema": {
          "type": "object",
          "required": [
            "sent",
            "reason",
            "rows"
          ],
          "properties": {
            "sent": {
              "type": "boolean"
            },
            "reason": {
              "type": "string"
            },
            "rows": {
              "type": "array"
            }
          }
        },
        "invoke": {
          "kind": "computer",
          "workdir": "/opt/keep-ai-provider-limits",
          "internet": false,
          "stdout": "json",
          "argv": [
            "node",
            "--no-warnings",
            "/opt/keep-ai-provider-limits/do-work/keep-ai-provider-limits.mjs"
          ],
          "stdin": {
            "fill": {
              "from": "input"
            }
          },
          "credential_mounts": [
            {
              "secret_name": "claude-proxy-client-key",
              "fd": 4
            }
          ],
          "records": {
            "fd": 3,
            "runs": [
              "tool:run-sql-in-my-database"
            ]
          },
          "files": {
            "package_files": [
              {
                "package": "keep-ai-provider-limits",
                "paths": [
                  "do-work"
                ],
                "at": "/opt/keep-ai-provider-limits"
              },
              {
                "package": "records-door",
                "paths": [
                  "read-data"
                ],
                "at": "/opt/records-door"
              },
              {
                "package": "keep-and-wake-ai-sessions-on-this-computer",
                "paths": [
                  "harness/claude-limits.mjs",
                  "harness/claude-limits.json"
                ],
                "at": "/opt/keep-and-wake-ai-sessions-on-this-computer"
              }
            ]
          },
          "capabilities": []
        },
        "result_selector": "$",
        "provenance": {
          "source": "Written for the Workshop: the Claude limit reader's idle fallback. The proxy passes Anthropic's rate-limit headers back only on a response, so a quiet-window call keeps the rows current when no other call has."
        }
      }
