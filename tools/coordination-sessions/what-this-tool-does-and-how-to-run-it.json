            "event_label": { "type": "string" },
            "focus_label": { "type": "string" },
            "public_summary": { "type": "string" },
            "detail_intro": { "type": "string" },
            "schedule_intent": { "type": "string" },
            "primary_starts_at": { "type": "string", "description": "Local time like 2026-09-12T09:00" },
            "primary_ends_at": { "type": "string" },
            "alternate_starts_at": { "type": "string" },
            "alternate_ends_at": { "type": "string" },
            "time_zone": { "type": "string", "description": "IANA zone, like America/Chicago" },
            "place_label": { "type": "string" },
            "mode": { "type": "string", "description": "The organizer's own word, like online or in person" },
            "visibility": { "type": "string", "description": "The organizer's own word, like public or members only" },
            "capacity": { "type": "integer", "minimum": 1, "maximum": 1000000 },
            "host_origin": { "type": "string", "description": "https://host, no path" },
            "catalog_path": { "type": "string", "description": "Where events live on the host (/events when left out)" },
