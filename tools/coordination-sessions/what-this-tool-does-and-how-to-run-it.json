        "id": "tool:work-a-session-catalog",
        "label": "Work a session catalog",
        "status": "active",
        "job": "Offer my sessions in a catalog: publish an entry, read what is current, change it, withdraw it, replace it, or point it to a related offer",
        "description": "Works on catalog entries, each naming the groups that own it, the sessions it offers, a reference to the person's own visibility rule, a recommendation policy, related offers and where it is shown. An entry is current until it is superseded or retracted. Operations: publish (checks and tidies an entry), read (the current entries, optionally for given entry or session refs), update, retract (with a reason), supersede (an entry by a different one), cross_offer (point one entry at another, replacing an earlier pointer to the same target). Who may see an entry, and the order entries are recommended in, are the person's own rules and are not decided here. Nothing is saved.",
        "input_schema": {
          "type": "object",
          "required": ["operation"],
          "additionalProperties": false,
          "properties": {
            "operation": { "type": "string", "description": "publish, read, update, retract, supersede or cross_offer" },
            "entry": { "type": "object", "description": "The entry (publish, update, retract, cross_offer)" },
            "entries": { "type": "array", "items": { "type": "object" }, "description": "For read: the entries to read from" },
            "catalog_entry_refs": { "type": "array", "items": { "type": "string" } },
            "session_refs": { "type": "array", "items": { "type": "string" } },
            "patch": { "type": "object", "description": "For update: fields to change (the entry's id cannot change)" },
            "retracted_at": { "type": "string", "description": "For retract: when (this run's time when left out)" },
            "reason_ref": { "type": "string", "description": "For retract: why" },
            "predecessor": { "type": "object" },
            "successor": { "type": "object" },
            "relation": { "type": "object", "description": "For cross_offer: { target_catalog_entry_ref, relation_descriptor_ref, rule_data? }" }
          }
        },
        "output_schema": {
          "type": "object",
          "properties": {
            "entry": { "type": "object" },
