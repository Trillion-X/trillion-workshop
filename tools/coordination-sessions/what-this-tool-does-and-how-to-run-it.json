        "kind": "ai-tool-descriptor",
        "id": "tool:run-a-session-step",
        "label": "Run a session step",
        "status": "active",
        "job": "Create, change, reschedule, fork, merge, cancel, supersede, confirm, close or ask feedback of a gathering I organize, keeping who came from where",
        "description": "Applies one named step to a coordination session and answers the next session (or, for supersede, the old one and its successor). The session carries its purpose, candidate times, places and modes, capacity plan, who may see and join it, and a lifecycle state, all as open descriptors the person names. Every step keeps lineage (which sessions it came from) and the provenance of who took part and what they preferred. Steps: create, update, reschedule, fork, merge (two or more sessions), cancel, supersede, confirm, record_no_show, close, request_feedback. A step that is not named is refused. Nothing is saved or sent: keep the answer as a record.",
        "input_schema": {
          "type": "object",
          "required": ["operation"],
          "additionalProperties": false,
          "properties": {
            "operation": { "type": "string", "description": "create, update, reschedule, fork, merge, cancel, supersede, confirm, record_no_show, close or request_feedback" },
            "session": { "type": "object", "description": "The session the step works on (create: the session to make)" },
            "sessions": { "type": "array", "items": { "type": "object" }, "description": "For merge: two or more sessions" },
            "patch": { "type": "object", "description": "For update: the fields to change" },
            "reschedule": { "type": "object", "description": "For reschedule: { candidate_occurrences, lifecycle_state, candidate_places?, candidate_modes? }" },
            "fork": { "type": "object", "description": "For fork: { session_id, lifecycle_state, overrides?, inheritance_policy_ref?, conflict_policy_ref? }" },
            "merge": { "type": "object", "description": "For merge: { session_id, lifecycle_state, overrides?, inheritance_policy_ref?, conflict_policy_ref? }" },
            "supersede": { "type": "object", "description": "For supersede: { session_id, lifecycle_state, predecessor_lifecycle_state, overrides? }" },
            "lifecycle_state": { "type": "object", "description": "For cancel, confirm, record_no_show, close, request_feedback: the new { key, descriptor_ref }" },
            "feedback_request_ref": { "type": "string", "description": "For request_feedback: what the feedback request is" }
          }
        },
        "output_schema": {
          "type": "object",
          "properties": {
            "session": { "type": "object" },
            "predecessor": { "type": "object" },
            "successor": { "type": "object" }
          }
        },
        "invoke": {
          "kind": "container",
          "files": { "package_files": [
            {
              "package": "coordination-sessions",
              "paths": [
                "do-work",
                "read-data"
              ],
              "at": "/opt/coordination-sessions"
            },
            {
              "package": "workflows",
              "paths": [
                "do-work/run-a-function.mjs"
              ],
              "at": "/opt/workflows"
            },
            {
              "package": "content-identity",
              "paths": [
                "read-data"
              ],
              "at": "/opt/content-identity"
            },
            {
              "packages": ["node_modules/@noble/hashes"],
              "paths": [
                "LICENSE",
                "package.json",
                "blake3.js",
                "blake2.js",
                "_blake.js",
                "_md.js",
                "_u64.js",
                "utils.js"
              ],
              "at": "/opt/node_modules/@noble/hashes"
            },
            {
              "package": "browse-and-upload-my-files",
              "paths": [
                "built-stored-bytes/content-chunks/content_chunks.js",
                "do-work/content-chunks.mjs",
                "do-work/namespace-client.mjs",
                "do-work/send-a-file-to-a-namespace.mjs",
                "do-work/send-retry.mjs",
                "do-work/send-window.mjs",
                "do-work/shared-file-reference.mjs",
                "send-settings.json"
              ],
              "at": "/opt/browse-and-upload-my-files"
            }
          ] },
          "workdir": "/opt/coordination-sessions",
          "stdout": "json",
          "run": ["node", "/opt/workflows/do-work/run-a-function.mjs", "/opt/coordination-sessions/do-work/coordination-sessions.mjs", "runASessionStep"],
          "stdin": { "fill": { "from": "input" } }
        },
        "needs": { "expected_seconds": 2, "network_egress": false },
        "licence_class": "licence:maker-own",
        "placements": ["placement:small-container"],
        "maker": "maker:coordination-sessions",
        "result_selector": "$.result",
        "provenance": { "source": "bitfield-packages packages/coordination-session do-work/session-lifecycle-operations.ts" },
        "verify": [{
          "kind": "sample-run",
          "input": {
            "operation": "create",
            "session": {
              "session_id": "session:sample",
              "purpose_contract": { "key": "baking-morning", "descriptor_ref": "purpose:baking-morning" },
              "candidate_occurrences": [{ "occurrence_id": "occurrence:sample:1", "starts_at": "2026-09-12T09:00", "ends_at": "2026-09-12T11:00", "time_zone": "America/Chicago", "calendar_system": "gregorian" }],
              "candidate_places": [],
              "candidate_modes": [{ "key": "mode:in-person", "descriptor_ref": "mode:in-person" }],
              "capacity_plan": { "capacity_policy_ref": "capacity-policy:sample", "seat_ledger_ref": "ledger:sample" },
              "participation_policy": { "visibility_predicate_ref": "visibility:members", "eligibility_predicate_ref": "eligible:members" },
              "lifecycle_state": { "key": "draft", "descriptor_ref": "lifecycle:draft" },
              "workflow_definition_ref": "workflow:sample",
              "participant_provenance": [],
              "preference_provenance": []
            }
          },
          "output_selector": "$.session.fork_merge_provenance.operation",
          "contains": "create"
        }]
      }
