        "id": "tool:plan-an-event",
        "label": "Plan an event",
        "status": "active",
        "job": "Turn my draft of a gathering into its session, its catalog entry, the places to open and the link people will use",
        "description": "Checks an organizer's draft (a retained 128-bit hex id, the owning group, labels in any language, a primary time and an optional alternate in the zone given, a place, a mode and a visibility word the organizer chooses, a capacity of 1 to 1,000,000, the host's web address and the workflow to run) and answers the session, the catalog entry that offers it, the capacity ledger to open for its places (the input of workflow:hold-places-in-a-finite-pool), and the preview and share addresses. The same draft always gives the same plan. It plans only: nothing is kept, published or sent. Refuses a half-given alternate, an end before a start, an unsafe route or a web address that is not https (except this computer's own).",
        "input_schema": {
          "type": "object",
          "required": ["idempotency_key", "host_group_ref", "event_label", "focus_label", "public_summary", "detail_intro", "schedule_intent", "primary_starts_at", "primary_ends_at", "time_zone", "mode", "visibility", "capacity", "host_origin", "workflow_definition_ref"],
          "additionalProperties": false,
          "properties": {
            "idempotency_key": { "type": "string", "description": "A retained 128-bit hexadecimal id (32 hex characters) the caller allocated" },
