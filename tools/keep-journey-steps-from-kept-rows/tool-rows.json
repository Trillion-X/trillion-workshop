{
  "kind": "package-set-records",
  "record_set": "keep-journey-steps-from-kept-rows-tool-rows",
  "what_this_is": "The Workshop row that keeps the journey steps of a pursuit from its kept rows (statements bookings, payment_events sales), into its journey_steps table. The connection string is the person's held value under the name given, handed to the one process on descriptor 3, as the show-where tool hands it.",
  "records": [
    {
      "payload": {
        "kind": "ai-tool-descriptor",
        "id": "tool:keep-journey-steps-from-kept-rows",
        "label": "Keep journey steps from kept rows",
        "job": "Keep each booking and each paid sale of the pursuit as a journey step, read from its own database",
        "description": "Reads the kept rows that stand for a journey step (read-data/journey-kept-rows.json: TidyCal bookings from the statements table, paid sales from payment_events for the pursuit's own offers) from the database named by credential_name, and keeps each one in journey_steps once. Reads from the newest kept step of each kind unless since is given. Answers how many rows each mapping read and how many steps it newly kept. Running it again keeps nothing new. Before it keeps anything it applies the kit's schema to that database once per version (a live pursuit gets each kit schema change within one run); mode check reports what the kit declares that the database lacks, and writes nothing.",
        "status": "active",
        "input_schema": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "credential_name"
          ],
          "properties": {
            "credential_name": {
              "type": "string",
              "minLength": 1,
              "description": "The held name of the database connection string: the vault name the person saved it under."
            },
            "since": {
              "type": "string",
              "description": "Optional ISO time (like 2026-11-21T00:00:00Z) to read rows from, instead of the newest kept step of each kind."
            },
            "refs": {
              "type": "array",
              "minItems": 1,
              "maxItems": 500,
              "items": {
                "type": "string",
                "minLength": 1
              },
              "description": "Optional list of refs (like tidycal:10712000) to read again whatever their cutoff, for a source row fixed after it was kept. Give refs or since, not both."
            },
            "mode": {
              "type": "string",
              "enum": ["keep", "check"],
              "description": "keep (the default) applies the kit's schema to this database when this version is not applied yet, then keeps the steps. check writes nothing and answers which objects the kit declares that the database lacks."
            }
          }
        },
        "output_schema": {
          "type": "object",
          "required": [
            "mappings"
          ],
          "properties": {
            "mappings": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "id",
                  "step",
                  "read",
                  "kept"
                ],
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "step": {
                    "type": "string"
                  },
                  "read": {
                    "type": "integer"
                  },
                  "kept": {
                    "type": "integer"
                  }
                }
              }
            }
          }
        },
        "invoke": {
          "kind": "container",
          "internet": true,
          "workdir": "/opt/keep-journey-steps-from-kept-rows",
          "stdout": "json",
          "argv": [
            "node",
            "/opt/keep-journey-steps-from-kept-rows/do-work/keep-steps.mjs"
          ],
          "stdin": {
            "fill": {
              "from": "input"
            }
          },
          "files": {
            "package_files": [
              {
                "package": "keep-journey-steps-from-kept-rows",
                "paths": [
                  "do-work",
                  "read-data"
                ],
                "at": "/opt/keep-journey-steps-from-kept-rows"
              },
              {
                "package": "traffic-attribution",
                "paths": [
                  "do-work/journey.mjs",
                  "read-data/journey.json",
                  "read-data/ad-return.json",
                  "read-data/consent.json",
                  "read-data/journey-steps.sql"
                ],
                "at": "/opt/traffic-attribution"
              },
              {
                "package": "content-identity",
                "paths": [
                  "read-data"
                ],
                "at": "/opt/content-identity"
              },
              {
