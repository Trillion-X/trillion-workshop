  "worked_examples": [
    {
      "title": "Lay out a person's profile on a sample input",
      "ask": "Run tool:lay-out-a-profile.",
      "mcp": {
        "server": "trillion",
        "tool": "run_resource_operation",
        "input": {
          "address": "@workshop-tools",
          "method": "tools:run",
          "input": {
            "tool": "tool:lay-out-a-profile",
            "input": {
              "layout": {
                "surfaceId": "person",
                "identity": {
                  "titlePath": [
                    "name"
                  ],
                  "subtitlePath": [
                    "company"
                  ]
                },
                "fields": [
                  {
                    "id": "email",
                    "label": "Email",
                    "valuePath": [
                      "email"
                    ]
                  },
                  {
                    "id": "stage",
                    "label": "Stage",
                    "valuePath": [
                      "stage"
                    ],
                    "fallbackValue": "Lead"
                  }
                ],
                "relationships": [
                  {
                    "id": "steps",
                    "label": "Recent steps",
                    "itemPath": [
                      "steps"
                    ],
                    "fields": [
                      {
                        "key": "label"
                      },
                      {
                        "key": "at"
                      }
                    ],
                    "emptyLabel": "Nothing yet"
                  }
                ],
                "actions": [
                  {
                    "id": "book",
                    "label": "Book a call"
                  },
                  {
                    "id": "win",
                    "label": "Mark won",
                    "visibleWhen": [
                      {
                        "path": [
                          "stage"
                        ],
                        "equals": "proposal"
                      }
                    ]
                  }
                ]
              },
              "sources": {
                "record": {
                  "name": "Ana Ruiz",
                  "company": "Northwind",
                  "email": "user-ed8c33be@example.com",
                  "steps": [
                    {
                      "id": "step:1",
                      "label": "First message",
                      "at": "2026-09-20"
                    }
                  ]
                }
              }
            }
          }
        }
      },
      "hands_back": "The answer's $.identity.title contains \"Ana Ruiz\"."
    }
  ]
