import assert from 'node:assert/strict';
import { readFileSync, readdirSync, statSync } from 'node:fs';
import { join, relative } from 'node:path';
import test from 'node:test';

import { loadTsModule, packageFile } from './load-ts-module.mjs';

const root = join(process.cwd(), 'packages/person-profile');

test('boundary declares described-record-surface and source guards stay clean', () => {
  const contract = JSON.parse(readFileSync(join(root, 'things-to-store-and-run.json'), 'utf8'));
  const payloadAt = (address) => contract.things.find((entry) => entry.address === address)?.payload;
  assert.equal(payloadAt('package::person-profile::primitive-contract').capability, 'described-record-surface');
  assert.equal(payloadAt('package::person-profile::described-record-surface::profile').kind, 'described-record-surface');

  const forbidden = [
    /\b(profile-http|profile-sync|profile-workflow|profile-crm|profile-calendar|profile-mail|profile-provider|person-profile-mobile|person-profile-ios)\b/,
    /\b(FIELD_SLOTS|full_name|display_name|recent posts|reaction|comment)\b/,
    /\b(slot::workflow|execute_definition|action:person-profile|save-person-profile|actor:local)\b/,
  ];
  const sourceFiles = (dir) => readdirSync(dir).flatMap((name) => {
    const path = join(dir, name);
    const stat = statSync(path);
    if (stat.isDirectory()) return sourceFiles(path);
    return /\.(ts|tsx|js|json|md)$/.test(name) ? [path] : [];
  });
  // GENERATED output is not source and must not be judged as source. This walk excluded only
  // `/tests/`, so it also scanned `.bitfield-entry-scope/`, which is emitted, and reported 4 of its
  // files as offenders. That is the same exclusion the declared corpus rules already use
  // (`check-source-files-against-declared-rules` carries
  // `/built-stored-bytes/|/\.bitfield-entry-scope/` in its scope.path_excludes), so this is not a
  // new judgement call, just one this hand-rolled copy of that job never picked up.
  //
  // With the noise gone this guard reports exactly ONE offender and it is REAL:
  // show/PersonProfileSurface.tsx names `display_name` at :143, :145 and :190. This package's
  // contract is `described-record-surface`, a GENERIC renderer, and the forbidden list exists
  // precisely to stop domain field vocabulary leaking into it. The field belongs in descriptor
  // DATA, read through the descriptor, never spelled in the panel. Left RED on purpose: fixing it
  // changes what the surface renders and belongs to whoever owns that decision, and a guard that
  // is quietly narrowed until it passes is worth less than no guard.
  const generated = /\/(\.bitfield-entry-scope|built-stored-bytes|node_modules)\//;
  const offenders = sourceFiles(root)
    .filter((file) => !file.includes('/tests/') && !generated.test(file))
    .flatMap((file) => {
      const text = readFileSync(file, 'utf8');
      return forbidden.map((pattern) => pattern.test(text) ? relative(root, file) : '').filter(Boolean);
    });
  assert.deepEqual(offenders, []);
});

test('described-record projection works for profile and non-profile fixtures', async () => {
  const { projectDescribedRecordSurface } = await loadTsModule(packageFile('packages/person-profile/read-data/described-record-surface.ts'));
  const profileSurface = projectDescribedRecordSurface({
    readerId: 'browser',
    descriptor: {
      kind: 'described-record-surface',
      surfaceId: 'profile.fixture',
      identity: { titlePath: ['title'], subtitlePath: ['line'], badgesPath: ['badges'] },
      fields: [
        { id: 'one', label: 'Visible title', valuePath: ['title'], editable: true, saveActionId: 'save-one' },
        { id: 'two', label: 'Long text', valuePath: ['body'], multiline: true },
        { id: 'hidden', label: 'Hidden', valuePath: ['hidden'], visibleWhen: [{ path: ['canSeeHidden'], equals: true }] },
      ],
      relationships: [{
        id: 'activity',
        label: 'Activity',
        sourceId: 'related',
        itemPath: ['items'],
        fields: [{ key: 'primaryText', path: ['title'] }, { key: 'metaText', path: ['when'] }],
      }],
      actions: [{ id: 'save-one', label: 'Save', enabled: true, intent: 'primary' }],
    },
    sources: {
      record: { title: 'Ava Reed', line: 'Community builder', body: 'Writes useful updates.', badges: [{ id: 'trusted' }] },
      related: { items: [{ id: 'item-1', title: 'Welcomed a new member', when: 'Today' }] },
    },
  });
  assert.equal(profileSurface.identity.title, 'Ava Reed');
  assert.deepEqual(profileSurface.fields.map((field) => field.id), ['one', 'two']);
  assert.deepEqual(profileSurface.relationships[0].items[0].values, {
    primaryText: 'Welcomed a new member',
    metaText: 'Today',
  });

  const genericSurface = projectDescribedRecordSurface({
    readerId: 'worker',
    descriptor: {
      kind: 'described-record-surface',
      surfaceId: 'generic.fixture',
      identity: { titlePath: ['summary'] },
      fields: [{ id: 'temperature', label: 'Temperature', valuePath: ['temperature'] }],
    },
    sources: { record: { summary: 'Sensor A', temperature: '72F' } },
  });
  assert.equal(genericSurface.identity.title, 'Sensor A');
  assert.equal(genericSurface.fields[0].value, '72F');
});

test('action builder and reader materialization are descriptor-driven', async () => {
  const { buildDescribedRecordActionRequest } = await loadTsModule(packageFile('packages/person-profile/do-work/described-record-action.ts'));
  const { materializeDescribedRecordSurface } = await loadTsModule(packageFile('packages/person-profile/read-data/described-record-materialization.ts'));
  const { describedRecordToSurfaceDescriptor } = await loadTsModule(packageFile('packages/person-profile/show/person-profile-screen-model.ts'));

  const action = buildDescribedRecordActionRequest({
    actionId: 'save-field',
    operationId: 'op-1',
    values: { fieldId: 'display-title', value: 'Ava' },
    sources: { actor: { id: 'actor-1' } },
    descriptors: [{
      id: 'save-field',
      target: 'owner-action:described-record-change',
      method: 'request',
      input: { surfaceId: 'surface-1' },
      bindings: [{ key: 'actorId', source: 'actor', path: ['id'] }],
    }],
  });
  assert.deepEqual(action.errors, []);
  assert.equal(action.requests[0].target, 'owner-action:described-record-change');
  assert.equal(action.requests[0].payload.input.actorId, 'actor-1');

  const descriptor = {
    kind: 'described-record-surface',
    surfaceId: 'shared.fixture',
    identity: { titlePath: ['label'] },
    fields: [{ id: 'field-a', label: 'Field A', valuePath: ['value'], editable: true }],
  };
  const browser = materializeDescribedRecordSurface({ descriptor, sources: { record: { label: 'Shared', value: 'same' } }, readerId: 'browser' });
  const native = materializeDescribedRecordSurface({ descriptor, sources: { record: { label: 'Shared', value: 'same' } }, readerId: 'ios' });
  assert.deepEqual(browser.value.fields, native.value.fields);
  assert.deepEqual(describedRecordToSurfaceDescriptor(browser.value).sections.map((section) => section.kind), ['identityHeader', 'fieldGroup']);
});
