{
  "kind": "tool-rows",
  "record_set": "generate-content-drafts-tool-rows",
  "records": [
    {
      "id": "package::generate-content-drafts::tool::compile-a-presentation-plan",
      "address": "package::generate-content-drafts::tool::compile-a-presentation-plan",
      "path": [
        "current-item",
        "published-record"
      ],
      "payload": {
        "uses_tools": [
          "trillion-workshop/content-identity"
        ],
        "kind": "ai-tool-descriptor",
        "status": "active",
        "read_only": true,
        "licence_class": "licence:maker-own",
        "maker": "maker:generate-content-drafts",
        "placements": [
          "placement:small-container"
        ],
        "needs": {
          "expected_seconds": 2,
          "network_egress": false,
          "memory_mb": 128
        },
        "id": "tool:compile-a-presentation-plan",
        "label": "Compile a presentation plan",
        "job": "Compile source material and a selected format into a presentation plan with its claims and setup requirements",
        "description": "Give material (id, title, claims and fields), format_id and formats (a document with a formats array). Returns rendered beats, the unchanged claim snapshot, source references, capabilities and setup requirements. Missing fields and claims are refused together. It neither saves the plan nor grants recording or publication authority.",
        "input_schema": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "material",
            "format_id",
            "formats"
          ],
          "properties": {
            "material": {
              "type": "object"
            },
            "format_id": {
              "type": "string",
              "minLength": 1
            },
            "formats": {
              "type": "object"
            }
          }
        },
        "output_schema": {
          "type": "object",
          "required": [
            "id",
            "beats",
            "requirements",
            "claim_snapshot"
          ]
        },
        "invoke": {
          "kind": "container",
          "stdout": "json",
          "workdir": "/opt/parts/generate-content-drafts",
          "run": [
            "node",
            "do-work/compile-presentation-plan.mjs",
            "--json"
          ],
          "stdin": {
            "fill": {
              "from": "input"
            }
          },
          "files": {
            "package_files": [
              {
                "package": "generate-content-drafts",
                "paths": [
                  "do-work"
                ],
                "at": "/opt/parts/generate-content-drafts"
              },
              {
                "package": "content-identity",
                "paths": [
                  "read-data"
                ],
                "at": "/opt/parts/content-identity"
              },
              {
                "packages": ["node_modules/@noble/hashes"],
                "paths": [
                  "LICENSE",
                  "package.json",
                  "blake3.js",
                  "blake2.js",
                  "_blake.js",
                  "_md.js",
                  "_u64.js",
                  "utils.js"
                ],
                "at": "/opt/node_modules/@noble/hashes"
              }
            ]
          }
        },
        "result_selector": "$.result",
        "provenance": {
          "source": "Exact retained source copy at Workshop 9427b9a0, followed by the JSON command adapter; original private paths and byte identities are in the source-first port contracts."
        },
        "verify": [
          {
            "kind": "sample-run",
            "input": {
              "material": {
                "id": "sample-material",
                "title": "Sample",
                "claims": [],
                "fields": {
                  "statement": "An observed example."
                }
              },
              "format_id": "sample-format",
              "formats": {
                "formats": [
                  {
                    "id": "sample-format",
                    "title": "An example",
                    "beats": [
                      {
                        "id": "opening",
                        "template": "{statement}"
                      }
                    ],
                    "requirements": [],
                    "execution": {
                      "adapter": "text"
                    }
                  }
                ]
              }
            },
            "output_selector": "$.beats.0.text",
            "contains": "An observed example."
          }
        ]
      }
    },
    {
      "id": "package::generate-content-drafts::tool::check-a-presentation-plans-readiness",
      "address": "package::generate-content-drafts::tool::check-a-presentation-plans-readiness",
      "path": [
        "current-item",
        "published-record"
      ],
      "payload": {
        "uses_tools": [
          "trillion-workshop/content-identity"
        ],
        "kind": "ai-tool-descriptor",
        "status": "active",
        "read_only": true,
        "licence_class": "licence:maker-own",
        "maker": "maker:generate-content-drafts",
        "placements": [
          "placement:small-container"
        ],
        "needs": {
          "expected_seconds": 2,
          "network_egress": false,
          "memory_mb": 128
        },
        "id": "tool:check-a-presentation-plans-readiness",
        "label": "Check a presentation plan is ready",
        "job": "Check a compiled presentation plan against available capabilities and fresh observations before authorization",
        "description": "Give plan, capabilities (an array of available capability names), observations (keyed by requirement key, each with value, method and observed_at_ms), and optionally now_ms. Returns setup problems or ready_to_authorize. Requirements must declare accepted methods and a finite nonnegative max_age_seconds. Operator evidence cannot stand in for a sensor-only requirement. Input observations are caller-supplied; the tool does not authenticate sensors, grant permission or start recording.",
        "input_schema": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "plan",
            "capabilities",
            "observations"
          ],
          "properties": {
            "plan": {
              "type": "object"
            },
            "capabilities": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "observations": {
              "type": "object"
            },
            "now_ms": {
              "type": "number"
            }
          }
        },
        "output_schema": {
          "type": "object",
          "required": [
            "plan_id",
            "state",
            "problems",
            "requirements"
          ]
        },
        "invoke": {
          "kind": "container",
          "stdout": "json",
          "workdir": "/opt/parts/generate-content-drafts",
          "run": [
            "node",
            "do-work/evaluate-presentation-readiness.mjs",
            "--json"
          ],
          "stdin": {
            "fill": {
              "from": "input"
            }
          },
          "files": {
            "package_files": [
              {
                "package": "generate-content-drafts",
                "paths": [
                  "do-work"
                ],
                "at": "/opt/parts/generate-content-drafts"
              }
            ]
          }
        },
        "result_selector": "$.result",
        "provenance": {
          "source": "Exact retained source copy at Workshop 9427b9a0, followed by the JSON command adapter; original private paths and byte identities are in the source-first port contracts."
        },
        "verify": [
          {
            "kind": "sample-run",
            "input": {
              "plan": {
                "id": "sample-plan",
                "requirements": [],
                "capabilities": []
              },
              "capabilities": [],
              "observations": {},
              "now_ms": 1000
            },
            "output_selector": "$.state",
            "contains": "ready_to_authorize"
          }
        ]
      }
    },
    {
      "id": "package::generate-content-drafts::tool::choose-a-content-style",
      "address": "package::generate-content-drafts::tool::choose-a-content-style",
      "path": [
        "current-item",
        "published-record"
      ],
      "payload": {
        "uses_tools": [
          "trillion-workshop/content-identity"
        ],
        "kind": "ai-tool-descriptor",
        "status": "active",
        "read_only": true,
        "licence_class": "licence:maker-own",
        "maker": "maker:generate-content-drafts",
        "placements": [
          "placement:small-container"
        ],
        "needs": {
          "expected_seconds": 2,
          "network_egress": false,
          "memory_mb": 128
        },
        "id": "tool:choose-a-content-style",
        "label": "Choose a content style",
        "job": "Choose a content style manually or from ordered rules for the supplied media shape",
        "description": "Give shape (the available input properties), rules (the rules document), optionally mode (manual or rule), and definition for manual selection. Returns the first matching definition, mode and unchanged shape. The container row runs no local AI or caller-supplied program. An unmatched rule reports local_ai_required; authorized local CLI callers retain the original AI mode with their rules file.",
        "input_schema": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "shape",
            "rules"
          ],
          "properties": {
            "shape": {
              "type": "object"
            },
            "rules": {
              "type": "object"
            },
            "mode": {
              "type": "string"
            },
            "definition": {
              "type": "string"
            }
          }
        },
        "output_schema": {
          "type": "object",
          "required": [
            "definition",
            "mode",
            "shape"
          ]
        },
        "invoke": {
          "kind": "container",
          "stdout": "json",
          "workdir": "/opt/parts/generate-content-drafts",
          "run": [
            "node",
            "do-work/media-classify.mjs",
            "--json"
          ],
          "stdin": {
            "fill": {
              "from": "input"
            }
          },
          "files": {
            "package_files": [
              {
                "package": "generate-content-drafts",
                "paths": [
                  "do-work"
                ],
                "at": "/opt/parts/generate-content-drafts"
              }
            ]
          }
        },
        "result_selector": "$.result",
        "provenance": {
          "source": "Exact retained source copy at Workshop 9427b9a0, followed by the JSON command adapter; original private paths and byte identities are in the source-first port contracts."
        },
        "verify": [
          {
            "kind": "sample-run",
            "input": {
              "shape": {
                "video": true,
                "audio": true
              },
              "rules": {
                "execution": { "default_mode": "rule" },
                "rules": [{ "when": { "video": true, "audio": true }, "definition": "action:sample-video" }]
              }
            },
            "output_selector": "$.mode",
            "contains": "rule"
          }
        ]
      }
    }
  ]
}
