        "id": "tool:compile-a-presentation-plan",
        "label": "Compile a presentation plan",
        "job": "Compile source material and a selected format into a presentation plan with its claims and setup requirements",
        "description": "Give material (id, title, claims and fields), format_id and formats (a document with a formats array). Returns rendered beats, the unchanged claim snapshot, source references, capabilities and setup requirements. Missing fields and claims are refused together. It neither saves the plan nor grants recording or publication authority.",
        "input_schema": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "material",
            "format_id",
            "formats"
          ],
          "properties": {
            "material": {
              "type": "object"
            },
            "format_id": {
              "type": "string",
              "minLength": 1
            },
            "formats": {
              "type": "object"
            }
          }
        },
        "output_schema": {
          "type": "object",
          "required": [
            "id",
            "beats",
            "requirements",
            "claim_snapshot"
          ]
        },
        "invoke": {
          "kind": "container",
          "internet": false,
          "stdout": "json",
          "workdir": "/opt/parts/generate-content-drafts",
          "argv": [
            "node",
            "do-work/compile-presentation-plan.mjs",
            "--json"
          ],
          "stdin": {
            "fill": {
              "from": "input"
            }
          },
          "files": {
            "package_files": [
              {
                "package": "generate-content-drafts",
                "paths": [
                  "do-work"
                ],
                "at": "/opt/parts/generate-content-drafts"
              },
              {
                "package": "content-identity",
                "paths": [
                  "read-data"
                ],
                "at": "/opt/parts/content-identity"
              },
              {
                "packages": ["node_modules/@noble/hashes"],
                "paths": [
                  "LICENSE",
                  "package.json",
                  "blake3.js",
                  "blake2.js",
                  "_blake.js",
                  "_md.js",
                  "_u64.js",
                  "utils.js"
                ],
                "at": "/opt/node_modules/@noble/hashes"
              }
            ]
          }
        },
        "result_selector": "$.result",
        "provenance": {
          "source": "Exact retained source copy at Workshop 9427b9a0, followed by the JSON command adapter; original private paths and byte identities are in the source-first port contracts."
        },
