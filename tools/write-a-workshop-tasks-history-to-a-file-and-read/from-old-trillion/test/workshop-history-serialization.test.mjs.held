import test from 'node:test';
import assert from 'node:assert/strict';
import { sqliteHost } from '../src/local-store.mjs';
import { workshopFactsTable } from '../../../keep-each-workshop-task-whole-and-a-small-index/from-old-trillion/src/workshop-tasks.mjs.held';
import { workshopHistorySource, workshopHistorySlice, workshopHistoryHex, workshopHistoryWholeBound } from '../src/workshop-history-serialization.mjs';
const encoder = new TextEncoder();
const decoder = new TextDecoder('utf-8', { fatal: true });
test('bounded source-byte cursors exactly serialize ASCII, escaped controls, raw NUL and astral UTF-8 across restart boundaries', t => {
  const host = sqliteHost(':memory:'); t.after(() => host.db.close()); workshopFactsTable(host.sql);
  for (const value of ['x'.repeat(4096), String.fromCodePoint(233,0x1f9f5,34,92,10,0).repeat(500)]) {
    const row = { at: 'at' + String.fromCodePoint(0,233), entity: 'task:' + String.fromCodePoint(0x1f9f5,34), value };
    const seq = host.sql.exec('INSERT INTO workshop_facts (at, entity, value) VALUES (?, ?, ?) RETURNING seq', row.at,row.entity,row.value).toArray()[0].seq;
    const reads = [];
    const sql = { exec(query,...params) { assert.ok(!query.includes('json_object'), 'streaming serialization never quotes the whole row in SQLite'); reads.push({query,params}); return host.sql.exec(query,...params); } };
    const source = workshopHistorySource(sql,seq),expected = encoder.encode(JSON.stringify({seq,...row}));
    assert.ok(workshopHistoryWholeBound(seq,source) >= expected.length);
    let cursor={stage:0,byte:0},size=0;
    const pieces=[];
    for(let step=0;step<2000;step++) {
      reads.length=0;
      const result=workshopHistorySlice(sql,seq,source,structuredClone(cursor),256);
      assert.ok(result.bytes.length<=256); assert.ok(reads.length<=16);
      assert.notDeepEqual(result.cursor,cursor);
      for(const read of reads){assert.ok(read.params[1]<=Math.floor(256/6));assert.match(read.query,/hex\(substr\(CAST\((at|entity|value) AS BLOB\)/);}
      pieces.push(result.bytes);size+=result.bytes.length;cursor=JSON.parse(JSON.stringify(result.cursor));
      if(result.final)break;
      assert.ok(step<1999,'bounded continuation must terminate');
    }
    assert.equal(cursor.stage,7);
    const whole=new Uint8Array(size);let offset=0;for(const piece of pieces){whole.set(piece,offset);offset+=piece.length;}
    assert.deepEqual(whole,expected); assert.deepEqual(JSON.parse(decoder.decode(whole)),{seq,...row});
    assert.equal(workshopHistoryHex(whole),Buffer.from(expected).toString('hex').toUpperCase());
  }
});
