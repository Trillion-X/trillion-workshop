// packages/practice-decision-loop/tests/published-records-scoped-feed.test.ts
// L126 scoped-feed guard: PracticeDecisionLoopSurface reads the 18 decision-loop kinds
// (read-practice-decision-loop). This locks the `published-records` input to a
// kind-scoped json_array feed (`package::practice-decision-loop::decision-feed`, in:[18])
// instead of the raw 34.7MB aggregate — excludes the ~22MB operational-exhaust kinds
// (ai-execution-run/agent-decision/etc.), which are NOT in this list. Consumer
// payloadFromRow reads `row.payload ?? row.value ?? row` → no change.
import { describe, expect, it } from 'vitest';
import { readFileSync } from 'node:fs';
import { join } from 'node:path';

const FEED = 'package::practice-decision-loop::decision-feed';
const KINDS = [
  'access-snapshot', 'comparison-result', 'content-reference', 'decision-debrief',
  'decision-event', 'decision-evidence', 'decision-prompt', 'decision-response',
  'decision-subject', 'evidence-attachment', 'follow-up-step', 'judge-result',
  'media-evidence-link', 'practice-step', 'profile-effect', 'progress-effect',
  'response-reason', 'review-schedule',
];

interface Thing {
  type?: string;
  address?: string;
  payload?: Record<string, unknown>;
  payload_bytes?: Record<string, unknown>;
}

const manifest = JSON.parse(
  readFileSync(join(__dirname, '..', 'things-to-store-and-run.json'), 'utf8'),
) as { things: Thing[] };

describe('practice-decision-loop published-records scoped feed (L126)', () => {
  it('declares a json_array multi-kind (in:[...]) scoped sink with all 18 kinds', () => {
    const sink = manifest.things.find(
      (t) => t.type === 'record_from_matching_records' && t.address === FEED,
    );
    expect(sink).toBeTruthy();
    const b = sink!.payload_bytes as {
      value_to_bytes?: string;
      rows?: { match?: Array<{ path?: string[]; in?: string[] }> };
    };
    expect(b.value_to_bytes).toBe('json_array');
    const m = b.rows?.match ?? [];
    expect(m.find((x) => x.path?.[0] === 'payload' && x.path?.[1] === 'kind')?.in).toEqual(KINDS);
    expect(m.some((x) => x.path?.length === 1 && x.path?.[0] === 'payload')).toBe(true);
  });

  it('the published-records input reads the scoped feed, not the raw aggregate', () => {
    const desc = manifest.things.find(
      (t) => t.payload?.input_name === 'published-records' && t.payload?.kind === 'bitfield-input-descriptor',
    );
    expect(desc).toBeTruthy();
    const p = desc!.payload as any;
    const loc = p.selected_payload ?? p;
    expect(loc.value_address_label).toBe(FEED);
    expect(loc.value?.source_bytes?.bytes_to_value).toBe('json');
  });

  it('NO descriptor points at the raw published-records aggregate', () => {
    const raw = manifest.things.filter((t) => {
      const p = t.payload as any;
      if (p?.kind !== 'bitfield-input-descriptor') return false;
      return (
        p.value_address_label === 'published-records' ||
        p.selected_payload?.value_address_label === 'published-records'
      );
    });
    expect(raw).toEqual([]);
  });
});
