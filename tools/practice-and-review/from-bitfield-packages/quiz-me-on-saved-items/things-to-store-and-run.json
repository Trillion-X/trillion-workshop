                    "current-item",
                    "published-record"
                  ],
                  "payload": {
                    "kind": "question-sequence",
                    "formId": {
                      "$kind": "binding",
                      "select": {
                        "from": "input",
                        "path": "request_id"
                      },
                      "transform": [
                        {
                          "op": "op:core.concat",
                          "args": {
                            "values": [
                              "recall:",
                              {
                                "$kind": "binding",
                                "select": {
                                  "from": "input",
                                  "path": "request_id"
                                }
                              }
                            ]
                          }
                        }
                      ]
                    },
                    "title": {
                      "$kind": "binding",
                      "select": {
                        "from": "input",
                        "path": "source_title"
                      },
                      "transform": [
                        {
                          "op": "op:core.concat",
                          "args": {
                            "values": [
                              "Recall: ",
                              {
                                "$kind": "binding",
                                "select": {
                                  "from": "input",
                                  "path": "source_title"
                                }
                              }
                            ]
                          }
                        }
                      ]
                    },
                    "sourceRef": {
                      "$kind": "binding",
                      "select": {
                        "from": "input",
                        "path": "source_ref"
                      }
                    },
                    "questions": [
                      {
                        "questionId": "multiple-choice",
                        "questionTypeId": "choice",
                        "label": {
                          "$kind": "binding",
                          "select": {
                            "from": "input",
                            "path": "items.0.text"
                          }
                        },
                        "required": true,
                        "options": [
                          {
                            "value": "A",
                            "label": "A"
                          },
                          {
                            "value": "B",
                            "label": "B"
                          },
                          {
                            "value": "C",
                            "label": "C"
                          },
                          {
                            "value": "D",
                            "label": "D"
                          }
                        ]
                      },
                      {
                        "questionId": "single-choice",
                        "questionTypeId": "choice",
                        "label": {
                          "$kind": "binding",
                          "select": {
                            "from": "input",
                            "path": "items.1.text"
                          }
                        },
                        "required": true,
                        "options": [
                          {
                            "value": "A",
                            "label": "A"
                          },
                          {
                            "value": "B",
                            "label": "B"
                          },
                          {
                            "value": "C",
                            "label": "C"
                          },
                          {
                            "value": "D",
                            "label": "D"
                          }
                        ]
                      },
                      {
                        "questionId": "open-ended-synthesis",
                        "questionTypeId": "text",
                        "label": {
                          "$kind": "binding",
                          "select": {
                            "from": "input",
                            "path": "items.2.text"
                          }
                        },
                        "required": true,
                        "placeholder": "Explain it in your own words."
                      }
                    ]
                  }
                }
              ]
            }
          }
        ],
