        "kind": "ai-tool-descriptor",
        "id": "tool:list-what-is-due",
        "label": "List what is due for review",
        "status": "active",
        "job": "See which of the things a person is learning are due for review now, soonest first, from the grades they have given them",
        "description": "Give the items being learned (each with an id and optional text; anything else on an item is handed back), the grades given so far (the item id, the grade word and when) and the person's own spacing policy. Each item's due time is folded from its grades, oldest first, so the grades are the only record and the queue cannot drift from them. Returns every item with whether it is due now, when it is next due, its state to keep, how many grades went into it and how many of them lapsed (lapse_count). Items never reviewed are due at once. Due items come first, soonest due first, then by text and id. Pass learner to count only that person's grades. The policy may be given as policy or found among rows by policy_kind. There is no default policy: a missing policy or field is refused with its name.",
        "input_schema": {
          "type": "object",
          "required": [
            "prompts"
          ],
          "properties": {
            "prompts": {
              "type": "array",
              "description": "The items being learned: [{ id, text? }]. Each id appears once.",
              "items": {
                "type": "object",
                "required": [
                  "id"
                ],
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "text": {
                    "type": "string"
                  }
                }
              }
            },
            "responses": {
              "type": "array",
              "description": "The grades given so far, in any order: [{ prompt_id, grade, at, learner? }].",
              "items": {
                "type": "object",
                "required": [
                  "prompt_id",
                  "grade",
                  "at"
                ],
                "properties": {
                  "prompt_id": {
                    "type": "string"
                  },
                  "grade": {
                    "type": "string"
                  },
                  "at": {
                    "type": "string"
                  },
                  "learner": {
                    "type": "string"
                  }
                }
              }
            },
            "now": {
              "type": "string",
              "description": "The time to judge against, such as 2026-01-31T09:00:00Z. Defaults to now."
            },
            "rows": {
              "type": "array",
              "description": "The person's records. When policy is left out, the first row whose kind is policy_kind is the policy."
            },
            "policy_kind": {
              "type": "string",
              "description": "The kind the person gave their policy record, used with rows."
            },
            "learner": {
              "type": "string",
              "description": "Count only the grades whose learner is this."
            },
            "policy": {
              "type": "object",
              "description": "The person's spacing policy, as for tool:schedule-next-review. Every field is required.",
              "required": [
                "initial_ease",
                "min_ease",
                "first_interval_days",
                "second_interval_days",
                "lapse_below_quality",
                "grade_quality"
              ],
              "properties": {
                "initial_ease": {
                  "type": "number"
                },
                "min_ease": {
                  "type": "number"
                },
                "first_interval_days": {
                  "type": "number"
                },
                "second_interval_days": {
                  "type": "number"
                },
                "lapse_below_quality": {
                  "type": "number"
                },
                "grade_quality": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "number"
                  }
                }
              }
            }
          }
        },
        "output_schema": {
          "type": "object",
          "required": [
            "now",
            "due_count",
            "items"
          ],
          "properties": {
            "now": {
              "type": "string"
            },
            "due_count": {
              "type": "number"
            },
            "items": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "prompt",
                  "is_due",
                  "review_count",
                  "state",
                  "due_at"
                ],
                "properties": {
                  "prompt": {
                    "type": "object"
                  },
                  "is_due": {
                    "type": "boolean"
                  },
                  "review_count": {
                    "type": "number"
                  },
                  "lapse_count": {
                    "type": "number"
                  },
                  "state": {
                    "type": [
                      "object",
                      "null"
                    ]
                  },
                  "due_at": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                }
              }
            }
          }
        },
        "invoke": {
          "kind": "container",
          "files": {
            "package_files": [
              {
                "package": "practice-and-review",
                "paths": [
                  "do-work",
                  "read-data"
                ],
                "at": "/opt/practice-and-review"
              },
              {
                "package": "content-identity",
                "paths": [
                  "read-data/identity.mjs"
                ],
                "at": "/opt/content-identity"
              }
            ]
          },
          "workdir": "/opt/practice-and-review",
          "stdout": "json",
          "run": [
            "node",
            "do-work/list-what-is-due.mjs"
          ],
          "stdin": {
            "fill": {
              "from": "input"
            }
          }
        },
        "result_selector": "$",
        "needs": {
          "expected_seconds": 20,
          "network_egress": false,
          "memory_mb": 256
        },
        "licence_class": "licence:maker-own",
        "placements": [
          "placement:small-container"
        ],
        "maker": "maker:practice-and-review",
        "provenance": {
          "source": "bitfield-packages packages/spaced-repetition"
        },
        "verify": [
          {
            "kind": "sample-run",
            "input": {
              "prompts": [
                {
                  "id": "card-1",
                  "text": "Alpha"
                },
                {
                  "id": "card-2",
                  "text": "Beta"
                }
              ],
              "responses": [
                {
                  "prompt_id": "card-1",
                  "grade": "solid",
                  "at": "2026-01-01T12:00:00Z"
                }
              ],
              "now": "2026-01-01T18:00:00Z",
              "policy": {
                "initial_ease": 2.5,
                "min_ease": 1.3,
                "first_interval_days": 1,
                "second_interval_days": 6,
                "lapse_below_quality": 0.6,
                "grade_quality": {
                  "miss": 0,
                  "shaky": 0.6,
                  "solid": 0.8,
                  "instant": 1
                }
              }
            },
            "output_selector": "$.items[0].prompt.id",
            "contains": "card-2"
          }
        ]
      }
    }
  ]
