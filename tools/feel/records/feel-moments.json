      "sound": { "tones": [{ "at": 0, "hz": 1760, "ms": 40, "gain": 0.04, "wave": "sine" }, { "at": 0.18, "hz": 659.25, "hz_to": 1318.51, "ms": 360, "gain": 0.03, "wave": "sine" }, { "at": 0.55, "hz": 1760, "ms": 260, "gain": 0.055, "wave": "triangle" }] },
      "motion": { "keyframes": [{ "transform": "scale(1)", "filter": "brightness(1)" }, { "transform": "scale(1.06)", "filter": "brightness(1.25)" }, { "transform": "scale(1)", "filter": "brightness(1)" }], "options": { "duration": 700, "easing": "cubic-bezier(0.22, 1, 0.36, 1)" }, "reduced": { "keyframes": [{ "filter": "brightness(1)" }, { "filter": "brightness(1.2)" }, { "filter": "brightness(1)" }], "options": { "duration": 300 } } }
