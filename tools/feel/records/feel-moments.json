      "label": "Sent",
      "haptic": { "events": [{ "at": 0, "intensity": 0.45, "sharpness": 0.7 }, { "at": 0.01, "intensity": 0.2, "sharpness": 0.3, "duration": 0.08 }], "vibrate": [15] },
      "sound": { "tones": [{ "at": 0, "hz": 987.77, "hz_to": 1318.51, "ms": 90, "gain": 0.035, "wave": "sine" }] },
      "motion": { "keyframes": [{ "transform": "translateY(0)", "opacity": 1 }, { "transform": "translateY(-6px)", "opacity": 0.7 }, { "transform": "translateY(0)", "opacity": 1 }], "options": { "duration": 220, "easing": "cubic-bezier(0.3, 0, 0.8, 0.15)" }, "reduced": { "keyframes": [{ "opacity": 1 }, { "opacity": 0.7 }, { "opacity": 1 }], "options": { "duration": 150 } } }
