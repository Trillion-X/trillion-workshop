      "sound": { "tones": [{ "at": 0, "hz": 880, "ms": 60, "gain": 0.05, "wave": "sine" }, { "at": 0.09, "hz": 1108.73, "ms": 110, "gain": 0.05, "wave": "sine" }] },
      "motion": { "keyframes": [{ "transform": "scale(1)" }, { "transform": "scale(1.04)" }, { "transform": "scale(1)" }], "options": { "duration": 260, "easing": "cubic-bezier(0.22, 1, 0.36, 1)" }, "reduced": { "keyframes": [{ "opacity": 1 }, { "opacity": 0.75 }, { "opacity": 1 }], "options": { "duration": 150 } } }
    },
