      "sound": { "tones": [{ "at": 0, "hz": 1108.73, "ms": 70, "gain": 0.035, "wave": "sine" }, { "at": 0.1, "hz": 1479.98, "ms": 120, "gain": 0.035, "wave": "sine" }] }
    },
