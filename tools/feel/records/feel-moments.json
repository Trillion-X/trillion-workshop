    "error": {
      "label": "Did not work",
      "haptic": { "events": [{ "at": 0, "intensity": 0.75, "sharpness": 0.3 }, { "at": 0.07, "intensity": 0.75, "sharpness": 0.3 }, { "at": 0.14, "intensity": 0.55, "sharpness": 0.2 }], "vibrate": [40, 50, 40, 50, 40] },
      "sound": { "tones": [{ "at": 0, "hz": 329.63, "ms": 80, "gain": 0.045, "wave": "triangle" }, { "at": 0.08, "hz": 277.18, "ms": 140, "gain": 0.045, "wave": "triangle" }] },
      "motion": { "keyframes": [{ "transform": "translateX(0)" }, { "transform": "translateX(-4px)" }, { "transform": "translateX(4px)" }, { "transform": "translateX(-3px)" }, { "transform": "translateX(3px)" }, { "transform": "translateX(0)" }], "options": { "duration": 300, "easing": "ease-out" }, "reduced": { "keyframes": [{ "opacity": 1 }, { "opacity": 0.6 }, { "opacity": 1 }], "options": { "duration": 150 } } }
