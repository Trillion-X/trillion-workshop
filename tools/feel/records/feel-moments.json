  },
  "moments": [
    { "id": "work-done", "label": "Work you asked for is done", "on": { "event_kind": "work-done" }, "feel": "done" },
    { "id": "work-failed", "label": "Something did not work", "on": { "event_kind": "work-failed" }, "feel": "error" },
    { "id": "press-done", "label": "A button finished its work", "on": { "event_kind": "press-done" }, "feel": "done" },
    { "id": "press-failed", "label": "A button's work did not work", "on": { "event_kind": "press-failed" }, "feel": "error" },
    { "id": "message-sent", "label": "A message leaves your hands", "on": { "event_kind": "message-sent" }, "feel": "sent" },
    { "id": "message-failed", "label": "A message could not be sent", "on": { "event_kind": "message-failed" }, "feel": "error" },
    { "id": "notice-problem", "label": "A notice says something went wrong", "on": { "event_kind": "notice-arrived", "match": { "kind": "error" } }, "feel": "error" },
    { "id": "notice-arrived", "label": "A notice arrives", "on": { "event_kind": "notice-arrived" }, "feel": "arrived" },
    { "id": "chosen", "label": "You choose something in a menu", "on": { "event_kind": "chosen" }, "feel": "selected" },
    { "id": "lifted", "label": "You pick something up to move it", "on": { "event_kind": "lifted" }, "feel": "lifted" },
    { "id": "dropped", "label": "You drop something in its place", "on": { "event_kind": "dropped" }, "feel": "dropped" },
    { "id": "tour-finished", "label": "You finish a tour", "on": { "event_kind": "tour-finished" }, "feel": "celebrate" },
    { "id": "needle-found", "label": "Your needle mover is found", "on": { "event_kind": "needle-found" }, "feel": "needle" }
