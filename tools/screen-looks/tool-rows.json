        "kind": "ai-tool-descriptor",
        "id": "tool:read-current-worn-look",
        "label": "Read my current screen look",
        "status": "active",
        "read_only": true,
        "licence_class": "licence:maker-own",
        "placements": ["placement:small-container"],
        "maker": "maker:screen-looks",
        "needs": { "expected_seconds": 1, "network_egress": false },
        "job": "Read this person's current worn screen look, look rules and day plan as the device token payload native screens draw",
        "description": "Reads this person's current worn screen look and returns the token payload native screens draw: every wearable look, the look now (including a scheduled blend), upcoming changes for twelve hours, and when to read again. `app_data` is the calling app owner's current look DATA: its starting look and themes, plan anchors/presets, and rule facts. Those values are supplied at runtime, never chosen by this generic reader. time_zone is required and must be an IANA zone. host, device, device_id and place are the facts this native screen says about itself; only saved rules matching those facts select another look. The person's own saved values (the worn choice, own themes, look-over-time plan and look rules) come in `saved`, read by the caller from wherever the person keeps them; it reaches no database. A missing personal choice uses `app_data.looks.start_with`. Returns `{ worn, worn_record, now, ahead, looks, read_again_at }` in the DeviceLooks token format.",
        "input_schema": {
          "type": "object",
          "required": ["time_zone", "app_data"],
          "additionalProperties": false,
          "properties": {
            "time_zone": { "type": "string", "minLength": 1, "description": "The native device's IANA time zone, such as America/Denver" },
            "host": { "type": "string", "description": "The app or place where the native screen is drawn, from the saved look rules' hosts" },
            "device": { "type": "string", "description": "The device kind, from the saved look rules' devices" },
            "device_id": { "type": "string", "description": "The particular device id, when the native host has one" },
            "place": { "type": "string", "description": "The screen or area of the app, when the native host knows it" },
            "app_data": {
              "type": "object",
              "required": ["looks", "look_over_time", "where_looks_apply"],
              "properties": {
                "looks": { "type": "object", "required": ["start_with", "themes"], "properties": { "start_with": { "type": "string" }, "themes": { "type": "array", "items": { "type": "object" } } } },
                "look_over_time": { "type": "object", "required": ["record_key", "most_points", "keep_readable", "anchors", "presets"], "properties": { "record_key": { "type": "string" }, "most_points": { "type": "integer", "minimum": 1 }, "keep_readable": { "type": "object", "required": ["ground", "least_contrast"], "properties": { "ground": { "type": "string" }, "least_contrast": { "type": "number" } } }, "anchors": { "type": "array", "items": { "type": "object" } }, "presets": { "type": "array", "items": { "type": "object" } } } },
                "where_looks_apply": { "type": "object", "required": ["record_key", "facts"], "properties": { "record_key": { "type": "string" }, "facts": { "type": "array", "items": { "type": "object", "required": ["id", "kind"], "properties": { "id": { "type": "string" }, "kind": { "type": "string" }, "turns": { "type": "string" } } } } } }
              }
            },
            "saved": {
              "type": "object",
              "description": "The person's saved look values by name, read by the caller from wherever the person keeps them: screen-look (the worn choice), screen-look-own-themes, and workspace-preference:<look_over_time.record_key> and workspace-preference:<where_looks_apply.record_key>. A value left out is one never saved."
            }
          }
        },
        "output_schema": {
          "type": "object",
          "required": ["worn", "worn_record", "now", "ahead", "looks", "read_again_at"],
          "properties": {
            "worn": { "type": "string" },
            "worn_record": { "type": "object", "required": ["address", "payload"] },
            "now": { "$ref": "#/$defs/device_look" },
            "ahead": { "type": "array", "items": { "type": "object", "required": ["at", "look"], "properties": { "at": { "type": "string" }, "look": { "$ref": "#/$defs/device_look" } } } },
            "looks": { "type": "array", "items": { "$ref": "#/$defs/device_look" } },
            "read_again_at": { "type": ["string", "null"] }
          },
          "$defs": {
            "device_look": {
              "type": "object",
              "required": ["look_id", "name", "colors", "lengths", "faces", "button"],
              "properties": {
                "look_id": { "type": "string" }, "name": { "type": "string" },
                "colors": { "type": "object", "additionalProperties": { "type": "array", "minItems": 4, "maxItems": 4, "items": { "type": "number", "minimum": 0, "maximum": 1 } } },
                "lengths": { "type": "object", "additionalProperties": { "type": "number" } },
                "faces": { "type": "object", "additionalProperties": { "type": "array", "items": { "type": "string" } } },
                "button": { "type": "object" }
              }
            }
          }
        },
        "invoke": {
          "kind": "container",
          "internet": false,
          "workdir": "/opt/screen-looks",
          "stdout": "json",
          "argv": [
            "node",
            "/opt/workflows/do-work/run-a-function.mjs",
            "/opt/screen-looks/do-work/read-current-worn-look.mjs",
            "readCurrentWornLook"
          ],
          "stdin": {
            "fill": {
              "from": "input"
            }
          },
          "files": {
            "package_files": [
              {
                "package": "screen-looks",
                "paths": [
                  "do-work",
                  "read-data"
                ],
                "at": "/opt/screen-looks"
              },
              {
                "package": "run-work-later-or-on-a-repeat",
                "paths": [
                  "do-work/timed-action.mjs",
                  "built-stored-bytes/timed-action"
                ],
                "at": "/opt/run-work-later-or-on-a-repeat"
              },
              {
                "package": "formula-engine",
                "paths": [
                  "rules",
                  "built-stored-bytes/formula-engine"
                ],
                "at": "/opt/node_modules/trillion-workshop/tools/formula-engine"
              },
              {
                "package": "workflows",
                "paths": [
                  "do-work/run-a-function.mjs"
                ],
                "at": "/opt/workflows"
              }
            ]
          }
        },
        "provenance": { "source": "src/looks.mjs device(), src/workspace/inputs.json and tools/screen-look/read-data; generic reader consumes app-owned look, schedule and rule DATA supplied by its caller" },
        "result_selector": "$.result",
        "verify": [{ "kind": "sample-run", "input": { "time_zone": "UTC", "host": "mac", "device": "computer", "app_data": { "looks": { "start_with": "harbor", "themes": [{ "address": "look:harbor", "payload": { "kind": "screen-look-editable-theme", "id": "harbor", "name": "Harbor", "tokens": [{ "key": "accent-primary", "kind": "color", "value": "#247b70", "css_variable": "--accent-primary" }] } }, { "address": "look:dusk", "payload": { "kind": "screen-look-editable-theme", "id": "dusk", "name": "Dusk", "tokens": [{ "key": "accent-primary", "kind": "color", "value": "#7b4f92", "css_variable": "--accent-primary" }] } }] }, "look_over_time": { "record_key": "screen-look-over-time", "most_points": 24, "keep_readable": { "ground": "--bg-primary", "least_contrast": 2.5 }, "anchors": [], "presets": [] }, "where_looks_apply": { "record_key": "where-looks-apply", "facts": [{ "id": "host", "kind": "choice" }, { "id": "device", "kind": "choice" }, { "id": "device_id", "kind": "choice" }, { "id": "place", "kind": "choice" }, { "id": "hour", "kind": "number", "turns": "hour" }, { "id": "weekday", "kind": "choice", "turns": "hour" }, { "id": "now", "kind": "date", "clock": true }] } }, "saved": { "screen-look": [{ "name": "dusk" }] } } }]
      }
    },
