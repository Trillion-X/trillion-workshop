// packages/revenue-ledger/vitest.config.mjs
//
// Focused vitest config for the revenue-ledger package.
// Mirrors the workspace root alias setup so @/ imports resolve when running
// tests in isolation:
//   npx vitest run --configLoader runner --config packages/revenue-ledger/vitest.config.mjs packages/revenue-ledger/__tests__
import { fileURLToPath } from 'node:url';
import { defineConfig } from 'vitest/config';

const root = fileURLToPath(new URL('../../', import.meta.url));

export default defineConfig({
  resolve: {
    alias: [
      {
        find: '@',
        replacement: root,
      },
    ],
  },
  test: {
    environment: 'node',
  },
});
