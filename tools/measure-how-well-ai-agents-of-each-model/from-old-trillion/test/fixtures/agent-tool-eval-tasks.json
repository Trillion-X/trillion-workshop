{
 "_what": "The tasks scripts/run-agent-tool-evals.mjs gives AI agents, with the settings every run shares. A task is plain DATA: area; job (what the person asks, in their words, never naming a tool); values (extra {names} the job and records use, beside {run}, a name unique to one run so two runs in one account never touch each other's records); seed (MCP calls that make the starting state, run before the agent starts); on_path (the tools a good attempt may use, beside settings.always_fine); open_world_tools (tools that reach outside the account which this task needs); capture (values the agent's own calls made, { name, tool, path }, for a grader that reads what the agent made by its id); ready_when (a read that must show the seed before the agent starts, since the service keeps some lists a moment behind a write); grader (checks, each a read of the real records after the run and what must be true in it). A grader path is dot keys, [*] for every item, [field=text] and [field~pattern] to keep items. Adding a task is one row.",
 "settings": {
  "account_attempts": 8,
  "paid_plan_credential": "trillion-agent-work-key",
  "ready_wait_ms": 600000,
  "ready_probes": [
   {
    "tool": "list_lists",
    "arguments": {}
   },
   {
    "tool": "list_files",
    "arguments": {
     "folder": "/"
    }
   }
  ],
  "tool_timeout_ms": 120000,
  "run_timeout_ms": 420000,
  "platform_error_patterns": [
   "carry is continuing",
   "Resource quota",
   "still being imported",
   "Install the actual Namespace",
   "Waits until a place can keep it",
   "internal error; reference"
  ],
  "always_fine": [
   "find_tool_for_job",
   "describe_tool",
   "find_workflow",
   "describe_workflow",
   "search",
   "tool_sources",
   "list_connections",
   "whats_new"
  ],
  "agent_preamble": "You are the AI of a person who keeps their work in a Trillion account, which is connected to you as MCP tools. Do the job they ask using those tools, check that the result is really there, and then answer in one or two sentences saying what you did.",
  "seed_visible_wait_ms": 150000,
  "seed_recheck_ms": 20000,
  "sign_up_tries": 3
 },
 "tasks": [
  {
   "id": "mail-tasks-from-message",
   "area": "mail",
   "job": "Dana wrote to me in my messages (conversation {run}). Find what she asked me to do and put each thing on my list of tasks waiting for my approval, with its due date. Do not make the tasks yourself.",
   "seed": [
    {
     "tool": "record_messages",
     "arguments": {
      "messages": [
       {
        "conversation_id": "{run}",
        "app": "Mail",
        "speaker": "Dana",
        "text": "Hi, can you send the invoice to Acme by Friday 2026-11-06, and please book the venue for the offsite by 2026-11-13? Thanks, Dana"
       }
      ]
     }
    }
   ],
   "on_path": [
    "read_messages",
    "propose_tasks",
    "list_proposed_tasks"
   ],
   "grader": [
    {
     "id": "invoice-proposed",
     "read": {
      "tool": "list_proposed_tasks",
      "arguments": {}
     },
     "expect": [
      {
       "path": "proposals[title~invoice].due",
       "op": "equals",
       "value": "2026-11-06"
      }
     ]
    },
    {
     "id": "venue-proposed",
     "read": {
      "tool": "list_proposed_tasks",
      "arguments": {}
     },
     "expect": [
      {
       "path": "proposals[title~venue].due",
       "op": "equals",
       "value": "2026-11-13"
      }
     ]
    },
    {
     "id": "only-proposed-not-made",
     "read": {
      "tool": "list_proposed_tasks",
      "arguments": {}
     },
     "expect": [
      {
       "path": "proposals[*].state",
       "op": "only",
       "value": [
        "proposed"
       ]
      }
     ]
    }
   ],
   "ready_when": {
    "id": "seed-message",
    "read": {
     "tool": "read_messages",
     "arguments": {
      "conversation_id": "{run}"
     }
    },
    "expect": [
     {
      "path": "messages[*]",
      "op": "count",
      "value": 1
     }
    ]
   }
  },
  {
   "id": "calendar-weekly-run",
   "area": "calendar",
   "job": "Every Monday at 8:30 in the morning, Los Angeles time, start my workflow called \"Weekly digest {run}\". Make it repeat by itself.",
   "seed": [
    {
     "tool": "save_workflow",
     "arguments": {
      "workflow": {
       "id": "workflow:digest-{run}",
       "job": "Weekly digest {run}",
       "label": "Weekly digest {run}",
       "input_schema": {
        "type": "object",
        "properties": {
         "topic": {
          "type": "string"
         }
        }
       },
       "steps": [
        {
         "id": "one",
         "title": "Write it",
         "do": "Write one sentence about the topic",
         "submit": {
          "type": "object",
          "properties": {
           "sentence": {
            "type": "string"
           }
          }
         },
         "checks": []
        }
       ]
      }
     }
    }
   ],
   "on_path": [
    "find_workflow",
    "describe_workflow",
    "set_schedule",
    "list_schedules"
   ],
   "grader": [
    {
     "id": "one-schedule",
     "read": {
      "tool": "list_schedules",
      "arguments": {}
     },
     "expect": [
      {
       "path": "schedules[then.workflow_id=workflow:digest-{run}]",
       "op": "count",
       "value": 1
      }
     ]
    },
    {
     "id": "monday-0830-la",
     "read": {
      "tool": "list_schedules",
      "arguments": {}
     },
     "expect": [
      {
       "path": "schedules[then.workflow_id=workflow:digest-{run}].every.at",
       "op": "equals",
       "value": "08:30"
      },
      {
       "path": "schedules[then.workflow_id=workflow:digest-{run}].every.time_zone",
       "op": "equals",
       "value": "America/Los_Angeles"
      },
      {
       "path": "schedules[then.workflow_id=workflow:digest-{run}].every.on",
       "op": "has",
       "value": [
        "monday"
       ]
      }
     ]
    }
   ],
   "open_world_tools": [
    "set_schedule"
   ]
  },
  {
   "id": "lists-update-leads",
   "area": "lists",
   "job": "I keep my sales leads in the list called \"Leads {run}\". Add Acme (open, 9000), Birch (open, 1200) and Cedar (won, 4500). Then Birch fell through: mark it lost.",
   "seed": [
    {
