     ]
    },
    {
     "id": "birch-lost",
     "read": {
      "tool": "read_list",
      "arguments": {
       "list_id": "leads-{run}"
      }
     },
     "expect": [
      {
       "path": "rows[values.name=Birch].values.status",
       "op": "equals",
       "value": "lost"
      }
     ]
    },
    {
     "id": "others-kept",
     "read": {
      "tool": "read_list",
      "arguments": {
       "list_id": "leads-{run}"
      }
     },
     "expect": [
      {
       "path": "rows[values.name=Acme].values.amount",
       "op": "equals",
       "value": 9000
      },
      {
       "path": "rows[values.name=Cedar].values.status",
       "op": "equals",
       "value": "won"
      }
     ]
    }
   ],
   "ready_when": {
    "id": "seed-list",
    "read": {
     "tool": "read_list",
     "arguments": {
      "list_id": "leads-{run}"
     }
    },
    "expect": [
