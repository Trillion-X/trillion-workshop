    },
    {
     "id": "current-plan-kept",
     "read": {
      "tool": "list_files",
      "arguments": {
       "folder": "/plans/{run}"
      }
     },
     "expect": [
      {
       "path": "files[*].name",
       "op": "has_match",
       "value": "q4-plan\\.md"
      }
     ]
    }
   ],
   "ready_when": {
    "id": "seed-file",
    "read": {
     "tool": "list_files",
     "arguments": {
      "folder": "/plans/{run}"
     }
    },
    "expect": [
     {
      "path": "files[*].name",
      "op": "has_match",
      "value": "q4-plan-old"
     }
    ]
   }
