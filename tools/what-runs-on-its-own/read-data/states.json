{
  "_what": "The states one cause the engine wakes on its own (a fact it hears, a program it keeps running) can be in, as the screen shows them, and the steps between them. Each state's red says it needs the person: something that should have happened did not. Derived from each wake:list row's switched_on and mark (src/wake.rs in the engine): switched off, a cause fired and not yet ran, the last outcome, a fact with no budget left, a kept-running program not started. order is how states win when more than one holds.",
  "order": [
    "off",
    "running",
    "failed",
    "unknown",
    "unfunded",
    "unplaced",
    "on"
  ],
  "states": {
    "on": {
      "label": "On",
      "red": false
    },
    "running": {
      "label": "Running",
      "red": false
    },
    "off": {
      "label": "Off",
      "red": false
    },
    "failed": {
      "label": "Last run failed",
      "red": true
    },
    "unknown": {
      "label": "Last run's outcome is unknown",
      "red": true
    },
    "unfunded": {
      "label": "Came with no budget left",
      "red": true
    },
    "unplaced": {
      "label": "Not picked up yet",
      "red": true
    }
  },
  "steps": [
    {
      "from": "unplaced",
      "to": "running",
      "label": "the engine starts its program"
    },
    {
      "from": "on",
      "to": "running",
      "label": "its cause happens"
    },
    {
      "from": "on",
      "to": "unfunded",
      "label": "its cause happens [the period's budget is spent]"
    },
    {
      "from": "running",
      "to": "on",
      "label": "the run finishes"
    },
    {
      "from": "running",
      "to": "failed",
      "label": "the run fails"
    },
    {
      "from": "running",
      "to": "unknown",
      "label": "the run's answer is lost"
    },
    {
      "from": "failed",
      "to": "running",
      "label": "its cause happens again"
    },
    {
      "from": "unknown",
      "to": "running",
      "label": "its cause happens again"
    },
    {
      "from": "unfunded",
      "to": "running",
      "label": "its cause happens in a new period"
    },
    {
      "from": "on",
      "to": "off",
      "label": "you turn it off"
    },
    {
      "from": "failed",
      "to": "off",
      "label": "you turn it off"
    },
    {
      "from": "unfunded",
      "to": "off",
      "label": "you turn it off"
    },
    {
      "from": "unplaced",
      "to": "off",
      "label": "you turn it off"
    },
    {
      "from": "off",
      "to": "on",
      "label": "you turn it on"
    },
    {
      "from": "off",
      "to": "unplaced",
      "label": "you turn on a kept-running one"
    }
  ]
}
