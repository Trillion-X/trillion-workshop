   ],
   "payload": {
    "kind": "ai-tool-descriptor",
    "id": "tool:see-what-runs-on-its-own",
    "label": "See what runs on its own",
    "status": "active",
    "job": "Show everything my account runs on its own (due times, facts it hears, programs it keeps running): what each waits for, whether it is on, its last run, which ones should have run and did not, and a switch to turn each off or on",
    "description": "Give wakes, the rows wake:list answers ([{tool, id, on, switched_on, mark}]). Returns one row per cause: what it waits for in plain words (a due time as its schedule), its state (on, running, off, last run failed, outcome unknown, came with no budget left, not picked up yet), red when it needs the person, why (a failed run says its cause), its last run and outcome, and the switch that turns it off or on; red rows first, then switched-on ones, with counts of red, on and off.",
    "input_schema": {
     "type": "object",
     "required": [
      "wakes"
     ],
     "additionalProperties": false,
     "properties": {
      "wakes": {
       "type": "array",
       "description": "The rows wake:list answers: [{tool, id, on, budget, switched_on, mark}]",
       "items": {
        "type": "object",
        "required": [
         "tool",
         "id",
         "on"
        ]
       }
      }
     }
    },
    "output_schema": {
     "type": "object",
     "required": [
      "causes",
      "red",
      "on",
      "off"
     ],
     "properties": {
      "causes": {
       "type": "array",
       "items": {
        "type": "object",
        "required": [
         "tool",
         "id",
         "waits_for",
         "state",
         "label",
         "red",
         "why",
         "switch"
        ]
       }
      },
      "red": {
       "type": "number"
      },
      "on": {
       "type": "number"
      },
      "off": {
       "type": "number"
      }
     }
    },
    "invoke": {
     "kind": "container",
     "files": {
      "package_files": [
       {
        "package": "what-runs-on-its-own",
        "paths": [
         "do-work",
         "read-data"
        ],
        "at": "/opt/what-runs-on-its-own"
       }
      ]
     },
     "workdir": "/opt/what-runs-on-its-own",
     "stdout": "json",
     "run": [
      "node",
      "do-work/what-runs-on-its-own.mjs"
     ],
     "stdin": {
      "fill": {
       "from": "input"
      }
     }
    },
    "result_selector": "$.result",
    "needs": {
     "expected_seconds": 5,
     "network_egress": false,
     "memory_mb": 128
    },
    "licence_class": "licence:maker-own",
    "placements": [
     "placement:small-container"
    ],
    "maker": "maker:what-runs-on-its-own",
    "provenance": {
     "source": "the engine's wake:list rows (each declared wake, whether it is switched on, and its mark), shown the way onit (MIT) shows a computer's background jobs: what is on, its state, and a switch"
    },
    "verify": [
     {
      "kind": "sample-run",
      "input": {
       "wakes": [
        {
         "tool": "tool:sample",
         "id": "daily",
         "on": {
          "fact": {
           "kind": "due-time",
           "from": [
            "run"
           ],
           "watch": {
            "schedules": [
             {
              "cadence": {
               "unit": "day"
              },
              "local_window": {
               "start": "14:00",
               "duration_minutes": 1
              },
              "timezone": "UTC"
             }
            ]
           }
          }
         },
         "budget": {
          "steps": 1
         },
         "switched_on": true,
         "mark": {
          "outcome": "failed",
          "outcome_cause": "the run was refused"
         }
        }
       ]
      },
      "output_selector": "$.causes[0].label",
      "contains": "Last run failed"
     }
    ],
    "record_model": {
     "_what": "Moved here from tools/keep-a-record-library-valid, where they were held unchanged after the engine's one record model left it (old trillion src/record-model.json and src/record-indexes.json): the kinds this tool's job keeps, each as old trillion declared it.",
     "kinds": [
      {
