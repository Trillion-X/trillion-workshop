{
  "_what": "The rows an account starts with that are not sign-in (src/account/rows.rs StartingRows): its copies row and its copy rules row (src/account/computers/copy_rule.rs). Moved from sign_in/new-accounts.json when sign-in moved to the Better Auth Workshop tool (Nov 13 2026).",
  "copies": {
    "least_copy_keepers": 3,
    "least_voters": 3,
    "least_may_answer": 2,
    "least_always_on": 0
  },
  "copies_rules": {
    "short_by_each": {
      "copy_keepers": {
        "$kind": "binding",
        "select": {
          "from": "self",
          "path": [
            "least_copy_keepers"
          ]
        },
        "transform": [
          {
            "op": "op:core.sub",
            "args": {
              "value": {
                "$kind": "binding",
                "select": {
                  "from": "context",
                  "path": [
                    "copy_keepers"
                  ]
                }
              }
            }
          }
        ]
      },
      "voters": {
        "$kind": "binding",
        "select": {
          "from": "self",
          "path": [
            "least_voters"
          ]
        },
        "transform": [
          {
            "op": "op:core.sub",
            "args": {
              "value": {
                "$kind": "binding",
                "select": {
                  "from": "context",
                  "path": [
                    "voters"
                  ]
                }
              }
            }
          }
        ]
      },
      "may_answer": {
        "$kind": "binding",
        "select": {
          "from": "self",
          "path": [
            "least_may_answer"
          ]
        },
        "transform": [
          {
            "op": "op:core.sub",
            "args": {
              "value": {
                "$kind": "binding",
                "select": {
                  "from": "context",
                  "path": [
                    "may_answer"
                  ]
                }
              }
            }
          }
        ]
      },
      "always_on": {
        "$kind": "binding",
        "select": {
          "from": "self",
          "path": [
            "least_always_on"
          ]
        },
        "transform": [
          {
            "op": "op:core.sub",
            "args": {
              "value": {
                "$kind": "binding",
                "select": {
                  "from": "context",
                  "path": [
                    "always_on"
                  ]
                }
              }
            }
          }
        ]
      }
    },
    "short_by": {
      "$kind": "binding",
      "select": {
        "from": "literal",
        "value": [
          0,
          {
            "$kind": "binding",
            "select": {
              "from": "self",
              "path": [
                "short_by_each",
                "copy_keepers"
              ]
            }
          },
          {
            "$kind": "binding",
            "select": {
              "from": "self",
              "path": [
                "short_by_each",
                "voters"
              ]
            }
          },
          {
            "$kind": "binding",
            "select": {
              "from": "self",
              "path": [
                "short_by_each",
                "may_answer"
              ]
            }
          },
          {
            "$kind": "binding",
            "select": {
              "from": "self",
              "path": [
                "short_by_each",
                "always_on"
              ]
            }
          }
        ]
      },
      "transform": [
        {
          "op": "op:core.max"
        }
      ]
    },
    "rule": {
      "id": "copies-short",
      "match_condition": {
        "conditions": [
          {
            "$bind": {
              "select": {
                "from": "change",
                "path": "short_by"
              },
              "transform": [
                {
                  "op": "op:core.gt",
                  "args": {
                    "value": 0
                  }
                }
              ]
            }
          }
        ]
      },
      "dispatch": {
        "target": "workflow:start",
        "output_template": {
          "rule_id": "copies-short",
          "record_id": {
            "$bind": {
              "select": {
                "from": "envelope",
                "path": "address_text"
              }
            }
          },
          "content": {
            "$bind": {
              "select": {
                "from": "change",
                "path": "computers_revision"
              }
            }
          },
          "then": {
            "workflow_id": "add-a-computer"
          },
          "input": {
            "short_by": {
              "$bind": {
                "select": {
                  "from": "change",
                  "path": "short_by"
                }
              }
            }
          }
        }
      }
    },
    "workflow": {
      "id": "add-a-computer",
      "name": "Add a computer",
      "kind": "workflow",
      "is_active": true,
      "version": 1,
      "steps": [
        {
          "id": "add",
          "kind": "ask",
          "config": {
            "name": "computers:add-computer",
            "input": {},
            "context": {
              "step_id": "add"
            }
          }
        },
        {
          "id": "vote",
          "kind": "ask",
          "config": {
            "name": "computers:voter-step",
            "input": {},
            "context": {
              "step_id": "vote"
            }
          }
        },
        {
          "id": "done",
          "kind": "return",
          "config": {
            "value": {
              "added": true
            }
          }
        }
      ],
      "edges": [
        {
          "from": "add",
          "to": "vote",
          "kind": "always"
        },
        {
          "from": "vote",
          "to": "done",
          "kind": "always"
        }
      ]
    }
  }
}
