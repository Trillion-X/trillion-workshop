{
  "_what": "Test-only families for src/storage/tests.rs (compiled only under cfg(test)): a family with a partial named order and arrival order, so the generic operations are proved on shapes no shipped family declares yet.",
  "schemas": [
    {
      "schema": "storage_test",
      "_what": "Scratch families the storage unit tests create in memory.",
      "families": [
        {
          "family": "items",
          "key": ["id"],
          "fields": ["id", "space", "kind", "withdrawn_at"],
          "orders": {
            "live_by_space_kind": { "fields": ["space", "kind"], "only": [{ "field": "withdrawn_at", "equals": null }] }
          },
          "arrival": true,
          "readers": ["src/storage/tests.rs"]
        },
        {
          "family": "drafts",
          "key": ["id"],
          "fields": ["id", "title", "size"],
          "orders": { "by_title": { "fields": ["title"] } },
          "made": "first_write",
          "readers": ["src/storage/tests.rs"]
        }
      ]
    }
  ]
}
