{
  "_what": "Every stored family the Rust runtime reads or writes through the storage boundary (src/storage/mod.rs), one row each, grouped by the kind of storage it lives in. A family's key, fields, named orders and arrival order are declared here and nowhere else; the boundary refuses any family, field or order not declared here. `readers` names the source files that read the family (the reason it is stored; the CP1 'readers' field of the storage-convergence plan). Names are the stored names in the current engine's layout; a supply with another layout maps them itself. Read by src/storage/schema.rs.",
  "schemas": [
    {
      "schema": "scoped_records",
      "_what": "The existing versioned record and durable receipt adapter (src/store.rs); a tombstone still owns its scoped record identity.",
      "families": [
        {
          "family": "records",
          "key": ["account", "resource", "id"],
          "fields": ["account", "resource", "id", "version", "deleted", "body"],
          "readers": ["src/store.rs"]
        }
      ]
    },
    {
      "schema": "account_policy",
      "_what": "The canonical account policy store (AccountControl's policy directory and its gate registrations).",
      "families": [
        {
          "family": "policy_directory",
          "key": [
            "name"
          ],
          "fields": [
            "name",
            "value"
          ],
          "readers": [
            "src/account_rights.rs",
            "src/account_rights/update.rs"
          ]
        },
        {
          "family": "policy_gates",
          "key": [
            "name"
          ],
          "fields": [
            "name",
            "sign_in",
            "resource"
          ],
          "readers": [
            "src/account_rights/update.rs"
          ]
        }
      ]
    },
    {
      "schema": "r2_inventory_ledger",
      "_what": "The preserved original local R2 copy's inventory ledger (inventory.sqlite): ledger state, inventoried objects and copied-body receipts.",
      "families": [
        {
          "family": "metadata",
          "key": [
            "name"
          ],
          "fields": [
            "name",
            "value"
          ],
          "readers": [
            "src/workspace_publication.rs"
          ]
        },
        {
          "family": "objects",
          "key": [
            "key"
          ],
          "fields": [
            "key",
            "size",
            "etag",
            "payload"
          ],
          "readers": [
            "src/workspace_publication.rs"
          ]
        },
        {
          "family": "copies",
          "key": [
            "key"
          ],
          "fields": [
            "key",
            "bytes",
            "receipt"
          ],
          "readers": [
            "src/workspace_publication.rs"
          ]
        }
      ]
    },
    {
      "schema": "record_log",
      "_what": "Original record envelope log and its retained key metadata, read through their existing bounded snapshot owner.",
      "families": [
        {
          "family": "record_log",
          "key": [
            "id"
          ],
          "fields": [
            "id",
            "transaction_id",
            "actor_context",
            "application_time",
            "system_time",
            "part",
            "parts",
            "envelopes",
            "keys"
          ],
          "arrival": true,
          "readers": [
            "src/legacy_records.rs",
            "src/storage/old_record_tables.rs"
          ]
        },
        {
          "family": "record_keys_meta",
          "key": [
            "key"
          ],
          "fields": [
            "key",
            "value"
          ],
          "readers": [
            "src/legacy_records.rs",
            "src/storage/old_record_tables.rs"
          ]
        },
        {
          "family": "resource_behavior_commands",
          "key": ["permit_id"],
          "fields": ["permit_id", "state", "result"],
          "orders": {"by_state": {"fields": ["state", "permit_id"], "only": [{"field": "result", "equals": null, "not": true}]}},
          "readers": ["src/local_account/command_journal.rs", "src/storage/old_record_tables.rs"]
        }
      ]
    },
    {
      "schema": "catch_up_original",
      "_what": "Existing original Workshop facts, read on their existing account handle; no overlay or new storage. (The catch-up copy that read them and the copy positions left for trillion-workshop tools/keep-copies-in-step.)",
      "families": [
        {
          "family": "workshop_facts",
          "key": [
            "seq"
          ],
          "fields": [
            "seq",
            "at",
            "entity",
            "value"
          ],
          "orders": {
            "latest": {
              "fields": [
                "entity",
                "seq"
              ]
            }
          },
          "readers": [
            "src/storage/old_record_tables.rs"
          ]
        }
      ]
    },
    {
