{
  "_what": "Every family of the record store (src/storage/record_store/), the whole record_store schema, declared here beside its engine. src/storage/schema.rs merges every families file: a schema declared in several files holds the union of their families, and a family name declared twice refuses every lookup, so no other families file declares these.",
  "schemas": [
    {
      "schema": "record_store",
      "_what": "The record store (storage-convergence plan section 5a): one current row per record (valid_to = 9223372036854775807, the largest stamp) and one history row per replaced version, keyed by the stamp that replaced it, so the version live at T is the first row after (id, T): one ordered seek, one row, whatever the history size. Stamps are hybrid logical clock values (milliseconds << 16 | counter) minted inside the write. Destroyed records wait in custody until the undo window ends. Declared field orders (src/storage/record_store/orders.rs, DATA in record_store/settings.json `orders`): one ordered row per record per order that covers it, keyed by the field's ECMA JSON text as UTF-16BE bytes then id, so the key order is the old engine's index order (text by code unit, then id); order_state says whether an order holds every live record of a scope (RecordStore::fill_order). The search port's segments (src/storage/record_store/segments.rs): search_segments holds one meta row per persisted segment (its stamp range, the first term of each part, the records it covers), search_parts one row per part (terms with postings, newest stamp first), search_walk one row per scope: the walk over the rows the scope held before its index or its current terms existed (terms rule, frontier stamp, last id walked, ready), so a stopped walk starts where it left off. Record sync (src/storage/record_store/record_log.rs, the settle surface of old trillion record-log-store.mjs): settle_log holds one log row per write of a scope (row: a UUIDv7, so rows sort by when they were written; actor and envelopes as JSON text); settle_records one kept state per record (type and value null once removed, meta its stamps, bucket its checksum bucket, ordered by_bucket so the records of chosen buckets are one range each); settle_sums the scope's 256 bucket checksums as 4096 hex; settle_positions how far each copy that settles with the scope took, kept beside the store and never a record.",
      "families": [
        {
          "family": "versions",
          "key": ["account", "resource", "id", "valid_to"],
          "fields": ["account", "resource", "id", "valid_to", "valid_from", "version", "deleted", "body", "ring", "kind"],
          "orders": {
            "live_kind": {
              "fields": ["account", "resource", "kind", "id"],
              "only": [
                { "field": "valid_to", "equals": 9223372036854775807 },
                { "field": "deleted", "equals": 0 }
              ]
            },
            "live": {
              "fields": ["account", "resource", "id"],
              "only": [
                { "field": "valid_to", "equals": 9223372036854775807 },
                { "field": "deleted", "equals": 0 }
              ]
            },
            "changed": {
              "fields": ["account", "resource", "valid_from"],
              "only": [{ "field": "valid_to", "equals": 9223372036854775807 }]
            },
            "ending": {
              "fields": ["account", "resource", "valid_to"],
              "only": [{ "field": "valid_to", "equals": 9223372036854775807, "not": true }]
            },
            "gone": {
              "fields": ["account", "resource", "valid_from"],
              "only": [
                { "field": "valid_to", "equals": 9223372036854775807 },
                { "field": "deleted", "equals": 1 }
              ]
            }
          },
          "readers": ["src/storage/record_store/mod.rs"]
        },
        {
          "family": "custody",
          "key": ["erased_at", "account", "resource", "id", "valid_to"],
          "fields": ["erased_at", "account", "resource", "id", "valid_to", "valid_from", "version", "deleted", "body", "ring", "kind"],
          "readers": ["src/storage/record_store/mod.rs"]
        },
        {
          "family": "ordered",
          "key": ["account", "resource", "order", "value", "id"],
          "fields": ["account", "resource", "order", "value", "id"],
          "readers": ["src/storage/record_store/mod.rs", "src/storage/record_store/orders.rs"]
        },
        {
          "family": "totals",
          "key": ["account", "total", "group"],
          "fields": ["account", "total", "group", "count", "sum"],
          "readers": ["src/storage/record_store/mod.rs", "src/storage/record_store/totals.rs"]
        },
        {
