    "ranked": [
      {
        "key": "devices:local-mac",
        "title": "My Mac"
      }
    ],
    "finishes": [
      {
        "choice": "Tap done",
        "press": "Done",
        "said": "Marked done."
      },
      {
        "choice": "Paste it",
        "press": "Send",
        "said": "Sent to your AIs.",
        "form": {
          "fields": [
            {
              "name": "answer",
              "label": "Paste it here",
              "kind": "long-text"
            }
          ],
          "runs": [
            {
              "tool_id": "tool:send-to-all-ais",
              "input": {
                "text": {
                  "template": "{answer}\n\n(My answer to \"{title}\" from what is waiting on me)"
                }
              }
            }
          ]
        }
      },
      {
        "choice": "Send a link",
        "press": "Send",
        "said": "Sent to your AIs.",
        "form": {
          "fields": [
            {
              "name": "answer",
              "label": "The link",
              "kind": "link"
            }
          ],
          "runs": [
            {
              "tool_id": "tool:send-to-all-ais",
              "input": {
                "text": {
                  "template": "{answer}\n\n(The link for \"{title}\" from what is waiting on me)"
                }
              }
            }
          ]
        }
      },
      {
        "choice": "Send a file",
        "press": "Send",
        "said": "Sent to your AIs.",
        "form": {
          "fields": [
            {
              "name": "file",
              "label": "The file",
              "kind": "file"
            }
          ],
          "runs": [
            {
              "tool_id": "tool:send-to-all-ais",
              "input": {
                "text": {
                  "template": "The file for \"{title}\" from what is waiting on me."
                },
                "files": {
                  "field": "file"
                }
              }
            }
          ]
        }
      },
      {
        "choice": "Tell Trillion",
        "press": "Send",
        "said": "Sent to your AIs.",
        "form": {
          "fields": [
            {
              "name": "answer",
              "label": "Tell your AIs",
              "kind": "long-text"
            }
          ],
          "runs": [
            {
              "tool_id": "tool:send-to-all-ais",
              "input": {
                "text": {
                  "template": "{answer}\n\n(About \"{title}\" from what is waiting on me)"
                }
              }
            }
          ]
        }
      },
      {
        "choice": "Checked for you",
        "checked": "Trillion checks this itself and takes it off once it is done."
      }
    ],
    "every_seconds": 90,
    "asides_left": 3,
    "hand_back": [
      {
        "id": "done",
        "label": "I did my part",
        "icon": "Check",
        "title": "What did you do?",
        "placeholder": "Turn on FTP sending in the camera's network menu and point it at the address shown",
        "submit": "Your AIs have the rest"
      },
      {
        "id": "broken",
        "label": "This doesn't work here",
        "icon": "AlertTriangle",
        "title": "What happens when you try?",
        "placeholder": "The Connect button keeps spinning and nothing opens",
        "submit": "Hand it to my AIs"
      }
    ],
    "stakes": [
