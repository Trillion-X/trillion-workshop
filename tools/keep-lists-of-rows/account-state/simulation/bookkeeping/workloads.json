{
  "format": "command-bookkeeping-workloads/1",
  "about": "The commands of U18, U22 and U32 as the command-bookkeeping simulator runs them. u18-probe is the code probe's own shape for calibration (one command at 12:00Z, then eight 5 minutes apart, rows counted over the eight, no eviction when run with --evict off). Each command's rate per day is read from its source workload's operation of the same name (workloads/*.json), so the two stay one number. Shapes come from the product repository's code measurement test/command-bookkeeping-rows.test.mjs at origin/main 050254ab91 (one claims:handOff = 5 record_log rows of its own work, 3.125 derived rows the probe counts as bookkeeping: workshop_facts 1, native_collection_dirty 1, native_collection_schedule 1.125, and three native reads of three purposes after it) and from the source workloads' own step families. Prices are the Durable Objects SQLite list prices the cost models read (rows read $0.001 per million, rows written $1.00 per million).",
  "prices": {
    "rows_read_dollars": 1e-9,
    "rows_written_dollars": 1e-6
  },
  "workloads": [
    {
      "id": "u18",
      "source": "workloads/u18-metering-around-ai-command.json",
      "commands": [
        {
          "operation": "AI tool call with its bookkeeping",
          "purpose": "rpc:claims:handOff",
          "domain_rows": { "base": 5, "extra": [] },
          "derived_rows": { "base": 3, "extra": [ { "count": 1, "chance": 0.125 } ] },
          "rows_read": { "min": 400, "max": 3300 },
          "work_ms": { "min": 300, "max": 3000 },
          "reads": [
            { "purpose": "rpc:readOwnRecordCommandResult", "rows_read": { "min": 20, "max": 400 } },
            { "purpose": "rpc:own-record-projection-ready", "rows_read": { "min": 20, "max": 400 } },
            { "purpose": "rpc:lists:read", "rows_read": { "min": 50, "max": 1200 } }
          ]
        }
      ],
      "replays": []
    },
    {
      "id": "u22",
      "source": "workloads/u22-marketplace-paid-run.json",
      "commands": [
        {
          "operation": "paid run",
          "purpose": "rpc:tools:run",
          "domain_rows": { "base": 2, "extra": [] },
          "derived_rows": { "base": 0, "extra": [] },
          "rows_read": { "min": 100, "max": 900 },
          "work_ms": { "min": 500, "max": 5000 },
          "reads": [],
          "paid": { "price": 0.25, "fails": false }
        },
        {
          "operation": "paid run that fails and is refunded",
          "purpose": "rpc:tools:run",
          "domain_rows": { "base": 2, "extra": [] },
          "derived_rows": { "base": 0, "extra": [] },
          "rows_read": { "min": 100, "max": 900 },
          "work_ms": { "min": 500, "max": 5000 },
          "reads": [],
          "paid": { "price": 0.25, "fails": true, "refund_rows": 2 }
        }
      ],
      "replays": [],
      "paid_ceiling_per_day": 1.5
    },
    {
      "id": "u32",
      "source": "workloads/u32-command-lifecycle.json",
      "commands": [
        {
          "operation": "command end to end",
          "purpose": "rpc:workshop:run",
          "domain_rows": { "base": 5, "extra": [ { "count": 7, "chance": 0.13 }, { "count": 1, "chance": 0.074 } ] },
          "derived_rows": { "base": 0, "extra": [] },
          "rows_read": { "min": 200, "max": 2400 },
          "work_ms": { "min": 200, "max": 2000 },
          "reads": []
        }
      ],
      "replays": [ { "operation": "replay a finished task" } ]
    },
    {
      "id": "u18-probe",
      "source": "workloads/u18-metering-around-ai-command.json",
      "commands": [
        {
          "operation": "AI tool call with its bookkeeping",
          "purpose": "rpc:claims:handOff",
          "domain_rows": { "base": 5, "extra": [] },
          "derived_rows": { "base": 3, "extra": [ { "count": 1, "chance": 0.125 } ] },
          "rows_read": { "min": 400, "max": 3300 },
          "work_ms": { "min": 300, "max": 3000 },
          "reads": [
            { "purpose": "rpc:readOwnRecordCommandResult", "rows_read": { "min": 20, "max": 400 } },
            { "purpose": "rpc:own-record-projection-ready", "rows_read": { "min": 20, "max": 400 } },
            { "purpose": "rpc:lists:read", "rows_read": { "min": 50, "max": 1200 } }
          ]
        }
      ],
      "replays": [],
      "schedule": { "start_ms": 43200000, "every_ms": 300000, "count": 9, "warmup": 1 }
    }
  ]
}
