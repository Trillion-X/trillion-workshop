{
  "format": "workload-simulation-workload/1",
  "name": "u07-search-all-kinds",
  "plan_ids": [
    "U07"
  ],
  "about": "@-search one word across all kinds, newest 20 first, while records keep arriving. Typical seat: 60 searches/day.",
  "stores": 1,
  "owners": 8,
  "vocabulary": 2000,
  "initial": [
    {
      "kind": "note",
      "count": 5000,
      "value": {
        "fields": [
          {
            "name": "text",
            "shape": {
              "words": {
                "min": 6,
                "max": 40
              }
            }
          },
          {
            "name": "status",
            "shape": {
              "choice": {
                "options": [
                  "open",
                  "waiting",
                  "done"
                ]
              }
            }
          }
        ]
      }
    },
    {
      "kind": "page",
      "count": 1000,
      "value": {
        "fields": [
          {
            "name": "text",
            "shape": {
              "words": {
                "min": 6,
                "max": 40
              }
            }
          },
          {
            "name": "title",
            "shape": {
              "words": {
                "min": 2,
                "max": 6
              }
            }
          }
        ]
      }
    }
  ],
  "operations": [
    {
      "name": "search all kinds",
      "per_day": 60,
      "window_seconds": {
        "start": 32400,
        "end": 61200
      },
      "intent": {
        "search": {
          "field": "text",
          "limit": 20
        }
      }
    },
    {
      "name": "search pages only",
      "per_day": 20,
      "window_seconds": {
        "start": 32400,
        "end": 61200
      },
      "intent": {
        "search": {
          "kinds": [
            "page"
          ],
          "field": "text",
          "limit": 20
        }
      }
    },
    {
      "name": "save new note",
      "per_day": 100,
      "window_seconds": {
        "start": 32400,
        "end": 61200
      },
      "intent": {
        "create": {
          "kind": "note",
          "value": {
            "fields": [
              {
                "name": "text",
                "shape": {
                  "words": {
                    "min": 6,
                    "max": 40
                  }
                }
              },
              {
                "name": "status",
                "shape": {
                  "choice": {
                    "options": [
                      "open",
                      "waiting",
                      "done"
                    ]
                  }
                }
              }
            ]
          }
        }
      }
    }
  ]
}
