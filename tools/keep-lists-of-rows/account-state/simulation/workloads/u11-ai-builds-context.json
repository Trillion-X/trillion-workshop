{
  "format": "workload-simulation-workload/1",
  "name": "u11-ai-builds-context",
  "plan_ids": [
    "U11",
    "C5",
    "C21"
  ],
  "about": "An AI reads 100 records at once to build context, 10 times a working day (typical seat). Records are picked uniformly; the plan's search-plus-links choice is approximated by point reads.",
  "stores": 1,
  "owners": 5,
  "vocabulary": 2000,
  "initial": [
    {
      "kind": "note",
      "count": 5000,
      "value": {
        "fields": [
          {
            "name": "text",
            "shape": {
              "words": {
                "min": 6,
                "max": 40
              }
            }
          },
          {
            "name": "status",
            "shape": {
              "choice": {
                "options": [
                  "open",
                  "waiting",
                  "done"
                ]
              }
            }
          }
        ]
      }
    }
  ],
  "operations": [
    {
      "name": "AI reads 100 records",
      "per_day": 10,
      "burst": 100,
      "window_seconds": {
        "start": 32400,
        "end": 61200
      },
      "intent": {
        "read": {
          "target": {
            "pick": "uniform"
          }
        }
      }
    }
  ]
}
