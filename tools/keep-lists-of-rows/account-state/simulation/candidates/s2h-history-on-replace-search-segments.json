{
  "format": "storage-sim-candidate/1",
  "id": "s2h-history-on-replace-search-segments",
  "plan_id": "S2h (a) + search inverted",
  "about": "Current row + reverse-diff history row only on replace; ids in mint order form the creation range (skew window 30 s, high-water row); no order index; owner index; word rows on text. Search variant: in-memory tail + packed segments as rows; with no order index the cold-start tail rebuild scans current rows.",
  "adapter": "s2h_history_on_replace",
  "params": {
    "order": {
      "coarse": {
        "skew_window_ms": 30000
      }
    },
    "in_row_versions": 0,
    "indexes": [
      {
        "id": "owner",
        "of": "owner"
      }
    ],
    "search": {
      "layout": "inverted",
      "fields": [
        "text"
      ],
      "persist": {
        "flush_records": 256,
        "flush_seconds": 600,
        "part_bytes": 65536,
        "fan_in": 4,
        "place": "rows",
        "cache_bytes": 0
      }
    },
    "member_min": 16,
    "generation_rows": 100000,
    "erase_lookup": "owner_index",
    "receipts": {
      "window_ms": 86400000,
      "max_entries": 64
    }
  }
}
