{
  "format": "storage-sim-candidate/1",
  "id": "s5-versioned-row-indexed-search-segments-cached",
  "plan_id": "S5 + declared indexes + search inverted",
  "about": "S5 plus a declared (kind, version) index and declared word rows on text: the same record cost plus separately counted search/index rows. Search variant: as search-segments with an 8 MiB in-memory part cache.",
  "adapter": "s5_versioned_row",
  "params": {
    "kind_newest": true,
    "search": {
      "layout": "inverted",
      "fields": [
        "text"
      ],
      "persist": {
        "flush_records": 256,
        "flush_seconds": 600,
        "part_bytes": 65536,
        "fan_in": 4,
        "place": "rows",
        "cache_bytes": 8388608
      }
    },
    "receipts": {
      "window_ms": 86400000,
      "max_entries": 64
    }
  }
}
