{
  "format": "storage-sim-candidate/1",
  "id": "s2h-in-row-8",
  "plan_id": "S2h (d) in-row history N=8",
  "about": "S2h exact order with the last 8 reverse diffs kept inside the current row: one log row per 8 replacements (1 + 1/8 rows per update).",
  "adapter": "s2h_history_on_replace",
  "params": {
    "order": "exact",
    "in_row_versions": 8,
    "indexes": [
      {
        "id": "kind_newest",
        "of": "kind_newest"
      },
      {
        "id": "owner",
        "of": "owner"
      }
    ],
    "search": {
      "layout": "word_rows",
      "fields": [
        "text"
      ]
    },
    "member_min": 16,
    "generation_rows": 100000,
    "erase_lookup": "owner_index",
    "receipts": {
      "window_ms": 86400000,
      "max_entries": 64
    }
  }
}
