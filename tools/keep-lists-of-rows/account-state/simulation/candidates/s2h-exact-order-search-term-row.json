{
  "format": "storage-sim-candidate/1",
  "id": "s2h-exact-order-search-term-row",
  "plan_id": "S2h + durable order + search term_row",
  "about": "S2h with an exact durable order: kind_newest entries keyed by the commit stamp (+1 entry per create, +2 per replace). Search variant: one packed term row per record, replaced when its terms change; a search scans term rows.",
  "adapter": "s2h_history_on_replace",
  "params": {
    "order": "exact",
    "in_row_versions": 0,
    "indexes": [
      {
        "id": "kind_newest",
        "of": "kind_newest"
      },
      {
        "id": "owner",
        "of": "owner"
      }
    ],
    "search": {
      "layout": "term_row",
      "fields": [
        "text"
      ]
    },
    "member_min": 16,
    "generation_rows": 100000,
    "erase_lookup": "owner_index",
    "receipts": {
      "window_ms": 86400000,
      "max_entries": 64
    }
  }
}
