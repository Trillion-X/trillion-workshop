        "kind": "ai-tool-descriptor",
        "id": "tool:leave-a-shared-pursuit",
        "label": "Leave a shared pursuit",
        "status": "active",
        "job": "A person leaves a pursuit they share with other people: their own membership of its space is marked left, what they put there stays, and the pursuit ends for them",
        "description": "Give the pursuit's id, the person, and the rows read from the store ([{ id, type, value }]: the pursuit, its space, the space's member rows). Refuses a pursuit that is not theirs or has ended, and refuses the person who runs the space (hand it over first). Answers the membership change and the pursuit ended, under `keep` ([{ id, type, value, expected }]) for the caller to store. It changes only the caller's own rows. The network's room leave is not a row change and is not done here.",
        "input_schema": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "pursuit",
            "subject",
            "records"
          ],
          "properties": {
            "pursuit": {
              "type": "string",
              "description": "The pursuit's id, as the person's record names it (pursuit:...)."
            },
            "subject": {
              "type": "string",
              "description": "The person leaving, the way the space names them."
            },
            "records": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "id",
                  "type"
                ]
              },
              "description": "The rows the ask reads: the pursuit, the space row, and the space's member rows."
            }
          }
        },
        "output_schema": {
          "type": "object",
          "required": [
            "pursuit_id",
            "left",
            "keep"
          ],
          "properties": {
            "pursuit_id": {
              "type": "string"
            },
            "left": {
              "type": [
                "string",
                "null"
              ],
              "description": "The space left, or null when the pursuit had no shared space."
            },
            "membership": {
              "type": "string",
              "description": "The membership state after the ask (left, or none when they were not a member)."
            },
            "keep": {
              "type": "array",
              "items": {
                "type": "object"
              },
              "description": "The rows to change, each { id, type, value, expected }."
            }
          }
        },
        "invoke": {
