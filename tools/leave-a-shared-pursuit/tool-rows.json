                  "blake3.js",
                  "blake2.js",
                  "_blake.js",
                  "_md.js",
                  "_u64.js",
                  "utils.js"
                ],
                "at": "/opt/node_modules/@noble/hashes"
              },
              {
                "package": "browse-and-upload-my-files",
                "paths": [
                  "built-stored-bytes/content-chunks/content_chunks.js",
                  "do-work/content-chunks.mjs",
                  "do-work/namespace-client.mjs",
                  "do-work/send-a-file-to-a-namespace.mjs",
                  "do-work/send-retry.mjs",
                  "do-work/send-window.mjs",
                  "do-work/shared-file-reference.mjs",
                  "send-settings.json"
                ],
                "at": "/opt/browse-and-upload-my-files"
              },
              {
                "package": "paid-access",
                "paths": [
                  "read-data/who-holds-access.mjs",
                  "read-data/payment-effects.mjs",
                  "read-data/effect-lifecycle.mjs",
                  "read-data/read-granted-access-refs.ts",
                  "read-data/take-payments-events.json"
                ],
                "at": "/opt/paid-access"
              },
              {
                "package": "formula-engine",
                "paths": [
                  "rules",
                  "built-stored-bytes/formula-engine"
                ],
                "at": "/opt/node_modules/trillion-workshop/tools/formula-engine"
              },
              {
                "package": "space-member-types",
                "paths": [
                  "src"
                ],
                "at": "/opt/space-member-types"
              }
            ]
          },
          "workdir": "/opt/leave-a-shared-pursuit",
          "internet": false,
          "stdout": "json",
          "argv": [
            "node",
            "/opt/leave-a-shared-pursuit/do-work/leave-a-shared-pursuit-run.mjs",
            "leaveASharedPursuit"
          ],
          "stdin": {
            "fill": {
              "from": "input"
            }
          }
        },
        "needs": {
          "expected_seconds": 3,
          "network_egress": false
        },
        "licence_class": "licence:maker-own",
        "placements": [
          "placement:small-container"
        ],
        "maker": "maker:leave-a-shared-pursuit",
        "result_selector": "$.result",
        "provenance": {
          "source": "old repository commit 4ffa1dc4a2^:src/pursuit-rooms.mjs leavePursuit (259-268) and ownPursuit (184-190): the person's own pursuit, not ended, and the room left; the owner refusal is tool:leave-a-space (space-members do-work/space-members.mjs:59). Not wired: no screen, route or wake calls it; the live wiring waits for the owner's word."
        },
