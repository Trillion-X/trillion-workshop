  "worked_examples": [
    {
      "title": "Keep the rows that match my rules on a sample input",
      "ask": "Run tool:filter-rows-by-rules.",
      "mcp": {
        "server": "trillion",
        "tool": "run_resource_operation",
        "input": {
          "address": "@workshop-tools",
          "method": "tools:run",
          "input": {
            "tool": "tool:filter-rows-by-rules",
            "input": {
              "records": [
                {
                  "id": "a",
                  "kind": "loaf",
                  "tags": [
                    "rye",
                    "seeded"
                  ],
                  "grams": 800
                },
                {
                  "id": "b",
                  "kind": "roll",
                  "tags": [
                    "white"
                  ],
                  "grams": 90
                },
                {
                  "id": "c",
                  "kind": "loaf",
                  "tags": [
                    "white"
                  ],
                  "grams": null
                }
              ],
              "fields": [
                {
                  "id": "kind",
                  "kind": "choice"
                },
                {
                  "id": "grams",
                  "kind": "number"
                }
              ],
              "tree": {
                "kind": "group",
                "combinator": "and",
                "negate": false,
                "rules": [
                  {
                    "kind": "rule",
                    "field": "kind",
                    "operator": "is_any_of",
                    "params": {
                      "values": [
                        "loaf"
                      ]
                    }
                  },
                  {
                    "kind": "rule",
                    "field": "grams",
                    "operator": "greater_than",
                    "params": {
                      "value": 500
                    }
                  }
                ]
              }
            }
          }
        }
      },
      "hands_back": "The answer's $.records[0].id contains \"a\"."
