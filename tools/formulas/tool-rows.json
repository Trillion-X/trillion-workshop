{
 "kind": "tool-rows",
 "record_set": "formulas-tool-rows",
 "what_this_is": "The Workshop rows for tools/formulas: keep the rows of a list that match a person's rule tree, evaluate a formula over rows, list the comparisons on offer, and give a record the label of the first of a person's rules that holds. Each row runs one function of do-work/requests.mjs on the request given; the records, fields, rules and formulas are the person's, none is built in.",
 "records": [
  {
   "id": "package::formulas::tool::filter-rows-by-rules",
   "address": "package::formulas::tool::filter-rows-by-rules",
   "path": [
    "current-item",
    "published-record"
   ],
   "payload": {
    "kind": "ai-tool-descriptor",
    "id": "tool:filter-rows-by-rules",
    "label": "Keep the rows that match my rules",
    "status": "active",
    "job": "Keep the rows of a list that match my rules: a tree of comparisons (is any of, has all of, contains, is more than, is between, is empty, is known and more) joined by all-of and any-of groups, each group optionally negated",
    "description": "Takes records, the fields the rules may read (an id, a kind and a path into each record) and a rule tree. Answers the positions and the records that match, the field ids the rules read and the rules left out because they are not finished (an unknown field or comparison, a comparison the field's kind does not offer, missing values), never guessing at them. A tree with no finished rule keeps every row. A value that is unknown never matches a comparison that cannot tell (contains, starts with, more than, less than, between and the like) nor its negation (does not contain, has none of), but an unknown value is simply not in a list and not equal to a word, so is none of and is not keep it. A group whose combinator is not one of the listed ones is refused with a sentence. A row whose value is of the wrong kind for a comparison is counted in error_rows and left out. The comparisons are rows of data: send operators to add or change them, or leave it out to use the ones list-comparisons shows.",
    "input_schema": {
     "type": "object",
     "required": [
      "records",
      "fields"
     ],
     "properties": {
      "records": {
       "type": "array",
       "items": {
        "type": "object"
       },
       "description": "The list to filter"
      },
      "fields": {
       "type": "array",
       "items": {
        "type": "object",
        "required": [
         "id",
         "kind"
        ],
        "properties": {
         "id": {
          "type": "string",
          "description": "The name rules use for this field"
         },
         "kind": {
          "type": "string",
          "description": "Which comparisons the field offers (see list-comparisons)"
         },
         "path": {
          "type": "array",
          "items": {},
          "description": "Keys and positions into a record; the id by default"
         }
        }
       }
      },
      "tree": {
       "type": "object",
       "description": "A group { kind: group, combinator, negate, rules } or a rule { kind: rule, field, operator, params }; left out means every row"
      },
      "operators": {
       "type": "object",
       "description": "Comparisons and combinators as rows of data, replacing the built-in ones"
      }
     }
    },
    "output_schema": {
     "type": "object",
     "required": [
      "total",
      "matches",
      "records",
      "incomplete",
      "error_rows"
     ],
     "properties": {
      "total": {
       "type": "integer"
      },
      "matches": {
       "type": "array",
       "items": {
        "type": "integer"
       }
      },
      "records": {
       "type": "array",
       "items": {
        "type": "object"
       }
      },
      "reads": {
       "type": "array",
       "items": {
        "type": "string"
       }
      },
      "incomplete": {
       "type": "array",
       "items": {
        "type": "object"
       }
      },
      "error_rows": {
       "type": "integer"
      },
      "first_error": {
       "type": [
        "string",
        "null"
       ]
      }
     }
    },
    "invoke": {
     "kind": "container",
     "files": {
      "package_files": {
       "package": "formulas",
       "paths": [
        "do-work",
        "read-data"
       ],
       "at": "/opt/formulas"
      }
     },
     "workdir": "/opt/formulas",
     "internet": false,
     "stdout": "json",
     "argv": [
      "node",
      "do-work/run-request.mjs",
      "filterRecords"
     ],
     "stdin": {
      "fill": {
       "from": "input"
      }
     }
    },
    "needs": {
     "expected_seconds": 5,
     "network_egress": false,
     "memory_mb": 256
    },
    "licence_class": "licence:maker-own",
    "placements": [
     "placement:small-container"
    ],
    "maker": "maker:formulas",
    "result_selector": "$.result",
    "verify": [
     {
      "kind": "sample-run",
      "input": {
       "records": [
        {
         "id": "a",
         "kind": "loaf",
         "tags": [
          "rye",
          "seeded"
         ],
         "grams": 800
        },
        {
         "id": "b",
         "kind": "roll",
         "tags": [
          "white"
         ],
         "grams": 90
        },
        {
         "id": "c",
         "kind": "loaf",
         "tags": [
          "white"
         ],
         "grams": null
        }
       ],
       "fields": [
        {
         "id": "kind",
         "kind": "choice"
        },
        {
         "id": "grams",
         "kind": "number"
        }
       ],
       "tree": {
        "kind": "group",
        "combinator": "and",
        "negate": false,
        "rules": [
         {
          "kind": "rule",
          "field": "kind",
          "operator": "is_any_of",
          "params": {
           "values": [
            "loaf"
           ]
          }
         },
         {
          "kind": "rule",
          "field": "grams",
          "operator": "greater_than",
          "params": {
           "value": 500
          }
         }
        ]
       }
      },
      "output_selector": "$.records[0].id",
      "contains": "a"
     }
    ],
    "provenance": {
     "source": "bitfield-packages packages/formula-engine (rules: rule-operators, compile-rules; the row evaluator re-implemented for the operators the comparisons use)"
    }
   }
  },
  {
   "id": "package::formulas::tool::evaluate-a-formula",
