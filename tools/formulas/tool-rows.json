   ],
   "payload": {
    "kind": "ai-tool-descriptor",
    "id": "tool:classify-a-record",
    "label": "Give a record the label of the first rule it meets",
    "status": "active",
    "job": "Give a record the label of the first of my rules that holds: each rule has clauses over facts read from the record (is present, is absent, at least, at most, equals), and I get the rule's key, label, tone and severity, or none",
    "description": "Takes a record, the facts to read from it (a key, a path, and how to read it: present, as a number, as an age in seconds up to now_ms, or as it is) and rules in order (a key, a label, an optional tone and severity, and clauses over facts). Answers the first rule whose clauses all hold, with its key, label, tone and severity exactly as given (null where none was given), or no result when none holds. A request that is unfinished (a rule with no key, label or clause, a clause naming a fact that was not declared, an operator that is not listed, an age fact with no now_ms) is refused with a sentence. The tool names no label, tone or threshold; the clock is now_ms, never read.",
    "input_schema": {
     "type": "object",
     "required": [
      "facts",
      "rules",
      "record"
     ],
     "properties": {
      "facts": {
       "type": "array",
       "items": {
        "type": "object",
        "required": [
         "key",
         "as"
        ],
        "properties": {
         "key": {
          "type": "string"
         },
         "path": {
          "type": "array",
          "items": {},
          "description": "Names and list positions into the record"
         },
         "as": {
          "type": "string",
          "enum": [
           "present",
           "number",
           "age-seconds",
           "value"
          ]
         }
        }
       }
      },
      "rules": {
       "type": "array",
       "items": {
        "type": "object",
        "required": [
         "key",
         "label",
         "requires"
        ],
        "properties": {
         "key": {
          "type": "string"
         },
         "label": {
          "type": "string"
         },
         "tone": {
          "type": "string"
         },
         "severity": {
          "type": "string"
         },
         "requires": {
          "type": "array",
          "items": {
           "type": "object",
           "required": [
            "fact",
            "op"
           ],
           "properties": {
            "fact": {
             "type": "string"
            },
            "op": {
             "type": "string",
             "enum": [
              "present",
              "absent",
              "gte",
              "lte",
              "eq"
             ]
            },
            "value": {}
           }
          }
         }
        }
       }
      },
      "record": {
       "type": "object"
      },
      "now_ms": {
       "type": "number",
       "description": "The time an age-seconds fact is measured to; required when one is declared"
      }
     }
    },
    "output_schema": {
     "type": "object",
     "required": [
      "result"
     ],
     "properties": {
      "result": {
       "type": [
        "object",
        "null"
       ],
       "properties": {
        "key": {
         "type": "string"
        },
        "label": {
         "type": "string"
        },
        "tone": {
         "type": [
          "string",
          "null"
         ]
        },
        "severity": {
         "type": [
          "string",
          "null"
         ]
        }
       }
      }
     }
    },
    "invoke": {
     "kind": "container",
     "files": {
      "package_files": {
       "package": "formulas",
       "paths": [
        "do-work",
        "read-data"
       ],
       "at": "/opt/formulas"
      }
     },
     "workdir": "/opt/formulas",
     "internet": false,
     "stdout": "json",
     "argv": [
