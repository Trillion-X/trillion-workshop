   ],
   "payload": {
    "kind": "ai-tool-descriptor",
    "id": "tool:evaluate-a-formula",
    "label": "Evaluate a formula over rows",
    "status": "active",
    "job": "Evaluate a formula over each row of a list: read a value from the row, then run a pipeline of steps (and, or, not, equals, more than, less than, is in a list, position in a list, lower-case, contains, starts with, join, is empty, is unknown) over it",
    "description": "Takes a binding (select from the row at a path, or a stated literal, then a transform list of { op, args }; an argument may itself be a binding evaluated over the value the step receives) and rows. Answers one value per row, in order, and the rows that could not be evaluated with the reason (a step given a value of the wrong kind, or a step that is not supported). Three-state logic: and, or and not answer true, false or unknown, and a comparison with an unknown side is unknown. Nothing outside the row is read.",
    "input_schema": {
     "type": "object",
     "required": [
      "binding",
      "rows"
     ],
     "properties": {
      "binding": {
       "type": "object",
       "description": "{ $kind: binding, select: { from: self, path: [...] }, transform: [{ op, args }], default? }"
      },
      "rows": {
       "type": "array",
       "description": "The values to evaluate the binding over"
      }
     }
    },
    "output_schema": {
     "type": "object",
     "required": [
      "values",
      "errors"
     ],
     "properties": {
      "values": {
       "type": "array"
      },
      "errors": {
       "type": "array",
       "items": {
        "type": "object",
        "required": [
         "row",
         "error"
        ]
       }
      }
     }
    },
    "invoke": {
     "kind": "container",
     "files": {
      "package_files": {
       "package": "formulas",
       "paths": [
        "do-work",
        "read-data"
       ],
       "at": "/opt/formulas"
      }
     },
     "workdir": "/opt/formulas",
     "internet": false,
     "stdout": "json",
     "argv": [
      "node",
      "do-work/run-request.mjs",
      "evaluateFormula"
     ],
     "stdin": {
      "fill": {
       "from": "input"
      }
     }
    },
    "needs": {
     "expected_seconds": 5,
     "network_egress": false,
     "memory_mb": 256
    },
    "licence_class": "licence:maker-own",
    "placements": [
     "placement:small-container"
    ],
    "maker": "maker:formulas",
    "result_selector": "$.result",
    "verify": [
     {
      "kind": "sample-run",
      "input": {
       "binding": {
        "$kind": "binding",
        "select": {
         "from": "self",
         "path": [
          "name"
         ]
        },
        "transform": [
         {
          "op": "op:core.lower"
         },
         {
          "op": "op:core.contains",
          "args": {
           "value": "rye"
          }
         }
        ]
       },
       "rows": [
        {
         "name": "Dark RYE loaf"
        },
        {
         "name": "Scone"
        },
        {
         "name": null
        }
       ]
      },
      "output_selector": "$.values",
      "contains": "true,false,"
     }
    ],
    "provenance": {
     "source": "bitfield-packages packages/formula-engine (evaluate-over-rows: the binding evaluator for the operators the comparison rows use)"
    }
   }
