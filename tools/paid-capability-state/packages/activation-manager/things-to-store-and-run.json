    {
      "type": "record",
      "address": "package::activation-manager::workflow-action::advance-to-state",
      "address_mode": "identity_text",
      "path": [
        "current-item",
        "published-record",
        "workflow-definition"
      ],
      "remove": false,
      "payload": {
        "id": "action:activation-manager.advance-to-state",
        "kind": "action",
        "name": "advance-to-state",
        "description": "Generic lifecycle advance: on a step-taken event (payment / clock / local delta), move a person to a new next-step state and dispatch that state's next-step action to its owning machine. ONE blind action fed state_key + action_definition_id as DATA from N trigger-rules (zero code per stage). Accepts EITHER customer_email (payment deltas carry attributes.customer_email, not an id -> first step derives the one-way account id via account-identity.derive, exactly as checkout does) OR a pre-derived account_id (local deltas that already carry it). Keys the superseding next-step-state (capability-state-evidence-record) on the one-way account id (SSOT), copies label/tone/rank/terminal from the matching state-descriptor DATA row owned by move-records-through-declared-states (no code maps the key), supersedes the person's prior state, then dispatches action_definition_id by envelope to the owning machine (e.g. customer-follow-up.claim-welcome-for-contact). This machine never sends/books/charges itself.",
        "input_schema": {
          "type": "object",
          "properties": {
            "account_id": {
              "type": "string",
              "description": "a pre-derived one-way account id (local deltas that already carry it); takes precedence over the derived id"
            },
            "state_key": {
              "type": "string",
              "description": "the state-descriptor key to advance this person into (DATA, e.g. paid-owes-welcome, going-quiet)"
            },
            "since": {
              "type": "string",
              "description": "when the person entered this state (waiting-time)"
            },
            "silence_threshold_days": {
              "type": "number",
              "description": "optional churn window (DATA from the silence trigger-rule); the stale-person filter uses this, never a literal in step logic"
            }
          },
          "required": [
            "account_id",
            "state_key",
            "since"
          ]
        },
        "steps": [
          {
            "id": "find-state",
            "kind": "ask",
            "join": "any",
            "join_config": null,
            "config": {
              "name": "slot::find-current-items",
              "input": {
                "operation": "find-current-items",
                "in": "published-record",
                "include": [
                  "address",
                  "payload"
                ],
                "where": {
                  "all": [
                    {
                      "field": "kind",
                      "in": [
                        "state-descriptor"
                      ]
                    },
                    {
                      "field": "key",
                      "in": [
                        {
                          "$kind": "binding",
                          "select": {
                            "from": "input",
                            "path": "state_key"
                          }
                        }
                      ]
                    }
                  ]
                },
                "limit": 64
              }
            }
          },
          {
            "id": "find-prior",
            "kind": "ask",
            "join": "any",
            "join_config": null,
            "config": {
              "name": "slot::find-current-items",
              "input": {
                "operation": "find-current-items",
                "in": "published-record",
                "include": [
                  "address",
                  "payload"
                ],
                "where": {
                  "all": [
                    {
                      "field": "kind",
                      "in": [
                        "capability-state-evidence-record"
                      ]
                    },
                    {
                      "field": "subject_ref",
                      "in": [
                        {
                          "$kind": "binding",
                          "select": {
                            "from": "input",
                            "path": "account_id"
                          },
                          "transform": [
                            {
                              "op": "op:core.concat",
                              "args": {
                                "values": [
                                  "person:",
                                  {
                                    "$kind": "binding",
                                    "select": {
                                      "from": "input",
                                      "path": "account_id"
                                    }
                                  }
                                ]
                              }
                            }
                          ]
                        }
                      ]
                    }
                  ]
                },
                "limit": 64
              }
            }
          },
          {
            "id": "write-state",
            "kind": "write",
            "join": "any",
            "join_config": null,
            "config": {
              "items": [
                {
                  "address": {
                    "$kind": "binding",
                    "select": {
                      "from": "input",
                      "path": "account_id"
                    },
                    "transform": [
                      {
                        "op": "op:core.concat",
                        "args": {
                          "values": [
                            "package::activation-manager::next-step-state::",
                            {
                              "$kind": "binding",
                              "select": {
                                "from": "input",
                                "path": "account_id"
                              }
                            }
                          ]
                        }
                      }
