[Unit]
Description={description}
After=network-online.target
Wants=network-online.target

[Service]
# BETTER_AUTH_SECRET is the value held under the vault name {secret_vault_key}: start-a-computer seals it for this computer
# (systemd-creds) at {secret_file}; this unit names only where. The row's other credentials (the sign-in store's connection, the
# email sender's key) are sealed the same way and loaded below; one that names an env is handed to the server in that variable.
LoadCredentialEncrypted={secret_name}:{secret_file}
{credential_lines}
Environment=BETTER_AUTH_SETTINGS={settings_file}
Environment=PATH={node_bin}:/usr/bin:/bin
Environment=npm_config_cache={workshop}/.npm-cache
Type=simple
User={user}
Group={user}
# The Workshop copy at {workshop} stays between starts: the row's pinned commit {workshop_commit} is fetched into it (only what
# the copy lacks) and checked out. npm ci runs only when that commit's package-lock.json is not the one installed last time,
# whose git id is kept in the copy's .git/npm-lock-id.
ExecStartPre=/bin/sh -c 'test -d {workshop}/.git || git init -q {workshop}'
ExecStartPre=/bin/sh -c 'git -C {workshop} fetch -q --depth 1 {repository} {workshop_commit} && git -C {workshop} checkout -q --detach {workshop_commit}'
ExecStartPre=/bin/sh -c 'lock=$$(git -C {workshop} rev-parse {workshop_commit}:{tool_folder}/package-lock.json) && if [ "$$(cat {workshop}/.git/npm-lock-id 2>/dev/null)" != "$$lock" ]; then cd {workshop}/{tool_folder} && npm ci --omit=dev --no-audit --no-fund && echo "$$lock" > {workshop}/.git/npm-lock-id; fi'
ExecStart=/bin/sh -c 'cd {workshop}/{tool_folder} && BETTER_AUTH_SECRET="$(cat "$CREDENTIALS_DIRECTORY/{secret_name}")" && export BETTER_AUTH_SECRET && {credential_env}exec node server.mjs'
Restart=on-failure
RestartSec=3
KillSignal=SIGTERM
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths={writable}
ProtectHome=true
PrivateTmp=true
LimitCORE=0

[Install]
WantedBy=multi-user.target
