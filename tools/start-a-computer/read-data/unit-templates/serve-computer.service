[Unit]
Description={description}
After=network-online.target
Wants=network-online.target
[Service]
# The engine (trillion-rust src/native_entry/computer.rs) serving its computer config {settings_file}. It runs the program
# `current` names in {builds}: start-a-computer's apply builds the row's source commit on this computer and moves `current` to it.
LimitNOFILE=1048576
Type=simple
User={user}
Group={user}
WorkingDirectory={state}
ExecStart={builds}/current/{program} serve {settings_file}
Restart=always
RestartSec=3
KillSignal=SIGTERM
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths={writable}
ProtectHome=true
PrivateTmp=true
LimitCORE=0
[Install]
WantedBy=multi-user.target
