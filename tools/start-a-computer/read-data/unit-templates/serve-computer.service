[Unit]
Description={description}
After=network-online.target
[Service]
Environment={launch_setting}={product_settings}
LimitNOFILE=1048576
User={user}
Group={user}
ExecStart=/bin/sh -c 'R=$(readlink -f {releases}/current) && exec env {data_env}="$R/{data_dir}" "$R/{engine_file}" serve {config}'
Restart=always
RestartSec=3
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths={writable}
ProtectHome=true
PrivateTmp=true
[Install]
WantedBy=multi-user.target
