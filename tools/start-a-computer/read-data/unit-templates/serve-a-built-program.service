[Unit]
Description={description}
After=network-online.target
Wants=network-online.target

[Service]
# Runs {interpreter} {builds}/{current}/{program}: the program start-a-computer's apply built here from the row's source commit
# and moved the `{current}` link to. Its held values are sealed credentials it reads from $CREDENTIALS_DIRECTORY; this unit
# names only where they are. Its own folder under /run is {runtime_directory}, owned by {user} and readable by the group {group}
# (a web server that sends it requests on a socket there). A restart keeps that folder (the row's runtime_preserve,
# `restart` unless it says), so the web server waits for the new program on the same socket instead of finding no folder; two
# slots that share the folder, each on its own socket, say `yes`, so the slot that stops never removes the folder the other
# serves from. The stop sends SIGTERM to the
# program alone (KillMode=mixed), which stops taking calls and finishes the ones it holds, for up to {stop_seconds} seconds.
{credential_lines}
Environment={environment}
Type=simple
User={user}
Group={group}
WorkingDirectory={state}
ExecStart={interpreter} {builds}/{current}/{program}
RuntimeDirectory={runtime_directory}
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve={runtime_preserve}
KillMode=mixed
TimeoutStopSec={stop_seconds}
Restart=always
RestartSec=3
UMask=0007
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths={writable}
ProtectHome=true
PrivateTmp=true
LimitCORE=0

[Install]
WantedBy=multi-user.target
