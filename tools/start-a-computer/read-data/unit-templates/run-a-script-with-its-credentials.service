[Unit]
Description={description}
After=network-online.target {after}
Wants={after}

[Service]
# One run of the program {script_file} as {user}, started by its timer or by start-a-computer's apply, with every sealed
# credential its row's `credentials` names (one of them may be held only in this computer's own vault: held_on computer),
# each read by the program from $CREDENTIALS_DIRECTORY by its name; this unit names only where. run-a-script.service is the
# same with one credential from the applier's vault.
Type=oneshot
{credential_lines}
Environment={environment}
Environment=PATH={program_bin}:/usr/local/bin:/usr/bin:/bin
User={user}
Group={user}
ExecStart=/bin/sh {script_file}
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths={writable}
ProtectHome=true
PrivateTmp=true
LimitCORE=0
