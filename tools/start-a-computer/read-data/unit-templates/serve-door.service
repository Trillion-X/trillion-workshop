[Unit]
Description={description}
After=network-online.target
Wants=network-online.target

[Service]
# The public door (trillion-rust src/forwarder, the program {door_file}): plain HTTP on the loopback address its environment
# names, behind the computer's Caddy, which holds TLS. It runs the program `current` names in {builds}: start-a-computer's
# apply builds the row's source commit on this computer and moves `current` to it.
Environment={environment}
LimitNOFILE=1048576
Type=simple
User={user}
Group={user}
ExecStart={builds}/current/{door_file}
Restart=always
RestartSec=3
KillSignal=SIGTERM
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
LimitCORE=0

[Install]
WantedBy=multi-user.target
