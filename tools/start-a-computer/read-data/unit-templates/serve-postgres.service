[Unit]
Description={description}
After=network-online.target
Wants=network-online.target

[Service]
# PostgreSQL from its own package, run as {user} on the data folder {data_dir} (made by initdb at the first start) with the
# settings file {settings_file} the row renders. The sealed credential {secret_name} is a file of NAME=value lines the server
# and the archive command it starts read (the backup store's address and key); this unit names only where. Each file the row
# names in files_read_at_start (another program's file, such as the front door's certificate) is copied in beside it at start.
LoadCredentialEncrypted={secret_name}:{secret_file}
{file_lines}
Environment={environment}
Environment=PATH={program_bin}:/usr/local/bin:/usr/bin:/bin
Type=notify
User={user}
Group={user}
RuntimeDirectory=postgresql
ExecStartPre=/bin/sh -c 'test -f {data_dir}/PG_VERSION || initdb -D {data_dir} --auth-local=peer --auth-host=scram-sha-256 --encoding=UTF8 --locale=C.UTF-8 --data-checksums'
ExecStart=/bin/sh -c 'set -a && . "$CREDENTIALS_DIRECTORY/{secret_name}" && set +a && exec postgres -D {data_dir} -c config_file={settings_file}'
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=3
KillMode=mixed
KillSignal=SIGINT
TimeoutStopSec=120
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths={writable}
ProtectHome=true
PrivateTmp=true
LimitCORE=0

[Install]
WantedBy=multi-user.target
