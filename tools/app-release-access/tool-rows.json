{
 "kind": "tool-rows",
 "record_set": "app-release-access-tool-rows",
 "what_this_is": "The Workshop rows for tools/app-release-access: reading an app's TestFlight and App Store availability, and arranging a person's beta access, with the release owner's App Store Connect key handed on a private pipe (credential_mounts fd 4). Both are container rows with internet to api.appstoreconnect.apple.com only (the client refuses any other origin).",
 "records": [
  {
   "id": "package::app-release-access::tool::read-app-distribution",
   "address": "package::app-release-access::tool::read-app-distribution",
   "path": [
    "current-item",
    "published-record"
   ],
   "payload": {
    "kind": "ai-tool-descriptor",
    "id": "tool:read-app-distribution",
    "label": "Read an app's TestFlight availability",
    "status": "active",
    "job": "Check with Apple which TestFlight and App Store routes a released app can be installed from right now, without changing anything",
    "description": "Give source_id (a configured release source, such as native-ios), the app's bundle_identifier and its testflight_groups. Reads App Store Connect with the release owner's held team key (app-store-connect-key: {key_id, issuer_id, private_key}) and answers the short-lived public observation: source_id, checked_at, expires_at and routes (each with its state, distribution_state, eligibility_state, reason, check and, when ready, action links on testflight.apple.com or apps.apple.com only). It never answers a tester email, the key or Apple's raw reply, and changes nothing at Apple. publish true is refused until the engine lets a tool save the release owner's device-distribution record.",
    "input_schema": {
     "type": "object",
     "required": [
      "source_id",
      "bundle_identifier"
     ],
     "additionalProperties": false,
     "properties": {
      "source_id": {
       "type": "string",
       "description": "A release source of read-data/distribution.json, such as native-ios."
      },
      "bundle_identifier": {
       "type": "string",
       "minLength": 1,
       "description": "The app's bundle identifier in App Store Connect, such as com.example.sample."
      },
      "testflight_groups": {
       "type": "array",
       "maxItems": 20,
       "items": {
        "type": "string",
        "minLength": 1
       },
       "description": "The TestFlight group names whose routes count (the release owner's own groups)."
      },
      "publish": {
       "type": "boolean",
       "description": "Save the observation to the release owner's device-distribution:<source> record. Refused for now (README Not yet)."
      }
     }
    },
    "output_schema": {
     "type": "object",
     "required": [
      "source_id",
      "observation"
     ],
     "properties": {
      "source_id": {
       "type": "string"
      },
      "observation": {
       "type": "object",
       "required": [
        "source_id",
        "checked_at",
        "expires_at",
        "routes"
       ],
       "properties": {
        "routes": {
         "type": "array"
        }
       }
      },
      "published": {
       "type": [
        "object",
        "null"
       ]
      }
     }
    },
    "invoke": {
     "kind": "container",
     "internet": true,
     "workdir": "/opt/app-release-access",
     "stdout": "json",
     "argv": [
      "node",
      "/opt/records-door/do-work/run-an-export.mjs",
      "/opt/app-release-access/read-data/app-distribution.mjs",
      "read"
     ],
     "stdin": {
      "fill": {
       "from": "input"
      }
     },
     "files": {
      "package_files": [
       {
        "package": "app-release-access",
        "paths": [
         "read-data"
        ],
        "at": "/opt/app-release-access"
       },
       {
        "package": "records-door",
        "paths": [
         "do-work",
         "read-data"
        ],
        "at": "/opt/records-door"
       },
       {
        "package": "content-identity",
        "paths": [
         "read-data"
        ],
        "at": "/opt/content-identity"
       },
       {
        "module": "@noble/hashes",
        "paths": [
         "LICENSE",
         "package.json",
         "blake3.js",
         "blake2.js",
         "_blake.js",
         "_md.js",
         "_u64.js",
         "utils.js"
        ],
        "at": "/opt/node_modules/@noble/hashes"
       },
       {
        "package": "browse-and-upload-my-files",
        "paths": [
         "built-stored-bytes/content-chunks/content_chunks.js",
         "do-work/content-chunks.mjs",
         "do-work/namespace-client.mjs",
         "do-work/send-a-file-to-a-namespace.mjs",
         "do-work/send-retry.mjs",
         "do-work/send-window.mjs",
         "do-work/shared-file-reference.mjs",
         "send-settings.json"
        ],
        "at": "/opt/browse-and-upload-my-files"
       }
      ]
     },
     "credential_mounts": [
      {
       "secret_name": "app-store-connect-key",
       "fd": 4
      }
     ]
    },
    "result_selector": "$.result",
    "verify": [
      {"kind": "sample-run", "input": {"source_id": "native-ios", "bundle_identifier": "com.example.sample", "testflight_groups": []}, "held": {"app-store-connect-key": "{\"key_id\": \"SAMPLEKEY01\", \"issuer_id\": \"00000000-0000-0000-0000-000000000000\", \"private_key\": \"[held value: app-store-connect-key private_key]\\n\"}"}, "replies": [{"request": {"method": "GET", "url": "https://api.appstoreconnect.apple.com/v1/apps"}, "status": 200, "body": {"data": [{"type": "apps", "id": "1000000001", "attributes": {"bundleId": "com.example.sample"}}], "links": {"self": "https://api.appstoreconnect.apple.com/v1/apps"}}}, {"request": {"method": "GET", "url": "https://api.appstoreconnect.apple.com/v1/betaGroups"}, "status": 200, "body": {"data": [], "links": {"self": "https://api.appstoreconnect.apple.com/v1/betaGroups"}}}, {"request": {"method": "GET", "url": "https://api.appstoreconnect.apple.com/v1/builds"}, "status": 200, "body": {"data": [], "links": {"self": "https://api.appstoreconnect.apple.com/v1/builds"}}}], "shape_read_at": "2026-11-04"}
    ],
    "needs": {
     "expected_seconds": 20,
     "network_egress": true,
     "memory_mb": 256
    },
    "licence_class": "licence:maker-own",
    "placements": [
     "placement:small-container"
    ],
    "maker": "maker:app-release-access",
    "provenance": {
     "source": "Trillion-X/trillion computer/app-distribution.mjs, scripts/app-store-connect.mjs, scripts/testflight-readiness.mjs, src/device-distribution.mjs"
    }
   }
  },
