   ],
   "payload": {
    "kind": "ai-tool-descriptor",
    "id": "tool:fulfill-setup-access",
    "verify": [
     {"kind": "needs-a-machine", "requires": "a Trillion engine whose records door serves the release owner's setup-access claim, checkpoint and finish operations (not built yet; README Not yet), plus the release owner's App Store Connect key on fd 4: until then every run refuses before any provider call, on any computer, so no sample can exit 0", "proved_on": null}
    ],
    "label": "Arrange a person's beta app access",
    "status": "active",
    "job": "Arrange the TestFlight access a person's setup requires, through the release owner's Apple account, without sending a second invitation",
    "description": "Give account_id, source_id and request_id (the person's setup-access request), and the app's bundle_identifier and testflight_groups. The release owner's claim resolves consent, setup, policy and the verified email; the tool never takes a recipient. It answers a public route when one is usable, otherwise enrolls the person in the policy's external group and, only when Apple will not notify on its own, sends one first invitation, each change after a checkpoint, and an uncertain change is read back, never sent again. Answers state (available, invited, accepted, installed, awaiting-invitation, blocked, indeterminate, revoked) and reason, never the email. Refused for now: the claim, checkpoint and finish are not operations a tool run can reach at the records door yet (README Not yet).",
    "input_schema": {
     "type": "object",
     "required": [
      "account_id",
      "source_id",
      "request_id",
      "bundle_identifier",
      "testflight_groups"
     ],
     "additionalProperties": false,
     "properties": {
      "account_id": {
       "type": "string",
       "minLength": 1,
       "maxLength": 200
      },
      "source_id": {
       "type": "string",
       "minLength": 1,
       "maxLength": 200
      },
      "request_id": {
       "type": "string",
       "minLength": 1,
       "maxLength": 200
      },
      "bundle_identifier": {
       "type": "string",
       "minLength": 1,
       "description": "The app's bundle identifier in App Store Connect, such as com.example.sample."
      },
      "testflight_groups": {
       "type": "array",
       "maxItems": 20,
       "items": {
        "type": "string",
        "minLength": 1
       },
       "description": "The TestFlight group names whose routes count (the release owner's own groups)."
      }
     }
    },
    "output_schema": {
     "type": "object",
     "required": [
      "state"
     ],
     "properties": {
      "state": {
       "type": "string"
      },
      "reason": {
       "type": "string"
      },
      "request_id": {
       "type": "string"
      }
     }
    },
    "invoke": {
     "kind": "container",
     "internet": true,
     "workdir": "/opt/app-release-access",
