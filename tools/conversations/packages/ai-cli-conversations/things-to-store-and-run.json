                  "op": "op:core.equals",
                  "args": {
                    "value": false
                  }
                }
              ]
            }
          ]
        },
        "dispatch": {
          "target": "slot::workflow",
          "output_template": {
            "operation": "execute_definition",
            "definition_id": "action:observe-codex-message-source",
            "input": {}
          }
        }
      }
