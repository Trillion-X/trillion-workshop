    {
      "type": "record",
      "address": "package::ai-cli-conversations::workflow-action::publish-current-transcript-sources",
      "address_mode": "identity_text",
      "path": [
        "current-item",
        "published-record",
        "workflow-definition"
      ],
      "payload": {
        "id": "action:publish-current-transcript-sources",
        "kind": "action",
        "name": "publish-current-transcript-sources",
        "description": "Refresh one current conversation source in Chat's source list without scanning unrelated records.",
        "input_schema": {
          "type": "object",
          "required": [
            "source_ref"
          ],
          "properties": {
            "source_ref": {
              "type": "string"
            }
          }
        },
        "steps": [
          {
            "id": "descriptor",
            "kind": "read",
            "config": {
              "from": {
                "$kind": "binding",
                "select": {
                  "from": "input",
                  "path": "source_ref"
                },
                "transform": [
                  {
                    "op": "op:core.concat",
                    "args": {
                      "values": [
                        "attribute_fact|",
                        {
                          "$kind": "binding",
                          "select": {
                            "from": "input",
                            "path": "source_ref"
                          }
                        },
                        "|prop:observed_content:conversation_source_descriptor|type:observed_content"
                      ]
                    }
                  }
                ]
              },
              "fallback_output": null
            }
          },
          {
            "id": "current",
            "kind": "read",
            "config": {
              "from": "transcript-sources",
              "fallback_output": []
            }
          },
          {
            "id": "script",
            "kind": "read",
            "config": {
              "from": "package::ai-cli-conversations::stored-bytes::merge-conversation-source-script"
            }
          },
          {
            "id": "merge",
            "kind": "ask",
            "config": {
              "name": "compute.process",
              "input": {
                "argv": [
                  "python3",
                  "merge-conversation-source.py",
                  "current.json",
                  "addressed.json",
                  {
                    "$kind": "binding",
                    "select": {
                      "from": "input",
                      "path": "source_ref"
                    }
                  },
                  "merged.json"
                ],
                "cwd": null,
                "timeout_ms": 30000,
                "termination_grace_ms": 1000,
                "expected_termination": null,
                "env": {},
                "inputs": [
                  {
                    "mount_path": "merge-conversation-source.py",
                    "content_type": "text/x-python",
                    "source": {
                      "kind": "blob_ref",
                      "hash": {
                        "$kind": "binding",
                        "select": {
                          "from": "steps",
                          "key": "script",
                          "path": "output.content_hash"
                        }
                      }
                    }
                  },
                  {
                    "mount_path": "current.json",
                    "content_type": "application/json",
                    "source": {
                      "kind": "inline",
                      "bytes": {
                        "$kind": "binding",
                        "select": {
                          "from": "steps",
                          "key": "current",
                          "path": "output"
                        },
                        "transform": [
                          {
                            "op": "op:core.stringify",
                            "args": {
                              "format": "json"
                            }
                          },
                          {
                            "op": "op:core.encode",
                            "args": {
                              "encoding": "base64"
                            }
                          }
                        ]
                      }
                    }
                  },
                  {
                    "mount_path": "addressed.json",
                    "content_type": "application/json",
                    "source": {
                      "kind": "inline",
                      "bytes": {
                        "$kind": "binding",
                        "select": {
                          "from": "steps",
                          "key": "descriptor",
                          "path": "output"
                        },
                        "transform": [
                          {
                            "op": "op:core.stringify",
                            "args": {
                              "format": "json"
                            }
                          },
                          {
                            "op": "op:core.encode",
                            "args": {
                              "encoding": "base64"
                            }
                          }
                        ]
                      }
                    }
                  }
                ],
                "input_trees": [],
                "outputs": [
                  {
                    "mount_path": "merged.json",
                    "content_type": "application/json"
                  }
                ],
                "containment": {
                  "kind": "leaf"
                },
                "capture_fds": [
                  1,
                  2
                ],
                "collected_files": []
              }
            }
          },
          {
            "id": "publish",
            "kind": "write",
            "config": {
              "items": [
                {
                  "address": "transcript-sources",
                  "path": [
                    "current-item",
                    "published-record",
                    "conversation-source-descriptors"
                  ],
                  "payload": {
                    "$kind": "binding",
                    "select": {
                      "from": "steps",
                      "key": "merge",
                      "path": "output.outputs.0.bytes.base64"
                    },
                    "transform": [
                      {
                        "op": "op:core.decode",
                        "args": {
                          "encoding": "base64"
                        }
                      },
                      {
                        "op": "op:core.json_parse"
                      }
                    ]
                  }
                }
              ]
            }
          }
        ]
      }
    },
    {
      "type": "record",
