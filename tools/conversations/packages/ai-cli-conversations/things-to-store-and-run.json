                    }
                  }
                ]
              }
            }
          ]
        },
        "dispatch": {
          "target": "slot::workflow",
          "output_template": {
            "operation": "execute_definition",
            "definition_id": "action:publish-current-transcript-sources",
            "include_steps": false,
            "include_output": false,
            "input": {
              "source_ref": {
                "$kind": "binding",
                "select": {
                  "from": "change",
                  "path": "subject_id"
                }
              }
            }
          }
        }
      }
    },
