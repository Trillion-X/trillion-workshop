    {
      "type": "record",
      "address": "package::ai-cli-conversations::workflow-action::observe-codex-message-source",
      "address_mode": "identity_text",
      "path": [
        "current-item",
        "published-record",
        "workflow-definition"
      ],
      "payload": {
        "kind": "action",
        "id": "action:observe-codex-message-source",
        "name": "observe-codex-message-source",
        "version": 1,
        "trigger_type": "manual",
        "trigger_source": "",
        "is_active": true,
        "description": "Read the current authorized Codex source and cursor, then ask the existing file-glob observer to admit changed session files.",
        "input_schema": {
          "type": "object",
          "properties": {},
          "required": []
        },
        "steps": [
          {
            "id": "read_descriptor",
            "kind": "ask",
            "config": {
              "name": "engine.operation.label-addressed",
              "input": {
                "operation_label": "engine.operation.read-current",
                "address_mode": "identity_text",
                "address_label": "attribute_fact|source:codex|prop:observed_content:source_descriptor|type:observed_content"
              }
            }
          },
          {
            "id": "read_cursor",
            "kind": "ask",
            "config": {
              "name": "engine.operation.label-addressed",
              "input": {
                "operation_label": "engine.operation.read-current",
                "address_mode": "identity_text",
                "address_label": "attribute_fact|source:codex|prop:observed_content:cursor|type:observed_content"
              }
            }
          },
          {
            "id": "descriptor_found",
            "kind": "return",
            "config": {
              "value": {
                "$kind": "binding",
                "select": {
                  "from": "steps",
                  "key": "read_descriptor",
                  "path": "output.found"
                },
                "transform": [
                  {
                    "op": "op:core.equals",
                    "args": {
                      "value": true
                    }
                  }
                ]
              }
            }
          },
          {
            "id": "observe",
            "kind": "action",
            "join": "all",
            "config": {
              "definition_id": "action:observe-file-glob-source",
              "inputs": {
                "plan_entry": {
                  "source_ref": "source:codex",
                  "descriptor": {
                    "$kind": "binding",
                    "select": {
                      "from": "steps",
                      "key": "read_descriptor",
                      "path": "output.payload.value_json"
                    },
                    "transform": [
                      {
                        "op": "op:core.json_parse"
                      }
                    ]
                  },
                  "cursor": {
                    "$kind": "binding",
                    "select": {
                      "from": "steps",
                      "key": "read_cursor",
                      "path": "output.payload.value_json"
                    },
                    "transform": [
                      {
                        "op": "op:core.if_null",
                        "args": {
                          "fallback": "{}"
                        }
                      },
                      {
                        "op": "op:core.json_parse"
                      }
                    ]
                  }
                }
              }
            }
          }
        ],
        "edges": [
          {
            "from": "read_descriptor",
            "to": "read_cursor",
            "kind": "always"
          },
          {
            "from": "read_cursor",
            "to": "descriptor_found",
            "kind": "always"
          },
          {
            "from": "descriptor_found",
            "to": "observe",
            "kind": "on_result",
            "config": {
              "$kind": "binding",
              "select": {
                "from": "input",
                "path": "output"
              }
            }
          }
        ]
      }
    },
    {
