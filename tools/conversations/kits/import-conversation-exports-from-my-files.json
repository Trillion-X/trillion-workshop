  "workflows": [],
  "tools": [
    "tool:import-conversation-exports-from-my-files"
  ],
  "instructions": [
    "1. Upload the export (JSON, zipped JSON or one ChatGPT Markdown chat) into your account files, and keep list:ai-conversations (or pour the two example rows into your own chat list, see pour).",
    "2. Say \"Import my chat export /exports/bread.json from my files\"; the AI runs tool:import-conversation-exports-from-my-files with {files: [\"/exports/bread.json\"]} (up to 100 files; add app when it is not ChatGPT).",
    "3. Read the answer: conversations_kept and messages_added say what is new; more: true means it stopped at its time box, so run it again and it continues; a finished file run again adds nothing.",
    "4. Open list:ai-conversations: each conversation has a row; every message is checked back against the pinned export."
  ],
  "worked_examples": [
    {
      "title": "A one-chat export in the account files is kept",
      "ask": "Import my chat export /exports/bread.json from my files.",
      "mcp": {
        "server": "{cli}",
        "tool": "do_one_thing_in_my_account",
        "input": {
          "method": "tools:run",
          "input": {
            "tool": "tool:import-conversation-exports-from-my-files",
            "input": {
              "files": [
                "/exports/bread.json"
              ]
            }
          }
        }
      },
      "given": "From the sample-run in tools/conversations/what-this-tool-does-and-how-to-run-it.json: the account files hold /exports/bread.json, the conversation bread-sample titled Bread with two messages (\"More rye.\" and \"Use fresh flour.\"). The counts were worked out from read-data/chat-import.mjs (importNamespaceExports), not run here.",
      "hands_back": "{\"files\":[{\"name\":\"/exports/bread.json\",\"done\":true,\"skipped\":false}],\"messages_added\":2,\"messages_already_kept\":0,\"conversations_kept\":1,\"done\":true,\"more\":false}"
    }
  ],
  "pour": {
    "tool": "tool:pour-example-rows-into-my-list",
    "least_coverage": 0.8,
    "how": "Name the list you already keep for your AI chats and its fields. The tool matches each kit field to one of yours (same id, same label or a name in alike), refuses when fewer than 80% match, and otherwise answers the records:write that adds the two example rows to your list.",
    "example": {
      "kit_list": "list:ai-conversations",
      "into": {
        "list": "list:chat-log",
        "row_type": "record:chat-log-entry",
        "fields": [
