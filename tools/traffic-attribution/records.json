        ],
        "at": "/opt/node_modules/@noble/hashes"
       }
      ]
     },
     "workdir": "/opt/parts/traffic-attribution",
     "stdout": "json",
     "argv": [
      "node",
      "do-work/make-a-tracked-link.mjs",
      {
       "fill": {
        "from": "input"
       }
      }
     ]
    },
    "needs": {
     "expected_seconds": 20,
     "network_egress": false,
     "memory_mb": 512
    },
    "licence_class": "licence:maker-own",
    "placements": [
