   "payload": {
    "kind": "ai-tool-descriptor",
    "id": "tool:make-tracked-link",
    "label": "Make a tracked link",
    "status": "active",
    "job": "Make a tracked link with UTM fields for a post, ad, email or bio, so visits and sales can be traced to it",
    "description": "Adds the project, source and campaign (and optionally the medium and a content tag for one post) to a web address as UTM fields, replacing any already there. Refuses an address that is not a web page or carries a user name or password. With go_base (the site's address) it also answers the touch row to keep in journey_touches and a short /go/ link that sends each visitor through it, so the visit and the sale trace back to the post. Use the same project, source and campaign names when breaking visits down later.",
    "input_schema": {
     "type": "object",
     "required": [
      "destination",
      "project",
      "source",
      "campaign"
     ],
     "properties": {
      "destination": {
       "type": "string",
       "description": "The web page the link opens"
      },
      "project": {
       "type": "string",
       "description": "Your name for what is being promoted, letters, numbers, dots, dashes or underscores"
      },
      "source": {
       "type": "string",
       "description": "Where the link is posted, like instagram or newsletter"
      },
      "campaign": {
       "type": "string"
      },
      "medium": {
       "type": "string"
      },
      "content": {
       "type": "string",
       "description": "A tag for one post or ad"
      },
      "go_base": {
       "type": "string",
       "description": "The client site's web address. When given, the answer also carries touch (the row to write into journey_touches) and short_link (the /go/ link that sends a visitor through it)"
      }
     },
     "additionalProperties": false
    },
    "output_schema": {
     "type": "object",
     "required": [
      "link",
      "fields"
     ],
     "properties": {
      "link": {
       "type": "string",
       "minLength": 1
      },
      "fields": {
       "type": "object"
      },
      "touch": {
       "type": "object"
      },
      "short_link": {
       "type": "string"
      }
     }
    },
    "invoke": {
     "kind": "container",
     "files": {
      "package_files": [
       {
        "package": "traffic-attribution",
        "paths": [
         "do-work/make-a-tracked-link.mjs",
         "do-work/journey.mjs",
         "read-data/tracked-link.mjs",
         "read-data/journey.json",
