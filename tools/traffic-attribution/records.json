  {
   "type": "record",
   "id": "package::traffic-attribution::tool::prepare-ad-conversions",
   "address": "package::traffic-attribution::tool::prepare-ad-conversions",
   "path": [
    "current-item",
    "published-record"
   ],
   "payload": {
    "kind": "ai-tool-descriptor",
    "id": "tool:prepare-ad-conversions",
    "label": "Prepare sign-ups and payments to send back to Meta Ads and Google Ads",
    "status": "active",
    "job": "Send sign-up and payment conversions back to Meta Ads (Conversions API) and Google Ads so their bidding learns which clicks became customers",
    "description": "Off until a destination is turned on (on: true) with its account (Meta: pixel_id; Google Ads: operating_account_id, the customer id without dashes) and which outcome is which event (Meta: an event name like CompleteRegistration or Purchase; Google Ads: a conversion action id). Each conversion (visitor, outcome, at, value, event_id, email, phone) becomes one event carrying the click ids of the visitor's first touch (gclid, gbraid, wbraid, fbc, fbp; fbc is made from fbclid when absent) and the email and phone hashed with SHA-256 after each platform's own plain-form rule; the plain values never appear in the answer. The answer lists the sends, each a send to Meta Ads or Google Ads with its exact input, batched to the platform's limit, and the conversions skipped with why. Event ids are the conversion's event_id or project:visitor:outcome, so sending again is counted once; give each repeat payment its own event_id.",
    "input_schema": {
     "type": "object",
     "required": [
      "project",
      "visits",
      "conversions"
     ],
     "properties": {
      "project": {
       "type": "object",
       "required": [
        "id"
       ],
       "properties": {
        "id": {
         "type": "string",
         "description": "The project name used in the tracked links"
        },
        "currency": {
         "type": "string",
         "description": "The currency values are in (default USD)"
        }
       }
      },
      "destinations": {
       "type": "array",
       "description": "Where conversions go; none, or none on, sends nothing",
       "items": {
        "type": "object",
        "required": [
         "shape",
         "on",
         "account",
         "events"
        ],
        "properties": {
         "id": {
          "type": "string"
         },
