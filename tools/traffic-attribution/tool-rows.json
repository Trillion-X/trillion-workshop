   ],
   "payload": {
    "uses_tools": [],
    "kind": "ai-tool-descriptor",
    "id": "tool:follow-a-short-link",
    "label": "Follow a short link",
    "job": "Send a visitor from a tracked short link to its destination, keeping the click",
    "description": "Finds the tracked link named by code, keeps one click step (with the visitor only when they consented) and answers where to send the visitor: the link's destination with its source fields and the touch id, as { status, location, set_cookie }. An unknown code answers status 404 with no location; an unreadable link answers 503 with retry_after. The click is best effort: a click that cannot be kept never holds the visitor back.",
    "status": "active",
    "read_only": false,
    "result_selector": "$",
    "input_schema": {
     "type": "object",
     "required": [
      "database",
      "code",
      "consent_cookie_name"
     ],
     "additionalProperties": false,
     "properties": {
      "database": {
       "type": "string",
       "minLength": 1,
       "description": "The name of the pursuit database to use, bound by the trusted caller. The engine opens it with the login its vault holds as that name and -writer-connection under a use (-connection without one); no caller supplies a login."
      },
      "use": {
       "type": "object",
       "additionalProperties": false,
       "required": ["purpose", "surface"],
       "description": "The use this run is for: the site's declared use, such as purpose publish and surface site/example.com. Given with the database, the computer opens it with its writer login (only the column rights read-data/writer-rights.json names) under this use and hands the run a ticket of it, which the run's transaction claims first. A share's run (a site's act) must give it.",
       "properties": {
        "purpose": { "type": "string", "minLength": 1 },
        "surface": { "type": "string" }
       }
      },
      "code": {
       "type": "string",
       "minLength": 1,
       "description": "The tracked link's id: the part of the address after /go/."
      },
      "visitor_cookie": {
       "type": "string",
       "description": "The value of the visitor's id cookie (jv), if they sent one. Never the whole Cookie header: it also carries the sign-in session."
      },
      "consent": {
       "type": "string",
       "description": "The value of the site's consent cookie (the one consent_cookie_name names), if they sent one."
      },
      "referer": {
       "type": "string",
       "description": "The Referer header the visitor sent, if any."
      },
      "consent_cookie_name": {
       "type": "string",
       "minLength": 1,
       "description": "The name of the site's consent cookie; a visitor is kept only when it holds the granted value."
      }
     }
    },
    "output_schema": {
     "type": "object",
     "required": [
      "status",
      "location",
      "set_cookie"
     ],
     "properties": {
      "status": {
       "type": "integer"
      },
      "location": {
       "type": [
        "string",
        "null"
       ]
      },
      "set_cookie": {
       "type": [
        "string",
        "null"
       ]
      },
      "retry_after": {
       "type": "integer"
      }
     }
    },
    "invoke": {
     "kind": "container",
     "internet": true,
     "workdir": "/opt/traffic-attribution",
     "stdout": "json",
     "argv": [
      "node",
      "/opt/traffic-attribution/routes/follow-a-short-link.ts"
     ],
     "stdin": {
      "fill": {
       "from": "input"
      }
     },
     "credential_mounts": [
      {
       "secret_name_from_input": "database",
       "held_suffix": "-connection",
       "fd": 3,
       "only_when": {
        "input": "database",
        "present": true
       },
       "under_use": {
        "use_from_input": "use",
        "ticket_fd": 5,
        "held_suffix": "-writer-connection",
        "key_suffix": "-use-key"
       }
      }
     ],
     "max_run_ms": 20000,
     "files": {
      "package_files": [
       {
