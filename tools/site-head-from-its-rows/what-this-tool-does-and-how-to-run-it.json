 "record_set": "site-head-from-its-rows-tool-rows",
 "what_this_is": "The Workshop rows for the tool in tools/site-head-from-its-rows: the head and body-start markup of a site, made from its rows.",
 "records": [
  {
   "payload": {
    "uses_tools": [],
    "kind": "ai-tool-descriptor",
    "id": "tool:read-the-site-head",
    "label": "Read the site head",
    "job": "Read the head and body-start markup every page of a site carries: the consent default, the Accept and Decline bar and the declared tags",
    "description": "Reads the site_head row (declared purposes and consent) and the site_head_parts rows (each head and body-start part, in place order) of the pursuit database for site, checks every rule (consent default denied for every visitor, https addresses only, every part's purpose declared) and answers head, the markup for the start of every page's head (the consent default first, the bar's stylesheet, the declared parts in order, then the bar), and body_start. A site with no row, or whose rows break a rule, is refused with every problem listed. The site's server places the markup with withSiteHead in do-work/site-head.ts.",
    "status": "active",
    "read_only": true,
    "result_selector": "$",
    "input_schema": {
     "type": "object",
     "required": [
      "database",
      "site"
     ],
     "additionalProperties": false,
     "properties": {
      "database": {
       "type": "string",
       "minLength": 1,
       "description": "The name of the pursuit database to read, bound by the trusted caller. The engine opens it with the login its vault holds as that name and -connection; no caller supplies a login."
      },
      "use": {
       "type": "object",
       "additionalProperties": false,
       "required": [
        "purpose",
        "surface"
       ],
       "description": "The use this statement runs for: a recipe step's declared purpose and surface (config.context.use, set by the workflow engine over any use the step's input carried). Given with database, the computer opens the database with its reader login (one that cannot get round the row rules, change a table or read the use binding) instead of the owner's, and hands the run a ticket of this use that it signed; the statement's transaction claims it first, so the database's row rules read this use and the statement cannot change it. A use with credential_name, which has no ticket, is refused. Absent: the owner's own work, read under the database's own purpose_when_unstated.",
       "properties": {
        "purpose": {
         "type": "string",
         "description": "The purpose path, such as publish or coach/review."
        },
        "surface": {
         "type": "string",
         "description": "The surface path, such as social/instagram; empty for any surface."
        }
       }
      },
      "site": {
       "type": "string",
       "minLength": 1,
       "maxLength": 200,
       "description": "The site's name in site_head."
      }
     }
    },
    "output_schema": {
     "type": "object",
     "required": [
      "head",
      "body_start"
     ],
     "properties": {
      "head": {
       "type": "string"
      },
      "body_start": {
       "type": "string"
      },
      "read_from": {
       "type": "array",
       "items": {
        "type": "string"
       },
       "description": "The tables the head was read from, so a server that keeps the markup reads it again only when a change names one of them."
      }
     }
    },
