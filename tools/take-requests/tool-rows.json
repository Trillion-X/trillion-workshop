    "output_schema": {
     "type": "object",
     "required": ["handed", "already", "said"],
     "properties": { "handed": { "type": "array", "items": { "type": "string" } }, "already": { "type": "array", "items": { "type": "string" } }, "said": { "type": "string" } }
    },
    "invoke": {
     "kind": "container",
     "files": {
