    "maker": "maker:take-requests",
    "needs": { "expected_seconds": 1, "network_egress": false },
    "id": "tool:take-a-request",
    "listed_on": "2026-10-30T20:00:00Z",
    "label": "Take a request",
    "job": "Keep one request that arrived, as decided, and ask the owner who should act on it",
    "description": "request is what arrived: request_id, source_ref, atom_ref, text, origin_ref, optionally message_ref, content_revision and at. Its origin_ref must be one the person accepts (an intake-origins record with id intake-origins:accepted). decision is the caller's: disposition and reason, and hand_to_owner true with owner_ref (an active intake-owner record) and acceptance_criteria when an owner should act; hand_off, required when hand_to_owner is true, names what the owner is asked to run (action_ref or action_refs, optional id, input and copy rows). existing_task_ref is refused (current_task_executor_not_verified): a task reference says nothing about who runs it now. max_text_chars (default 65536) bounds the kept text: a longer text is kept cut to it, or, when it is being handed to an owner, held back. Returns { status, request_id, problems, owner_request, said }. status is handed, recorded, deferred (nothing is kept because the owner is not on file or the text is too long; take it again once fixed), already-taken (the same request again changes nothing) or refused (no accepted origins on file, incomplete, origin not accepted, a decision that names an existing task, or the same id from another source, message, place or version).",
    "input_schema": {
     "type": "object",
     "required": ["request", "decision"],
     "additionalProperties": false,
     "properties": {
      "request": {
       "type": "object",
       "required": ["request_id", "source_ref", "atom_ref", "text", "origin_ref"],
       "additionalProperties": false,
       "properties": {
        "request_id": { "type": "string", "minLength": 1 },
        "source_ref": { "type": "string", "minLength": 1 },
        "atom_ref": { "type": "string", "minLength": 1 },
        "text": { "type": "string", "minLength": 1 },
        "origin_ref": { "type": "string", "minLength": 1 },
        "message_ref": { "type": "string" },
        "content_revision": { "type": "string" },
        "at": { "type": "string" }
       }
      },
      "decision": {
       "type": "object",
       "required": ["disposition", "reason"],
       "additionalProperties": false,
       "properties": {
        "disposition": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 },
        "hand_to_owner": { "type": "boolean" },
        "owner_ref": { "type": "string" },
        "acceptance_criteria": { "type": "string" },
        "existing_task_ref": { "type": "string" }
       }
      },
      "hand_off": {
       "type": "object",
       "description": "What the owner is asked to run. Required when decision.hand_to_owner is true: give action_ref, or action_refs.",
       "additionalProperties": false,
       "properties": {
        "id": { "type": "string" },
        "action_ref": { "type": "string" },
        "action_refs": { "type": "array", "items": { "type": "string" } },
        "input": { "type": "object" },
        "copy": { "type": "array", "items": { "type": "object", "required": ["key"], "properties": { "key": { "type": "string" }, "from": { "type": "string" }, "value": {} } } }
       }
      },
      "max_text_chars": { "type": "integer", "minimum": 1, "description": "The most characters of the request's text to keep (default 65536)" }
     }
    },
    "output_schema": {
     "type": "object",
     "required": ["status", "problems", "said"],
     "properties": {
      "status": { "type": "string", "enum": ["handed", "recorded", "deferred", "already-taken", "refused"] },
      "request_id": { "type": ["string", "null"] },
      "problems": { "type": "array", "items": { "type": "object", "required": ["code", "said"], "properties": { "code": { "type": "string" }, "said": { "type": "string" } } } },
      "owner_request": { "type": ["string", "null"] },
      "said": { "type": "string" }
     }
    },
    "invoke": {
     "kind": "container",
     "files": {
      "package_files": [
       { "package": "take-requests", "paths": ["read-data"], "at": "/opt/take-requests" },
       { "package": "records-door", "paths": ["do-work", "read-data"], "at": "/opt/records-door" },
       {"package": "content-identity", "paths": ["read-data"], "at": "/opt/content-identity"},
       {"module": "@noble/hashes", "paths": ["LICENSE", "package.json", "blake3.js", "blake2.js", "_blake.js", "_md.js", "_u64.js", "utils.js"], "at": "/opt/node_modules/@noble/hashes"}
      ]
     },
     "workdir": "/opt/take-requests",
     "internet": false,
     "stdout": "json",
     "argv": ["node", "/opt/records-door/do-work/run-an-export.mjs", "/opt/take-requests/read-data/requests.mjs", "takeARequest"],
     "stdin": { "fill": { "from": "input" } },
     "records": { "fd": 3, "rights": [
      { "kind": "intake-origins", "operations": ["records:read"] },
      { "kind": "intake-owner", "operations": ["records:read"] },
      { "kind": "intake-request", "operations": ["records:read", "records:write"] },
      { "kind": "owner-action-request", "operations": ["records:read", "records:write"] }
     ] }
    },
    "provenance": { "source": "bitfield-packages request-intake do-work/request-intake-actions.ts decideSourceMessageIntake (whole request, accepted origin, same id from one source, owner on file, one hand-off), ported to the records door with the origin list, owners and action in the person's records" },
    "verify": [{ "kind": "sample-run", "input": { "request": { "request_id": "request-1", "source_ref": "source-1", "atom_ref": "atom-1", "text": "Two loaves for Friday.", "origin_ref": "origin-1" }, "decision": { "disposition": "recorded", "reason": "A customer asked." } }, "output_selector": "$.request_id", "contains": "request-1" }],
    "result_selector": "$.result"
   }
  },
  {
