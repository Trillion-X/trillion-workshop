     "internet": false,
     "stdout": "json",
     "argv": ["node", "/opt/records-door/do-work/run-an-export.mjs", "/opt/take-requests/read-data/requests.mjs", "handARequestToItsOwner"],
     "stdin": { "fill": { "from": "input" } },
     "records": { "fd": 3, "rights": [{ "kind": "owner-action-request", "operations": ["records:read", "records:write"] }] }
    },
    "provenance": { "source": "bitfield-packages request-intake do-work/request-intake-actions.ts buildRequestIntakeActionRequests (action input, answers and copy rows into one request per definition), ported to owner-action-request records in the records door" },
    "verify": [{ "kind": "sample-run", "input": { "action": { "owner": "owner-1", "action_ref": "action-1" }, "context": { "operation_id": "operation-1" } }, "output_selector": "$.said", "contains": "owner-1" }],
