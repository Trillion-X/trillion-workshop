        "package": "content-identity",
        "paths": [
         "read-data"
        ],
        "at": "/opt/content-identity"
       },
       {
        "packages": ["node_modules/@noble/hashes"],
        "paths": [
         "LICENSE",
         "package.json",
         "blake3.js",
         "blake2.js",
         "_blake.js",
         "_md.js",
         "_u64.js",
         "utils.js"
        ],
        "at": "/opt/node_modules/@noble/hashes"
       },
       {
        "package": "browse-and-upload-my-files",
        "paths": [
         "built-stored-bytes/content-chunks/content_chunks.js",
         "do-work/content-chunks.mjs",
         "do-work/namespace-client.mjs",
         "do-work/send-a-file-to-a-namespace.mjs",
         "do-work/send-retry.mjs",
         "do-work/send-window.mjs",
         "do-work/shared-file-reference.mjs",
         "send-settings.json"
        ],
        "at": "/opt/browse-and-upload-my-files"
       }
      ]
     },
     "workdir": "/opt/take-requests",
     "internet": false,
     "stdout": "json",
     "argv": ["node", "/opt/records-door/do-work/run-an-export.mjs", "/opt/take-requests/read-data/requests.mjs", "takeARequest"],
     "stdin": { "fill": { "from": "input" } }
    },
    "provenance": { "source": "bitfield-packages request-intake do-work/request-intake-actions.ts decideSourceMessageIntake (whole request, accepted origin, same id from one source, owner on file, one hand-off), ported as pure rows that take the origin list, owners and action the caller reads from the person's own store as records" },
    "verify": [{ "kind": "sample-run", "input": { "request": { "request_id": "request-1", "source_ref": "source-1", "atom_ref": "atom-1", "text": "Two loaves for Friday.", "origin_ref": "origin-1" }, "decision": { "disposition": "recorded", "reason": "A customer asked." } }, "output_selector": "$.request_id", "contains": "request-1" }],
    "result_selector": "$.result"
   }
