{
 "kind": "tool-rows",
 "record_set": "take-requests-tool-rows",
 "what_this_is": "The Workshop rows for taking requests, in tools/take-requests: each kept as a record, handed to the owner who can act on it and closed by the owner's receipt, in the person's own records through the run's records door.",
 "records": [
  {
   "id": "package::take-requests::tool::take-a-request",
