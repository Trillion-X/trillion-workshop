              "type": "object"
            },
            "body": {},
            "browser": {
              "type": "object"
            },
            "stored": {
              "type": "object",
              "description": "What this run reads of the person's own things, read by the caller from where the person keeps them (the route keeps no database) and given here: records: [{id, type, value}] of message and message-source-key, as the caller read them, newest first; file_identities: [identity] of the person's own files a message may name. What is not given is not there."
            }
          }
