{
  "_required_check": "How the deploy treats a required secret that is not bound: 'report' prints it and goes on; 'enforce' refuses the upload (after three tries to read the list). Report first, so a failing list call from the build cannot stop deploys; enforce once a real build log shows the list working.",
  "forms": {
    "root_key": {
      "pattern": "^(?:\\d+:)?[0-9a-fA-F]{64}$",
      "says": "a 64-hex key, optionally after its generation and a colon"
    },
    "hex_key": {
      "pattern": "^[0-9a-fA-F]{64}$",
      "says": "64 hex characters"
    },
    "token": {
      "pattern": "^\\S{8,}$",
      "says": "one word of at least 8 characters"
    },
    "json": {
      "json": true,
      "says": "JSON"
    },
    "stripe_key": {
      "pattern": "^(sk|rk)_(live|test)_[0-9A-Za-z]{16,}$",
      "says": "a Stripe secret or restricted key (sk_ or rk_, live or test)"
    }
  },
  "secrets": [
    {
      "name": "HELD_VALUES_ROOT_KEY",
      "form": "root_key"
    },
    {
      "name": "HELD_VALUES_ROOT_KEY_ALTERNATE",
      "form": "root_key"
    },
    {
      "name": "PHONE_INDEX_KEY",
      "form": "hex_key"
    },
    {
      "name": "SHARE_MATCH_KEY",
      "form": "hex_key"
    },
    {
      "name": "SMS_TWILIO_AUTH_TOKEN",
      "form": "token"
    },
    {
      "name": "SETUP_KEY_HASH",
      "form": "hex_key"
    },
    {
      "name": "TRILLION_PUSH_KEY",
      "form": "json"
    },
    {
      "name": "TRILLION_APNS_KEY",
      "form": "json"
    },
    {
      "name": "TRILLION_STRIPE_KEY",
      "form": "stripe_key"
    },
    {
      "name": "CLOUDFLARE_ANALYTICS_TOKEN",
      "form": "token"
    },
    {
      "name": "CLOUDFLARE_STREAM_TOKEN",
      "form": "token"
    },
    {
      "name": "CLOUDFLARE_BUILDS_TOKEN",
      "form": "token"
    },
    {
      "name": "NATIVE_KEY_DERIVATION_ROOT",
      "form": "hex_key",
      "required": true
    },
    {
      "name": "SERVICE_ACTOR_DERIVATION_ROOT",
      "form": "hex_key",
      "required": true
    }
  ],
  "required_check": "report"
}
