// Capture exclusion categories with cursor diffs, and two-tier capture dedupe (computer/capture-exclusion.mjs, computer/capture-dedupe.mjs).
import assert from 'node:assert/strict';
import test from 'node:test';
import { applyDiff, categoriesOn, domainsIn, domainsOf, exclusionSettings, excluded } from '../computer/capture-exclusion.mjs';
import { createDedupe, dedupeSettings, distance, simhash } from '../computer/capture-dedupe.mjs';

const settings = exclusionSettings();
const empty = { cursor: 0, added: {}, removed: [] };

test('the person choice beats the default, subdomains count, look-alikes do not', () => {
  assert.deepEqual(categoriesOn(settings, {}), ['adult-content', 'banking-finance']);
  assert.deepEqual(categoriesOn(settings, { 'banking-finance': false, social: true }), ['adult-content', 'social']);
  assert.equal(excluded(settings, empty, {}, 'https://secure.chase.com/login'), 'banking-finance');
  assert.equal(excluded(settings, empty, {}, 'chase.com'), 'banking-finance');
  assert.equal(excluded(settings, empty, {}, 'https://notchase.com'), null);
  assert.equal(excluded(settings, empty, {}, 'https://www.reddit.com/r/x'), null, 'social is not on by default');
  assert.equal(excluded(settings, empty, { social: true }, 'https://www.reddit.com/r/x'), 'social');
  assert.equal(excluded(settings, empty, {}, '::::'), null);
  assert.ok(domainsOf(settings, empty, {}).includes('paypal.com'));
});

test('a diff must start at the cursor, adds new domains, tombstones outlive the seed, and a re-added domain returns', () => {
  const one = applyDiff(settings, empty, { from: 0, to: 5, add: [{ domain: 'New-Bank.example', category: 'banking-finance' }], remove: ['paypal.com'] });
  assert.equal(one.cursor, 5);
  assert.equal(excluded(settings, one, {}, 'https://login.new-bank.example'), 'banking-finance');
  assert.equal(excluded(settings, one, {}, 'https://paypal.com'), null, 'the tombstone beats the seed');
  assert.throws(() => applyDiff(settings, one, { from: 0, to: 6 }), { status: 409 });
  assert.throws(() => applyDiff(settings, one, { from: 5, to: 6, add: [{ domain: 'a.example', category: 'nope' }] }), /no category nope/);
  const back = applyDiff(settings, one, { from: 5, to: 9, add: [{ domain: 'paypal.com', category: 'banking-finance' }] });
  assert.equal(excluded(settings, back, {}, 'https://paypal.com'), 'banking-finance');
  assert.equal(domainsIn(settings, back, 'banking-finance').filter(d => d === 'paypal.com').length, 1);
});

const page = 'Quarterly report for the finance team with revenue costs and the plan for the next three quarters of the year';

test('the exact tier catches the same text, the near tier a lightly changed one, a different text and a short one pass, and erasing a span forgets it', () => {
  const dedupe = createDedupe(dedupeSettings());
  assert.deepEqual(dedupe.seen(page, 1000), { duplicate: false });
  assert.equal(dedupe.seen(`  ${page.toUpperCase()}  `, 2000).duplicate, 'exact');
  assert.equal(dedupe.seen(`${page} today`, 3000).duplicate, 'near');
  assert.equal(dedupe.seen('Completely different words appear on this other screen about travel plans to the coast next summer', 4000).duplicate, false);
  assert.equal(dedupe.seen('Save', 5000).duplicate, false);
  assert.equal(dedupe.seen('Cancel', 6000).duplicate, false, 'short texts are never near each other');
  assert.equal(dedupe.erase(900, 2500), 1);
  assert.deepEqual(dedupe.seen(page, 7000), { duplicate: false }, 'an erased capture no longer hides a later one');
  const aged = createDedupe({ ...dedupeSettings(), remember_seconds: 1 });
  aged.seen(page, 0); assert.equal(aged.seen(page, 5000).duplicate, false);
  const bounded = createDedupe({ ...dedupeSettings(), most_entries: 2 });
  ['alpha one two three four five six seven eight', 'beta one two three four five six seven eight nine', 'gamma ten eleven twelve thirteen fourteen fifteen sixteen'].forEach((t, i) => bounded.seen(t, i));
  assert.equal(bounded.size(), 2);
  assert.ok(distance(simhash(page), simhash(`${page} today`)) <= 6);
  assert.ok(distance(simhash(page), simhash('Completely different words appear on this other screen about travel plans')) > 10);
});

test('the memory survives a restart as plain JSON', () => {
  const first = createDedupe(dedupeSettings());
  first.seen(page, 1000);
  const second = createDedupe(dedupeSettings(), JSON.parse(JSON.stringify(first.entries())));
  assert.equal(second.seen(`${page} today`, 2000).duplicate, 'near');
  assert.equal(second.seen(page, 3000).duplicate, 'exact');
});
