  {
   "id": "package::trillion::tool::govee-set-colour",
   "address": "package::trillion::tool::govee-set-colour",
   "path": [
    "current-item",
    "published-record"
   ],
   "payload": {
    "kind": "ai-tool-descriptor",
    "status": "active",
    "licence_class": "licence:maker-own",
    "maker": "maker:trillion",
    "listed_on": "2026-10-04T13:00:00Z",
    "id": "tool:govee-set-colour",
    "label": "Set a Govee light's colour",
    "job": "Set one Govee light or LED strip to a colour",
    "description": "Sets one Govee device (its sku and device id from List Govee lights) to a colour given as a number: red times 65536 plus green times 256 plus blue. Govee allows about 10 changes a minute per device.",
    "placements": [
     "placement:public-web-address"
    ],
    "needs": {
     "expected_seconds": 2,
     "network_egress": true
    },
    "input_schema": {
     "type": "object",
     "required": [
      "sku",
      "device",
      "rgb"
     ],
     "additionalProperties": false,
     "properties": {
      "sku": {
       "type": "string"
      },
      "device": {
       "type": "string",
       "x-free-text-because": "The device id Govee itself gives each light, read from the connected Govee account, not a row of a list."
      },
      "rgb": {
       "type": "integer",
       "minimum": 0,
       "maximum": 16777215
      }
     }
    },
    "output_schema": {
     "type": "object"
    },
    "invoke": {
     "kind": "http",
     "connection": "package::service-connections::published-record::govee",
     "connection_id": "service_connection:govee",
     "url": "https://openapi.api.govee.com/router/api/v1/device/control",
     "method": "POST",
     "timeout_ms": 15000,
     "credential_injections": [
      {
       "field_id": "api_key",
       "placement": {
        "kind": "header",
        "name": "Govee-API-Key",
        "prefix": "",
        "suffix": ""
       }
      }
     ],
     "body": {
      "requestId": "trillion",
      "payload": {
       "sku": "{sku}",
       "device": "{device}",
       "capability": {
        "type": "devices.capabilities.color_setting",
        "instance": "colorRgb",
        "value": {
         "from": "rgb"
        }
       }
      }
     }
    },
    "runs_quietly": true
   }
  },
