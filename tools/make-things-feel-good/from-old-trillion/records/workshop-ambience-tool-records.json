{
 "kind": "package-set-records",
 "package_set": "trillion",
 "record_set": "workshop-ambience-tool-records",
 "what_this_is": "Ambience as Workshop tools: the web rows that read what is playing (Spotify, Last.fm) and set connected lights (LIFX, Govee) on the person's own connections. The Ambience screen itself (parts/ambience) is a screen row in workshop-screen-tool-records.json. Rows marked runs_quietly are sent by a light following the sound through POST /work/api/workshop/send-quietly/<id>, which keeps no run for each send.",
 "records": [
  {
   "id": "package::trillion::tool::lifx-set-lights",
   "address": "package::trillion::tool::lifx-set-lights",
   "path": [
    "current-item",
    "published-record"
   ],
   "payload": {
    "kind": "ai-tool-descriptor",
    "status": "active",
    "licence_class": "licence:maker-own",
    "maker": "maker:trillion",
    "listed_on": "2026-10-04T13:00:00Z",
    "id": "tool:lifx-set-lights",
    "label": "Set LIFX lights",
    "job": "Turn LIFX lights on and set their colour and brightness",
    "description": "Sets the state of the LIFX lights the selector names ('all', 'label:Desk', 'group:Living Room', 'id:d073d5...') on the person's LIFX account: colour as #rrggbb or any LIFX colour words, brightness 0 to 1, over duration seconds. LIFX allows 120 changes a minute. Runs quietly when a light follows the sound.",
    "placements": [
     "placement:public-web-address"
    ],
    "needs": {
     "expected_seconds": 2,
     "network_egress": true
    },
    "input_schema": {
     "type": "object",
     "required": [
      "selector"
     ],
     "additionalProperties": false,
     "properties": {
      "selector": {
       "type": "string",
       "description": "Which lights: all, label:<name>, group:<name> or id:<id>"
      },
      "color": {
       "type": "string",
       "description": "#rrggbb or LIFX colour words"
      },
      "brightness": {
       "type": "number",
       "minimum": 0,
       "maximum": 1
      },
      "duration": {
       "type": "number",
       "minimum": 0,
       "description": "Seconds the change takes"
      },
      "power": {
       "type": "string",
       "enum": [
        "on",
        "off"
       ]
      }
     }
    },
    "output_schema": {
     "type": "object"
    },
    "invoke": {
     "kind": "http",
     "connection": "package::service-connections::published-record::lifx",
     "connection_id": "service_connection:lifx",
     "url": "https://api.lifx.com/v1/lights/{selector}/state",
     "method": "PUT",
     "timeout_ms": 15000,
     "credential_injections": [
      {
       "field_id": "api_token",
       "placement": {
        "kind": "header",
        "name": "Authorization",
        "prefix": "Bearer ",
        "suffix": ""
       }
      }
     ],
     "body": {
      "power": {
       "from": "power",
       "otherwise": "on"
      },
      "color": {
       "from": "color",
       "optional": true
      },
      "brightness": {
       "from": "brightness",
       "optional": true
      },
      "duration": {
       "from": "duration",
       "optional": true
      },
      "fast": true
     }
    },
    "runs_quietly": true
   }
  },
