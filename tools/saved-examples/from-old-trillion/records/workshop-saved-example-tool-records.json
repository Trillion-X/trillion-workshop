      }
    },
    {
      "id": "package::trillion::tool::remove-a-saved-example",
      "address": "package::trillion::tool::remove-a-saved-example",
      "path": [
        "current-item",
        "published-record"
      ],
      "payload": {
        "kind": "ai-tool-descriptor",
        "status": "active",
        "licence_class": "licence:maker-own",
        "placements": [
          "placement:this-account"
        ],
        "maker": "maker:trillion",
        "id": "tool:remove-a-saved-example",
        "listed_on": "2026-09-30T07:12:34Z",
        "label": "Remove a saved example",
        "job": "Remove one saved example this person no longer wants",
        "description": "id is the example's id from tool:list-saved-examples. Returns { id, removed: true }.",
        "needs": {
          "expected_seconds": 1,
          "network_egress": false
        },
        "input_schema": {
          "type": "object",
          "required": [
            "id"
          ],
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^example:[0-9a-f]{32}$",
