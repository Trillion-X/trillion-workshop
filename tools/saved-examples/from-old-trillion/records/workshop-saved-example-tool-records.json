{
  "kind": "package-set-records",
  "package_set": "trillion",
  "record_set": "workshop-saved-example-tool-records",
  "what_this_is": "Saved examples as Workshop tools that run inside the person's own store (placement:this-account; src/saved-examples.mjs through src/person-store.mjs accountActions): keep a post, video or page that worked with its link, words, pictures and why it worked, list them, and remove one. The list tool's screen is the Saved examples screen (entry saved-examples, src/workspace/saved-examples-screen.tsx). A share sent with an action in records/share-destination-starters.json saved_example_actions keeps its links through the same owner. Nothing is kept for an account until something is saved.",
  "records": [
    {
      "id": "package::trillion::tool::save-an-example",
      "address": "package::trillion::tool::save-an-example",
      "path": [
        "current-item",
        "published-record"
      ],
      "payload": {
        "kind": "ai-tool-descriptor",
        "status": "active",
        "licence_class": "licence:maker-own",
        "placements": [
          "placement:this-account"
        ],
        "maker": "maker:trillion",
        "id": "tool:save-an-example",
        "listed_on": "2026-09-30T07:12:34Z",
        "label": "Save an example that worked",
        "job": "Keep a post, video or page someone else made that worked, with its link, words, pictures and why it worked, so this person can make their own in the same shape",
        "description": "Give url and anything you know: title, words (what it says, in its own words), pictures (picture addresses), why_it_worked (what made it work: its hook, structure, pacing, visuals, numbers) and collection. What you leave out is read from the link itself. The same link saved again is the same example: what you give fills it in, what you leave out stays as it was. Returns the example.",
        "needs": {
          "expected_seconds": 6,
          "network_egress": true
        },
        "input_schema": {
          "type": "object",
          "required": [
            "url"
          ],
          "additionalProperties": false,
          "properties": {
            "url": {
              "type": "string",
              "format": "uri",
              "title": "Link",
              "description": "The address of the post, video or page."
            },
            "title": {
              "type": "string",
              "maxLength": 500,
              "title": "Title"
            },
            "words": {
              "type": "string",
              "maxLength": 20000,
              "title": "Its words",
              "description": "What it says: the caption, the post text or what is said in the video."
            },
            "pictures": {
              "type": "array",
              "maxItems": 20,
              "items": {
                "type": "string",
                "format": "uri"
              },
              "title": "Pictures",
              "description": "Addresses of its pictures."
            },
            "why_it_worked": {
              "type": "string",
              "maxLength": 4000,
              "title": "Why it worked"
            },
            "collection": {
              "type": "string",
              "maxLength": 200,
              "title": "Collection"
            }
          }
        },
        "output_schema": {
          "type": "object",
          "required": [
            "id",
            "url",
            "host",
            "pictures",
            "added_at"
          ],
          "properties": {
            "id": {
              "type": "string"
            },
            "url": {
              "type": "string"
            },
            "host": {
              "type": "string"
            },
            "site": {
              "type": [
                "string",
                "null"
              ]
            },
            "title": {
              "type": [
                "string",
                "null"
              ]
            },
            "words": {
              "type": [
                "string",
                "null"
              ]
            },
            "pictures": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "why_it_worked": {
              "type": [
                "string",
                "null"
              ]
            },
            "collection": {
              "type": [
                "string",
                "null"
              ]
            },
            "added_from": {
              "type": "string"
            },
            "added_at": {
              "type": "string"
            },
            "updated_at": {
              "type": "string"
            }
          }
        },
        "invoke": {
          "kind": "account-action",
          "action": "save-an-example"
        },
        "provenance": {
          "source": "src/saved-examples.mjs, reading links through src/read-link.mjs; ported from the Mac media workspace's saved examples"
        },
        "verify": [
          {
            "kind": "output-contains-input",
            "output_selector": "$.url",
            "input_field": "url"
          }
        ]
      }
    },
    {
