  "worked_examples": [
    {
      "title": "Check a move to another stage on a sample input",
      "ask": "Run tool:check-a-stage-move.",
      "mcp": {
        "server": "trillion",
        "tool": "run_resource_operation",
        "input": {
          "address": "@workshop-tools",
          "method": "tools:run",
          "input": {
            "tool": "tool:check-a-stage-move",
            "input": {
              "stages": [
                {
                  "key": "lead",
                  "label": "Lead"
                },
                {
                  "key": "call-booked",
                  "label": "Call booked"
                },
                {
                  "key": "proposal",
                  "label": "Proposal sent"
                },
                {
                  "key": "won",
                  "label": "Won",
                  "terminal": true
                },
                {
                  "key": "lost",
                  "label": "Lost",
                  "terminal": true
                }
              ],
              "transitions": [
                {
                  "from": "lead",
                  "to": "call-booked"
                },
                {
                  "from": "lead",
                  "to": "lost"
                },
                {
                  "from": "call-booked",
                  "to": "proposal"
                },
                {
                  "from": "call-booked",
                  "to": "lost"
                },
                {
                  "from": "proposal",
                  "to": "won",
                  "when": {
                    "equals": {
                      "signal": "paid",
                      "value": true
                    }
                  }
                },
                {
                  "from": "proposal",
                  "to": "lost"
                }
              ],
              "start": "lead",
              "moves": [
                {
                  "from": "lead",
                  "to": "call-booked",
                  "at": "2026-09-20T10:00:00Z"
                }
              ],
              "to": "proposal",
              "at": "2026-09-27T10:00:00Z",
              "because": "Call went well"
            }
          }
        }
      },
      "hands_back": "The answer's $.requested.move.to contains \"proposal\"."
    }
  ]
