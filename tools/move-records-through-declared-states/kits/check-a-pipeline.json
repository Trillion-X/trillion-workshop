  "worked_examples": [
    {
      "title": "Check a pipeline's stages for mistakes on a sample input",
      "ask": "Run tool:check-a-pipeline.",
      "mcp": {
        "server": "trillion",
        "tool": "run_resource_operation",
        "input": {
          "address": "@workshop-tools",
          "method": "tools:run",
          "input": {
            "tool": "tool:check-a-pipeline",
            "input": {
              "stages": [
                {
                  "key": "lead",
                  "label": "Lead"
                },
                {
                  "key": "call-booked",
                  "label": "Call booked"
                },
                {
                  "key": "proposal",
                  "label": "Proposal sent"
                },
                {
                  "key": "won",
                  "label": "Won",
                  "terminal": true
                },
                {
                  "key": "lost",
                  "label": "Lost",
                  "terminal": true
                },
                {
                  "key": "archived",
                  "label": "Archived"
                }
              ],
              "transitions": [
                {
                  "from": "lead",
                  "to": "call-booked"
                },
                {
                  "from": "lead",
                  "to": "lost"
                },
                {
                  "from": "call-booked",
                  "to": "proposal"
                },
                {
                  "from": "call-booked",
                  "to": "lost"
                },
                {
                  "from": "proposal",
                  "to": "won",
                  "when": {
                    "equals": {
                      "signal": "paid",
                      "value": true
                    }
                  }
                },
                {
                  "from": "proposal",
                  "to": "lost"
                }
              ],
              "start": "lead"
            }
          }
        }
      },
      "hands_back": "The answer's $.problems contains \"archived\"."
    }
  ]
