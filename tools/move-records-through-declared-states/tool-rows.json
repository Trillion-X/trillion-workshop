    "kind": "ai-tool-descriptor",
    "id": "tool:check-a-pipeline",
    "label": "Check a pipeline's stages for mistakes",
    "status": "active",
    "job": "Check a sales pipeline or any set of stages for mistakes: stages nothing can reach, a way out of a finished stage, or a move to a stage that does not exist",
    "description": "Give the stages, the moves allowed between them and the start stage. Returns sound (true when there is nothing wrong), each problem in words, and which stages are and are not reachable from the start.",
    "input_schema": {
     "type": "object",
     "required": [
      "stages",
      "transitions",
      "start"
     ],
     "additionalProperties": false,
     "properties": {
      "stages": {
       "type": "array",
       "items": {
        "type": "object",
        "required": [
         "key"
        ],
        "properties": {
         "key": {
          "type": "string",
          "description": "The stage's own key"
         },
         "label": {
          "type": "string",
          "description": "Its name"
         },
         "terminal": {
          "type": "boolean",
          "description": "True for a finished stage (won, lost) nothing moves out of"
         }
        }
       },
       "minItems": 1,
       "description": "Every stage, once each"
      },
      "transitions": {
       "type": "array",
       "items": {
        "type": "object",
        "required": [
         "from",
         "to"
        ],
        "properties": {
         "from": {
          "type": "string"
         },
         "to": {
          "type": "string"
         },
         "when": {
          "type": "object",
          "description": "Optional: when the move is open, a rule group of the formula engine over the signals: {\"kind\":\"group\",\"combinator\":\"and\",\"negate\":false,\"rules\":[{\"kind\":\"rule\",\"field\":\"<signal>\",\"operator\":\"equals | at_least | at_most | is_unknown | ...\",\"params\":{\"value\":...}}]}"
         }
        }
       },
       "description": "The moves allowed between stages"
      },
      "start": {
       "type": "string",
       "description": "The stage every record starts in"
      }
     }
    },
    "output_schema": {
     "type": "object",
     "required": [
      "sound",
      "problems",
      "reachable",
      "unreachable"
     ],
     "properties": {
      "sound": {
       "type": "boolean"
      },
      "problems": {
       "type": "array",
       "items": {
        "type": "string"
       }
      },
      "reachable": {
       "type": "array",
       "items": {
        "type": "string"
       }
      },
      "unreachable": {
       "type": "array",
       "items": {
        "type": "string"
       }
      }
     }
    },
    "invoke": {
     "kind": "container",
     "files": {
      "package_files": [
       {
        "package": "move-records-through-declared-states",
        "paths": [
         "do-work"
        ],
        "at": "/opt/move-records-through-declared-states",
        "exclude": [
         "__tests__"
        ]
       },
       {
        "package": "formula-engine",
        "paths": [
         "rules",
         "built-stored-bytes/formula-engine"
        ],
        "at": "/opt/node_modules/trillion-workshop/tools/formula-engine"
       }
      ]
     },
     "workdir": "/opt/move-records-through-declared-states",
     "internet": false,
     "stdout": "json",
     "argv": [
      "node",
      "do-work/check-a-pipeline.mjs"
     ],
     "stdin": {
      "fill": {
       "from": "input"
      }
     }
    },
    "result_selector": "$",
    "needs": {
     "expected_seconds": 20,
     "network_egress": false,
     "memory_mb": 256
    },
    "licence_class": "licence:maker-own",
    "placements": [
     "placement:small-container"
    ],
    "maker": "maker:move-records-through-declared-states",
    "provenance": {
     "source": "bitfield-packages packages/move-records-through-declared-states"
    },
    "verify": [
     {
      "kind": "sample-run",
      "input": {
       "stages": [
        {
         "key": "lead",
         "label": "Lead"
        },
        {
         "key": "call-booked",
         "label": "Call booked"
        },
        {
         "key": "proposal",
         "label": "Proposal sent"
        },
        {
         "key": "won",
         "label": "Won",
         "terminal": true
        },
        {
         "key": "lost",
         "label": "Lost",
         "terminal": true
        },
        {
         "key": "archived",
         "label": "Archived"
        }
       ],
       "transitions": [
        {
         "from": "lead",
         "to": "call-booked"
        },
        {
         "from": "lead",
         "to": "lost"
        },
        {
         "from": "call-booked",
         "to": "proposal"
        },
        {
         "from": "call-booked",
         "to": "lost"
        },
        {
         "from": "proposal",
         "to": "won",
         "when": {
          "kind": "group",
          "combinator": "and",
          "negate": false,
          "rules": [
           {
            "kind": "rule",
            "field": "paid",
            "operator": "equals",
            "params": {
             "value": true
            }
           }
          ]
         }
        },
        {
         "from": "proposal",
         "to": "lost"
        }
       ],
       "start": "lead"
      },
      "output_selector": "$.problems",
      "contains": "archived"
     }
    ]
   }
  }
 ]
