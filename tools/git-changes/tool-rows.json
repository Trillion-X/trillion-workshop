    "id": "tool:see-changes-in-a-project",
    "placements": [
     "placement:your-computer"
    ],
    "needs": {
     "expected_seconds": 5,
     "network_egress": false
    },
    "label": "See what changed in a project",
    "job": "See every file that changed in a project on the person's computer and where each one stands: staged for the next commit, changed but not staged, or new",
    "description": "Give folder, the full path of a project folder the person has let this tool use. Returns the branch, how many commits it is ahead of and behind its upstream, and one row per changed file per place it stands (bucket staged, unstaged or untracked, with git's one-letter status). Changes nothing.",
    "input_schema": {
     "type": "object",
     "required": [
      "folder"
     ],
     "additionalProperties": false,
     "properties": {
      "folder": {
       "type": "string",
       "minLength": 1,
       "description": "The full path of the project folder."
      }
     }
    },
    "output_schema": {
     "type": "object",
     "required": [
      "folder",
      "branch",
      "ahead",
      "behind",
      "changes"
     ],
     "properties": {
      "folder": {
       "type": "string"
      },
      "branch": {
       "type": "string"
      },
      "ahead": {
       "type": "integer"
      },
      "behind": {
       "type": "integer"
      },
      "changes": {
       "type": "array",
       "items": {
        "type": "object",
        "required": [
         "file_path",
         "bucket",
         "status"
        ],
        "properties": {
         "file_path": {
          "type": "string"
         },
         "bucket": {
          "type": "string",
          "enum": [
           "staged",
           "unstaged",
           "untracked"
          ]
         },
         "status": {
          "type": "string"
         }
        }
       }
      }
     }
    },
    "invoke": {
     "kind": "computer",
     "capabilities": [
      "use-git-in-a-folder"
     ],
     "workdir": "/opt/git-changes",
     "stdout": "json",
     "argv": [
      "node",
      "/opt/records-door/do-work/run-an-export.mjs",
      "/opt/git-changes/read-data/git-changes.mjs",
      "seeChangesInAProject"
     ],
     "stdin": {
      "fill": {
       "from": "input"
      }
     },
     "files": {
      "package_files": [
       {
        "package": "git-changes",
        "paths": [
         "read-data"
        ],
        "at": "/opt/git-changes"
       },
       {
        "package": "records-door",
        "paths": [
         "do-work",
         "read-data"
        ],
        "at": "/opt/records-door"
       }
      ]
     }
    },
    "result_selector": "$.result.result",
    "provenance": {
     "source": "bitfield-packages packages/git-worktree (refresh-git-worktree)"
    }
   }
