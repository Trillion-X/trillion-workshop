{
  "_what": "Where the work map reads each kind of record and how the kinds hang together (read-data/join-records.mjs). Each source: read (the answer it comes from and the path of its rows in it), kind (the word shown on its cards), icon (its mark when no face or app stands for it), fields (paths to the row's id, title, detail, state and time; the first path that has a value wins), who (fields naming who does it, each with the source that one is in; the first found wins), each (a path in each row whose every value is a row of its own, { value, of }), parents (fields naming the rows it hangs under, in order) otherwise (\"who\": a row with no parent shown hangs under whoever does it) opens (the screen a row opens on, and which of its fields that screen is given) and start_from (a row of this kind can be the one the map starts from, chosen above it or opened with { goal: <id> }). Paths are lists of keys; \"*\" takes every item of a list. A new kind of record on the map is one row here.",
  "root": {"id": "root", "icon": "Network", "kind": "Everything", "title": "Everything being worked on"},
  "reads": {"goals": "/work/api/decisions", "work": "/work/api/ai-work", "spaces": "/work/api/spaces", "automations": "/work/api/workflows", "workshop": "/work/api/workshop"},
  "sources": [
    {"id": "goal", "icon": "Target", "start_from": true, "read": {"answer": "goals", "path": ["pursuits"]}, "kind": "Goal", "fields": {"id": ["id"], "title": [["title"]], "detail": [["now"], ["after"]], "status": [["status"]], "at": [["recorded_at"]]}, "parents": [{"path": ["parents"], "source": "goal"}], "opens": {"surface": "trillion.progress", "input": {"id": ["id"]}}},
    {"id": "decision", "icon": "Compass", "read": {"answer": "goals", "path": ["summaries"]}, "kind": "Decision", "fields": {"id": ["case_id"], "title": [["goal"]], "detail": [["decision"], ["next_action"]], "status": [["status"]], "at": [["created_at"]]}, "parents": [{"path": ["pursuits"], "key": ["id"], "source": "goal"}], "opens": {"surface": "trillion.decision", "input": {"id": ["case_id"]}}},
    {"id": "ai", "icon": "Bot", "read": {"answer": "work", "path": ["agents"]}, "kind": "AI", "fields": {"id": ["agent_id"], "title": [["name"]], "detail": [["model"], ["harness"], ["app"]], "status": [["capacity", "status"]], "at": [["last_seen_at"]]}, "opens": {"surface": "trillion.ai-work"}},
    {"id": "job", "icon": "CircleDot", "read": {"answer": "work", "path": ["work"]}, "kind": "Job", "fields": {"id": ["handoff_id"], "title": [["said"], ["job"]], "detail": [["in_the_way"], ["summary"]], "status": [["status"]], "at": [["finished_at"], ["taken_at"], ["handed_at"]]}, "who": [{"path": ["taken_by"], "source": "ai"}, {"path": ["to_agent"], "source": "ai"}], "parents": [{"path": ["parent_handoff_id"], "source": "job"}, {"path": ["case_id"], "source": "decision"}], "otherwise": "who", "opens": {"surface": "trillion.ai-work"}},
    {"id": "space", "icon": "Boxes", "read": {"answer": "spaces", "path": ["spaces"]}, "kind": "Space", "fields": {"id": ["space_id"], "title": [["title"]], "detail": [["description"]], "at": [["last_activity_at"]]}, "opens": {"surface": "trillion.space", "input": {"id": ["space_id"]}}},
    {"id": "person", "icon": "UserRound", "read": {"answer": "spaces", "path": ["spaces"]}, "kind": "Person", "fields": {"id": ["value"], "title": [["value"]]}, "parents": [{"path": ["of", "space_id"], "source": "space"}], "each": ["member_names"]},
    {"id": "automation", "icon": "CalendarClock", "read": {"answer": "automations", "path": ["automations"]}, "kind": "Automation", "fields": {"id": ["id"], "title": [["name"]], "detail": [["does"], ["when"]], "status": [["enabled"]], "at": [["next_run_at"], ["last_run_at"]]}, "status_values": {"true": "on", "false": "off"}, "status_default": "ready", "opens": {"surface": "trillion.workflow", "input": {"id": ["open_id"]}}},
    {"id": "tool-run", "icon": "Wrench", "read": {"answer": "workshop", "path": ["runs"]}, "kind": "Tool run", "fields": {"id": ["id"], "title": [["title"]], "detail": [["job"]], "status": [["state"]], "at": [["started_at"]]}, "opens": {"surface": "trillion.workshop-run", "input": {"id": ["id"]}}}
  ]
}
