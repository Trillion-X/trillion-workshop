        },
        "id": "tool:quote-untrusted-words",
        "listed_on": "2026-11-03T12:00:00Z",
        "label": "Quote a stranger's words safely",
        "job": "Make someone else's words safe to quote into what an AI reads, so hidden characters or a fake tag cannot sneak instructions in",
        "description": "Give text (another party's words: mail, an imported chat, a web page, a title) and, optionally, max (the most code points the quote may hold, ellipsis included; 8000 when left out). The text is normalised to NFC; control and format characters are removed (bidi overrides, zero-width characters, the byte order mark), except newline and tab; '<' and its full-width and angle-bracket lookalikes become '&lt;'; then it is cut by code points, never inside a surrogate pair or an escape, ending with an ellipsis. Returns quoted and code_points. Never give the person's own words: only the copy handed to an AI is quoted, the original is not changed.",
        "input_schema": {
          "type": "object",
          "required": [
            "text"
          ],
          "additionalProperties": false,
          "properties": {
            "text": {
              "type": "string"
            },
            "max": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "output_schema": {
          "type": "object",
          "required": [
            "quoted",
            "code_points"
          ],
          "properties": {
            "quoted": {
              "type": "string"
            },
            "code_points": {
              "type": "integer"
            }
          }
        },
        "invoke": {
          "kind": "container",
          "files": {
            "package_files": [
              {
                "package": "quote-untrusted-words",
                "paths": [
                  "read-data"
                ],
                "at": "/opt/quote-untrusted-words"
              },
              {
                "package": "records-door",
                "paths": [
                  "do-work",
                  "read-data"
                ],
                "at": "/opt/records-door"
              },
              {
                "package": "content-identity",
                "paths": [
                  "read-data"
                ],
                "at": "/opt/content-identity"
              },
              {
                "module": "@noble/hashes",
                "paths": [
                  "LICENSE",
                  "package.json",
                  "blake3.js",
                  "blake2.js",
                  "_blake.js",
                  "_md.js",
                  "_u64.js",
                  "utils.js"
                ],
                "at": "/opt/node_modules/@noble/hashes"
              }
            ]
          },
          "workdir": "/opt/quote-untrusted-words",
          "internet": false,
          "stdout": "json",
          "argv": [
