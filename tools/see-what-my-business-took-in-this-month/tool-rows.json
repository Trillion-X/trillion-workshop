    "kind": "ai-tool-descriptor",
    "id": "tool:stripe-events-read_money_since",
    "status": "active",
    "maker": "maker:see-what-my-business-took-in-this-month",
    "licence_class": "licence:maker-own",
    "label": "Read the money on my Stripe account since a moment",
    "job": "List the money that moved on this Stripe account since a moment, newest first, at most 100 entries",
    "description": "Lists what moved this Stripe account's balance at or after `since` (seconds since 1970, UTC), newest first, at most 100 entries: Stripe's own answer ({ data: [balance transactions, each with amount, fee and net in the currency's smallest unit, currency and reporting_category], has_more }), read with the Stripe account `connection` names (the person may hold more than one). Business's read (tool:read-business) sums it. Reads only.",
    "input_schema": {
     "type": "object",
     "required": [
      "since",
      "connection"
     ],
     "properties": {
      "since": {
       "type": "integer",
       "minimum": 0,
       "description": "The moment to list from, in seconds since 1970 (UTC)"
      },
      "connection": {
       "type": "object",
       "required": [
        "connection_id"
       ],
       "additionalProperties": true,
       "description": "The person's Stripe account to read, by its handle only",
       "properties": {
        "connection_id": {
         "type": "string",
         "description": "service_connection:stripe:<account>, as the person's connections list it; service_connection:stripe with no account is the one Stripe account the vault holds (several held: refused, naming them)"
        }
       }
      }
     }
    },
    "output_schema": {
     "type": "object",
     "required": [
      "data",
      "has_more"
     ],
     "properties": {
      "data": {
       "type": "array"
      },
      "has_more": {
       "type": "boolean"
      }
     }
    },
    "invoke": {
     "kind": "http",
     "connection": {
      "vendor": "stripe",
      "from_input": "connection"
     },
     "method": "GET",
     "url": "https://api.stripe.com/v1/balance_transactions?limit=100&created[gte]={since}",
     "timeout_ms": 30000,
     "credential_injections": [
      {
       "field_id": "secret_key",
       "placement": {
        "kind": "header",
        "name": "Authorization",
        "prefix": "Bearer "
       },
       "hosts": [
        "api.stripe.com"
       ]
      }
     ],
     "answer_codes_that_mean_it_worked": {
      "at_least": 200,
      "below": 300
     }
    },
    "needs": {
     "expected_seconds": 5,
     "network_egress": true
    },
    "read_only": true,
    "placements": [
     "placement:public-web-address"
    ],
    "provenance": {
     "record": "package::service-connections::how-to-ask-something-else-to-do-things::stripe-events",
     "source": "old trillion's row of the same id, made from this record's instrument_requests.read_money_since by the tool-row-source source:how-to-ask-something-else-to-do-things (tools/connect-a-service-and-seal-its-key/from-an-older-version/records/workshop-tool-records.json); `hosts` binds the key to Stripe's API host, as the engine requires of every key (F-0803)"
    }
   }
  }
