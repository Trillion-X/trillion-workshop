  "worked_examples": [
    {
      "title": "Evaluate a writing-voice classifier on labelled passages on a sample input",
      "ask": "Run tool:evaluate-a-writing-voice-classifier.",
      "mcp": {
        "server": "trillion",
        "tool": "run_resource_operation",
        "input": {
          "address": "@workshop-tools",
          "method": "tools:run",
          "input": {
            "tool": "tool:evaluate-a-writing-voice-classifier",
            "input": {
              "action": "evaluate",
              "data": {
                "schema": "book-voice-decider-challenge-v2",
                "dataset_role": "source_feedback_controls",
                "criteria": [
                  {
                    "id": "claim-strength",
                    "primitive": "true-or-false",
                    "question": "Does the passage state the claim no more strongly than its source?"
                  }
                ],
                "items": [
                  {
                    "id": "MADE-UP-01",
                    "text": "We tried the kettle first. It boiled in four minutes, so we stopped guessing and timed the pot instead.",
                    "family": "made-up-kettle",
                    "split": "eval",
                    "rationale": "Made-up fixture.",
                    "axis": [
                      "made_up_axis"
                    ],
                    "origin": {
                      "kind": "made-up-fixture",
                      "source_ref": {
                        "file": "made-up-notes.md",
                        "lines": "1-3"
                      }
                    },
                    "checks": {
                      "claim-strength": "pass"
                    }
                  },
                  {
                    "id": "MADE-UP-02",
                    "text": "Leverage synergies to maximize kettle outcomes across all stakeholders.",
                    "family": "made-up-kettle",
                    "split": "eval",
                    "rationale": "Made-up fixture.",
                    "axis": [
                      "made_up_axis"
                    ],
                    "origin": {
                      "kind": "made-up-fixture",
                      "source_ref": {
                        "file": "made-up-notes.md",
                        "lines": "5-7"
                      }
                    },
                    "checks": {
                      "claim-strength": "fail"
                    }
                  }
                ]
              },
              "data_name": "/fixture/binary-challenge.json",
              "settings_record": {
                "id": "record:setting:train-and-evaluate-a-writing-voice-classifier~person~made-up-writer",
                "type": "record:setting",
                "value": {
                  "name": "A made-up writer's voice classifier",
                  "tool": "tool:evaluate-a-writing-voice-classifier",
                  "scope_kind": "person",
                  "scope_id": "made-up-writer",
                  "settings": "{\"endpoint\":\"http://127.0.0.1:8099/v1/systemone\",\"model\":\"made-up-model\",\"workers\":1}",
                  "from": "made-up",
                  "status": "active"
                }
              },
              "replies": [
                {
                  "request": "{\"state\":\"Passage: We tried the kettle first. It boiled in four minutes, so we stopped guessing and timed the pot instead.\",\"questions\":{\"claim-strength\":{\"type\":\"noul\",\"instructions\":\"Does the passage state the claim no more strongly than its source?\"}},\"model\":\"made-up-model\"}",
                  "status": 200,
                  "response": "{\"model\":\"made-up-model\",\"served_identity\":\"/fixture/made-up-model-snapshot\",\"answers\":{\"claim-strength\":{\"noul\":0.8}},\"usage\":{\"input_tokens\":12,\"output_tokens\":0}}"
                },
                {
                  "request": "{\"state\":\"Passage: Leverage synergies to maximize kettle outcomes across all stakeholders.\",\"questions\":{\"claim-strength\":{\"type\":\"noul\",\"instructions\":\"Does the passage state the claim no more strongly than its source?\"}},\"model\":\"made-up-model\"}",
                  "status": 200,
                  "response": "{\"model\":\"made-up-model\",\"served_identity\":\"/fixture/made-up-model-snapshot\",\"answers\":{\"claim-strength\":{\"noul\":0.3}},\"usage\":{\"input_tokens\":12,\"output_tokens\":0}}"
                }
              ],
              "health": {
                "serving": "/fixture/made-up-model-snapshot",
                "device": "cpu"
              }
            }
          }
        }
      },
      "hands_back": "The answer's $.result holds the result: Check how well a small classifier judges a writer's voice: validate the labelled challenge passages, plan the questions, ask the classifier each one, and report its choices, probabilities, abstentions and accuracy by criterion, family and source"
    }
  ],
