        "id": "tool:fit-a-tool-list-in-a-budget",
        "listed_on": "2026-11-03T12:00:00Z",
        "label": "Fit a tool list in a budget",
        "job": "Shrink a list of tools for an AI so it fits in a number of characters, keeping as much detail as fits",
        "description": "Give tools (MCP tool entries: name, description, inputSchema), budget_chars (a positive number of characters of the JSON list) and, optionally, names (tools to keep in full whatever the budget). The list is tried at levels full, brief (first sentence of each description), schema-only (no descriptions) and names (schemas reduced to an open object); the first whose whole list fits is sent, and the last when none fit. No tool is renamed, reordered or dropped. Returns tools and listing { level, chars, budget_chars, fits, tools, said when shortened, unknown and unknown_said for names no tool has }. Without a positive budget_chars the list comes back unchanged with an empty listing.",
        "input_schema": {
          "type": "object",
          "required": [
            "tools"
          ],
          "additionalProperties": false,
          "properties": {
            "tools": {
              "type": "array",
              "items": {
                "type": "object"
              }
            },
            "budget_chars": {
              "type": "number"
            },
            "names": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "output_schema": {
          "type": "object",
          "required": [
            "tools",
            "listing"
          ],
          "properties": {
            "tools": {
              "type": "array"
            },
            "listing": {
              "type": "object"
            }
          }
        },
        "invoke": {
          "kind": "container",
          "files": {
            "package_files": [
              {
                "package": "list-tools-for-an-ai",
                "paths": [
                  "read-data"
                ],
                "at": "/opt/list-tools-for-an-ai"
              },
              {
                "package": "records-door",
                "paths": [
                  "do-work",
                  "read-data"
                ],
                "at": "/opt/records-door"
              },
              {
                "package": "content-identity",
                "paths": [
                  "read-data"
                ],
                "at": "/opt/content-identity"
              },
              {
                "module": "@noble/hashes",
                "paths": [
                  "LICENSE",
                  "package.json",
                  "blake3.js",
                  "blake2.js",
                  "_blake.js",
                  "_md.js",
                  "_u64.js",
                  "utils.js"
                ],
                "at": "/opt/node_modules/@noble/hashes"
              }
            ]
          },
          "workdir": "/opt/list-tools-for-an-ai",
          "internet": false,
          "stdout": "json",
          "argv": [
            "node",
            "/opt/records-door/do-work/run-an-export.mjs",
            "/opt/list-tools-for-an-ai/read-data/listing-tools.mjs",
            "fitToolList"
          ],
          "stdin": {
            "fill": {
              "from": "input"
            }
          }
        },
        "result_selector": "$.result",
        "provenance": {
          "source": "moved from Trillion-X/trillion src/tool-listing-budget.mjs"
        },
        "verify": [
          {
            "kind": "sample-run",
            "input": {
              "tools": [
                {
                  "name": "sample_tool",
                  "description": "Lists sample things. It takes nothing and changes nothing.",
                  "inputSchema": {
                    "type": "object"
                  }
                }
              ],
              "budget_chars": 60
            },
            "output_selector": "$.listing.said",
            "contains": "shortened to fit 60 characters"
          }
        ]
      }
    },
