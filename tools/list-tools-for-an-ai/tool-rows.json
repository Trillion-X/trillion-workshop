        "id": "tool:pick-the-release-a-host-runs",
        "listed_on": "2026-11-03T12:00:00Z",
        "label": "Pick the release a host version runs",
        "job": "Tell which release of a published tool a given Trillion version runs, or which version it needs",
        "description": "Give row (a published tool row, optionally with minimum_host_version and earlier_releases, newest first) and host_version (the version of the Trillion that will run it, like 2026.10.1). Versions compare part by part, missing parts are zero. Returns release: the row itself when its minimum is met, else the first earlier release whose minimum is met (without its earlier_releases); when none runs, release is null and oldest_needed names the oldest version any release runs on. A missing host_version is refused.",
        "input_schema": {
          "type": "object",
          "required": [
            "row",
            "host_version"
          ],
          "additionalProperties": false,
          "properties": {
            "row": {
              "type": "object"
            },
            "host_version": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "output_schema": {
          "type": "object",
          "required": [
            "release"
          ],
          "properties": {
            "release": {
              "type": [
                "object",
                "null"
              ]
            },
            "oldest_needed": {
              "type": [
                "string",
                "null"
              ]
            }
          }
