});

test('a vector scan resumes after its bounded page and reports pending until complete', async () => {
  const { sql, results, store } = person();
  store(1, 'paged.mp4');
  const lane = { id: 'meaning', source: 'files', place: 'seen', match: 'meaning-in-results', kind: 'meaning', items_path: 'items', keep: 'each', floor: 0.5, rank: 1 };
  const config = { ...settings, vector_scan_page_size: 1, lanes: [lane] };
  results.put([{ identity: drive(1), kind: 'meaning', value: { items: [
    { v: half([0, 1, 0]) }, { v: half([1, 0, 0]) }, { v: half([0, 0, 1]) },
  ] } }]);
  const search = makeSearch({ sql, config });
  await finishIndexing(search);
  const encoded = { meaning: { vector: [1, 0, 0] } };
  const first = await search.indexSearch('ceramics', { encoded });
  assert.ok(first.pending.some(item => item.lane === lane.id));
  const answer = await finishPendingIndexSearch(search, 'ceramics', { encoded }, first);
  assert.deepEqual(answer.answered[0], [], 'large exact candidate sets stay in the durable candidate store');
  assert.equal(answer.candidate_refs.length, 1);
  assert.equal(sql.exec("SELECT best FROM search_nearest_walks WHERE lane = 'meaning' LIMIT 1").one().best, '[]', 'the durable walk row holds only its cursor, not a candidate array');
  assert.equal(sql.exec("SELECT COUNT(*) AS n FROM search_candidate_hits WHERE kind = 'nearest'").one().n, 1, 'the exact candidate is kept as its own row');
  const found = await finishPendingSearch(search, 'ceramics', { encoded });
  assert.deepEqual(found.results.map(result => result.name), ['paged.mp4']);
  assert.equal(found.results[0].score, 0.01639, 'the completed public result uses the lane contribution');
});

test('ranked candidate pages keep equal-score cursors stable across the indexed tie boundary', () => {
  const { sql } = person();
  const reads = [];
  const observed = {exec(query, ...args) {
    if (/^SELECT seq, set_lane/.test(query)) reads.push([query, args]);
    return sql.exec(query, ...args);
  }};
  const candidates = searchCandidatePages(observed, { pageSize: 3 });
  const hits = Array.from({ length: 8 }, (_, index) => ({
    identity: own(800 + index), n: 0, start: index, end: index + 1, timed: true, score: index < 5 ? 1 : 0.5,
  }));
  candidates.putPage('nearest', 'ranked', 'question', hits.slice(0, 3));
  candidates.putPage('nearest', 'ranked', 'question', hits.slice(3, 6));
  candidates.putPage('nearest', 'ranked', 'question', hits.slice(6));
  const first = candidates.readRankedPage('nearest', 'ranked', 'question', null, 0, 3);
  const second = candidates.readRankedPage('nearest', 'ranked', 'question', first.afterScore, first.afterSeq, 3);
  const third = candidates.readRankedPage('nearest', 'ranked', 'question', second.afterScore, second.afterSeq, 3);
  assert.deepEqual([first, second, third].map(page => page.rows.map(row => row.identity)), [
    hits.slice(0, 3).map(hit => hit.identity), hits.slice(3, 6).map(hit => hit.identity), hits.slice(6).map(hit => hit.identity),
  ]);
  assert.deepEqual([first.more, second.more, third.more], [true, true, false]);
  assert.ok(reads.length >= 4, 'the actual owner exercised the initial, tie and lower-score reads');
  for (const [query, args] of reads) {
    const plan = sql.exec(`EXPLAIN QUERY PLAN ${query}`, ...args).toArray().map(row => row.detail).join('\n');
    assert.match(plan, /SEARCH search_candidate_hits USING INDEX search_candidate_hits_ranked/);
    assert.doesNotMatch(plan, /SCAN search_candidate_hits|TEMP B-TREE/);
  }
});

test('detail hydration uses indexed seeks through equal and lower priorities after reopening', () => {
  const {sql} = person(), reads = [];
  const observed = {exec(query, ...args) {
    if (/^SELECT lane, n, start/.test(query)) reads.push([query, args]);
    return sql.exec(query, ...args);
  }};
  let candidates = searchCandidatePages(observed, {pageSize: 3});
  for (let n = 0; n < 8; n++) sql.exec(`INSERT INTO search_fusion_candidate_details
    (session,lane,identity,n,start,end,timed,said,score,source_seq,priority,lane_order)
    VALUES ('session','lane','identity',?,?,?,1,'words',1,?,?,0)`, n, n * 20, n * 20 + 10, n + 1, n < 5 ? 1 : 0.5);
  const first = candidates.hydrationPage('session', 'identity', null, 3);
  candidates = searchCandidatePages(observed, {pageSize: 3});
  const second = candidates.hydrationPage('session', 'identity', first.rows.at(-1), 3);
  const third = candidates.hydrationPage('session', 'identity', second.rows.at(-1), 3);
  assert.deepEqual([first, second, third].flatMap(page => page.rows.map(row => row.n)), [0,1,2,3,4,5,6,7]);
  assert.deepEqual([first.more, second.more, third.more], [true,true,false]);
  for (const [query,args] of reads) {
    const plan = sql.exec(`EXPLAIN QUERY PLAN ${query}`, ...args).toArray().map(row => row.detail).join('\n');
    assert.match(plan, /SEARCH search_fusion_candidate_details USING INDEX search_fusion_candidate_details_identity_v2/);
    assert.doesNotMatch(plan, /SCAN search_fusion_candidate_details|TEMP B-TREE/);
  }
});

test('rank fusion keeps a lower raw-score candidate that wins across meaning lanes', async () => {
  const { sql, results, store } = person();
  store(1, 'x.mp4');
  store(2, 'y.mp4');
  const lane = (id, kind) => ({ id, source: 'files', place: 'seen', match: 'meaning-in-results', kind, items_path: 'items', keep: 'each', floor: -1, rank: 1, encoder: { via: 'workers-ai', model: 'example' } });
  const lanes = [lane('model-a', 'model-a'), lane('model-b', 'model-b')];
  const config = { ...settings, limit: 1, vector_scan_page_size: 16, lanes };
  const vector = score => half([score, Math.sqrt(1 - score * score)]);
  const distractors = config.lanes.length + 2;
  const values = [
    { identity: drive(1), kind: 'model-a', value: { items: [{ v: vector(0.999) }] } },
    ...Array.from({ length: distractors }, (_, index) => {
      const id = index + 3;
      store(id, `candidate-${id}.mp4`);
      return { identity: drive(id), kind: 'model-a', value: { items: [{ v: vector(0.98 - index * 0.001) }] } };
    }),
    { identity: drive(2), kind: 'model-a', value: { items: [{ v: vector(0.2) }] } },
    { identity: drive(2), kind: 'model-b', value: { items: [{ v: vector(0.1) }] } },
  ];
  results.put(values);
  const search = makeSearch({ sql, config, embed: async () => [[1, 0]] });
  await finishIndexing(search);
  const found = await finishPendingSearch(search, 'ceramics', { places: ['seen'], sources: ['files'], matches: ['meaning-in-results'] });
  assert.deepEqual(found.results.map(result => result.name), ['y.mp4'], 'a deep candidate can win through consensus despite lower raw scores');
});

test('public finish resumes bounded detail hydration and keeps the strongest spaced moments', async () => {
  const { sql, results, store } = person();
  store(1, 'many-moments.mp4');
  const lane = { id: 'speech', source: 'files', place: 'said', match: 'meaning-in-results', kind: 'speech', items_path: 'items', time_fields: { start: 'start', end: 'end', said: 'text' }, keep: 'each', floor: 0.5, rank: 1, encoder: { via: 'workers-ai', model: 'example' } };
  const config = { ...settings, limit: 1, vector_scan_page_size: 256, lanes: [lane] };
  results.put([{ identity: drive(1), kind: 'speech', value: { items: Array.from({ length: 130 }, (_, index) => ({
    v: half([1, 0]), start: index * 20, end: index * 20 + 10, text: `moment ${index}`,
  })) } }]);
  const search = makeSearch({ sql, config, embed: async () => [[1, 0]] });
  await finishIndexing(search);
  const found = await finishPendingSearch(search, 'ceramics');
  assert.deepEqual(found.results[0].moments.map(moment => moment.start), [0, 20, 40]);
  const progress = sql.exec('SELECT processed, done FROM search_fusion_hydration_progress WHERE session = ? LIMIT 1', found.fusion_session ?? search.fusionSession('ceramics')).one();
  assert.deepEqual({ ...progress }, { processed: 130, done: 1 });
});

test('saved result projection pages survive reopen without rewriting the accumulated output', async t => {
  const { mkdtempSync, rmSync } = await import('node:fs');
  const { tmpdir } = await import('node:os');
  const { join } = await import('node:path');
  const folder = mkdtempSync(join(tmpdir(), 'search-projection-pages-')), file = join(folder, 'search.sqlite');
  let host = sqliteHost(file);
  t.after(() => { host.db.close(); rmSync(folder, { recursive: true, force: true }); });
  namespaceStore(host.sql); resultsStore(host.sql);
  host.sql.exec("INSERT INTO namespace_files (identity,byte_length,media_type,origin,key,part_bytes,stored_at,checked_at) VALUES (?,10,'video/mp4','small','k',10,'now','now')", own(1));
  host.sql.exec("INSERT INTO namespace_names (name,collection,identity,byte_length,modified_at_ms,named_at) VALUES ('/Pottery/all-models.mp4','/Pottery',?,10,5,'now')", own(1));
  const lane = { id:'meaning', source:'files', match:'meaning-in-results', kind:'meaning', sets_path:'$.sets', rank:1 };
  const config = { ...settings, lanes:[lane], limit:1 };
  const queries = [];
  const mount = () => makeSearch({sql:{exec(query,...args){queries.push(query);return host.sql.exec(query,...args);}},index:false,config,transaction:host.transaction});
  let search = mount();
  const refs = [{kind:'sets',lane:lane.id,question:'projection-source',revision:0,max_hits:null,transferred:true}];
  const question = 'all models', session = search.fusionSession(question), fingerprint = search.candidateFusionFingerprint(refs);
  search.ensureCandidateFusion(session, fingerprint);
  const count = 270;
  for(let at=0;at<count;at+=128) search.acceptCandidatePage(session,lane.id,Array.from({length:Math.min(128,count-at)},(_,offset)=>({
    identity:own(1),set_lane:`meaning@space-${String(at+offset).padStart(3,'0')}@said`,score:1,n:at+offset,start:5,end:8,timed:true,said:'the kiln',seq:at+offset,
  })));
  let answer, reopened=false;
  for(let step=0;step<100;step++) {
    const partial={answered:[[]],unavailable:[],pending:[],still_reading:{},candidate_refs:refs.map(row=>({...row})),fusion_session:session};
    answer=await search.finish(question,{},partial);
    const pages=host.sql.exec('SELECT seq,phase,payload FROM search_fusion_projection_pages WHERE session=? AND identity=? ORDER BY seq LIMIT 100',session,own(1)).toArray();
    assert.ok(pages.every(page=>JSON.parse(page.payload).length<=128),'every saved projection is one bounded source page');
    if(!reopened && pages.length>=2){host.db.close();host=sqliteHost(file);search=mount();reopened=true;}
    if(!answer.pending.length)break;
  }
  assert.equal(reopened,true,'the real SQLite store reopens midway through projection');
  assert.deepEqual(answer.pending,[]);
  assert.deepEqual(answer.results.map(row=>[row.name,row.start]),[['all-models.mp4',5]]);
  assert.equal(host.sql.exec('SELECT COUNT(*) AS n FROM search_fusion_seen WHERE session=?',session).one().n,count,'all selected model ranks survive');
  const places=host.sql.exec("SELECT payload FROM search_fusion_projection_pages WHERE session=? AND identity=? AND phase='places' ORDER BY seq LIMIT 100",session,own(1)).toArray();
  assert.equal(places.reduce((n,page)=>n+JSON.parse(page.payload).length,0),count,'no selected lane is truncated');
  assert.equal(queries.some(query=>/UPDATE search_fusion_hydration_projection SET payload/.test(query)),false,'continuations never rewrite the growing aggregate');
});

test('durable candidate fusion lets deep agreement win without a candidate cap', () => {
  const { sql } = person();
  const lane = id => ({ id, source: 'files', place: 'seen', match: 'meaning-in-results', kind: id, items_path: 'items', keep: 'each', floor: -1, rank: 1 });
  const search = makeSearch({ sql, index: false, config: { ...settings, lanes: [lane('deep-a'), lane('deep-b')] } });
  const fusion = 'deep-agreement';
  search.ensureCandidateFusion(fusion, 'deep-agreement-inputs');
  sql.exec(`CREATE TABLE IF NOT EXISTS search_candidate_transfers (
    session TEXT PRIMARY KEY, lane TEXT NOT NULL, kind TEXT NOT NULL, source_question TEXT NOT NULL,
    after_score REAL, after_seq INTEGER NOT NULL DEFAULT 0, count INTEGER NOT NULL DEFAULT 0, done INTEGER NOT NULL DEFAULT 0,
    fusion_session TEXT, source_revision TEXT, cursor_json TEXT
  )`);
  const transfer = (laneId, rows) => {
    const session = `${fusion}:${laneId}`;
    sql.exec('INSERT OR REPLACE INTO search_candidate_transfers (session, lane, kind, source_question, fusion_session) VALUES (?, ?, ?, ?, ?)', session, laneId, 'nearest', 'q', fusion);
    search.acceptCandidatePage(fusion, laneId, rows.map((identity, index) => ({ identity, n: 0, start: 0, end: 0, timed: false, score: 1 - index / 100, seq: index + 1 })), {
      transfer: { session, afterScore: 0.9, afterSeq: rows.length, count: rows.length, done: true, sourceRevision: 1 },
    });
  };
  const a = Array.from({ length: 5 }, (_, at) => own(300 + at));
  const b = Array.from({ length: 5 }, (_, at) => own(400 + at));
  const consensus = own(500);
  transfer('deep-a', [...a, consensus]);
  transfer('deep-b', [...b, consensus]);
  const top = sql.exec('SELECT identity, score FROM search_fusion_totals WHERE session = ? ORDER BY score DESC LIMIT 1', fusion).one();
  assert.equal(top.identity, consensus);
  assert.equal(top.score, 2 / 66, 'both rank-six lane contributions are kept exactly');
  assert.ok(top.score > 1 / 61, 'agreement outranks a candidate first in only one lane');
});

test('fusion reset is fenced and drains candidates, projections, and transfer receipts in bounded pages', () => {
  const { sql } = person();
  const candidates = searchCandidatePages(sql, { pageSize: 2 });
  assert.equal(candidates.ensureFusionFingerprint('reset-session', 'old', 'r1'), true);
  assert.equal(candidates.fusionReady('reset-session', 'old', 'r1'), true);
  for (let at = 0; at < 5; at += 1) {
    const identity = own(900 + at);
    sql.exec(`INSERT INTO search_fusion_candidates (session,lane,set_lane,identity,n,start,end,timed,score)
      VALUES ('reset-session','lane','',?,0,0,0,0,1)`, identity);
    sql.exec(`INSERT INTO search_fusion_totals (session,identity,score) VALUES ('reset-session',?,1)`, identity);
    sql.exec(`INSERT INTO search_fusion_hydration_projection (session,identity,payload) VALUES ('reset-session',?,'{}')`, identity);
    sql.exec(`INSERT INTO search_candidate_transfers (session,lane,kind,source_question,fusion_session)
      VALUES (?,?, 'nearest','q','reset-session')`, `transfer-${at}`, 'lane');
  }
  const count = () => ['search_fusion_candidates', 'search_fusion_totals', 'search_fusion_hydration_projection', 'search_candidate_transfers']
    .reduce((sum, table) => sum + sql.exec(`SELECT COUNT(*) AS n FROM ${table} WHERE ${table === 'search_candidate_transfers' ? 'fusion_session' : 'session'} = ?`, 'reset-session').one().n, 0);
  let before = count(), ready = false, fingerprint = 'new', revision = 'r2';
  for (let step = 0; step < 64 && !ready; step += 1) {
    if (step === 3) {
      fingerprint = 'newest';
      revision = 'r3';
    }
    candidates.ensureFusionFingerprint('reset-session', fingerprint, revision);
    const after = count();
    assert.ok(before - after <= 2, 'one reset step deletes at most its configured page');
    before = after;
    ready = candidates.fusionReady('reset-session', fingerprint, revision);
    if (!ready) assert.equal(candidates.fusionReady('reset-session', fingerprint, revision), false, 'new fusion input remains fenced while cleanup is pending');
  }
  assert.equal(ready, true, 'the bounded cleanup cursor eventually admits the latest replacement session');
  assert.equal(candidates.fusionReady('reset-session', 'new', 'r2'), false, 'an interrupted cleanup cannot admit its superseded target');
  assert.equal(count(), 0, 'the replaced session has no candidate, total, or transfer rows');
});

test('retired base and model-set lane indexes clean in durable pages before a lane can be re-added', async t => {
  const { mkdtempSync, rmSync } = await import('node:fs');
  const { tmpdir } = await import('node:os');
  const { join } = await import('node:path');
  const directory = mkdtempSync(join(tmpdir(), 'search-retired-lane-'));
  const path = join(directory, 'search.sqlite');
  let host = sqliteHost(path);
  t.after(() => { host.db.close(); rmSync(directory, { recursive: true, force: true }); });
  resultsStore(host.sql,identity=>[identity]);
  const lane = settings.lanes.find(item => item.id === 'meaning');
  const active = { ...settings, lanes: [lane] };
  makeSearch({ sql: host.sql, config: active });
  const setLane = `${lane.id}@space@place`;
  for (let at = 0; at < 5; at += 1) {
    const identity = own(1200 + at);
    sqlInsertVector(host.sql, lane.id, identity, at);
    sqlInsertVector(host.sql, setLane, identity, at);
    host.sql.exec('INSERT INTO search_marks (lane, identity, value_identity) VALUES (?, ?, ?)', lane.id, identity, `v${at}`);
    host.sql.exec('INSERT INTO search_set_lanes (lane, identity, set_lane) VALUES (?, ?, ?)', lane.id, identity, setLane);
  }
  host.sql.exec('INSERT INTO search_set_lane_names (lane, set_lane) VALUES (?, ?)', lane.id, setLane);
  host.sql.exec('INSERT INTO search_vector_counts (lane, n) VALUES (?, 5), (?, 5)', lane.id, setLane);
  host.sql.exec('INSERT INTO search_vector_trained (lane, vectors, buckets) VALUES (?, 5, 1), (?, 5, 1)', lane.id, setLane);
  host.sql.exec('INSERT INTO search_vector_centroids (lane, bucket, vector) VALUES (?, 0, ?), (?, 0, ?)', lane.id, new Uint8Array([127, 0, 0]), setLane, new Uint8Array([127, 0, 0]));
  const wordRow = host.sql.exec('INSERT INTO search_word_rows (lane, identity) VALUES (?, ?) RETURNING word_row', lane.id, own(1200)).one().word_row;
  host.sql.exec('INSERT INTO search_words (rowid, lane, identity, text) VALUES (?, ?, ?, ?)', wordRow, lane.id, own(1200), 'retired words');
  const retired = { ...settings, lanes: [] };
  const retiredSearch = makeSearch({ sql: host.sql, config: retired });
  assert.equal(host.sql.exec('SELECT COUNT(*) AS n FROM search_vectors WHERE lane IN (?, ?)', lane.id, setLane).one().n, 10,
    'construction queues retirement without deleting a lane-sized index');
  await retiredSearch.catchUp(2);
  host.sql.exec("UPDATE search_retired_lane_cleanup SET phase = 15, after_rowid = 999, row_key = '[999]', version = 1 WHERE lane = ?", lane.id);
  host.sql.exec("UPDATE search_set_cleanup SET phase = 5, row_cursor = 999, row_key = '[999]', active_set = ?, version = 1 WHERE lane = ?", setLane, lane.id);

  let search;
  for (let step = 0; step < 180; step += 1) {
    host.db.close();
    host = sqliteHost(path);
    search = makeSearch({ sql: host.sql, config: active });
    const baseBefore = host.sql.exec('SELECT COUNT(*) AS n FROM search_vectors WHERE lane = ?', lane.id).one().n;
    const setBefore = host.sql.exec('SELECT COUNT(*) AS n FROM search_vectors WHERE lane = ?', setLane).one().n;
    const refsBefore = host.sql.exec('SELECT COUNT(*) AS n FROM search_set_lanes WHERE lane = ?', lane.id).one().n;
    await search.catchUp(2);
    const baseAfter = host.sql.exec('SELECT COUNT(*) AS n FROM search_vectors WHERE lane = ?', lane.id).one().n;
    const setAfter = host.sql.exec('SELECT COUNT(*) AS n FROM search_vectors WHERE lane = ?', setLane).one().n;
    const refsAfter = host.sql.exec('SELECT COUNT(*) AS n FROM search_set_lanes WHERE lane = ?', lane.id).one().n;
    assert.ok(baseBefore - baseAfter <= 2, 'base vectors are removed by one configured page');
    assert.ok(setBefore - setAfter <= 2, 'derived vectors are removed by one configured page');
    assert.ok(refsBefore - refsAfter <= 2, 'set-to-file references are removed by one configured page');
    if (!host.sql.exec('SELECT 1 FROM search_retired_lane_cleanup WHERE lane = ? UNION ALL SELECT 1 FROM search_set_cleanup WHERE lane = ? LIMIT 1', lane.id, lane.id).toArray().length) break;
    assert.equal(host.sql.exec('SELECT COUNT(*) AS n FROM search_result_lanes WHERE lane = ?', lane.id).one().n, 0,
      'a returning lane stays unsubscribed while old rows are still being deleted');
  }
  assert.equal(host.sql.exec('SELECT COUNT(*) AS n FROM search_retired_lane_cleanup WHERE lane = ?', lane.id).one().n, 0);
  assert.equal(host.sql.exec('SELECT COUNT(*) AS n FROM search_set_cleanup WHERE lane = ?', lane.id).one().n, 0);
  assert.equal(host.sql.exec('SELECT COUNT(*) AS n FROM search_vectors WHERE lane IN (?, ?)', lane.id, setLane).one().n, 0);
  assert.equal(host.sql.exec('SELECT COUNT(*) AS n FROM search_words WHERE lane = ?', lane.id).one().n, 0);
  assert.equal(host.sql.exec('SELECT COUNT(*) AS n FROM search_result_lanes WHERE lane = ?', lane.id).one().n, 1,
    'the lane is re-subscribed only after cleanup, so normal backfill can safely rebuild it');
  assert.equal(host.sql.exec('SELECT COUNT(*) AS n FROM search_backfill WHERE lane = ?', lane.id).one().n, 1);
});

function sqlInsertVector(sql, lane, identity, n) {
  sql.exec('INSERT INTO search_vectors (lane, identity, n, start, finish, said, vector) VALUES (?, ?, ?, ?, ?, ?, ?)',
    lane, identity, n, n, n + 1, 'kept', new Uint8Array([127, 0, 0]));
}

test('candidate fusion canonicalizes aliases across pages, restarts on alias revisions, and replays atomically', () => {
  const { sql, store } = person();
  store(1, 'aliases.mp4');
  const lane = { id: 'alias-meaning', source: 'files', place: 'seen', match: 'meaning-in-results', kind: 'alias-meaning', items_path: 'items', keep: 'each', floor: -1, rank: 1 };
  const search = makeSearch({ sql, index: false, config: { ...settings, lanes: [lane] } });
  const fusion = 'alias-boundary';
  const fingerprint = 'alias-boundary-inputs';
  const hidden = own(2);
  sql.exec("INSERT INTO namespace_set_aside_names (id, ordinal, name, collection, identity) VALUES ('deleted', 0, NULL, NULL, ?)", hidden);
  assert.equal(search.ensureCandidateFusion(fusion, fingerprint), true);
  sql.exec(`CREATE TABLE IF NOT EXISTS search_candidate_transfers (
    session TEXT PRIMARY KEY, lane TEXT NOT NULL, kind TEXT NOT NULL, source_question TEXT NOT NULL,
    after_score REAL, after_seq INTEGER NOT NULL DEFAULT 0, count INTEGER NOT NULL DEFAULT 0, done INTEGER NOT NULL DEFAULT 0,
    fusion_session TEXT, source_revision TEXT, cursor_json TEXT
  )`);
  const aliasOne = drive(601), aliasTwo = drive(602), canonical = own(1);
  const page = (sourceSession, alias, seq, score) => {
    sql.exec('INSERT OR REPLACE INTO search_candidate_transfers (session, lane, kind, source_question, fusion_session) VALUES (?, ?, ?, ?, ?)', sourceSession, lane.id, 'nearest', 'q', fusion);
    search.acceptCandidatePage(fusion, lane.id, [{ identity: alias, n: 0, start: seq, end: seq + 1, timed: true, score, seq }], {
      transfer: { session: sourceSession, afterScore: score, afterSeq: seq, count: seq, done: false, sourceRevision: 1 },
    });
  };
  sql.exec("INSERT INTO namespace_aliases (alias, identity, grade, added_at) VALUES (?, ?, 'checked', 'now')", aliasOne, canonical);
  page('alias-page-1', aliasOne, 1, 0.9);
  sql.exec("INSERT INTO namespace_aliases (alias, identity, grade, added_at) VALUES (?, ?, 'checked', 'now')", aliasTwo, canonical);
  assert.equal(search.ensureCandidateFusion(fusion, fingerprint), true, 'the alias revision invalidates the staged rank');
  assert.equal(search.candidateFusionReady(fusion, fingerprint), false, 'the old alias ranks stay fenced while bounded cleanup is pending');
  for (let step = 0; step < 100 && !search.candidateFusionReady(fusion, fingerprint); step++) search.ensureCandidateFusion(fusion, fingerprint);
  assert.equal(search.candidateFusionReady(fusion, fingerprint), true, 'the exact current alias revision becomes ready after cleanup');
  assert.equal(sql.exec('SELECT COUNT(*) AS n FROM search_fusion_totals WHERE session = ?', fusion).one().n, 0);
  page('alias-page-1', aliasOne, 1, 0.9);
  page('alias-page-2', aliasTwo, 2, 0.8);
  page('hidden-page', hidden, 3, 0.7);
  const seen = sql.exec('SELECT rank FROM search_fusion_seen WHERE session = ? AND lane = ? AND identity = ?', fusion, lane.id, canonical).one();
  assert.equal(seen.rank, 1, 'aliases on separate pages share one canonical lane rank');
  const before = sql.exec('SELECT score FROM search_fusion_totals WHERE session = ? AND identity = ?', fusion, canonical).one().score;
  page('alias-page-1', aliasOne, 1, 0.9);
  assert.equal(sql.exec('SELECT score FROM search_fusion_totals WHERE session = ? AND identity = ?', fusion, canonical).one().score, before, 'replaying a page does not add a second contribution');
  assert.equal(sql.exec('SELECT COUNT(*) AS n FROM search_fusion_candidate_details WHERE session = ? AND identity = ?', fusion, canonical).one().n, 2);
  assert.equal(sql.exec('SELECT COUNT(*) AS n FROM search_fusion_totals WHERE session = ? AND identity = ?', fusion, hidden).one().n, 0, 'a file set aside without a remaining name is excluded');
  assert.equal(sql.exec('SELECT after_seq FROM search_candidate_transfers WHERE session = ?', 'alias-page-2').one().after_seq, 2, 'the page cursor commits with its rank update');
  assert.throws(() => search.acceptCandidatePage(fusion, lane.id, Array.from({ length: 129 }, (_, seq) => ({ identity: own(700 + seq), score: 1, seq }))), /exceeds 128/);
});

test('a sets lane keyset walk visits more than 256 sets, including empty and supplementary-Unicode places', async () => {
  const { sql, results, store } = person();
  store(1, 'paged.mp4');
  const lane = { id: 'meaning', source: 'files', match: 'meaning-in-results', kind: 'meaning', sets_path: '$.sets', floor: 0.5, rank: 1 };
  const config = { ...settings, lanes: [lane] };
  const places = ['', 'place-000', ...Array.from({ length: 255 }, (_, at) => `place-${String(at + 1).padStart(3, '0')}`), '🧭'];
  const sets = places.map(place => ({ space: 'space', place, items: [{ v: half([1, 0, 0]) }] }));
  results.put([{ identity: drive(1), kind: 'meaning', value: { sets } }]);
  const search = makeSearch({ sql, config });
  await finishIndexing(search);
  const encoded = { meaning: { spaces: { space: { vector: [1, 0, 0] } }, encoder_page: { complete: true } } };
  const indexed = await finishPendingIndexSearch(search, 'ceramics', { encoded });
  assert.equal(indexed.candidate_refs.length, 1, 'the index half returns a durable reference for the completed sets walk');
  const answer = await finishPendingSearch(search, 'ceramics', { encoded });
  assert.deepEqual(answer.results[0].found_in.sort(), [...places].sort());
  assert.deepEqual(answer.results[0].places.map(place => place.place).sort(), [...places].sort());
});

test('a sets lane has no 1024-name ceiling', async () => {
  const { sql, results, store } = person();
  store(1, 'paged.mp4');
  const lane = { id: 'meaning', source: 'files', match: 'meaning-in-results', kind: 'meaning', sets_path: '$.sets', floor: 0.5, rank: 1 };
  const config = { ...settings, lanes: [lane] };
  const places = Array.from({ length: 1025 }, (_, at) => `place-${String(at).padStart(4, '0')}`);
  const sets = places.map(place => ({ space: 'space', place, items: [{ v: half([1, 0, 0]) }] }));
  results.put([{ identity: drive(1), kind: 'meaning', value: { sets } }]);
  const search = makeSearch({ sql, config });
  await finishIndexing(search);
  const encoded = { meaning: { spaces: { space: { vector: [1, 0, 0] } }, encoder_page: { complete: true } } };
  const indexed = await finishPendingIndexSearch(search, 'ceramics', { encoded });
  assert.equal(indexed.candidate_refs.length, 1);
  const answer = await finishPendingSearch(search, 'ceramics', { encoded });
  assert.equal(new Set(answer.results[0].found_in).size, places.length, 'the completed public result preserves every set lane');
  assert.equal(answer.results[0].places.length, places.length);
  assert.equal(sql.exec("SELECT COUNT(*) AS n FROM search_candidate_hits WHERE kind = 'sets'").one().n, places.length, 'every place candidate is stored as a durable row');
  assert.equal(sql.exec('SELECT COUNT(*) AS n FROM search_set_results').one().n, 0, 'no growing JSON hit accumulator remains after the walk');
});

test('replacement and deletion remove every old model set beyond the former 256-row cutoff', async () => {
  for (const remove of [false, true]) {
    const { sql, results, store } = person();
    store(1, 'all model sets.mp4');
    const sets = Array.from({ length: 257 }, (_, at) => ({ space: `space-${String(at).padStart(4, '0')}`, place: 'said',
      items: [{ v: half([1, 0, 0]), start: at, end: at + 1, said: 'kept original passage' }] }));
    results.put([{ identity: drive(1), kind: 'meaning', value: { sets } }]);
    const search = makeSearch({ sql });
    await finishIndexing(search);
    assert.equal(sql.exec('SELECT COUNT(*) AS n FROM search_vectors').one().n, 257);
    if (remove) results.remove(drive(1), 'meaning');
    else results.put([{ identity: drive(1), kind: 'meaning', value: { sets: [] } }]);
    await finishIndexing(search);
    assert.equal(sql.exec('SELECT COUNT(*) AS n FROM search_vectors').one().n, 0, remove ? 'no erased set leaves orphan vectors' : 'no replaced set leaves orphan vectors');
    assert.equal(sql.exec('SELECT COUNT(*) AS n FROM search_set_lanes').one().n, 0);
  }
});

test('an installed model remains searchable without reading unrelated historical model-place names', async () => {
  const { spaceOf } = await import('../src/meaning-spaces.mjs');
  const { sql, results, store } = person();
  store(1, 'last model.mp4');
  const encoder = { id: 'tool:last-space', serves: ['encode'], encodes: { accepts: ['text'], space: { model: 'last/model', dim: 3 }, reads: [] } };
  const space = spaceOf(encoder), reads = [];
  const measured = { exec(query, ...values) { const cursor = sql.exec(query, ...values); if (/SELECT set_lane FROM search_set_lane_names/.test(query)) reads.push({ query, values, rows: cursor.toArray().length }); return cursor; } };
  results.put([{ identity: drive(1), kind: 'meaning', value: { sets: [{ space, place: 'said', items: [{ v: half([1, 0, 0]), start: 7, end: 8, said: 'found after all old names' }] }] } }]);
  const search = makeSearch({ sql: measured, encoders: async () => [encoder], runTool: async () => ({ state: 'completed', output: { model: { name: 'last/model' }, vectors: [[1, 0, 0]] } }) });
  await finishIndexing(search);
  const measurements = [];
  let seeded = 0;
  for (const total of [1025, 4100]) {
    for (; seeded < total; seeded += 1) sql.exec('INSERT INTO search_set_lane_names (lane, set_lane) VALUES (?, ?)', 'meaning', `meaning@0${String(seeded).padStart(4, '0')}@said`);
    reads.length = 0;
    const answer = await finishPendingSearch(search, `different words ${total}`, { places: ['said'], matches: ['meaning-in-results'] });
    assert.deepEqual(answer.results.map(row => [row.name, row.start]), [['last model.mp4', 7]]);
    assert.equal(reads.length, 1);
    assert.equal(reads[0].rows, 1, 'only the selected installed model/place is materialized');
    const read = reads[0];
    const plan = sql.exec(`EXPLAIN QUERY PLAN ${read.query}`, ...read.values).toArray();
    assert.ok(plan.some(row => /SEARCH search_set_lane_names/.test(row.detail)), JSON.stringify(plan));
    assert.ok(plan.every(row => !/SCAN search_set_lane_names|TEMP B-TREE/.test(row.detail)), JSON.stringify(plan));
    measurements.push(reads.map(row => ({ rows: row.rows, values: row.values })));
  }
  assert.deepEqual(measurements[0], measurements[1], 'unrelated history growing fourfold adds no selected SQL work');
});

test('dropping a model-set lane cleans its final vector and index state after 1024 names', async () => {
  const { sql } = person();
  makeSearch({ sql });
  for (let at = 0; at < 1025; at += 1) sql.exec('INSERT INTO search_set_lane_names (lane, set_lane) VALUES (?, ?)', 'meaning', `meaning@space-${String(at).padStart(4, '0')}@said`);
  const last = 'meaning@space-1024@said';
  sql.exec('INSERT INTO search_vectors (lane, identity, n, vector) VALUES (?, ?, 0, ?)', last, drive(1), new Uint8Array([127, 0, 0]));
  sql.exec('INSERT INTO search_vector_counts (lane, n) VALUES (?, 1)', last);
  sql.exec('INSERT INTO search_vector_trained (lane, vectors, buckets) VALUES (?, 1, 1)', last);
  sql.exec('INSERT INTO search_vector_centroids (lane, bucket, vector) VALUES (?, 0, ?)', last, new Uint8Array(new Float32Array([1, 0, 0]).buffer));
  const retired = makeSearch({ sql, config: { ...settings, lanes: settings.lanes.filter(lane => lane.id !== 'meaning') } });
  for (let step = 0; step < 100 && await retired.stale(); step += 1) await retired.catchUp(128);
  assert.equal((await retired.stale()), 0, 'the bounded retirement walk finishes across repeated wakes');
  for (const table of ['search_vectors', 'search_vector_counts', 'search_vector_trained', 'search_vector_centroids']) {
    assert.equal(sql.exec(`SELECT COUNT(*) AS n FROM ${table} WHERE lane = ?`, last).one().n, 0, `${table} has no orphaned final model set`);
  }
});

test('candidate pages retain answered-empty lanes across a real SQLite reopen and bounded cleanup', async t => {
  const { mkdtempSync, rmSync } = await import('node:fs');
  const { tmpdir } = await import('node:os');
  const { join } = await import('node:path');
  const directory = mkdtempSync(join(tmpdir(), 'search-participation-'));
  const path = join(directory, 'search.sqlite');
  let host = sqliteHost(path);
  t.after(() => { host.db.close(); rmSync(directory, { recursive: true, force: true }); });
  let candidates = searchCandidatePages(host.sql, { pageSize: 2, transaction: host.transaction });
  const identities = Array.from({ length: 5 }, (_, at) => own(800 + at));
  for (let at = 0; at < identities.length; at += 2) candidates.putPage('sets', 'parent', 'question',
    identities.slice(at, at + 2).map((identity, index) => ({ identity, score: 1 - (at + index) / 10 })));
  const lanes = ['parent@a@said', 'parent@b@said', 'parent@c@said', 'parent@d@said'];
  for (const lane of lanes) host.sql.exec('INSERT INTO search_candidate_participation VALUES (?, ?, ?, ?)', 'sets', 'parent', 'question', lane);
  const sourceRevision = candidates.sourceRevision('sets', 'parent', 'question');
  const ref = { kind: 'sets', lane: 'parent', question: 'question', max_hits: null };
  let page = candidates.candidatePage(ref);
  const hits = page.rows.map(row => row.identity), participated = [...page.participated];
  assert.equal(page.more, true);
  assert.equal(page.rows.length, 2);
  assert.equal(page.participated.length, 2);
  host.db.close();
  host = sqliteHost(path);
  candidates = searchCandidatePages(host.sql, { pageSize: 2, transaction: host.transaction });
  for (let steps = 0; page.more; steps += 1) {
    assert.ok(steps < 8, 'the durable cursor makes forward progress');
    page = candidates.candidatePage(ref, page.cursor);
    assert.ok(page.rows.length <= 2 && page.participated.length <= 2);
    hits.push(...page.rows.map(row => row.identity));
    participated.push(...page.participated);
  }
  assert.deepEqual(hits, identities);
  assert.deepEqual(participated, lanes, 'lanes with no candidate hit remain present exactly once');
  let after = 0, more = true;
  for (let steps = 0; more; steps += 1) {
    assert.ok(steps < 8);
    const cleaned = candidates.deletePage('sets', 'parent', 'question', after);
    assert.ok(cleaned.deleted <= 2);
    after = cleaned.after; more = cleaned.more;
  }
  assert.deepEqual(candidates.candidatePage(ref).rows, []);
  assert.deepEqual(candidates.candidatePage(ref).participated, []);
  assert.ok(candidates.sourceRevision('sets', 'parent', 'question') > sourceRevision,
    'candidate and answered-empty changes leave a durable revision so a same-key re-add resets old fusion receipts');
});

test('retired lane discovery resumes past 128 subscriptions across SQLite reopen and fences same-ID re-add', async t => {
  const { mkdtempSync, rmSync } = await import('node:fs');
  const { tmpdir } = await import('node:os');
  const { join } = await import('node:path');
  const directory = mkdtempSync(join(tmpdir(), 'search-retired-discovery-'));
  const path = join(directory, 'search.sqlite');
  let host = sqliteHost(path);
  t.after(() => { host.db.close(); rmSync(directory, { recursive: true, force: true }); });
  resultsStore(host.sql,identity=>[identity]);
  makeSearch({ sql: host.sql, config: { ...settings, lanes: [] } });
  const lanes = ['meaning', ...Array.from({ length: 259 }, (_, at) => `retired-${String(at).padStart(3, '0')}`)].sort();
  for (const lane of lanes) host.sql.exec('INSERT INTO search_result_lanes (lane, kind, definition) VALUES (?, ?, ?)', lane, lane, `def-${lane}`);

  host.sql.exec('DELETE FROM search_retired_lane_discovery');
  let search;
  for (let page = 0; page < 9; page += 1) {
    if (page > 0) host.db.close();
    if (page > 0) host = sqliteHost(path);
    search = makeSearch({ sql: host.sql, config: { ...settings, lanes: [] } });
    const before = host.sql.exec('SELECT COUNT(*) AS n FROM search_result_lanes').one().n;
    await search.catchUp(32);
    const after = host.sql.exec('SELECT COUNT(*) AS n FROM search_result_lanes').one().n;
    assert.ok(before - after <= 32, 'one alarm queues and removes at most its configured discovery page');
    assert.ok(after < before || after === 0, 'discovery advances while subscriptions remain');
  }
  assert.equal(host.sql.exec('SELECT COUNT(*) AS n FROM search_result_lanes').one().n, 0,
    'more than 128 removed subscriptions are all discovered without another configuration change');
  assert.equal(host.sql.exec('SELECT complete FROM search_retired_lane_discovery WHERE singleton = 1').one().complete, 1);
  assert.equal(host.sql.exec('SELECT COUNT(*) AS n FROM search_retired_lane_cleanup').one().n, lanes.length);

  host.db.close();
  host = sqliteHost(path);
  const active = settings.lanes.find(lane => lane.id === 'meaning');
  search = makeSearch({ sql: host.sql, config: { ...settings, lanes: [active] } });
  assert.equal(host.sql.exec('SELECT COUNT(*) AS n FROM search_result_lanes WHERE lane = ?', active.id).one().n, 0,
    'a returning lane waits while its queued cleanup is pending');
  for (let step = 0; step < 120; step += 1) {
    const pending = host.sql.exec('SELECT 1 FROM search_retired_lane_cleanup WHERE lane = ? UNION ALL SELECT 1 FROM search_set_cleanup WHERE lane = ? LIMIT 1', active.id, active.id).toArray().length;
    const subscribed = host.sql.exec('SELECT 1 FROM search_result_lanes WHERE lane = ? LIMIT 1', active.id).toArray().length;
    if (!pending && subscribed) break;
    await search.catchUp(32);
  }
  assert.equal(host.sql.exec('SELECT COUNT(*) AS n FROM search_retired_lane_cleanup WHERE lane = ?', active.id).one().n, 0);
  assert.equal(host.sql.exec('SELECT COUNT(*) AS n FROM search_set_cleanup WHERE lane = ?', active.id).one().n, 0);
  assert.equal(host.sql.exec('SELECT COUNT(*) AS n FROM search_result_lanes WHERE lane = ?', active.id).one().n, 1,
    'same-ID re-add subscribes only after both durable cleanup walks finish');
});

test('retirement discovery pages current subscriptions before searching later retired rows',async t=>{
  const host=sqliteHost(':memory:');t.after(()=>host.db.close());
  const original=settings.lanes.find(lane=>lane.id==='meaning');
  const lanes=Array.from({length:12},(_,at)=>({...original,id:`active-${String(at).padStart(3,'0')}`}));
  const config={...settings,lanes};
  resultsStore(host.sql,identity=>[identity]);
  let search=makeSearch({sql:host.sql,config});
  host.sql.exec('INSERT INTO search_result_lanes(lane,kind,definition) VALUES (?,?,?)','z-retired','old','old-definition');
  host.sql.exec("UPDATE search_retired_lane_discovery SET complete=0,cursor='' WHERE singleton=1");
  await search.catchUp(4);
  const first=host.sql.exec('SELECT cursor,complete FROM search_retired_lane_discovery WHERE singleton=1').one();
  assert.equal(first.cursor,'active-003','one wake examines four subscriptions, including current ones');
  assert.equal(first.complete,0,'a current-only page still leaves discovery due');
  assert.equal(host.sql.exec('SELECT 1 FROM search_retired_lane_cleanup LIMIT 1').toArray().length,0);
  assert.ok(await search.stale());
  search=makeSearch({sql:host.sql,config});
  for(let wake=0;wake<3;wake++)await search.catchUp(4);
  assert.equal(host.sql.exec('SELECT complete FROM search_retired_lane_discovery WHERE singleton=1').one().complete,1);
  assert.equal(host.sql.exec('SELECT 1 FROM search_result_lanes WHERE lane=? LIMIT 1','z-retired').toArray().length,0);
  assert.equal(host.sql.exec('SELECT COUNT(*) AS n FROM search_result_lanes').one().n,lanes.length,'current subscriptions survive retirement discovery');
});

test('retirement cleanup pages use composite indexed seeks and return only the requested SQLite page', () => {
  const { sql } = person();
  makeSearch({ sql, config: { ...settings, lanes: [] } });
  const nearest = ['nearest', 'lane'];
  const specs = [
    { name: 'search_changed', where: 'lane = ?', values: ['lane'], columns: ['identity'] },
    { name: 'search_vectors', where: 'lane = ?', values: ['lane'], columns: ['identity', 'n'] },
    { name: 'search_word_rows', where: 'lane = ?', values: ['lane'], columns: ['identity', 'word_row'] },
    { name: 'search_marks', where: 'lane = ?', values: ['lane'], columns: ['identity'] },
    { name: 'search_set_lanes', where: 'lane = ?', values: ['lane'], columns: ['identity', 'set_lane'] },
    { name: 'search_nearest_walks', where: 'lane = ?', values: ['lane'], columns: ['question'] },
    { name: 'search_set_walks', where: 'lane = ?', values: ['lane'], columns: ['question', 'space'] },
    { name: 'search_set_results', where: 'lane = ?', values: ['lane'], columns: ['question'] },
    { name: 'search_walk_activity', where: 'kind = ? AND lane = ?', values: nearest, columns: ['question'] },
    { name: 'search_walk_cleanup', where: 'kind = ? AND lane = ?', values: ['sets', 'lane'], columns: ['question'] },
    { name: 'search_candidate_cleanup', where: 'kind = ? AND lane = ?', values: nearest, columns: ['question'] },
    { name: 'search_candidate_hits', where: 'kind = ? AND lane = ?', values: nearest, columns: ['question', 'seq'] },
    { name: 'search_candidate_participation', where: 'kind = ? AND lane = ?', values: nearest, columns: ['question', 'actual_lane'] },
    { name: 'search_candidate_revision', where: 'kind = ? AND lane = ?', values: nearest, columns: ['question'] },
    { name: 'search_encoder_walks', where: 'lane = ?', values: ['lane'], columns: ['question'] },
    { name: 'search_encoder_space_rows', where: 'lane = ?', values: ['lane'], columns: ['question', 'revision', 'space'] },
    { name: 'search_encoder_cleanup', where: 'lane = ?', values: ['lane'], columns: ['question', 'revision'] },
    { name: 'search_vector_centroids', where: 'lane = ?', values: ['lane'], columns: ['bucket'] },
    { name: 'search_vector_trained', where: 'lane = ?', values: ['lane'], columns: [] },
    { name: 'search_vector_counts', where: 'lane = ?', values: ['lane'], columns: [] },
    { name: 'search_vector_generation', where: 'lane = ?', values: ['lane'], columns: [] },
  ];
  for (const kind of ['encoder', 'nearest', 'sets']) specs.push({ name: 'search_walk_activity', where: 'kind = ? AND lane = ?', values: [kind, 'lane'], columns: ['question'] });
  for (const kind of ['nearest', 'sets']) {
    specs.push({ name: 'search_walk_cleanup', where: 'kind = ? AND lane = ?', values: [kind, 'lane'], columns: ['question'] });
    specs.push({ name: 'search_candidate_cleanup', where: 'kind = ? AND lane = ?', values: [kind, 'lane'], columns: ['question'] });
    specs.push({ name: 'search_candidate_hits', where: 'kind = ? AND lane = ?', values: [kind, 'lane'], columns: ['question', 'seq'] });
    specs.push({ name: 'search_candidate_participation', where: 'kind = ? AND lane = ?', values: [kind, 'lane'], columns: ['question', 'actual_lane'] });
    specs.push({ name: 'search_candidate_revision', where: 'kind = ? AND lane = ?', values: [kind, 'lane'], columns: ['question'] });
  }
  for (const spec of specs) {
    const cursor = spec.columns.map(column => /^(n|seq|bucket|word_row)$/.test(column) ? 0 : '');
    const plan = sql.exec(`EXPLAIN QUERY PLAN ${searchCleanupPageQuery({ ...spec, cursor })}`,
      ...spec.values, ...cursor, 4).toArray().map(row => row.detail).join(' | ');
    assert.match(plan, /SEARCH/i, `${spec.name} cleanup must use an indexed search: ${plan}`);
    assert.doesNotMatch(plan, /SCAN\s+\w+/i, `${spec.name} cleanup must not scan a table prefix: ${plan}`);
    assert.doesNotMatch(plan, /USE TEMP B-TREE/i, `${spec.name} cleanup order must come from the index: ${plan}`);
  }

  for (let at = 0; at < 600; at += 1) {
    sql.exec('INSERT INTO search_vectors (lane, identity, n, vector) VALUES (?, ?, 0, ?)',
      'target', `target-${String(at).padStart(4, '0')}`, new Uint8Array([127, 0, 0]));
  }
  const spec = { name: 'search_vectors', where: 'lane = ?', values: ['target'], columns: ['identity', 'n'] };
  const first = searchCleanupPage(sql, spec, [], 5, ...spec.values);
  const second = searchCleanupPage(sql, spec, first.cursor, 5, ...spec.values);
  assert.equal(first.rowids.length, 5);
  assert.equal(second.rowids.length, 5);
  assert.ok(second.rows[0].identity > first.rows.at(-1).identity, 'the persisted composite cursor seeks past the previous page');
  assert.equal(new Set([...first.rowids, ...second.rowids]).size, 10, 'adjacent cleanup pages never replay a row');
});

test('a meaning lane that cannot embed the question says why: the failure the meter wrapped, not only its wrapper', async () => {
  const { sql } = person();
  const lane = settings.lanes.find(item => item.id === 'speech-meaning');
  const refused = Object.assign(new Error('Resource quota: measurement_or_receipt_uncertain'), { cause: Object.assign(new Error('The model road refused: no admission'), { cause: new Error('quota object busy') }) });
  const search = makeSearch({ sql, config: { ...settings, lanes: [lane] }, embed: async () => { throw refused; } });
  const found = await finishPendingSearch(search, 'toss', { sources: ['files'], places: ['said'] });
  const said = found.unavailable.find(item => item.lane === lane.id);
  assert.ok(said, `the lane is named unavailable: ${JSON.stringify(found.unavailable)}`);
  assert.match(said.reason, /measurement_or_receipt_uncertain: The model road refused: no admission: quota object busy/);
});
