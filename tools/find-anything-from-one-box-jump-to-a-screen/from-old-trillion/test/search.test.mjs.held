// The one search (src/search.mjs): every result is one thing with the places it matched; words, meaning, names,
// records and a connected service each answer from what is kept; places and sources filter; a picture encoder still
// starting is pending, never guessed; a changed result is derived again; one file under two identities is one result.
import assert from 'node:assert/strict';
import test from 'node:test';
import { sqliteHost } from '../src/local-store.mjs';
import { namespaceStore } from '../../../recently-deleted-and-storage/namespace-store.mjs';
import { resultsStore } from '../src/namespace-results.mjs';
import { decisionStore } from '../../../keep-and-wake-ai-sessions-on-this-computer/src/decision-store.mjs';
import { makeSearch, searchOptions } from '../src/search.mjs';
import { searchCandidatePages } from '../../../answer-one-search-over-my-results-by-matching-words/src/search-candidate-pages.mjs';
import { searchCleanupPage, searchCleanupPageQuery } from '../../../keep-my-search-index-beside-a-copy-of-my-results/from-old-trillion/src/search-cleanup-pages.mjs';
import settings from '../../../shared-code/src/search.json' with { type: 'json' };
import { nativeNamespaceEvidence } from '../src/native-namespace-evidence.mjs';

const hex = (digit, index) => (digit + index.toString(16)).padEnd(64, digit);
const drive = index => `12:${hex('b', index)}`, own = index => `1f:${hex('a', index)}`;
const half = values => {
  const bits = new Uint16Array(values.map(value => {
    const f = new Float32Array([value]), i = new Uint32Array(f.buffer)[0];
    const sign = (i >>> 16) & 0x8000, exponent = ((i >>> 23) & 0xff) - 127 + 15, fraction = (i >>> 13) & 0x3ff;
    return value === 0 ? sign : sign | (exponent << 10) | fraction;
  }));
  return Buffer.from(bits.buffer).toString('base64');
};

function person() {
  const { sql } = sqliteHost(':memory:');
  const files = namespaceStore(sql);
  const results = resultsStore(sql, identity => files.identitiesOf(identity));
  const store = (index, name) => {
    sql.exec("INSERT INTO namespace_files (identity, byte_length, media_type, origin, key, part_bytes, stored_at, checked_at) VALUES (?, 10, 'video/mp4', 'small', 'k', 10, 'now', 'now')", own(index));
    files.addAliases(own(index), [drive(index)]);
    sql.exec("INSERT INTO namespace_names (name, collection, identity, byte_length, modified_at_ms, named_at) VALUES (?, '/Pottery', ?, 10, 5, 'now')", `/Pottery/${name}`, own(index));
  };
  const { eeaf } = decisionStore(sql);
  return { sql, results, store, eeaf };
}

async function finishIndexing(search) {
  for (let wake = 0; wake < 40 && (await search.stale()); wake += 1) await search.catchUp(10);
  assert.equal((await search.stale()), 0, 'the account alarm finishes the queued index work');
}

// A search response can name unfinished vector or set walks in `pending`. The consumer repeats the same request;
// the durable cursor resumes and the completed response carries the full ranked answer.
async function finishPendingSearch(search, question, options = {}, first = null) {
  let answer = first ?? await search.search(question, options);
  for (let page = 0; page < 2048 && answer.pending?.length; page += 1) answer = await search.search(question, options);
  assert.deepEqual(answer.pending, [], 'the repeated search request finishes its declared pending walk');
  return answer;
}

async function finishPendingIndexSearch(search, question, options = {}, first = null) {
  let answer = first ?? await search.indexSearch(question, options);
  for (let page = 0; page < 2048 && answer.pending?.length; page += 1) answer = await search.indexSearch(question, options);
  assert.deepEqual(answer.pending, [], 'the repeated index request finishes its declared pending walk');
  return answer;
}

test('each thing says where it matched, a thing found in several places ranks first, and places filter', async () => {
  const { sql, results, store, eeaf } = person();
  store(1, 'forehand.mp4');
  store(2, 'pottery serve.mp4');
  store(3, 'beach.mp4');
  results.put([
    { identity: drive(1), kind: 'transcript', value: { text: 'first the grip. now pottery footwork', segments: [{ start: 0, end: 3, text: 'first the grip.' }, { start: 41, end: 44, text: 'now pottery footwork' }] } },
    { identity: drive(2), kind: 'transcript', value: { text: 'we play pottery every day' } },
    { identity: drive(1), kind: 'picture-vectors', value: { frames: [{ t: 6, v: half([0, 1, 0]) }, { t: 12, v: half([1, 0, 0]) }] } },
    { identity: drive(3), kind: 'picture-vectors', value: { frames: [{ t: 2, v: half([0, 0, 1]) }] } },
    { identity: drive(3), kind: 'note', value: { text: 'no ball games here' } },
  ]);
  const runTool = async ({ tool_id }) => (tool_id === 'tool:words-as-picture-vector' ? { state: 'completed', output: { model: { name: 'ViT-B-32', pretrained: 'openai' }, vectors: [[1, 0, 0]] } } : { state: 'failed', error: 'not connected' });
  const search = makeSearch({ sql, eeaf, embed: null, runTool });
  await finishIndexing(search);
  const found = await search.search('pottery');
  const byName = Object.fromEntries(found.results.map(result => [result.name, result]));
  assert.deepEqual(byName['forehand.mp4'].found_in.sort(), ['said', 'seen']);
  assert.equal(byName['forehand.mp4'].places.find(place => place.place === 'said').start, 41);
  assert.equal(byName['forehand.mp4'].places.find(place => place.place === 'seen').start, 12, 'the best frame is found for a result kept as an average');
  assert.deepEqual(byName['pottery serve.mp4'].found_in.sort(), ['name', 'said']);
  assert.equal(byName['beach.mp4'], undefined, 'a picture under the floor and a note without the word are not matches');
  assert.equal(found.results.filter(result => result.source === 'files').length, 2, 'each file is one result, whichever identity its results were kept under');
  assert.ok(found.unavailable.some(item => item.source === 'github' && item.reason === 'Connect GitHub in Connections to search it.'));
  assert.deepEqual(byName['forehand.mp4'].bytes, `/work/api/namespace/bytes/${encodeURIComponent(own(1))}`);

  const saidOnly = await search.search('pottery', { places: ['said'] });
  assert.deepEqual(saidOnly.results.map(result => result.found_in), [['said'], ['said']]);
  const namesOnly = await search.search('pottery', { places: ['name'] });
  assert.deepEqual(namesOnly.results.map(result => result.name), ['pottery serve.mp4']);
});

test('a note kept only as text is called by its first line, never by its identity', async () => {
  const { sql, results, eeaf } = person();
  results.put([{ identity: drive(9), kind: 'note', value: { text: '\n# Ideas for the pottery camp\n- book the studio' } }]);
  const search = makeSearch({ sql, eeaf, embed: null, runTool: async () => ({ state: 'failed', error: 'not connected' }) });
  await finishIndexing(search);
  const found = await search.search('pottery', { places: ['written'], sources: ['files'] });
  assert.deepEqual(found.results.map(result => [result.title, result.name, result.found_in]), [['Ideas for the pottery camp', 'Ideas for the pottery camp', ['written']]]);
});

test('result-word search reads indexed identities rather than scanning every result JSON value', async () => {
  const { sql, results, store } = person();
  for (let index = 1; index <= 12; index += 1) {
    store(index, `clip ${index}.mp4`);
    results.put([{ identity: drive(index), kind: 'transcript', value: {
      text: index === 11 ? 'violet locomotive arriving' : `ordinary conversation ${index}`,
      segments: index === 11 ? [{ start: 14, end: 19, text: 'violet locomotive arriving' }] : [],
    } }]);
  }
  const note = drive(13);
  results.put([{ identity: note, kind: 'note', value: { text: 'violet locomotive checklist' } }]);
  const queries = [];
  const measured = { exec(query, ...values) { queries.push({ query, values }); return sql.exec(query, ...values); } };
  const search = makeSearch({ sql: measured, embed: null });
  for (let wake = 0; wake < 30 && (await search.stale()); wake += 1) await search.catchUp(10);
  assert.equal((await search.stale()), 0);
  queries.length = 0;
  const found = await search.search('violet locomotive', { places: ['said', 'written'], sources: ['files'] });
  assert.deepEqual(found.results.map(result => result.identity).sort(), [own(11), note].sort());
  assert.equal(found.results.find(result => result.identity === own(11)).start, 14);
  assert.ok(queries.some(({ query }) => /FROM search_words WHERE search_words MATCH/.test(query)));
  assert.equal(queries.some(({ query }) => /instr\(lower\(json_extract\(value/.test(query)), false,
    'matching never scans every JSON value of a result kind');
  assert.ok(queries.filter(({ query }) => /SELECT json_extract\(value/.test(query))
    .every(({ query }) => /identity = \?|identity IN/.test(query)),
  'a value is read only after its identity was selected');
  results.put([{ identity: note, kind: 'note', value: { text: 'another checklist' } }]);
  const changed = await search.search('violet locomotive', { places: ['written'], sources: ['files'] });
  assert.deepEqual(changed.results, [], 'a changed value leaves the word index');
});

test('a foreground word search reports pending indexing without deriving unrelated source values', async () => {
  const { sql, results } = person();
  const queries = [];
  const measured = { exec(query, ...values) { queries.push(query); return sql.exec(query, ...values); } };
  const search = makeSearch({ sql: measured });
  results.put([
    { identity: drive(17), kind: 'note', value: { text: 'orchid garden' } },
    { identity: drive(18), kind: 'speech-vectors', value: { chunks: [{ start: 1, end: 2, text: 'orchid', v: half([1, 0, 0]) }] } },
  ]);
  const before = (await search.stale());
  queries.length = 0;
  const early = await search.search('orchid', { matches: ['words-in-results'], sources: ['files'] });
  assert.deepEqual(early.results, []);
  assert.equal(early.still_reading.notes, 1);
  assert.equal((await search.stale()), before, 'a read leaves index work for the account alarm');
  assert.equal(queries.some(query => /(?:INSERT|UPDATE|DELETE) (?:INTO |FROM )?(?:search_changed|search_marks|search_vectors|search_words)/.test(query)), false,
    'a word-only read writes no index, including meaning vectors it did not ask for');
  await finishIndexing(search);
  const ready = await search.search('orchid', { matches: ['words-in-results'], sources: ['files'] });
  assert.deepEqual(ready.results.map(result => result.identity), [drive(17)]);
  assert.deepEqual(ready.still_reading, {});
});

// A lane still reading is a search still working, never an empty answer: every screen (Files, Media, the layers panel) and
// the search tool an AI calls read `pending` to say "still looking" and ask again, so a lane still reading is named there
// (a follower rebuilding its lanes after the account's results moved, src/search-follower.mjs resultsMoved).
test('an answer with no results and one lane still reading names it pending, never a final empty answer', async () => {
  const { sql } = person();
  const search = makeSearch({ sql, index: false });
  const options = { matches: ['words-in-results'], sources: ['files'] };
  const lane = settings.lanes.find(item => item.match === 'words-in-results' && item.source === 'files');
  const answer = await search.finish('orchid', options, { answered: [], unavailable: [], pending: [], still_reading: { [lane.id]: 1 } });
  assert.deepEqual(answer.results, []);
  assert.deepEqual(answer.pending.filter(item => item.lane === lane.id), [{ lane: lane.id, place: lane.place, source: lane.source }]);
  assert.ok(answer.places.some(place => place.id === lane.place), 'the screen names the place it is still looking in');
  const whole = await search.finish('orchid', options, { answered: [], unavailable: [], pending: [], still_reading: {} });
  assert.deepEqual(whole.pending, [], 'an answer with every lane read is final');
});

test('speech meaning counts above its floor, or lower when the passage holds every word; no model means unavailable', async () => {
  const { sql, results, store } = person();
  store(1, 'a.mp4');
  store(2, 'b.mp4');
  results.put([
    { identity: drive(1), kind: 'speech-vectors', value: { chunks: [{ start: 30, end: 34, text: 'lift it up above your head', v: half([1, 0, 0]) }] } },
    { identity: drive(2), kind: 'speech-vectors', value: { chunks: [{ start: 5, end: 9, text: 'the toss goes up', v: half([0.5, 0.866, 0]) }] } },
  ]);
  const embed = async (model, texts) => { assert.equal(model, '@cf/baai/bge-small-en-v1.5'); assert.ok(texts[0].endsWith('toss')); return [[1, 0, 0]]; };
  const search = makeSearch({ sql, embed });
  await finishIndexing(search);
  const found = await finishPendingSearch(search, 'toss', { sources: ['files'] });
  assert.deepEqual(found.results.map(result => [result.name, result.start, result.said]), [['a.mp4', 30, 'lift it up above your head'], ['b.mp4', 5, 'the toss goes up']]);
  const without = await makeSearch({ sql, embed: null }).search('toss', { places: ['said'] });
  assert.ok(without.unavailable.some(item => item.lane === 'speech-meaning'));
  // A quick answer names only the word mechanisms: no model is asked, and what the words find still answers.
  const asked = [];
  const quick = await makeSearch({ sql, embed: async () => { asked.push('model'); return [[1, 0, 0]]; } }).search('toss', { sources: ['files'], matches: ['words-in-results', 'words-in-names'] });
  assert.deepEqual(asked, [], 'no model asked for a words-only answer');
  assert.ok(quick.results.every(result => result.name !== 'a.mp4'), 'the meaning-only match is not found by words');
});

test('meaning search yields between complete vector pages without losing moments at an identity boundary', async () => {
  const { sql } = person();
  const lane = settings.lanes.find(item => item.id === 'speech-meaning');
  const config = { ...settings, lanes: [lane], vector_scan_page_size: 2 };
  let timerFired = false;
  const search = makeSearch({ sql, config, embed: async () => {
    setTimeout(() => { timerFired = true; }, 0);
    return [[1, 0, 0]];
  } });
  for (const [identity, n, start] of [[drive(1), 0, 1], [drive(1), 1, 10], [drive(1), 2, 20], [drive(2), 0, 30]]) {
    sql.exec('INSERT INTO search_vectors (lane, identity, n, start, finish, said, vector) VALUES (?, ?, ?, ?, ?, ?, ?)', lane.id, identity, n, start, start + 2, 'toss', new Uint8Array([127, 0, 0]));
  }
  const found = await finishPendingSearch(search, 'toss', { sources: ['files'], places: ['said'] });
  assert.equal(timerFired, true, 'another event runs while the vector scan continues');
  assert.deepEqual(found.results.find(item => item.identity === drive(1)).moments.map(moment => moment.start), [1, 10, 20]);
  assert.deepEqual(found.results.find(item => item.identity === drive(2)).moments.map(moment => moment.start), [30]);
});

test('expired nearest candidate cleanup remains fenced until its saved rows drain', async () => {
  const { sql } = person();
  const lane = settings.lanes.find(item => item.id === 'speech-meaning');
  const search = makeSearch({ sql, config: { ...settings, lanes: [lane] }, embed: async () => [[1, 0, 0]] });
  sql.exec('INSERT INTO search_vectors (lane, identity, n, start, finish, said, vector) VALUES (?, ?, 0, 1, 2, ?, ?)',
    lane.id, own(1), 'old hit', new Uint8Array([127, 0, 0]));
  const first = await search.indexSearch('toss', { places: ['said'] });
  const key = sql.exec('SELECT question FROM search_nearest_walks WHERE lane = ? LIMIT 1', lane.id).one().question;
  assert.equal(first.candidate_refs.length, 1);
  const candidates = searchCandidatePages(sql);
  candidates.putPage('nearest', lane.id, key, [{ identity: own(2), score: 0.99 }]);
  sql.exec("INSERT INTO search_candidate_cleanup (kind, lane, question, after_seq) VALUES ('nearest', ?, ?, 0)", lane.id, key);
  const queuedRows = sql.exec('SELECT identity FROM search_candidate_hits WHERE kind = ? AND lane = ? AND question = ? ORDER BY identity', 'nearest', lane.id, key).toArray();
  assert.deepEqual(queuedRows.map(row => row.identity), [own(1), own(2)].sort(), 'both the original match and injected stale candidate are retained');

  const waiting = await search.indexSearch('toss', { places: ['said'] });
  assert.ok(waiting.pending.some(item => item.lane === lane.id));
  assert.deepEqual(waiting.candidate_refs, [], 'a new transfer cannot include rows queued for cleanup');
  assert.equal(sql.exec('SELECT COUNT(*) AS n FROM search_candidate_cleanup WHERE lane = ? AND question = ?', lane.id, key).one().n, 1,
    'the bounded alarm cleanup keeps ownership of the cursor');
  assert.deepEqual(sql.exec('SELECT identity FROM search_candidate_hits WHERE kind = ? AND lane = ? AND question = ? ORDER BY identity', 'nearest', lane.id, key).toArray(), queuedRows,
    'the search does not restart into or replace the still-present stale candidates');
});

test('average-lane refinement reads only its configured strongest candidate page', async () => {
  const { sql } = person();
  const queries = [];
  const measured = { exec(query, ...values) { queries.push({ query, values }); return sql.exec(query, ...values); } };
  const base = settings.lanes.find(item => item.id === 'picture-meaning');
  const lane = { ...base, encoder: { via: 'workers-ai', model: 'fixture' }, floor: 0, rank: 1 };
  const config = { ...settings, lanes: [lane], refine_top: 3, vector_scan_page_size: 400 };
  const search = makeSearch({ sql: measured, config, embed: async () => [[1, 0, 0]] });
  for (let at = 0; at < 300; at += 1) sql.exec(
    'INSERT INTO search_vectors (lane, identity, n, start, finish, said, vector) VALUES (?, ?, 0, ?, ?, ?, ?)',
    lane.id, own(1000 + at), at, at + 1, `frame ${at}`, new Uint8Array([127 - (at % 2), 1, 0]));

  const answer = await search.indexSearch('studio', { places: ['seen'] });
  assert.equal(answer.answered[0].length, 3, 'only the strongest configured results are refined');
  const rankedReads = queries.filter(({ query }) => /FROM search_candidate_hits[\s\S]*ORDER BY score DESC, seq ASC LIMIT \?/.test(query));
  assert.equal(rankedReads.length, 1);
  assert.equal(rankedReads[0].values.at(-1), 4, 'the source read is refine_top plus one lookahead row');
});

test('a picture encoder still starting is pending, and a changed result is derived again', async () => {
  const { sql, results, store } = person();
  store(1, 'a.mp4');
  results.put([{ identity: drive(1), kind: 'picture-vectors', value: { frames: [{ t: 1, v: half([0, 1, 0]) }] } }]);
  let state = 'working';
  const runTool = async () => (state === 'working' ? { state } : { state, output: { model: { name: 'ViT-B-32', pretrained: 'openai' }, vectors: [[1, 0, 0]] } });
  const search = makeSearch({ sql, runTool });
  await finishIndexing(search);
  const waiting = await search.search('studio', { places: ['seen'] });
  assert.deepEqual(waiting.pending.map(item => item.place), ['seen']);
  assert.deepEqual(waiting.results, []);
  state = 'completed';
  assert.deepEqual((await search.search('studio', { places: ['seen'] })).results, [], 'the frame does not look like it');
  results.put([{ identity: drive(1), kind: 'picture-vectors', value: { frames: [{ t: 7, v: half([1, 0, 0]) }] } }]);
  assert.equal((await search.stale()), 1);
  await finishIndexing(search);
  const seen = await search.search('studio', { places: ['seen'] });
  assert.deepEqual(seen.results.map(result => [result.name, result.start]), [['a.mp4', 7]]);
  assert.equal((await search.stale()), 0);
});

test('scheduler checks a settled search without scanning every result again', async () => {
  const { sql, results } = person();
  const queries = [];
  const measured = { exec(query, ...values) { queries.push(query); return sql.exec(query, ...values); } };
  const search = makeSearch({ sql: measured });
  const fullCounts = () => queries.filter(query => /FROM namespace_results r LEFT JOIN search_marks m/.test(query)).length;
  assert.equal((await search.stale()), 0);
  const firstCounts = fullCounts();
  assert.equal(firstCounts, 0, 'an empty store needs no whole-result migration scan');
  assert.equal((await search.stale()), 0);
  assert.equal(fullCounts(), firstCounts, 'an unchanged store uses its revision');
  results.put([{ identity: own(2), kind: 'note', value: { text: 'unindexed note' } }]);
  assert.equal(sql.exec("SELECT COUNT(*) AS n FROM search_changed WHERE identity = ?", own(2)).toArray()[0].n, 1,
    'notes now enter their indexed words lane');
  const reopened = makeSearch({ sql: measured });
  assert.equal((await reopened.stale()), 1, 'the note still needs its indexed words');
  assert.equal(fullCounts(), firstCounts, 'a new Durable Object instance reuses the saved check');
  results.put([{ identity: own(1), kind: 'contents', value: { text: 'new words' } }]);
  assert.equal((await search.stale()), 2, 'the note and new document both need catch-up');
  assert.equal(fullCounts(), firstCounts, 'a changed revision does not scan the result table');
  assert.deepEqual(await search.catchUp(10), {});
  const caughtUpCounts = fullCounts();
  assert.equal((await search.stale()), 0);
  assert.equal(fullCounts(), caughtUpCounts);
  const settledQueries = queries.length;
  assert.deepEqual(await search.catchUp(10), {});
  assert.equal(queries.slice(settledQueries).filter(query => /namespace_results r LEFT JOIN search_marks m|DELETE FROM search_marks|DELETE FROM search_vectors|DELETE FROM search_words/.test(query)).length, 0,
    'another search skips result scans and cleanup when those kinds did not change');
  assert.equal(results.remove(own(1), 'contents').removed, 1);
  assert.equal((await search.stale()), 1, 'removing a value also schedules index cleanup');
  assert.deepEqual(await search.catchUp(10), {});
  assert.equal((await search.stale()), 0);
});

test('records and a connected service are sources; the service reads its account once and fills its question', async () => {
  const { sql, eeaf } = person();
  eeaf.write([
    { id: 'case-1', type: 'decision', value: { input: { goal: 'Which pottery racket to buy' } } },
    { id: 'case-2', type: 'decision', value: { input: { goal: 'Where to live' } } },
    { id: 'note-1', type: 'pursuit', value: { title: 'Play pottery weekly' } },
  ], { actor: { by: 'test' } });
  const asked = [];
  const runTool = async ({ tool_id, input }) => {
    asked.push([tool_id, input]);
    if (tool_id === 'tool:github-find_my_account') return { state: 'completed', output: { login: 'someone' } };
    const url = tool_id === 'tool:github-search_code' ? 'https://github.com/someone/studio/blob/main/README.md' : `https://github.com/someone/studio/${tool_id}`;
    return { state: 'completed', output: { total_count: 1, items: [{ path: 'README.md', html_url: url, repository: { full_name: 'someone/studio' }, full_name: 'someone/studio', title: 'Studio booking', text_matches: [{ fragment: 'a pottery studio finder' }] }] } };
  };
  const search = makeSearch({ sql, eeaf, runTool });
  await finishIndexing(search);
  const found = await search.search('pottery', { sources: ['trillion', 'github'] });
  const decision = found.results.find(result => result.source === 'trillion');
  assert.deepEqual([decision.title, decision.kind_label, decision.open], ['Which pottery racket to buy', 'Decision', { id: 'trillion.decision', title: 'Which pottery racket to buy', surfaceInput: { screen: 'decision', id: 'case-1' } }]);
  const code = found.results.find(result => result.kind_label === 'Code');
  assert.deepEqual([code.title, code.url, code.said, code.found_in], ['README.md', 'https://github.com/someone/studio/blob/main/README.md', 'a pottery studio finder', ['written']]);
  assert.deepEqual(asked.filter(([tool]) => tool === 'tool:github-search_code').map(([, input]) => input), [{ query: 'pottery user:someone' }]);
  assert.equal(asked.filter(([tool]) => tool === 'tool:github-find_my_account').length, 1);
});

test('record text searches use the alarm-fed index and validate edits and removals before catch-up', async () => {
  const { sql, eeaf } = person();
  for (let n = 0; n < 500; n += 1) eeaf.write([{ id: `message:${String(n).padStart(4, '0')}`, type: 'message', value: { text: n === 2 ? 'rare violet locomotive' : `ordinary message ${n}` } }]);
  const indexed = { ...eeaf, find() { throw new Error('a signed-in search must not walk the record log'); } };
  const search = makeSearch({ sql, eeaf: indexed });
  const before = await search.search('violet locomotive', { places: ['written'], sources: ['trillion'] });
  assert.deepEqual(before.results, []);
  assert.equal(before.still_reading.messages, 1);
  for (let wake = 0; wake < 40 && (await search.stale()); wake += 1) await search.catchUp(50);
  assert.equal((await search.stale()), 0, 'the bounded alarm eventually admits old records');
  assert.deepEqual((await search.search('violet locomotive', { places: ['written'], sources: ['trillion'] })).results.map(row => row.id), ['record:message:0002']);

  eeaf.write([{ id: 'message:0002', type: 'message', value: { text: 'ordinary replacement' } }]);
  const changed = await search.search('violet locomotive', { places: ['written'], sources: ['trillion'] });
  assert.deepEqual(changed.results, [], 'a stale FTS row cannot return edited text');
  assert.equal(changed.still_reading.messages, 1);
  await search.catchUp(50);
  assert.equal((await search.stale()), 0);
  eeaf.write([{ id: 'message:0002', type: 'message', value: { text: 'violet locomotive again' } }]);
  await search.catchUp(50);
  assert.deepEqual((await search.search('violet locomotive', { places: ['written'], sources: ['trillion'] })).results.map(row => row.id), ['record:message:0002']);
  eeaf.write([{ id: 'message:0002', type: 'message', value: null }]);
  assert.deepEqual((await search.search('violet locomotive', { places: ['written'], sources: ['trillion'] })).results, [], 'a removed record is refused immediately');
  await search.catchUp(50);
  assert.equal((await search.stale()), 0);
  assert.deepEqual((await search.search('violet locomotive', { places: ['written'], sources: ['trillion'] })).results, []);
});

test('a service still working is pending and never holds back what is found; the same run answers the next ask', async () => {
  const { sql, store, eeaf } = person();
  store(1, 'pottery serve.mp4');
  let state = 'working';
  const waits = new Set();
  const runTool = async ({ tool_id, wait_seconds }) => {
    waits.add(wait_seconds);
    if (state === 'working') return { state };
    return tool_id === 'tool:github-find_my_account' ? { state, output: { login: 'someone' } } : { state, output: { items: [{ full_name: 'someone/pottery', html_url: 'https://github.com/someone/pottery' }] } };
  };
  const search = makeSearch({ sql, eeaf, runTool });
  const first = await search.search('pottery', { sources: ['files', 'github'], places: ['name'] });
  assert.deepEqual([first.results.map(result => result.name), first.pending.map(item => item.lane)], [['pottery serve.mp4'], ['github-repositories']]);
  assert.deepEqual([...waits], [settings.tool_wait_seconds]);
  state = 'completed';
  const next = await search.search('pottery', { sources: ['github'], places: ['name'] });
  assert.deepEqual([next.results.map(result => result.title), next.pending], [['someone/pottery'], []]);
});

test('search names no place, source or kind in its code: every lane is DATA', async () => {
  const { readFileSync } = await import('node:fs');
  const code = readFileSync(new URL('../src/search.mjs', import.meta.url), 'utf8').replace(/^\s*\/\/.*$/gm, '');
  for (const word of [...settings.places.map(place => place.id), ...settings.sources.map(source => source.id), ...settings.lanes.map(lane => lane.kind).filter(Boolean)]) {
    assert.equal(new RegExp(`['"\`]${word}['"\`]`).test(code), false, `${word} is named in search.mjs`);
  }
  assert.deepEqual(searchOptions(new URLSearchParams('places=said,seen&limit=5')), { places: ['said', 'seen'], sources: null, matches: null, limit: 5 });
  assert.deepEqual(searchOptions(new URLSearchParams('matches=words-in-names')).matches, ['words-in-names']);
});

test('catching up reads one stored value at a time, so a store full of large results never holds a step of them at once', async () => {
  const { sql, results, store } = person();
  for (let index = 1; index <= 5; index += 1) {
    store(index, `clip ${index}.mp4`);
    results.put([{ identity: drive(index), kind: 'speech-vectors', value: { chunks: [{ start: 0, end: 2, text: `words ${index}`, v: half([1, 0, 0]) }] } }]);
  }
  let mostValuesAtOnce = 0;
  const counting = { exec: (query, ...values) => {
    const cursor = sql.exec(query, ...values);
    if (!/namespace_results/.test(query) || !/\bvalue\b/.test(query.replace(/value_identity|json_each\(\?\)|SELECT value FROM json_each/g, ''))) return cursor;
    const rows = cursor.toArray();
    mostValuesAtOnce = Math.max(mostValuesAtOnce, rows.filter(row => typeof row.value === 'string').length);
    return { toArray: () => rows };
  } };
  const search = makeSearch({ sql: counting });
  assert.deepEqual(await search.catchUp(2), { 'speech-meaning': 1 }, 'a wake derives only as many results as it is given, then checks for more with an indexed seek');
  assert.ok(sql.exec("SELECT count(*) AS n FROM search_changed WHERE lane = 'speech-meaning'").toArray()[0].n <= 2,
    'old results enter the queue a bounded page at a time');
  for (let wake = 0; wake < 10 && (await search.stale()); wake += 1) await search.catchUp(10);
  assert.equal((await search.stale()), 0, 'repeated bounded wakes fill the earlier results');
  assert.equal(mostValuesAtOnce, 1, 'no read brought more than one stored value into memory');
  assert.equal(sql.exec("SELECT count(*) AS n FROM search_marks WHERE lane = 'speech-meaning'").toArray()[0].n, 5);
});

test('a settled search uses indexed queue seeks, while changed and deleted results update one identity', async () => {
  const { sql, results } = person();
  const search = makeSearch({ sql });
  const speech = (identity, start) => ({ identity, kind: 'speech-vectors', value: { chunks: [{ start, end: start + 2, text: 'serve', v: half([1, 0, 0]) }] } });
  results.put([speech(drive(1), 1), speech(drive(2), 2)]);
  assert.equal((await search.stale()), 1);
  assert.deepEqual(await search.catchUp(10), {});
  const queries = [];
  const measured = { exec(query, ...values) { queries.push(query); return sql.exec(query, ...values); } };
  const reopened = makeSearch({ sql: measured });
  queries.length = 0;
  assert.equal((await reopened.stale()), 0);
  assert.deepEqual(await reopened.catchUp(50), {});
  assert.equal(queries.some(query => /FROM namespace_results|DELETE FROM search_vectors|DELETE FROM search_marks/.test(query)), false,
    'a clean alarm reads the queue, not the result or vector tables');
  results.put([speech(drive(1), 4), speech(drive(1), 7)]);
  assert.equal(sql.exec("SELECT count(*) AS n FROM search_changed WHERE lane = 'speech-meaning'").toArray()[0].n, 1,
    'several writes before catch-up collapse to one identity');
  assert.equal((await reopened.stale()), 1);
  assert.deepEqual(await reopened.catchUp(10), {});
  assert.equal(sql.exec("SELECT start FROM search_vectors WHERE lane = 'speech-meaning' AND identity = ?", drive(1)).toArray()[0].start, 7);
  sql.exec("DELETE FROM namespace_results WHERE identity = ? AND kind = 'speech-vectors'", drive(1));
  assert.equal((await reopened.stale()), 1, 'direct source deletion also queues index cleanup');
  assert.deepEqual(await reopened.catchUp(10), {});
  assert.equal(sql.exec("SELECT count(*) AS n FROM search_vectors WHERE lane = 'speech-meaning' AND identity = ?", drive(1)).toArray()[0].n, 0);
  assert.equal(sql.exec("SELECT count(*) AS n FROM search_marks WHERE lane = 'speech-meaning' AND identity = ?", drive(1)).toArray()[0].n, 0);
  results.put([{ identity: drive(3), kind: 'note', value: { text: 'unwatched' } }]);
  assert.equal((await reopened.stale()), 1, 'notes now have a watched words lane');
});

test('the same change queue updates and removes indexed document words', async () => {
  const { sql, results } = person();
  const identity = drive(8);
  const search = makeSearch({ sql });
  const hits = word => sql.exec('SELECT COUNT(*) AS n FROM search_words WHERE search_words MATCH ? AND lane = ?', word, 'contents-words').toArray()[0].n;
  results.put([{ identity, kind: 'contents', value: { text: 'blue orchid' } }]);
  assert.equal((await search.stale()), 1);
  assert.deepEqual(await search.catchUp(1), {});
  assert.equal(hits('orchid'), 1);
  results.put([{ identity, kind: 'contents', value: { text: 'red dune' } }]);
  assert.equal((await search.stale()), 1);
  assert.deepEqual(await search.catchUp(1), {});
  assert.equal(hits('orchid'), 0);
  assert.equal(hits('dune'), 1);
  results.remove(identity, 'contents');
  assert.equal((await search.stale()), 1);
  assert.deepEqual(await search.catchUp(1), {});
  assert.equal(hits('dune'), 0);
  assert.equal((await search.stale()), 0);
});

test('first queue admission preserves vectors already derived by an earlier release', async () => {
  const { sql, results } = person();
  const one = drive(1), two = drive(2), removed = drive(3);
  const value = { chunks: [{ start: 1, end: 2, text: 'serve', v: half([1, 0, 0]) }] };
  results.put([{ identity: one, kind: 'speech-vectors', value }, { identity: two, kind: 'speech-vectors', value }]);
  sql.exec('CREATE TABLE search_marks (lane TEXT NOT NULL, identity TEXT NOT NULL, value_identity TEXT NOT NULL, PRIMARY KEY (lane, identity))');
  sql.exec('CREATE TABLE search_vectors (lane TEXT NOT NULL, identity TEXT NOT NULL, n INTEGER NOT NULL, start REAL, finish REAL, said TEXT, vector BLOB NOT NULL, PRIMARY KEY (lane, identity, n))');
  const valueIdentity = sql.exec("SELECT value_identity FROM namespace_results WHERE identity = ? AND kind = 'speech-vectors'", one).toArray()[0].value_identity;
  sql.exec("INSERT INTO search_marks (lane, identity, value_identity) VALUES ('speech-meaning', ?, ?)", one, valueIdentity);
  sql.exec("INSERT INTO search_vectors (lane, identity, n, start, finish, said, vector) VALUES ('speech-meaning', ?, 0, 1, 2, 'serve', ?)", one, new Uint8Array([127, 0, 0]));
  sql.exec("INSERT INTO search_marks (lane, identity, value_identity) VALUES ('speech-meaning', ?, ?)", removed, valueIdentity);
  sql.exec("INSERT INTO search_vectors (lane, identity, n, start, finish, said, vector) VALUES ('speech-meaning', ?, 0, 1, 2, 'serve', ?)", removed, new Uint8Array([127, 0, 0]));
  const search = makeSearch({ sql });
  assert.equal((await search.stale()), 1, 'old results are admitted through bounded wakes');
  assert.equal(sql.exec("SELECT count(*) AS n FROM search_vectors WHERE lane = 'speech-meaning' AND identity = ?", one).toArray()[0].n, 1);
  for (let wake = 0; wake < 10 && (await search.stale()); wake += 1) await search.catchUp(10);
  assert.equal((await search.stale()), 0);
  assert.equal(sql.exec("SELECT count(*) AS n FROM search_vectors WHERE lane = 'speech-meaning'").toArray()[0].n, 2);
});

test('a large first admission stays paged and changes behind its cursor still reach the index', async () => {
  const { sql, results } = person();
  const total = 120;
  const identity = index => `12:${index.toString(16).padStart(4, '0').padEnd(64, 'b')}`;
  results.put(Array.from({ length: total }, (_, index) => ({ identity: identity(index + 1), kind: 'contents', value: { text: `old word ${index + 1}` } })));
  assert.equal(sql.exec("SELECT count(*) AS n FROM namespace_results WHERE kind = 'contents'").toArray()[0].n, total);
  const calls = [];
  const measured = { exec(query, ...values) {
    calls.push({ query, values });
    return sql.exec(query, ...values);
  } };
  const search = makeSearch({ sql: measured });
  assert.equal((await search.stale()), 1);
  assert.equal(calls.some(({ query }) => /^INSERT(?: OR IGNORE)? INTO search_changed[^]*SELECT/.test(query)), false,
    'lane registration never inserts an entire source scan');
  const first = identity(1);
  results.put([{ identity: first, kind: 'contents', value: { text: 'fresh orchid' } }]);
  for (let wake = 0; wake < 40 && (await search.stale()); wake += 1) await search.catchUp(10);
  assert.equal((await search.stale()), 0, 'all old results eventually become searchable');
  assert.equal(sql.exec("SELECT count(*) AS n FROM search_marks WHERE lane = 'contents-words'").toArray()[0].n, total);
  assert.equal(sql.exec("SELECT count(*) AS n FROM search_words WHERE search_words MATCH 'orchid' AND lane = 'contents-words'").toArray()[0].n, 1,
    'a changed identity already passed by the migration cursor is not missed');
  const admissions = calls.filter(({ query }) => /SELECT identity, value_identity FROM namespace_results WHERE kind = \? AND identity > \?/.test(query));
  assert.ok(admissions.length > 1);
  assert.ok(admissions.every(({ values }) => values.at(-1) <= 50), 'each source walk is bounded to one small page');
});

test('removing a meaning lane also removes its trigger subscription and derived data', async () => {
  const { sql, results } = person();
  const identity = drive(1);
  const value = { chunks: [{ start: 1, end: 2, text: 'serve', v: half([1, 0, 0]) }] };
  const search = makeSearch({ sql });
  results.put([{ identity, kind: 'speech-vectors', value }]);
  await search.catchUp(10);
  const withoutSpeech = { ...settings, lanes: settings.lanes.filter(lane => lane.id !== 'speech-meaning') };
  const retired = makeSearch({ sql, config: withoutSpeech });
  await finishIndexing(retired);
  assert.equal(sql.exec("SELECT count(*) AS n FROM search_result_lanes WHERE lane = 'speech-meaning'").toArray()[0].n, 0);
  assert.equal(sql.exec("SELECT count(*) AS n FROM search_vectors WHERE lane = 'speech-meaning'").toArray()[0].n, 0);
  results.put([{ identity, kind: 'speech-vectors', value: { ...value, updated: true } }]);
  assert.equal(sql.exec("SELECT count(*) AS n FROM search_changed WHERE lane = 'speech-meaning'").toArray()[0].n, 0);
});

// 'what is my EIN' read 508,000 rows a search on one owner's store (2026-10-06): the word index walked and scored every
// document holding 'what' and 'is' to rank by a word only one document holds. A word held by over common_ratio times as
// many documents as the rarest asked word is left out of the index query; every word is still checked where it must be.
test('a word nearly every document holds is left out of the word index query, and the rare word still finds its file', async () => {
  const { sql, results } = person();
  const docs = settings.common_ratio + 20;
  results.put(Array.from({ length: docs }, (_, n) => ({ identity: own(n + 1), kind: 'contents', value: { text: n === 7 ? 'what is the ein of the club' : `what is on the studio today ${n}` } })));
  const matched = [];
  const measured = { exec(query, ...args) { if (/search_words MATCH/.test(query)) matched.push(args[0]); return sql.exec(query, ...args); } };
  const search = makeSearch({ sql: measured, embed: null });
  while ((await search.stale())) await search.catchUp(100);
  const found = await search.search('what is the ein', { matches: ['words-in-index'] });
  assert.deepEqual(found.results.map(result => result.identity), [own(8)]);
  assert.ok(matched.length > 0 && matched.every(query => query === '"ein"*'), 'each result word lane drops the common words');
  matched.length = 0;
  const every = await search.search('what is', { matches: ['words-in-index'] });
  assert.ok(every.results.length > 0, 'words that are all common are all asked');
  assert.ok(matched.length > 0 && matched.every(query => query === '"what"* OR "is"*'), 'each result word lane asks both common words');
});

test('a question a Marketplace tool encodes is encoded once where tools run, and an index that cannot run tools answers with that vector', async () => {
  const { sql, results, store } = person();
  store(1, 'a.mp4');
  results.put([{ identity: drive(1), kind: 'picture-vectors', value: { frames: [{ t: 7, v: half([1, 0, 0]) }] } }]);
  let state = 'working', runs = 0;
  const runTool = async () => { runs += 1; return state === 'working' ? { state } : { state, output: { model: { name: 'ViT-B-32', pretrained: 'openai' }, vectors: [[1, 0, 0]] } }; };
  // As in the store: the index is kept by an owner with no Marketplace tools (the follower, the frozen index) and the
  // answer is finished by the owner that can run them.
  const indexOwner = makeSearch({ sql });
  const finisher = makeSearch({ sql, runTool, index: false });
  await finishIndexing(indexOwner);
  const options = { places: ['seen'] };
  const unaided = await indexOwner.indexSearch('studio', options);
  assert.deepEqual(unaided.unavailable.map(item => item.reason), ['no Marketplace tools here'], 'the index alone cannot encode the question');
  const working = await finisher.encodeQuestion('studio', options);
  const waiting = await finisher.finish('studio', options, await indexOwner.indexSearch('studio', { ...options, encoded: working }));
  assert.deepEqual(waiting.pending.map(item => item.place), ['seen'], 'an encoder still starting is pending, never unavailable');
  assert.deepEqual(waiting.unavailable, []);
  state = 'completed';
  const encoded = await finisher.encodeQuestion('studio', options);
  assert.ok(Object.values(encoded).every(item => Array.isArray(item.vector)), 'the vector travels as plain numbers');
  const found = await finisher.finish('studio', options, await indexOwner.indexSearch('studio', { ...options, encoded }));
  assert.deepEqual(found.results.map(result => [result.name, result.start]), [['a.mp4', 7]]);
  assert.deepEqual(found.unavailable, []);
  assert.equal(runs, 2, 'each question is encoded by the finisher only, once per ask');
  const words = await finisher.encodeQuestion('studio', { matches: ['words-in-results'] });
  assert.deepEqual(words, {}, 'a question that asks no meaning lane runs no encoder');
});

test('the device evidence search asks the said-words lane, so a spoken word is found', async () => {
  const { sql, results, store } = person();
  store(1, 'a.mp4');
  results.put([{ identity: drive(1), kind: 'transcript', value: { text: 'the kiln is hot today' } }]);
  const evidence = nativeNamespaceEvidence({ sql, transaction: fn => fn() });
  for (let wake = 0; wake < 40 && (await evidence.nextAt()) !== null; wake += 1) await evidence.advance();
  const found = await evidence.search('kiln');
  assert.deepEqual(found.results.map(result => result.name), ['a.mp4']);
  assert.deepEqual(found.unavailable, []);
});

test('an installed encoder adds a searched space with no search.json edit, and uninstalling it stops it', async () => {
  const { spaceOf } = await import('../src/meaning-spaces.mjs');
  const { sql, results, store } = person();
  store(1, 'kiln talk.mp4');
  store(2, 'beach.mp4');
  const encoder = { id: 'tool:encode-example', serves: ['encode'], encodes: { accepts: ['text'], space: { model: 'example/model', dim: 3, query_prompt: 'q: ' }, reads: [{ result_kind: 'transcript', place: 'said', pieces_path: '$.segments', text_field: 'text' }] } };
  const other = { ...encoder, id: 'tool:encode-other', encodes: { ...encoder.encodes, space: { model: 'other/model', dim: 3 } } };
  const space = spaceOf(encoder);
  results.put([
    { identity: drive(1), kind: 'meaning', value: { sets: [{ space, place: 'said', tool_id: encoder.id, items: [{ v: half([1, 0, 0]), start: 30, end: 33, said: 'the kiln gets hot' }] }] } },
    { identity: drive(2), kind: 'meaning', value: { sets: [{ space, place: 'said', tool_id: encoder.id, items: [{ v: half([0, 1, 0]), start: 1, end: 2, said: 'waves' }] }] } },
  ]);
  const asked = [];
  const runTool = async ({ tool_id, input }) => { asked.push([tool_id, input.texts[0]]); return { state: 'completed', output: { model: { name: tool_id === encoder.id ? 'example/model' : 'other/model' }, vectors: [[1, 0, 0]] } }; };
  let installed = [encoder];
  const lane = { id: 'meaning', source: 'files', match: 'meaning-in-results', kind: 'meaning', sets_path: '$.sets', time_fields: { start: 'start', end: 'end', said: 'said' }, floor: 0.5, rank: 1 };
  const config = { ...settings, lanes: [...settings.lanes.filter(row => row.match !== 'meaning-in-results'), lane] };
  let catalogRevision = 1;
  const encoders = async ({ revision = null } = {}) => {
    const current = String(catalogRevision);
    if (revision !== null && String(revision) !== current) {
      return { tools: [], cursor: { after: null, revision: current }, complete: false, restart: true };
    }
    return { tools: installed, cursor: { after: null, revision: current }, complete: true, restart: false };
  };
  const search = makeSearch({ sql, runTool, encoders, config });
  await finishIndexing(search);
  const found = await finishPendingSearch(search, 'ceramics oven', { places: ['said'] });
  assert.deepEqual(found.results.map(result => [result.name, result.start, result.said]), [['kiln talk.mp4', 30, 'the kiln gets hot']], 'found by meaning in the installed space, at its moment');
  assert.deepEqual(asked, [[encoder.id, 'q: ceramics oven']], 'the question is encoded once, with the space\'s own query prompt');
  assert.deepEqual((await finishPendingSearch(search, 'ceramics oven', { places: ['seen'] })).results, [], 'a place the space holds no vectors for finds nothing');
  installed = [encoder, other];
  catalogRevision += 1;
  const both = await finishPendingSearch(search, 'ceramics oven', { places: ['said'] });
  assert.deepEqual(both.results.map(result => result.name), ['kiln talk.mp4'], 'a second space with no vectors yet adds nothing and breaks nothing');
  installed = [];
  catalogRevision += 1;
  assert.deepEqual((await finishPendingSearch(search, 'ceramics oven', { places: ['said'] })).results, [], 'uninstalled: the space is no longer searched');
  installed = [{ ...encoder, id: 'tool:liar' }];
  catalogRevision += 1;
  const lied = await finishPendingSearch(search, 'ceramics oven', { places: ['said'] });
  assert.deepEqual(lied.results, []);
  assert.match(lied.unavailable[0].reason, /another model/, 'an answer from another model than the space declares is refused, never compared');
});

test('encoder-space answers page past forty spaces and search resumes through the last one', async () => {
  const { spaceOf } = await import('../src/meaning-spaces.mjs');
  const { sql, results, store } = person();
  store(1, 'last-space.mp4');
  const lane = { id: 'meaning', source: 'files', match: 'meaning-in-results', kind: 'meaning', sets_path: '$.sets', time_fields: { start: 'start', end: 'end' }, floor: 0.5, rank: 1 };
  const config = { ...settings, lanes: [lane] };
  const tools = Array.from({ length: 41 }, (_, at) => ({
    id: `tool:encoder-${String(at).padStart(2, '0')}`, serves: ['encode'],
    encodes: { accepts: ['text'], space: { model: `example/model-${at}`, dim: 3 }, reads: [] },
  }));
  const lastSpace = spaceOf(tools.at(-1));
  results.put([{ identity: drive(1), kind: 'meaning', value: { sets: [
    { space: lastSpace, place: 'said', tool_id: tools.at(-1).id, items: [{ v: half([1, 0, 0]), start: 19, end: 22, said: 'the kiln fires' }] },
  ] } }]);
  let catalogCalls = 0, encoderCalls = 0;
  const encoders = async ({ after = null, revision = null, limit }) => {
    catalogCalls += 1;
    if (revision !== null && revision !== 'r1') return { tools: [], cursor: { after: null, revision: 'r1' }, complete: false, restart: true };
    const start = after ? tools.findIndex(tool => tool.id === after) + 1 : 0;
    const page = tools.slice(start, start + limit);
    const cursor = page.at(-1)?.id ?? after;
    return { tools: page, cursor: { after: cursor, revision: 'r1' }, complete: start + page.length >= tools.length };
  };
  const runTool = async ({ tool_id }) => {
    encoderCalls += 1;
    const tool = tools.find(item => item.id === tool_id);
    return { state: 'completed', output: { model: { name: tool.encodes.space.model }, vectors: [[1, 0, 0]] } };
  };
  const search = makeSearch({ sql, runTool, encoders, config });
  await finishIndexing(search);
  const found = await finishPendingSearch(search, 'ceramics kiln', { places: ['said'] });
  assert.ok(catalogCalls >= 2, 'the catalog and its persisted space pages resume under one revision');
  assert.equal(encoderCalls, tools.length, 'each declared space is encoded once');
  assert.deepEqual(found.results.map(result => [result.name, result.start]), [['last-space.mp4', 19]], 'the last space survives result paging');
});

test('backlog reports a cold changed queue past one bounded wake', async () => {
  const { sql } = person();
  const config = { ...settings, catch_up: { ...settings.catch_up, values_per_wake: 2 } };
  const search = makeSearch({ sql, config });
  sql.exec("INSERT INTO search_changed (lane, identity) VALUES ('transcript-words', 'a'), ('transcript-words', 'b'), ('transcript-words', 'c')");
