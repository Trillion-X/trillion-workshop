import test from 'node:test';
import assert from 'node:assert/strict';
import { readFileSync } from 'node:fs';
import { Miniflare, convertV4MiniflareOptions } from 'miniflare';
import Ajv from 'ajv';
import settings from '../../../service-watch/src/service-watch.json' with { type: 'json' };
import { BUILD_READ_LIMITS, readBuilds, readServiceWatch } from '../src/service-watch.mjs';
import { createBuildProgress } from '../scripts/deploy-build-progress.mjs';

const commit = '6e734eb2540d188f20e8cfdf9851e4ec03b26965';
const key = settings.builds_key_prefix + commit;
const build = { commit, started_at: '2026-10-08T07:35:55Z', outcome: 'refused',
  why: 'VISUAL CHECK FAILED: home--390 changed', finished_at: '2026-10-08T07:42:15.747Z',
  failures: { kind: 'visual', complete: false, omitted: 0, records: [
    { name: 'home--390', failed: 'a kept comparison differs', failure: { phase: 'compare', message: 'original retained diagnostic' } },
  ] } };
const fixture = async t => {
  const mf = new Miniflare(convertV4MiniflareOptions({ workers: [{ name: 'build-record-fixture', modules: true,
    script: 'export default { fetch() { return new Response("fixture"); } };',
    compatibilityDate: '2026-10-01', kvNamespaces: ['APP_KV'] }] }));
  t.after(() => mf.dispose());
  const kept = await mf.getKVNamespace('APP_KV', 'build-record-fixture');
  const reads = [];
  const kv = {
    get(name, options) { reads.push({ name, options }); return kept.get(name, options); },
    list() { assert.fail('The exact-build read must not enumerate keys.'); },
    put() { assert.fail('The exact-build read must not write.'); },
  };
  return { kept, kv, reads };
};

test('the real PersonStore action reads one retained build through real KV and preserves the ordinary snapshot', async t => {
  const { countingHost, personStoreOver } = await import('./person-store-reads-for-tests.mjs');
  const person = await personStoreOver(countingHost(), 'one-build-read');
  const { kept, kv, reads } = await fixture(t);
  const state = { read_at: '2026-10-08T07:48:21Z', watches: { deploys: { said: 'Earlier snapshot', evidence: '{}' } } };
  await kept.put(settings.state_key, JSON.stringify(state));
  await kept.put(key, JSON.stringify(build));
  await kept.put(settings.builds_key_prefix + '0'.repeat(40), 'unreadable unrelated build');
  await kept.put('visual-check:' + commit, 'separate screenshot artifact is not read');
  person.env.APP_KV = kv;
  const result = await person.accountActions()['read-service-watch']({ build_commit: commit.toUpperCase() });
  assert.equal(result.build_status, 'found');
  assert.equal(result.build_commit, commit);
  assert.deepEqual(result.build, build);
  assert.deepEqual(result.watches, {});
  assert.equal(result.build_read.complete, true, 'projection completeness is separate from the original incomplete capture');
  assert.equal(result.build.failures.complete, false);
  assert.equal(result.build_read.consistency, 'eventual');
  assert.deepEqual(reads, [{ name: key, options: { type: 'stream', cacheTtl: 30 } }]);
  const snapshot = await person.accountActions()['read-service-watch']({});
  assert.deepEqual(snapshot, { said: 'Earlier snapshot', ...state });
  assert.equal(reads.at(-1).name, settings.state_key);
  assert.equal(reads.at(-1).options, undefined, 'the existing snapshot read remains unchanged');
  assert.equal(await kept.get(key), JSON.stringify(build), 'the retained record is unchanged');
});

test('the installed descriptor and owner admit only an optional exact hexadecimal commit', async () => {
  const rows = JSON.parse(readFileSync(new URL('../../../keep-and-wake-ai-sessions-on-this-computer/records/workshop-account-tool-records.json', import.meta.url)));
  const descriptor = rows.records.find(row => row.payload?.id === 'tool:read-service-watch').payload;
  const validate = new Ajv().compile(descriptor.input_schema);
  for (const value of [{}, { build_commit: commit }, { build_commit: commit.toUpperCase() }]) assert.equal(validate(value), true);
  const invalid = [{ build_commit: null }, { build_commit: '' }, { build_commit: commit + ' ' },
    { build_commit: 'z'.repeat(40) }, { build_commit: '../' + '0'.repeat(37) }, { build_commit: '0'.repeat(39) },
    { build_commit: commit, key: 'private-value' }, { key: key }];
  const kv = { get() { assert.fail('Invalid input reached KV.'); } };
  for (const input of invalid) {
    assert.equal(validate(input), false);
    await assert.rejects(readServiceWatch(kv, undefined, input), TypeError);
  }
  const output = new Ajv().compile(descriptor.output_schema);
  assert.equal(output({ said: 'A retained record', read_at: null, watches: {}, build_commit: commit, build_status: 'absent', build: null, build_read: {} }), true);
});

test('a missing retained value is explicitly absent and no schedule or key scan is started', async t => {
  const { kv, reads } = await fixture(t);
  const result = await readServiceWatch(kv, undefined, { build_commit: commit });
  assert.equal(result.build_status, 'absent');
  assert.equal(result.build, null);
  assert.equal(result.build_read.key_reads, 1);
  assert.match(result.said, /absent, expired or not yet visible/);
  assert.equal(reads.length, 1);
});

test('all saved build outcomes remain inspectable, including outcomes omitted from the aggregate watch', async t => {
  const { kept, kv, reads } = await fixture(t);
  for (const [index, outcome] of ['running', 'refused', 'went-live', 'already-live', 'handed-on'].entries()) {
    const hash = index.toString(16).repeat(40);
    const record = { ...build, commit: hash, outcome, finished_at: outcome === 'running' ? null : build.finished_at };
    await kept.put(settings.builds_key_prefix + hash, JSON.stringify(record));
    const result = await readServiceWatch(kv, undefined, { build_commit: hash });
    assert.equal(result.build_status, 'found');
    assert.equal(result.build.outcome, outcome);
    assert.equal(result.build.finished_at, record.finished_at);
  }
  assert.equal(reads.length, 6, 'only the running build adds its exact progress read');
});

test('a running build exposes active diagnostics, while terminal results outrank a late progress write', async t => {
  const { kept, kv, reads } = await fixture(t);
  const progressKey = settings.build_progress_key_prefix + commit;
  const progress = { commit, started_at: build.started_at, phase: 'guard-checks', updated_at: new Date().toISOString(), elapsed_ms: 60000,
    guard: { state: 'heartbeat', completed: 2, total: 10, active: [{ file: 'test/slow.test.mjs', elapsed_ms: 45000 }],
      last_completed: { file: 'test/fast.test.mjs', result: 'passed', elapsed_ms: 10 } } };
  await kept.put(key, JSON.stringify({ ...build, outcome: 'running', finished_at: null }));
  await kept.put(progressKey, JSON.stringify(progress));
  const running = await readServiceWatch(kv, undefined, { build_commit: commit });
  assert.deepEqual(running.build.progress, progress);
  assert.equal(running.build_read.progress.state, 'found');
  assert.deepEqual(reads.map(row => row.name), [key, progressKey]);
  const terminal = { ...build, progress: { ...progress, phase: 'refused' } };
  await kept.put(key, JSON.stringify(terminal));
  const finished = await readServiceWatch(kv, undefined, { build_commit: commit });
  assert.deepEqual(finished.build, terminal);
  assert.equal(reads.length, 3, 'terminal reads never take an in-flight heartbeat');
});

test('same-commit concurrent runs keep distinct exact result and progress keys', async t => {
  const { kept, kv, reads } = await fixture(t);
  const olderRun = '11111111-1111-4111-8111-111111111111';
  const newerRun = '22222222-2222-4222-8222-222222222222';
  const olderStart = '2026-10-12T01:00:00.000Z';
  const newerStart = '2026-10-12T01:00:01.000Z';
  const older = { ...build, run_id: olderRun, runner: 'local', started_at: olderStart, outcome: 'running', finished_at: null };
  const newer = { ...build, run_id: newerRun, runner: 'hosted', started_at: newerStart, outcome: 'running', finished_at: null };
  const pointer = { record_type: 'build-pointer', commit, started_at: newerStart, run_id: newerRun, runner: 'hosted' };
  const progress = { commit, run_id: newerRun, runner: 'hosted', started_at: newerStart, phase: 'guard-checks', updated_at: new Date().toISOString() };
  await kept.put(key, JSON.stringify(pointer));
  await kept.put(`${key}:${olderRun}`, JSON.stringify(older));
  await kept.put(`${key}:${newerRun}`, JSON.stringify(newer));
  await kept.put(`${settings.build_progress_key_prefix}${commit}:${olderRun}`, JSON.stringify({ ...progress, run_id: olderRun, runner: 'local', started_at: olderStart, phase: 'compile-worker' }));
  await kept.put(`${settings.build_progress_key_prefix}${commit}:${newerRun}`, JSON.stringify(progress));

  const result = await readServiceWatch(kv, undefined, { build_commit: commit });
  assert.equal(result.build_status, 'found');
  assert.equal(result.build.run_id, newerRun);
  assert.equal(result.build.runner, 'hosted');
  assert.deepEqual(result.build.progress, progress);
  assert.deepEqual(reads.map(row => row.name), [key, `${key}:${newerRun}`, `${settings.build_progress_key_prefix}${commit}:${newerRun}`]);
});

test('retained build listing skips pointers and enriches the newer active same-commit run by its identity', async t => {
  const { kept, reads } = await fixture(t);
  const olderRun = '33333333-3333-4333-8333-333333333333';
  const newerRun = '44444444-4444-4444-8444-444444444444';
  const olderStart = '2026-10-12T02:00:00.000Z';
  const newerStart = '2026-10-12T02:00:01.000Z';
  const older = { ...build, run_id: olderRun, runner: 'local', started_at: olderStart, outcome: 'refused' };
  const newer = { ...build, run_id: newerRun, runner: 'hosted', started_at: newerStart, outcome: 'running', finished_at: null,
    progress: { commit, run_id: newerRun, runner: 'hosted', started_at: newerStart, phase: 'starting', updated_at: newerStart } };
  const newestProgress = { ...newer.progress, phase: 'guard-checks', updated_at: new Date().toISOString() };
  const records = new Map([
    [key, JSON.stringify({ record_type: 'build-pointer', commit, started_at: newerStart, run_id: newerRun, runner: 'hosted' })],
    [`${key}:${olderRun}`, JSON.stringify(older)],
    [`${key}:${newerRun}`, JSON.stringify(newer)],
    [`${settings.build_progress_key_prefix}${commit}:${newerRun}`, JSON.stringify(newestProgress)],
  ]);
  const kv = {
    async list({ prefix }) { return { keys: [...records.keys()].filter(name => name.startsWith(prefix)).map(name => ({ name })), list_complete: true }; },
    async get(name, options) {
      reads.push({ name, options });
      const value = records.get(name) ?? null;
      return options?.type === 'stream' && value !== null ? new Response(value).body : value;
    },
  };
  const builds = await readBuilds(kv, settings);
  assert.equal(builds.length, 2, 'pointer rows do not duplicate their retained run');
  assert.equal(builds[0].run_id, olderRun);
  assert.equal(builds[0].outcome, 'refused');
  assert.equal(builds[1].run_id, newerRun);
  assert.equal(builds[1].outcome, 'running');
  assert.deepEqual(builds[1].progress, newestProgress);
  assert.equal(builds[1].progress_read.state, 'found');
  assert.ok(reads.some(row => row.name === `${key}:${newerRun}`));
  assert.ok(reads.some(row => row.name === `${settings.build_progress_key_prefix}${commit}:${newerRun}`));
  assert.ok(!reads.some(row => row.name === `${settings.build_progress_key_prefix}${commit}:${olderRun}`));
});

test('progress snapshots include attempt identity only when the publisher supplies it', () => {
  const runId = '55555555-5555-4555-8555-555555555555';
  const startedAt = '2026-10-12T03:00:00.000Z';
  const ordinary = createBuildProgress({ commit, startedAt, write: async () => {} });
  const identified = createBuildProgress({ commit, startedAt, runId, runner: 'hosted', write: async () => {} });
  try {
    assert.equal(Object.hasOwn(ordinary.snapshot(), 'run_id'), false);
    assert.equal(Object.hasOwn(ordinary.snapshot(), 'runner'), false);
    assert.equal(identified.snapshot().run_id, runId);
    assert.equal(identified.snapshot().runner, 'hosted');
  } finally { ordinary.close(); identified.close(); }
});

test('an invalid build pointer is unreadable and never selects an arbitrary KV key', async t => {
  const { kept, kv, reads } = await fixture(t);
  await kept.put(key, JSON.stringify({ record_type: 'build-pointer', commit, started_at: build.started_at,
    run_id: '../service-watch:build:private', runner: 'hosted' }));
  const result = await readServiceWatch(kv, undefined, { build_commit: commit });
  assert.equal(result.build_status, 'unreadable');
  assert.equal(result.build_read.reason, 'invalid_build_pointer');
  assert.equal(result.build_read.key_reads, 1);
  assert.deepEqual(reads.map(row => row.name), [key]);
});

test('progress from another commit, another run of the same commit or an oversized sample stays explicitly unreadable', async () => {
  for (const [value, reason] of [
    [JSON.stringify({ commit: '0'.repeat(40), phase: 'guard-checks', updated_at: new Date().toISOString() }), 'invalid_progress_record'],
    [JSON.stringify({ commit, started_at: '2026-10-12T00:00:00Z', phase: 'guard-checks', updated_at: new Date().toISOString() }), 'progress_run_mismatch'],
    ['x'.repeat(BUILD_READ_LIMITS.record_bytes + 1), 'record_byte_limit'],
  ]) {
    const kv = { get: async name => new Response(name === key ? JSON.stringify({ ...build, outcome: 'running' }) : value).body };
    const result = await readServiceWatch(kv, undefined, { build_commit: commit });
    assert.equal(result.build_status, 'found');
    assert.equal(result.build.progress, undefined);
    assert.equal(result.build_read.progress.state, 'unreadable');
    assert.equal(result.build_read.progress.reason, reason);
  }
});

test('malformed, wrongly attributed and oversized real KV values are unreadable rather than absent or partial success', async t => {
  const { kept, kv } = await fixture(t);
  const cases = [
    ['invalid_record_json', '{broken'],
    ['invalid_record_encoding', new Uint8Array([0xff, 0xfe])],
    ['record_commit_mismatch', JSON.stringify({ ...build, commit: '0'.repeat(40) })],
    ['invalid_record_shape', JSON.stringify({ ...build, why: { unexpected: true } })],
    ['record_byte_limit', 'x'.repeat(BUILD_READ_LIMITS.record_bytes + 1)],
  ];
  for (const [index, [reason, value]] of cases.entries()) {
    const hash = (index + 1).toString(16).repeat(40);
    const payload = typeof value === 'string' && value.includes(commit) ? value.replace(commit, hash) : value;
    await kept.put(settings.builds_key_prefix + hash, payload);
    const result = await readServiceWatch(kv, undefined, { build_commit: hash });
    assert.equal(result.build_status, 'unreadable', reason);
    assert.equal(result.build, null);
    assert.equal(result.build_read.reason, reason);
    assert.equal(result.build_read.complete, false);
  }
});

test('diagnostics are byte bounded with explicit omissions while original records and screenshot artifacts stay unchanged', async t => {
  const { kept, kv, reads } = await fixture(t);
  const original = { ...build, why: '🧪'.repeat(1300), unrecognized: 'excluded from the diagnostic contract',
    failures: { complete: true, records: Array.from({ length: 16 }, (_, index) => ({
      name: 'assertion-' + index, message: 'm'.repeat(1800), actual: 'a'.repeat(1800),
      expected: 'e'.repeat(1800), stderr: 's'.repeat(1800), seen: 'screenshot-canary',
    })) } };
  const text = JSON.stringify(original);
  assert.ok(Buffer.byteLength(text) < BUILD_READ_LIMITS.record_bytes);
  await kept.put(key, text);
  const result = await readServiceWatch(kv, undefined, { build_commit: commit });
  assert.equal(result.build_status, 'found');
  assert.ok(Buffer.byteLength(JSON.stringify(result)) <= BUILD_READ_LIMITS.output_bytes);
  assert.ok(Buffer.byteLength(result.build.why) <= BUILD_READ_LIMITS.field_bytes);
  assert.ok(!result.build.why.includes('�'));
  assert.equal(result.build_read.complete, false);
  assert.ok(result.build_read.truncated_fields > 0);
  assert.ok(result.build_read.omitted_image_fields > 0);
  assert.ok(result.build_read.omitted_records > 0);
  assert.equal(result.build.failures.complete, true, 'the original capture flag is unchanged; projection omissions are separate');
  assert.ok(!JSON.stringify(result).includes('screenshot-canary'));
  assert.equal(reads.length, 1);
  assert.equal(await kept.get(key), text);
});

test('KV and stream transport failures retain their actual failure instead of being reported as missing or malformed records', async () => {
  const unavailable = Object.assign(new Error('KV unavailable'), { failure_code: 'service-busy' });
  await assert.rejects(readServiceWatch({ get: async () => { throw unavailable; } }, undefined, { build_commit: commit }), error => error === unavailable);
  const streamError = new TypeError('Stream transport failed');
  const stream = new ReadableStream({ start(controller) { controller.error(streamError); } });
  await assert.rejects(readServiceWatch({ get: async () => stream }, undefined, { build_commit: commit }), error => error === streamError);
});

test('an oversized stream is cancelled at the read bound before any later chunks are consumed', async () => {
  let pulled = 0, cancelled = false;
  const stream = new ReadableStream({
    pull(controller) { pulled += 1; controller.enqueue(new Uint8Array(65536)); },
    cancel() { cancelled = true; },
  }, { highWaterMark: 0 });
  const result = await readServiceWatch({ get: async () => stream }, undefined, { build_commit: commit });
  assert.equal(result.build_read.reason, 'record_byte_limit');
  assert.equal(result.build_status, 'unreadable');
  assert.equal(cancelled, true);
  assert.equal(pulled, 3);
});
