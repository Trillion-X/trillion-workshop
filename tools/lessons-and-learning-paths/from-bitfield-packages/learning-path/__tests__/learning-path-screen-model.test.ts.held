import { describe, it, expect } from 'vitest';
import { Star } from 'lucide-react';
import {
  buildLearningPathScreenModel,
  DEFAULT_STATUS_OVERRIDES,
} from '@/packages/learning-path/read-data/learning-path-screen-model';

const FEED = {
  title: 'Forehand mastery',
  nodes: [
    { id: 's1', label: 'Grip basics', status: 'complete', iconName: 'star' },
    { id: 's2', label: 'Depth drill', status: 'active', iconName: 'drill' },
    { id: 's3', label: 'Topspin', status: 'locked' },
  ],
};

describe('buildLearningPathScreenModel', () => {
  it('projects the feed into resolved path nodes with the title', () => {
    const model = buildLearningPathScreenModel(FEED, () => Star);
    expect(model.title).toBe('Forehand mastery');
    expect(model.isEmpty).toBe(false);
    expect(model.nodes.map((n) => n.id)).toEqual(['s1', 's2', 's3']);
    expect(model.nodes[0]).toMatchObject({ toneColor: 'var(--status-success)', complete: true });
    expect(model.nodes[1]).toMatchObject({ ring: true, bubble: 'START' });
    expect(model.nodes[2]).toMatchObject({ dimmed: true });
  });

  it('is empty (honest state) when the feed has no nodes', () => {
    expect(buildLearningPathScreenModel({ title: 'x' }).isEmpty).toBe(true);
    expect(buildLearningPathScreenModel(null).isEmpty).toBe(true);
    expect(buildLearningPathScreenModel({ nodes: [] }).nodes).toEqual([]);
  });

  it('feed statusOverrides merge over the defaults (new status = data row)', () => {
    const model = buildLearningPathScreenModel({
      nodes: [{ id: 'b', label: 'Bonus', status: 'bonus' }],
      statusOverrides: { bonus: { toneColor: 'var(--status-warning)', bubble: 'BONUS' } },
    });
    expect(model.nodes[0]).toMatchObject({ toneColor: 'var(--status-warning)', bubble: 'BONUS' });
  });

  it('default overrides cover complete/active/available/locked', () => {
    expect(Object.keys(DEFAULT_STATUS_OVERRIDES).sort()).toEqual(['active', 'available', 'complete', 'locked']);
  });

  it('accepts a bare nodes array (no wrapper)', () => {
    const model = buildLearningPathScreenModel([{ id: 'a', label: 'A', status: 'available' }]);
    expect(model.nodes).toHaveLength(1);
    expect(model.title).toBe('');
  });
});
