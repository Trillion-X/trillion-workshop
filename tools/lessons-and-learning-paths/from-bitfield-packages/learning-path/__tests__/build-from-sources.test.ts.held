import { describe, it, expect } from 'vitest';
import { buildLearningPathFromSources } from '@/packages/learning-path/read-data/build-from-sources';

// Curriculum fallback (the package surface-state default).
const CURRICULUM = {
  title: 'Your tennis path',
  nodes: [
    { id: 'n1', label: 'Welcome & grip', status: 'active' },
    { id: 'n2', label: 'Ready position', status: 'locked' },
  ],
};

const PROGRESS_VIEWS = [
  {
    title: 'Applied decision making',
    steps: [
      { id: 's1', label: 'Frame the choice', sortOrder: 1, completed: true, current: false },
      { id: 's2', label: 'Test the constraint', sortOrder: 2, completed: false, current: true },
    ],
  },
];

describe('buildLearningPathFromSources', () => {
  it('prefers an owner-ready progress view when it yields a journey', () => {
    const model = buildLearningPathFromSources({ surfaceState: CURRICULUM, progressViews: PROGRESS_VIEWS });
    expect(model.title).toBe('Applied decision making');
    expect(model.nodes.map((n) => n.id)).toEqual(['s1', 's2']);
    expect(model.nodes[0]).toMatchObject({ complete: true }); // s1 completed
    expect(model.nodes[1]).toMatchObject({ ring: true }); // s2 current/active
  });

  it('falls back to the curriculum when there are no progress rows', () => {
    const model = buildLearningPathFromSources({ surfaceState: CURRICULUM, progressViews: [] });
    expect(model.title).toBe('Your tennis path');
    expect(model.nodes.map((n) => n.id)).toEqual(['n1', 'n2']);
  });

  it('falls back to curriculum when a progress view has no steps', () => {
    const model = buildLearningPathFromSources({ surfaceState: CURRICULUM, progressViews: [{ title: 'Empty', steps: [] }] });
    expect(model.title).toBe('Your tennis path'); // empty journey -> curriculum
  });

  it('honest empty when neither source has content', () => {
    const model = buildLearningPathFromSources({ surfaceState: { nodes: [] }, progressViews: [] });
    expect(model.isEmpty).toBe(true);
  });

  it('total on junk input', () => {
    expect(buildLearningPathFromSources({}).isEmpty).toBe(true);
    expect(buildLearningPathFromSources({ surfaceState: null }).isEmpty).toBe(true);
  });
});
