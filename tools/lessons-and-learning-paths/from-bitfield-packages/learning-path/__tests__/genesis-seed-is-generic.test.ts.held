// packages/learning-path/__tests__/genesis-seed-is-generic.test.ts
//
// learning-path is a GENERIC primitive: the path-rail mechanism, not any one
// subject. The DEFAULT genesis it SHIPS (the `learning-path.surface-state` record
// rendered until a product seeds a real path) must therefore contain ZERO domain
// vocabulary (L039 / Physics-vs-Society). A product package-set supplies the real
// domain path; the generic package ships only a domain-agnostic placeholder.
// Regression for §6.4 (it used to ship a "Your tennis path" / Forehand / serve seed).

import { describe, it, expect } from 'vitest';
import { readFileSync } from 'node:fs';

const things = JSON.parse(
  readFileSync('packages/learning-path/things-to-store-and-run.json', 'utf8'),
).things as any[];

// Words from ANY specific subject that must never appear in the generic primitive's
// shipped seed (a small representative set across domains — tennis is the one that
// leaked, but cooking/finance/etc. would be equally wrong).
const DOMAIN_WORDS = [
  'tennis', 'rosa-example', 'forehand', 'backhand', 'serve', 'racket', 'rally',
  'crosscourt', 'grip', 'court', 'swing', 'match play', 'ready position',
  'recipe', 'portfolio', 'guitar', 'chord',
];

describe('learning-path ships a GENERIC genesis seed (no domain vocabulary)', () => {
  const seed = things.find((t) => t?.address === 'learning-path.surface-state')?.payload;

  it('the default genesis exists and is a functional path (title + nodes)', () => {
    expect(seed).toBeTruthy();
    expect(typeof seed.title).toBe('string');
    expect(Array.isArray(seed.nodes)).toBe(true);
    expect(seed.nodes.length).toBeGreaterThan(0);
    expect(seed.nodes[0].status).toBe('active'); // a real starting point
  });

  it('the title + every node label name no specific subject (the deletion test)', () => {
    const renderedText = [seed.title, ...seed.nodes.map((n: any) => n.label)]
      .join(' ')
      .toLowerCase();
    for (const w of DOMAIN_WORDS) {
      expect(renderedText.includes(w), `domain word "${w}" leaked into the generic seed`).toBe(false);
    }
  });

  it('no SHIPPED record (title/label/text fields, excluding _note docs) carries domain vocabulary', () => {
    // Walk every record's user-facing string fields; _note is build documentation,
    // not shipped/rendered content, so it is exempt.
    const bad: string[] = [];
    const walk = (o: any) => {
      if (Array.isArray(o)) return o.forEach(walk);
      if (o && typeof o === 'object') {
        for (const [k, v] of Object.entries(o)) {
          if (k === '_note') continue;
          if (typeof v === 'string') {
            const low = v.toLowerCase();
            for (const w of DOMAIN_WORDS) if (low.includes(w)) bad.push(`${k}:"${v}" (${w})`);
          } else walk(v);
        }
      }
    };
    things.forEach(walk);
    expect(bad).toEqual([]);
  });
});
