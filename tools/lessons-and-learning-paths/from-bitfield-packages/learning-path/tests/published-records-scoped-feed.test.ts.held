import { describe, expect, it } from 'vitest';
import { readFileSync } from 'node:fs';
import { join } from 'node:path';

interface Thing {
  type?: string;
  address?: string;
  payload?: Record<string, unknown>;
}

const manifest = JSON.parse(
  readFileSync(join(__dirname, '..', 'things-to-store-and-run.json'), 'utf8'),
) as { things: Thing[] };

describe('learning-path parameterized owner-ready progress input', () => {
  it('resolves only the caller-provided projection address', () => {
    const input = manifest.things.find((thing) => thing.address === 'package::learning-path::input::progress-view-by-address-label');
    expect(input?.payload).toMatchObject({
      kind: 'bitfield-input-descriptor',
      input_name: 'progress-view-by-address-label',
      selected_payload: {
        value_address_label: { op: 'path', from: 'params', path: ['addressLabel'] },
        value: { source_bytes: { bytes_to_value: 'json' } },
      },
    });
  });

  it('contains no raw published-record feed or sibling owner address', () => {
    const text = JSON.stringify(manifest);
    expect(text).not.toContain('package::learning-path::progress-feed');
    expect(text).not.toContain('input::published-records');
    expect(text).not.toContain('learning-progress');
  });
});
