import React from 'react';
import { cleanup, render, screen } from '@testing-library/react';
import { afterEach, describe, expect, it } from 'vitest';

import { LearningPathSurface, buildLearningPathSurfaceModel } from '@/packages/learning-path/show/LearningPathSurface';

const FEED = {
  title: 'Forehand mastery',
  nodes: [
    { id: 's1', label: 'Grip basics', status: 'complete', iconName: 'star' },
    { id: 's2', label: 'Depth drill', status: 'active', iconName: 'drill' },
    { id: 's3', label: 'Topspin', status: 'locked' },
  ],
};

const bannedVisibleTerms = ['surface-state', 'payload', 'descriptor', 'status_enum', 'toneColor', 'progression_rule'];

afterEach(() => cleanup());

describe('LearningPathSurface', () => {
  it('renders the winding path with a node button per journey node + the title', () => {
    const { container } = render(<LearningPathSurface model={buildLearningPathSurfaceModel(FEED)} />);
    expect(screen.getByLabelText('Grip basics')).toBeTruthy();
    expect(screen.getByLabelText('Depth drill')).toBeTruthy();
    expect(screen.getByLabelText('Topspin')).toBeTruthy();
    expect(container.textContent).toContain('Forehand mastery');
    expect(container.textContent).toContain('START'); // active node bubble
    expect(container.querySelector('[data-scrollable-surface-viewport="true"]')).toBeTruthy();
  });

  it('shows an honest empty state (no fabricated nodes) when the feed is empty', () => {
    const { container } = render(<LearningPathSurface model={buildLearningPathSurfaceModel({ title: 'x', nodes: [] })} />);
    expect(container.textContent).toContain('Your path is being built');
    expect(container.querySelectorAll('button')).toHaveLength(0);
  });

  it('leaks no internal vocabulary to the user (L118)', () => {
    const { container } = render(<LearningPathSurface model={buildLearningPathSurfaceModel(FEED)} />);
    const text = (container.textContent ?? '').toLowerCase();
    for (const banned of bannedVisibleTerms) {
      expect(text).not.toContain(banned.toLowerCase());
    }
  });
});
