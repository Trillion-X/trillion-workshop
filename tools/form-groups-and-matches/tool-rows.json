          "required": ["selected", "rejected", "configuration_requests"],
          "properties": { "selected": { "type": "array" }, "rejected": { "type": "array" }, "configuration_requests": { "type": "array" }, "instrumentation": { "type": "object" } }
        },
        "invoke": {
          "kind": "container",
          "files": { "package_files": [
            { "package": "form-groups-and-matches", "paths": ["do-work", "read-data"], "at": "/opt/form-groups-and-matches" },
