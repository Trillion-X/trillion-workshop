// packages/interaction-program/read-data/emergent-communities.test.mjs
//
// THE T9 EMERGENCE PROOF (plan Wave 4): the addressed-interaction-group
// primitive is only a real primitive if NEW community types are DATA ROWS, not
// code. This test builds the plan §4's full 43-community list purely as
// `interaction-program` descriptor DATA and asserts EVERY ONE:
//   1. folds through the SAME unchanged `foldInteractionPrograms` (all 10 refs
//      land as opaque data pointers, extras preserved),
//   2. runs the SAME unchanged `selectPairs` pairing engine with its own
//      pairing DATA (pods, bipartite mentor/mentee, no-exclusion lotteries),
//   3. renders its member types through the SAME unchanged console
//      `buildRoleMatrix` (novel roles + novel permission strings per community).
// 43 >= 35 (the acceptance bar). ZERO engine change — this file imports the
// production modules and defines ONLY DATA. Deleting all 43 rows and dropping
// a 44th unseen community in works identically (deletion test, gate §32).
//
// L117 note: these are DATA-row proofs by design — the acceptance's intent is
// "new community = DATA, zero code", NOT seeding 43 fake communities into the
// live tribes app as saved product data.

import { describe, expect, it } from 'vitest';
import { foldInteractionPrograms, PROGRAM_REFS } from './interaction-program-fold.mjs';
import { selectPairs } from './select-pairs.mjs';
import { buildRoleMatrix } from './console-selectors.mjs';

function factorEvidence(score = 1) {
  const factorIds = ['complementarity', 'relevance', 'timing', 'ability_to_act', 'impact'];
  return {
    status: 'grounded',
    evidence_refs: ['evidence:emergence-fixture'],
    factors: Object.fromEntries(factorIds.map((factor) => [factor, {
      status: 'grounded',
      score: factor === 'complementarity' ? score : 1,
      evidence_refs: ['evidence:emergence-fixture'],
      inference_ref: `inference:emergence-fixture:${factor}`,
    }])),
  };
}

// The plan §4 emergent list — each entry becomes ONE interaction-program DATA
// row (43 communities; open strings everywhere; the engines enumerate none).
const COMMUNITIES = [
  'book-club', 'mastermind-pod', 'dating-cohort', 'founder-dinner', 'support-group',
  'accountability-circle', 'onboarding-cohort', 'course-cohort', 'mentorship-circle',
  'mentor-mentee-matching', 'buddy-system', 'peer-review-pod', 'writing-sprint',
  'reading-challenge', 'fitness-challenge', 'habit-streak-league', 'hackathon-team-builder',
  'beta-tester-panel', 'customer-advisory-board', 'volunteer-rota', 'event-matchmaking',
  'office-hours-queue', 'alumni-networking-week', 'local-meetup-group', 'language-exchange',
  'study-group', 'recovery-check-in-circle', 'grief-support-group', 'parenting-pod',
  'neighborhood-mutual-aid', 'job-referral-club', 'sales-referral-circle',
  'investor-founder-matching', 'talent-marketplace-cohort', 'project-squad', 'guild',
  'seasonal-leaderboard-game', 'quest-board', 'daily-prompt-challenge',
  'weekly-connection-lottery', 'hot-seat-mastermind', 'rotating-dinner-table', 'cohort-contest',
];

function programRow(name, index) {
  const grouping = {
    modes: [
      { type: '1:1', min_size: 2, max_size: 2 },
      { type: 'small_group', min_size: 3, max_size: 5 },
      { type: 'session', min_size: 6, max_size: 100 },
    ],
  };
  return {
    payload: {
      kind: 'interaction-program',
      id: `interaction-program:${name}`,
      partition_key: 'runtime-partition',
      label: name.replace(/-/g, ' '),
      // vary pairing DATA across communities — pods of 3, bipartite roles,
      // lottery (no exclusion) — all pure config over the ONE engine
      pairing: index % 3 === 0
        ? { group_size: 3, grouping }
        : index % 3 === 1
          ? { group_size: 2, grouping, roles: { bipartite: ['giver', 'receiver'] } }
          : { group_size: 2, grouping, exclusion: 'none' },
      group_ref: `group:${name}`,
      participant_source_ref: `person-list:${name}-members`,
      match_descriptor_ref: `meaning-search.descriptor:${name}-affinity`,
      relationship_kind_ref: `relationship-graph.kind:${name}-bond`,
      time_window_ref: `timed-action.window:${name}-cycle`,
      daily_context_sequence_ref: `context-feed.sequence:${name}-themes`,
      ai_icebreaker_producer_ref: `ai-records-producer.instruction:${name}-opener`,
      access_rule_ref: `access-rule:${name}`,
      score_measure_ref: `progression-evaluator.measure:${name}-points`,
      surface_ref: `documents.page:${name}-home`,
      community_flavor: name, // unknown extra — must survive on `extra`
    },
  };
}

describe('T9: 43 emergent community types as pure DATA rows (>= 35)', () => {
  const rows = COMMUNITIES.map((name, i) => programRow(name, i));
  const folded = foldInteractionPrograms(rows);

  it('all 43 fold through the unchanged resolver with all 10 refs intact', () => {
    expect(COMMUNITIES.length).toBe(43);
    expect(folded.size).toBe(43);
    for (const name of COMMUNITIES) {
      const p = folded.get(`interaction-program:${name}`);
      expect(p).toBeTruthy();
      for (const refKey of PROGRAM_REFS) {
        expect(typeof p.refs[refKey]).toBe('string');
        expect(p.refs[refKey]).toContain(name); // opaque pointer carried verbatim
      }
      expect(p.extra.community_flavor).toBe(name); // unknown field preserved
    }
  });

  it('every community pairs members through the unchanged selectPairs with its OWN pairing DATA', () => {
    for (const [i, name] of COMMUNITIES.entries()) {
      const p = folded.get(`interaction-program:${name}`);
      const members = ['m1', 'm2', 'm3', 'm4', 'm5', 'm6'];
      const factors = (value) => ({ complementarity: value, relevance: 1, timing: 1, ability_to_act: 1, impact: 1 });
      const scope = {
        pursuit_ref: `pursuit:${name}`,
        system_ref: `system:${name}`,
        timescale_ref: 'timescale:cycle',
        state_ref: 'state:current',
      };
      const candidates = [
        { subject: 'm1', participant: 'm2', expected_value: 0.9, factors: factors(0.9), factor_evidence: factorEvidence(0.9), scope, role: 'receiver' },
        { subject: 'm1', participant: 'm3', expected_value: 0.8, factors: factors(0.8), factor_evidence: factorEvidence(0.8), scope, role: 'giver' },
        { subject: 'm1', participant: 'm4', expected_value: 0.7, factors: factors(0.7), factor_evidence: factorEvidence(0.7), scope, role: 'receiver' },
        { subject: 'm4', participant: 'm5', expected_value: 0.9, factors: factors(0.9), factor_evidence: factorEvidence(0.9), scope, role: 'giver' },
        { subject: 'm4', participant: 'm6', expected_value: 0.8, factors: factors(0.8), factor_evidence: factorEvidence(0.8), scope, role: 'receiver' },
      ];
      const req = { candidates, pairing: p.pairing };
      if (p.pairing.roles) {
        req.participant_roles = { m1: 'giver', m2: 'receiver', m3: 'giver', m4: 'receiver', m5: 'giver', m6: 'receiver' };
      }
      const { groups } = selectPairs(req);
      expect(Array.isArray(groups)).toBe(true);
      expect(groups.length).toBeGreaterThan(0);
      if (i % 3 === 0) {
        for (const g of groups) {
          expect(g.members.length).toBe(3);
          expect(g.grouping).toBe('small_group');
        }
      }
      if (i % 3 === 1) {
        // bipartite communities: every group pairs a giver with a receiver
        for (const g of groups) {
          const roles = g.members.map((m) => req.participant_roles[m]).sort();
          expect(roles).toEqual(['giver', 'receiver']);
        }
      }
    }
  });

  it('every community renders its OWN novel role matrix through the unchanged console selectors', () => {
    for (const name of COMMUNITIES) {
      const memberTypes = [
        { kind: 'interaction-program.member-type', id: `${name}:host`, community: name, role: 'host', permissions: [`${name}-configure`, `${name}-invite`] },
        { kind: 'interaction-program.member-type', id: `${name}:participant`, community: name, role: 'participant', permissions: [`${name}-participate`] },
      ];
      const matrix = buildRoleMatrix(memberTypes);
      expect(matrix.rows.map((r) => r.role)).toEqual(['host', 'participant']);
      // columns are THIS community's novel permission strings — never a shared enum
      expect(matrix.columns).toEqual([`${name}-configure`, `${name}-invite`, `${name}-participate`]);
    }
  });

  it('deletion test: an unseen 44th community works identically with zero code change', () => {
    const novel = programRow('beekeeping-mentorship-guild', 44);
    const one = foldInteractionPrograms([novel]);
    const p = one.get('interaction-program:beekeeping-mentorship-guild');
    expect(p).toBeTruthy();
    expect(p.refs.group_ref).toBe('group:beekeeping-mentorship-guild');
  });
});
