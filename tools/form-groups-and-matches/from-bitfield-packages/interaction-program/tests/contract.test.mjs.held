// packages/interaction-program/tests/contract.test.mjs
//
// Run: node --test packages/interaction-program/tests/contract.test.mjs
//
// Structural + genericity gate for the composition DATA. Proves: valid JSON; every
// interaction-program descriptor carries all 10 composition refs; the package owns NO
// behavior another package owns (no god package); and NO community-type is enumerated in
// source (the leaves + the workflow are blind — community identity lives entirely in DATA).

import { test } from "node:test";
import assert from "node:assert/strict";
import { readFileSync } from "node:fs";
import { fileURLToPath } from "node:url";
import { dirname, join } from "node:path";
import { PROGRAM_REFS } from "../read-data/interaction-program-fold.mjs";
import {
  MATCH_FACTOR_IDS,
  MATCH_INTAKE_QUESTION_CONTRACT,
  MATCH_PRIMITIVE_IDS,
} from "../read-data/match-intake-evidence.mjs";

const PKG = dirname(dirname(fileURLToPath(import.meta.url)));
const things = JSON.parse(readFileSync(join(PKG, "things-to-store-and-run.json"), "utf8"));

test("things.json is valid and declares the package", () => {
  assert.equal(things.package, "interaction-program");
  assert.ok(Array.isArray(things.things) && things.things.length > 0);
});

test("every interaction-program descriptor carries all 10 composition refs + a pairing config", () => {
  const programs = things.things.filter((t) => (t.payload || {}).kind === "interaction-program");
  assert.ok(programs.length >= 5, "flagship + >=4 emergent communities shipped as DATA");
  for (const p of programs) {
    for (const ref of PROGRAM_REFS) {
      assert.equal(typeof p.payload[ref], "string", `${p.payload.id} missing ${ref}`);
    }
    assert.equal(typeof p.payload.pairing, "object");
  }
});

test("the match cycle is a workflow-definition dispatching EXISTING owned engines (no re-owned logic)", () => {
  const wf = things.things.find((t) => (t.payload || {}).name === "tribe.run-match-cycle");
  assert.ok(wf, "run-match-cycle workflow-definition present");
  const coreNames = JSON.stringify(wf.payload.steps);
  // The SYNCHRONOUS core match dispatches reads + pairing + edge storage by address.
  for (const owner of [
    "slot::find-current-items",                       // reads
    "action:find-similar",                            // bounded retrieval OWNER
    "compute.process",                                // our pairing policy mount
    "action:relationship-graph.write-one-connection", // edge storage OWNER
  ]) {
    assert.ok(coreNames.includes(owner), `core match cycle must dispatch ${owner}`);
  }
  // Engagement (scheduling + AI icebreakers) is DECOUPLED (L063, article-distribution precedent)
  // to a companion definition fired by the on-new-connection trigger, so the core match never
  // blocks/rolls back on engagement. It still composes the OWNING engines by address (no god package).
  const allDefNames = JSON.stringify(
    things.things.filter((t) => (t.payload || {}).kind === "workflow-definition").map((t) => t.payload.steps),
  );
  for (const owner of [
    "action:timed-action.write-scheduled-action",     // scheduling OWNER (engagement)
    "action:run-ai-records-production",               // AI OWNER (icebreakers)
  ]) {
    assert.ok(allDefNames.includes(owner), `package must compose ${owner} (engagement)`);
  }
  const serializedWorkflow = JSON.stringify(wf.payload);
  assert.ok(serializedWorkflow.includes('"initiating_event"'));
  assert.ok(serializedWorkflow.includes('"read_consents"'));
  assert.ok(!serializedWorkflow.includes("read_embeddings"));
  assert.ok(!serializedWorkflow.includes("read_provenance"));
  assert.ok(!serializedWorkflow.includes('"mount_path":"embeddings.json"'));
  assert.ok(!serializedWorkflow.includes('"mount_path":"provenance.json"'));
  assert.ok(serializedWorkflow.includes("packages/interaction-program/read-data/match-intake-evidence.mjs"));
  assert.ok(serializedWorkflow.includes("read_match_intake_evidence_lib"));
});

test("post-shortlist reasoning receives one tiny group and can never request outreach", () => {
  const instruction = things.things.find((thing) => (
    thing.address === "package::interaction-program::seed::instruction::group-review"
  ))?.payload;
  assert.ok(instruction, "group-review instruction present");
  assert.equal(instruction.output_kind, "prepared-introduction-review");
  assert.match(instruction.wrap_prefix, /ONE already-selected tiny group/);
  assert.match(instruction.wrap_prefix, /Do not .*send\/contact anyone/);
  assert.ok(!/every unordered pair|all pairs/i.test(instruction.wrap_prefix));
});

test("configuration selection is a complete generic target above human pairing", () => {
  const target = things.things.filter((thing) => (
    thing.payload?.kind === "package-target-descriptor"
    && thing.payload.entry_name === "select-configurations"
  ));
  const entry = things.things.filter((thing) => (
    thing.payload?.kind === "bitfield-package-entry"
    && thing.payload.entry_name === "select-configurations"
  ));
  const bytes = things.things.filter((thing) => (
    thing.type === "stored_bytes" && thing.name === "entry-bytes-select-configurations"
  ));
  assert.equal(target.length, 1);
  assert.equal(entry.length, 1);
  assert.equal(bytes.length, 1);
  const source = readFileSync(join(PKG, "read-data/select-configurations.mjs"), "utf8");
  assert.match(source, /export function selectConfigurations/);
  assert.doesNotMatch(source, /switch\s*\([^)]*(?:configuration_kind|configurationKind)/);
  assert.doesNotMatch(source, /(?:configuration_kind|configurationKind)\s*(?:===|==|!==|!=)\s*["']/);
  assert.doesNotMatch(source, /["'][^"']+["']\s*(?:===|==|!==|!=)\s*(?:configuration_kind|configurationKind)/);
});

test("match intake DATA covers all eleven primitives and requires cited factor evidence", () => {
  const contract = things.things.find((thing) => (
    thing.address === "package::interaction-program::match-intake-contract::evidence-grounded"
  ))?.payload;
  assert.ok(contract, "evidence-grounded match intake contract present");
  assert.deepEqual(contract.source_lineage, {
    title: "Map User Journey Funnel",
    sha256: "8da2258ddda5d1d3dc9c04245eb4adabcdbb033d8c3212cfa8c0c856e09079f8",
    line_count: 5358,
  });
  assert.deepEqual(Object.keys(contract.primitive_question_ids), MATCH_PRIMITIVE_IDS);
  const knownQuestionIds = new Set(MATCH_INTAKE_QUESTION_CONTRACT.map((question) => question.question_id));
  for (const questionIds of Object.values(contract.primitive_question_ids)) {
    assert.ok(questionIds.every((questionId) => knownQuestionIds.has(questionId)));
  }
  assert.deepEqual(contract.factor_evidence_policy.factor_ids, MATCH_FACTOR_IDS);
  assert.equal(contract.factor_evidence_policy.every_factor_requires_claim_and_evidence_citations, true);
  assert.equal(contract.factor_evidence_policy.missing_evidence_status, "no_justified_match");
  assert.equal(contract.connected_source_policy.credential_material_forbidden, true);
  assert.ok(contract.connected_source_policy.required_provenance.includes("source.permission_lease_ref"));
  assert.ok(contract.connected_source_policy.required_provenance.includes("source.consent_ref"));
});

test("factor synthesis instruction is bounded, citation-required, and cannot contact anyone", () => {
  const instruction = things.things.find((thing) => (
    thing.address === "package::interaction-program::seed::instruction::match-factor-evidence-synthesis"
  ))?.payload;
  assert.ok(instruction, "match-factor-evidence-synthesis instruction present");
  assert.match(instruction.wrap_prefix, /ONE already-retrieved candidate/);
  assert.match(instruction.wrap_prefix, /Cite exact subject_claim_refs, candidate_claim_refs, and evidence_refs/);
  assert.match(instruction.wrap_prefix, /missing evidence, not a score/);
  assert.match(instruction.wrap_prefix, /Do not .*contact anyone/);
});

test("NO GOD PACKAGE: the package hardcodes no model/provider and no scheduling/scoring logic in source", () => {
  // The AI is dispatched by address (ai-records-producer), never a raw provider/model call.
  const src = readFileSync(join(PKG, "do-work/process-scripts/select-pairs-cli.mjs"), "utf8")
    + readFileSync(join(PKG, "read-data/select-pairs.mjs"), "utf8")
    + readFileSync(join(PKG, "read-data/bounded-candidates.mjs"), "utf8")
    + readFileSync(join(PKG, "read-data/match-intake-evidence.mjs"), "utf8");
  for (const banned of ["openai", "anthropic", "gpt-", "api_key", "apikey", "fetch(", "http", "cron", "setInterval"]) {
    assert.ok(!src.toLowerCase().includes(banned), `source must not contain "${banned}" (re-owning a capability)`);
  }
});

test("NO INSTANCE-SOLVE: no community-type name is enumerated in the leaf CODE or workflow (L090)", () => {
  // Strip comments — a comment naming "book club" as an example is EVIDENCE of genericity,
  // not a violation. The gate targets executable code: no community-type branch may exist.
  const stripComments = (s) => s
    .replace(/\/\*[\s\S]*?\*\//g, "")     // block comments
    .replace(/(^|[^:])\/\/.*$/gm, "$1");  // line comments (leave "://" URLs untouched)
  const code = [
    "read-data/select-pairs.mjs",
    "read-data/bounded-candidates.mjs",
    "read-data/match-intake-evidence.mjs",
    "read-data/interaction-program-fold.mjs",
    "do-work/process-scripts/select-pairs-cli.mjs",
  ].map((f) => stripComments(readFileSync(join(PKG, f), "utf8"))).join("\n");
  // Community identity lives ONLY in DATA rows in things.json — never as a source branch.
  for (const community of ["book-club", "mastermind", "mentorship", "dating", "weekly-matchmaker"]) {
    assert.ok(!code.includes(community), `community "${community}" must be DATA, not code`);
  }
  // And no closed community switch/branch.
  assert.ok(!/switch\s*\(\s*\w*kind/.test(code) && !/if\s*\(\s*[^)]*community/.test(code),
    "no closed community switch/branch in code");
});
