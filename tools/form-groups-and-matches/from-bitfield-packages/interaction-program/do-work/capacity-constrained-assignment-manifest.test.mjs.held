import assert from "node:assert/strict";
import { readFileSync } from "node:fs";
import { test } from "node:test";

const manifest = JSON.parse(readFileSync(
  new URL("../things-to-store-and-run.json", import.meta.url),
  "utf8",
));

const targets = manifest.things.filter((thing) => thing.payload?.kind === "package-target-descriptor" && thing.payload.entry_name === "capacity-constrained-assignment");
const entries = manifest.things.filter((thing) => thing.payload?.kind === "bitfield-package-entry" && thing.payload.entry_name === "capacity-constrained-assignment");
const bytes = manifest.things.filter((thing) => thing.type === "stored_bytes" && thing.name === "entry-bytes-capacity-constrained-assignment");

test("capacity-constrained assignment exposes exactly one complete target, entry, and source-byte triple", () => {
  assert.equal(targets.length, 1);
  assert.equal(entries.length, 1);
  assert.equal(bytes.length, 1);
  assert.deepEqual(targets[0], {
    type: "record",
    address: "package::interaction-program::target::capacity-constrained-assignment",
    path: ["packages", "interaction-program", "targets", "capacity-constrained-assignment"],
    payload: {
      kind: "package-target-descriptor",
      target: "interaction-program.capacity-constrained-assignment",
      entry_name: "capacity-constrained-assignment",
      export_name: "executeAssignmentOperation",
      source_path: "do-work/solve-capacity-constrained-assignment.mjs",
      request_schema_ref: "interaction-program.capacity-constrained-assignment-request",
      response_schema_ref: "interaction-program.capacity-constrained-assignment-result",
    },
    remove: false,
  });
  assert.deepEqual(entries[0], {
    type: "record",
    address: "package::interaction-program::entry::capacity-constrained-assignment",
    path: ["packages", "interaction-program", "entries", "capacity-constrained-assignment"],
    payload: {
      kind: "bitfield-package-entry",
      entry_name: "capacity-constrained-assignment",
      export_name: "executeAssignmentOperation",
      source_path: "do-work/solve-capacity-constrained-assignment.mjs",
      entry_bytes: { stored_bytes: "entry-bytes-capacity-constrained-assignment" },
    },
    remove: false,
  });
  assert.deepEqual(bytes[0], {
    type: "stored_bytes",
    name: "entry-bytes-capacity-constrained-assignment",
    source_path: "built-stored-bytes/entry-bytes-capacity-constrained-assignment",
    source_closure_receipt_path: "built-stored-bytes/entry-bytes-capacity-constrained-assignment.source-closure.json",
  });
  const source = readFileSync(
    new URL("./solve-capacity-constrained-assignment.mjs", import.meta.url),
    "utf8",
  );
  assert.match(source, /export function executeAssignmentOperation/);
});

test("assignment remains generic and introduces no ordinal schema label", () => {
  const admittedRows = manifest.things.filter((thing) => (
    thing.payload?.kind === "package-target-descriptor"
    || thing.payload?.kind === "bitfield-package-entry"
    || thing.type === "stored_bytes"
  ));
  const serialized = JSON.stringify(admittedRows);
  assert.doesNotMatch(serialized, /Eth|Trillion|Gevity|Friday|Griffin|mom|doctor|founder|athlete|salesperson|minister/i);
  assert.doesNotMatch(serialized, /(?:^|[^a-z])(?:v[0-9]+|version[ -]?[0-9]+)(?:[^a-z]|$)/i);
});
