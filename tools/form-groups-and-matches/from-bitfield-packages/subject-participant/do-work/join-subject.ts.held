import {
  readTrustedRuntimeClockMs,
  readTrustedRuntimePartition,
  sendRequestToBitfieldTarget,
  type BitfieldRuntimeContext,
} from '@bitfield/runtime-kit';
import {
  buildEngineReadCurrentRequestFromLabels,
  buildEngineWriteBatchRequestFromLabels,
  decodeEngineReadCurrentReply,
  type EngineReadCurrentReply,
} from '@bitfield/runtime-kit/protocol';

type JsonRecord = Record<string, unknown>;
type Sender = (request: unknown) => Promise<unknown>;
type ParticipantRow = JsonRecord & { participation_ref: string; subject_ref: string; actor_ref: string; revision: number; idempotency_ref: string; participation: JsonRecord; removed: boolean };
type Mutation = { participation_ref: string; actor_ref: string; expected_revision: number; idempotency_ref: string; requested_at: string; participation: JsonRecord; operation: 'upsert' | 'remove'; migration_basis: string };
const encoder = new TextEncoder(); const decoder = new TextDecoder();
const text = (value: unknown) => typeof value === 'string' ? value.trim() : '';
const record = (value: unknown): JsonRecord | null => value && typeof value === 'object' && !Array.isArray(value) ? value as JsonRecord : null;
const clone = <Value>(value: Value): Value => JSON.parse(JSON.stringify(value)) as Value;
const canonical = (value: unknown): string => Array.isArray(value) ? `[${value.map(canonical).join(',')}]` : record(value) ? `{${Object.keys(record(value)!).sort().map((key) => `${JSON.stringify(key)}:${canonical(record(value)![key])}`).join(',')}}` : JSON.stringify(value);
const rowAddress = (subjectRef: string, participationRef: string) => `package::subject-participant::row::${encodeURIComponent(subjectRef)}::${encodeURIComponent(participationRef)}`;
const receiptAddress = (subjectRef: string, idempotencyRef: string) => `package::subject-participant::receipt::${encodeURIComponent(subjectRef)}::${encodeURIComponent(idempotencyRef)}`;

export interface JoinSubjectRequest { subjectRef: string; idempotencyRef: string; expectedRevision?: number; }

/** Caller supplies a subject and opaque participation values; admission and actor remain server-owned. */
export function joinSubject(request: JoinSubjectRequest): Promise<unknown> {
  if (!text(request.subjectRef) || !text(request.idempotencyRef) || (request.expectedRevision !== undefined && (!Number.isSafeInteger(request.expectedRevision) || request.expectedRevision < 0))) return Promise.reject(new Error('invalid participation request'));
  return sendRequestToBitfieldTarget({ target: 'subject-participant.join-subject', payload: { subject_ref: request.subjectRef, expected_revision: request.expectedRevision ?? 0, idempotency_ref: request.idempotencyRef } });
}

async function admitted(input: unknown, actionRef: string, context: BitfieldRuntimeContext | undefined, sender: Sender): Promise<{ payload: JsonRecord; actor: JsonRecord; decision: JsonRecord }> {
  const wrapped = record(input); const payload = record(wrapped?.payload); const actor = record(wrapped?.ambient_actor); const decision = record(wrapped?.access_decision); const revisions = record(decision?.revisions);
  if (!payload || !actor || !decision || !revisions || decision.decision !== 'allow' || text(actor.actor_ref) !== text(decision.actor_ref) || text(actor.session_ref) !== text(decision.session_ref) || text(actor.session_revision) !== text(revisions.session_revision) || text(payload.subject_ref) !== text(decision.subject_ref)) throw new Error('server admission is required and must be current');
  const verified = jsonReply(await sender({ target: 'access-rule.verify-decision', payload: { decision_proof: decision.decision_proof, actor_ref: actor.actor_ref, session_ref: actor.session_ref, subject_ref: payload.subject_ref, action_ref: actionRef, revisions } }));
  const durable = record(verified?.decision);
  if (verified?.verified !== true || !durable || text(durable.actor_ref) !== text(actor.actor_ref) || text(durable.subject_ref) !== text(payload.subject_ref)) throw new Error('server admission is not durable or does not authorize this owner action');
  return { payload, actor: { actor_ref: durable.actor_ref, session_ref: durable.session_ref, session_revision: record(durable.revisions)?.session_revision }, decision: durable };
}
function replyBytes(reply: unknown): Uint8Array { if (reply instanceof Uint8Array) return reply; if (reply instanceof ArrayBuffer) return new Uint8Array(reply); if (ArrayBuffer.isView(reply)) return new Uint8Array(reply.buffer, reply.byteOffset, reply.byteLength); const payload = record(reply)?.payload; if (payload === undefined) throw new Error('engine reply did not include bytes'); return replyBytes(payload); }
async function current(partition: string, address: string, sender: Sender): Promise<EngineReadCurrentReply> { return decodeEngineReadCurrentReply(replyBytes(await sender(buildEngineReadCurrentRequestFromLabels(partition, address)))); }
function decodeStored(currentValue: EngineReadCurrentReply): JsonRecord | null { if (!currentValue.found || currentValue.payload === null) return null; const parsed = record(JSON.parse(decoder.decode(currentValue.payload))); if (!parsed) throw new Error('participant owner record must be an object'); return parsed; }
function basis(currentValue: EngineReadCurrentReply) { if (!currentValue.found) return null; if (!currentValue.payloadHash) throw new Error('engine current value lacks an atomic payload basis'); return currentValue.payloadHash; }
function normalize(rawValue: unknown, actor: JsonRecord, decision: JsonRecord): Mutation {
  const raw = record(rawValue); const explicitActor = text(raw?.actor_ref); const migrationBasis = text(raw?.migration_basis); const actorRef = explicitActor || text(actor.actor_ref); const operation = text(raw?.operation) || 'upsert'; const participation = record(raw?.participation) ?? {};
  if (!raw || !actorRef || !text(raw.idempotency_ref) || !Number.isSafeInteger(raw.expected_revision) || Number(raw.expected_revision) < 0 || (operation !== 'upsert' && operation !== 'remove')) throw new Error('invalid participation mutation');
  if (explicitActor && (!migrationBasis || record(decision.constraints)?.allow_explicit_actor !== true)) throw new Error('participant actor identity is server-derived except under a durable owner constraint');
  return { participation_ref: text(raw.participation_ref) || `participant:${actorRef}`, actor_ref: actorRef, expected_revision: Number(raw.expected_revision), idempotency_ref: text(raw.idempotency_ref), requested_at: text(raw.requested_at), participation: clone(participation), operation, migration_basis: migrationBasis };
}
function uniqueMutations(values: Mutation[]) {
  const unique: Mutation[] = [];
  for (const value of values) {
    const sameReceipt = unique.find((entry) => entry.idempotency_ref === value.idempotency_ref);
    if (sameReceipt) { if (canonical(sameReceipt) !== canonical(value)) throw new Error('one idempotency ref cannot name different participation mutations'); continue; }
    if (unique.some((entry) => entry.participation_ref === value.participation_ref)) throw new Error('one participant row may be mutated once per owner batch');
    unique.push(value);
  }
  return unique;
}
function receipt(mutationValue: Mutation, row: ParticipantRow, actorRef: string) { return { kind: 'subject-participant.mutation-receipt/v1', subject_ref: row.subject_ref, idempotency_ref: mutationValue.idempotency_ref, fingerprint: canonical(mutationValue), participation_ref: row.participation_ref, actor_ref: row.actor_ref, revision: row.revision, removed: row.removed, accepted_by: actorRef, accepted_at: row.updated_at }; }
function conflict(mutationValue: Mutation, currentRow: ParticipantRow | null) { return { participation_ref: mutationValue.participation_ref, expected_revision: mutationValue.expected_revision, current_revision: currentRow?.revision ?? 0, current: currentRow ? clone(currentRow) : null }; }
function ownerRequest(payload: JsonRecord, actor: JsonRecord, decision: JsonRecord) { return { payload, ambient_actor: actor, access_decision: decision }; }
function jsonReply(reply: unknown): JsonRecord {
  if (reply instanceof Uint8Array || reply instanceof ArrayBuffer || ArrayBuffer.isView(reply)) {
    const value = record(JSON.parse(decoder.decode(replyBytes(reply)))); if (!value) throw new Error('owner target reply must be an object'); return value;
  }
  const outer = record(reply); if (!outer) throw new Error('owner target reply must be an object'); const payload = outer.payload;
  if (payload instanceof Uint8Array || payload instanceof ArrayBuffer || ArrayBuffer.isView(payload)) { const value = record(JSON.parse(decoder.decode(replyBytes(payload)))); if (!value) throw new Error('owner target reply must be an object'); return value; }
  return outer;
}
function accepted(reply: unknown, label: string) { const value = jsonReply(reply); if (value.status !== 'accepted' || value.conflict === true) throw new Error(`${label} did not accept the owner action`); return value; }
async function emitAcceptedEvent(subjectRef: string, idempotencyRef: string, actorRef: string, row: JsonRecord, sender: Sender) {
  const eventRef = `owner-accepted:${subjectRef}:${idempotencyRef}`; const occurredAt = text(row.updated_at); const revision = Number(row.revision);
  if (!occurredAt || !Number.isSafeInteger(revision) || revision < 1) throw new Error('participant readback cannot support an accepted event');
  const signed = jsonReply(await sender({ target: 'signed-event-author.sign-event', payload: { payload: { event_id: eventRef, namespace: 'owner-action', occurred_at: occurredAt, idempotency_key: eventRef, supersedes: [], facts: [{ fact_id: `${eventRef}:mutation`, subject: actorRef, relation: 'owner-action.accepted', object: 'subject-participant.join-subject', attributes: { subject_ref: subjectRef, owner_ref: text(row.participation_ref), owner_revision: revision, idempotency_ref: idempotencyRef } }] } } }));
  const authority = jsonReply(await sender({ target: 'signed-event-authority.admit-event', payload: { body: { events: [signed] }, request_id: eventRef } })); const hashes = record(record(authority.evaluation)?.event_hashes); const eventHash = text(hashes?.[eventRef]);
  if (!eventHash) throw new Error('signed accepted event was not admitted');
  await sender({ target: 'slot::workflow', payload: { operation: 'execute_definition', definition_id: 'action:owner-action-event-log.record-owner-action-event', include_output: true, input: { event: signed, canonical_hash: eventHash } } });
  return { event_ref: eventRef, event_hash: eventHash };
}
async function readRows(partition: string, subjectRef: string, requested: Array<{ participation_ref: string }>, sender: Sender) {
  const values = await Promise.all(requested.map((entry) => current(partition, rowAddress(subjectRef, entry.participation_ref), sender)));
  return values.map(decodeStored).filter((row): row is ParticipantRow => Boolean(row && row.kind === 'subject-participant.row/v1' && !row.removed)).sort((left, right) => left.participation_ref.localeCompare(right.participation_ref)).map(clone);
}

/** Durable owner target. Participation rows, revisions, actors, server times, and receipts live only in engine facts. */
export async function upsertParticipationsTarget(input: unknown, context?: BitfieldRuntimeContext, sender: Sender = sendRequestToBitfieldTarget as Sender) {
  const { payload, actor, decision } = await admitted(input, 'subject-participant.upsert-participations', context, sender); const partition = readTrustedRuntimePartition(context); const subjectRef = text(payload.subject_ref);
  const rawMutations = Array.isArray(payload.mutations) ? payload.mutations : [payload]; if (!rawMutations.length) throw new Error('participation mutations are required');
  const mutations = uniqueMutations(rawMutations.map((entry) => normalize(entry, actor, decision)));
  const beforeRows = await Promise.all(mutations.map((entry) => current(partition, rowAddress(subjectRef, entry.participation_ref), sender)));
  const beforeReceipts = await Promise.all(mutations.map((entry) => current(partition, receiptAddress(subjectRef, entry.idempotency_ref), sender)));
  const pending: Array<{ mutation: Mutation; before: EngineReadCurrentReply; row: ParticipantRow; receipt: JsonRecord }> = []; const conflicts: JsonRecord[] = [];
  for (let index = 0; index < mutations.length; index += 1) {
    const mutationValue = mutations[index]; const row = decodeStored(beforeRows[index]) as ParticipantRow | null; const storedReceipt = decodeStored(beforeReceipts[index]);
    if (storedReceipt) { if (storedReceipt.kind !== 'subject-participant.mutation-receipt/v1' || storedReceipt.fingerprint !== canonical(mutationValue)) throw new Error('idempotency receipt names a different participation mutation'); continue; }
    if (mutationValue.expected_revision !== (row?.revision ?? 0)) { conflicts.push(conflict(mutationValue, row)); continue; }
    // The row this writes becomes log state, so its stamps come from the request's
    // trusted clock; a machine clock here replays to different rows on another day.
    const now = new Date(readTrustedRuntimeClockMs(context)).toISOString(); const next: ParticipantRow = { kind: 'subject-participant.row/v1', participation_ref: mutationValue.participation_ref, subject_ref: subjectRef, actor_ref: mutationValue.actor_ref, revision: (row?.revision ?? 0) + 1, idempotency_ref: mutationValue.idempotency_ref, participation: clone(mutationValue.participation), created_by: row?.created_by ?? text(actor.actor_ref), created_at: row?.created_at ?? now, updated_by: text(actor.actor_ref), updated_at: now, removed: mutationValue.operation === 'remove' };
    pending.push({ mutation: mutationValue, before: beforeRows[index], row: next, receipt: receipt(mutationValue, next, text(actor.actor_ref)) });
  }
  if (conflicts.length) return { status: 'conflict', conflict: true, conflicts, rows: await readRows(partition, subjectRef, mutations, sender) };
  if (pending.length) {
    const entries = pending.flatMap((entry) => [
      { partitionLabel: partition, addressLabel: rowAddress(subjectRef, entry.row.participation_ref), pathLabels: ['current-item', 'subject-participant-row'], payloadBytes: encoder.encode(JSON.stringify(entry.row)), expectedCurrent: { payloadHash: basis(entry.before) } },
      { partitionLabel: partition, addressLabel: receiptAddress(subjectRef, entry.mutation.idempotency_ref), pathLabels: ['current-item', 'mutation-receipt'], payloadBytes: encoder.encode(JSON.stringify(entry.receipt)), expectedCurrent: { payloadHash: null } },
    ]);
    try { await sender(buildEngineWriteBatchRequestFromLabels(entries)); } catch { /* read durable state below */ }
  }
  const afterReceipts = await Promise.all(mutations.map((entry) => current(partition, receiptAddress(subjectRef, entry.idempotency_ref), sender)));
  const afterRows = await Promise.all(mutations.map((entry) => current(partition, rowAddress(subjectRef, entry.participation_ref), sender)));
  const replayConflicts: JsonRecord[] = [];
  for (let index = 0; index < mutations.length; index += 1) { const durableReceipt = decodeStored(afterReceipts[index]); const durableRow = decodeStored(afterRows[index]) as ParticipantRow | null; if (!durableReceipt || durableReceipt.kind !== 'subject-participant.mutation-receipt/v1' || durableReceipt.fingerprint !== canonical(mutations[index]) || !durableRow) replayConflicts.push(conflict(mutations[index], durableRow)); }
  if (replayConflicts.length) return { status: 'conflict', conflict: true, conflicts: replayConflicts, rows: await readRows(partition, subjectRef, mutations, sender) };
  const rows = await readRows(partition, subjectRef, mutations, sender); const receipts = afterRows.map((value, index) => { const row = decodeStored(value) as ParticipantRow; return { status: 'accepted', participation_ref: row.participation_ref, actor_ref: row.actor_ref, revision: row.revision, idempotency_ref: mutations[index].idempotency_ref, removed: row.removed, row: row.removed ? null : clone(row) }; });
  if (receipts.some((entry) => !entry.removed && !rows.some((row) => row.idempotency_ref === entry.idempotency_ref))) throw new Error('participant owner readback is incomplete');
  console.info(`[subject-participant.upsert] subject=${subjectRef} rows=${mutations.length} result=accepted`);
  return { status: 'accepted', conflict: false, receipts, rows };
}

/** Hosted join doorway. Predicate admission is DATA-owned; this target fixes the owner mutation and event chain. */
export async function joinSubjectTarget(input: unknown, context?: BitfieldRuntimeContext, sender: Sender = sendRequestToBitfieldTarget as Sender) {
  const { payload, actor, decision } = await admitted(input, 'subject-participant.join-subject', context, sender);
  const subjectRef = text(payload.subject_ref); const idempotencyRef = text(payload.idempotency_ref); const expectedRevision = Number(payload.expected_revision);
  if (!subjectRef || !idempotencyRef || !Number.isSafeInteger(expectedRevision) || expectedRevision < 0) throw new Error('invalid join-subject request');
  if ('actor_ref' in payload || 'participation' in payload || 'mutations' in payload || 'owner_target' in payload || 'event' in payload) throw new Error('join-subject derives actor, participation, owner targets, and event from server truth');
  const actorRef = text(actor.actor_ref); const participationRef = `participant:${actorRef}`;
  const readMembership = async () => {
    const readback = accepted(await sender({ target: 'subject-participant.read-subject-participants', payload: ownerRequest({ subject_ref: subjectRef, participations: [{ participation_ref: participationRef }] }, actor, decision) }), 'participant owner readback');
    const rows = Array.isArray(readback.rows) ? readback.rows.map(record).filter((row): row is JsonRecord => Boolean(row)) : [];
    return rows.find((entry) => text(entry.participation_ref) === participationRef && text(entry.actor_ref) === actorRef && entry.removed !== true) ?? null;
  };
  let row = await readMembership();
  let replay = Boolean(row);
  if (!row) {
    const mutation = accepted(await sender({ target: 'subject-participant.upsert-participations', payload: ownerRequest({ subject_ref: subjectRef, participation_ref: participationRef, expected_revision: expectedRevision, idempotency_ref: idempotencyRef, participation: { kind: 'subject-participant.membership/v1', predicate_ref: text(decision.predicate_ref) } }, actor, decision) }), 'participant owner');
    replay = mutation.replay === true;
    row = await readMembership();
  }
  if (!row) throw new Error('joined participant owner readback is missing');
  const acceptedIdempotencyRef = text(row.idempotency_ref) || idempotencyRef;
  const event = await emitAcceptedEvent(subjectRef, acceptedIdempotencyRef, actorRef, row, sender); const revision = Number(row.revision);
  return { status: 'accepted', replay, subject_ref: subjectRef, participation_ref: participationRef, revision, membership_revision: `subject-participant:${encodeURIComponent(subjectRef)}:${encodeURIComponent(actorRef)}:${revision}`, row: clone(row), ...event };
}

/** Reads explicit subject-owned participant rows from engine truth; it has no local owner ledger. */
export async function readSubjectParticipantsTarget(input: unknown, context?: BitfieldRuntimeContext, sender: Sender = sendRequestToBitfieldTarget as Sender) {
  const { payload } = await admitted(input, 'subject-participant.read-subject-participants', context, sender); const partition = readTrustedRuntimePartition(context); const subjectRef = text(payload.subject_ref);
  if (!Array.isArray(payload.participations) || payload.participations.length === 0) throw new Error('explicit participation owner row references are required');
  const requested = payload.participations.map((entry) => { const value = record(entry); if (!value || !text(value.participation_ref)) throw new Error('invalid participant owner row reference'); return { participation_ref: text(value.participation_ref) }; });
  const snapshots = await Promise.all(requested.map(async (entry) => {
    const addressLabel = rowAddress(subjectRef, entry.participation_ref);
    const value = await current(partition, addressLabel, sender);
    return { entry, addressLabel, value, row: decodeStored(value) };
  }));
  return {
    status: 'accepted',
    rows: snapshots.flatMap(({ row }) => row?.kind === 'subject-participant.row/v1' && !row.removed ? [clone(row)] : [])
      .sort((left, right) => text(left.participation_ref).localeCompare(text(right.participation_ref))),
    // Consumers can atomically guard these exact owner reads without importing
    // membership storage internals or writing participation state themselves.
    read_preconditions: snapshots.map(({ entry, addressLabel, value }) => ({
      participation_ref: entry.participation_ref, partition_label: partition, address_label: addressLabel,
      payload_hash: value.found ? Array.from(basis(value)!) : null,
    })),
  };
}

export const subjectParticipantOwnerAddresses = { row: rowAddress, receipt: receiptAddress };
