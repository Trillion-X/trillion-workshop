        "kind": "ai-tool-descriptor",
        "id": "tool:ask-a-model",
        "label": "Ask a model",
        "status": "active",
        "job": "Ask a model served on the person's own computer (a local model, free to run) a conversation, a yes-or-no question about some words, or for vectors that compare words by meaning, instead of a service billed per word",
        "description": "Runs on the person's computer with the models it serves (read-data/models-on-this-computer.json: Ollama for conversations, a small classifier for yes-or-no questions). messages asks a conversation and answers in the chat-completions shape (fill instead puts values into the job row’s own system words and frame); job picks a job row (which models, how many words, what answer format); tools optionally supplies the functions it may call, whose calls are returned for the caller to execute through its normal permissions; parts true also returns the answer as keyed parts. state and questions ask the classifier and answer its probabilities. texts answers one vector per text from the embedding model its job names (meaning when it names none), with that model's name, since vectors compare only with vectors from the same model. Answers error in words, with each model tried and why it did not answer, when no model on the computer is running.",
        "input_schema": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "job": {
              "type": "string",
              "description": "A job row of read-data/models-on-this-computer.json `jobs`; the default row is used when absent"
            },
            "messages": {
              "type": "array",
              "items": {
                "type": "object"
              },
              "description": "A conversation: [{ role, content }]"
            },
            "fill": {
              "type": "object",
              "description": "Instead of messages, for a job that keeps its own system words and frame: the values for the frame's {names} (for write-in-his-voice: channel, thread, draft). A channel the job does not list is refused."
            },
            "tools": {
              "type": "array",
              "items": {
                "type": "object"
              },
              "description": "OpenAI-style function definitions the local model may request; the caller executes and checks them."
            },
            "max_tokens": {
              "type": "integer",
              "minimum": 1
            },
            "temperature": {
              "type": "number"
            },
            "seed": {
              "type": "integer"
            },
            "state": {
              "type": "string",
              "description": "The words a yes-or-no question is about"
            },
            "questions": {
              "type": "object",
              "description": "The classifier's questions by id: { verdict: { type: 'noul', instructions, criteria } }"
            },
            "parts": {
              "type": "boolean",
              "description": "true streams the answer and also returns it as keyed parts"
            },
            "texts": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 1,
              "description": "Words to turn into vectors that compare by meaning: one vector per text, in order"
            }
          }
        },
        "output_schema": {
          "type": "object"
        },
        "invoke": {
          "kind": "computer",
          "capabilities": [],
          "local_doors": ["local-model-server", {"name": "local-judge-server", "required": false}, {"name": "local-classifier-server", "required": false}, {"name": "codex-lb", "required": false}],
          "workdir": "/opt/models-on-this-computer",
          "stdout": "json",
          "argv": [
            "node",
            "/opt/workflows/do-work/run-a-function.mjs",
            "/opt/models-on-this-computer/read-data/models-on-this-computer.mjs",
            "ask"
          ],
          "stdin": {
            "input": {"fill": {"from": "input"}},
            "local_ports": {"fill": {"from": "computer", "field": "local_ports"}}
          },
          "files": {
            "package_files": [
              {
                "package": "models-on-this-computer",
                "paths": [
                  "read-data"
                ],
                "at": "/opt/models-on-this-computer"
              },
              {
                "package": "workflows",
                "paths": [
                  "do-work/run-a-function.mjs"
                ],
                "at": "/opt/workflows"
              }
            ]
          },
          "max_run_ms": 1800000
        },
        "result_selector": "$.result",
        "verify": [{"kind":"sample-run","input":{"messages":[{"role":"user","content":"Say hello to Ada Example."}]}}],
        "needs": {
          "expected_seconds": 8,
          "network_egress": false
        },
        "licence_class": "licence:maker-own",
        "placements": [
          "placement:your-computer"
        ],
        "maker": "maker:models-on-this-computer",
        "listed_on": "2026-10-05T05:00:00Z",
        "provenance": {
          "source": "old trillion computer/local-models.mjs localModelTools.ask, moved without the Mac runner's wiring (computer/mac-tools.mjs), the account read of the model rows, the managed-profile check, other computers' offered servers and the model-server installer"
        }
      }
    },
