});

test('connected source is pinned, uniquely resolved, changed with CAS, read back and build checked', async () => {
  const { call, calls, state } = setup();
  assert.equal(isSourceProjectApiPath('/work/api/source-projects'), true);
  const connected = await call('/source-projects', 'POST', { owner: 'owner', repo: 'customer-app', branch: 'main',
    preview_url: 'https://preview.example.com/', live_url: 'https://app.example.com/' });
  assert.equal(connected.code, 201);
  assert.equal(connected.body.commit, first);
  const id = connected.body.id;
  const selection = { project_id: id, revision: first, route: '/', frame: 'desktop',
    element: { tag: 'h1', text: 'Original words', attributes: { id: 'hero', 'data-testid': 'hero-heading' }, selector: '#hero' } };
  selection.fingerprint = sourceSelectionFingerprint(selection);
  const resolved = await call(`/source-projects/${id}/resolve`, 'POST', { expected_commit: first, selection });
  assert.equal(resolved.body.status, 'resolved', JSON.stringify(resolved.body));
  assert.equal(resolved.body.locator.path, path);
  assert.equal(resolved.body.locator.file_sha, fileSha);
  const edited = await call(`/source-projects/${id}/edit`, 'POST', { expected_commit: first, selection,
    locator: resolved.body.locator, intent: { kind: 'text', value: 'Updated words' } });
  assert.equal(edited.body.status, 'source_written', JSON.stringify(edited.body));
  assert.equal(edited.body.commit, second);
  assert.match(state().contents, /Updated words/);
  assert.match(state().contents, /data-testid="hero-heading"/);
  assert.equal(calls.filter(row => row.tool_id === 'tool:github-update_git_ref').length, 1);
  const verified = await call(`/source-projects/${id}/verify`, 'POST', { commit: second });
  assert.equal(verified.body.source_readback, true);
  assert.equal(verified.body.build, 'passed');
  assert.equal(verified.body.status, 'verification_incomplete');
  assert.equal(verified.body.preview.status, 'unavailable');
});

test('a live dynamic app route can be selected and edited without replacing its saved GitHub connection', async () => {
  const { call, rendered, projects, state } = setup();
