test('removing a source connection uses the saved revision and does not read GitHub', async () => {
  const { call, rows, calls, env, person, workshop } = setup();
  const { body: project } = await call('/source-projects', 'POST', { owner: 'owner', repo: 'customer-app', branch: 'main' });
  const identityKey = [...rows.keys()].find(key => key.startsWith('source-project-identity:'));
  const originalRow = structuredClone(rows.get(`source-project:person-one:${project.id}`));
  originalRow.last_edit = { commit: second, previous_commit: first, path: 'src/App.tsx', blob_sha: fileSha };
  originalRow.pending_edit = { commit: second, previous_commit: first, path: 'src/App.tsx', blob_sha: fileSha };
  rows.set(`source-project:person-one:${project.id}`, originalRow);
  const { body: listed } = await call('/source-projects');
  const pendingRefusal = await call(`/source-projects/${project.id}`, 'DELETE', { expected_revision: listed.projects[0].revision });
  assert.equal(pendingRefusal.code, 409);
  rows.get(`source-project:person-one:${project.id}`).pending_edit = null;
  const { body: currentList } = await call('/source-projects');
  const revision = currentList.projects[0].revision;
  const wrongAccountResponse = await answerSourceProjectApi(new Request(`https://app.gettrillion.ai/work/api/source-projects/${project.id}`, {
    method: 'DELETE', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ expected_revision: revision }),
  }), { env, person, workshop, userId: 'person-two' });
  assert.equal((await wrongAccountResponse.json()).status, 'already_absent');
  assert.ok(rows.has(`source-project:person-one:${project.id}`));
  const githubCallsBeforeDelete = calls.length;
  const removed = await call(`/source-projects/${project.id}`, 'DELETE', { expected_revision: revision });
  assert.equal(removed.body.status, 'removed');
  assert.equal(rows.has(`source-project:person-one:${project.id}`), false);
  assert.equal(rows.has(identityKey), false);
  assert.ok([...rows.entries()].some(([key, row]) => key.startsWith(`source-project-history:person-one:${project.id}:`) && row.last_edit?.commit === second));
  assert.equal(calls.length, githubCallsBeforeDelete);
  assert.equal((await call(`/source-projects/${project.id}`, 'DELETE', { expected_revision: revision })).body.status, 'already_absent');
  const reconnected = await call('/source-projects', 'POST', { owner: 'owner', repo: 'customer-app', branch: 'main' });
  const staleRetry = await call(`/source-projects/${reconnected.body.id}`, 'DELETE', { expected_revision: revision });
  assert.equal(staleRetry.code, 409);
  assert.notEqual(rows.get(`source-project:person-one:${project.id}`).generation, originalRow.generation);
});

test('removing a source connection refuses linked sites and saved assemblies without touching state', async () => {
  const { call, rows } = setup();
  const { body: project } = await call('/source-projects', 'POST', { owner: 'owner', repo: 'customer-app', branch: 'main' });
  const routeId = '1'.repeat(32);
  rows.set(`public-app-owner:person-one:${routeId}`, '1');
  rows.set(`public-app-route:${routeId}`, { installation_id: routeId, owner_user_id: 'person-one' });
  rows.set(`source-project-site-link:person-one:${routeId}`, { installation_id: routeId, owner_user_id: 'person-one', source_project_id: project.id });
  let listed = await call('/source-projects');
  let refused = await call(`/source-projects/${project.id}`, 'DELETE', { expected_revision: listed.body.projects[0].revision });
  assert.equal(refused.code, 409);
  assert.equal(refused.body.dependencies[0].kind, 'site-link');
  rows.delete(`source-project-site-link:person-one:${routeId}`);
  rows.set(`public-app-assembly:${routeId}`, { project: { sources: [{
    project: { source: { origin: { project_id: project.id } } },
  }] } });
  listed = await call('/source-projects');
  refused = await call(`/source-projects/${project.id}`, 'DELETE', { expected_revision: listed.body.projects[0].revision });
  assert.equal(refused.code, 409);
  assert.equal(refused.body.dependencies[0].kind, 'saved-assembly');
  assert.ok(rows.has(`source-project:person-one:${project.id}`));
});

test('a deletion queued during source refresh refuses the old revision after the network wait', async t => {
  const fixture = setup({ serialized: true }); t.after(fixture.close);
  const { body: project } = await fixture.call('/source-projects', 'POST', { owner: 'owner', repo: 'customer-app', branch: 'main' });
  let release; let entered;
  const hold = new Promise(resolve => { release = resolve; });
  const atBranch = new Promise(resolve => { entered = resolve; });
  const run = fixture.workshop.run;
  fixture.workshop.run = async body => {
    if (body.tool_id === 'tool:github-read_branch') { entered(); await hold; }
    return run(body);
  };
  const refresh = fixture.call(`/source-projects/${project.id}`, 'PATCH', { expected_commit: first, live_url: 'https://site.example.com/' });
  await atBranch;
  const removal = fixture.call(`/source-projects/${project.id}`, 'DELETE', { expected_revision: project.revision });
  release();
  assert.equal((await refresh).code, 200);
  assert.equal((await removal).code, 409);
  assert.equal((await fixture.call('/source-projects')).body.projects[0].live_url, 'https://site.example.com/');
});

test('published source edit survives a failed metadata copy and account restart, then removal preserves its history', async t => {
  const fixture = setup({ serialized: true }); t.after(fixture.close);
  const { body: project } = await fixture.call('/source-projects', 'POST', { owner: 'owner', repo: 'customer-app', branch: 'main', preview_url: 'https://preview.example.com/' });
  const selection = { project_id: project.id, revision: first, route: '/', frame: 'desktop',
    element: { tag: 'h1', text: 'Original words', attributes: { id: 'hero', 'data-testid': 'hero-heading' }, selector: '#hero' } };
  selection.fingerprint = sourceSelectionFingerprint(selection);
  const { body: resolved } = await fixture.call(`/source-projects/${project.id}/resolve`, 'POST', { expected_commit: first, selection });
  const put = fixture.env.APP_KV.put;
  fixture.env.APP_KV.put = async (key, value) => {
    const row = JSON.parse(value);
    if (key === `source-project:person-one:${project.id}` && row.commit === second && !row.pending_edit) throw new Error('KV copy unavailable');
    return put(key, value);
  };
  const edited = await fixture.call(`/source-projects/${project.id}/edit`, 'POST', { expected_commit: first, selection,
    locator: resolved.locator, intent: { kind: 'text', value: 'Changed despite interrupted metadata copy' } });
  assert.equal(edited.body.status, 'source_written_verification_pending');
  assert.equal(edited.body.verification.metadata_saved, false);
  assert.equal(fixture.state().head, second);
  fixture.restart(); fixture.env.APP_KV.put = put;
  const saved = (await fixture.call('/source-projects')).body.projects[0];
  assert.equal(saved.commit, second); assert.equal(saved.last_edit.commit, second); assert.equal(saved.pending_edit, null);
  assert.equal((await fixture.call(`/source-projects/${project.id}`, 'DELETE', { expected_revision: saved.revision })).code, 200);
  const history = [...fixture.rows].find(([key]) => key.startsWith('source-project-history:person-one:'))[1];
  assert.equal(history.last_edit.commit, second);
});

test('refresh settles an earlier pending source edit only when its exact commit reached the branch', async t => {
  const pending = { commit: second, previous_commit: first, path, blob_sha: newFileSha };
  const fixture = setup({ serialized: true, initialHead: second, existingProjects: [{ id: '1'.repeat(32), provider: 'github',
    owner: 'owner', repo: 'customer-app', branch: 'main', commit: first, pending_edit: pending }] });
  t.after(fixture.close);
  const refresh = await fixture.call('/source-projects', 'POST', { owner: 'owner', repo: 'customer-app', branch: 'main',
    project_id: '1'.repeat(32), expected_commit: first, current_commit: second });
  assert.equal(refresh.code, 200); assert.equal(refresh.body.pending_edit, null); assert.deepEqual(refresh.body.last_edit, pending);
  assert.equal((await fixture.call(`/source-projects/${refresh.body.id}`, 'DELETE', { expected_revision: refresh.body.revision })).code, 200);
});
