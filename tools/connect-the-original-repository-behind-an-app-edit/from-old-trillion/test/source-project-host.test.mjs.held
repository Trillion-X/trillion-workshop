  const { call, calls } = setup({ scanFiles });
  const { body: project } = await call('/source-projects', 'POST', { owner: 'owner', repo: 'customer-app', branch: 'main',
    preview_url: 'https://preview.example.com/' });
  const selection = { project_id: project.id, revision: first, route: '/for-you', frame: 'desktop',
    element: { tag: 'h1', text: 'Original words from source data', attributes: { id: 'hero' }, selector: '#hero' } };
  selection.fingerprint = sourceSelectionFingerprint(selection);
