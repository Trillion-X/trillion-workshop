        "needs": {
          "expected_seconds": 10,
          "network_egress": false
        },
        "label": "Check my app's bundle only uses what each package made public",
        "job": "Stop a build that takes a file from a package that did not declare it public: read the bundler's own list of what went into the finished bundle and report every import that reaches into a package's private files",
        "description": "Give metafile_file (the bundler's metafile, esbuild's shape, a path inside the folder the person granted for reading), packages_root (the folder whose sub-folders are packages), declaration (how a package declares its public files: file, the name of the declaration file in each package folder; entries_at, the dotted path to the list in it, or empty for a root array; optional kind_at and kind together filter entries by their kind; path_at names the file or folder inside an entry, or is empty when each entry is itself a path string) and optionally bundle_root (what the metafile's relative paths are relative to; the granted folder when absent). The tool has no default declaration. Each import from outside a package to a file the package did not declare, and each use of a package whose declaration file cannot be read, is a finding in words. Imports inside one package, to files no package owns, to external modules and to virtual modules are not judged. Returns ok, edges_checked, packages_reached and findings.",
        "input_schema": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "metafile_file",
            "packages_root",
            "declaration"
          ],
          "properties": {
            "metafile_file": {
              "type": "string",
              "description": "A path inside the granted folder to the bundler's metafile (JSON)"
            },
            "packages_root": {
              "type": "string",
              "description": "A path inside the granted folder to the folder whose sub-folders are packages"
            },
            "bundle_root": {
              "type": "string",
              "description": "A path inside the granted folder that the metafile's relative paths are relative to"
            },
            "declaration": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "file",
                "entries_at",
                "path_at"
              ],
              "properties": {
                "file": {
                  "type": "string",
                  "description": "The declaration file's name inside each package folder"
                },
                "entries_at": {
                  "type": "string",
                  "description": "Dotted path to the list of entries in it; empty selects a root array"
                },
                "kind_at": {
                  "type": "string",
                  "description": "Optional dotted path, inside an entry, to its kind; supply together with kind"
                },
                "kind": {
                  "type": "string",
                  "description": "Optional value at kind_at that means the entry declares a public file or folder; supply together with kind_at"
                },
                "path_at": {
                  "type": "string",
                  "description": "Dotted path, inside an entry, to the public file or folder relative to the package; empty selects the entry itself"
                }
              }
            }
          }
        },
        "output_schema": {
          "type": "object",
          "required": [
            "ok",
            "edges_checked",
            "packages_reached",
            "findings"
          ],
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "edges_checked": {
              "type": "integer"
            },
            "packages_reached": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "findings": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "rule",
                  "importer",
                  "package",
                  "said"
                ],
                "properties": {
                  "rule": {
                    "type": "string"
                  },
                  "importer": {
                    "type": "string"
                  },
                  "target": {
                    "type": "string"
                  },
                  "package": {
                    "type": "string"
                  },
                  "target_path": {
                    "type": "string"
                  },
                  "reason": {
                    "type": "string"
                  },
                  "said": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "invoke": {
          "kind": "computer",
          "capabilities": [
            "read-a-folder"
          ],
          "workdir": "/opt/check-bundle-package-boundaries",
          "internet": false,
          "stdout": "json",
          "argv": [
            "node",
            "/opt/check-bundle-package-boundaries/do-work/check-my-bundle.mjs",
            {
              "fill": {
                "from": "task",
                "field": "grants.read-a-folder.folder"
              }
            }
          ],
          "stdin": {
            "fill": {
              "from": "input"
            }
          },
          "files": {
            "package_files": [
              {
                "package": "check-bundle-package-boundaries",
                "paths": [
                  "do-work"
                ],
                "at": "/opt/check-bundle-package-boundaries"
              }
            ]
          }
        },
        "result_selector": "$.result",
        "verify": [{"kind": "sample-run", "input": {"metafile_file": "meta.json", "packages_root": "packages", "declaration": {"file": "public-files.json", "entries_at": "things", "kind_at": "payload.kind", "kind": "public-source", "path_at": "payload.source_path"}}, "files": [{"grant": "read-a-folder", "path": "packages/ledger/public-files.json", "text": "{\"things\":[{\"payload\":{\"kind\":\"public-source\",\"source_path\":\"show\"}}]}"}, {"grant": "read-a-folder", "path": "meta.json", "text": "{\"inputs\":{\"host/app.mjs\":{\"imports\":[{\"path\":\"packages/ledger/show/a.mjs\"}]}}}"}]}]
      }
