{
  "kind": "tool-rows",
  "record_set": "draw-a-change-as-a-diagram-tool-rows",
  "what_this_is": "The Workshop rows for tools/draw-a-change-as-a-diagram: a graph document of lanes, nodes and edges that a person's AI writes from words or a code change, checked by one contract, changed by typed operations bound to its identity, kept corrected by a person's fixes, and drawn as standalone SVG files. Each row runs one function of do-work/requests.mjs in the small container; no row calls a model or the network.",
  "records": [
    {
      "id": "package::draw-a-change-as-a-diagram::tool::draw-a-diagram",
      "address": "package::draw-a-change-as-a-diagram::tool::draw-a-diagram",
      "path": [
        "current-item",
        "published-record"
      ],
      "payload": {
        "kind": "ai-tool-descriptor",
        "id": "tool:draw-a-diagram",
        "label": "Draw words or a code change as a diagram",
        "status": "active",
        "job": "Turn words or a code change into a diagram of lanes, nodes and edges my AI writes, checked and drawn as standalone SVG files",
        "description": "Call it first with request (and files: [{ path, text }] for a large input such as the files of a change) and no document: it answers brief (the system message and JSON Schema to write a graph document by) and outbound, the exact list of which files a model would be shown and which would not leave (secrets, lock files, binaries). Write the document, then call it again with document: it is checked (a refusal lists each problem with its path), its text is contained, the host fields given in host are stamped over it, and it answers page_block, svg_files (one standalone SVG per palette, named by the identity of its bytes), manifest, identity, identifiers and warnings; with command ({ kind: answer | show | sketch, ... }) that command is checked against the document's ids. Nothing is stored or posted; no model is called.",
        "input_schema": {
          "type": "object",
          "properties": {
            "request": {
              "type": "string"
            },
            "files": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "path",
                  "text"
                ],
                "properties": {
                  "path": {
                    "type": "string"
                  },
                  "text": {
                    "type": "string"
                  }
                }
              }
            },
            "document": {
              "type": "object",
              "description": "A graph document: { schema_version, id, label, caption?, lanes: [{ id, label?, nodes: [{ id, label, detail?, kind?, delta, min_height? }] }], edges: [{ from, to, kind?, label?, delta }] }"
            },
            "host": {
              "type": "object",
              "description": "Fields the host already knows (id, label, caption)"
            },
            "command": {
              "type": "object"
            },
            "orientation": {
              "type": "string",
              "enum": [
                "across",
                "down"
              ]
            }
          }
        },
        "output_schema": {
          "type": "object",
          "required": [
            "ok"
          ],
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "brief": {
              "type": "object"
            },
            "outbound": {
              "type": "array"
            },
            "errors": {
              "type": "array"
            },
            "identity": {
              "type": "string"
            },
            "svg_files": {
              "type": "object"
            },
            "manifest": {
              "type": "object"
            },
            "page_block": {
              "type": "object"
            },
            "identifiers": {
              "type": "object"
            },
            "warnings": {
              "type": "array"
            },
            "live": {
              "type": "object"
            }
          }
        },
        "invoke": {
          "kind": "container",
          "files": {
            "package_files": [
              {
                "package": "draw-a-change-as-a-diagram",
                "paths": [
                  "do-work",
                  "read-data"
                ],
                "at": "/opt/draw-a-change-as-a-diagram"
              },
              {
                "package": "screen-looks",
                "paths": [
                  "read-data/resolve-screen-look-palette.js"
                ],
                "at": "/opt/screen-looks"
              },
              {
                "module": "@noble/hashes",
                "paths": [
                  "LICENSE",
                  "package.json",
                  "blake3.js",
                  "blake2.js",
                  "_blake.js",
                  "_md.js",
                  "_u64.js",
                  "utils.js"
                ],
                "at": "/opt/node_modules/@noble/hashes"
              }
            ]
          },
          "workdir": "/opt/draw-a-change-as-a-diagram",
          "internet": false,
          "stdout": "json",
          "argv": [
            "node",
            "do-work/run-request.mjs",
            "drawDiagram"
          ],
          "stdin": {
            "fill": {
              "from": "input"
            }
          }
        },
        "needs": {
          "expected_seconds": 5,
          "network_egress": false,
          "memory_mb": 256
        },
        "licence_class": "licence:maker-own",
        "placements": [
          "placement:small-container"
        ],
        "maker": "maker:draw-a-change-as-a-diagram",
        "result_selector": "$.result",
        "verify": [
          {
            "kind": "sample-run",
            "input": {
              "document": {
                "schema_version": 1,
                "id": "sample-change",
                "label": "A sample change",
                "lanes": [
                  {
                    "id": "core",
                    "label": "Core",
                    "nodes": [
                      {
                        "id": "orders",
                        "label": "Orders",
                        "delta": "modified"
                      },
                      {
                        "id": "ledger",
                        "label": "Ledger",
                        "delta": "added"
                      }
                    ]
                  }
                ],
                "edges": [
                  {
                    "from": "orders",
                    "to": "ledger",
                    "delta": "added"
                  }
                ]
              },
              "host": {
                "id": "sample-change",
                "label": "A sample change"
              }
            },
            "output_selector": "$.identity",
            "contains": "1f:"
          }
        ],
        "provenance": {
          "source": "moved from Trillion-X/trillion parts/ui/show/layer-diagram and src/diagram-tools.mjs (original code)"
        }
