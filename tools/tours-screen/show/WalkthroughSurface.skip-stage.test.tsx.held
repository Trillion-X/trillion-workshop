import { cleanup, fireEvent, render, screen } from '@testing-library/react';
import { afterEach, describe, expect, it, vi } from 'vitest';
import { WalkthroughSurface } from './WalkthroughSurface';

afterEach(cleanup);

describe('WalkthroughSurface stage skip', () => {
  it('jumps to the DATA-named required stage and persists the skip as an advance', async () => {
    const onExit = vi.fn();
    const transitions: Array<{ from: string; to: string; cause: string }> = [];
    render(
      <WalkthroughSurface
        definition={{
          kind: 'walkthrough-definition',
          id: 'stage-skip',
          entry_step: 'optional-setup',
          triggers: [],
          steps: [
            {
              id: 'optional-setup',
              content: { content_kind: 'text', payload: { title: 'Optional setup' } },
              nav: { buttons: [{ role: 'skip', label: 'Skip for now', skip_to: 'required-gate' }] },
            },
            {
              id: 'ignored-step',
              content: { content_kind: 'text', payload: { title: 'Should not show' } },
            },
            {
              id: 'required-gate',
              content: { content_kind: 'text', payload: { title: 'Required gate' } },
            },
          ],
        }}
        onExit={onExit}
        onCursorTransition={async (previous, next, cause) => {
          transitions.push({ from: previous.currentStepId, to: next.currentStepId, cause });
          return next;
        }}
      />,
    );

    fireEvent.click(screen.getByRole('button', { name: 'Skip for now' }));

    expect(await screen.findByText('Required gate')).toBeTruthy();
    expect(screen.queryByText('Should not show')).toBeNull();
    expect(transitions).toEqual([{ from: 'optional-setup', to: 'required-gate', cause: 'advance' }]);
    expect(onExit).not.toHaveBeenCalled();
  });

  it('keeps whole-tour skip when no stage target is declared', () => {
    const onExit = vi.fn();
    render(
      <WalkthroughSurface
        definition={{
          kind: 'walkthrough-definition',
          id: 'legacy-skip',
          entry_step: 'intro',
          triggers: [],
          steps: [{
            id: 'intro',
            content: { content_kind: 'text', payload: { title: 'Intro' } },
            nav: { buttons: [{ role: 'skip', label: 'Skip tour' }] },
          }],
        }}
        onExit={onExit}
      />,
    );

    fireEvent.click(screen.getByRole('button', { name: 'Skip tour' }));

    expect(onExit).toHaveBeenCalledWith('skipped');
  });

  it('enforces a required step against skip, Escape, and backdrop dismissal', () => {
    const onExit = vi.fn();
    render(
      <WalkthroughSurface
        definition={{
          kind: 'walkthrough-definition',
          id: 'required-gate',
          entry_step: 'sign-in',
          triggers: [],
          steps: [{
            id: 'sign-in',
            dismiss_policy: { allow_dismiss: false, allow_skip: false },
            content: { content_kind: 'text', payload: { title: 'Sign in to continue' } },
            nav: { buttons: [
              { role: 'back', label: 'Back' },
              { role: 'skip', label: 'Skip' },
            ] },
          }],
        }}
        onExit={onExit}
      />,
    );

    expect(screen.queryByRole('button', { name: 'Skip' })).toBeNull();
    fireEvent.keyDown(window, { key: 'Escape' });
    fireEvent.click(screen.getByRole('dialog'));

    expect(screen.getByText('Sign in to continue')).toBeTruthy();
    expect(onExit).not.toHaveBeenCalled();
  });

  it('lets a step override a stricter run policy without naming the product', () => {
    const onExit = vi.fn();
    render(
      <WalkthroughSurface
        definition={{
          kind: 'walkthrough-definition',
          id: 'policy-override',
          entry_step: 'optional',
          triggers: [],
          dismiss_policy: { allow_dismiss: false, allow_skip: false },
          steps: [{
            id: 'optional',
            dismiss_policy: { allow_dismiss: true, allow_skip: true },
            content: { content_kind: 'text', payload: { title: 'Optional' } },
            nav: { buttons: [{ role: 'skip', label: 'Not now' }] },
          }],
        }}
        onExit={onExit}
      />,
    );

    fireEvent.click(screen.getByRole('button', { name: 'Not now' }));
    expect(onExit).toHaveBeenCalledWith('skipped');
  });

  it('announces saving without inserting a visible status row', () => {
    render(
      <WalkthroughSurface
        definition={{
          kind: 'walkthrough-definition',
          id: 'stable-saving-layout',
          entry_step: 'one',
          triggers: [],
          status_copy: { saving: 'Saving your progress…' },
          steps: [{
            id: 'one',
            content: { content_kind: 'text', payload: { title: 'One' } },
            nav: { buttons: [{ role: 'advance', label: 'Continue' }] },
          }],
        }}
        onExit={() => new Promise<void>(() => {})}
      />,
    );

    fireEvent.click(screen.getByRole('button', { name: 'Continue' }));
    const saving = screen.getByRole('status');
    expect(saving.textContent).toBe('Saving your progress…');
    expect(saving.className).toContain('sr-only');
  });

  it('routes a generic DATA choice without teaching the overlay its meaning', async () => {
    render(
      <WalkthroughSurface
        definition={{
          kind: 'walkthrough-definition',
          id: 'generic-choice',
          entry_step: 'choose',
          triggers: [],
          steps: [
            {
              id: 'choose',
              content: {
                content_kind: 'single-choice',
                payload: {
                  title: 'Choose one',
                  options: [
                    { value: 'alpha', label: 'Alpha' },
                    { value: 'beta', label: 'Beta' },
                  ],
                },
              },
              advance_condition: { op: 'answer-given' },
              branch_map: { by_answer: { alpha: 'alpha-result', beta: 'beta-result' } },
              nav: { buttons: [{ role: 'advance', label: 'Continue' }] },
            },
            { id: 'alpha-result', content: { content_kind: 'text', payload: { title: 'Alpha result' } } },
            { id: 'beta-result', content: { content_kind: 'text', payload: { title: 'Beta result' } } },
          ],
        }}
        onExit={vi.fn()}
      />,
    );

    expect((screen.getByRole('button', { name: 'Continue' }) as HTMLButtonElement).disabled).toBe(true);
    fireEvent.click(screen.getByRole('button', { name: 'Beta' }));
    expect((screen.getByRole('button', { name: 'Continue' }) as HTMLButtonElement).disabled).toBe(false);
    fireEvent.click(screen.getByRole('button', { name: 'Continue' }));
    expect(await screen.findByText('Beta result')).toBeTruthy();
  });
});
