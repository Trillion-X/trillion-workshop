{
  "_what": "The calendar providers a person's calendar can be on, one row each: the connection kind that reaches the account (connection_vendor: a connection `service_connection:<vendor>` or `service_connection:<vendor>:<name>`), the one host family a held key may go to (hosts, base_url), how its key is renewed (refresh, the engine's own descriptor), which wire adapter turns its requests and replies into time blocks (adapter: read-data/adapters/<adapter>.mjs) and which operations it offers. Read by read-data/calendar-events.mjs and by test/calendar-providers.test.mjs, which derives the tool row's by_input variants from these rows so this file is the only owner of what differs between providers. A new provider is a row and an adapter file; no tool id or row names one.",
  "operations": [
    "read-calendar-events"
  ],
  "words": {
    "not_offered": "{label} does not offer this: {job}.",
    "refused": "{label} refused the request ({status}): {said}",
    "no_key": "Your {label} connection holds no access key. Connect {label} again.",
    "host": "A connection's key goes only to {hosts}, so nothing was sent to {host}.",
    "no_provider": "Give provider: one of {providers}.",
    "no_such_provider": "{provider} is not a calendar provider here; the providers are {providers}.",
    "empty": "{label} answered, but no events were returned for the range.",
    "one_connection": "{label} reads one connection per run: give connection.",
    "account_failed": "{label} could not read one account: {said}"
  },
