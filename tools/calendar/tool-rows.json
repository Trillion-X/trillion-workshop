        "id": "tool:lay-out-a-calendar-view",
        "label": "Lay out a calendar view",
        "status": "active",
        "job": "Arrange time blocks for a day, week, month or agenda view, split overlapping blocks into columns, and name the blocks that clash",
        "description": "Takes time blocks and the views the person keeps (each a record naming a geometry: a time grid with a number of day columns, a month grid, or an agenda list, and the numbers it reads) and gives back the days to show with the blocks on each. In a time grid, blocks that overlap in time share the day column in equal parts, and every set of blocks that overlap is listed as a clash. Days are the person's own: give utc_offset_minutes and every time moves by it before it is cut into a day; an all-day block is a date and is not moved. There is no clock: the day comes from the anchor, the selected block, the first block or the range start. A view whose geometry is not known is answered with a notice.",
        "input_schema": {
          "type": "object",
          "required": ["blocks", "views"],
          "properties": {
            "blocks": { "type": "array", "items": { "type": "object" }, "description": "Time blocks as read-time-blocks gives them: { id, interval: { start, end, allDay } }" },
            "views": { "type": "array", "items": { "type": "object" }, "description": "calendar-view-descriptor records: { kind: 'calendar-view-descriptor', view_id, label?, layout: 'time-grid' | 'month-grid' | 'agenda-list', order?, day_count?, skip_weekends?, max_chips_per_cell? }" },
            "view_id": { "type": "string", "description": "Which view; the first by order when absent or unknown" },
            "anchor": { "type": "string", "description": "An ISO time inside the day to show" },
            "range_start": { "type": "string", "description": "Used for the day when there is no anchor and no block" },
            "selected_block_id": { "type": "string", "description": "The day of this block is the day to show when there is no anchor" },
            "utc_offset_minutes": { "type": "integer", "description": "The person's offset from UTC in minutes; 0 when absent" }
          },
          "additionalProperties": false
        },
        "output_schema": {
          "type": "object",
          "required": ["view", "days", "clashes"],
          "properties": { "view": { "type": ["object", "null"] }, "views": { "type": "array" }, "anchor_day": { "type": "string" }, "days": { "type": "array" }, "clashes": { "type": "array" }, "skipped": { "type": "array" }, "notice": { "type": "string" } }
        },
        "invoke": {
          "kind": "container",
          "files": { "package_files": { "package": "calendar", "paths": ["do-work", "read-data"], "at": "/opt/parts/calendar" } },
          "workdir": "/opt/parts/calendar",
          "stdout": "json",
          "argv": ["node", "do-work/lay-out-a-calendar-view.mjs"],
          "stdin": { "fill": { "from": "input" } }
        },
