        "kind": "ai-tool-descriptor",
        "id": "tool:read-time-blocks",
        "label": "Read records as time blocks",
        "status": "active",
        "job": "Turn any records that have a start and an end (bookings, scheduled work, reservations, events) into one ordered list of time blocks, and say which rows could not be shown",
        "description": "Reads each kind of record through a lens the person wrote: which field is the identity, the start, the end, the title, the colour, the state, and which fields point at other records. A new kind of record that happens in time is one more lens. Rows may be records or lists of cells (column N is the Nth cell). Gives back the blocks ordered by start, how many rows were read and skipped, and an issue for every lens that could not be used or has no rows. It can also read account records through account lenses, and show changes waiting to be written and changes that clashed as blocks of their own. It reads and shows only; it never writes a calendar.",
        "input_schema": {
          "type": "object",
          "required": ["lenses", "feeds"],
          "properties": {
            "lenses": { "type": "array", "items": { "type": "object" }, "description": "time-block-lens records: { kind: 'time-block-lens', lens_id, input_address, owner_ref, owner_label?, selectors: { identity, start, end, title?, all_day?, timezone?, color?, state?, lane? }, relations? }. A selector is a path, or { path | column, fallback_path?, fallback? }." },
            "feeds": { "type": "object", "description": "The rows each lens reads, by the lens's input_address: a list of records or of lists of cells." },
            "account_lenses": { "type": "array", "items": { "type": "object" }, "description": "calendar-account-lens records: { kind, lens_id, input_address, selectors: { identity, label, color?, status?, status_label?, visible?, calendars? } }" },
            "queued_changes": { "type": "array", "items": { "type": "object" }, "description": "Changes waiting to be written: { id, affected_block_ref, proposed_start, proposed_end, label?, queue_state? }" },
            "conflicts": { "type": "array", "items": { "type": "object" }, "description": "Changes that clashed: { id, affected_block_ref, original_start, original_end, proposed_start, proposed_end, owner_message_ref? }" }
          },
          "additionalProperties": false
        },
        "output_schema": {
          "type": "object",
          "required": ["blocks", "diagnostics", "issues"],
          "properties": { "blocks": { "type": "array" }, "diagnostics": { "type": "object" }, "issues": { "type": "array" }, "accounts": { "type": "array" }, "queued_blocks": { "type": "array" }, "conflict_blocks": { "type": "array" } }
        },
        "invoke": {
          "kind": "container",
          "files": { "package_files": { "package": "calendar", "paths": ["do-work", "read-data"], "at": "/opt/parts/calendar" } },
          "workdir": "/opt/parts/calendar",
          "stdout": "json",
          "argv": ["node", "do-work/read-time-blocks.mjs"],
          "stdin": { "fill": { "from": "input" } }
        },
        "needs": { "expected_seconds": 10, "network_egress": false, "memory_mb": 256 },
        "licence_class": "licence:maker-own",
        "placements": ["placement:deployed-container"],
        "maker": "maker:calendar",
        "result_selector": "$",
        "provenance": { "source": "bitfield-packages packages/calendar (the time-block projection, accounts and sync states)" },
        "verify": [
          {
            "kind": "sample-run",
            "input": {
              "lenses": [{ "kind": "time-block-lens", "lens_id": "orders", "input_address": "pickups", "owner_ref": "bakery", "selectors": { "identity": "id", "start": "window.from", "end": "window.to", "title": "what" } }],
              "feeds": { "pickups": [{ "id": "p1", "window": { "from": "2026-01-05T09:00:00Z", "to": "2026-01-05T09:30:00Z" }, "what": "Rye loaf pickup" }] }
            },
            "output_selector": "$.blocks[0].id",
            "contains": "bakery:orders:p1"
          }
        ],
        "record_model": {
          "_what": "Moved here from tools/keep-a-record-library-valid, where they were held unchanged after the engine's one record model left it (old trillion src/record-model.json and src/record-indexes.json): the kinds this tool's job keeps, each as old trillion declared it.",
          "kinds": [
            {
              "type": "space-calendar-event",
              "guard_properties": {
                "calendar": "text",
                "calendar_event_id": "text",
                "changed_at": "text",
                "ends_at": "text",
                "event_id": "text",
                "placed": "number",
                "space_id": "text",
                "starts_at": "text",
                "state": "text"
              }
            }
          ]
        }
      }
    },
