        "kind": "ai-tool-descriptor",
        "id": "tool:read-google-calendar-events",
        "label": "Read events from my Google calendar",
        "status": "active",
        "job": "Read the events in a time range from one of the person's own Google calendars and give them back as time blocks",
        "description": "Asks Google for the events of one calendar between two times (every occurrence of a repeating event, in start order) with the person's own Google OAuth client id, client secret and refresh token, and gives them back as time blocks that read-time-blocks and lay-out-a-calendar-view understand. A cancelled event is marked cancelled; an all-day event is a date. It reads only: it never creates, changes or removes an event. The three credentials arrive only on private pipes under the held-value names the row names; no answer or error carries them. Without all three it refuses.",
        "input_schema": {
          "type": "object",
          "required": ["range_start", "range_end"],
          "properties": {
            "range_start": { "type": "string", "description": "ISO time the range starts" },
            "range_end": { "type": "string", "description": "ISO time the range ends" },
            "calendar_id": { "type": "string", "description": "Which of the person's calendars; their primary one when absent" },
            "max_results": { "type": "integer", "description": "At most this many events, 1 to 2500; 50 when absent" },
            "connection_ref": { "type": "string", "description": "A name the person uses for this account; carried on each block" }
          },
          "additionalProperties": false
        },
        "output_schema": {
          "type": "object",
          "required": ["blocks", "issues", "source"],
          "properties": { "blocks": { "type": "array" }, "issues": { "type": "array" }, "range_start": { "type": "string" }, "range_end": { "type": "string" }, "source": { "type": "object" } }
        },
        "invoke": {
          "kind": "container",
          "internet": true,
          "files": { "package_files": { "package": "calendar", "paths": ["do-work", "read-data"], "at": "/opt/parts/calendar" } },
          "workdir": "/opt/parts/calendar",
          "stdout": "json",
          "argv": ["node", "do-work/read-google-calendar-events.mjs"],
          "stdin": { "fill": { "from": "input" } },
          "credential_mounts": [
            { "secret_name": "google-calendar-client-id", "fd": 3 },
            { "secret_name": "google-calendar-client-secret", "fd": 4 },
            { "secret_name": "google-calendar-refresh-token", "fd": 5 }
          ]
        },
        "needs": { "expected_seconds": 20, "network_egress": true, "memory_mb": 256 },
        "licence_class": "licence:maker-own",
        "placements": ["placement:deployed-container"],
        "maker": "maker:calendar",
        "result_selector": "$",
        "provenance": { "source": "bitfield-packages packages/calendar (the Google calendar sync workflow's request and normalizer)" },
