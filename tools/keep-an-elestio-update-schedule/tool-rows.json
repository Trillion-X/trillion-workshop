{
  "records": [
    {
      "payload": {
        "kind": "ai-tool-descriptor",
        "status": "active",
        "id": "tool:keep-an-elestio-update-schedule",
        "label": "Make an Elestio service's update schedules equal the ones kept for it",
        "job": "Keep the two update schedules of one Elestio service (its OS updates and its software updates) equal to what its owner keeps as DATA (a computer's row), and say what it changed. With apply false it only reads and says the difference.",
        "description": "Give the account email, the project and the service (vm_id), and the schedules to keep: system {enabled, security_only, day, hour, minute} for Elestio's OS updates (its weekly unattended-upgrades run) and app {enabled, day, hour, minute} for its software updates (its weekly watchtower run). Hours are UTC. It signs in with the held elestio-api-key, reads servers/getServerDetails, and sends systemAutoUpdateEnable or systemAutoUpdateDisable, appAutoUpdateEnable or appAutoUpdateDisable for each schedule that differs, then reads back until both are equal (wait_seconds, 120). A schedule not given is only read. Elestio names the system schedule's time RebootDayOfWeek and RebootHour, but it is when updates run: whether that run reboots is the computer's own apt setting (Unattended-Upgrade::Automatic-Reboot), which the computer's row keeps. A container that must keep its pinned image is labelled com.centurylinklabs.watchtower.enable=false itself, so the software schedule can stay on for Elestio's own containers.",
        "input_schema": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "email",
            "project_id",
            "vm_id"
          ],
          "properties": {
            "email": {
              "type": "string",
              "description": "The Elestio account's email."
            },
            "project_id": {
              "type": "string"
            },
            "vm_id": {
              "type": "string",
              "description": "The service's vmID."
            },
            "system": {
              "type": "object",
              "description": "system schedule",
              "required": [
                "enabled"
              ],
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "security_only": {
                  "type": "boolean",
                  "description": "Security patches only (true unless false)."
                },
                "day": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 6,
                  "description": "0 Sunday to 6 Saturday"
                },
                "hour": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 23,
                  "description": "UTC"
                },
                "minute": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 59
                }
              }
            },
            "app": {
              "type": "object",
              "description": "app schedule",
              "required": [
                "enabled"
              ],
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "day": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 6,
                  "description": "0 Sunday to 6 Saturday"
                },
                "hour": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 23,
                  "description": "UTC"
                },
                "minute": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 59
                }
              }
            },
            "apply": {
              "type": "boolean",
              "description": "false: only read and say the difference."
            },
            "wait_seconds": {
              "type": "integer",
              "minimum": 5,
              "maximum": 900
            },
            "poll_seconds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 60
            }
          }
        },
        "output_schema": {
          "type": "object",
          "required": [
            "ok",
            "vm_id",
            "sent",
            "before",
            "after"
          ],
          "properties": {
