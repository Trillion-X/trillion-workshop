              }
            ]
          }
        },
        "result_selector": "$",
        "needs": {
          "expected_seconds": 60,
          "network_egress": true,
          "memory_mb": 128
        },
        "licence_class": "licence:maker-own",
        "placements": [
          "placement:small-container"
        ],
        "maker": "maker:keep-an-elestio-update-schedule",
        "provenance": {
          "source": "Nov 25 2026: Elestio's panel still kept both Elestio computers' OS and software update schedules by hand (system Sunday 05:00 UTC, software Sunday 01:00 UTC) after their rows took over the reboot; the schedules become each computer's DATA, with the API calls of Elestio's own API documentation (servers/DoActionOnServer systemAutoUpdateEnable/Disable, appAutoUpdateEnable/Disable)."
        },
        "verify": [
          {
            "kind": "sample-run",
            "input": {
              "email": "owner@example.test",
              "project_id": "90000",
              "vm_id": "170000000",
              "apply": false,
              "app": {
                "enabled": false
              }
            },
            "held": {
              "elestio-api-key": "made-up-elestio-token"
            },
            "replies": [
              {
                "request": {
                  "method": "POST",
                  "url": "https://api.elest.io/api/auth/checkAPIToken"
                },
                "status": 200,
                "body": {
                  "status": "OK",
                  "jwt": "made-up-session"
                }
              },
              {
                "request": {
                  "method": "POST",
                  "url": "https://api.elest.io/api/servers/getServerDetails"
                },
                "status": 200,
                "body": {
                  "status": "OK",
                  "serviceInfos": [
                    {
                      "vmID": "170000000",
                      "system_AutoUpdate_Enabled": 1,
                      "system_AutoUpdate_SecurityPatchesOnly": 1,
                      "system_AutoUpdate_RebootDayOfWeek": 0,
                      "system_AutoUpdate_RebootHour": 5,
                      "system_AutoUpdate_RebootMinute": 0,
                      "app_AutoUpdate_Enabled": 1,
                      "app_AutoUpdate_DayOfWeek": 0,
                      "app_AutoUpdate_Hour": 1,
                      "app_AutoUpdate_Minute": 0
                    }
                  ]
                }
              }
            ],
            "shape_read_at": "2026-11-25",
            "output_selector": "$.reason",
            "contains": "apply was false"
          }
        ]
      }
