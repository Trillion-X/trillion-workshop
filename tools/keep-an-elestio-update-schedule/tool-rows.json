            }
          }
        },
        "invoke": {
          "kind": "container",
          "internet": true,
          "workdir": "/opt/keep-an-elestio-update-schedule",
          "stdout": "json",
          "argv": [
            "/usr/local/bin/node",
            "/opt/keep-an-elestio-update-schedule/do-work/keep-an-elestio-update-schedule.mjs"
          ],
          "stdin": {
            "fill": {
              "from": "input"
            }
          },
          "credential_mounts": [
            {
              "secret_name": "elestio-api-key",
              "fd": 4
