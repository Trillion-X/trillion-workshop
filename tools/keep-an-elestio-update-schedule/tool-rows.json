                    "enabled": {
                      "type": "boolean"
                    },
                    "security_only": {
                      "type": "boolean"
                    },
                    "day": {
                      "type": "integer"
                    },
                    "hour": {
                      "type": "integer"
                    },
                    "minute": {
                      "type": "integer"
                    }
                  }
                },
                "app": {
                  "type": "object",
                  "properties": {
                    "enabled": {
                      "type": "boolean"
                    },
                    "security_only": {
                      "type": "boolean"
                    },
                    "day": {
                      "type": "integer"
                    },
                    "hour": {
                      "type": "integer"
                    },
                    "minute": {
                      "type": "integer"
                    }
                  }
                }
              }
            },
            "after": {
              "type": "object",
              "properties": {
