// src/connected-ais.mjs
//
// The one answer to "which AIs did this person connect": the person's AIs (src/ais.mjs) that came in on a sign-in still
// current (an OAuth grant or a personal key, src/account-app-grants.mjs), named as each introduced itself.
import { grantsOf } from './account-app-grants.mjs';
import { personalKeysOf } from './personal-keys.mjs';
import { mcpSignInId } from './mcp-client-identity.mjs';

/** The one answer to "which AIs did this person connect": every current sign-in (OAuth grant or personal key) whose MCP
 *  client introduced itself, by the name it gave. A native app's grant (the iPhone app) is not an AI. Pure, so every screen
 *  reads the same list; the setup screen names each one (src/setup-steps.mjs shownAis) and never drops one it does not know. */
export function connectedAiNames({ grants = [], keys = [], clients = {} }) {
  const named = name => typeof name === 'string' && name.trim() ? name.trim() : null;
  return [
    ...grants.map(grant => named(clients[mcpSignInId({ clientId: grant.clientId })])),
    ...keys.map(key => named(clients[mcpSignInId({ keyId: key.id })])),
  ].filter(Boolean);
}
/** The names each sign-in introduced itself as, read off the one list of the person's AIs (src/ais.mjs): every `ai`
 *  record names the sign-ins it came in on. Two AIs on one key are both named, as one joined name. */
export function clientsOfAis(ais) {
  const named = {};
  for (const ai of ais) for (const signIn of ai.sign_ins ?? []) if (typeof ai.label === 'string' && !(named[signIn] ?? []).includes(ai.label)) (named[signIn] ??= []).push(ai.label);
  return Object.fromEntries(Object.entries(named).map(([signIn, names]) => [signIn, names.join(' and ')]));
}
/** The account's AIs as its own records keep them (ais:list on @own-records), where every AI's introduction is written
 *  (ais:introduce). `native` is the caller's native owner; the answer is the list, or a refusal. */
export function nativeAisRead(native) {
  return async () => {
    await native.ensureReady('@own-records');
    const answer = await native.execute('@own-records', 'ais:list', {}, `ais-list:${crypto.randomUUID()}`);
    const body = answer?.native_response ? (answer.status < 400 ? answer.body : null) : answer;
    if (!Array.isArray(body?.ais)) throw new Error('The connected MCP clients could not be verified.');
    return body.ais;
  };
}
/** The person's AIs (src/ais.mjs) that came in on a sign-in still current: what "connected" means everywhere.
 *  `readAis` reads the one list of the account's AIs: its own records' (nativeAisRead) wherever a native owner is
 *  supplied; left out, `person.ais()` (the account's own AI owner, or the caller's person store). */
export async function connectedAis(env, userId, person, readAis = () => person.ais()) {
  // An expired personal key connects nothing (src/personal-keys.mjs).
  const [grants, keys, ais] = await Promise.all([grantsOf(env, userId), personalKeysOf(env, userId).then(found => found.keys.filter(key => !key.expired)), readAis()]);
  if (!Array.isArray(ais)) throw new Error('The connected MCP clients could not be verified.');
  const current = new Set([...grants.map(grant => mcpSignInId({ clientId: grant.clientId })), ...keys.map(key => mcpSignInId({ keyId: key.id }))]);
  return { grants, keys, ais, connected: ais.filter(ai => (ai.sign_ins ?? []).some(signIn => current.has(signIn))) };
}
/**
 * Whether an AI is connected: an existing sign-in that actually introduced an MCP client on the authenticated MCP
 * endpoint (connectedAiNames). Native API traffic, an OAuth grant alone and the general last-use timestamp do not prove
 * that connection. The remembered client must still match an existing OAuth grant or personal key. A failed owner read
 * remains unknown to setup. { connected, app, apps } is shared by Get started and the press of "Hand this to my AI".
 */
export async function aiConnection(env, userId, person, readAis) {
  const { grants, keys, ais } = await connectedAis(env, userId, person, readAis);
  const apps = connectedAiNames({ grants, keys, clients: clientsOfAis(ais) });
  return { connected: apps.length > 0, app: apps[0] ?? null, apps: [...new Set(apps)] };
}
