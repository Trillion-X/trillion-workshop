        "kind": "ai-tool-descriptor",
        "id": "tool:write-public-share-files",
        "label": "Write the public files of my share links",
        "status": "active",
        "licence_class": "licence:maker-own",
        "maker": "maker:trillion",
        "placements": ["placement:your-computer"],
        "needs": { "expected_seconds": 20, "network_egress": false },
        "job": "Write the public files of every share link of mine that anyone may open, into the folder my public server serves, and remove the files of links I revoked or that expired",
        "description": "Takes the person's sharing rows (each link grant), the Lists those links share (a whole List, or one row of it) and the List's rows as input.records, read by the caller from the person's own store, reads the files its shown rows name from the files the caller hands in as input.stored.files, and writes into the folder the person granted: <code>.json (and <name>.json for a link with a readable address) in the shape { kind: \"list\", title, about, changed, fields, rows: [{ id, title, address, url, values }], files: [{ identity, name, url, media_type }] }, whole and never paged; <name>/index.html for the List and <name>/<row address>/index.html for each row; files/<identity> for each file a shown row names; sitemap.xml and llms.txt over every listed link; and manifest.json, every file with its BLAKE3 content identity and the files this run removed. A link has public files only while it is published, not revoked, not expired and open to anyone; a link for named people, an email, an audience or an access code has none. What leaves is the List's share rule less the fields the person left out, only the rows whose own rules hold and only the files they name. A link with its own condition, a match-only field, or a row rule that counts opens or reads the clock is left out with its reason, because a file on a public server cannot check it at each open. Runs on its own when a sharing row or a List changes, and again at the earliest expiry of a published link. Returns written, unchanged, removed, published, left_out, ended and next_change_at.",
        "input_schema": {
          "type": "object",
          "required": ["origin", "row_kind", "records"],
          "additionalProperties": false,
          "properties": {
            "origin": { "type": "string", "format": "uri", "description": "The https address the public server answers on, with no path, like https://example.com. Every address in the files is under <origin>/share/." },
            "row_kind": { "type": "string", "description": "The record kind of the shared Lists' rows (record:<the List's row_type>), the one row kind this run is granted to list. A shared List whose rows are another kind is left out with its reason and has no files in this folder; a person who shares Lists of several row kinds gives each kind its own folder." },
            "records": {
              "type": "array",
              "items": { "type": "object", "required": ["id", "type", "value"], "properties": { "id": { "type": "string" }, "type": { "type": "string" }, "value": { "type": "object" } }, "additionalProperties": false },
              "description": "The records this run reads of the person's own store, read by the caller from where the person keeps them (the engine keeps none) and handed in here: sharing rows (type sharing, each with its record, link_grants, leave_out and match_only), the List rows (type list, id as the sharing row's record names it) and the row_kind rows (type record:<row_type>). What is not given is not there."
            },
            "stored": {
              "type": "object",
              "description": "What this run reads of the person's own files, read by the caller from where the person keeps them and given here: files: {name: text or {base64}} under /, as this row's `stored` lists. What is not given is not there."
            }
          }
        },
        "output_schema": {
          "type": "object",
          "required": ["written", "unchanged", "removed", "published", "left_out", "ended", "next_change_at"],
          "properties": {
            "host_files": { "type": "object", "description": "Current desired static_files row for the existing public-host owner, derived from the files this run wrote. It names this run's folder, not a remote folder. Applying it is a separate authorized host operation; this result is not deployment or ongoing expiry/revocation proof.", "required": ["path", "folder", "index", "exclude", "media_types"], "properties": { "path": { "type": "string" }, "folder": { "type": "string" }, "index": { "type": "string" }, "exclude": { "type": "array", "items": { "type": "string" } }, "media_types": { "type": "object", "additionalProperties": { "type": "string" } } }, "additionalProperties": false },
            "written": { "type": "integer" },
            "unchanged": { "type": "integer" },
            "removed": { "type": "array", "items": { "type": "string" } },
            "published": { "type": "array", "items": { "type": "object", "required": ["code", "name", "listed"], "properties": { "code": { "type": "string" }, "name": { "type": "string" }, "listed": { "type": "boolean" } } } },
            "left_out": { "type": "array", "items": { "type": "object", "required": ["code", "because"], "properties": { "code": { "type": "string" }, "because": { "type": "string" } } } },
            "ended": { "type": "array", "items": { "type": "string" } },
            "next_change_at": { "type": ["string", "null"] }
          }
        },
        "wakes": [
          { "id": "a-grant-changed", "on": { "fact": { "kind": "something-changed", "from": ["run"], "match": { "place": "sharing" } } }, "budget": { "steps": 1, "wall_ms": 300000 } },
          { "id": "a-list-changed", "on": { "fact": { "kind": "something-changed", "from": ["run"], "match": { "place": "list" } } }, "budget": { "steps": 1, "wall_ms": 300000 } }
        ],
        "invoke": {
          "kind": "computer",
          "capabilities": ["change-a-folder"],
          "workdir": "/opt/write-public-share-files",
          "stdout": "json",
          "run": ["node", "/opt/workflows/do-work/run-a-function.mjs", "/opt/write-public-share-files/do-work/write-share-files.mjs", "writeShareFiles"],
          "stdin": {
            "input": { "fill": { "from": "input" } },
            "folder": { "fill": { "from": "task", "field": "grants.change-a-folder.folder" } }
          },
          "files": {
            "package_files": [
              {
                "package": "write-public-share-files",
                "paths": [
                  "do-work",
                  "read-data"
                ],
                "at": "/opt/write-public-share-files"
              },
              {
                "package": "workflows",
                "paths": [
                  "do-work/run-a-function.mjs"
                ],
                "at": "/opt/workflows"
              },
              {
                "package": "content-identity",
                "paths": [
                  "read-data"
                ],
                "at": "/opt/content-identity"
              },
              {
                "package": "formula-engine",
                "paths": [
                  "rules",
                  "built-stored-bytes/formula-engine"
                ],
                "at": "/opt/node_modules/trillion-workshop/tools/formula-engine"
              },
              {
                "packages": ["node_modules/@noble/hashes"],
                "paths": [
                  "LICENSE",
                  "package.json",
                  "blake3.js",
                  "blake2.js",
                  "_blake.js",
                  "_md.js",
                  "_u64.js",
                  "utils.js"
                ],
                "at": "/opt/node_modules/@noble/hashes"
              }
            ]
          }
        },
        "provenance": {
          "source": "Moved from Trillion's hosted share reader (src/record-share-pages.mjs: /share/<code>.json, /share/<code>/files/<identity>, /share/<name> and its row pages, /share/sitemap.xml, /share/llms.txt), its grant owner's admission and list rows (src/record-sharing.mjs), src/list-copy.mjs and the shareable copy (src/person-spaces.mjs shareableCopy), so the person's own computer writes a share's public output whenever it changes and a public server only serves files"
        },
        "verify": [
          { "kind": "sample-run", "input": { "origin": "https://example.com", "row_kind": "record:example", "records": [] }, "output_selector": "$", "contains": "published" }
        ],
        "result_selector": "$.result",
        "record_model": {
          "_what": "The record kinds, indexes and links this tool keeps (moved unchanged from trillion-rust's one record model: src/record_model_policy/record-model.json, src/record_indexes/record-indexes.json, product/lists.json field_kinds and product/record-sharing.json links).",
          "kinds": [
            {
              "type": "sharing",
              "parts": [
                {
                  "role": "record",
                  "path": [
                    "record"
                  ]
                },
                {
                  "role": "space",
                  "path": [
                    "spaces"
                  ]
                },
                {
                  "role": "person",
                  "path": [
                    "people"
                  ]
                }
              ],
              "_read_by": "src/record-sharing.mjs: who and which spaces a record is shared with",
              "guard_properties": {
                "chain": "boolean",
                "changed_at": "text",
                "choice_made": "boolean",
                "choice_revision": "text",
                "leave_out": "list",
                "link_grants": "objects",
                "match_only": "list",
                "network": "any",
                "owner_intent_order": "number",
                "people": "list",
                "record": "text",
                "spaces": "list"
              }
            },
            {
              "type": "link-page",
              "guard_properties": {
                "about": "text",
                "code": "text",
                "links": "objects",
                "on": "boolean",
                "pending_code": "text",
                "title": "text"
              }
            }
          ],
          "indexes": [
            {
              "type": "sharing",
              "name": "chain",
              "backfill": "sharing-chain-v1",
              "paths": [
                [
                  "chain"
                ]
              ],
              "_read_by": "src/record-sharing.mjs chainSharingRows (the choices that cover the records linked to theirs)"
            }
          ],
          "_what_moved": "Moved here from tools/keep-a-record-library-valid, where they were held unchanged after the engine's one record model left it (old trillion src/record-model.json and src/record-indexes.json): the kinds this tool's job keeps, each as old trillion declared it."
        },
        "stored": [
          {
            "files": "/",
            "operations": [
              "read_file"
            ]
          }
        ]
      }
    }
  ]
