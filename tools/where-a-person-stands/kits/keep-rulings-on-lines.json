  "workflows": [],
  "tools": [
    "tool:keep-rulings-on-lines",
    "tool:count-real-rulings",
    "tool:make-examples-from-rulings"
  ],
  "instructions": [
    "1. Pour the example rulings into your own list of rulings on lines (see pour), or keep them in list:checks, and keep your settings for this tool as one row of list:settings (the example row shows the values: unruled_part_of, real, needs, refuse, place, hand_rulings).",
    "2. Say which lines you ruled on and how: text, verdict (bad, good, escalated or any one word), by, and optionally rule, kind, at and where.",
    "3. The AI reads the rulings already kept (records:list type record:check prefix record:check:ruling-) and your settings row, then runs tool:keep-rulings-on-lines at @workshop-tools with {rows, existing, settings_record}.",
    "4. Read the answer: write (the records:write input to send at @own-records, one record:check for each new ruling, with its film read from where) and fresh (how many are new). A ruling already kept is not written again; a row from a test piece or a temporary folder refuses the whole write. Nothing is written until the AI sends write."
  ],
  "worked_examples": [
    {
      "title": "One bad line is kept once even when it is given twice",
      "ask": "Keep my ruling that the line \"A line that says too much.\" is bad.",
      "mcp": {
        "server": "trillion",
        "tool": "run_resource_operation",
        "input": {
          "address": "@workshop-tools",
          "method": "tools:run",
          "input": {
            "tool": "tool:keep-rulings-on-lines",
            "input": {
              "rows": [
                {
                  "text": "A line that says too much.",
                  "verdict": "bad",
                  "by": "person",
                  "where": "films/x/SCRIPT.md:3"
                },
                {
                  "text": "A line that says too much.",
                  "verdict": "bad",
                  "by": "person",
                  "where": "films/x/SCRIPT.md:3"
                }
              ],
              "at": "2030-01-01T09:00:00Z",
              "unruled_part_of": "content-production",
              "real": [
                "person"
              ],
              "needs": [
                "film"
              ],
              "needed": 3,
              "bad_label": "real-bad-film",
              "default_kind": "voiceover",
              "place": {
                "field": "film",
                "pattern": "films/([^/]+)/"
              },
              "refuse": [
                {
                  "field": "film",
                  "one_of": [
                    "test-piece"
                  ]
                },
                {
                  "field": "where",
                  "contains_one_of": [
                    "/scratch-test-",
                    "/tmp/",
                    "/.local/"
                  ]
                }
              ],
              "hand_rulings": {
                "verdict": [
                  "bad",
                  "good"
                ],
                "by": [
                  "reviewer"
                ]
              }
            }
          }
        }
      },
      "given": "From tools/where-a-person-stands/test/rulings-from-the-verdict-log.test.mjs (the first test, run here): the same ruling given twice, with the settings written out in the input (unruled_part_of content-production, place pattern films/([^/]+)/ on the field film, refuse rows from film test-piece or paths holding /scratch-test-, /tmp/ or /.local/); nothing is kept yet.",
      "hands_back": "{\"write\":{\"records\":[{\"id\":\"record:check:ruling-f65eb2746a8e7ef4428f86981fa051425cbf138afd3957e6b3d6399541725858\",\"type\":\"record:check\",\"value\":{\"kind\":\"labelled-line\",\"part_of\":[\"content-production\"],\"at\":\"2030-01-01T09:00:00Z\",\"film\":\"x\",\"text\":\"A line that says too much.\",\"verdict\":\"bad\",\"by\":\"person\",\"where\":\"films/x/SCRIPT.md:3\"}}]},\"fresh\":1}. Sent again with that record in existing, it answers {\"write\":{\"records\":[]},\"fresh\":0}."
    }
  ],
  "pour": {
    "tool": "tool:pour-example-rows-into-my-list",
    "least_coverage": 0.8,
    "how": "Name the list you already keep for the same job and its fields. The tool matches each kit field to one of yours (by the map you give, the same id, the same label, or a name in alike), refuses when fewer than least_coverage of the kit's fields match, and otherwise answers the records:write that adds the example rows to your list, leaving your own rows untouched.",
    "example": {
      "kit_list": "list:checks",
      "into": {
        "list": "list:line-rulings",
        "row_type": "record:line-ruling",
        "fields": [
          {
            "id": "kind",
            "label": "Kind"
          },
          {
            "id": "part_of",
            "label": "Part of"
          },
          {
            "id": "at",
            "label": "When"
          },
          {
            "id": "film",
            "label": "Film"
          },
          {
            "id": "text",
            "label": "Line"
          },
          {
            "id": "verdict",
            "label": "Verdict"
          },
          {
            "id": "by",
            "label": "By"
          },
          {
            "id": "where",
            "label": "Where"
          },
          {
            "id": "rule",
            "label": "Rule"
          }
        ]
      },
      "field_map": {}
    }
  }
