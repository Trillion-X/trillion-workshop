  "workflows": [],
  "tools": [
    "tool:count-real-rulings",
    "tool:keep-rulings-on-lines",
    "tool:make-examples-from-rulings"
  ],
  "instructions": [
    "1. Keep your rulings as rows of list:checks and your settings for this tool as a row of list:settings: real (who counts), needs (fields a ruling must carry), needed (how many real bad rulings a model row needs) and default_kind.",
    "2. The AI reads the rulings (records:list type record:check prefix record:check:ruling-) and runs tool:count-real-rulings at @workshop-tools with {rulings, settings_record}.",
    "3. Read real_bad_film (the real bad rulings), needed, promotion_allowed (true only when real_bad_film reaches needed), counts (each \"<by> <verdict>\") and bad_lines (text, kind, where), the lines to check.",
    "4. Run your check on bad_lines, then send again with rules (the model rows, [{id, ask: {calibration: {t_fail}}}]) and results ([{text, uncertain: [{rule, p_fail}]}]) to read escalated_by_any, per_rule and unanswered. It runs no check and writes nothing."
  ],
  "worked_examples": [
    {
      "title": "Two real bad rulings are not enough for three needed",
      "ask": "Count my real bad rulings on lines.",
      "mcp": {
        "server": "trillion",
        "tool": "run_resource_operation",
        "input": {
          "address": "@workshop-tools",
          "method": "tools:run",
          "input": {
            "tool": "tool:count-real-rulings",
            "input": {
              "rulings": [
                {
                  "text": "A line that says too much.",
                  "verdict": "bad",
                  "by": "person",
                  "film": "x",
                  "where": "films/x/SCRIPT.md:3"
                },
                {
                  "text": "Kindless.",
                  "verdict": "bad",
                  "by": "person",
                  "film": "x"
                },
                {
                  "text": "Flagged.",
                  "verdict": "escalated",
                  "by": "small-model",
                  "rule": "ask-plain",
                  "film": "x"
                }
              ],
              "real": [
                "person"
              ],
              "needs": [
                "film"
              ],
              "needed": 3,
              "default_kind": "voiceover"
            }
          }
        }
      },
      "given": "From tools/where-a-person-stands/test/rulings-from-the-verdict-log.test.mjs (the count tests, run here): two bad rulings by person with a film and one line a small model escalated; the settings say only person counts, a ruling needs a film, three real bad rulings are needed and a ruling with no kind counts as voiceover.",
      "hands_back": "{\"real_bad_film\":2,\"needed\":3,\"promotion_allowed\":false,\"counts\":{\"person bad\":2,\"small-model escalated\":1},\"bad_lines\":[{\"text\":\"A line that says too much.\",\"kind\":\"voiceover\",\"where\":\"films/x/SCRIPT.md:3\",\"also_at\":[]},{\"text\":\"Kindless.\",\"kind\":\"voiceover\",\"where\":\"x\",\"also_at\":[]}]}. Sent again with rules [{id: \"ask-plain\", ask: {calibration: {t_fail: 0.6}}}] and results that give both lines p_fail 0.999, it adds \"escalated_by_any\":2,\"per_rule\":{\"ask-plain\":2},\"unanswered\":0."
    }
  ],
  "pour": {
    "tool": "tool:pour-example-rows-into-my-list",
    "least_coverage": 0.8,
    "how": "Name the list you already keep for the same job and its fields. The tool matches each kit field to one of yours (by the map you give, the same id, the same label, or a name in alike), refuses when fewer than least_coverage of the kit's fields match, and otherwise answers the records:write that adds the example rows to your list, leaving your own rows untouched.",
    "example": {
      "kit_list": "list:checks",
      "into": {
        "list": "list:line-rulings",
