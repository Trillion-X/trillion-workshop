  "workflows": [],
  "tools": [
    "tool:make-examples-from-rulings",
    "tool:keep-rulings-on-lines",
    "tool:count-real-rulings"
  ],
  "instructions": [
    "1. Keep your rulings as rows of list:checks (tool:keep-rulings-on-lines) and your settings for this tool as a row of list:settings: real (who counts), needs (fields a ruling must carry, such as film) and bad_label.",
    "2. Collect the lines you said yourself as speech ({text, sets}) and the lists of lines a model was trained on as exclude.",
    "3. The AI reads the rulings (records:list type record:check prefix record:check:ruling-) and your settings row, then runs tool:make-examples-from-rulings at @workshop-tools with {rulings, speech, exclude, settings_record}. The input's own fields win over the setting.",
    "4. Read the answer: items ({text, good, bad_for, split, source ruling or speech, context}) and left_out (texts ruled both ways, texts in exclude). Only rulings by the people in real, carrying every field in needs, count. It writes nothing."
  ],
  "worked_examples": [
    {
      "title": "Examples from real rulings; torn and trained lines are left out",
      "ask": "Make examples from my rulings and the lines I said, leaving out the trained lines.",
      "mcp": {
        "server": "trillion",
        "tool": "run_resource_operation",
        "input": {
          "address": "@workshop-tools",
          "method": "tools:run",
          "input": {
            "tool": "tool:make-examples-from-rulings",
            "input": {
              "rulings": [
                {
                  "text": "Bad line.",
                  "verdict": "bad",
                  "by": "person",
                  "film": "f"
                },
                {
                  "text": "Good line.",
                  "verdict": "good",
                  "by": "person",
                  "film": "f"
                },
                {
                  "text": "Torn line.",
                  "verdict": "bad",
                  "by": "person",
                  "film": "f"
                },
                {
                  "text": "Torn line.",
                  "verdict": "good",
                  "by": "person",
                  "film": "f"
                },
                {
                  "text": "Trained line.",
                  "verdict": "bad",
                  "by": "person",
                  "film": "f"
                },
                {
                  "text": "Reviewer line.",
                  "verdict": "bad",
                  "by": "reviewer",
                  "film": "f"
                },
                {
                  "text": "No film.",
                  "verdict": "bad",
                  "by": "person"
                }
              ],
              "speech": [
                {
                  "text": "Their words.",
                  "sets": [
                    "person"
                  ],
                  "bad_for": []
                },
                {
                  "text": "Their trained words.",
                  "sets": [
                    "person"
                  ],
                  "bad_for": []
                }
              ],
              "exclude": [
                [
                  "Trained line.",
                  "Their trained words."
                ]
              ],
              "real": [
                "person"
              ],
              "needs": [
                "film"
              ],
              "bad_label": "real-bad-film"
            }
          }
        }
      },
      "given": "From tools/where-a-person-stands/test/rulings-from-the-verdict-log.test.mjs (the examples test, run here): seven rulings (one ruled both ways, one in the model's training lines, one by a reviewer who is not in real, one with no film) and two spoken lines, one of them trained.",
      "hands_back": "{\"items\":[{\"text\":\"Bad line.\",\"good\":false,\"bad_for\":[\"real-bad-film\"],\"split\":\"real\",\"source\":\"ruling\",\"context\":null},{\"text\":\"Good line.\",\"good\":true,\"bad_for\":[],\"split\":\"real\",\"source\":\"ruling\",\"context\":null},{\"text\":\"Their words.\",\"good\":true,\"bad_for\":[],\"split\":\"real\",\"source\":\"speech\",\"context\":null}],\"left_out\":{\"both_rulings\":1,\"in_exclude\":2}}"
    }
  ],
  "pour": {
    "tool": "tool:pour-example-rows-into-my-list",
    "least_coverage": 0.8,
    "how": "Name the list you already keep for the same job and its fields. The tool matches each kit field to one of yours (by the map you give, the same id, the same label, or a name in alike), refuses when fewer than least_coverage of the kit's fields match, and otherwise answers the records:write that adds the example rows to your list, leaving your own rows untouched.",
    "example": {
      "kit_list": "list:checks",
      "into": {
        "list": "list:line-rulings",
        "row_type": "record:line-ruling",
        "fields": [
          {
            "id": "kind",
            "label": "Kind"
          },
          {
            "id": "part_of",
            "label": "Part of"
          },
          {
            "id": "at",
            "label": "When"
          },
          {
            "id": "film",
            "label": "Film"
          },
          {
            "id": "text",
            "label": "Line"
          },
          {
            "id": "verdict",
            "label": "Verdict"
          },
          {
            "id": "by",
            "label": "By"
          },
          {
            "id": "where",
            "label": "Where"
          },
          {
            "id": "rule",
            "label": "Rule"
          }
        ]
      },
      "field_map": {}
    }
  }
