   ],
   "payload": {
    "kind": "ai-tool-descriptor",
    "id": "tool:read-where-you-stand",
    "label": "Read where you stand on things",
    "status": "active",
    "job": "See whether a person agrees, disagrees or partly agrees with one thing made for them, in their own words, with every time they changed their mind",
    "description": "Two steps. First page records:history at @own-records for the thing's stance record (id stance:<kind>:<identity>, limit up to 100, before_version from next) until next is null; this tool cannot read the person's records itself. Then give the versions of every page together and next from the last page, exactly as records:history returns them. Returns stand: its stand now (the newest version), said, why in the person's own words, by, at, version, earlier (every version before it, oldest first, a tombstone as deleted) and complete (false while next is not null: earlier stands not yet read are unknown); and choices, the stands a person can take. No version, a tombstone or a stand taken back reads stance null with taken_back: silence is not agreement.",
    "input_schema": {
     "type": "object",
     "required": [
      "versions",
      "next"
     ],
     "additionalProperties": false,
     "properties": {
      "versions": {
       "type": "array",
       "items": {
        "type": "object",
        "required": [
         "version",
         "value",
         "deleted",
         "at"
        ],
        "properties": {
         "version": {
          "type": "integer",
          "minimum": 1
         },
         "value": {
          "type": [
           "object",
           "null"
          ],
          "description": "The stance record at that version; null for a tombstone"
         },
         "deleted": {
          "type": "boolean",
          "description": "True for a tombstone: the record was removed at that version"
         },
         "at": {
          "type": "string",
          "description": "When that version was written (ISO)"
         }
        }
       },
       "description": "The versions records:history returned, from every page read, in any order"
      },
      "next": {
       "type": [
        "integer",
        "null"
       ],
       "description": "next from the last page read; null when the oldest version was read"
      }
     }
    },
    "output_schema": {
     "type": "object",
     "required": [
      "stand",
      "choices"
     ],
     "properties": {
      "stand": {
       "type": "object",
       "required": [
        "stance",
        "why",
        "earlier",
        "complete"
       ],
       "properties": {
        "id": {
         "type": [
          "string",
          "null"
         ]
        },
        "kind": {
         "type": [
          "string",
          "null"
         ]
        },
        "artifact": {
         "type": [
          "string",
          "null"
         ]
        },
        "stance": {
         "type": [
          "string",
          "null"
         ]
        },
        "said": {
         "type": [
          "string",
          "null"
         ]
        },
        "why": {
         "type": [
          "string",
          "null"
         ]
        },
        "by": {
         "type": [
          "string",
          "null"
         ]
        },
        "at": {
         "type": [
          "string",
          "null"
         ]
        },
        "version": {
         "type": [
          "integer",
          "null"
         ]
        },
        "taken_back": {
         "type": "boolean"
        },
        "earlier": {
         "type": "array",
         "items": {
          "type": "object"
         }
        },
        "complete": {
         "type": "boolean"
        }
       }
      },
      "choices": {
       "type": "array",
       "items": {
        "type": "object"
       }
      }
     }
    },
    "invoke": {
     "kind": "container",
     "files": {
      "package_files": [
       {
        "package": "where-a-person-stands",
        "paths": [
         "do-work",
         "read-data"
        ],
        "at": "/opt/where-a-person-stands"
       },
       {
        "package": "content-identity",
        "paths": [
         "read-data"
        ],
        "at": "/opt/content-identity"
       },
       {
        "module": "@noble/hashes",
        "paths": [
         "LICENSE",
         "package.json",
         "blake3.js",
         "blake2.js",
         "_blake.js",
         "_md.js",
         "_u64.js",
         "utils.js"
        ],
        "at": "/opt/node_modules/@noble/hashes"
       }
      ]
     },
     "workdir": "/opt/where-a-person-stands",
     "internet": false,
     "stdout": "json",
     "argv": [
      "node",
      "do-work/read-where-you-stand.mjs"
     ],
     "stdin": {
      "fill": {
       "from": "input"
      }
     }
    },
    "result_selector": "$.result",
    "needs": {
     "expected_seconds": 5,
