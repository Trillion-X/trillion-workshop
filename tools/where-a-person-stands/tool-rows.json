  {
   "id": "package::where-a-person-stands::tool::plan-a-stance-reload",
   "address": "package::where-a-person-stands::tool::plan-a-stance-reload",
   "path": [
    "current-item",
    "published-record"
   ],
   "payload": {
    "kind": "ai-tool-descriptor",
    "id": "tool:plan-a-stance-reload",
    "label": "Plan moving kept stands into stance records",
    "status": "active",
    "job": "Turn stands a person took that were kept somewhere else into their stance records, with every earlier stand as an earlier version, and show what would change before anything is written",
    "description": "Give stances (rows: kind, text, contains or view, stance, why, by, at, earlier as [{stance, why, at}], and the old ref if there was one) and fold, how the owner of the rules says two texts are the same. Returns writes, the record versions to send one at a time in order (each record's earlier stands first, oldest first), and summary: rows, records and versions by kind, refs_changed (rows whose identity differs from their old ref) and collisions (records two or more rows became under the fold, with each row's text and time). summary_only true leaves the writes out. It writes nothing.",
    "input_schema": {
     "type": "object",
     "required": [
      "stances",
      "fold"
     ],
     "additionalProperties": false,
     "properties": {
      "stances": {
       "type": "array",
       "items": {
        "type": "object"
       },
       "description": "The stands kept elsewhere, one row per thing"
      },
      "fold": {
       "type": "object",
       "description": "How two texts are the same text, as the owner of the rules declares it: lowercase, quotes ([[from characters, to]]), collapse_space, strip_trailing (a pattern)"
      },
      "by": {
       "type": "string",
       "description": "Who a row with no by was said through (default person)"
      },
      "summary_only": {
       "type": "boolean",
       "description": "True: only the summary"
      }
     }
    },
    "output_schema": {
     "type": "object",
     "required": [
      "summary"
     ],
     "properties": {
      "writes": {
       "type": "array",
       "items": {
        "type": "object",
        "required": [
         "id",
         "type",
         "value"
        ]
       }
      },
      "summary": {
       "type": "object",
       "required": [
        "rows",
        "records",
        "versions",
        "by_kind",
        "refs_changed",
        "collisions"
       ]
      }
     }
    },
    "invoke": {
     "kind": "container",
     "files": {
      "package_files": [
       {
        "package": "where-a-person-stands",
        "paths": [
         "do-work",
         "read-data"
        ],
        "at": "/opt/where-a-person-stands"
       },
       {
        "package": "content-identity",
        "paths": [
         "read-data"
        ],
        "at": "/opt/content-identity"
       },
       {
        "module": "@noble/hashes",
        "paths": [
         "LICENSE",
         "package.json",
         "blake3.js",
         "blake2.js",
         "_blake.js",
         "_md.js",
         "_u64.js",
         "utils.js"
        ],
        "at": "/opt/node_modules/@noble/hashes"
       }
      ]
     },
     "workdir": "/opt/where-a-person-stands",
     "internet": false,
     "stdout": "json",
     "argv": [
      "node",
      "do-work/plan-stance-reload.mjs"
     ],
     "stdin": {
      "fill": {
       "from": "input"
      }
     }
    },
    "result_selector": "$.result",
    "needs": {
     "expected_seconds": 10,
     "network_egress": false,
     "memory_mb": 256
    },
    "licence_class": "licence:maker-own",
    "placements": [
     "placement:small-container"
    ],
    "maker": "maker:where-a-person-stands",
    "provenance": {
     "source": "the record-stance owner of the decision engine, as a tool: the stand is a record, its history is the record's versions"
    },
    "verify": [
     {
      "kind": "sample-run",
      "input": {
       "fold": {
        "lowercase": true,
        "strip_trailing": "[.!?]+"
       },
       "summary_only": true,
       "stances": [
        {
         "kind": "title",
         "text": "Start Here.",
         "stance": "agree",
         "why": "good",
         "at": "2026-01-01T11:00:00Z",
         "earlier": [
          {
           "stance": "disagree",
           "why": "no",
           "at": "2026-01-01T10:00:00Z"
          }
         ]
        },
        {
         "kind": "title",
         "text": "start here",
         "stance": "disagree",
         "why": "worse",
         "at": "2026-01-01T13:00:00Z"
        }
       ]
      },
      "output_selector": "$.summary.collisions[0].kind",
      "contains": "title"
     }
    ]
   }
  }
