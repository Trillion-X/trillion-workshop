{
 "kind": "tool-rows",
 "record_set": "where-a-person-stands-tool-rows",
 "what_this_is": "The Workshop rows for the tools in tools/where-a-person-stands: what each tool does, what it takes and gives back, how it runs, and the stance record it keeps.",
 "records": [
  {
   "id": "package::where-a-person-stands::tool::keep-where-you-stand",
   "address": "package::where-a-person-stands::tool::keep-where-you-stand",
   "path": [
    "current-item",
    "published-record"
   ],
   "payload": {
    "kind": "ai-tool-descriptor",
    "id": "tool:keep-where-you-stand",
    "label": "Keep where you stand on something",
    "status": "active",
    "job": "Write down whether a person agrees, disagrees or partly agrees with something made for them, such as a title, a take, a plan or a file, in their own words",
    "description": "Give kind (what the thing is: a title, a take, a plan, a file), the thing (artifact_ref, its identity: 1f: and 64 hex digits, or file: and that identity; or the thing itself: text, contains for a part of a text, or view for any JSON, with fold, how its owner says two texts are the same), stance (agree, disagree or partly, or null to take a stand back), why (the person's own words, kept exactly) and answered_by \"person\": only send what the person said. Returns the stance record, kept in the person's records as one record per kind and identity (stance:<kind>:<identity>), so a change of mind is a new version and every earlier stand stays in its history. Text is identified folded, so the same title typed again finds the same stand. A name instead of an identity, or a stand not answered by the person, is refused.",
    "input_schema": {
     "type": "object",
     "required": [
      "kind",
      "stance",
      "answered_by"
     ],
     "additionalProperties": false,
     "properties": {
      "kind": {
       "type": "string",
       "description": "What kind of thing the stand is on (title, voice take, plan, file)"
      },
      "artifact_ref": {
       "type": "string",
       "pattern": "^(file:)?1f:[0-9a-f]{64}$",
       "description": "The identity of the thing the stand is on"
      },
      "text": {
       "type": "string",
       "description": "The thing itself, when it is a text"
      },
      "contains": {
       "type": "string",
       "description": "A part of a text the person named"
      },
      "view": {
       "description": "The thing itself, when it is JSON (a plan, a measure report)"
      },
      "fold": {
       "type": "object",
       "description": "How two texts are the same text, as the owner of the rules declares it: lowercase, quotes ([[from characters, to]]), collapse_space, strip_trailing (a pattern)"
      },
      "stance": {
       "type": [
        "string",
        "null"
       ],
       "enum": [
        "agree",
        "disagree",
        "partly",
        null
       ],
       "description": "Where the person stands; null takes the stand back"
      },
      "why": {
       "type": "string",
       "description": "The person's own words, exactly as they said them"
      },
      "answered_by": {
       "type": "string",
       "enum": [
        "person"
       ],
       "description": "Always person: a stand is only ever theirs"
      },
      "by": {
       "type": "string",
       "description": "Who sent it (the app or chat), when it is not the person's own screen"
      },
      "at": {
       "type": "string",
       "description": "When they said it, as an ISO time (default: now)"
      }
     }
    },
    "output_schema": {
     "type": "object",
     "required": [
      "stance_record"
     ],
     "properties": {
      "stance_record": {
       "type": "object",
       "required": [
        "type",
        "id",
        "kind",
        "artifact",
        "stance",
        "by",
        "at"
       ],
       "properties": {
        "type": {
         "type": "string"
        },
        "id": {
         "type": "string"
        },
        "kind": {
         "type": "string"
        },
        "artifact": {
         "type": "string"
        },
        "text": {
         "type": "string"
        },
        "contains": {
         "type": "string"
        },
        "view": {},
        "stance": {
         "type": [
          "string",
          "null"
         ]
        },
        "said": {
         "type": "string"
        },
        "why": {
         "type": "string"
        },
        "by": {
         "type": "string"
        },
        "at": {
         "type": "string"
        }
       }
      }
     }
    },
    "keeps_records": [
     {
      "output_selector": "$.stance_record",
      "type_field": "type",
      "id_field": "id"
     }
    ],
    "invoke": {
     "kind": "container",
     "files": {
      "package_files": [
       {
        "package": "where-a-person-stands",
        "paths": [
         "do-work",
         "read-data"
        ],
        "at": "/opt/where-a-person-stands"
       },
       {
        "package": "content-identity",
        "paths": [
         "read-data"
        ],
        "at": "/opt/content-identity"
       },
       {
        "module": "@noble/hashes",
        "paths": [
         "LICENSE",
         "package.json",
         "blake3.js",
         "blake2.js",
         "_blake.js",
         "_md.js",
         "_u64.js",
         "utils.js"
        ],
        "at": "/opt/node_modules/@noble/hashes"
       }
      ]
     },
     "workdir": "/opt/where-a-person-stands",
     "internet": false,
     "stdout": "json",
     "argv": [
      "node",
      "do-work/keep-where-you-stand.mjs"
     ],
     "stdin": {
      "fill": {
       "from": "input"
      }
     }
    },
    "result_selector": "$.result",
    "needs": {
     "expected_seconds": 5,
     "network_egress": false,
     "memory_mb": 128
    },
    "licence_class": "licence:maker-own",
    "placements": [
     "placement:small-container"
    ],
    "maker": "maker:where-a-person-stands",
    "provenance": {
     "source": "the record-stance owner of the decision engine, as a tool: the stand is a record, its history is the record's versions"
    },
    "verify": [
     {
      "kind": "sample-run",
      "input": {
       "kind": "title",
       "text": "Start Here.",
       "fold": {
        "lowercase": true,
        "collapse_space": true,
        "strip_trailing": "[.!?]+"
       },
       "stance": "partly",
       "why": "fine for now",
       "answered_by": "person",
       "at": "2026-01-01T12:00:00Z"
      },
      "output_selector": "$.stance_record.id",
      "contains": "stance:title:1f:"
     }
    ]
   }
  },
  {
   "id": "package::where-a-person-stands::tool::read-where-you-stand",
   "address": "package::where-a-person-stands::tool::read-where-you-stand",
   "path": [
