        "kind": "ai-tool-descriptor",
        "id": "tool:record-an-introduction-state",
        "label": "Record an introduction state",
        "job": "Record one introduction's state (proposed, sent, accepted, declined, passed, expired, and the rest) in the person's own database, with the consent it was shown.",
        "description": "Records one introduction's state move in the person's own database named by `database`: a move the lifecycle allows, from the state it is in now, and a move to sent or one_yes only with the consent the introduction was shown. It records states only: it sends nothing to any person and sets no route, wake or notice. Live sending waits for the owner's word.",
        "status": "active",
        "input_schema": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "database",
            "a",
            "b",
            "from",
            "to"
          ],
          "properties": {
            "a": {
              "type": "string",
              "minLength": 1,
              "description": "One person in the introduction (their network address)."
            },
            "b": {
              "type": "string",
              "minLength": 1,
              "description": "The other person in the introduction (their network address)."
            },
            "database": {
              "type": "string",
              "minLength": 1,
              "description": "The name of the person's database, such as shop_for_who_runs_it. The computer opens it with the login its vault holds as that name and -connection."
            },
            "from": {
              "type": "string",
              "enum": [
                "proposed",
                "one_yes",
                "sent",
                "accepted",
                "declined",
                "waiting_for_ais",
                "introduced",
                "talked",
                "passed",
                "expired"
              ]
            },
            "to": {
              "type": "string",
              "enum": [
                "proposed",
                "one_yes",
                "sent",
                "accepted",
                "declined",
                "waiting_for_ais",
                "introduced",
                "talked",
                "passed",
                "expired"
              ]
            },
            "consent": {
              "type": "string",
              "description": "The consent the person gave for the introduction as it was shown (required for sent and one_yes)."
            },
            "shown": {
              "type": "object",
              "description": "The introduction as it was shown: text, recipients, shared and expires_at."
            }
          }
        },
        "output_schema": {
          "type": "object",
          "properties": {
            "result": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "status": {
                  "type": "string"
                },
                "says": {
                  "type": "string"
                },
                "database": {
                  "type": "string"
                }
              }
            },
            "error": {
              "type": "string"
            },
            "status": {
              "type": "integer"
            }
          }
        },
