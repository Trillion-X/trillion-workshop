#!/usr/bin/env python3
# packages/observed-content/do-work/process-scripts/test_reverse_roundtrip.py
#
# WS-B reverse-direction round-trip guard. Proves the OUTBOUND leg of the
# bidirectional external-endpoint sync end-to-end, and that it closes the loop
# with the INBOUND observer — using ONLY the shipped, format-blind scripts and a
# temp directory (no live engine, no network, no credentials):
#
#   package record (doc)
#     -> write-apple-notes-local.py   (OUTBOUND writer)  -> <slug>.md on disk
#     -> observe-apple-notes-local.py  (INBOUND observer) -> external-content-observed record
#
# The observed record's title must equal the original doc title: content that
# leaves a package through the writer must be recoverable by the observer that
# reads the same endpoint. This is the reverse of the already-live-proven inbound
# sync (Apple Notes file -> documents), so together they prove the
# primitive is bidirectional. Generic: swap the descriptor `location`/`sink_ref`
# for any markdown-note directory and it still holds (deletion test) — no
# Apple-specific branching anywhere.
#
# Run: python3 test_reverse_roundtrip.py   (exit 0 = pass, non-zero = fail)

import json
import pathlib
import subprocess
import sys
import tempfile

HERE = pathlib.Path(__file__).resolve().parent
WRITER = HERE / "write-apple-notes-local.py"
OBSERVER = HERE / "observe-apple-notes-local.py"


def run(script: pathlib.Path, *args: str) -> int:
    return subprocess.run([sys.executable, str(script), *args], check=False).returncode


def read_json(path: pathlib.Path):
    return json.loads(path.read_text(encoding="utf-8"))


def main() -> int:
    doc_title = "The Kinetic Chain in the Modern Forehand"
    doc_body = (
        "Hip-shoulder separation stores elastic energy; the racket lags, then "
        "the kinetic chain releases it sequentially from ground to contact."
    )

    with tempfile.TemporaryDirectory() as tmp:
        base = pathlib.Path(tmp)
        notes_dir = base / "apple-notes-dir"
        notes_dir.mkdir()

        # --- OUTBOUND: package record -> external .md file ---
        sink = {"sink_ref": "apple-notes-local", "location": str(notes_dir),
                "encoder_capability_ref": "markdown-note-encoder"}
        record = {"record_id": "doc:kinetic-chain", "source_kind": "apple-notes",
                  "title": doc_title, "text": doc_body}
        (base / "sink.json").write_text(json.dumps(sink))
        (base / "record.json").write_text(json.dumps(record))
        rc = run(WRITER, str(base / "sink.json"), str(base / "record.json"), str(base / "out.json"))
        assert rc == 0, f"writer exit {rc}"
        out = read_json(base / "out.json")
        assert out["status"] == "written", f"expected written, got {out}"
        md_files = list(notes_dir.glob("*.md"))
        assert len(md_files) == 1, f"expected 1 .md, got {md_files}"
        assert md_files[0].read_text(encoding="utf-8").startswith(f"# {doc_title}"), "md missing # title"

        # --- idempotency: re-writing identical content must SKIP, not duplicate ---
        run(WRITER, str(base / "sink.json"), str(base / "record.json"), str(base / "out2.json"))
        assert read_json(base / "out2.json")["status"] == "skipped", "second write should skip (idempotent)"
        assert len(list(notes_dir.glob("*.md"))) == 1, "idempotent write must not duplicate files"

        # --- INBOUND: observe the same dir -> record (closes the round-trip) ---
        (base / "cursor.json").write_text("{}")
        (base / "obs-desc.json").write_text(json.dumps({"source_ref": "apple-notes-local", "location": str(notes_dir)}))
        rc = run(OBSERVER, str(base / "obs-desc.json"), str(base / "cursor.json"), str(base / "observed.json"))
        assert rc == 0, f"observer exit {rc}"
        observed = read_json(base / "observed.json")
        entries = observed if isinstance(observed, list) else observed.get("items", [])
        titles = [e.get("payload", {}).get("title") for e in entries]
        assert doc_title in titles, f"round-trip broken: {doc_title!r} not in observed {titles!r}"

    print("PASS: reverse round-trip (doc -> .md -> re-observed) + idempotency + title fidelity")
    return 0


if __name__ == "__main__":
    sys.exit(main())
