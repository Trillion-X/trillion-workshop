                  "is_active": true,
                  "mechanism_capability_ref": "package::notice-when-something-shows-up::mechanism::due-time",
                  "mechanism_leaf": "due-time.mjs",
                  "mechanism_settings": {
                    "from_wakes": {
                      "kind": "due-time"
                    },
                    "look_again_seconds": 60,
                    "look_again_why": "A wake switched on since the last look is watched within a minute; reading the list is one door call a minute."
                  },
                  "emitted_record": {
                    "change_kind": "due-time",
                    "address_label": "clock::due",
                    "path_labels": [
                      "current-item",
                      "due-time"
                    ],
                    "payload_fields": [
                      "schedule_id",
                      "start",
                      "record_id",
                      "operation"
                    ]
                  },
                  "candidate_identity_feed": null,
                  "why": "What timed-action says is due (tools/run-work-later-or-on-a-repeat whenToWake), told as a fact once per occurrence. The schedules are the ones the switched-on wakes that hear due-time ask for in their watch (wake:list), so each lives once, on the row that wants it: a tool hears its own with a wake {fact: {kind: due-time, from: [run], match: {schedule_id}, watch: {schedules: [...]}}}."
                }
