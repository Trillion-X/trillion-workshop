        "placements": [
          "placement:small-container"
        ],
        "needs": {
          "expected_seconds": 0,
          "network_egress": false,
          "memory_mb": 128
        },
        "id": "tool:notice-when-something-shows-up",
        "listed_on": "2026-11-18T06:30:00Z",
        "label": "Notice when something shows up, and tell the engine",
        "job": "Keep watching for things outside (a stretch of time passing, a drive attached or removed, files someone finished putting in a place, a delivery over the network) and tell the person's engine one fact each time, so any tool whose wake hears that kind of fact starts",
        "description": "Give waiters: the standing orders the noticer keeps (notice-when-something-shows-up.waiter-descriptor rows, each naming one mechanism in do-work/mechanisms, its settings and the kind of fact it emits). It runs as a kept-open program: while its wake is on, each waiter waits, and each time something shows up or goes away it tells the engine one fact at wake:arrive, of the waiter's kind, with the change's fields as text. A tool hears it by declaring a wake {fact: {kind, from: [\"run\"], match}}. This row may tell only the kinds its rights name. Each fact told or refused is one line of the program's output. Given for_seconds, it watches that long and answers {told, refused}.",
        "input_schema": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "waiters": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "kind",
                  "id",
                  "is_active",
                  "mechanism_capability_ref",
                  "mechanism_leaf",
                  "emitted_record"
                ]
              },
              "minItems": 1
            },
            "for_seconds": {
              "type": "number",
              "exclusiveMinimum": 0,
              "description": "Watch this long, then answer every fact told; left out, it watches until it is stopped (its wake keeps it running)."
            }
          },
          "required": [
            "waiters"
          ]
        },
        "invoke": {
          "kind": "container",
          "files": {
            "package_files": [
              {
                "package": "notice-when-something-shows-up",
                "paths": [
                  "do-work"
                ],
                "at": "/opt/notice-when-something-shows-up"
              },
              {
                "package": "wall-time",
                "paths": [
                  "read-data"
                ],
                "at": "/opt/wall-time"
              },
              {
                "package": "run-work-later-or-on-a-repeat",
                "paths": [
                  "do-work"
                ],
                "at": "/opt/run-work-later-or-on-a-repeat"
              },
              {
                "packages": [
                  "node_modules/@noble/hashes"
                ],
                "paths": [
                  "LICENSE",
                  "package.json",
                  "blake3.js",
                  "blake2.js",
                  "_blake.js",
                  "_md.js",
                  "_u64.js",
                  "utils.js"
                ],
                "at": "/opt/node_modules/@noble/hashes"
              }
            ]
          },
          "workdir": "/opt/notice-when-something-shows-up",
          "internet": false,
          "argv": [
            "node",
            "do-work/tell-the-engine.mjs",
            "--keep",
            {
              "fill": {
                "from": "task",
                "field": "kept_folder"
              }
            }
          ],
          "stdin": {
            "fill": {
              "from": "input"
            }
          },
          "session": {
            "keep_open": true
          },
          "kept_folder": true,
          "records": {
            "fd": 3,
            "rights": [
              {
                "at": "@own-records",
                "id": "clock-tick",
