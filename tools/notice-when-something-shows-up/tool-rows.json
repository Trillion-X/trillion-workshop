{
  "kind": "tool-rows",
  "record_set": "notice-when-something-shows-up",
  "what_this_is": "The noticer as a Workshop tool: kept running by its wake, it tells the engine one fact per thing that showed up or went away.",
  "records": [
    {
      "id": "package::notice-when-something-shows-up::tool::notice-when-something-shows-up",
      "address": "package::notice-when-something-shows-up::tool::notice-when-something-shows-up",
      "path": [
        "current-item",
        "published-record"
