                  "mechanism_leaf": "row-changes.mjs",
                  "mechanism_settings": {
                    "connection_fd": 4,
                    "table": "row_changes",
                    "channel": "row_changes",
                    "look_again_seconds": 30,
                    "look_again_why": "NOTIFY wakes it at once; the reread catches a notice lost while it was not listening."
                  },
                  "emitted_record": {
                    "change_kind": "row-changes",
                    "address_label": "database::row-changes",
                    "path_labels": [
                      "current-item",
                      "row-changes"
                    ],
                    "payload_fields": [
                      "database",
                      "table_name",
                      "op",
                      "at",
                      "txid",
                      "position",
                      "connection"
                    ]
                  },
                  "candidate_identity_feed": null,
                  "why": "Each change of a table the person's AI attached record_row_change() to, in the database whose connection the person keeps under own-rows-postgres-connection (made by workflow:make-a-database-for-each-pursuit), told once in commit order. The fact names where the change is, never the row: the engine admits at most 8 text fields of 1,024 bytes each, so a reader takes before and after from the change table at `position`, through the vault name in `connection`. A tool hears it with a wake {fact: {kind: row-changes, from: [run], match: {table_name}}}."
                }
              ]
            }
          }
        ],
