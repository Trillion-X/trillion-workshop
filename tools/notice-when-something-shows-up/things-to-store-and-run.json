    {
      "type": "record",
      "address": "package::notice-when-something-shows-up::trigger-rule::on-runtime-loaded",
      "address_mode": "identity_text",
      "path": [
        "current-item",
        "published-record",
        "trigger-rule"
      ],
      "payload": {
        "id": "trigger:notice-when-something-shows-up:start-on-runtime-loaded",
        "topic": "runtime_loaded",
        "trigger_type": "lifecycle",
        "is_active": true,
        "description": "Start the resident waiter once per runtime-loaded lifecycle fact, using that fact's ID as the idempotency key and its stable app identity for current authority discovery.",
        "match_condition": {
          "conditions": [
            {
              "$kind": "binding",
              "select": {
                "from": "change",
                "path": "properties.event_type"
              },
              "transform": [
                {
                  "op": "op:core.equals",
                  "args": {
                    "value": "runtime_loaded"
                  }
                }
              ]
            }
          ]
        },
        "dispatch": {
          "target": "slot::workflow",
          "output_template": {
            "operation": "execute_definition",
            "definition_id": "action:notice-when-something-shows-up:start-waiting",
            "input": {
              "idempotency_key": {
                "$kind": "binding",
                "select": {
                  "from": "change",
                  "path": "id"
                }
              },
              "partition": {
                "$kind": "binding",
                "select": {
                  "from": "change",
                  "path": "properties.runtime_context.partition"
                }
              },
              "app_id": {
                "$kind": "binding",
                "select": {
                  "from": "change",
                  "path": "properties.runtime_context.app_id"
                }
              }
            }
          }
        }
      }
    },
    {
