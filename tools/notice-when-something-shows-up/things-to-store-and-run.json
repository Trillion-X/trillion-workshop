{
  "package": "notice-when-something-shows-up",
  "things": [
    {
      "type": "record",
      "address": "package::notice-when-something-shows-up::capability::arrival-fact-emitter",
      "address_mode": "identity_text",
      "path": [
        "packages",
        "notice-when-something-shows-up",
        "published-record"
      ],
      "payload": {
        "kind": "bitfield-package-capability",
        "id": "capability:notice-when-something-shows-up",
        "package": "notice-when-something-shows-up",
        "label": "Something outside became reachable, or stopped being reachable",
        "description": "A resident process reads standing orders (waiter descriptor rows), starts the mechanism each one declares, and appends ONE self-describing fact per transition. It never dispatches: every reaction is a trigger rule matching the fact, which is somebody else's DATA. The clock is one waiter row whose projection reproduces the clock-tick record byte for byte, which is why this package supersedes clock-ticker with zero consumer edits.",
        "owned_record_kinds": [
          "something-showed-up",
          "clock-tick",
          "notice-when-something-shows-up.waiter-descriptor"
        ],
        "reuses": [
          "workflow",
          "trigger-engine",
          "compute.process_session"
        ]
      }
    },
    {
      "type": "record",
      "address": "package::notice-when-something-shows-up::contract::arrival-fact",
      "address_mode": "identity_text",
      "path": [
        "packages",
        "notice-when-something-shows-up",
        "published-record"
      ],
      "payload": {
        "kind": "package-record-contract",
        "record_kind": "something-showed-up",
        "required_fields": [
          "kind",
          "waiter_ref",
          "condition",
          "observed_at",
          "observed_identity",
          "matched_source_refs",
          "sequence"
        ],
        "optional_fields": [],
        "condition_contract": "condition is closed by physics: became-reachable or became-unreachable. A refused waiter row is recorded as became-unreachable with observed_identity.waiter_refused true, so a waiter that could not start is never silent.",
        "identity_contract": "observed_identity is whatever the mechanism could learn, opaque to every reader that does not care. matched_source_refs is computed from identity predicates on source descriptor rows and NEVER from a visible name; an empty array is the first-class case where a thing nobody declared showed up.",
        "sequence_contract": "sequence is monotonic per waiter_ref and is resumed from the current record in the log, never from a file on disk. A predecessor record carrying counter instead of sequence resumes from counter, so the clock supersession is continuous.",
        "dispatch_contract": "The emitter appends and never dispatches. No workflow target, action id, or consumer name appears in this package's code or DATA. Eligibility lives in trigger rules owned by whoever reacts."
      }
    },
    {
      "type": "record",
      "address": "package::notice-when-something-shows-up::retention-policy::something-showed-up",
      "address_mode": "identity_text",
      "path": [
        "packages",
        "notice-when-something-shows-up",
        "retention-policies",
        "something-showed-up"
      ],
      "payload": {
        "kind": "record-retention-policy",
        "record_kind": "something-showed-up",
        "owner_package": "notice-when-something-shows-up",
        "retention": {
          "class": "history",
          "keep_generations": 64
        },
        "justification": "One address per waiter; every transition re-appends it. The last sixty-four transitions per waiter are enough to reconstruct what attached and detached across a day of plugging and unplugging, and a consumer that needs more keeps its own record."
      }
    },
    {
      "type": "record",
      "address": "package::notice-when-something-shows-up::waiter-descriptor::elapsed-time",
      "address_mode": "identity_text",
      "path": [
        "packages",
        "notice-when-something-shows-up",
        "waiter-descriptor"
      ],
      "payload": {
        "kind": "notice-when-something-shows-up.waiter-descriptor",
        "id": "waiter:elapsed-time",
        "is_active": true,
        "mechanism_capability_ref": "package::notice-when-something-shows-up::mechanism::elapsed-time",
        "mechanism_leaf": "elapsed-time.mjs",
        "mechanism_settings": {
          "interval_seconds": 45,
          "every": "interval"
        },
        "emitted_record": {
          "change_kind": "clock-tick",
          "address_label": "clock::tick",
          "path_labels": [
            "current-item",
            "clock-tick"
          ],
          "payload_fields": [
            "iso_time",
            "epoch_ms",
            "counter",
            "every"
          ]
        },
        "candidate_identity_feed": null,
        "supersedes": "package::clock-ticker::workflow-action::start-clock",
        "why": "This row IS the clock. Its projection writes the exact clock-tick record at the exact address and path labels clock-ticker wrote, so every trigger rule matching clock-tick keeps firing with no edit."
      }
    },
    {
      "type": "record",
      "address": "package::notice-when-something-shows-up::waiter-descriptor::attached-volumes",
      "address_mode": "identity_text",
      "path": [
        "packages",
        "notice-when-something-shows-up",
        "waiter-descriptor"
      ],
      "payload": {
        "kind": "notice-when-something-shows-up.waiter-descriptor",
        "id": "waiter:attached-volumes",
        "is_active": true,
        "mechanism_capability_ref": "package::notice-when-something-shows-up::mechanism::filesystem-volume-attachment",
        "mechanism_leaf": "filesystem-volume-attachment.mjs",
        "mechanism_settings": {
          "attachment_place": "/Volumes",
          "settle_milliseconds": 750
        },
        "emitted_record": {
          "change_kind": "something-showed-up",
          "address_label": "something-showed-up::attached-volumes",
          "path_labels": [
            "current-item",
            "something-showed-up"
          ],
          "payload_fields": [
            "waiter_ref",
            "condition",
            "observed_at",
            "observed_identity",
            "matched_source_refs",
            "sequence"
          ]
        },
        "candidate_identity_feed": {
          "path_labels": [
            "prop:observed_content:source_descriptor"
          ],
          "value_field": "value_json",
          "source_ref_field": "source_ref",
          "predicate_field": "identity_predicate"
        },
        "why": "A storage volume becoming reachable under the attachment place is a fact. Which declared source it is comes from identity predicates on the source descriptor rows, matched on filesystem identity and never on the visible name."
      }
    },
    {
      "type": "record",
      "address": "package::notice-when-something-shows-up::waiter-descriptor::handed-over-files",
      "address_mode": "identity_text",
      "path": [
        "packages",
        "notice-when-something-shows-up",
        "waiter-descriptor"
      ],
      "payload": {
        "kind": "notice-when-something-shows-up.waiter-descriptor",
        "id": "waiter:handed-over-files",
        "is_active": true,
        "mechanism_capability_ref": "package::notice-when-something-shows-up::mechanism::files-someone-finished-putting-here",
        "mechanism_leaf": "files-someone-finished-putting-here.mjs",
        "mechanism_settings": {
          "handover_place": {
            "from": "environment",
            "key": "BITFIELD_HANDOVER_PLACE"
          },
          "completion_note_suffix": ".handover-finished.json",
          "rescan_milliseconds": 2000
        },
        "emitted_record": {
          "change_kind": "something-showed-up",
          "address_label": "something-showed-up::handed-over-files",
          "path_labels": [
            "current-item",
            "something-showed-up"
          ],
          "payload_fields": [
            "waiter_ref",
            "condition",
            "observed_at",
            "observed_identity",
            "matched_source_refs",
            "sequence"
          ]
        },
        "candidate_identity_feed": {
          "path_labels": [
            "prop:observed_content:source_descriptor"
          ],
          "value_field": "value_json",
          "source_ref_field": "source_ref",
          "predicate_field": "identity_predicate"
        },
        "why": "Somebody outside finished putting a unit in a place, and this row reports each one. THE PLACE IS THE WRITER'S PRIVATE VOLUME, read WITHOUT taking its lease. This row shipped inactive until 2026-09-10 because reading a private volume inherited writing's exclusivity: the volume is leased LOCK_EX for the whole session, collected_files fire only after termination and a resident writer never terminates, and store-bytes-to-cas needs a whole Uint8Array so a large original cannot be copied out either. Three closed doors meant a resident writer's bytes were reachable by nothing. architect 352f9b79 split the two permissions: the start action declares readable_private_volumes and binds BITFIELD_HANDOVER_PLACE to the volume's resolved root through a workspace binding, so this row names an environment key rather than a host path, and any number of readers may share a volume one writer is filling. A literal '.' here would resolve to this process's ephemeral working directory, which is readable, listable and permanently empty, so the mechanism would report nothing while looking healthy; that is why the place is resolved by the owner and an absent volume is refused rather than created. The completion note is the completeness signal and the identity carrier, so a half written unit is invisible rather than merely unlikely, and no unit is ever read twice to learn what it is. Which sender it was comes from identity predicates on the source descriptor rows, matched on the opaque handed_over_by string the receiver wrote and never on a filename."
      }
    },
    {
      "type": "record",
      "address": "package::notice-when-something-shows-up::workflow-action::start-waiting",
      "address_mode": "identity_text",
      "path": [
        "current-item",
        "published-record",
        "workflow-definition"
      ],
      "payload": {
        "id": "action:notice-when-something-shows-up:start-waiting",
        "kind": "action",
        "is_active": true,
        "name": "start the resident waiter",
        "description": "Boot the arrival emitter as a durable compute.process_session. Runtime lifecycle DATA carries stable app identity and partition. The shared connector privately discovers the current authority for each request.",
        "input_schema": {
          "properties": {
            "partition": {
              "type": "string"
            },
            "max_consecutive_failures": {
              "type": "string"
            },
            "idempotency_key": {
              "type": "string"
            },
            "app_id": {
              "type": "string"
            }
          }
        },
        "steps": [
          {
            "id": "read_emitter",
            "join": "any",
            "join_config": null,
            "kind": "read",
            "config": {
              "from": "package::notice-when-something-shows-up::stored-bytes::emit-arrival-fact-mjs"
            }
          },
          {
            "id": "read_running_app_owner",
            "join": "any",
            "join_config": null,
            "kind": "read",
            "config": {
              "from": "package::send-requests-to-an-engine::stored-bytes::find-and-send-node-source"
            }
          },
          {
            "id": "read_mechanism_elapsed_time",
            "join": "any",
            "join_config": null,
            "kind": "read",
            "config": {
              "from": "package::notice-when-something-shows-up::stored-bytes::mechanism-elapsed-time-mjs"
            }
          },
          {
            "id": "read_mechanism_filesystem_volume_attachment",
            "join": "any",
            "join_config": null,
            "kind": "read",
            "config": {
              "from": "package::notice-when-something-shows-up::stored-bytes::mechanism-filesystem-volume-attachment-mjs"
            }
          },
          {
            "id": "read_mechanism_inbound_http_delivery",
            "join": "any",
            "join_config": null,
            "kind": "read",
            "config": {
              "from": "package::notice-when-something-shows-up::stored-bytes::mechanism-inbound-http-delivery-mjs"
            }
          },
          {
            "id": "read_mechanism_files_someone_finished_putting_here",
            "join": "any",
            "join_config": null,
            "kind": "read",
            "config": {
              "from": "package::notice-when-something-shows-up::stored-bytes::mechanism-files-someone-finished-putting-here-mjs"
            }
          },
          {
            "kind": "ask",
            "config": {
              "name": "compute.process_session",
              "input": {
                "operation": "start_session",
                "idempotency_key": {
                  "$kind": "binding",
                  "select": {
                    "from": "input",
                    "path": "idempotency_key"
                  }
                },
                "descriptor": {
                  "process": {
                    "argv": [
                      "node",
                      "emit-arrival-fact.mjs"
                    ],
                    "cwd": null,
                    "timeout_ms": 31536000000,
                    "termination_grace_ms": 1000,
                    "expected_termination": null,
                    "env": {
                      "BITFIELD_ARRIVAL_MAX_CONSECUTIVE_FAILURES": {
                        "$kind": "binding",
                        "select": {
                          "from": "input",
                          "path": "max_consecutive_failures"
                        },
                        "transform": [
                          {
                            "op": "op:core.if_null",
                            "args": {
                              "fallback": "10"
                            }
                          }
                        ]
                      },
                      "BITFIELD_ARRIVAL_PARTITION": {
                        "$kind": "binding",
                        "select": {
                          "from": "input",
                          "path": "partition"
                        },
                        "transform": [
                          {
                            "op": "op:core.if_null",
                            "args": {
                              "fallback": ""
                            }
                          }
                        ]
                      },
                      "RUNNING_APP_APP_ID": {
                        "$kind": "binding",
                        "select": {
                          "from": "input",
                          "path": "app_id"
                        },
                        "transform": [
                          {
                            "op": "op:core.if_null",
                            "args": {
                              "fallback": ""
                            }
                          }
                        ]
                      }
                    },
                    "inputs": [
                      {
                        "mount_path": "emit-arrival-fact.mjs",
                        "content_type": "text/javascript",
                        "source": {
                          "kind": "blob_ref",
                          "hash": {
                            "$kind": "binding",
                            "select": {
                              "from": "steps",
                              "key": "read_emitter",
                              "path": "output.content_hash"
                            }
                          }
                        }
                      },
                      {
                        "mount_path": "mechanisms/elapsed-time.mjs",
                        "content_type": "text/javascript",
                        "source": {
                          "kind": "blob_ref",
                          "hash": {
                            "$kind": "binding",
                            "select": {
                              "from": "steps",
                              "key": "read_mechanism_elapsed_time",
                              "path": "output.content_hash"
                            }
                          }
                        }
                      },
                      {
                        "mount_path": "mechanisms/filesystem-volume-attachment.mjs",
                        "content_type": "text/javascript",
                        "source": {
                          "kind": "blob_ref",
                          "hash": {
                            "$kind": "binding",
                            "select": {
                              "from": "steps",
                              "key": "read_mechanism_filesystem_volume_attachment",
                              "path": "output.content_hash"
                            }
                          }
                        }
                      },
                      {
                        "mount_path": "mechanisms/inbound-http-delivery.mjs",
                        "content_type": "text/javascript",
                        "source": {
                          "kind": "blob_ref",
                          "hash": {
                            "$kind": "binding",
                            "select": {
                              "from": "steps",
                              "key": "read_mechanism_inbound_http_delivery",
                              "path": "output.content_hash"
                            }
                          }
                        }
                      },
                      {
                        "mount_path": "mechanisms/files-someone-finished-putting-here.mjs",
                        "content_type": "text/javascript",
                        "source": {
                          "kind": "blob_ref",
                          "hash": {
                            "$kind": "binding",
                            "select": {
                              "from": "steps",
                              "key": "read_mechanism_files_someone_finished_putting_here",
                              "path": "output.content_hash"
                            }
                          }
                        }
                      },
                      {
                        "mount_path": "running-app-requests.mjs",
                        "content_type": "text/javascript",
                        "source": {
                          "kind": "blob_ref",
                          "hash": {
                            "$kind": "binding",
                            "select": {
                              "from": "steps",
                              "key": "read_running_app_owner",
                              "path": "output.content_hash"
                            }
                          }
                        }
                      }
                    ],
                    "input_trees": [],
                    "outputs": [],
                    "readable_private_volumes": [
                      "files-handed-over-to-this-computer"
                    ],
                    "network_access": "allowed",
                    "containment": {
                      "kind": "leaf"
                    },
                    "capture_fds": [
                      1,
                      2
                    ],
                    "collected_files": []
                  },
                  "workspace_bindings": {
                    "environment": [
                      {
                        "key": "BITFIELD_HANDOVER_PLACE",
                        "parts": [
                          {
                            "kind": "readable_private_volume_root",
                            "name": "files-handed-over-to-this-computer"
