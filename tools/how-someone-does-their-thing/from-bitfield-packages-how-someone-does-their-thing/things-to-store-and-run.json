    {
      "type": "record",
      "address": "package::how-someone-does-their-thing::workflow-action::build-profile",
      "address_mode": "identity_text",
      "path": [
        "current-item",
        "published-record",
        "workflow-definition"
      ],
      "payload": {
        "id": "action:build-profile",
        "kind": "action",
        "is_active": true,
        "name": "build-profile",
        "description": "Build or refresh one profile by gathering the subject's current records, dispatching ai-records-producer, then writing the returned profile items back as profile facts. The same profile record is used for validation and draft conditioning.",
        "input_schema": {
          "required": [
            "request_id",
            "profile_ref",
            "subject_ref"
          ],
          "properties": {
            "request_id": {
              "type": "string"
            },
            "profile_ref": {
              "type": "string"
            },
            "subject_ref": {
              "type": "string"
            },
            "instruction_text": {
              "type": "string"
            },
            "output_kind": {
              "type": "string"
            },
            "wrap_instruction_ref": {
              "type": "string"
            }
          }
        },
        "steps": [
          {
            "kind": "ask",
            "config": {
              "name": "slot::find-current-items",
              "input": {
                "operation": "find-current-items",
                "in": "attribute_fact",
                "select": [
                  "subject_id",
                  "property_id",
                  "value_json"
                ],
                "where": {
                  "all": [
                    {
                      "field": "subject_id",
                      "eq": {
                        "$kind": "binding",
                        "select": {
                          "from": "input",
                          "path": "subject_ref"
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          {
            "kind": "ask",
            "config": {
              "name": "slot::workflow",
              "input": {
                "operation": "execute_definition",
                "definition_id": "action:run-ai-records-production",
                "input": {
                  "request_id": {
                    "$kind": "binding",
                    "select": {
                      "from": "input",
                      "path": "request_id"
                    }
                  },
                  "target_group_ref": {
                    "$kind": "binding",
                    "select": {
                      "from": "input",
                      "path": "profile_ref"
                    }
                  },
                  "instruction_text": {
                    "$kind": "binding",
                    "select": {
                      "from": "input",
                      "path": "instruction_text"
                    },
                    "transform": [
                      {
                        "op": "op:core.if_null",
                        "args": {
                          "fallback": {
                            "$kind": "binding",
                            "select": {
                              "from": "steps",
                              "key": "step_0",
                              "path": "output.items"
                            },
                            "transform": [
                              {
                                "op": "op:core.stringify",
                                "args": {
                                  "format": "json"
                                }
                              }
                            ]
                          }
                        }
                      }
                    ]
                  },
                  "output_kind": {
                    "$kind": "binding",
                    "select": {
                      "from": "input",
                      "path": "output_kind"
                    },
                    "transform": [
                      {
                        "op": "op:core.if_null",
                        "args": {
                          "fallback": "profile-fact"
                        }
                      }
                    ]
                  },
                  "wrap_instruction_ref": {
                    "$kind": "binding",
                    "select": {
                      "from": "input",
                      "path": "wrap_instruction_ref"
                    },
                    "transform": [
                      {
                        "op": "op:core.if_null",
                        "args": {
                          "fallback": "instr:how-someone-does-their-thing:build-profile"
                        }
                      }
                    ]
                  }
                }
              }
            }
          },
          {
            "kind": "write",
            "config": {
              "items": [
                {
                  "address": {
                    "$kind": "binding",
                    "select": {
                      "from": "input",
                      "path": "profile_ref"
                    },
                    "transform": [
                      {
                        "op": "op:core.concat",
                        "args": {
                          "values": [
                            "attribute_fact|",
                            {
                              "$kind": "binding",
                              "select": {
                                "from": "input",
                                "path": "profile_ref"
                              }
                            },
                            "|prop:profile:derived_items|type:profile"
                          ]
                        }
                      }
                    ]
                  },
                  "path": [
                    "prop:profile:derived_items"
                  ],
                  "payload": {
                    "table": "attribute_fact",
                    "subject_id": {
                      "$kind": "binding",
                      "select": {
                        "from": "input",
                        "path": "profile_ref"
                      }
                    },
                    "property_id": "prop:profile:derived_items",
                    "type_id": "type:profile",
                    "value_json": {
                      "$kind": "binding",
                      "select": {
                        "from": "steps",
                        "key": "step_1",
                        "path": "output.items"
                      },
                      "transform": [
                        {
                          "op": "op:core.stringify",
                          "args": {
                            "format": "json"
                          }
                        }
                      ]
                    }
                  }
                },
                {
                  "address": {
                    "$kind": "binding",
                    "select": {
                      "from": "input",
                      "path": "profile_ref"
                    },
                    "transform": [
                      {
                        "op": "op:core.concat",
                        "args": {
                          "values": [
                            "attribute_fact|",
                            {
                              "$kind": "binding",
                              "select": {
                                "from": "input",
                                "path": "profile_ref"
                              }
                            },
                            "|prop:profile:last_build_result_ref|type:profile"
                          ]
                        }
                      }
                    ]
                  },
                  "path": [
                    "prop:profile:last_build_result_ref"
                  ],
                  "payload": {
                    "table": "attribute_fact",
                    "subject_id": {
                      "$kind": "binding",
                      "select": {
                        "from": "input",
                        "path": "profile_ref"
                      }
                    },
                    "property_id": "prop:profile:last_build_result_ref",
                    "type_id": "type:profile",
                    "value_json": {
                      "$kind": "binding",
                      "select": {
                        "from": "input",
                        "path": "request_id"
                      },
                      "transform": [
                        {
                          "op": "op:core.concat",
                          "args": {
                            "values": [
                              "\"package::ai-records-producer::result::",
                              {
                                "$kind": "binding",
                                "select": {
                                  "from": "input",
                                  "path": "request_id"
                                }
                              },
                              "\""
                            ]
                          }
                        }
                      ]
                    }
                  }
                }
              ]
            }
          }
        ],
        "edges": [],
        "version": 1,
        "extra": {},
        "extra_properties": {}
