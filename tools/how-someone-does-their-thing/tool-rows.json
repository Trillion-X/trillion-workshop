    "id": "tool:find-repeated-voice-edits",
    "label": "Find the edits a person repeats",
    "status": "active",
    "job": "Find the word changes a person keeps making to drafts written for them",
    "description": "Counts, over the person's kept edits (kind narrows them), the words removed, added or replaced, each once per draft, and returns the changes found in at least min_distinct_drafts different drafts (3 when left out, never below 2), each with an example edit_id. They are proposals to show the person before saving any into a profile with tool:save-voice. Writes nothing.",
    "input_schema": {
     "type": "object",
     "additionalProperties": false,
     "properties": {
      "kind": {
       "type": "string",
       "pattern": "^[a-z][a-z0-9-]{0,39}$",
       "description": "What is written, like post or email; leave out for every kind (or, saving, the general profile)"
      },
      "min_distinct_drafts": {"type": "integer", "minimum": 2}
     }
    },
    "output_schema": {
     "type": "object",
     "required": ["edits", "min_distinct_drafts", "repeated", "said"],
     "properties": {
      "edits": {"type": "integer"},
      "min_distinct_drafts": {"type": "integer"},
      "repeated": {"type": "array"},
      "said": {"type": "string"}
     }
    },
    "invoke": {
     "kind": "container",
     "files": {
      "package_files": [
       {"package": "how-someone-does-their-thing", "paths": ["read-data"], "at": "/opt/how-someone-does-their-thing"},
       {"package": "records-door", "paths": ["do-work", "read-data"], "at": "/opt/records-door"},
       {"package": "content-identity", "paths": ["read-data"], "at": "/opt/content-identity"},
       {
        "module": "@noble/hashes",
        "paths": ["LICENSE", "package.json", "blake3.js", "blake2.js", "_blake.js", "_md.js", "_u64.js", "utils.js"],
        "at": "/opt/node_modules/@noble/hashes"
       }
      ]
     },
     "workdir": "/opt/how-someone-does-their-thing",
     "internet": false,
     "stdout": "json",
     "argv": [
      "node",
      "/opt/records-door/do-work/run-an-export.mjs",
      "/opt/how-someone-does-their-thing/read-data/voice.mjs",
      "findRepeatedVoiceEdits"
     ],
     "stdin": {"fill": {"from": "input"}},
     "records": {"fd": 3, "rights": [{"kind": "voice-edit", "operations": ["records:read", "records:list"]}]}
    },
    "result_selector": "$.result",
    "needs": {"expected_seconds": 10, "network_egress": false, "memory_mb": 256},
    "licence_class": "licence:maker-own",
    "placements": ["placement:small-container"],
    "maker": "maker:how-someone-does-their-thing",
    "provenance": {
     "source": "Trillion-X/trillion src/voice.mjs (the person's writing voice, learned from what they change), moved here; reads and writes the person's voice-edit and voice-profile records through the records door"
    },
    "verify": [{"kind": "sample-run", "input": {}, "output_selector": "$.said", "contains": "No word change recurs"}]
   }
  }
 ]
}
