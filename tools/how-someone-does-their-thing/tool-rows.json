        "paths": ["LICENSE", "package.json", "blake3.js", "blake2.js", "_blake.js", "_md.js", "_u64.js", "utils.js"],
        "at": "/opt/node_modules/@noble/hashes"
       }
      ]
     },
     "workdir": "/opt/how-someone-does-their-thing",
     "internet": false,
     "stdout": "json",
     "argv": [
      "node",
      "/opt/records-door/do-work/run-an-export.mjs",
      "/opt/how-someone-does-their-thing/read-data/voice.mjs",
      "readVoice"
     ],
     "stdin": {"fill": {"from": "input"}},
