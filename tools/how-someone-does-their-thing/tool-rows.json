      "fd": 3,
      "rights": [
       {"kind": "voice-profile", "operations": ["records:read", "records:list"]},
       {"kind": "voice-edit", "operations": ["records:read", "records:list"]},
       {"kind": "post", "operations": ["records:list"]}
