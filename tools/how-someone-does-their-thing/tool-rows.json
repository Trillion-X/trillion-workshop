    {
      "id": "package::how-someone-does-their-thing::tool::save-voice",
      "address": "package::how-someone-does-their-thing::tool::save-voice",
      "path": [
        "current-item",
        "published-record"
      ],
      "payload": {
        "kind": "ai-tool-descriptor",
        "id": "tool:save-voice",
        "label": "Save how someone writes",
        "status": "active",
        "job": "Save what you learned about how this person writes, for one kind of writing",
        "description": "Shapes what you learned into the voice profile of one kind of writing (kind, like post or email; leave out for a general one). earlier is the voice-profile the person's store holds for that kind (null when none), profiles_kept how many it holds. fields are named by voice.json's profile_fields; a field you give replaces that field, an empty one removes it, and the rest are kept. builds_on names the kinds of the profiles this one sits on, earliest first. Pass expected_set_at (the set_at you read) so a profile saved since is not overwritten. by is person only when the person saved it themselves. Returns profile, said and keep: the row the store writes, with the version it was read at.",
        "input_schema": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "fields"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{0,39}$",
              "description": "What is written, like post or email; leave out for every kind (or, saving, the general profile)"
            },
            "name": {
              "type": "string"
            },
            "fields": {
              "type": "object",
              "additionalProperties": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "earlier": {
              "type": [
                "object",
                "null"
              ],
              "description": "The voice-profile record the store holds for this kind, as it reads it, or null when there is none"
            },
            "profiles_kept": {
              "type": "integer",
              "minimum": 0,
              "description": "How many voice-profile records the store holds"
            },
            "expected_set_at": {
              "type": [
                "string",
                "null"
              ]
            },
            "by": {
              "type": "string",
              "enum": [
                "ai",
                "person"
              ]
            }
          }
        },
        "output_schema": {
          "type": "object",
          "required": [
            "profile",
            "said"
          ],
          "properties": {
            "profile": {
              "type": "object"
            },
            "said": {
              "type": "string"
            },
            "keep": {
              "type": "array",
              "description": "What the run made, for the caller to keep where the person keeps it: rows {id, type, value} (value null removes), settings {label, value}, files {file, base64}. The run itself writes nothing."
            }
          }
        },
        "invoke": {
          "kind": "container",
          "files": {
            "package_files": {
              "package": "how-someone-does-their-thing",
              "paths": [
                "do-work",
                "read-data"
              ],
              "at": "/opt/how-someone-does-their-thing"
            }
          },
          "workdir": "/opt/how-someone-does-their-thing",
          "internet": false,
          "stdout": "json",
          "argv": [
            "node",
            "do-work/save-voice.mjs"
          ],
          "stdin": {
            "fill": {
              "from": "input"
            }
          }
        },
        "result_selector": "$.result",
        "needs": {
          "expected_seconds": 10,
          "network_egress": false,
          "memory_mb": 256
        },
        "licence_class": "licence:maker-own",
        "placements": [
          "placement:small-container"
        ],
        "maker": "maker:how-someone-does-their-thing",
        "provenance": {
          "source": "Trillion-X/trillion src/voice.mjs (the person's writing voice, learned from what they change), moved here as the shaper; the store reads and writes the voice-edit and voice-profile records in its own language (workflow:keep-how-someone-does-their-thing)"
        },
