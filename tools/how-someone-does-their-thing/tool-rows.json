              "description": "Whose way of doing the thing this is"
            },
            "subject_records": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object"
              },
              "description": "What the subject made or said, read from their records"
            },
            "instruction": {
              "type": "string",
              "description": "An extra rule for the answer, if any"
            }
          }
        },
        "output_schema": {
          "type": "object",
