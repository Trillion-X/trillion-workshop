   "path": ["current-item", "published-record"],
   "payload": {
    "kind": "ai-tool-descriptor",
    "id": "tool:read-voice",
    "label": "Read how someone writes",
    "status": "active",
    "job": "Read how this person writes before drafting anything for them: a post, an email, a message",
    "description": "Read BEFORE you draft for this person. Returns how_to_use, the profile fields, the voice profiles saved so far (one per kind of writing), their newest edits to words an AI wrote (each with the draft as it was, before, and their words, after) and words they published (sent). Give kind to read one kind's profile and edits; limit is how many edits (1 to 50). Writes nothing.",
    "input_schema": {
     "type": "object",
     "additionalProperties": false,
     "properties": {
      "kind": {
       "type": "string",
       "pattern": "^[a-z][a-z0-9-]{0,39}$",
       "description": "What is written, like post or email; leave out for every kind (or, saving, the general profile)"
      },
      "limit": {"type": "integer", "minimum": 1, "maximum": 50}
     }
    },
    "output_schema": {
     "type": "object",
     "required": ["how_to_use", "fields", "profiles", "edits", "sent"],
     "properties": {
      "how_to_use": {"type": "string"},
      "fields": {"type": "array"},
      "profiles": {"type": "array"},
      "edits": {"type": "array"},
      "sent": {"type": "array"},
      "said": {"type": "string"}
     }
    },
    "invoke": {
     "kind": "container",
     "files": {
      "package_files": [
       {"package": "how-someone-does-their-thing", "paths": ["read-data"], "at": "/opt/how-someone-does-their-thing"},
       {"package": "records-door", "paths": ["do-work", "read-data"], "at": "/opt/records-door"},
