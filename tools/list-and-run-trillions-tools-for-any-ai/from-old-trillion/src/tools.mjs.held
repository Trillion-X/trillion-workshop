  tool_sales: { title: 'Read paid tool earnings', readOnlyHint: true, destructiveHint: false, idempotentHint: true, openWorldHint: false },
  set_up_payouts: { title: 'Set up payouts for paid tools', readOnlyHint: false, destructiveHint: false, idempotentHint: true, openWorldHint: true },
  network_profile: { title: 'Set how people can find me', readOnlyHint: false, destructiveHint: false, idempotentHint: true, openWorldHint: false },
