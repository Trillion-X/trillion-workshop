function withAnnotations(tools) {
  // A tool whose answer is a Trillion screen names the screen view (src/screen-view.mjs, ./screen-view.json tools).
  return withScreenViews(withScreenHints(tools)).map(tool => {
    if (!ANNOTATIONS[tool.name]) throw new Error(`Missing annotations for ${tool.name}`);
    const { title: named, ...hints } = ANNOTATIONS[tool.name];
    const title = placementTitle(tool.name) ?? named;
    return withBehaviorNotes({ ...tool, title, annotations: { title, ...hints } });
  });
}


// Protocol versions this server speaks. A request carrying its version in `_meta` (2026-07-28 and later) is served
// statelessly; an `initialize` request is the earlier handshake. Both are answered on the same endpoint.
export const MODERN_VERSIONS = ['2026-07-28'];
export const LEGACY_VERSIONS = ['2025-11-25', '2025-06-18', '2025-03-26'];
const VERSION_META = 'io.modelcontextprotocol/protocolVersion';
// The results a 2026-07-28 client may cache, and the hint Trillion gives them: revalidate every time, never shared.
const CACHEABLE = ['tools/list', 'prompts/list', 'resources/list', 'resources/templates/list', 'resources/read'];
const KEEP_NOTHING = { ttlMs: 0, cacheScope: 'private' };
// The name of the tool set an AI was given: the BLAKE3 identity of the listed tools. A long-lived session compares it with
// the one `ping` answers now and lists again only when it differs, so a tool added or changed by a deploy or by the
// person's Marketplace is noticed without a relist on every turn.
const toolSetNames = new WeakMap();
const TOOL_SET_META = 'trillion/toolSetFingerprint';
// What a person or AI can expect of a tool that changes something: it only reads, it can be undone (and by which tool), or it is immediate.
const mutationOf = tool => (tool.annotations?.readOnlyHint === true ? { kind: 'read' } : Object.hasOwn(toolUndo.undoable, tool.name) ? { kind: 'undoable', undo_with: toolUndo.undoable[tool.name] } : { kind: 'immediate' });
// Only Trillion's own server says it; an app answering through this owner lists its tools as they are.
const listedTools = (tools, own = true) => tools.map(({ run, reach, ...tool }) => (own ? { ...tool, _meta: { ...tool._meta, 'trillion/mutation': mutationOf(tool) } } : tool));
function toolSetFingerprint(tools, listed = listedTools(tools)) {
  let name = toolSetNames.get(tools);
  if (!name) { name = `1f:${bytesToHex(blake3(new TextEncoder().encode(JSON.stringify(listed))))}`; toolSetNames.set(tools, name); }
  return name;
}
/** The version a modern request declares in `_meta`, or null for an earlier-style request. */
export const declaredVersion = message => message?.params?._meta?.[VERSION_META] ?? null;

// One JSON-RPC message in, one reply out (or null for a notification).
// `resources` are the views tools name (src/file-tools.mjs fileResources): { uri, name, title, mimeType, text(), _meta }.
// `info` and `instructions` are the server's own name and words: Trillion's unless another server answers through this
// one owner (a published Sites app at its own address, src/public-app-mcp.mjs).
// `events` answers MCP Events (src/mcp-events.mjs) for this sign-in: { list(params), subscribe(params),
// unsubscribe(params) } each resolving to a result, or throwing an error with a JSON-RPC `code` and `data`. Without
// it, the server declares no events.
// `headerVersion` is the MCP-Protocol-Version header an HTTP request carried: a client that agreed a modern revision in
// `initialize` and then sends that header without `_meta` is answered in the modern shape too (resultType on every
// result), as is an `initialize` that asks for a modern revision, since Trillion answers it with that revision.
export async function handleMcpMessage(message, tools, { onInitialize, resources = [], afterCall, aroundCall, routeCallReply, events = null, headerVersion = null, toolIndex, origin = null, consequences = null, info = serverInfo, instructions = serverInstructions, continuationInstructions = info === serverInfo && instructions === serverInstructions ? defaultContinuationInstructions : [] } = {}) {
  // Every thing an answer names carries its own link on this service's origin (src/item-links.mjs), so an AI can hand
  // the person one click to it; the text the AI reads is the same JSON with the links in it.
  const linked = result => (origin && result && typeof result === 'object' ? withItemLinks(result, origin) : result);
  const textOf = (result, answer) => (typeof result === 'string' ? result : result?.[SAID] ?? JSON.stringify(answer, null, 2));
  const { id: requestId, method, params } = message ?? {};
  // The managed owner awaits its source receipt before this function dispatches a mutation. The callback receives
  // protocol identity separately from client claims; batch members have separate call ids and preserve their index.
  // A class of action the person or space switched on (src/consequence-classes.json) waits for their yes to this exact
  // call instead of running; with `consequences` unset, or a class left `none`, nothing waits.
  const held = (tool, input, meta) => consequences ? consequenceHold({ tool, input, modes: consequences.modes, approvals: consequences.approvals ?? null }) : null;
  const invoke = (tool, input, batchIndex = null, meta = null) => held(tool, input, meta ?? params?._meta)
    ? { status: 'waiting_for_the_person', ran: false, hold: held(tool, input, meta ?? params?._meta) }
    : aroundCall
    ? aroundCall({ tool: tool.name, input, request_id: requestId, batch_index: batchIndex,
      meta: meta ?? params?._meta ?? {}, reads: tool.annotations?.readOnlyHint === true }, () => tool.run(input))
    : tool.run(input);
  if (requestId === undefined || requestId === null) return null;
  const agreedModern = [headerVersion, method === 'initialize' ? params?.protocolVersion : null].find(version => MODERN_VERSIONS.includes(version)) ?? null;
  const declared = declaredVersion(message) ?? agreedModern;
  // A modern request (its version in `_meta`) is answered with `resultType` on every result, and a list or read result
  // also says how long it may be kept (SEP-2549): a 2026-07-28 client refuses one without them (Claude Code 2.1.280 listed
  // no Trillion tools). What each sign-in sees differs and changes with every deploy, so nothing is kept or shared.
  const modern = declared === null ? null : { resultType: 'complete', ...(CACHEABLE.includes(method) ? KEEP_NOTHING : {}) };
  const reply = result => {
    const answer = method === 'tools/call' ? withContinuation(result, continuationInstructions) : result;
    return { jsonrpc: '2.0', id: requestId, result: modern ? { ...modern, ...answer } : answer };
  };
  if (declared !== null && !MODERN_VERSIONS.includes(declared)) {
    return { jsonrpc: '2.0', id: requestId, error: { code: -32022, message: 'Unsupported protocol version', data: { supported: [...MODERN_VERSIONS, ...LEGACY_VERSIONS], requested: declared } } };
  }
  const waitingWords = pending => (pending.length ? `\n\nWork is waiting for this AI: ${pending.map(item => item.handoff_id).join(', ')}. Read each with read_handoff, take it with take_work, and finish it when done.` : '');
  const capabilities = { tools: {}, resources: {}, ...(events ? { events: {} } : {}) };
  try {
    if (method === 'initialize') {
      const pending_handoffs = await onInitialize?.(params ?? {}) ?? [];
      return reply({ protocolVersion: params?.protocolVersion ?? '2025-06-18', capabilities, serverInfo: info, instructions: instructions + waitingWords(pending_handoffs), pending_handoffs });
    }
    // The modern discovery answer: what initialize told earlier clients, with no session.
    if (method === 'server/discover') {
      const pending_handoffs = await onInitialize?.(params ?? {}) ?? [];
      return reply({ supportedVersions: [...MODERN_VERSIONS, ...LEGACY_VERSIONS], capabilities, _meta: { 'io.modelcontextprotocol/serverInfo': info }, instructions: instructions + waitingWords(pending_handoffs) });
    }
    if (events && ['events/list', 'events/subscribe', 'events/unsubscribe'].includes(method)) {
      try { return reply(await events[method.slice('events/'.length)](params ?? {})); }
      catch (error) { return { jsonrpc: '2.0', id: requestId, error: { code: Number.isInteger(error.code) ? error.code : -32603, message: String(error.message ?? error), ...(error.data ? { data: error.data } : {}) } }; }
    }
    if (method === 'ping') return reply(Array.isArray(tools) ? { _meta: { [TOOL_SET_META]: toolSetFingerprint(tools) } } : {});
    if (method === 'tools/list') {
      const listed = listedTools(tools, info === serverInfo);
      const budget = params?.[listingBudget.request_field];
      const within = listWithinBudget(listed, budget);
      const named = withNamedInFull(within ? within.tools : listed, listed, params?.[listingBudget.names_field], listingBudget);
      return reply({ tools: named.tools, _meta: { [TOOL_SET_META]: toolSetFingerprint(tools, listed), ...(within ? listingMeta(within, budget) : {}),
        ...(named.unknown.length ? { [listingBudget.meta_key]: { ...(within ? listingMeta(within, budget)[listingBudget.meta_key] : {}), unknown: named.unknown, unknown_said: named.said.replace('{names}', named.unknown.join(', ')) } } : {}) } });
    }
    if (method === 'resources/list') return reply({ resources: resources.map(({ text, _meta, ...resource }) => resource) });
    if (method === 'resources/templates/list') return reply({ resourceTemplates: [] });
    if (method === 'resources/read') {
      const resource = resources.find(item => item.uri === params?.uri);
      if (!resource) return { jsonrpc: '2.0', id: requestId, error: { code: -32002, message: `Resource not found: ${params?.uri}` } };
      return reply({ contents: [{ uri: resource.uri, mimeType: resource.mimeType, text: await resource.text(), _meta: resource._meta }] });
    }
    if (method === 'tools/call') {
      const toolsByName = toolIndex ?? (tools instanceof Map ? tools : indexToolsByName(tools));
      if (Array.isArray(params?.calls)) {
        if (params.calls.length > 50) return { jsonrpc: '2.0', id: requestId, error: { code: -32602, message: 'A batch can contain at most 50 calls.' } };
        const results = [];
        const routedIndexes = new Set();
        for (const [index, asked] of params.calls.entries()) {
          const former = toolsByName.has(asked?.name) ? null : formerOperation(asked?.name);
          const tool = toolsByName.get(asked?.name) ?? (former && toolsByName.get(former.to));
          const refused = refusalFor({ name: asked?.name, args: asked?.arguments, toolsByName, resolved: tool });
          if (refused) {
            const error = `${refused.message}. ${refused.data.words}`;
            try { afterCall?.({ tool: String(asked?.name ?? ''), input: asked?.arguments ?? {}, error, refusal: refused.reason }); } catch {}
            results.push({ index, name: asked?.name ?? null, isError: true, content: [{ type: 'text', text: error }], structuredContent: { error: { message: error, retryable: refused.reason !== 'unknown_tool', ...refused.data } } });
            continue;
          }
          const input = former ? former.input(asked?.arguments) : asked?.arguments === null ? null : asked?.arguments ?? {};
          try {
            const invalid = invalidToolInput(tool, input);
            if (invalid) throw invalid;
            // A mixed carrier may supply a complete protocol result from the call's own
            // authenticated owner. Keep its content, screen metadata and errors intact;
            // wrapping that result as operation data would lose their protocol meaning.
            const routed = await routeCallReply?.({ tool: tool.name, input, asked, request_id: requestId, batch_index: index,
              meta: asked?._meta ?? params?._meta ?? {} });
            if (routed !== undefined) {
              results.push({ ...routed, index, name: tool.name });
              if (continuationInstructions.every(value => routed.structuredContent?.ai_instructions?.includes(value))) routedIndexes.add(index);
              continue;
            }
            const result = former ? former.answer(await invoke(tool, input, index, asked?._meta)) : await invoke(tool, input, index, asked?._meta);
            try { afterCall?.({ tool: tool.name, input, result, ...(former ? { former: asked.name } : {}) }); } catch {}
            const answer = linked(typeof result === 'string' ? { text: result } : nativeCollectionAnswer(result));
            const screen = result?.[VIEW_DATA]?.['trillion/screen'];
            const structuredContent = screen ? { ...answer, 'trillion/screen': screen } : answer;
            results.push({ index, name: tool.name, isError: false, content: [{ type: 'text', text: textOf(result, Array.isArray(result) && !result[nativeCollectionContinuation] && !result[nativeCollectionCoverage] ? answer.items : answer) }, ...(result?.[CONTENT] ?? [])], structuredContent, ...(result?.[VIEW_DATA] ? { _meta: result[VIEW_DATA] } : {}) });
          } catch (error) {
            try { afterCall?.({ tool: tool.name, input, error: String(error.said ?? error.message ?? error) }); } catch {}
            const { failure, reference } = diagnoseUnexpectedToolFailure(tool.name, error);
            const message = errorTextWithReference(error, reference);
            results.push({ index, name: tool.name, isError: true, content: [{ type: 'text', text: sentAgainSafely(error) ? SEND_AGAIN_WORDS : message }], structuredContent: { error: { message, code: failure.code, domain: failure.domain, retryable: failure.retryable, fatal: failure.fatal, remediation: failure.remediation, ...(reference ? { reference } : {}), ...(failure.retry_at ? { retry_at: failure.retry_at, retry_after_seconds: failure.retry_after_seconds } : {}) }, ...(payloadOf(failure, error).next_call ? { next_call: payloadOf(failure, error).next_call } : {}) }, ...(payloadOf(failure, error).upgrade_needed ? { _meta: { upgrade_needed: true, feature: payloadOf(failure, error).feature ?? null } } : {}) });
          }
        }
        const continued = results.map(result => routedIndexes.has(result.index) ? result : withContinuation(result, continuationInstructions));
        return reply({ content: [{ type: 'text', text: JSON.stringify({ results: continued }) }], structuredContent: { results: continued } });
      }
      // A former operation name (src/renamed-tools.json operations) is answered by the operation it merged into.
      const former = toolsByName.has(params?.name) ? null : formerOperation(params?.name);
      const tool = toolsByName.get(params?.name) ?? (former && toolsByName.get(former.to));
      const refused = refusalFor({ name: params?.name, args: params?.arguments, toolsByName, resolved: tool });
      if (refused) {
        try { afterCall?.({ tool: String(params?.name ?? ''), input: params?.arguments ?? {}, error: refused.message, refusal: refused.reason }); } catch {}
        return { jsonrpc: '2.0', id: requestId, error: refusalAsError(refused, continuationInstructions.length ? { ai_instructions: continuationInstructions } : {}) };
      }
      // afterCall hears every call's answer or failure (the AI activity record, src/activity.mjs); it never changes the reply.
      const input = former ? former.input(params.arguments) : params.arguments === null ? null : params.arguments ?? {};
      const heard = outcome => { try { afterCall?.({ tool: tool.name, input, ...outcome, ...(former ? { former: params.name } : {}) }); } catch {} };
      try {
        const invalid = invalidToolInput(tool, input);
        if (invalid) throw invalid;
        const routed = await routeCallReply?.({ tool: tool.name, input, asked: params, request_id: requestId, batch_index: null,
          meta: params?._meta ?? {} });
        if (routed !== undefined) {
          // A separately authenticated owner already supplied protocol content.
          const continued = continuationInstructions.every(value => routed.structuredContent?.ai_instructions?.includes(value));
          return { jsonrpc: '2.0', id: requestId, result: modern
            ? { ...modern, ...(continued ? routed : withContinuation(routed, continuationInstructions)) }
            : (continued ? routed : withContinuation(routed, continuationInstructions)) };
        }
        const result = former ? former.answer(await invoke(tool, input)) : await invoke(tool, input);
        heard({ result });
        // Some clients (Codex script mode) resolve a call from structuredContent, so return the object too.
        const answer = linked(typeof result === 'string' ? { text: result } : nativeCollectionAnswer(result));
        // Some AI apps omit a tool result's _meta when handing it to an inline view. Carry the
        // harmless screen address in structuredContent too, so the view can still open the result.
        const screen = result?.[VIEW_DATA]?.['trillion/screen'];
        const structuredContent = screen ? { ...answer, 'trillion/screen': screen } : answer;
        return reply({ content: [{ type: 'text', text: textOf(result, Array.isArray(result) && !result[nativeCollectionContinuation] && !result[nativeCollectionCoverage] ? answer.items : answer) }, ...(result?.[CONTENT] ?? [])], structuredContent, ...(result?.[VIEW_DATA] ? { _meta: result[VIEW_DATA] } : {}) });
      } catch (error) {
        // The person reads only the failure's own words (error.said); the AI still gets the whole message, with its next call.
        heard({ error: String(error.said ?? error.message ?? error) });
        // A call the platform cut off in passing (a deploy reset the store it reached: src/cut-off.mjs) says to send it
        // again, the words the Worker's catch answers HTTP callers with, never the platform's "Network connection lost."
        // A refusal of something the person's plan does not include says so in _meta, so an app can offer the plan.
        const { failure, reference } = diagnoseUnexpectedToolFailure(tool.name, error);
        const message = errorTextWithReference(error, reference);
        return reply({ isError: true, content: [{ type: 'text', text: sentAgainSafely(error) ? SEND_AGAIN_WORDS : message }], structuredContent: { error: { message, code: failure.code, domain: failure.domain, retryable: failure.retryable, fatal: failure.fatal, remediation: failure.remediation, ...(reference ? { reference } : {}), ...(failure.retry_at ? { retry_at: failure.retry_at, retry_after_seconds: failure.retry_after_seconds } : {}) }, ...(payloadOf(failure, error).next_call ? { next_call: payloadOf(failure, error).next_call } : {}) }, ...(payloadOf(failure, error).upgrade_needed ? { _meta: { upgrade_needed: true, feature: payloadOf(failure, error).feature ?? null } } : {}) });
      }
    }
    return { jsonrpc: '2.0', id: requestId, error: { code: -32601, message: `Unknown method ${method}` } };
  } catch (error) {
    return { jsonrpc: '2.0', id: requestId, error: { code: -32603, message: String(error.message ?? error) } };
  }
}

// Keep the array's first-match behavior while making repeated named dispatch a keyed lookup.
export function indexToolsByName(tools) {
  const indexed = new Map();
  for (const tool of tools ?? []) {
    if (!indexed.has(tool.name)) indexed.set(tool.name, tool);
  }
  return indexed;
}
