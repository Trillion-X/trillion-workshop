        "id": "tool:read-live-matches",
        "label": "Show live matches, their scores and a tournament board",
        "status": "active",
        "job": "Show the current score of live matches for the scorer and for spectators, and a board of matches with their schedule, bracket, standings and leaderboard",
        "description": "Give the records of the matches (match records, score events, context links and board rows) and get every match, newest first. Each match has the scorer's view (every event counts) and the spectator view (no actor ids, and no tap that is still pending-offline). Events with one sequence number, such as an offline tap and its confirmation, count once: reconciled beats confirmed beats pending-offline, and the same state keeps the later one. The board lists each match with its score line and its linked schedule, bracket, standing and leaderboard rows; a finished match without standing or leaderboard rows of its own gets one row per side (win 3 points, loss 0). With match_id the answer also holds that match's view and the sequence number the next event takes.",
        "input_schema": {
          "type": "object",
          "required": ["rows"],
          "additionalProperties": false,
          "properties": {
            "rows": { "type": "array", "items": { "type": "object" }, "description": "The records, each as { payload } or the record itself" },
            "match_id": { "type": "string", "description": "A match to answer for on its own" }
          }
        },
        "output_schema": {
          "type": "object",
          "required": ["matches", "board"],
          "properties": {
            "matches": { "type": "array", "items": { "type": "object" }, "description": "Each match: { match, latestEvent, score, eventCount, context, spectator }" },
            "board": { "type": "object", "description": "{ rows, schedule, brackets, standings, leaderboard }" },
            "match": { "type": "object", "description": "With match_id: that match's view" },
            "next_sequence": { "type": "integer", "description": "With match_id: the sequence number the next score event takes" }
          }
        },
        "invoke": {
          "kind": "container",
          "files": { "package_files": { "package": "live-match-scores", "paths": ["do-work", "read-data"], "at": "/opt/live-match-scores" } },
          "workdir": "/opt/live-match-scores",
          "stdout": "json",
          "run": ["node", "do-work/read-live-matches.mjs"],
          "stdin": { "fill": { "from": "input" } }
        },
        "result_selector": "$.result",
        "needs": { "expected_seconds": 1, "network_egress": false, "memory_mb": 128 },
        "licence_class": "licence:maker-own",
        "placements": ["placement:small-container"],
        "maker": "maker:live-match-scores",
