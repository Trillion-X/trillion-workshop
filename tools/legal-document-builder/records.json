{
 "package": "legal-document-builder",
 "things": [
  {
   "type": "record",
   "id": "package::legal-document-builder::tool::write-legal-documents",
   "address": "package::legal-document-builder::tool::write-legal-documents",
   "path": [
    "current-item",
    "published-record"
   ],
   "payload": {
    "kind": "ai-tool-descriptor",
    "id": "tool:write-legal-documents",
    "label": "Write legal documents",
    "status": "active",
    "job": "Write a business's terms of service, privacy policy, refund policy or waiver from its facts",
    "description": "Assembles each document you ask for from a library of forty clauses, choosing the clauses the business's facts call for (accounts, paid offers, subscriptions, AI, physical activity, minors) and filling in its name, address, contact and policies. Each document comes back with its text, its identity, the clauses used, the facts still missing or to be confirmed, and whether it is ready to publish; nothing is ready to publish until a lawyer has reviewed it. facts_it_reads lists every fact each document uses, so a first call with a few facts shows what to ask for next.",
    "input_schema": {
     "type": "object",
     "required": [
      "documents",
      "facts"
     ],
     "properties": {
      "documents": {
       "type": "array",
       "minItems": 1,
       "items": {
        "type": "string",
        "enum": [
         "terms",
         "privacy",
         "refunds",
         "waiver"
        ]
       },
       "description": "Which documents to write"
      },
      "facts": {
       "type": "object",
       "description": "The business's facts by name (business_legal_name, service_name, site_url, contact_email, service_description, has_accounts, has_paid_offers, has_subscriptions, uses_ai, has_physical_activity, serves_minors, governing_law_state, ...). A value may be {\"value\": ..., \"needs_founder_verification\": \"what to confirm\"} when it still has to be confirmed."
      },
      "titles": {
       "type": "object",
       "additionalProperties": {
        "type": "string"
       },
       "description": "A title to use for a document instead of the usual one"
      },
      "addresses": {
       "type": "object",
       "additionalProperties": {
        "type": "string"
       },
       "description": "Where each document will be published, like {\"terms\": \"/legal/terms\"}"
      },
      "reviewed_by_a_lawyer": {
       "type": "boolean",
       "description": "True once a lawyer has reviewed these documents (default false)"
      }
     },
     "additionalProperties": false
    },
    "output_schema": {
     "type": "object",
     "required": [
      "documents",
      "facts_it_reads"
     ],
     "properties": {
      "documents": {
       "type": "array",
       "minItems": 1,
       "items": {
        "type": "object",
        "required": [
         "document_type",
         "title",
         "text",
         "identity",
         "clauses",
         "ready_to_publish",
         "missing_facts",
         "facts_to_confirm"
        ],
        "properties": {
         "text": {
          "type": "string",
          "minLength": 1
         },
         "identity": {
          "type": "string"
         },
         "ready_to_publish": {
          "type": "boolean"
         },
         "missing_facts": {
          "type": "array"
         },
         "facts_to_confirm": {
          "type": "array"
         },
         "clauses": {
          "type": "array",
          "minItems": 1
         }
        }
       }
      },
      "facts_it_reads": {
       "type": "object"
      }
     }
    },
    "invoke": {
     "kind": "container",
     "files": {
      "package_files": [
       {
        "package": "legal-document-builder",
        "paths": [
         "do-work",
         "read-data",
         "data"
        ],
        "at": "/opt/parts/legal-document-builder"
       },
       {
        "package": "content-identity",
        "paths": [
         "read-data"
        ],
        "at": "/opt/parts/content-identity"
       },
       {
        "module": "@noble/hashes",
        "paths": [
         "LICENSE",
         "package.json",
         "blake3.js",
         "blake2.js",
         "_blake.js",
         "_md.js",
         "_u64.js",
         "utils.js"
        ],
        "at": "/opt/node_modules/@noble/hashes"
       }
      ]
     },
     "workdir": "/opt/parts/legal-document-builder",
     "stdout": "json",
     "argv": [
      "node",
      "do-work/write-legal-documents.mjs",
      {
       "fill": {
        "from": "input"
       }
      }
     ]
    },
    "needs": {
     "expected_seconds": 20,
     "network_egress": false,
     "memory_mb": 512
    },
    "licence_class": "licence:maker-own",
    "placements": [
     "placement:deployed-container"
    ],
    "maker": "maker:legal-document-builder",
    "result_selector": "$.result",
    "provenance": {
     "source": "bitfield-packages packages/legal-document-builder"
    },
    "verify": [
     {
      "kind": "sample-run",
      "input": {
       "documents": [
        "terms"
       ],
       "facts": {
        "business_legal_name": "Harbor Coaching LLC",
        "service_name": "Harbor Coaching",
        "site_url": "https://harbor.example",
        "contact_email": "help@harbor.example",
        "service_description": "One-to-one swim coaching sessions booked online.",
        "has_accounts": true,
        "has_paid_offers": true
       }
      },
      "output_selector": "$.documents[0].text",
      "contains": "Harbor Coaching LLC"
     },
     {
      "kind": "output-contains",
      "output_selector": "$.documents[0].identity",
      "text": "1f:"
     }
    ]
   }
  },
  {
   "type": "record",
   "id": "package::legal-document-builder::tool::make-a-sales-contract",
   "address": "package::legal-document-builder::tool::make-a-sales-contract",
   "path": [
    "current-item",
    "published-record"
   ],
   "payload": {
    "kind": "ai-tool-descriptor",
    "id": "tool:make-a-sales-contract",
    "label": "Make a sales contract's terms, file request and approval link",
    "status": "active",
    "job": "Make the terms of an accepted sales contract ready to give out: what the buyer must accept, the terms as rows, the request that turns them into a PDF, Word, spreadsheet, Markdown or text file, and a link the buyer opens to accept",
    "description": "Give a contract (its name, currency, total in cents, customer, offer and a list of rules such as Commitment and GrantAccess) and which file forms you want (pdf, csv, xlsx, md, txt; all by default). Returns acceptance_requirements (always the terms; the payment obligation when a rule is a Commitment; the installment authorization when it has a payment schedule), terms_rows (the contract's facts and one row per rule, money in the locale you name, en-US by default), file_request (a structured-file-output.request that tool:export-documents-to-files turns into the files) and output_forms. With a base_url it also returns approval_link: a link that carries the whole request, so the buyer can open it on any computer and see the same contract. The forms a contract can be made in are the rows of data/contract-output-targets.json. Nothing here knows what is being sold, who the parties are or what anything costs.",
    "input_schema": {
     "type": "object",
     "required": [
      "contract"
     ],
     "properties": {
      "contract": {
       "type": "object",
       "required": [
        "rules"
       ],
       "properties": {
        "id": {
         "type": "string"
        },
        "name": {
         "type": "string"
        },
        "status": {
         "type": "string"
        },
        "currency": {
         "type": "string"
        },
        "total_amount": {
         "type": "number",
         "description": "In cents"
        },
        "intended_actor_id": {
         "type": "string"
        },
        "resource_id": {
         "type": "string"
        },
        "rules": {
         "type": "array",
         "items": {
          "type": "object"
         },
         "description": "The contract's rules, each with a type such as Commitment or GrantAccess"
        }
       }
      },
      "formats": {
       "type": "array",
       "items": {
        "type": "string"
       },
       "description": "File forms by extension, from data/contract-output-targets.json (default all)"
      },
      "actor_id": {
       "type": "string",
       "description": "Who the approval is for"
      },
      "base_url": {
       "type": "string",
       "description": "Where the approval page lives; asked for only when a link is wanted"
      },
      "request_id": {
       "type": "string"
      },
      "created_at": {
       "type": "string",
       "description": "When the request is made, as a date and time (default now)"
      },
      "locale": {
       "type": "string",
       "description": "How money is written (default en-US)"
      }
     },
     "additionalProperties": false
    },
    "output_schema": {
     "type": "object",
     "required": [
      "acceptance_requirements",
      "terms_rows",
      "file_request",
      "output_forms"
     ],
     "properties": {
      "acceptance_requirements": {
       "type": "array",
       "items": {
        "type": "string"
       }
      },
      "terms_rows": {
       "type": "array",
       "items": {
        "type": "array"
       }
      },
      "file_request": {
       "type": "object"
      },
      "output_forms": {
       "type": "array"
      },
      "approval_link": {
       "type": "string"
      }
     }
    },
    "invoke": {
     "kind": "container",
     "files": {
      "package_files": {
       "package": "legal-document-builder",
       "paths": [
        "do-work",
        "read-data",
        "data"
       ],
       "at": "/opt/parts/legal-document-builder"
      }
     },
     "workdir": "/opt/parts/legal-document-builder",
     "internet": false,
     "stdout": "json",
     "argv": [
      "node",
      "do-work/make-a-sales-contract.mjs"
     ],
     "stdin": {
      "fill": {
       "from": "input"
      }
     }
    },
    "needs": {
     "expected_seconds": 5,
     "network_egress": false,
     "memory_mb": 256
    },
    "licence_class": "licence:maker-own",
    "placements": [
     "placement:small-container"
    ],
    "maker": "maker:legal-document-builder",
    "result_selector": "$.result",
    "provenance": {
     "source": "bitfield-packages packages/sales-contract-builder"
    },
    "verify": [
     {
      "kind": "sample-run",
      "input": {
       "contract": {
        "id": "contract-1",
        "name": "Swim Coaching Agreement",
        "currency": "usd",
        "total_amount": 48000,
        "rules": [
         {
          "type": "Commitment",
          "amount": 48000,
          "recurrence": "one_time"
         }
        ]
       },
       "formats": [
        "pdf"
       ]
      },
      "output_selector": "$.acceptance_requirements[1]",
      "contains": "payment obligation"
     },
     {
      "kind": "output-contains",
      "output_selector": "$.terms_rows[5][1]",
      "text": "USD 480.00"
     }
    ]
   }
  }
 ]
}
