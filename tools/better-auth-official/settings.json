{
  "port": 8792,
  "base_url": "http://localhost:8792",
  "base_path": "/api/auth",
  "issuer": "http://localhost:8792",
  "audience": "http://localhost:8792",
  "database_path": "data/better-auth.db",
  "session_cookie_name": "__Host-trillion_session",
  "account_claim": {
    "field": "trillionAccount",
    "claim": "trillion_account"
  },
  "passkey": {
    "rp_id": "localhost",
    "rp_name": "Trillion"
  },
  "trusted_origins": [
    "http://localhost:8792"
  ],
  "api_key": {
    "prefix": "tr_",
    "rate_limit": {
      "enabled": false
    },
    "default_permissions": null
  },
  "internal": {
    "host": "127.0.0.1",
    "port": 8793,
    "verify_path": "/api-key/verify"
  },
  "key_check": {
    "path": "/api/auth/computer/key-check",
    "use": "key-check"
  },
  "computer_proof": {
    "proof_uses": {
      "key-check": "trillion-place-key-check-v1"
    },
    "window_ms": 60000,
    "signed_domain": "trillion-places-v1",
    "account_id_context": "trillion account id from its public key v1",
    "most_admitted_computers": 1024
  },
  "two_factor_issuer": "Trillion",
  "mcp": {
    "login_page": "/sign-in",
    "consent_page": "/consent",
    "resource": "https://app.gettrillion.ai/mcp",
    "scopes": [
      "openid",
      "profile",
      "email",
      "offline_access",
      "records",
      "tools",
      "account",
      "vault",
      "namespace-read"
    ],
    "resource_scopes": [
      "records",
      "tools",
      "account",
      "vault",
      "namespace-read"
    ]
  },
  "disabled_paths": [
    "/token"
  ],
  "email": {
    "outbox": "data/outbox.jsonl",
    "command": null
  },
  "device": {
    "verification_uri": "/device"
  },
  "attached_origins": {
    "ask_url": null,
    "cache_ms": 60000,
    "related_url": null
  }
}
