{
  "port": 8792,
  "base_url": "http://localhost:8792",
  "base_path": "/api/auth",
  "issuer": "http://localhost:8792",
  "audience": "http://localhost:8792",
  "store": {
    "credential": "sign-in-store-connection",
    "env": "BETTER_AUTH_STORE_CONNECTION",
    "pool_size": 10
  },
  "session_cookie_name": "__Host-trillion_session",
  "passkey": {
    "rp_id": "localhost",
    "rp_name": "Trillion"
  },
  "trusted_origins": [
    "http://localhost:8792"
  ],
  "api_key": {
    "prefix": "tr_",
    "rate_limit": {
      "enabled": false
    },
    "default_permissions": null
  },
  "internal": {
    "host": "127.0.0.1",
    "port": 8793,
    "verify_path": "/api-key/verify"
  },
  "credential_standing": {
    "path": "/credential/standing",
    "kinds": {
      "key": "api_key",
      "session": "session",
      "mcp-access": "client_grant"
    }
  },
  "two_factor_issuer": "Trillion",
  "mcp": {
    "login_page": "/sign-in",
    "consent_page": "/consent",
    "resource": "http://localhost:8792/mcp",
    "scopes": [
      "openid",
      "profile",
      "email",
      "offline_access",
      "records",
      "tools",
      "account",
      "vault",
      "namespace-read"
    ],
    "resource_scopes": [
      "records",
      "tools",
      "account",
      "vault",
      "namespace-read"
    ]
  },
  "disabled_paths": [
    "/token"
  ],
  "email": {
    "outbox": "data/outbox.jsonl",
    "command": null
  },
  "device": {
    "verification_uri": "/device"
  },
  "attached_origins": {
    "ask_url": null,
    "cache_ms": 60000,
    "related_url": null
  },
  "admin": {
    "user_ids": []
  },
  "delete_user": {
    "enabled": false
  },
  "email_code": {
    "digits": 6,
    "expires_in_seconds": 600,
    "attempts": 5,
    "sends_per_window": 10,
    "window_seconds": 900
  },
  "add_passkey_link": {
    "expires_in_seconds": 86400
  },
  "session": {
    "fresh_age_seconds": 600,
    "cookie_cache_seconds": 300
  },
  "email_password": {
    "require_verification": true
  },
  "rate_limit": {
    "enabled": true
  }
}
