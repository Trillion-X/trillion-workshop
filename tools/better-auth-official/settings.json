{
  "port": 8792,
  "base_url": "http://localhost:8792",
  "base_path": "/api/auth",
  "issuer": "http://localhost:8792",
  "audience": "http://localhost:8792",
  "store": {
    "credential": "sign-in-store-connection",
    "env": "BETTER_AUTH_STORE_CONNECTION",
    "pool_size": 10,
    "migrate_from": null
  },
  "session_cookie_name": "__Host-trillion_session",
  "passkey": {
    "rp_id": "localhost",
    "rp_name": "Trillion"
  },
  "trusted_origins": [
    "http://localhost:8792"
  ],
  "api_key": {
    "prefix": "tr_",
    "rate_limit": {
      "enabled": false
    },
    "default_permissions": null
  },
  "internal": {
    "host": "127.0.0.1",
    "port": 8793,
    "verify_path": "/api-key/verify"
  },
  "credential_standing": {
    "path": "/credential/standing",
    "kinds": {
      "key": "api_key",
      "session": "session",
      "mcp-access": "client_grant"
    }
  },
  "two_factor_issuer": "Trillion",
  "mcp": {
    "login_page": "/sign-in",
    "consent_page": "/consent",
    "resource": "http://localhost:8792/mcp",
    "always_offline_access": true,
    "refresh_token_reuse_interval": 2,
    "_refresh_token_reuse_interval_why": "Seconds. Measured Nov 17 2026 about 11:10 AM CST from the Mac to the live token address with a made-up refresh token: 20 answered round trips, median 0.62 s, p99 1.70 s (60 sent 0.4 s apart; the other 40 were refused 429 by the token path's rate limit). The window must cover one renewal's round trip, so it is the p99 rounded up to whole seconds (the option takes whole seconds). Re-measure with a real renewal if the engine or the gateway moves.",
    "first_party_clients": [],
    "loopback_resources": {
      "name": "A computer's own engine",
      "hosts": [
        "127.0.0.1",
        "[::1]",
        "localhost"
      ],
      "path": "/mcp"
    },
    "scopes": [
      "openid",
      "profile",
      "email",
      "offline_access",
      "records",
      "records-read",
      "tools",
      "tools-list",
      "account",
      "vault",
      "namespace-read"
    ],
    "resource_scopes": [
      "offline_access",
      "records",
      "records-read",
      "tools",
      "tools-list",
      "account",
      "vault",
      "namespace-read"
    ],
    "access_token_seconds": 3600
  },
  "disabled_paths": [
    "/token"
  ],
  "email": {
    "sender": null,
    "from": null
  },
  "device": {
    "verification_uri": "/device"
  },
  "attached_origins": {
    "ask_url": null,
    "cache_ms": 60000,
    "related_url": null
  },
  "admin": {
    "user_ids": []
  },
  "delete_user": {
    "enabled": false
  },
  "email_code": {
    "digits": 6,
    "expires_in_seconds": 600,
    "attempts": 5,
    "sends_per_window": 10,
    "window_seconds": 900
  },
  "add_passkey_link": {
    "expires_in_seconds": 86400
  },
  "session": {
    "fresh_age_seconds": 600,
    "cookie_cache_seconds": 300
  },
  "email_password": {
    "require_verification": true
  },
  "rate_limit": {
    "enabled": true,
    "client_ip_headers": [
      "x-forwarded-for",
      "x-real-ip"
    ],
    "trusted_proxies": [
      "127.0.0.0/8",
      "::1/128"
    ]
  },
  "cimd": {
    "fetch_module": "@better-auth/cimd/node"
  },
  "teams": {
    "claim": "team_ids",
    "most": 100
  }
}
