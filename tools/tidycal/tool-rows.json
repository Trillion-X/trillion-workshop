        "id": "tool:cancel-a-tidycal-booking",
        "label": "Cancel a TidyCal booking",
        "job": "Cancel one of my TidyCal bookings by its numeric id, with an optional reason sent to the booker",
        "description": "Cancels one TidyCal booking by its numeric id. The cancellation cannot be undone. Call it only for a booking the person asked to cancel.",
        "status": "active",
        "input_schema": {
