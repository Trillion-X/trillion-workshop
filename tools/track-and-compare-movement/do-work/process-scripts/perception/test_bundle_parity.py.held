#!/usr/bin/env python3
"""BUNDLE-PARITY DRIFT GUARD (SSOT enforcement, L063 — makes "bundle diverges from source" impossible).

The perception bundle is a DEPLOYMENT PROJECTION of the crown-jewel engine whose SSOT lives in the
show-up-video-tennis source repo. The package needs the files co-located (it ships without that repo),
so they are COPIED — but a silent copy is the classic two-sources-that-diverge bug. This guard asserts
every bundled file is BYTE-IDENTICAL to its source original, so any edit-without-resync fails loudly on
the authoring machine (where drift is introduced). Mirrors the painter-mirror-parity guard pattern.

ENV `MOTION_SOURCE_REPO` overrides the source-repo path (L089). If the source repo is absent (e.g. a
deploy host without it checked out), the guard SKIPS — it can only compare where the SSOT is present,
which is exactly the authoring machine that introduces drift. Run: python3 test_bundle_parity.py"""
import filecmp
import os
import sys
from pathlib import Path

HERE = Path(__file__).resolve().parent
SRC = Path(os.environ.get("MOTION_SOURCE_REPO", str(Path.home() / "dev" / "show-up-video-tennis")))

# bundle filename -> path within the source repo (the SSOT home)
SOURCE_OF = {
    "pose_estimate.py": "tools/motion/pose_estimate.py",
    "describe_clip.py": "tools/match/describe_clip.py",
    "pose_schema.py": "tools/match/pose_schema.py",
    "swing_state.py": "tools/match/swing_state.py",
    "body_orientation.py": "tools/match/body_orientation.py",
    "orientation.py": "tools/match/orientation.py",
    "finite_json.py": "tools/match/finite_json.py",
    "run_perception.py": "tools/match/run_perception.py",
}

if not SRC.exists():
    print(f"SKIP bundle-parity — source repo absent at {SRC} (set MOTION_SOURCE_REPO). "
          "Guard runs on the authoring machine where the SSOT lives.")
    sys.exit(0)

fails = []
for name, rel in SOURCE_OF.items():
    bundled = HERE / name
    origin = SRC / rel
    if not bundled.exists():
        fails.append(f"{name}: MISSING from bundle (expected — re-sync from {rel})")
    elif not origin.exists():
        fails.append(f"{name}: source SSOT MISSING at {rel} (did the engine move?)")
    elif not filecmp.cmp(bundled, origin, shallow=False):
        fails.append(f"{name}: DRIFTED from source SSOT ({rel}) — re-copy the source file into the bundle")
    else:
        print(f"PASS {name} == {rel} (byte-identical)")

# the bundle must contain EXACTLY the declared closure — no stray/forgotten files masquerading as engine
stray = sorted(
    p.name for p in HERE.glob("*.py")
    if p.name not in SOURCE_OF and p.name != "test_bundle_parity.py"
)
if stray:
    fails.append(f"stray .py in bundle not in the declared closure: {stray}")
else:
    print("PASS no stray .py files in the bundle (closure is exactly the 8 declared)")

print()
if fails:
    print(f"{len(fails)} DRIFT FAILURE(S):")
    for f in fails:
        print("  -", f)
    sys.exit(1)
print("ALL PASS — bundle is byte-identical to the source SSOT")
