{
  "records": [
    {
      "payload": {
        "kind": "ai-tool-descriptor",
        "id": "tool:reboot-a-computer-when-it-asks",
        "label": "Reboot a computer when it asks",
        "job": "read whether one of my computers' updates ask for a reboot, and reboot it then, only when nothing is busy, and see it come back with every container it ran",
        "description": "Give the computer's name, address and pinned SSH host key. It signs in as the computer's administrator with the held key server-administration-ssh-key. mode read (the default) reads whether the computer's updates ask for a reboot (/var/run/reboot-required and the packages in reboot-required.pkgs), its boot id, uptime and systemd state, the containers that run, and whatever makes a reboot unsafe now: a package manager at work, or a container build or compose run that changes containers (a pipeline deploy). It changes nothing. mode reboot reads the same, then reboots only when the computer asks (or even_if_not_asked is true, for a proof run) and nothing is busy; otherwise it answers rebooted: false and why. systemd reboots a few seconds after the session ends, so every running program is stopped by the system's own shutdown (SIGTERM, then its stop timeout); nothing is stopped by hand, so a container under restart: unless-stopped starts again. It then waits (wait_seconds, 600 unless given) until the computer answers with a new boot id and a started system, and reads it again: still-asks-for-a-reboot (warn), degraded-after-reboot (alert: a failed unit), container-not-back (alert: a container that ran before does not run after), not-back-after-reboot (alert). Whether an apply holds the computer's row, and telling the people who share the computer, are the caller's: workflow:reboot-a-computer-after-its-updates does both, at a quiet hour.",
        "status": "active",
        "input_schema": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "address",
            "host_key"
          ],
          "properties": {
            "name": {
              "type": "string",
              "description": "The computer's name, as its row names it."
            },
            "address": {
              "type": "string",
              "minLength": 1,
              "description": "The computer's address (an IPv4 address or a lowercase DNS name)."
            },
            "host_key": {
              "type": "string",
              "description": "The computer's SSH host public key, \"<type> <base64>\", pinned for this connection alone."
            },
            "ssh_port": {
              "type": "integer",
              "description": "The SSH port (22 unless given)."
            },
            "admin_user": {
              "type": "string",
              "description": "The administrator account (root unless given)."
            },
            "mode": {
              "enum": [
                "read",
                "reboot"
              ],
              "description": "read (the default): only read. reboot: reboot when the computer asks and nothing is busy, wait for it, read it again."
            },
            "even_if_not_asked": {
              "type": "boolean",
              "description": "true: reboot even when no update asks for it (a proof run of this tool). Busy still refuses."
            },
            "wait_seconds": {
              "type": "integer",
              "minimum": 60,
              "maximum": 3600,
              "description": "How long to wait for the computer to come back (600 unless given)."
            }
          }
        },
        "output_schema": {
          "type": "object",
          "required": [
            "name",
            "address",
            "mode",
            "at",
            "read",
            "rebooted"
          ],
          "properties": {
