{
  "records": [
    {
      "payload": {
        "kind": "ai-tool-descriptor",
        "id": "tool:check-a-computer-from-outside",
        "label": "Check a computer from outside",
        "job": "see what anyone on the internet can see of one computer (open ports, certificates, its SSH version, its domains' registration, how long a connection takes) and say where it differs from what the computer's row declares",
        "description": "Give the computer's public address, the ports its row declares and the names it serves. It tries every port in settings.json ports_to_try and every declared one, reads each name's certificate and its domain's registration expiry (RDAP), reads the SSH version line, and times the connection. It answers what it saw and the findings: an open port the row does not declare, a declared port that does not answer, a certificate or domain within its warning days or unreadable. It logs in to nothing and writes nothing; every connection goes through the run's own proxy.",
        "status": "active",
        "input_schema": {
          "type": "object",
          "required": [
            "address"
          ],
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string",
              "description": "The computer's name, as its row names it."
            },
            "address": {
              "type": "string",
              "minLength": 1,
              "description": "The computer's public address (an IP address or a name)."
            },
            "declared_ports": {
              "type": "array",
              "items": {
                "type": [
                  "string",
                  "integer"
                ]
              },
              "description": "The ports its row declares open, such as \"22/tcp\" or 443 (the row's machine.firewall_allow)."
            },
            "names": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "The names it serves (each site's host): each certificate and each domain's registration is read."
            },
            "also_try": {
              "type": "array",
              "items": {
                "type": [
                  "string",
                  "integer"
                ]
              },
              "description": "More ports to try beyond settings.json ports_to_try and the declared ones."
            }
          }
        },
        "output_schema": {
          "type": "object",
          "required": [
            "address",
            "checked_at",
            "ports",
            "findings"
          ],
          "properties": {
            "name": {
              "type": "string"
            },
            "address": {
              "type": "string"
            },
            "checked_at": {
              "type": "string"
            },
            "ports": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "port": {
                    "type": "integer"
                  },
                  "open": {
                    "type": "boolean"
                  },
                  "ms": {
                    "type": "integer"
                  }
                }
              }
            },
            "certificates": {
              "type": "array"
            },
            "ssh": {
              "type": [
                "object",
                "null"
              ]
            },
            "domains": {
              "type": "array"
            },
            "rtt_ms": {
              "type": "object"
            },
            "findings": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "computer",
                  "at",
                  "kind",
                  "about",
                  "said"
                ],
                "properties": {
                  "kind": {
                    "type": "string"
                  },
                  "about": {
                    "type": "string"
                  },
                  "said": {
                    "type": "string"
                  },
                  "computer": {
                    "type": "string"
                  },
                  "at": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "invoke": {
          "kind": "container",
          "internet": true, "public_read": true,
          "workdir": "/opt/check-a-computer-from-outside",
          "stdout": "json",
          "argv": [
            "node",
            "/opt/check-a-computer-from-outside/do-work/check-from-outside.mjs"
          ],
          "stdin": {
            "fill": {
              "from": "input"
            }
          },
          "files": {
            "package_files": [
              {
                "package": "check-a-computer-from-outside",
                "paths": [
                  "do-work",
                  "settings.json"
                ],
                "at": "/opt/check-a-computer-from-outside"
              }
            ]
          }
        },
        "result_selector": "$",
        "needs": {
          "expected_seconds": 30,
          "memory_mb": 128
        },
        "maker": "maker:check-a-computer-from-outside",
        "licence_class": "licence:maker-own",
        "placements": [
          "placement:your-computer"
        ],
        "provenance": {
          "source": "Roadmap plan W2.1 (/l078-roadmap PLAN.md, aspects 1, 2, 6): one outside check of every computer; Node's own net and tls, no package."
        }
      }
    }
  ]
}
