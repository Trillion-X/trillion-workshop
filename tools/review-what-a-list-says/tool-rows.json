        "label": "Review the rows of a list",
        "job": "Keep what a list of mine says true: set it up for review (an owner, a review state and a check-again date on each row, and views of what needs review), and mark rows verified, outdated or asking to be checked, or name their owner",
        "description": "Give list_id (one of the person's lists), row_kind (record:<its row_type>, the records its rows are) and action. set_up (expires_days optional, 90 as shipped) adds the review fields (owner, review_state, review_due, verified_by) and the views review-needed, review-expired and review-empty a list lacks; fields it already has stay as they are. verify (row_ids, by: who checked) sets Verified and a check-again date expires_days ahead; flag_outdated and request_verification set their state and clear the date; assign (row_ids, owner) names the owner. Answers what changed. An unknown action, or a row action on a list not set up, is refused with the words saying what to send. Every write is conditional on the rows as read, so a row changed meanwhile refuses the write.",
        "input_schema": {
          "type": "object",
          "required": [
            "list_id",
            "row_kind",
            "action"
          ],
          "additionalProperties": false,
          "properties": {
            "list_id": {
              "type": "string"
            },
            "row_kind": {
              "type": "string",
              "pattern": "^record:",
              "description": "The record kind of the list's rows: record:<the list's row_type>"
            },
            "action": {
              "type": "string"
            },
            "row_ids": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "maxItems": 200
            },
            "owner": {
              "type": "string"
            },
            "by": {
              "type": "string"
            },
            "expires_days": {
              "type": "number"
            }
          }
        },
        "output_schema": {
          "type": "object",
          "required": [
            "list_id"
          ],
          "properties": {
            "list_id": {
              "type": "string"
            },
            "set_up": {
              "type": "boolean"
            },
            "fields_added": {
              "type": "array"
            },
            "views_added": {
              "type": "array"
            },
            "action": {
              "type": "string"
            },
            "kept": {
              "type": "array"
            }
          }
        },
