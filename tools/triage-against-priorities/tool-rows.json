    "job": "Keep the decision made about one incoming item only if it holds up against the person's priorities and dispositions, and otherwise hold the item back",
    "description": "Give the same item, priorities, dispositions and least confidence you were briefed with, and answers: a list holding your one answer ({disposition_ref, confidence, rationale, target_ref, and objective with acceptance_criteria where the disposition needs them}). Returns and keeps one decision record per item and version. If there are no priorities, no answer or more than one, the confidence is not a number, is outside 0 to 1 or is under the least, the rationale or objective has more words than max_words allows, the disposition is not listed, or a needed objective is missing, the decision is the fallback disposition, blocked, with each reason in words. blocked is false only where the disposition's row says blocked_default is false. It does nothing else; whoever owns the disposition acts on the decision.",
    "input_schema": {
     "type": "object",
     "required": ["item", "priorities", "dispositions", "min_confidence"],
     "additionalProperties": false,
     "properties": {
      "item": { "type": "object", "required": ["ref"] },
      "priorities": { "type": "array", "items": { "type": "object" } },
      "dispositions": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["ref", "label"] } },
      "min_confidence": { "type": "number", "minimum": 0, "maximum": 1 },
      "max_words": {
       "type": "object",
       "additionalProperties": false,
       "properties": {
        "rationale": { "type": "integer", "minimum": 1 },
        "objective": { "type": "integer", "minimum": 1 }
       },
       "description": "The same word limits you were briefed with; an answer over a limit fails closed"
      },
      "answers": { "type": "array", "items": { "type": "object" }, "description": "Your one answer, in a list; empty or missing fails closed" }
     }
    },
    "output_schema": {
     "type": "object",
     "required": ["decision"],
     "properties": {
      "decision": {
       "type": "object",
       "required": ["type", "id", "item", "disposition_ref", "confidence", "blocked", "fail_closed", "reasons"],
       "properties": {
        "type": { "type": "string" },
        "id": { "type": "string" },
        "item": { "type": "object" },
        "priorities_seen": { "type": "number" },
        "disposition_ref": { "type": "string" },
        "confidence": { "type": "number" },
        "blocked": { "type": "boolean" },
        "fail_closed": { "type": "boolean" },
        "reasons": { "type": "array", "items": { "type": "string" } },
        "rationale": { "type": "string" },
        "objective": { "type": "string" },
        "acceptance_criteria": { "type": "array", "items": { "type": "string" } },
        "target_ref": { "type": "string" }
       }
      }
     }
    },
    "keeps_records": [{ "output_selector": "$.decision", "type_field": "type", "id_field": "id" }],
    "invoke": {
     "kind": "container",
     "files": {
      "package_files": {
       "package": "triage-against-priorities",
       "paths": ["do-work", "read-data"],
       "at": "/opt/triage-against-priorities"
      }
     },
     "workdir": "/opt/triage-against-priorities",
     "internet": false,
     "stdout": "json",
     "argv": ["node", "do-work/settle-a-triage.mjs"],
     "stdin": { "fill": { "from": "input" } }
    },
    "result_selector": "$.result",
    "needs": { "expected_seconds": 20, "network_egress": false, "memory_mb": 256 },
    "licence_class": "licence:maker-own",
    "placements": ["placement:small-container"],
    "maker": "maker:triage-against-priorities",
    "provenance": { "source": "bitfield-packages packages/commander-triage" },
    "verify": [
     {
      "kind": "sample-run",
      "input": {
       "item": { "ref": "note:1", "version": "v1", "text": "The flour bin is nearly empty" },
       "priorities": [{ "text": "Never run out of flour" }],
       "dispositions": [
        { "ref": "keep-note", "label": "Keep the note", "blocked_default": false },
        { "ref": "hold", "label": "Hold for the baker", "fallback": true }
       ],
       "min_confidence": 0.6,
       "answers": [{ "disposition_ref": "keep-note", "confidence": 0.8, "rationale": "Matches the flour priority." }]
      },
      "output_selector": "$.decision.disposition_ref",
      "contains": "keep-note"
     }
    ]
   }
  }
 ]
}
