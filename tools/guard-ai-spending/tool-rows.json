            "rail_ref": { "type": "string" },
            "spender_id": { "type": "string" },
            "facilitator_response": { "description": "What the rail answered, kept with the payment" }
          }
        },
        "output_schema": {
          "type": "object",
          "required": ["already_recorded", "total_spent_today", "total_spent_all_time", "amount", "payment_record"],
