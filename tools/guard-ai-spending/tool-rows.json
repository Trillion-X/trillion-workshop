{
  "kind": "tool-rows",
  "record_set": "guard-ai-spending-tool-rows",
  "what_this_is": "The Workshop rows for tools/guard-ai-spending: an AI's own spending kept inside the budget its person set (reserve before paying, check just before paying, record after paying, reset each day) and the rails that may pay. Each row reaches the person's own spend records through the run's records door. None can raise a limit or turn a budget on.",
  "records": [
    {
      "id": "package::guard-ai-spending::tool::reserve-a-spend-within-budget",
      "address": "package::guard-ai-spending::tool::reserve-a-spend-within-budget",
      "path": ["current-item", "published-record"],
      "payload": {
        "kind": "ai-tool-descriptor",
        "id": "tool:reserve-a-spend-within-budget",
        "label": "Reserve a spend within budget",
        "status": "active",
        "job": "Before my AI spends money, check the spend against my budget and reserve it, or refuse it",
        "description": "Checks one spend (whole cents) against the person's spend authority: it must be turned on and active, and stay inside the daily limit and the per-spend limit. Answers approved and the reason, and writes the check and a reservation the spend carries to the person's records; a refused spend is written too, with its reason. A zero-cost operation is checked and fenced without using the budget. The same idempotency key while its reservation is current answers the first reservation again and counts nothing twice. No authority record means every positive spend is refused.",
        "input_schema": {
          "type": "object",
          "required": ["spend_authority_ref", "operation_ref", "estimated_cost"],
          "additionalProperties": false,
          "properties": {
            "spend_authority_ref": { "type": "string", "description": "The person's spend authority to spend from, like \"spend-authority:research\"" },
            "operation_ref": { "type": "string", "description": "What the money is for, like \"operation:buy-a-report\"" },
            "estimated_cost": { "type": "integer", "minimum": 0, "description": "Whole cents" },
            "rail_ref": { "type": "string", "description": "The rail that will pay, like \"payment-rail:x402\"" },
            "spender_id": { "type": "string", "description": "Which AI or worker is spending" },
            "idempotency_key": { "type": "string", "description": "The same key for the same spend sent again" },
            "ttl_seconds": { "type": "integer", "minimum": 1, "description": "How long the reservation stays current (300 when left out)" }
          }
        },
        "output_schema": {
          "type": "object",
          "required": ["approved", "reason", "idempotent", "budget_check", "budget_reservation", "spend_snapshot"],
          "properties": {
            "approved": { "type": "boolean" },
            "reason": { "type": "string" },
            "idempotent": { "type": "boolean" },
            "budget_check": { "type": "object" },
            "budget_reservation": { "type": "object" },
            "spend_snapshot": { "type": "object" }
          }
        },
        "invoke": {
          "kind": "container",
          "files": {
            "package_files": [
              { "package": "guard-ai-spending", "paths": ["do-work", "read-data"], "at": "/opt/guard-ai-spending" },
              { "package": "records-door", "paths": ["do-work", "read-data"], "at": "/opt/records-door" },
              {"package": "content-identity", "paths": ["read-data"], "at": "/opt/content-identity"},
              {"module": "@noble/hashes", "paths": ["LICENSE", "package.json", "blake3.js", "blake2.js", "_blake.js", "_md.js", "_u64.js", "utils.js"], "at": "/opt/node_modules/@noble/hashes"}
            ]
          },
          "workdir": "/opt/guard-ai-spending",
          "internet": false,
          "stdout": "json",
          "argv": ["node", "/opt/records-door/do-work/run-an-export.mjs", "/opt/guard-ai-spending/read-data/spend-budget.mjs", "reserveSpendWithinBudget"],
          "stdin": { "fill": { "from": "input" } },
          "records": {
            "fd": 3,
            "rights": [
              { "kind": "spend-authority", "operations": ["records:read"] },
              { "kind": "spend-budget-check", "operations": ["records:write"] },
              { "kind": "spend-budget-reservation", "operations": ["records:read", "records:write"] }
            ]
          }
        },
        "needs": { "expected_seconds": 3, "network_egress": false },
        "licence_class": "licence:maker-own",
        "placements": ["placement:small-container"],
        "maker": "maker:guard-ai-spending",
        "result_selector": "$.result",
        "provenance": { "source": "bitfield-packages packages/agent-wallet (do-work/decide-budget.mjs and action:budget-gate), ported to the records door" },
        "verify": [{ "kind": "output-number-within", "output_selector": "$.spend_snapshot.total_spent_today", "at_least": 0 }]
      }
    },
