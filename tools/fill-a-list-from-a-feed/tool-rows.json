            },
            "stamp_row": {
              "type": "object"
            },
            "files_into": {
              "type": "string"
            },
            "stored": {
              "type": "object",
              "description": "What this run reads of the person's own things, read by the caller from where the person keeps them (the engine keeps none) and given here: records: [{id, type, value}] of the list record (id list:<list_id>, type list) and of the rows of row_kind (type record:<row_kind>), as the list stores them. What is not given is not there."
            }
          }
        },
        "output_schema": {
          "type": "object",
          "properties": {
            "keep": {
              "type": "array",
              "description": "What the run made, for the caller to keep where the person keeps it: rows {id, type, value, expected} (value null removes; expected is the record as the run was given it, or null, so the write is conditional), files {file, base64}. The run itself writes nothing."
            }
          }
        },
