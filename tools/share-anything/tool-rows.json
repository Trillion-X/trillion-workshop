                  "type": "string"
                },
                "on": {
                  "type": "boolean"
                },
                "added_at": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            },
            "removed": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "state": {
              "type": [
                "string",
                "null"
              ],
              "enum": [
                "open",
                "stopped",
                "ended",
                null
              ]
            },
            "shared": {
              "type": "boolean"
            },
            "can": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "expires_at": {
              "type": [
                "string",
                "null"
              ]
            },
            "ends": {
              "type": [
                "object",
                "null"
              ],
              "description": "A run share's end rule as kept, {until?, unused_days?, since}, or null when it has no end"
            },
            "last_used": {
              "type": [
                "string",
                "null"
              ],
              "description": "access of a run share: when a call was last admitted under it, as the engine lists it"
            },
            "revoked_at": {
              "type": [
                "string",
                "null"
              ]
            },
            "said": {
              "type": "string"
            },
            "keep": {
              "type": "array",
              "description": "What the run made, for the caller to keep where the person keeps it: rows {id, type, value} (value null removes), settings {label, value}, files {file, base64}. The run itself writes nothing."
            },
            "writes": {
              "type": "array",
              "description": "The records to write in the person's own store, in order: {kind: share | run-share | shared-text, address, value (null withdraws it), expect (what the store must still hold for the write: null when it holds nothing), type (shared-text only)}. The writes hold digests only, never a key."
            }
          }
        },
