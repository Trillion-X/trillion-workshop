        "kind": "ai-tool-descriptor",
        "id": "tool:end-shares-whose-condition-failed",
        "label": "End shares whose condition failed",
        "status": "active",
        "job": "End the shares I let people run my tools by, once the end I gave each has passed, so none stays open past its time",
        "description": "Judges every share that lets people run your tools, from the run shares the caller lists from your store (each with the end rule you gave it, if any, and when it was last used), and returns the withdrawal of each whose rule says it has ended: until, a time that has passed, or unused_days, that many days with no use counted from the later of when you set the rule and its last use (each use starts the days again). A share with no rule never ends here; it stands until you stop it. The engine keeps your rule beside the share and reads none of it: it admits a person while their share is kept, so a share ends when this withdraws it. A rule it cannot read is left alone and counted as waiting; a share the engine lists with no last use is judged by its until alone and counted as unjudged. Change a rule with tool:share-anything op end and the next run acts on it. It takes the listed runs as input (runs) and reads no store itself; a caller that runs it every hour, the grain the engine writes a last use at, gives it the runs and writes what it returns.",
        "input_schema": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "now": {
              "type": "string",
              "description": "The time to decide at (ISO); now when left out"
            },
            "runs": {
              "type": "array",
              "description": "The run shares the caller listed from the person's store: each {label, grant?, people?, ends?, last_used?} as the engine lists it (last_used absent when the listing has none; null when never used)."
            }
          }
        },
        "output_schema": {
          "type": "object",
          "required": [
            "ended",
            "waiting",
            "said"
          ],
          "properties": {
            "ended": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "waiting": {
              "type": "integer"
            },
            "said": {
              "type": "string"
            },
            "never": {
              "type": "integer"
            },
            "unjudged": {
              "type": "integer"
            },
            "writes": {
              "type": "array",
              "description": "The run shares to withdraw in the person's store: {kind: run-share, address, value: null, expect}."
            }
          }
        },
        "invoke": {
          "kind": "container",
          "workdir": "/opt/share-anything",
          "internet": false,
          "stdout": "json",
          "argv": [
            "node",
            "/opt/workflows/do-work/run-a-function.mjs",
            "/opt/share-anything/do-work/end-shares-whose-condition-failed.mjs",
            "endSharesWhoseConditionFailed"
          ],
          "stdin": {
            "fill": {
              "from": "input"
            }
          },
          "files": {
            "package_files": [
              {
                "package": "share-anything",
                "paths": [
                  "do-work",
                  "read-data"
                ],
                "at": "/opt/share-anything"
              },
              {
                "package": "workflows",
                "paths": [
                  "do-work/run-a-function.mjs"
                ],
                "at": "/opt/workflows"
              }
            ]
          }
        },
        "needs": {
          "expected_seconds": 2,
          "network_egress": false
        },
        "licence_class": "licence:maker-own",
        "placements": [
          "placement:small-container"
        ],
        "maker": "maker:share-anything",
        "result_selector": "$.result",
        "provenance": {
          "source": "The owner, Nov 14 to 16 2026: anything that is not one of the five core jobs is a tool and leaves the engine, and who decides that an end time; decision case source:bm8tZ3JhbnQtY29uZGl0aW9uLWluLWVuZ2luZS1jb2RlOndoZXJlLWNvbmRpdGlvbnMtbGl2ZS0yMDI2LTExLTE2 (a condition the person holds and a wake they switched on withdraws the share); the owner, Nov 17 2026: how long a share lasts is the person's choice, no end by default, and the person can change it; old trillion src/record-sharing.mjs createRecordShare expires_at"
        },
        "verify": [
          {
            "kind": "sample-run",
            "input": {},
            "output_selector": "$.waiting",
            "contains": "0",
            "records": []
          }
        ],
        "wakes": [
          {
            "id": "check-unused-grants",
            "on": {
              "fact": {
                "kind": "due-time",
                "from": [
                  "run"
                ],
                "match": {
                  "schedule_id": "schedule:tool:end-shares-whose-condition-failed:check-unused-grants"
                },
                "watch": {
                  "schedules": [
                    {
