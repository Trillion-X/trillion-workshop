            "/opt/records-door/do-work/run-an-export.mjs",
            "/opt/share-anything/do-work/end-shares-whose-condition-failed.mjs",
            "endSharesWhoseConditionFailed"
          ],
          "stdin": {
            "fill": {
              "from": "input"
            }
          },
          "records": {
            "fd": 3,
            "rights": [
              {
                "kind": "grant-end",
                "prefix": "grant-end:",
                "operations": [
