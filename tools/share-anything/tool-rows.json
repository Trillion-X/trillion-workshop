    {
      "payload": {
        "kind": "ai-tool-descriptor",
        "id": "tool:end-shares-whose-condition-failed",
        "label": "End shares whose condition failed",
        "status": "active",
        "job": "End the shares I let people run my tools by, once the end I gave each has passed, so none stays open past its time",
        "description": "Reads each condition row of kind grant-end that tool:share-anything kept for a run share: every run share is given one that ends it after 90 days with no use (each use starts the days again), and your own until is its fixed end. For each row whose end has passed by this run's clock (or now, an ISO time to decide at) it withdraws that share at your door, removes the row and keeps a grant-ended record saying why, for the Connections page. The engine keeps no end and reads none: it admits a person while their share is kept, so a share ends when this withdraws it. A row with no readable end is left alone and counted as waiting; a share the engine lists with no last use is judged by its fixed end alone and counted as unjudged. Edit or remove a grant-end row and it stays so. Switch its wake on (wake:switch) and it runs about every 22 hours (a hundredth of the 90 days); run it once by hand and it does the same.",
        "input_schema": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "now": {
              "type": "string",
              "description": "The time to decide at (ISO); now when left out"
            }
          }
        },
        "output_schema": {
          "type": "object",
          "required": [
            "ended",
            "waiting",
            "said"
          ],
          "properties": {
            "ended": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "waiting": {
              "type": "integer"
            },
            "said": {
              "type": "string"
            }
          }
        },
        "invoke": {
          "kind": "container",
          "files": {
            "package_files": [
              {
                "package": "share-anything",
                "paths": [
                  "do-work",
                  "read-data"
                ],
                "at": "/opt/share-anything"
              },
