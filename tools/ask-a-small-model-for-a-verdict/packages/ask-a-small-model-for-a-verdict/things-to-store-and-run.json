{
  "package": "ask-a-small-model-for-a-verdict",
  "things": [
    {
      "type": "record",
      "address": "package::ask-a-small-model-for-a-verdict::capability::ask-for-a-verdict",
      "address_mode": "identity_text",
      "path": [
        "current-item",
