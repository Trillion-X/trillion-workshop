            "grants": { "type": "array", "items": { "type": "object" }, "description": "Grant and revoke rows to use instead of your access-grant records" },
            "rules": { "type": "array", "items": { "type": "object" }, "description": "Effect rules to use instead of your access-effect-rule records" },
            "lifecycle": { "type": "object", "description": "One lifecycle row (episode_keys and transitions) to use instead of your effect-lifecycle record" }
          }
        },
        "output_schema": {
          "type": "object",
          "required": ["subject", "held_access_refs", "capabilities", "granted_access_refs", "limits", "active_offers", "episodes", "problems"],
          "properties": {
            "subject": { "type": "string" },
            "held_access_refs": { "type": "array", "items": { "type": "string" } },
            "capabilities": { "type": "array", "items": { "type": "string" } },
            "granted_access_refs": { "type": "array", "items": { "type": "string" } },
            "limits": { "type": "object" },
