         "_blake.js",
         "_md.js",
         "_u64.js",
         "utils.js"
        ],
        "at": "/opt/node_modules/@noble/hashes"
       }
      ]
     },
     "records": {
      "fd": 3,
      "rights": [
       {
        "kind": "record:pooled-situation",
        "operations": [
         "records:write"
        ]
       }
      ]
     }
    },
    "needs": {
     "expected_seconds": 10,
     "network_egress": false,
     "memory_mb": 256
    },
    "licence_class": "licence:maker-own",
    "placements": [
     "placement:small-container"
    ],
    "maker": "maker:learn-from-everyones-results"
   }
  }
 ]
