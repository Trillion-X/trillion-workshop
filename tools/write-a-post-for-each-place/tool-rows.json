                },
                "collapsibles": {
                  "type": "boolean"
                },
                "checkboxes": {
                  "type": "boolean"
                },
                "dialect": {
                  "type": "string",
                  "enum": [
                    "markdown",
                    "plain"
                  ]
                },
                "max_chars": {
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "theme": {
                  "type": "object"
                },
                "unproven": {
