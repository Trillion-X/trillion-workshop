        "listed_on": "2026-11-03T12:00:00Z",
        "label": "Write a post for one place",
        "job": "Write one message for a pull request thread, a merge request note, a chat or a post from the same blocks, using only what that place can show",
        "description": "Give blocks (heading, paragraph, code, list, checklist, image with an optional dark_url, collapsible holding more blocks) and exactly one of surface (github_comment, gitlab_note, bitbucket_comment or plain_message), capability (a record with html, collapsibles, checkboxes, dialect 'markdown' or 'plain', max_chars or null, theme { strategy 'picture', 'suffix' or 'single' } and unproven) or place (a post place whose format may carry caption_max_characters and source). Optional marker is put first and kept through any cut. Returns body, degraded (the capabilities the place lacked, so the body did without them), unproven_used (capabilities relied on that nobody has confirmed for that place), truncated (a body over max_chars is cut at a block boundary and says so) and the capability record used. An unknown surface, more or fewer than one of surface, capability or place, or an unknown block type is refused. It posts nothing.",
        "input_schema": {
          "type": "object",
          "required": [
            "blocks"
          ],
          "additionalProperties": false,
          "properties": {
            "blocks": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "type"
                ],
                "properties": {
                  "type": {
                    "type": "string",
                    "enum": [
                      "heading",
                      "paragraph",
                      "code",
                      "list",
                      "checklist",
                      "image",
                      "collapsible"
                    ]
                  }
                }
              }
            },
