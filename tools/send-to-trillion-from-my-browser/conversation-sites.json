          ],
          "text": [
            {
              "select": ".query-text"
            }
          ],
          "skip": "button, .cdk-visually-hidden, [aria-hidden='true']"
        },
        {
          "select": "model-response",
          "id": [
            {
              "closest": ".conversation-container",
              "attribute": "id",
              "suffix": ":ai"
            },
            {
              "value_from": "text",
              "suffix": ":ai"
            }
          ],
          "speaker": [
            {
              "value": "ai"
            }
          ],
          "text": [
            {
              "select": "message-content .markdown"
            },
            {
              "select": "message-content"
            }
          ],
          "skip": "button, .cdk-visually-hidden, [aria-hidden='true'], sources-list"
        }
      ]
    },
    {
      "id": "whatsapp",
      "app": "WhatsApp",
      "hosts": [
        "web.whatsapp.com"
      ],
      "conversation_id": [
        {
          "select": "#main [data-id]",
          "attribute": "data-id",
          "pattern": "^(?:true|false)_([^_]+)_"
        },
        {
          "select": "[data-id]:has([data-pre-plain-text])",
          "attribute": "data-id",
          "pattern": "^(?:true|false)_([^_]+)_"
        }
      ],
      "title": [
        {
          "select": "#main header span[dir='auto'][title]",
          "attribute": "title"
        },
        {
          "select": "#main header span[dir='auto']"
        }
      ],
      "earlier": {
        "wait_ms": 2500,
        "quiet_rounds": 2,
        "step_ms": 150,
        "max_messages": 50000,
        "max_seconds": 600
      },
      "messages": [
        {
          "select": "[data-pre-plain-text]",
          "id": [
            {
              "closest": "[data-id]",
              "attribute": "data-id"
            }
          ],
          "speaker": [
            {
              "closest": "[data-id]",
              "attribute": "data-id",
              "pattern": "^(true)_",
              "map": {
                "true": "person"
              }
            },
            {
              "attribute": "data-pre-plain-text",
              "pattern": "^\\[[^\\]]*\\]\\s*(.+?):\\s*$"
            }
          ],
          "text": [
            {
              "select": "span.selectable-text"
            }
          ],
          "at": [
            {
              "attribute": "data-pre-plain-text",
              "pattern": "^\\[([^\\]]+)\\]"
            }
          ]
        }
      ]
    }
  ]
}
