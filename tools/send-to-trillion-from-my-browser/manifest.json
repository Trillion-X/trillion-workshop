{
  "manifest_version": 3,
  "name": "Send to Trillion",
  "description": "Send any page, post, picture or selection to your AIs in Trillion, with what you want done with it.",
  "version": "1.3.5",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Send to Trillion",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "contextMenus",
    "tabCapture",
    "offscreen",
    "notifications",
    "alarms"
  ],
  "optional_permissions": [
    "nativeMessaging"
  ],
  "host_permissions": [
    "https://app.gettrillion.ai/*"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "signed-in.html"
      ],
      "matches": [
        "https://app.gettrillion.ai/*"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+S",
        "mac": "Alt+Shift+S"
      },
      "description": "Open Send to Trillion"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "right-clicked.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "minimum_chrome_version": "121"
}
