    "kind": "ai-tool-descriptor",
    "id": "tool:tell-the-makers-of-a-product",
    "label": "Tell the makers of this product",
    "job": "Tell the people who make this product about anything: report a bug, send feedback, or share an idea, with the things picked in the product",
    "description": "Takes credential_name (the held name of your own makers login), kind (a bug report, friction, feedback or an idea), things (what the person picked: each { kind, label, screen_label?, place?, address?, id? }), note (their own words, up to 8000 characters), where (their own work or the space they were in), screen (the address they were on), browser and picture. Writes one row to the makers' calendar_tasks: title (the note's first line, 80 characters at most), description (the whole note with kind, where and screen), with the id taken from the content, so the same note sent twice is refused as already taken. The server sets the rest of the row.",
    "status": "active",
    "input_schema": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "credential_name",
      "kind",
      "note"
     ],
     "properties": {
      "credential_name": {
       "type": "string",
       "minLength": 1,
       "description": "The held name of your own makers login: a connection that may only insert into the makers' calendar_tasks."
      },
      "kind": {
       "type": "string",
       "enum": [
        "a bug report",
        "friction",
        "feedback",
        "an idea"
       ],
       "description": "What the note is: a bug report (something went wrong), friction (something was hard to do), feedback (something to change) or an idea"
      },
      "things": {
       "type": "array",
       "maxItems": 50,
       "items": {
        "type": "object",
        "required": [
         "kind",
         "label"
        ],
        "properties": {
         "key": {
          "type": "string"
         },
         "kind": {
          "type": "string"
         },
         "label": {
          "type": "string"
         },
         "icon": {
          "type": "string"
         },
         "screen": {
          "type": "string"
         },
         "screen_label": {
          "type": "string"
         },
         "address": {
          "type": "string"
         },
         "id": {
          "type": "string"
         },
         "place": {
          "type": "string"
         }
        }
       },
       "description": "What was picked"
      },
      "note": {
       "type": "string",
       "maxLength": 8000,
       "description": "In your own words"
      },
      "screen": {
       "type": "string",
       "description": "The address you were on"
      },
      "browser": {
       "type": "string",
       "description": "The browser you use"
      },
      "picture": {
       "type": "string",
       "description": "A picture of the screen, from your Files"
      },
      "where": {
       "type": "string",
       "maxLength": 200,
       "description": "Where you were working: your own space or the pursuit's name"
      }
     }
    },
    "output_schema": {
     "type": "object",
     "required": [
      "id",
      "row_count"
     ],
     "properties": {
      "id": {
       "type": "string"
      },
      "row_count": {
       "type": "integer"
      }
     }
    },
