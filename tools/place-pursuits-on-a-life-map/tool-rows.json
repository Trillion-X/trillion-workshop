  "records": [
    {
      "payload": {
        "kind": "ai-tool-descriptor",
        "id": "tool:place-pursuits-on-a-life-map",
        "label": "Place my pursuits on my life map",
        "status": "active",
        "job": "Place what I am pursuing on my own map of a full life and say which parts of my life none of my pursuits touch",
        "description": "Reads the person's own map (their map list, whose rows are its areas, each with what it is part of and what it means) and places each pursuit on the areas it names; answers every area with its pursuits, the leaf areas no pursuit names that are not optional, one line for each, and with section true the Progress section. A person who never made a map gets offered: true and nothing placed; the starter map is never read in its place. The starter map (its areas list and its settings row, named in read-data/place-pursuits-on-a-life-map.json) is read through the records door or handed in as settings; pursuits are handed in or read from the person's pursuit records (title and areas). It writes nothing.",
        "input_schema": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "pursuits": {
              "type": "array",
              "items": {
                "type": "object"
              },
              "description": "The pursuits to place, each { title, areas: [area id] }; left out, the person's pursuit records are read"
            },
            "settings": {
              "type": "object",
              "description": "The starter map ({ areas, list, reading, words }); left out, it is read from the person's lists"
            },
            "section": {
              "type": "boolean",
              "description": "true also answers the Progress section for the map"
            }
          }
        },
        "output_schema": {
          "type": "object",
          "properties": {
            "list_id": {
              "type": "string"
            },
            "offered": {
              "type": "boolean"
            },
            "areas": {
              "type": "array"
            },
            "missing": {
              "type": "array"
            },
            "missing_lines": {
              "type": "array"
            },
            "section": {
              "type": "object"
            }
          }
        },
