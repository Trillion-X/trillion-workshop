{
  "kind": "package-set-records",
  "record_set": "measurement-ledger-tool-rows",
  "what_this_is": "Generic, unit-aware cost evidence operations over the person's existing account records door.",
  "records": [
    {
      "id": "package::measurement-ledger::tool::cost-measurement-ledger",
      "address": "package::measurement-ledger::tool::cost-measurement-ledger",
      "path": [
        "current-item",
        "published-record"
      ],
      "payload": {
        "kind": "ai-tool-descriptor",
        "id": "tool:cost-measurement-ledger",
        "label": "Check and total cost measurements",
        "status": "active",
        "job": "Check cost observations, forecasts and billing evidence and return their rows, and aggregate only comparable measured units from observations in the request",
        "description": "Takes the observations, forecast, billing evidence or forecast rows in the request, which the caller read from its store, and returns the checked rows (their ids and values), grouped totals with scenario, currency, source revision and time windows kept distinct, or the latest refresh state. Corrections and unknown coverage are preserved. Reads and keeps nothing; the caller writes returned rows through its store.",
        "input_schema": {
          "type": "object",
          "required": [
            "action"
          ],
          "additionalProperties": false,
          "properties": {
            "action": {
              "type": "string",
              "enum": [
                "check_observations",
                "aggregate",
                "check_forecast",
                "check_billing",
                "latest_refresh_state"
              ]
            },
            "observations": {
              "type": "array",
              "items": {
                "type": "object"
              },
              "description": "Observations (check_observations) or the observation rows the caller read from its store (aggregate); never include customer content."
            },
            "forecast": {
              "type": "object",
              "description": "Versioned forecast; incomplete history is returned as incomplete."
            },
            "billing": {
              "type": "object",
              "description": "Versioned provider billing evidence; unknown invoice values remain null."
            },
            "forecasts": {
              "type": "array",
              "items": {
                "type": "object"
              },
              "description": "Forecast rows the caller read from its store (latest_refresh_state)."
            },
            "group_by": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Optional dimensions to group by; default preserves all identity and billing scope dimensions."
            }
          }
        },
        "output_schema": {
          "type": "object"
        },
        "invoke": {
          "kind": "container",
          "workdir": "/opt/measurement-ledger",
          "stdout": "json",
          "internet": false,
          "argv": [
            "node",
            "/opt/records-door/do-work/run-an-export.mjs",
            "/opt/measurement-ledger/do-work/ledger-tool.mjs",
            "run"
          ],
          "stdin": {
            "fill": {
              "from": "input"
            }
          },
          "files": {
            "package_files": [
              {
                "package": "measurement-ledger",
                "paths": [
                  "do-work",
                  "read-data"
                ],
                "at": "/opt/measurement-ledger"
              },
              {
                "package": "records-door",
                "paths": [
                  "do-work",
                  "read-data"
                ],
                "at": "/opt/records-door"
              },
              {
                "package": "content-identity",
                "paths": [
                  "do-work",
                  "read-data"
                ],
                "at": "/opt/tools/content-identity"
              },
              {
                "package": "content-identity",
                "paths": [
                  "read-data"
                ],
                "at": "/opt/content-identity"
              },
              {
                "packages": [
                  "node_modules/@noble/hashes"
                ],
                "paths": [
                  "LICENSE",
                  "package.json",
                  "blake3.js",
                  "blake2.js",
                  "_blake.js",
                  "_md.js",
                  "_u64.js",
                  "utils.js"
                ],
                "at": "/opt/node_modules/@noble/hashes"
              },
              {
                "package": "browse-and-upload-my-files",
                "paths": [
                  "built-stored-bytes/content-chunks/content_chunks.js",
                  "do-work/content-chunks.mjs",
                  "do-work/namespace-client.mjs",
                  "do-work/send-a-file-to-a-namespace.mjs",
                  "do-work/send-retry.mjs",
                  "do-work/send-window.mjs",
                  "do-work/shared-file-reference.mjs",
                  "send-settings.json"
                ],
                "at": "/opt/browse-and-upload-my-files"
              }
            ]
          }
        },
        "result_selector": "$.result",
        "licence_class": "licence:maker-own",
        "maker": "maker:measurement-ledger",
        "verify": [
          {
            "kind": "sample-run",
            "input": {
              "action": "check_billing",
              "billing": {
                "provider": "vendor",
                "billing_id": "invoice-1",
                "version": 1,
                "billing_period_start": "2026-10-01",
                "billing_period_end": "2026-10-31",
                "currency": "USD",
                "unit": "invoice",
                "source_revision": "rev",
                "observed_at": "2026-10-31",
                "scope": "unknown",
                "amount": null
              }
            }
          }
        ]
      }
    }
  ]
}
