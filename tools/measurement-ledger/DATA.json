  "semantics": {
    "unknown": "value must be null; never interpreted as zero",
    "append_once": "deterministic event ID plus content equality; exact replay is idempotent; same event ID with different content raises conflict. Records-door contract confirms expected:null as atomic absent-ID precondition; exact readback distinguishes concurrent replay from conflicting content",
    "corrections": "a new event links by corrects_event_id; active aggregation excludes original after replacement, rejects missing target and ambiguous forks, and retains source rows",
    "aggregation": "Default dimensions separate provider, operation, metric semantics, unit, currency, scenario, source revision, run, and measurement window. Counter deltas and money sum; gauges select latest observed; duration distributions expose count/min/max/sum; unknown mixed with known returns partial, never complete.",
    "forecasts": "incomplete versions remain visible with completeness=incomplete; caller cannot label a forecast complete when any component is unknown",
    "retention": "records are account-owned; corrections append; no deletion or expiry is implied",
    "retries_errors": "retry/error counts may be null with an explicit unknown status; absent metrics are never summed as zero. Aggregate counts include completeness fields",
    "privacy": "evidence is a source locator only; never store prompts, transcripts, credentials, or customer payloads"
  },
  "provenance": {
    "source": "Generic measurement schemas with synthetic examples only. Private observations and discovery state are supplied through account records."
  },
  "samples_are_synthetic": true
}
