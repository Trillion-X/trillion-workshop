        // (the engine asks every kept answer again) or the engine itself was not reached, the first step not done.
        const tries = (run.interrupted?.tries ?? 0) + 1;
        const since = run.interrupted?.since ?? at;
        const reached = definition.steps.some(step => step.id === interruption.step_id && step.kind === 'ask') && !next.done[interruption.step_id];
        const step_id = reached ? interruption.step_id : asksOf(run.recipe).find(step => !next.done[step.id])?.id ?? interruption.step_id;
        next.state = tries >= interruptions.stuck_after_tries ? 'stuck' : 'working';
        next.interrupted = { step_id, tries, since, last_at: at, error: interruption.error.slice(0, 600) };
        const says = (next.state === 'stuck' ? interruptions.words.stuck : interruptions.words.interrupted).replaceAll('{tries}', String(tries));
        next.waiting = [{ ...shownOf(definition, step_id), interrupted: { says, tries, since, error: next.interrupted.error } }, ...stillWaiting.filter(item => item.step_id !== step_id).sort(byOrder)];
        if (next.state === 'stuck') next.error = says; else delete next.error;
      } else {
