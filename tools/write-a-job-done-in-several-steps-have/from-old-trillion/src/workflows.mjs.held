    const published = (await market.published({ workflow_id })).find(item => item.row?.id === workflow_id && item.maker === maker)?.row ?? null;
    // Marketplace readback can yield to an account edit. Read local state after that awaited boundary.
    const current = (await store.savedRecipes({ workflow_id })).find(item => item.id === workflow_id && item.status !== 'deleted') ?? null;
    if (!current) throw new WorkflowError(`${workflow_id} disappeared from this account while it was being published.`);
    if (identityOf(current) !== identityOf(row)) throw new WorkflowError(`${workflow_id} changed in this account while it was being published. Publish the current recipe explicitly.`);
    if (!published || identityOf(published) !== identityOf(publishedWorkflowRow(current))) throw new WorkflowError(`${workflow_id} was sent to the Marketplace, but its published row did not read back as the saved recipe.`);
