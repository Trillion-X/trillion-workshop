      const stopped = await store.run(run.run_id);
      if (stopped?.withdrawal) {
        // A call launched before stop may now have returned its real task/handoff id. Keep that follow-up evidence,
        // but admit no new step or successful result and never undo the stop with this older engine pass.
        const withdrawal = { ...stopped.withdrawal, started_work: startedWork(stopped, next) };
        const kept = { ...stopped, withdrawal };
        if (canonical(withdrawal) !== canonical(stopped.withdrawal)) await store.putRun(kept);
        return { run: kept, refused: null };
      }
      const steps = result.execution_context?.steps ?? {};
      // A check that failed refuses the answer it checked; every other answer the engine got past is kept.
      const refusals = new Map(definition.steps.filter(step => step.kind === 'check' && steps[step.id]?.status === 'failed').map(step => [step.config.subject, steps[step.id].output?.problems ?? [steps[step.id].error]]));
      let refused = actorRefusal;
      const at = now().toISOString();
      for (const [step_id, answer] of answered) {
        if (refusals.has(step_id)) {
          if (answer.sent) refused = refusals.get(step_id);
          else if (next.tool_runs[step_id]) next.tool_runs[step_id] = { ...next.tool_runs[step_id], problems: refusals.get(step_id) };
          continue;
        }
        if (steps[step_id]?.status !== 'completed') continue;
        await store.putOutput(run.run_id, answer.key, answer.output);
        next.done[answer.key] = { admitted_at: at, output_identity: identityOf(answer.output), payload_identity: answer.payloadIdentity, ...answer.evidence };
      }
      // A wait whose time had passed by the time the engine reached it is held by the engine without asking; it is kept
      // as the engine finished it.
      for (const step of definition.steps) {
        if (step.kind !== 'wait' || next.done[step.id] || steps[step.id]?.status !== 'completed') continue;
        const output = steps[step.id].output ?? {};
        await store.putOutput(run.run_id, step.id, output);
