    },

    // Shares a learned job's generic shape (src/learned-workflows.mjs publicShape) with every account, by itself and only
    // once its checks pass: it is saved as this account's own workflow and published in the same call, never before. A
    // workflow anyone can already find that runs the same tools in the same order is used instead of a second copy; this
    // account's own earlier shape of the same tools is replaced in place when its bindings changed.
    // runs: the run record with each run's result; tools: { tool_id: { made_by, descriptor } }; job: the person's words.
    async publishShape({ runs, tools: described = {}, job = '' }) {
      if (!learnedSettings.publish.on) return { published: false, why: 'off' };
      if (!market) return { published: false, why: 'This service has no shared place to publish workflows.' };
      const shape = publicShape({ runs, tools: described, job, id_suffix: maker });
      if (shape.refused) return { published: false, refused: shape.refused };
      const order = JSON.stringify(shape.tools);
      const listed = (await everything()).filter(item => JSON.stringify(toolIdsOf(item.row)) === order);
      const other = listed.find(item => item.from !== 'this account' || item.row.id !== shape.row.id);
      if (other && other.row.id !== shape.row.id) return { published: false, workflow_id: other.row.id, made_by: other.from, note: learnedWords('refused_duplicate', { workflow_id: other.row.id }) };
      const earlier = listed.find(item => item.row.id === shape.row.id)?.row ?? null;
      if (earlier && canonical(withoutPins(earlier.steps)) === canonical(withoutPins(shape.row.steps)) && canonical(earlier.input_schema) === canonical(shape.row.input_schema)) {
        return { published: true, change: 'same', workflow_id: shape.row.id, note: learnedWords('shape_same_note', { workflow_id: shape.row.id }) };
      }
      const version = earlier ? (Number(earlier.version) || 1) + 1 : 1;
