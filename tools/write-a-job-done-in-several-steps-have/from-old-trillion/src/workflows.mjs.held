  // each recipe's submit schema must require the facts that step must verify.
  const catalogs = {
    workflow: async id => (await recipeById(id))?.row ?? null,
    tool: async id => (await toolExists(id) ? { id } : null),
    'list-row': async id => { const at = id.indexOf('/'); return at > 0 && store.listRow ? (await store.listRow(id.slice(0, at), id.slice(at + 1))) ?? null : null; },
    record: async encoded => {
