    async recipeOf({ workflow_id: named, purpose }) {
      return (await recipe(nonempty(named) || purpose === undefined ? named : await workflowFor(purpose))).row;
    },

    async describe({ workflow_id: named, purpose }) {
      const workflow_id = nonempty(named) || purpose === undefined ? named : await workflowFor(purpose);
      const { row, from, space } = await recipe(workflow_id);
      // A row this account did not make shows where it came from as find does (sourceFacts): its maker's own notes on
      // why it was made stay with its maker.
      const shown = from === 'this account' || !row.source ? row : (({ source: _source, ...rest }) => (sourceFacts(row) ? { ...rest, source: sourceFacts(row) } : rest))(row);
      const step_versions = tools ? await stepVersionsOf(row, describeTool) : [];
      return { workflow: shown, made_by: from, recipe_identity: identityOf(row), ...(step_versions.length ? { step_versions } : {}), ...spaceWords({ row, space }), ...await selectedLineage(row, Boolean(space)) };
    },

    // Moves this account's saved workflow's tool steps (step_ids, or every one) to the tools as they are now, as a new
    // saved version: runs already started keep the recipe they started with (src/workflow-step-versions.mjs).
    async upgrade({ workflow_id, step_ids = [] } = {}) {
      if (!tools) throw new WorkflowError('This service runs no Marketplace tools here, so no step can be upgraded.');
      const row = await savedRow(workflow_id);
      if (!row) throw new WorkflowError(`${workflow_id} is not a workflow this account saved. A workflow is upgraded by the account that saved it; describe_workflow shows which of its steps wait for an upgrade.`);
      if (!Array.isArray(step_ids) || !step_ids.every(nonempty)) throw new WorkflowError('step_ids must list step ids of this workflow, or be left out to upgrade every tool step.');
      const { row: upgradedRow, upgraded, problems, note } = await upgradedRecipe(row, describeTool, step_ids);
      if (problems.length) throw new WorkflowError(`The workflow was not upgraded: ${problems.join(' ')}`, { problems, next_call: { tool: 'describe_workflow', arguments: { workflow_id } } });
      if (!upgraded.length) return { workflow_id, upgraded: [], note, recipe_identity: identityOf(row) };
      const candidate = { ...upgradedRow, saved_at: now().toISOString() };
      const keptRow = await store.putRecipe(candidate, { expected_identity: identityOf(row) }) ?? candidate;
      // A published copy is this account's earlier publish: it moves only when the owner publishes again.
      const published = Boolean(await marketRowOf(workflow_id));
      return { workflow_id, upgraded, recipe_identity: identityOf(keptRow), note: runsKeepWords(),
        next_call: published ? { tool: 'publish_workflow', arguments: { workflow_id } } : { tool: 'describe_workflow', arguments: { workflow_id } } };
    },

    // Turns a finished job's run record into a workflow (src/learned-workflows.mjs) and keeps it as this account's:
    // the closest learned workflow this account can see improves in place when it is this account's own, and gets this
    // account's own improvement (made_from it) when someone shared it into a space. Returns what changed and the spaces
    // the workflow already lives in, so the caller shares the new version where the old one was.
    async learn({ job, runs, source = {}, id_suffix = null, onCommit = null }) {
      if (!nonempty(job)) throw new WorkflowError('job is needed: what the work got done, in plain words.');
      // Most finished jobs have no completed tool sequence to teach. Do not load every
      // account, shared and Space workflow (or score them) for those jobs.
      if (finishedRuns(runs).length < learnedSettings.min_tool_runs) {
        return { learned: false, why: `Fewer than ${learnedSettings.min_tool_runs} tools ran and finished in this work, so there are no steps to keep.` };
      }
      const learned = (await everything({ spaces: true })).filter(item => item.row.learned_from);
      const close = (await closeness(job, learned)).rows.filter(item => item.score >= learnedSettings.same_job_at_least[item.by])
        .sort((a, b) => (a.from === 'this account' ? 0 : 1) - (b.from === 'this account' ? 0 : 1) || b.score - a.score);
      const match = close[0] ?? null;
      const mine = match?.from === 'this account' ? match.row : null;
      const theirs = match && !mine ? match : null;
      const made = learnedRecipe({
        job, runs, source, earlier: mine, made_from: theirs?.row.id ?? null, now: now(), recipeIdentity: row => identityOf(row),
