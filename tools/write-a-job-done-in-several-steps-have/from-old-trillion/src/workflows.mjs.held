// Workflows: a job done in several steps, run by the workflow engine (crates/workflow-core, reached only as the
// Workshop tool tool:run-workflow-definition, run in process by src/built-in-tools.mjs), with this person's AI, agents and Workshop tools answering its steps and every answer kept.
//
// A workflow is DATA (a row of kind "workflow-recipe"): its job in plain words, an input schema, and either ordered
// `steps` or an engine `definition` ({ steps, edges }: the step graph workflow-core runs, with branches, parallel
// steps, loops and checks). Ordered steps become an engine definition here (`definitionOf`), so every workflow runs
// on the one engine:
//   - a step the AI does becomes an `ask` named "ai": its answer is the output the AI sends with submit_workflow_step;
//   - a step with `run_tool: { tool_id, input }` becomes an `ask` named by the tool id: this person's Workshop runs it
//     wherever the tool lives (Trillion's compute or a web address);
//   - an `ask` named "agent:<agent_id>" is handed to that agent of this account, and its finished result is the answer
//     ("agent:" with no id hands it to the agent its input names in `to_agent`, and with none, to whichever of the
//     account's agents takes it first, so a rule can aim the same workflow at one agent by its input alone; its input's
//     `said`, when given, is the work as the person sees it, kept on the handoff apart from the job the AI reads; its
//     `once_per`, when given, names the item the work is about, so every run about that item reaches one handoff; its
//     `case_id` is the decision the work is worked through);
//   - a step's `checks` become a `check` step over its output (crates/workflow-core/src/executor/checks.rs): subset-of,
//     covers, mentioned-in, excludes-words, distinct-at-least, exists.
// Every answer must also fit the shape its step declares (`submit`, a JSON Schema) before the engine is given it.
//
// The engine runs a definition from the start each time something changes (a run starts, an output is sent, the run is
// read), and this host answers every ask it answered before with the answer it kept. When Trillion could not reach a step
// at all (the engine's `dispatch_failed`, or the engine itself unreachable, and the failure contract says a later try
// gets past it: src/failure.mjs `tries_again_later`), nothing about the step was decided, so the run does not fail: it
// waits at that step, tries again (src/workflow-interruptions.json), and after enough tries in a row shows as stuck
// until a read reaches it or it is resumed. An ask whose answer is not there
// yet (the AI has not sent it, a tool is still working or failed, an agent has not finished) is answered
// "not-answered-yet": the engine pauses there, and the run waits at that step. Nothing polls: reading the run asks
// again. An answer is kept only when the engine got past it, so an output its checks refuse is never kept; a refused
// tool output leaves the step waiting for the tool to run again or for output sent instead.
//
// Recipes come from four places, like Workshop tools: the rows the deploy ships (records/workflow-recipe-records.json,
// where the workflow:skill- rows are made from agent skill folders by scripts/skills-to-workflows.mjs),
// skills read from public repositories at their source (`sourced`: src/skill-sources.mjs through the shared pool,
// records/skill-sources.json, each row carrying its licence, author, repository, commit and page under `source`),
// this account's own saved recipes, and recipes other accounts published. A run keeps a copy of the recipe it started
// with and that copy's BLAKE3 identity, so changing or withdrawing a recipe never changes a run already under way.
// Each tool step also keeps the version of the tool it was written for (src/workflow-step-versions.mjs): a newer
// release runs only while the step's contract is unchanged, and otherwise the step waits for upgrade_workflow_steps.
//
// A recipe may name `made_from`: the workflows it was made from (another account's published workflow an AI changed
// for its own person, or a skill row it started from). That is the only edge kept; a workflow's variations are every
// row that names it, read from the shelf each time, so the graph grows as AIs save variations and is never written twice.
import { withActionCompleteness, actionCompletenessProblems } from './action-completeness.mjs';
import { blake3 } from '@noble/hashes/blake3.js';
import { bytesToHex } from '@noble/hashes/utils.js';
import { schemaProblems } from '../../../keep-and-wake-ai-sessions-on-this-computer/src/workshop.mjs';
import { sourceProblems } from '../../../read-public-repositories-of-agent-skills-and-offer/from-old-trillion/src/skill-sources.mjs.held';
import skillSources from '../../../read-public-repositories-of-agent-skills-and-offer/from-old-trillion/src/skill-source-config.mjs.held';
import { finishedRuns, learnedRecipe, learnedSettings, learnedWords, publicShape } from '../../../learn-a-workflow-from-a-job/src/learned-workflows.mjs';
import { failureOf } from '../../../tweak-live-controls/failure.mjs';
import { withoutSecrets } from '../../../learn-a-workflow-from-a-job/src/scheduler.mjs';
import { publishedWorkflowRow } from '../../../leave-a-makers-private-starting-values-out/src/published-workflow-privacy.mjs';
import { MATCHED_BY_WORDS, wordShare, wordsOf } from '../../../keep-and-wake-ai-sessions-on-this-computer/src/meaning-or-words.mjs';
import interruptions from '../../../workflow-interruptions/src/workflow-interruptions.json' with { type: 'json' };
import { actorPolicyProblems, actorAdmissionProblems, submittedActorEvidence } from '../../../require-that-a-workflow-steps-ai-answer-comes/src/workflow-actor-policy.mjs';
import { authoringNotes } from '../../../shared-code/src/workflow-authoring-guidance.mjs';
import { compareToPin, pinProblems, pinnedRecipe, runsKeepWords, stepVersionsOf, upgradeNeeded, upgradedRecipe, withoutPins } from '../../../shared-code/src/workflow-step-versions.mjs';

const object = value => Boolean(value) && typeof value === 'object' && !Array.isArray(value);
const nonempty = value => typeof value === 'string' && value.trim().length > 0;
function canonical(value) {
  if (Array.isArray(value)) return `[${value.map(canonical).join(',')}]`;
  if (object(value)) return `{${Object.keys(value).sort().map(key => `${JSON.stringify(key)}:${canonical(value[key])}`).join(',')}}`;
  return JSON.stringify(value ?? null);
}
// One step's output is kept as one stored value, and a hosted store keeps values under 2 MB.
const MAX_STEP_BYTES = 1_500_000;
const identityOf = value => '1f:' + bytesToHex(blake3(new TextEncoder().encode(canonical(value))));
// The reply of unpublish_workflow: one shape for its call and for its readback once the call is gone.
export const unpublishedWorkflowReply = workflow_id => ({ workflow_id, published: false, visible_to: 'only the account that saved it' });
export const workflowRecipeIdentity = identityOf;
const encoder = new TextEncoder();
const decoder = new TextDecoder();
const bytesOf = value => encoder.encode(JSON.stringify(value ?? null));
const valueOf = bytes => (bytes === undefined || bytes === null ? {} : JSON.parse(decoder.decode(bytes)));
// What an ask whose answer is not there yet is answered: workflow-core's NOT_ANSWERED_YET.
const notYet = detail => bytesOf({ $kind: 'not-answered-yet', ...detail });

// A refusal the caller can act on: every problem at once, and the call that will work.
export class WorkflowError extends Error {
  constructor(message, { problems = null, next_call = null } = {}) { super(message); this.problems = problems; this.next_call = next_call; }
}

const CHECK_KINDS = ['subset-of', 'covers', 'mentioned-in', 'excludes-words', 'distinct-at-least', 'exists'];
const CATALOGS = ['workflow', 'tool', 'list-row', 'record'];
const ROOTS = ['this', 'input', 'steps'];
const PATH_FIELDS = ['path', 'of', 'in'];
const STEP_ID = /^[a-z0-9][a-z0-9_-]*$/;

// Every problem with one list of check rules (the engine's `check` step config), for step `stepId` whose earlier
// steps are `earlier`.
function checkProblems(checks, name, stepId, earlier) {
  const problems = [];
  for (const [at, check] of (checks ?? []).entries()) {
    const where = `${name}.checks[${at}]`;
    if (!object(check) || !CHECK_KINDS.includes(check.kind)) { problems.push(`${where}.kind must be one of: ${CHECK_KINDS.join(', ')}.`); continue; }
    if (!nonempty(check.says)) problems.push(`${where}.says must say, in plain words, what the check asks for.`);
    for (const field of PATH_FIELDS) {
      if (check[field] === undefined) continue;
      const paths = Array.isArray(check[field]) && Array.isArray(check[field][0]) ? check[field] : [check[field]];
      for (const path of paths) if (!Array.isArray(path) || !ROOTS.includes(path[0]) || path.some(key => typeof key !== 'string')) problems.push(`${where}.${field} must be a list of keys starting with ${ROOTS.map(root => `"${root}"`).join(', ')}.`);
      else if (path[0] === 'steps' && (path[1] === stepId || !earlier.has(path[1]))) problems.push(`${where}.${field} reads step "${path[1]}", which is not an earlier step.`);
    }
    if (!Array.isArray(check.path)) problems.push(`${where}.path is required.`);
    if (check.kind === 'subset-of' && !Array.isArray(check.of)) problems.push(`${where}.of is required.`);
    if (check.kind === 'covers' && !Array.isArray(check.of) && !Array.isArray(check.values)) problems.push(`${where} needs of or values.`);
    if (check.kind === 'mentioned-in' && !Array.isArray(check.in)) problems.push(`${where}.in is required.`);
    if (check.kind === 'excludes-words' && !(Array.isArray(check.words) && check.words.length && check.words.every(nonempty))) problems.push(`${where}.words must list the words to keep out.`);
    if (check.kind === 'distinct-at-least' && !(Number.isInteger(check.count) && check.count > 0)) problems.push(`${where}.count must be a whole number above 0.`);
    if (check.kind === 'exists' && !CATALOGS.includes(check.catalog)) problems.push(`${where}.catalog must be one of: ${CATALOGS.join(', ')}.`);
  }
  return problems;
}

// What is wrong with a recipe row, every problem at once. A recipe that passes can be run by any account.
export function recipeProblems(recipe) {
  const problems = [];
  if (!object(recipe)) return ['The workflow must be an object.'];
  if (!/^workflow:[a-z0-9][a-z0-9-]*$/.test(recipe.id ?? '')) problems.push('id must be "workflow:" followed by lowercase letters, numbers and dashes.');
  if (!nonempty(recipe.job)) problems.push('job must say in plain words what the workflow gets done.');
  if (recipe.made_from !== undefined && !(Array.isArray(recipe.made_from) && recipe.made_from.every(id => /^workflow:[a-z0-9][a-z0-9-]*$/.test(id ?? '')) && !recipe.made_from.includes(recipe.id))) problems.push('made_from must list the ids of the workflows this one was made from ("workflow:..."), never its own id.');
  if (recipe.input_schema !== undefined && !(object(recipe.input_schema) && recipe.input_schema.type === 'object')) problems.push('input_schema must be a JSON Schema with "type": "object".');
  if (recipe.definition !== undefined) return [...problems, ...definitionProblems(recipe.definition)];
  if (!Array.isArray(recipe.steps) || recipe.steps.length === 0) return [...problems, 'steps (or definition) must list at least one step.'];
  const seen = new Set();
  const actorAsks = new Map(recipe.steps.map(step => [step?.id, { name: step?.run_tool?.tool_id ?? 'ai', policy: step?.actor_policy }]));
  recipe.steps.forEach((step, index) => {
    const name = `steps[${index}]`;
    if (!object(step)) { problems.push(`${name} must be an object.`); return; }
    if (!STEP_ID.test(step.id ?? '')) problems.push(`${name}.id must be lowercase letters, numbers, dashes or underscores.`);
    else if (seen.has(step.id)) problems.push(`${name}.id "${step.id}" is used twice.`);
    seen.add(step.id);
    if (!nonempty(step.do)) problems.push(`${name}.do must say what to do in this step.`);
    if (!(object(step.submit) && step.submit.type === 'object')) problems.push(`${name}.submit must be a JSON Schema with "type": "object" for what the step hands back.`);
    if (step.run_tool !== undefined && !(object(step.run_tool) && /^tool:/.test(step.run_tool.tool_id ?? '') && (step.run_tool.input === undefined || object(step.run_tool.input)))) problems.push(`${name}.run_tool must be { tool_id: "tool:...", input: { field: value, or { "from": path } } }.`);
    else if (step.run_tool !== undefined) problems.push(...pinProblems(step.run_tool.pinned, `${name}.run_tool.pinned`));
    problems.push(...checkProblems(step.checks, name, step.id, seen));
    problems.push(...actorPolicyProblems(step.actor_policy, { name, step_id: step.id, asks: actorAsks, prior: id => id !== step.id && seen.has(id) }));
  });
  return problems;
}

// What is wrong with an engine definition written directly: { steps: [{ id, kind, config }], edges: [{ from, to, kind }] }.
// The engine decides everything else when it runs; this names what would make every run of it fail.
function definitionProblems(definition) {
  if (!object(definition) || !Array.isArray(definition.steps) || definition.steps.length === 0) return ['definition must be { steps: [...], edges: [...] } with at least one step.'];
  const problems = [];
  const ids = new Set();
  definition.steps.forEach((step, index) => {
    const name = `definition.steps[${index}]`;
    if (!object(step) || !/^[a-z0-9][a-z0-9_#-]*$/.test(step.id ?? '') || !nonempty(step.kind)) { problems.push(`${name} must have an id (lowercase letters, numbers, dashes, underscores or #) and a kind.`); return; }
    if (ids.has(step.id)) problems.push(`${name}.id "${step.id}" is used twice.`);
    ids.add(step.id);
    if (step.kind === 'ask' && !nonempty(step.config?.name)) problems.push(`${name}.config.name must say who answers: "ai", a tool id, or "agent:<agent_id>".`);
    if (step.kind === 'ask') problems.push(...pinProblems(step.config?.context?.pinned, `${name}.config.context.pinned`));
    if (step.kind === 'ask' && step.config?.name === 'ai' && !(nonempty(step.config.input?.do) && object(step.config.input?.submit) && step.config.input.submit.type === 'object')) problems.push(`${name}.config.input must say what the AI does (do) and the shape it hands back (submit, a JSON Schema with "type": "object").`);
    if (step.kind === 'check') {
      if (!nonempty(step.config?.subject)) problems.push(`${name}.config.subject must name the step whose output is checked.`);
      if (!Array.isArray(step.config?.rules)) problems.push(`${name}.config.rules must list the checks.`);
      else problems.push(...checkProblems(step.config.rules, name, step.config.subject, new Set(definition.steps.map(item => item?.id).filter(id => id !== step.config.subject))));
    }
  });
  if (!Array.isArray(definition.edges ?? [])) problems.push('definition.edges must be a list of { from, to, kind }.');
  for (const [index, edge] of (definition.edges ?? []).entries()) if (!object(edge) || !ids.has(edge.from) || !ids.has(edge.to)) problems.push(`definition.edges[${index}] must join two steps of the definition.`);
  const actorAsks = new Map(definition.steps.filter(step => step?.kind === 'ask').map(step => [step.id, { name: step.config?.name, policy: step.config?.context?.actor_policy }]));
  const precedes = (from, to) => {
    const visited = new Set(), pending = [from];
    while (pending.length) {
      const id = pending.pop();
      if (visited.has(id)) continue;
      visited.add(id);
      for (const edge of Array.isArray(definition.edges) ? definition.edges : []) if (edge?.from === id) {
        if (edge.to === to) return true;
        pending.push(edge.to);
      }
    }
    return false;
  };
  for (const step of definition.steps.filter(step => step?.kind === 'ask')) problems.push(...actorPolicyProblems(step.config?.context?.actor_policy, {
    name: `definition.steps.${step.id}.config.context`, step_id: step.id, asks: actorAsks, prior: id => id !== step.id && actorAsks.has(id) && precedes(id, step.id),
  }));
  return problems;
}

// A tool input written with { "from": path } (the first value there) or { "all_from": path } (every value there),
// as the engine's bindings of the values at a path.
function bindingsOf(template) {
  if (Array.isArray(template)) return template.map(bindingsOf);
  if (!object(template)) return template;
  const pathKeys = Object.keys(template);
  const optionalPath = pathKeys.length === 2 && template.omit_if_missing === true && pathKeys.includes('omit_if_missing');
  if (Array.isArray(template.from) && (pathKeys.length === 1 || optionalPath)) return { $kind: 'binding', values: template.from, ...(optionalPath ? { omit_if_missing: true } : {}) };
  if (Array.isArray(template.all_from) && (pathKeys.length === 1 || optionalPath)) return { $kind: 'binding', values: template.all_from, take: 'all', ...(optionalPath ? { omit_if_missing: true } : {}) };
  return Object.fromEntries(Object.entries(template).map(([key, value]) => [key, bindingsOf(value)]));
}

// A recipe row as the engine definition it runs as. Every ask carries, as its context, what a person or AI reading the
// run sees of that step, so the host can name the step and check an answer's shape whoever answers it.
export function definitionOf(row) {
  const shell = { id: row.id, name: row.label ?? row.id, kind: 'workflow', is_active: true, version: 1 };
  if (row.definition) {
    return {
      ...shell, edges: row.definition.edges ?? [],
      steps: row.definition.steps.map(step => (step.kind === 'ask' ? { ...step, config: { ...step.config, context: { ...(object(step.config.context) ? step.config.context : {}), step_id: step.id } } } : step)),
    };
  }
  const steps = [];
  const edges = [];
  let last = null;
  for (const step of row.steps) {
    const shown = { step_id: step.id, title: step.title ?? step.id, do: step.do, submit: step.submit, checks: (step.checks ?? []).map(check => check.says), ...(step.actor_policy ? { actor_policy: step.actor_policy } : {}), ...(step.run_tool?.pinned ? { pinned: step.run_tool.pinned } : {}) };
    steps.push({ id: step.id, kind: 'ask', config: { name: step.run_tool?.tool_id ?? 'ai', input: step.run_tool ? bindingsOf(step.run_tool.input ?? {}) : { do: step.do, submit: step.submit, checks: shown.checks }, context: shown } });
    if (last) edges.push({ from: last, to: step.id, kind: 'always' });
    last = step.id;
    if (step.checks?.length) {
      steps.push({ id: `${step.id}#checks`, kind: 'check', config: { subject: step.id, rules: step.checks } });
      edges.push({ from: last, to: `${step.id}#checks`, kind: 'always' });
      last = `${step.id}#checks`;
    }
  }
  return { ...shell, steps, edges };
}

// The asks of a row in the order they are written: the steps a run shows as done or left.
// The steps a run waits on and keeps an answer for: its asks, and its waits (answered once their time has passed).
const asksOf = row => definitionOf(row).steps.filter(step => step.kind === 'ask' || step.kind === 'wait');
const stepTitlesOf = row => asksOf(row).map(step => step.config.context?.title ?? step.id);
const toolIdsOf = row => asksOf(row).map(step => step.config.name).filter(name => typeof name === 'string' && name.startsWith('tool:'));

// shared:     () → recipe rows the deploy ships (payloads).
// store:      { savedRecipes() → rows, putRecipe(row), putRecipeIfAbsent(row) → { inserted, row }, run(id) → run | null, putRun(run), runs({ before, limit }) → { cards, next } (or every run's card),
//               output(run_id, key) → output, putOutput(run_id, key, output) }. Each admitted output is its own value.
// builtIn:    the Workshop tools this Worker runs in process (src/built-in-tools.mjs): { run(tool_id, input, host) };
//               tool:run-workflow-definition runs the engine with this host's ask and read.
// market:     every account's shared recipes, when the host has one: { published() → [{ row, maker }], publish({ row, maker }),
//               unpublish({ id, maker }) → boolean }.
// maker:      this account's opaque identity in the market.
// tools:      the Workshop, when the host has one: { run({ tool_id, input, request_key }) → task, read({ task_id }) → task,
//               describe({ tool_id }) }. An ask named by a tool id runs through it.
// agents:     this account's agents, when the host has them: { handOff({ job, to_agent, input, request_key }) → { handoff_id },
//               read({ handoff_id }) → { state, result } }. An ask named "agent:<agent_id>" is handed to that agent.
// similarity: meaning search, when the host has it: (text, { id: description }) → { id: similarity 0..1 } | null. Without
//               it, or when it answers null (meaning cannot be had now, src/meaning-or-words.mjs), shared words are counted,
//               and find says so when meaning was expected.
// similar_at_least: { meaning, words }: how close another workflow's job must be to be named as doing the same job.
// spaced:     the workflows other members shared into the spaces this account is in, read as each owner keeps them now:
//               () → [{ row, space_id, space_title, by }]. A member's AI finds and runs them like its own, so a skill learned
//               in a space reaches everyone there with no other step, and the owner's later improvement reaches them too.
/** How a kept run stands: `{ state, error? }`, the error only when it ended neither working nor finished. */
// What find_workflow and the Marketplace card say about a workflow's lineage: its origins by name, and how many
// variations were made from it, each only when there is one.
// Where a workflow found through a space came from and how it was learned, so a member's AI can see who learned it and
// from what run.
function spaceWords({ row, space }) {
  return {
    ...(space ? { space: { space_id: space.space_id, title: space.title, shared_by: space.by } } : {}),
    ...(row.learned_from ? { learned_from: row.learned_from, version: row.version ?? 1, ...(row.versions?.length ? { earlier_versions: row.versions.length } : {}) } : {}),
  };
}

function lineageWords({ made_from, variations }) {
  return {
    ...(made_from.length ? { made_from: made_from.map(item => item.workflow_id), made_from_labels: made_from.map(item => item.label) } : {}),
    ...(variations.length ? { variation_count: variations.length } : {}),
  };
}

export function runState(run) {
  // working, finished, failed, or stuck: Trillion could not reach a step stuck_after_tries times in a row.
  const state = run.state ?? (run.finished_at ? 'finished' : 'working');
  return { state, ...(state !== 'working' && state !== 'finished' && run.error ? { error: run.error } : {}) };
}

// The ask workflow-core sends a wait it cannot hold under (crates/workflow-core automation.rs WAIT_ASK).
const WAIT_ASK = 'wait';
// When a wait condition is over, in ms, measured from when it was first asked; null for a wait on an event only.
function waitOver(condition, askedMs) {
  if (condition?.type === 'until') { const at = Date.parse(condition.datetime); return Number.isFinite(at) ? at : null; }
  if (condition?.type === 'duration') return askedMs + Math.max(Number(condition.secs) || 0, 0) * 1000;
  if (condition?.type === 'race') {
    const times = (condition.conditions ?? []).map(inner => waitOver(inner, askedMs)).filter(at => at !== null);
    return times.length ? Math.min(...times) : null;
  }
  return null;
}

// Where a row came from, as every place that lists workflows shows it: its licence, author, original page,
// repository and the commit it was read at. Null for a row that names none of them.
const SOURCE_FACTS = ['licence', 'author', 'url', 'repository', 'commit', 'read_from'];
export function sourceFacts(row) {
  const facts = Object.fromEntries(SOURCE_FACTS.filter(key => nonempty(row?.source?.[key])).map(key => [key, row.source[key]]));
  return Object.keys(facts).length ? facts : null;
}

// pause:      (ms) → a promise that settles after ms; how a pass waits before trying an unreachable step again.
export function makeWorkflows({ shared, sourced = null, sourceReads = null, sourceConfig = skillSources, spaced = null, store, builtIn, market = null, maker = null, tools = null, agents = null, similarity = null, similar_at_least = { meaning: 0.85, words: 0.5 }, now = () => new Date(), pause = ms => new Promise(resolve => setTimeout(resolve, ms)) }) {
  // Serialize only a run's local transitions, never a tool or agent's work. A stop can therefore be kept while a
  // dispatched call is in flight, and an older pass cannot overwrite it or dispatch another effect afterward.
  const runChanges = new Map();
  const activePasses = new Map();
  async function changeRun(run_id, change) {
    const before = runChanges.get(run_id) ?? Promise.resolve();
    const changed = before.catch(() => {}).then(change);
    runChanges.set(run_id, changed);
    try { return await changed; }
    finally { if (runChanges.get(run_id) === changed) runChanges.delete(run_id); }
  }
  const startedWork = (...runs) => {
    const entries = new Map();
    for (const run of runs) {
      for (const kept of run.withdrawal?.started_work ?? []) entries.set(`${kept.kind}:${kept.step_id}`, kept);
      for (const [step_id, task] of Object.entries(run.tool_runs ?? {})) {
        if (!task.task_id && !task.request_key) continue;
        entries.set(`tool:${step_id}`, { kind: 'tool', step_id, tool_id: task.tool_id, state: task.state,
          ...(task.request_key ? { request_key: task.request_key } : {}), ...(task.task_id ? { task_id: task.task_id, next_call: { tool: 'read_task', arguments: { task_id: task.task_id } } } : {}) });
      }
      for (const [step_id, handoff] of Object.entries(run.handoffs ?? {})) {
        if (!handoff.handoff_id && !handoff.request_key) continue;
