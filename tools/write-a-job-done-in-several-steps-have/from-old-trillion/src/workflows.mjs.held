  }
  const definitionOrder = (definition, step_id) => definition.steps.findIndex(step => step.id === step_id);
  // The step a failed run could not reach and the words it failed with, when that is all that stopped it: a step whose
  // answerer was never reached (the engine's `dispatch_failed`) with a failure a later try gets past.
  function interruptionIn(result) {
    if (result?.status !== 'failed') return null;
    for (const [step_id, step] of Object.entries(result.execution_context?.steps ?? {})) {
      const cut = step?.status === 'failed' ? step.output?.dispatch_failed : null;
      if (cut && failureOf({ message: cut.reason }).tries_again_later) return { step_id, error: String(cut.reason) };
    }
    return null;
  }
  function shownOf(definition, step_id) {
    const step = definition.steps.find(item => item.id === step_id);
    const context = step?.config?.context ?? {};
    const input = step?.config?.input ?? {};
    return { step_id, title: context.title ?? step_id, do: context.do ?? input.do, submit: context.submit ?? input.submit ?? { type: 'object' }, checks: context.checks ?? input.checks ?? [], asks: step?.config?.name, ...(context.actor_policy ? { actor_policy: context.actor_policy } : {}) };
  }

  const wholeOutputCall = (run_id, step_id) => ({ tool: 'read_workflow_run', arguments: { run_id, step_id } });
  // Read one output at a time, retain only a bounded opening, and stop fetching outputs once the run's display budget
  // is spent. Compact JSON avoids indentation multiplying the stored value's size. The admitted value is unchanged;
  // its existing exact read remains available whether the display limit is per step or across the whole run.
  function shownOutput(run_id, step_id, output, budget) {
    if (output === undefined) return {};
    const text = JSON.stringify(output);
    if (text.length <= STEP_OUTPUT_SHOWN_CHARS && text.length <= budget.left) {
      budget.left -= text.length;
      return { output };
    }
    // A substring can retain its entire large backing string in V8. Round-trip only the bounded substring so the
    // preview owns small backing storage, including an unchanged lone surrogate when the boundary splits a pair.
    const preview = JSON.parse(JSON.stringify(text.slice(0, Math.min(STEP_OUTPUT_PREVIEW_CHARS, budget.left))));
    budget.left -= preview.length;
    return { output_preview: preview, output_characters: text.length, read_whole_output: wholeOutputCall(run_id, step_id) };
  }

  async function view(run) {
    const asks = asksOf(run.recipe);
    const step = run.waiting?.[0] ?? null;
    const toolRun = step?.tool_run ?? null;
    const next = !step ? null
      : run.state === 'stuck' ? { tool: 'read_workflow_run', arguments: { run_id: run.run_id, resume: true }, note: 'Tries the step again from where the run stopped; every step done so far is kept.' }
      : step.interrupted ? { tool: 'read_workflow_run', arguments: { run_id: run.run_id }, note: 'Trillion could not reach this step just now; reading the run tries it again. Nothing done so far is lost.' }
      : step.waits_until ? { tool: 'read_workflow_run', arguments: { run_id: run.run_id }, note: `This step waits until ${step.waits_until}; Trillion reads the run again then, and so does reading it yourself after that time.` }
      : toolRun?.state === 'working' || toolRun?.state === 'scheduled' || (step.agent && !step.agent.problems && step.agent.state !== 'failed') ? { tool: 'read_workflow_run', arguments: { run_id: run.run_id }, note: 'The tool is still working; read the run again later. Working is waiting, not failure.' }
        : toolRun && (toolRun.problems || toolRun.state === 'failed') ? { tool: 'submit_workflow_step', arguments: { run_id: run.run_id, step_id: step.step_id, run_again: true }, note: 'Runs the tool again, or send output yourself instead.' }
          : { tool: 'submit_workflow_step', arguments: { run_id: run.run_id, step_id: step.step_id, output: '(what this step asks for, in the shape of submit)' } };
    const shownStep = item => ({ step_id: item.step_id, title: item.title, do: item.do, submit: item.submit, checks: item.checks, ...(item.actor_policy ? { actor_policy: item.actor_policy } : {}), ...(item.actor_problems ? { actor_problems: item.actor_problems } : {}), ...(item.asks?.startsWith('tool:') ? { runs_tool: item.asks } : {}), ...(item.asks?.startsWith('agent:') ? { handed_to: item.asks.slice('agent:'.length) } : {}), ...(item.tool_run ? { tool_run: item.tool_run } : {}), ...(item.agent ? { agent: item.agent } : {}), ...(item.interrupted ? { interrupted: item.interrupted } : {}), ...(item.waits_until ? { waits_until: item.waits_until } : {}) });
    const done = [];
    const budget = { left: RUN_OUTPUT_SHOWN_CHARS };
    for (const item of asks) {
      const kept = run.done[item.id];
      if (!kept) continue;
      const output = budget.left > 0
        ? shownOutput(run.run_id, item.id, await store.output(run.run_id, item.id), budget)
        : { read_whole_output: wholeOutputCall(run.run_id, item.id) };
      done.push({ step_id: item.id, title: item.config.context?.title ?? item.id, admitted_at: kept.admitted_at,
        ...(kept.task_id ? { task_id: kept.task_id, tool_id: kept.tool_id } : {}), ...(kept.handoff_id ? { handoff_id: kept.handoff_id } : {}), ...(kept.actor_evidence ? { actor_evidence: kept.actor_evidence } : {}), ...output });
    }
    const readWholeOutputs = done.filter(item => item.read_whole_output).map(item => item.read_whole_output);
    return {
      run_id: run.run_id,
      workflow_id: run.recipe.id,
      recipe_identity: run.recipe_identity,
      state: run.state,
      ...(run.withdrawal ? { withdrawal: run.withdrawal } : {}),
      who_does_the_work: 'You, the AI, unless a step names a tool or an agent, which Trillion runs or hands the step to. Trillion runs the steps on its workflow engine, checks each output and keeps the evidence; no step is done until its output passes.',
      input: run.input,
      done,
      ...(run.state === 'working' || run.state === 'stuck'
        ? { step: shownStep(step), ...(run.waiting.length > 1 ? { also_waiting: run.waiting.slice(1).map(shownStep) } : {}), steps_left: asks.filter(item => !run.done[item.id]).length, next_call: next, ...(run.state === 'stuck' ? { error: run.error } : {}) }
        : run.state === 'finished'
          ? { finished_at: run.finished_at, result: Object.fromEntries(done.filter(item => Object.hasOwn(item, 'output')).map(item => [item.step_id, item.output])),
            ...(readWholeOutputs.length ? { result_is_partial: true, read_whole_outputs: readWholeOutputs } : {}) }
          : { error: run.error }),
    };
  }
  async function runOf(run_id) {
    const run = await store.run(run_id);
    if (!run) throw new WorkflowError(`There is no run ${run_id} in this account.`);
    return run;
  }
  const refusal = (step_id, problems) => new WorkflowError(`Step ${step_id} was not admitted. Fix these and submit it again: ${problems.join(' | ')}`, { problems });
  // Carries a run on from its last admitted step, with every admitted output and the recipe version it started with:
  // its count of unreachable tries starts again, and a stopped or stuck run is run once more. A run whose step really
  // failed fails the same way again and says so.
  async function resume(run_id) {
    const run = await runOf(run_id);
    if (run.withdrawal) throw new WorkflowError('This run stopped because its requested work was withdrawn. Start a new run explicitly; resuming cannot recreate that work.');
    if (run.state === 'finished') throw new WorkflowError('This run is finished; there is nothing to carry on.');
    const { interrupted: _tries, error: _error, ...kept } = run;
    return await view((await pass({ ...kept, state: 'working' })).run);
  }

  return {
    // Ranked by a job, at most 25 come back (10 unless limit says). With no job it is the whole shelf in id order, as
    // many as limit asks (all of them when limit is left out), so a listing such as the Marketplace's sees every one.
    // This account's own saved workflows whose screen is of `kind` (an interface of controls, src/made-controls.mjs):
    // each one's id, name and screen, at most `limit` (1..500). Only this account's rows are read: the person's own made
    // screens, for the screen their typed words pick (src/instant-screens.mjs).
    async screens({ kind, limit = 200 } = {}) {
      if (!nonempty(kind)) throw new WorkflowError('kind is required: the kind of screen, such as "controls".');
      const most = Math.min(Math.max(Math.trunc(Number(limit)) || 1, 1), 500);
      const rows = (await store.savedRecipes({})).filter(row => row.status !== 'deleted' && row.lifecycle !== 'archived' && object(row.screen) && row.screen.kind === kind);
      return { workflows: rows.slice(0, most).map(row => ({ workflow_id: row.id, label: row.label ?? row.id, screen: row.screen })) };
    },

    async find({ job = '', limit } = {}) {
      const all = await everything({ spaces: nonempty(job) });
      // A learned workflow someone improved is found through its improvement; describe_workflow still reads it.
      const improved = new Set(all.filter(item => item.row.learned_from).flatMap(item => item.row.made_from ?? []));
      const rows = all.filter(item => !improved.has(item.row.id) && item.row.lifecycle !== 'archived');
      const ranked = nonempty(job);
      const close = ranked ? await closeness(job, rows) : { stopped: false, rows: rows.map(item => ({ ...item, score: 0 })) };
      const scored = (ranked ? close.rows.filter(item => item.score > 0) : close.rows)
        .sort((a, b) => b.score - a.score || a.row.id.localeCompare(b.row.id));
      const asked = limit === undefined ? (ranked ? 10 : scored.length) : Math.max(Number(limit) || 10, 1);
      return {
        workflows: scored.slice(0, ranked ? Math.min(asked, 25) : asked).map(({ row, from, score, space }) => ({
          workflow_id: row.id, label: row.label ?? row.id, job: row.job, made_by: from, steps: stepTitlesOf(row), closeness: Math.round(score * 1000) / 1000,
          ...(row.lifecycle === 'stale' ? { stale: learnedWords('lifecycle_stale', { workflow_id: row.id, days: learnedSettings.lifecycle.stale_after_days }) } : {}),
          ...(sourceFacts(row) ? { source: sourceFacts(row) } : {}),
          ...lineageWords(lineageOf(row, all)),
          ...spaceWords({ row, space }),
          next_call: { tool: 'start_workflow', arguments: { workflow_id: row.id, input: '(matching input_schema)', request_key: '(any unique text)' } },
        })),
        ...(close.stopped ? { matched_by_words: MATCHED_BY_WORDS } : {}),
