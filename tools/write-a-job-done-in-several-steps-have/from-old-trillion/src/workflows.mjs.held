  // A workflow that saves, to read as an example when one did not: the first of Trillion's own, chosen at run time.
  const exampleCall = async () => { const row = (await shared())[0]; return row ? { next_call: { tool: 'describe_workflow', arguments: { workflow_id: row.id } } } : {}; };
  async function selectedRecipe(workflow_id, spaces = false) {
