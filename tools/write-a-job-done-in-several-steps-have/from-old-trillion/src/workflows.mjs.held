    },

    // A learned workflow no run has used ages (DATA: learned-workflows.json lifecycle): stale, then archived, never deleted;
    // a pinned one never ages. Called by the account's alarm; the latest use of each is read from the run cards, newest first.
    async age() {
      const life = learnedSettings.lifecycle, nowMs = now().getTime(), day = 86_400_000;
      const candidates = (await store.savedRecipes()).filter(row => row.status !== 'deleted' && row.learned_from && row.pinned !== true && row.lifecycle !== 'archived');
      if (!candidates.length) return { aged: [] };
      const horizon = nowMs - life.archive_after_days * day;
      const used = new Map();
      let before = null, reached = false;
      for (let page = 0; page < life.run_pages && !reached; page += 1) {
        const read = await store.runs({ before, limit: 200 });
        const cards = Array.isArray(read) ? read : read.cards;
        for (const card of cards) {
          const at = Date.parse(card.started_at);
          if (Number.isFinite(at) && at < horizon) { reached = true; continue; }
          if (Number.isFinite(at) && card.recipe?.id && !(used.get(card.recipe.id) >= at)) used.set(card.recipe.id, at);
        }
        before = Array.isArray(read) ? null : read.next;
        if (before === null) reached = true;
      }
      if (!reached) return { aged: [], note: learnedWords('lifecycle_unreadable') };
      const aged = [];
      for (const row of candidates) {
        const reference = Math.max(used.get(row.id) ?? 0, Date.parse(row.lifecycle_at ?? row.saved_at ?? '') || 0);
        if (!reference) continue;
        const idle = (nowMs - reference) / day;
        const to = idle >= life.archive_after_days ? 'archived' : idle >= life.stale_after_days ? 'stale' : null;
        if (!to || to === row.lifecycle) continue;
        const entry = { at: now().toISOString(), from: row.lifecycle ?? 'active', to, recipe_identity: identityOf(row) };
        await store.putRecipe({ ...row, lifecycle: to, lifecycle_at: entry.at, lifecycle_log: [...(row.lifecycle_log ?? []), entry].slice(-life.log_most) }, { expected_identity: identityOf(row) });
        aged.push({ workflow_id: row.id, from: entry.from, to });
      }
      return { aged };
    },

    // Undoes the latest lifecycle change of one learned workflow: it is found again and its clock starts now.
    async restore({ workflow_id }) {
      const row = await savedRow(workflow_id);
      if (!row) throw new WorkflowError(`${workflow_id} is not a workflow this account saved.`);
      if (row.lifecycle !== 'stale' && row.lifecycle !== 'archived') throw new WorkflowError(learnedWords('lifecycle_not_aged', { workflow_id }));
      const entry = { at: now().toISOString(), from: row.lifecycle, to: 'active', recipe_identity: identityOf(row) };
      const { lifecycle: _was, ...rest } = row;
      await store.putRecipe({ ...rest, lifecycle_at: entry.at, lifecycle_log: [...(row.lifecycle_log ?? []), entry].slice(-learnedSettings.lifecycle.log_most) }, { expected_identity: identityOf(row) });
      return { workflow_id, restored: true, said: learnedWords('lifecycle_restored', { workflow_id }), next_call: { tool: 'start_workflow', arguments: { workflow_id, input: '(matching input_schema)', request_key: '(any unique text)' } } };
    },

    // One run per (workflow, request_key): the same key returns the run already started.
    async start({ workflow_id: named, purpose, input = {}, request_key }) {
      if (!nonempty(request_key)) throw new WorkflowError('request_key is required: any unique text, so sending the same start twice starts one run.');
      const workflow_id = nonempty(named) || purpose === undefined ? named : await workflowFor(purpose);
      const { row } = await recipe(workflow_id);
      const run_id = `run:${identityOf({ workflow_id, request_key }).slice(3, 27)}`;
      const earlier = await store.run(run_id);
      if (earlier) return await view((await pass(earlier)).run);
      if (row.action_completeness?.attachment_error) throw new WorkflowError(row.action_completeness.attachment_error);
      const problems = schemaProblems(input, row.input_schema ?? { type: 'object' }, 'input');
      if (problems.length) throw new WorkflowError(`The input does not fit this workflow: ${problems.join('; ')}.`, { problems });
      const run = { run_id, request_key, recipe: row, recipe_identity: identityOf(row), input, done: {}, state: 'working', started_at: now().toISOString() };
      await store.putRun(run);
      return await view((await pass(run)).run);
    },

    // Admits one step's output only when it fits the step's shape and passes every check, then names the next step.
    // For a step that runs a tool, run_again starts the tool again; output sent instead is checked like any other.
    async submit({ run_id, step_id, output, run_again = false }, { reader = null } = {}) {
      let { run } = await pass(await runOf(run_id));
      if (run.state === 'finished') throw new WorkflowError('This run is finished; nothing more is taken.');
      if (run.state === 'failed') throw new WorkflowError(`This run stopped: ${run.error}`);
      if (run.state === 'stuck') throw new WorkflowError(run.error, { next_call: { tool: 'read_workflow_run', arguments: { run_id, resume: true } } });
      if (run.done[step_id]) {
        if (canonical(await store.output(run_id, step_id)) === canonical(output)) return await view(run);
        throw new WorkflowError(`Step ${step_id} was already admitted with other output. The step now is ${run.waiting[0]?.step_id}.`, { next_call: (await view(run)).next_call });
      }
      const current = run.waiting.find(item => item.step_id === step_id);
      if (!current) throw new WorkflowError(`The step now is ${run.waiting.map(item => item.step_id).join(' or ')}, not ${step_id}. Steps are done in order.`, { next_call: (await view(run)).next_call });
      if (run_again) {
        if (!current.asks?.startsWith('tool:')) throw new WorkflowError(`Step ${step_id} runs no tool; send its output.`);
        const { [step_id]: _, ...others } = run.tool_runs ?? {};
        // Workshop restarts only a pre-effect cut-off under its original request key. Ordinary failures get a new key.
        const attempts = { ...(run.tool_attempts ?? {}) };
        if (current.tool_run?.cut_off === true) attempts[step_id] = Math.max(0, (attempts[step_id] ?? 1) - 1);
        return await view((await pass({ ...run, tool_runs: others, tool_attempts: attempts })).run);
      }
      const problems = shapeProblems(output, current.submit);
      if (current.actor_policy && current.asks?.startsWith('agent:')) problems.push('This step requires the completed agent handoff; supplied output cannot replace its author evidence.');
      else if (current.actor_policy && !submittedActorEvidence(reader)) problems.push('This step requires authenticated actor evidence from its actual author.');
      if (!problems.length) {
        const contract = run.recipe.action_completeness;
        const inventory = contract && step_id === contract.proof_step ? await store.output(run_id, contract.inventory_step) : undefined;
        problems.push(...actionCompletenessProblems(run.recipe, step_id, output, inventory));
      }
      if (problems.length) throw refusal(step_id, problems);
      const after = await pass(run, { step_id, output, actor_evidence: submittedActorEvidence(reader) });
      if (after.refused) throw refusal(step_id, after.refused);
      if (after.run.interrupted && !after.run.done[step_id]) throw new WorkflowError(`Step ${step_id} was not kept: ${after.run.waiting[0]?.interrupted?.says ?? after.run.error} Send the same output again.`, { next_call: { tool: 'submit_workflow_step', arguments: { run_id, step_id, output: '(the same output)' } } });
      return await view(after.run);
    },

    // Inspect the persisted run without advancing it or admitting a tool's output.
    // view() reads only the stored recipe, state and previously admitted output.
    async snapshot({ run_id }) {
      return await view(await runOf(run_id));
    },

    // Reading a run runs it again, so a tool or agent that answered since is admitted now.
    // With step_id, reads that admitted step's whole output instead; with resume, carries a stopped or stuck run on.
    async read({ run_id, step_id, resume: resuming = false }) {
      if (resuming) return await resume(run_id);
      if (step_id !== undefined) {
        const run = await runOf(run_id);
        if (!run.done?.[step_id]) throw new WorkflowError(`Step ${step_id} of ${run_id} has no admitted output yet.`);
        return { run_id, step_id, admitted_at: run.done[step_id].admitted_at, ...(run.done[step_id].actor_evidence ? { actor_evidence: run.done[step_id].actor_evidence } : {}), output: await store.output(run_id, step_id) };
      }
      return await view((await pass(await runOf(run_id))).run);
    },

    // Lost step submissions and stops read from the run they changed, never by passing the run again (view only reads):
    // an admitted step with this output is that submission, answered as a repeat answers it; a step not admitted was
    // never kept (a run again restarts a tool, so it cannot say); a stop is the run's kept withdrawal for this reason.
    async submitOutcome({ run_id, step_id, output, run_again = false } = {}) {
      const run = nonempty(run_id) ? await store.run(run_id) : null;
      if (!run || run_again) return run ? { state: 'unknown' } : { state: 'aborted' };
      if (!run.done?.[step_id]) return { state: 'aborted' };
      return canonical(await store.output(run_id, step_id)) === canonical(output) ? { state: 'committed', result: await view(run) } : { state: 'unknown' };
    },
    async stopOutcome({ run_id, reason } = {}) {
      const run = nonempty(run_id) ? await store.run(run_id) : null;
      if (run?.withdrawal?.kind !== 'workflow-stop') return { state: 'aborted' };
      return run.withdrawal.reason === String(reason ?? '').trim() ? { state: 'committed', result: { stopped: true, run: await view(run) } } : { state: 'unknown' };
    },

    // Stop the continuation itself, including a manual ask that has no handoff to withdraw. This does not cancel a
    // dispatched tool, recall a sent effect, or claim the requested outcome happened. Its original evidence stays.
    async stop({ run_id, reason }) {
      if (!nonempty(reason) || reason.trim().length > 2000) throw new WorkflowError('reason must say why this workflow is stopping, in 1 to 2000 characters.');
      const stopped = await changeRun(run_id, async () => {
        const run = await runOf(run_id);
        if (run.withdrawal) return run;
        if (runState(run).state === 'finished') throw new WorkflowError('This run is already finished. Stopping cannot undo its result or effects.');
        const next = { ...run, state: 'failed', waiting: [], error: `Workflow stopped: ${reason.trim()}`,
          withdrawal: { kind: 'workflow-stop', at: now().toISOString(), reason: reason.trim(),
            started_work: startedWork(run, ...(activePasses.get(run_id) ?? [])),
            note: 'Workflow continuation is stopped. Previously started tools and agents are unchanged and may still finish or have effects; read their own records before making any claim about cancellation.' } };
        delete next.interrupted;
        await store.putRun(next);
        return next;
      });
      return { stopped: true, run: await view(stopped) };
    },

    // One page of runs, newest written first; `before` is the `next` of the page before. A store that answers a plain list
    // of every run (a test's) is shown whole. run_ids reads those runs instead of a page. outcome_fields names fields a
    // caller shows (a list's own fields, src/work-item-rows.mjs): each run then also says its title and, under outcome,
    // the latest value its done steps sent for each of them, read from those steps' kept outputs only.
    async runs({ before = null, limit = null, run_ids = null, outcome_fields = null } = {}) {
      const read = Array.isArray(run_ids) ? { cards: (await Promise.all(run_ids.slice(0, RUN_IDS_READ_MOST).map(id => store.run(id)))).filter(Boolean), next: null }
        : await store.runs({ before, limit });
      const page = Array.isArray(read) ? { cards: read, next: null } : read;
      const outcomeOf = async run => {
        const outcome = {};
        if (!outcome_fields?.length) return outcome;
        for (const step of asksOf(run.recipe)) {
          if (!run.done?.[step.id]) continue;
          const output = await store.output(run.run_id, step.id);
          if (object(output)) for (const field of outcome_fields) if (output[field] !== undefined && output[field] !== null) outcome[field] = output[field];
        }
        return outcome;
      };
      return { runs: await Promise.all(page.cards.map(async run => {
        const { state } = runState(run);
        const card = { run_id: run.run_id, workflow_id: run.recipe.id, state, started_at: run.started_at, ...(state === 'working' || state === 'stuck' ? { step_now: run.waiting?.[0]?.step_id ?? null } : {}), ...(state === 'finished' ? { finished_at: run.finished_at } : state !== 'working' ? { error: run.error } : {}) };
        if (!Array.isArray(outcome_fields)) return card;
        const step = state === 'working' || state === 'stuck' ? asksOf(run.recipe).find(item => item.id === card.step_now) : null;
        return { ...card, title: run.recipe.label ?? run.recipe.id, ...(step ? { step_title: step.config.context?.title ?? step.id } : {}), outcome: await outcomeOf(run) };
      })), ...(page.next === null ? {} : { next: page.next }) };
    },

    // Keeps a workflow this account wrote, so any AI signed in to it can find and run it. Saving the same id replaces it.
    // The reply names the workflows that already do a job this close, so a duplicate is merged instead of kept twice.
    async save({ workflow }, { onCommit = null } = {}) {
      const problems = recipeProblems(workflow);
      if (problems.length) throw new WorkflowError(`The workflow was not saved: ${problems.join(' ')}`, { problems, ...(await exampleCall()) });
      const before = (await store.savedRecipes({ workflow_id: workflow.id })).find(row => row.id === workflow.id) ?? null;
      const existing = before?.status !== 'deleted' ? before : null;
      const adopted = existing?.adopted_from?.kind === 'shipped-workflow' && existing.adopted_from.workflow_id === workflow.id
        ? existing.adopted_from : null;
      const { adopted_from: _callerAdoption, ...authoredWorkflow } = workflow;
      if ((await shared()).some(row => row.id === workflow.id) && !adopted && !existing) throw new WorkflowError(`${workflow.id} is one of Trillion's own workflows. Save yours under another id, or adopt it into this account first.`);
      for (const id of workflow.made_from ?? []) if (!(await catalogs.workflow(id))) throw new WorkflowError(`made_from names ${id}, which is not a workflow this account can find. find_workflow finds the one this was made from.`);
      for (const tool_id of toolIdsOf(workflow)) if (!(await toolExists(tool_id))) throw new WorkflowError(`A step runs ${tool_id}, which is not a tool this account can find. find_tool_for_job finds one; save_tool keeps one you have.`);
      const others = (await everything()).filter(item => item.row.id !== workflow.id);
      const similar = (await closeness(`${workflow.label ?? ''}: ${workflow.job}`, others)).rows.filter(isSimilar).sort((a, b) => b.score - a.score).slice(0, 5);
      // Each tool step keeps the version of the tool it was written for (src/workflow-step-versions.mjs).
      const pinnedWorkflow = tools ? await pinnedRecipe(authoredWorkflow, describeTool) : authoredWorkflow;
      // What the author could still improve (src/workflow-authoring-guidance.json); it never refuses the save.
      const notes = await authoringNotes(pinnedWorkflow, tools ? describeTool : null);
      const candidate = { ...pinnedWorkflow, kind: 'workflow-recipe', saved_at: now().toISOString(), ...(adopted ? { adopted_from: adopted } : {}) };
      // An owner may capture the learned reply in the same transaction as its
      // recipe. The callback is a host function, never customer-authored DATA.
      // The reply is made from the kept row alone, so `onCommit` can keep it with the row (onCommit(row, reply)).
      const reply = row => ({
        workflow_id: row.id, saved: true, visible_to: 'every AI signed in to this account', recipe_identity: identityOf(row),
        ...(notes.length ? { authoring_notes: notes } : {}),
        ...(similar.length ? { similar_workflows: similar.map(({ row: other, from, score }) => ({ workflow_id: other.id, job: other.job, made_by: from, closeness: Math.round(score * 1000) / 1000 })), note: 'These already do a job this close. When one does the same job, improve that one (save_workflow with its id when it is this account\'s) instead of keeping two. When yours is a variation of one of them for this person, name it in made_from, so its origin shows yours among its variations.' } : {}),
        next_call: { tool: 'start_workflow', arguments: { workflow_id: row.id, input: '(matching input_schema)', request_key: '(any unique text)' } },
      });
      const row = await store.putRecipe(candidate, { expected_identity: before == null ? null : identityOf(before), ...(typeof onCommit === 'function' ? { onCommit: kept => onCommit(kept, reply(kept)) } : {}) }) ?? candidate;
      return reply(row);
    },

    // Copies one shipped workflow into this account under the same stable id, then publishes and verifies the exact
    // account-owned row. The conditional store write preserves a pre-existing account recipe, and the marker makes
    // this copy win over its shipped source without changing any run's immutable recipe snapshot.
    async adopt({ workflow_id }) {
      if (!nonempty(workflow_id)) throw new WorkflowError('workflow_id is required.');
      if (!market) throw new WorkflowError('This service has no shared place to publish workflows.');
      const source = (await shared()).find(row => row.id === workflow_id);
      if (!source || recipeProblems(source).length) throw new WorkflowError(`${workflow_id} is not an adoptable shipped workflow.`);
      const current = (await store.savedRecipes({ workflow_id })).find(row => row.id === workflow_id && row.status !== 'deleted') ?? null;
      let row = current;
      if (current && !(current.adopted_from?.kind === 'shipped-workflow' && current.adopted_from.workflow_id === workflow_id)) {
        throw new WorkflowError(`${workflow_id} already has an account-owned workflow. It was left unchanged.`);
      }
      for (const id of source.made_from ?? []) if (!(await catalogs.workflow(id))) throw new WorkflowError(`The shipped workflow names ${id}, which is not a workflow this account can find.`);
      if (!current) {
        if (typeof store.putRecipeIfAbsent !== 'function') throw new WorkflowError('The workflow store cannot conditionally adopt a shipped workflow.');
        const candidate = { ...source, kind: 'workflow-recipe', saved_at: now().toISOString(), adopted_from: {
          kind: 'shipped-workflow', workflow_id, recipe_identity: identityOf(source),
        } };
        const problems = recipeProblems(candidate);
        if (problems.length) throw new WorkflowError(`The shipped workflow cannot be adopted: ${problems.join(' ')}`, { problems });
        for (const tool_id of toolIdsOf(candidate)) if (!(await toolExists(tool_id))) throw new WorkflowError(`A step runs ${tool_id}, which is not a tool this account can find.`);
        const result = await store.putRecipeIfAbsent(candidate);
        if (!result?.inserted) {
          const raced = result?.row ?? (await store.savedRecipes({ workflow_id })).find(item => item.id === workflow_id && item.status !== 'deleted') ?? null;
          if (!(raced?.status !== 'deleted' && raced?.adopted_from?.kind === 'shipped-workflow' && raced.adopted_from.workflow_id === workflow_id)) {
            throw new WorkflowError(`${workflow_id} already has an account-owned workflow. It was left unchanged.`);
          }
          row = raced;
        } else row = result.row ?? candidate;
      }
      const verified = await publishAndVerify(workflow_id, row);
      return adoptedReply(workflow_id, verified.recipe_identity);
    },

    async publish({ workflow_id }) {
      if (!market) throw new WorkflowError('This service has no shared place to publish workflows.');
      const row = (await store.savedRecipes({ workflow_id })).find(item => item.id === workflow_id && item.status !== 'deleted');
      if (!row) throw new WorkflowError(`${workflow_id} is not a workflow this account saved. Save it with save_workflow first.`);
      const verified = await publishAndVerify(workflow_id, row);
      return publishedReply(workflow_id, verified.recipe_identity);
    },

    // A lost publish or adopt is read from the Marketplace row this maker has for it, never sent again: the row the
    // saved recipe publishes as is there (committed), no row is there and nothing was adopted (aborted), else unknown.
    async publishOutcome({ workflow_id } = {}) {
      const published = await marketRowOf(workflow_id);
      if (!published) return { state: 'aborted' };
      const current = await savedRow(workflow_id);
      return current && identityOf(published) === identityOf(publishedWorkflowRow(current))
        ? { state: 'committed', result: publishedReply(workflow_id, identityOf(published)) } : { state: 'unknown' };
    },
    async adoptOutcome({ workflow_id } = {}) {
      const current = await savedRow(workflow_id);
      const adopted = current?.adopted_from?.kind === 'shipped-workflow' && current.adopted_from.workflow_id === workflow_id;
      const published = await marketRowOf(workflow_id);
      if (!adopted) return published || current ? { state: 'unknown' } : { state: 'aborted' };
      return published && identityOf(published) === identityOf(publishedWorkflowRow(current))
        ? { state: 'committed', result: adoptedReply(workflow_id, identityOf(published)) } : { state: 'unknown' };
    },

    async unpublish({ workflow_id }) {
      if (!market || !(await market.unpublish({ id: workflow_id, maker }))) throw new WorkflowError(`${workflow_id} is not a workflow this account published.`);
      return unpublishedWorkflowReply(workflow_id);
    },

    // Whether this account's row for the workflow is on the Marketplace now (an unpublish's own effect is its absence).
    async publishedByThisAccount({ workflow_id }) {
      return Boolean(market) && (await market.published({ workflow_id })).some(item => item.row?.id === workflow_id && item.maker === maker);
    },

    // The public repositories whose skills are workflows here: every account's (records/skill-sources.json) and this
    // account's own, each as last read (its commit, when, any failure, the skills it gave and the ones held back with
    // why). `add` names one more repository for this account ({ host, owner, repository, branch, folder, kind }); `remove`
    // takes one of this account's own away by id.
    async sources({ add = null, remove = null } = {}) {
      if (!store.savedSources) throw new WorkflowError('This service keeps no skill repositories.');
      const config = typeof sourceConfig === 'function' ? await sourceConfig() : sourceConfig;
      if (add) {
        if (!object(add)) throw new WorkflowError('add must name a public repository.');
        const row = { host: config.hosts[0]?.id, folder: '', ...add, id: String(add.id ?? `${add.owner}-${add.repository}`).toLowerCase().replace(/[^a-z0-9._-]+/g, '-') };
        const problems = sourceProblems({...row,kind:row.kind??config.default_kind}, config.hosts, config.kinds);
        if (problems.length) throw new WorkflowError(`This repository cannot be read: ${problems.join(' ')}`, { problems });
        if (config.sources.some(item => item.id === row.id)) throw new WorkflowError(`${row.id} is already read for every account.`);
        await store.putSource({ id: row.id, host: row.host, owner: row.owner, repository: row.repository, ...(row.branch ? { branch: row.branch } : {}), ...(row.kind ? { kind: row.kind } : {}), folder: row.folder, added_at: now().toISOString() });
      }
      if (remove) {
        const row = (await ownSources()).find(item => item.id === remove);
        if (!row) throw new WorkflowError(`${remove} is not a repository this account added.`);
        await store.putSource({ ...row, status: 'deleted', removed_at: now().toISOString() });
      }
      const own = await ownSources();
      const reads = sourceReads ? await sourceReads(own) : [];
      if (canonical(await ownSources()) !== canonical(own)) throw new WorkflowError('Your skill repositories changed during this read; read the current repositories again.');
      if (typeof sourceConfig === 'function' && canonical(await sourceConfig()) !== canonical(config))
        throw new WorkflowError('The skill-source definitions changed during this read; read the current repositories again.');
      const ownIds = new Set(own.map(row => row.id));
      const shown = read => ({ id: read.source_id, commit: read.commit, read_at: read.read_at, checked_at:read.checked_at, ...(read.error ? { error: read.error } : {}), skills: read.skills ?? [], held: read.held ?? [] });
      const readOf = (id,scope) => reads.find(read => read.source_id === id && (!read.scope || read.scope === scope)) ?? {source_id:id};
      return {
        every_account: config.sources.map(source => ownIds.has(source.id) ? {...source,overridden_by_account:true} : {...source,...shown(readOf(source.id,'default'))}),
        yours: own.map(source => ({...source,...shown(readOf(source.id,'account'))})),
        hosts: config.hosts.map(host => ({ id: host.id, label: host.label })),
        kinds: Object.entries(config.kinds).map(([id, kind]) => ({ id, label: kind.label, becomes: kind.becomes })),
      };
    },

    // Only a workflow this account saved; a published one is withdrawn with it. The row is kept marked deleted, so runs
    // already started keep their version and no one finds or starts it again.
    async remove({ workflow_id }) {
      const row = (await store.savedRecipes({ workflow_id })).find(item => item.id === workflow_id && item.status !== 'deleted');
      if (!row) throw new WorkflowError(`${workflow_id} is not a workflow this account saved.`);
      if (market) await market.unpublish({ id: workflow_id, maker });
      await store.putRecipe({ ...row, status: 'deleted', removed_at: now().toISOString() }, { expected_identity: identityOf(row) });
      return { workflow_id, removed: true, visible_to: 'no one' };
    },
  };
}

// An output up to this many characters (as compact JSON) is shown whole within the run budget; otherwise its opening.
const STEP_OUTPUT_SHOWN_CHARS = 16_000;
const STEP_OUTPUT_PREVIEW_CHARS = 4_000;
// Retained output text across one view; finished results reuse those same small values instead of fetching again.
// Serialized responses can repeat a small value in done and result or escape preview characters. This character
// budget is not a total response-byte or isolate-heap limit; stored evidence and engine reads remain unchanged.
const RUN_OUTPUT_SHOWN_CHARS = 128_000;
// The most runs one read by run_ids answers, a list page's own row ids.
const RUN_IDS_READ_MOST = 100;

const PATHS = { '/workflows/restore': 'restore', '/workflows/find': 'find', '/workflows/describe': 'describe', '/workflows/start': 'start', '/workflows/submit': 'submit', '/workflows/read': 'read', '/workflows/snapshot': 'snapshot', '/workflows/stop': 'stop', '/workflows/save': 'save', '/workflows/adopt': 'adopt', '/workflows/upgrade': 'upgrade', '/workflows/publish': 'publish', '/workflows/unpublish': 'unpublish', '/workflows/remove': 'remove', '/workflows/sources': 'sources' };
export const isWorkflowPath = pathname => pathname === '/workflows' || pathname.startsWith('/workflows/');

// The workflow routes, over standard Request and Response like the case and Workshop routes.
export async function handleWorkflowRequest(workflows, request, { reportUnexpected = event => console.error(JSON.stringify(event)) } = {}) {
  const url = new URL(request.url);
  const reply = (value, status = 200) => Response.json(value, { status });
  try {
    // reads-ok: workflowRunCards.list caps the requested limit at LISTED_MOST (200).
    if (request.method === 'GET' && url.pathname === '/workflows/runs') return reply(await workflows.runs({ before: url.searchParams.get('before'), limit: url.searchParams.get('limit') }));
    const verb = request.method === 'POST' && PATHS[url.pathname];
    if (!verb) return reply({ error: 'Not found' }, 404);
    const raw = await request.text();
    if (raw.length > 4_000_000) throw new WorkflowError('Request too large: send a step\'s evidence in parts of under 4 MB, or keep large files with write_file and name them.');
    return reply(await workflows[verb](JSON.parse(raw || '{}'), { reader: request.headers.get('x-trillion-reader') || null }));
  } catch (error) {
    const expected = error instanceof WorkflowError || error instanceof SyntaxError;
    let reference = null;
    if (!expected) {
      reference = crypto.randomUUID().replaceAll('-', '').slice(0, 16);
      const error_class = error instanceof TypeError ? 'TypeError' : error instanceof ReferenceError ? 'ReferenceError' : error instanceof RangeError ? 'RangeError' : 'Error';
      const headline = `${error?.name}: ${error?.message}`;
      const stack = typeof error?.stack === 'string' && error.stack.startsWith(`${headline}\n`) ? error.stack.slice(headline.length + 1) : '';
      const frames = stack.split('\n').filter(line => /^\s*at\s+/.test(line)).slice(0, 20);
      reportUnexpected({ event: 'workflow_operation_failed', reference, operation: PATHS[url.pathname] ?? 'read', error_class, frames });
    }
    return reply({ error: String(error.message ?? error), ...(reference ? { code: 'workflow_internal_failure', reference } : {}), ...(error.problems ? { problems: error.problems } : {}), ...(error.next_call ? { next_call: error.next_call } : {}) }, expected ? 400 : 500);
  }
}
