      });
      if (!made) return { learned: false, why: `Fewer than ${learnedSettings.min_tool_runs} tools ran and finished in this work, so there are no steps to keep.` };
      if (theirs && made.change === 'new' && JSON.stringify((theirs.row.steps ?? []).map(step => step.learned_tool).filter(Boolean)) === JSON.stringify(made.row.steps.map(step => step.learned_tool).filter(Boolean))) {
        return { learned: true, workflow_id: theirs.row.id, change: 'same', version: theirs.row.version ?? 1, space: theirs.space ?? null };
      }
      if (made.change === 'same') return { learned: true, workflow_id: made.row.id, change: 'same', version: made.row.version ?? 1 };
      const answer = row => ({ learned: true, workflow_id: row.id, change: theirs ? 'improved' : made.change, version: made.row.version, recipe_identity: identityOf(row), ...(theirs ? { improves: theirs.row.id, space: theirs.space ?? null } : {}) });
      const saved = await this.save({ workflow: made.row }, { onCommit: typeof onCommit === 'function' ? row => onCommit(answer(row)) : null });
