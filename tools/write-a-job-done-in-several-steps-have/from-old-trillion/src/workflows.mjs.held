    // One try of the engine, and whether it stopped only because a step (or the engine) could not be reached.
    const tryOnce = async () => {
      answered = new Map();
      waiting = [];
      readFailures = [];
      reachedActors = new Map();
      actorRefusal = null;
      try {
        const definitions = await definitionsForRun();
        const ran = await builtIn.run('tool:run-workflow-definition', { definitions, workflow_id: run.recipe.id, input: run.input ?? {}, partition: 'person' }, { ask, read });
        if (ran.status === 'failed' && readFailures.length) {
          const error = new Error(readFailures.map(item => `Could not read ${withoutSecrets(item.catalog)} ${JSON.stringify(withoutSecrets(item.id))}: ${withoutSecrets(item.error)}`).join(' | '));
          error.failure_code = failureOf(readFailures.find(item => failureOf(item.error).tries_again_later)?.error ?? readFailures[0].error).code;
          // Reuse the engine-interruption boundary below. No answer from this uncertain pass is admitted; outputs
