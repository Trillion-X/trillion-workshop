    },
  };
  const publishedReply = (workflow_id, recipe_identity) => ({ workflow_id, published: true, recipe_identity, visible_to: 'every account\'s AI', next_call: { tool: 'unpublish_workflow', arguments: { workflow_id } } });
  const adoptedReply = (workflow_id, recipe_identity) => ({ workflow_id, adopted: true, saved: true, published: true, visible_to: 'every account’s AI', recipe_identity });
  const savedRow = async workflow_id => nonempty(workflow_id) ? (await store.savedRecipes({ workflow_id })).find(item => item.id === workflow_id && item.status !== 'deleted') ?? null : null;
  const marketRowOf = async workflow_id => market && nonempty(workflow_id) ? (await market.published({ workflow_id })).find(item => item.row?.id === workflow_id && item.maker === maker)?.row ?? null : null;
  async function publishAndVerify(workflow_id, row) {
    if (!row) throw new WorkflowError(`${workflow_id} has no saved recipe to publish.`);
