  const workflowFor = async purpose => {
    if (!nonempty(purpose)) throw new WorkflowError('Name the workflow_id, or the purpose of the default workflow to start.');
    const row = (await shared()).find(item => Array.isArray(item.default_for) && item.default_for.includes(purpose));
    if (row) return row.id;
    const named = /^[a-z0-9][a-z0-9-]*$/.test(purpose) ? (await recipeById(`workflow:${purpose}`))?.row : null;
