      const publicCandidate = publishedAdoptions.get(row.id);
      const adopted = ownCandidate && recipeProblems(withActionCompleteness(ownCandidate)).length === 0 ? ownCandidate : null;
      const publicAdoption = publicCandidate && recipeProblems(withActionCompleteness(publicCandidate.row)).length === 0 ? publicCandidate : null;
      const selected = adopted ?? publicAdoption?.row ?? row;
