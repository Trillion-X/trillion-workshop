    return found;
  }
  const toolExists = async id => { if (!tools) return false; try { await tools.describe({ tool_id: id }); return true; } catch { return false; } };
  // A tool's definition as this account reads it now: what a step's pin is made from and compared with. Null from a
  // host that answers no definition; such a step keeps no pin and follows the tool as it is.
  const describeTool = async id => {
    const found = await tools.describe({ tool_id: id });
