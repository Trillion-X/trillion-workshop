            "kind": "sample-run",
            "input": {
              "recipe": {
                "id": "workflow:made-up-bake",
                "title": "Bake a loaf",
                "steps": [
                  {
                    "id": "pick",
                    "title": "Pick flours",
                    "do": "Pick the flours the card names.",
                    "submit": {
                      "type": "object",
                      "properties": {
                        "flours": {
                          "type": "array"
                        }
                      }
                    },
                    "checks": [
                      {
                        "kind": "subset-of",
                        "says": "Only flours the card names",
                        "path": [
                          "this",
                          "flours",
                          "*"
                        ],
                        "of": [
                          "input",
                          "allowed"
                        ]
                      }
                    ]
                  },
                  {
                    "id": "bake",
                    "title": "Bake",
                    "do": "Bake the loaf.",
                    "submit": {
                      "type": "object"
                    }
                  }
                ]
              },
              "input": {
                "allowed": [
                  "rye",
                  "wheat"
                ]
              }
            },
