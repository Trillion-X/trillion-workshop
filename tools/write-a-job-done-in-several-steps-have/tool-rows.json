{
  "kind": "package-set-records",
  "record_set": "write-a-job-done-in-several-steps-have-tool-rows",
  "what_this_is": "The Workshop row for the write-a-job-done-in-several-steps-have folder: run a person's workflow on the workflow engine in one call, from engine definitions or from a recipe (or its row and step rows), with the answers known so far. It takes what it runs in its request and returns the run in its answer; nothing is kept.",
  "records": [
    {
      "payload": {
        "kind": "ai-tool-descriptor",
        "status": "active",
        "result_selector": "$.result",
        "maker": "maker:write-a-job-done-in-several-steps-have",
        "licence_class": "licence:maker-own",
        "provenance": {
          "source": "Moved from the older version (commit b6ae0ebf81): its row tool:run-workflow-definition (tools/run-rules-and-schedules-by-themselves/from-an-older-version/records/workshop-engine-tool-records.json), and its src/workflows.mjs definitionOf, moved whole into read-data/workflows.mjs (moved-from.json). The engine is tools/run-a-workflow-definition-on-the-workflow-engine-in-one-call."
        },
        "id": "tool:run-workflow-definition",
        "label": "Run a workflow definition (workflow engine)",
        "job": "Workflow engine: run a workflow definition of steps (asks, branches, loops, parallel steps, checks) with an input, using the answers known so far, and say where it finished or which steps are waiting for an answer",
        "description": "Give definitions (workflow-core definitions: id, name, kind \"workflow\", is_active, version, steps [{id, kind, config}], edges [{from, to, kind}]), the workflow_id to run, its input and answers keyed by step id (an ask's config.context.step_id) or ask name. Returns the run (status completed, failed or paused, each step's output) and waiting: the asks with no answer yet, each with the input the engine gave it. Call again with those answers added and the run goes on from there. Or give a recipe (or the person's record:workflow-recipe row with its record:workflow-step rows) instead of definitions: it becomes one definition, each step an ask (named \"ai\", or the tool a step runs) followed by a check step holding the step's checks, and a recipe holding its own definition runs as that definition. A check fails the run with the engine's own words, naming the value. A listed workflow row (source:workflow-recipes) runs as this tool: given its id as row, the shipped recipe runs, the row's other fields (a wake's input) are the run's input, start_at there is the step the run starts at, and the answer carries the recipe's kit. Nothing is kept: the caller keeps the answers and calls again.",
        "input_schema": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "definitions": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object"
              },
              "description": "Every definition the run may reach (give these with workflow_id, or give a recipe)"
            },
            "workflow_id": {
              "type": "string",
              "minLength": 1,
              "description": "The definition to run, when definitions are given"
            },
            "input": {
              "description": "The run's input, which the steps' checks may read (input....)"
            },
            "answers": {
              "type": "object",
              "description": "Answers so far, by step id or ask name"
            },
            "partition": {
              "type": "string"
            },
            "recipe": {
              "type": "object",
              "description": "A workflow recipe (id, title, steps in order, or its own definition): made a definition by definitionOf, then run"
            },
            "row": {
              "type": [
                "object",
                "string"
              ],
              "description": "The person's record:workflow-recipe row, given instead of recipe, with its steps; or a shipped workflow row's id, which is what the engine hands when a listed workflow row runs as this tool (its row source's invoke_with). Then every field other than these is the run's input, and start_at there names the step the run starts at."
            },
            "steps": {
              "type": "array",
              "items": {
                "type": "object"
              },
              "description": "The recipe row's record:workflow-step rows"
            }
          }
        },
        "output_schema": {
          "type": "object",
          "required": [
            "status",
            "waiting"
          ],
          "properties": {
            "status": {
              "type": "string"
            },
            "waiting": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "step_id"
                ],
                "properties": {
                  "step_id": {
                    "type": "string"
                  },
                  "asks": {
                    "type": "string"
                  },
                  "input": {}
                }
              }
            },
            "execution_context": {
              "type": "object"
            },
            "definition": {
              "type": "object",
              "description": "The definition a recipe was made into (only when a recipe was given)"
            }
          }
        },
        "invoke": {
