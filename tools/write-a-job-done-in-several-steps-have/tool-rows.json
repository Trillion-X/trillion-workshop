                      "id": "count",
                      "kind": "ask",
                      "config": {
                        "name": "tool:count-words",
                        "input": {},
                        "context": {
                          "step_id": "count"
                        }
                      }
                    }
                  ],
                  "edges": [
                    {
                      "from": "draft",
                      "to": "count",
                      "kind": "always"
                    }
                  ]
                }
              ]
            },
            "output_selector": "$.waiting[0].step_id",
            "contains": "count"
