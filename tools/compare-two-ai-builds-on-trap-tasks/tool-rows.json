  "what_this_is": "The Workshop rows of tools/compare-two-ai-builds-on-trap-tasks.",
  "records": [
    {
      "payload": {
        "kind": "ai-tool-descriptor",
        "id": "tool:compare-two-ai-builds-on-trap-tasks",
        "label": "Compare two AI builds on trap tasks",
        "status": "active",
        "job": "Score two builds of an AI's behaviour on the same trap tasks from the calls each run recorded, and say on which tasks they differ",
        "description": "Give left and right: each arm's trace { arm, runs: [{ task_id, state, calls: [{ tool }] }] }, written from the calls its runs recorded (never from what a run said about itself). Both are scored over the whole trap battery this tool carries (src/behavior-evals.json; each task drawn from a waste or failure class, scored by max_calls, forbids_tool, requires_tool, calls_before and ends_in), or over battery when given. A task an arm has no run for scores 0 and stays in the denominator. Returns arms (score, of, ran, classes, tasks), same_denominator and differ.",
        "input_schema": {
          "type": "object",
          "required": [
            "left",
            "right"
          ],
          "additionalProperties": false,
          "properties": {
            "left": {
              "type": "object"
            },
            "right": {
              "type": "object"
            },
            "battery": {
              "type": "object"
            }
          }
        },
        "output_schema": {
          "type": "object",
          "required": [
            "arms",
            "same_denominator",
            "differ"
          ],
          "properties": {
            "arms": {
              "type": "array"
            },
            "same_denominator": {
              "type": "boolean"
            },
            "differ": {
              "type": "array"
            }
          }
        },
        "invoke": {
          "kind": "container",
          "internet": false,
          "workdir": "/opt/compare-two-ai-builds-on-trap-tasks",
          "stdout": "json",
          "argv": [
