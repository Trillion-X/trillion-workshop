            "/opt/records-door/do-work/run-an-export.mjs",
            "/opt/compare-two-ai-builds-on-trap-tasks/do-work/compare-two-builds.mjs",
            "compareTwoBuilds"
          ],
          "stdin": {
            "fill": {
              "from": "input"
            }
          },
          "files": {
