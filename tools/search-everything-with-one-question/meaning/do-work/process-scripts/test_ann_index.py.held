    test_query_returns_candidates_containing_true_neighbor()
    test_query_against_empty_state_is_fail_closed_empty()
    test_cli_end_to_end_upsert_then_query()
    test_snapshot_refs_are_opaque_and_same_snapshot_conflicts_reject()
    test_delete_tombstone_survives_restart_and_blocks_same_snapshot_conflict()
    test_delete_before_add_persists_tombstone_across_restart()
    test_invalid_descriptor_params_fail_closed_before_empty_query()
    test_duplicate_identity_is_idempotent_and_atomic_write_preserves_old_file_on_encode_failure()
    test_scale_proof_old_scan_vs_ann_query()
    print("test_ann_index: all tests passed")
