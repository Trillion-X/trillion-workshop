{
  "_what": "The account-wide search uses the existing reciprocal-rank finisher: record kinds and each descriptor/model/match are separate rankings. File names have weight 0.8; other lanes have weight 1. Lanes are the records and file names the caller hands in (records, files), never a store read. Descriptor place overrides field-based classification (text+start=said, text=written, otherwise seen). Encoder DATA binds a descriptor model identity to the existing query-vector tool and verifies the response model. Missing input or models are reported, never guessed.",
  "limit": 60,
  "min_word_length": 2,
  "merge_seconds": 4,
  "moments_per_thing": 3,
  "fusion": {
    "k": 60,
    "word_confidence_floor": 0.15
  },
  "encoders": [
    {
      "model_id": "open_clip ViT-B-32",
      "model_version": "openai",
      "tool": "tool:words-as-picture-vector",
      "name": "ViT-B-32",
      "pretrained": "openai",
      "dims": 512
    }
  ],
  "places": [
    {
      "id": "said",
      "label": "Said"
    },
    {
      "id": "seen",
      "label": "Seen"
    },
    {
      "id": "name",
      "label": "Name"
    },
    {
      "id": "written",
      "label": "Notes and text"
    }
  ],
  "lanes": [
    {
      "id": "records",
      "match": "records",
      "place": "written",
      "source": "trillion",
      "rank": 1
    },
    {
      "id": "file-names",
      "match": "files",
      "place": "name",
      "source": "files",
      "rank": 0.8
    },
    {
      "id": "index-said",
