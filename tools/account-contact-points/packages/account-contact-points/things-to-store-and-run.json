                  "select": {
                    "from": "input",
                    "path": "account_id"
                  }
                },
                "claim_result": {
                  "$kind": "binding",
                  "select": {
                    "from": "steps",
                    "key": "claim",
                    "path": "output"
                  }
                }
              }
            }
          }
