                      ]
                    },
                    "address_mode": "identity_text",
                    "path_labels": [
                      "current-item",
                      "published-record"
                    ],
                    "payload": {
                      "kind": "account-delivery-claim",
                      "account_id": {
                        "$kind": "binding",
                        "select": {
                          "from": "input",
                          "path": "account_id"
                        }
                      },
                      "template": {
                        "$kind": "binding",
                        "select": {
                          "from": "input",
                          "path": "template"
                        }
                      },
                      "purpose": {
                        "$kind": "binding",
                        "select": {
                          "from": "input",
                          "path": "purpose"
                        }
                      },
                      "idempotency_key": {
                        "$kind": "binding",
                        "select": {
                          "from": "input",
                          "path": "idempotency_key"
                        }
                      },
                      "status": "claimed",
                      "claimed_at": {
                        "$kind": "binding",
                        "select": {
                          "from": "input",
                          "path": "at"
                        }
                      }
                    },
                    "remove": false,
                    "expected_current": {
                      "payload_hash_base64": null
                    }
                  }
                ]
              }
            }
          },
