                "operation_label": "engine.operation.write-batch",
                "partition_label": {
                  "$kind": "binding",
                  "select": {
                    "from": "input",
                    "path": "partition_label"
                  }
                },
                "writes": [
                  {
                    "address_label": {
                      "$kind": "binding",
                      "select": {
                        "from": "input",
                        "path": "idempotency_key"
                      },
                      "transform": [
                        {
                          "op": "op:core.concat",
                          "args": {
                            "values": [
                              "package::account-contact-points::delivery-claim::",
                              {
                                "$kind": "binding",
                                "select": {
                                  "from": "input",
                                  "path": "idempotency_key"
                                }
                              }
                            ]
                          }
