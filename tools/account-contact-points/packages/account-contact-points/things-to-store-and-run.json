      "remove": false,
      "payload": {
        "kind": "action",
        "id": "action:claim-delivery-once",
        "name": "claim-delivery-once",
        "description": "Idempotency barrier for exactly-once lifecycle delivery. CAS-creates account-delivery-claim::<idempotency_key> via engine.operation.label-addressed with expected_current.payload_hash_base64:null (create-only — an existing claim rejects with ExpectedCurrentMismatch, verified engine-side incl a concurrent one-success-one-mismatch test). ONLY the first (winning) create writes the record → emits the delta a downstream send trigger reacts to; replay/concurrent grants write nothing → no delta → no double-send. Generic: the caller controls the idempotency_key grain and the template/purpose DATA; no lifecycle/welcome policy here.",
        "input_schema": {
          "type": "object",
          "properties": {
            "partition_label": {
              "type": "string"
            },
            "idempotency_key": {
              "type": "string",
              "description": "the exactly-once grain, e.g. <account_id>:welcome:<capability_ref>"
            },
            "account_id": {
              "type": "string"
            },
            "template": {
              "type": "string",
              "description": "the delivery template id (DATA, caller-owned)"
            },
            "purpose": {
              "type": "string",
              "description": "delivery purpose (DATA, caller-owned)"
            },
            "at": {
              "type": "string",
              "description": "claim timestamp ISO"
            }
          },
          "required": [
            "partition_label",
            "idempotency_key",
            "account_id",
            "at"
          ]
        },
