      }
    },
    {
      "type": "stored_bytes",
      "name": "entry-bytes-record-work-surface-descriptor",
      "source_path": "built-stored-bytes/entry-bytes-record-work-surface-descriptor",
      "source_closure_receipt_path": "built-stored-bytes/entry-bytes-record-work-surface-descriptor.source-closure.json"
