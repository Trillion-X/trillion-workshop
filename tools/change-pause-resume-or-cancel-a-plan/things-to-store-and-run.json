        "kind": "bitfield-package-entry",
        "source_path": "show/mount-plan-lifecycle-portal.tsx"
      }
    },
    {
      "type": "record",
      "address": "package::plan-lifecycle::published-record::placeable-surface::plan",
      "path": [
