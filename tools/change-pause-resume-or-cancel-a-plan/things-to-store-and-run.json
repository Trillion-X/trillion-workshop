      }
    },
    {
      "type": "record",
      "address": "package::plan-lifecycle::entry::plan-lifecycle-ios-jscore",
      "address_mode": "identity_text",
      "path": [
        "packages",
        "plan-lifecycle",
        "entries",
        "plan-lifecycle-ios-jscore"
      ],
      "payload": {
        "kind": "bitfield-package-entry",
        "entry_name": "plan-lifecycle-ios-jscore",
        "source_path": "show-ios-jscore/mount-plan-lifecycle-jscore.js",
        "entry_bytes": {
          "stored_bytes": "entry-bytes-plan-lifecycle-ios-jscore"
        }
      }
    },
    {
      "type": "record",
      "address": "package::plan-lifecycle::native-screen-command-entry",
      "address_mode": "identity_text",
      "path": [
        "package-primitive",
        "native-screen-command-entry"
      ],
      "payload": {
        "kind": "bitfield-native-screen-command-entry",
        "source_path": "show-ios-jscore/mount-plan-lifecycle-jscore.js",
        "readme_path": "show-ios-jscore/README.md"
      }
    },
    {
      "type": "stored_bytes",
      "name": "read-portal-plan-state",
      "source_path": "do-work/read-portal-plan-state.ts"
    },
    {
      "type": "stored_bytes",
      "name": "send-plan-lifecycle-event",
      "source_path": "do-work/send-plan-lifecycle-event.ts"
    },
    {
      "type": "stored_bytes",
