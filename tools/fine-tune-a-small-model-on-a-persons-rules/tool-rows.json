        "kind": "ai-tool-descriptor",
        "id": "tool:build-training-rows-from-a-persons-rules",
        "label": "Build the train rows and held-out test lines for teaching a small model my rules (runs on your computer)",
        "job": "Make the training set to teach a small model my writing rules, with the test lines held out before any training",
        "description": "Reads the person's laws, their writing rules (one yes-or-no question per law, which answer fails, and which ruled-bad sets count as bad for it), the lines they ruled on, an optional transcript of them speaking, an optional folder of other people's caption files, made-up training lines and their held-out lines. Splits real lines by source before any training (ruled lines by the heading they sit under in a folder of guides, the transcript by halves, captions by video), keeps never-train and held-out lines out of training, and writes items.json (every real line with its side, sets and the laws it breaks) and train.jsonl (one row per law and line: question, options, gold answer). The same request always makes the same rows.",
        "status": "active",
        "input_schema": {
          "type": "object",
          "required": [
            "out_dir",
            "laws",
            "labelled_lines"
          ],
          "properties": {
            "out_dir": {
              "type": "string",
              "description": "The folder items.json and train.jsonl are written to."
            },
            "seed": {
              "type": "integer",
              "description": "The random generator's seed."
            },
            "test_share": {
              "type": "number",
              "description": "The share of groups that go to test."
            },
            "good_sets": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "The set names whose lines are good lines."
            },
            "fail_set": {
              "type": "string",
              "description": "The set name of ruled lines that are bad."
            },
            "pass_set": {
              "type": "string",
              "description": "The set name of ruled lines that are good."
            },
            "labelled_lines": {
              "description": "Rows {text, sets, bad_for}, inline or {\"file\": a JSON Lines file}."
            },
            "group_by_headings_in": {
              "type": "string",
              "description": "A folder of markdown guides; a ruled line found in one is grouped by its nearest heading."
            },
            "spoken": {
              "type": "object",
              "description": "{set, transcript_file, per_split, min_words}: sentences of the person speaking; the first half trains, the second half tests."
            },
            "captions": {
              "type": "object",
              "description": "{set, folder, per_video, train, test, max_characters, min_words, max_words, language}: caption sentences of other people's videos (.info.json beside .<language>.json3), split by video."
            },
            "never_train": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Lines never trained on (written to items.json as narrator); an empty list when there are none."
            },
            "held_out": {
              "description": "Rows {text, kind, breaks, unsure}, never trained on, inline or {\"file\": ...}."
            },
            "synthetic": {
              "description": "Made-up training rows {law (or * for every law), text, label: good|bad, kind}, inline or {\"file\": ...}; read in the order given (the samples depend on it)."
            },
            "short_kinds": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "The kinds of short good lines (law *) every law trains on."
            },
            "short_kinds_for": {
              "type": "object",
              "description": "{<law id>: [kinds]} for a law that takes other short kinds."
            },
            "no_other_goods": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Laws that do not train on other laws' good lines."
            },
            "laws": {
              "type": "object",
              "description": "{<law id>: {question, options: [two answers], fail: the answer that fails the line, bad_from: [the bad_for names that count as bad for this law]}}; other keys are kept."
            },
            "per_law": {
              "type": "object",
              "description": "{spoken_goods, other_goods, short_goods}: how many of each kind of good line each law trains on."
            },
            "settings_record": {
              "description": "The person's settings row record:setting:fine-tune-a-small-model-on-a-persons-rules~<scope_kind>~<scope_id> from their list:settings, exactly as selected from their database with plain SQL (or as tool:read-a-tool-setting answers it), or the path of a JSON file holding it. Its settings' build object gives every request key the request does not give (an object both give is merged key by key). Read by tools/settings/read-data/settings.py; a list of rows, or a JSON file of them, is read too."
            },
            "settings": {
              "type": "object",
              "description": "Inline settings {build: {...}} instead of settings_record, for a test or a sample."
            },
            "settings_scope": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "[scope_kind, scope_id]: which row to read when settings_record holds several."
            }
          },
          "description": "With settings_record, the person's build settings give seed, test_share, good_sets, fail_set, pass_set, per_law, short_kinds, never_train and the rest; without it the request gives them all (seed, test_share, good_sets, fail_set, pass_set, per_law, short_kinds and never_train are then required)."
        },
        "output_schema": {
          "type": "object",
          "description": "Summary lines, then a last line {\"result\": {items_file, train_file, items, train_items, test_items, train_rows, synthetic_rows, synthetic_dropped, per_law: {<law>: {train_bad, train_good, test_bad, test_good}}}} or {\"error\": \"what to change\"}. items.json holds {laws, narrator (the never-train lines), items (text, sets, bad_for, bad_laws, good, split, group), synthetic_dropped_as_test_overlap}; train.jsonl one {law, question, options, text, gold, bad, source} per line."
        },
        "invoke": {
          "kind": "on-your-computer",
          "get_it": [
            "clone the Workshop repository (package.json repository.url)"
          ],
          "run": "python3 -I tools/fine-tune-a-small-model-on-a-persons-rules/do-work/build_training_rows.py {input}",
          "needs": [
            "python",
            "the person's rules and the lines they ruled on"
          ],
          "say": "This runs on the person's own computer, from the root of the Workshop checkout. Every law, line, set name and number is the person's: read their settings row (tool:read-a-tool-setting) and pass it as settings_record, and read their laws and lines from their lists; never invent them. Write the request to a file, run `run` with that file as {input}, and read the last line: { result } names the two files and the counts per rule; { error } says what to change. Tell the person how many bad test lines each law has: a law with fewer than a handful cannot be measured."
        },
        "maker": "maker:fine-tune-a-small-model-on-a-persons-rules",
        "licence_class": "licence:maker-own",
        "placements": [
          "placement:your-computer"
        ]
      }
    },
