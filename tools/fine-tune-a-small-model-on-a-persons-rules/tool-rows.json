              "description": "items.json from tool:build-training-rows-from-a-persons-rules."
            },
            "out_dir": {
              "type": "string"
            },
            "pass_set": {
              "type": "string",
              "description": "The set name of written lines ruled good."
            },
            "held_out": {
              "description": "The held-out rows {text, kind, breaks, unsure}, inline or {\"file\": ...}."
            },
            "base_model": {
              "type": "string",
              "description": "The decider model folder (not needed with scores_from)."
            },
            "frame": {
              "type": "string",
              "description": "The context each line is put in, holding {text}."
            },
            "adapter": {
              "type": "string",
              "description": "The adapter folder; without it the base model is measured."
            },
            "scores_from": {
              "type": "string",
              "description": "An earlier results file whose kept scores are reported again."
            },
            "batch": {
              "type": "integer"
            },
            "device": {
              "type": "string"
            },
            "nice": {
              "type": "integer"
            },
            "threads": {
              "type": "integer"
            },
            "settings_record": {
              "description": "The person's settings row record:setting:fine-tune-a-small-model-on-a-persons-rules~<scope_kind>~<scope_id> from their list:settings, exactly as selected from their database with plain SQL (or as tool:read-a-tool-setting answers it), or the path of a JSON file holding it. Its settings' score object gives every request key the request does not give (an object both give is merged key by key). Read by tools/settings/read-data/settings.py; a list of rows, or a JSON file of them, is read too."
            },
            "settings": {
              "type": "object",
              "description": "Inline settings {score: {...}} instead of settings_record, for a test or a sample."
            },
