{
  "schema": "bitfield.local_external_process_runtime_source.v1",
  "runtime_alias": "local-whisper",
  "build_owner": "package::service-connections::how-to-ask-something-else-to-do-things::container-engine",
  "build_context": "packages/audio-transcription/runtime/local-whisper",
  "build_platform": "linux/arm64",
  "provider": {
    "provider_id": "local-oci-engine",
    "provider_protocol_revision": "bitfield.oci-engine-api/v1",
    "provider_connection_ref": "package::service-connections::connection::local-oci-engine",
    "provider_entrypoint": [
      "/usr/local/bin/python3"
    ],
    "provider_argv_prefix": [],
    "workspace_mount_path": "/bitfield/workspace",
    "exposed_ports": [],
    "required_capabilities": {
      "persistent_session": true,
      "descendant_lifecycle": true,
      "exclusive_private_volume_lease": true,
      "correlated_output": true,
      "cleanup": true,
      "zero_unowned_descendants": true
    }
  },
  "runtime": {
    "network_allowed": false,
    "max_runtime_ms": 1800000,
    "required_paths": {
      "python3": "/usr/local/bin/python3",
      "ffmpeg": "/usr/bin/ffmpeg",
      "whisper_cli": "/opt/whisper/bin/whisper-cli",
      "model": "/opt/whisper/models/ggml-tiny.en.bin"
    }
  },
  "local_process_role_projection": {
    "projector": "packages/native-artifact/do-work/apply-local-process-role-binding.py",
    "selection_schema": "bitfield.local_process_role_provider_binding_selection",
    "source_role_id": "local-macos-presentation-shell",
    "expected_skeleton_role_id": "local-macos-presentation-shell",
    "runtime_alias_selection": {
      "name": "local-whisper",
      "mode": "add_external_provider"
    },
    "alias_fields_from_this_source": [
      "provider",
      "runtime.network_allowed",
      "runtime.max_runtime_ms"
    ]
  },
  "local_registry_promotion": {
    "status": "optional_when_the_local_config_and_ordered_layers_are_exactly_pinned",
    "repository_must_match": "^(127\\.0\\.0\\.1|localhost):[0-9]+/bitfield-local-whisper$",
    "source_image": "bitfield-local-whisper:1.8.3-tiny-en",
    "docker_engine_operations": [
      "POST /images/{source_image}/tag?repo={loopback_repository}&tag=1.8.3-tiny-en",
      "POST /images/{loopback_repository}:1.8.3-tiny-en/push",
      "GET /images/{loopback_repository}:1.8.3-tiny-en/json"
    ],
    "required_result": {
      "repo_digest_must_match": "^(127\\.0\\.0\\.1|localhost):[0-9]+/bitfield-local-whisper@sha256:[0-9a-f]{64}$",
      "image_id_must_equal_build_result": true
    },
    "refuse": [
      "non-loopback registry",
      "image ID used as artifact digest",
      "mutable tag used as artifact identity",
      "local image without exact config and ordered layer identities"
    ]
  },
  "artifact_admission": {
    "required_reference_shape": "<loopback-name>@sha256:<manifest-digest> or local-oci-image/rootfs/<ordered-sha256-diff-ids>@sha256:<config-digest>",
    "digest_is_filled_only_from_container_engine_build_result": true,
    "local_image_identity": {
      "config_digest_source": "inspect.Id",
      "ordered_layer_identity_source": "inspect.RootFS.Layers",
      "absence_is_never_pulled_or_substituted": true
    },
    "native_fallback": false
  }
}
