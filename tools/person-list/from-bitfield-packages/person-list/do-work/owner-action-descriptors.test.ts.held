import { describe, expect, it } from 'vitest';
import {
  buildOwnerActionPayload,
  decodeOwnerActionDescriptors,
  requireOwnerActionDescriptor,
} from './owner-action-descriptors';

describe('owner action descriptors', () => {
  it('decodes target and action details from data', () => {
    const descriptors = decodeOwnerActionDescriptors({
      actions: [
        {
          key: 'search',
          target: 'slot::workflow',
          operation: 'execute_definition',
          definition_id: 'action:any-package.record-request',
          include_steps: false,
          include_output: false,
          input_template: { action: 'search' },
        },
      ],
    });
    expect(descriptors).toHaveLength(1);
    expect(descriptors[0]).toMatchObject({
      key: 'search',
      target: 'slot::workflow',
      operation: 'execute_definition',
      definitionId: 'action:any-package.record-request',
      inputTemplate: { action: 'search' },
    });
  });

  it('builds an opaque owner-action payload from descriptor and input', () => {
    const descriptor = requireOwnerActionDescriptor(decodeOwnerActionDescriptors([
      {
        key: 'refresh-primary',
        target: 'slot::workflow',
        operation: 'execute_definition',
        definition_id: 'action:any-package.refresh',
        input_template: { source: 'configured' },
      },
    ]), 'refresh-primary');
    expect(buildOwnerActionPayload(descriptor, { requested_at: '2026-06-22T00:00:00Z' })).toEqual({
      operation: 'execute_definition',
      definition_id: 'action:any-package.refresh',
      include_steps: false,
      include_output: false,
      input: {
        source: 'configured',
        requested_at: '2026-06-22T00:00:00Z',
      },
    });
  });

  it('throws when the requested action descriptor is absent', () => {
    expect(() => requireOwnerActionDescriptor([], 'search')).toThrow(/Missing owner-action descriptor/);
  });
});
