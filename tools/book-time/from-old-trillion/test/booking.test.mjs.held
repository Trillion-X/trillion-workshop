// Booking a session an access is fulfilled by: open times from the row's rules, the mention condition, the book
// that never lets a time go twice, and the messages and calendar calls that go out.
import { test } from 'node:test';
import assert from 'node:assert/strict';
import { sqliteHost } from '../src/local-store.mjs';
import { BookingBook, BookingRefusal, bookables, bookingEffects, bookingPeriod, holds, inviteFor, mentionFits, messages, openTimes, timeWords, valueAt } from '../src/booking.mjs';
import { MAIL_SETTINGS } from '../src/mail-sender.mjs';
import { HostBookings } from '../src/host-bookings.mjs';

// Any SQLite, in the Durable Object's exec(...).toArray() shape.
function sqlite() { return sqliteHost(':memory:').sql; }
const row = bookables()[0];
// Friday 2026-10-02 12:00 in the row's zone is 19:00 UTC; the row asks for two days' notice.
const NOW = Date.parse('2026-10-02T19:00:00Z');
const at = iso => Date.parse(iso);

// A made-up service in another field: nothing in the booking code knows the real row.
const tutor = {
  id: 'bookable:tutor', access: 'access:tutor', host: { id: 'host:tutor', name: 'Ms Ada', email: 'ada@example.org', calendar: null },
  session: { title: 'Calculus tutoring', place: 'Online', sessions_per_purchase: 2 },
  rules: { timezone: 'Europe/Berlin', windows: [{ weekday: 6, start: '10:00', end: '12:00' }], session_minutes: 60, step_minutes: 30, min_notice_minutes: 0, horizon_days: 7 },
  reminders: [{ minutes_before: 60 }],
};

test('open times follow the row: session length, notice, buffers, one a day, and busy blocks removed', () => {
  const times = openTimes(row, { nowMs: NOW });
  assert.ok(times.length > 0);
  assert.ok(times.every(time => time.end_ms - time.start_ms === row.rules.session_minutes * 60000));
  assert.ok(times[0].start_ms >= NOW + row.rules.min_notice_minutes * 60000, 'nothing inside the notice period');
  assert.equal(timeWords(times[0].start_ms, row.rules.timezone), 'Monday, October 5 at 9:00 AM PDT', 'Saturday and Sunday are not in the windows');
  const first = times[0];
  // A booked session that day takes the whole day (max_per_day 1).
  const afterHeld = openTimes(row, { nowMs: NOW, held: [first] });
  assert.ok(!afterHeld.some(time => timeWords(time.start_ms, row.rules.timezone).startsWith('Monday, October 5')));
  // A busy block from 12:30 to 13:00 closes every time whose buffered span touches it.
  const busy = [{ start_ms: at('2026-10-06T19:30:00Z'), end_ms: at('2026-10-06T20:00:00Z') }];
  const tuesday = openTimes(row, { nowMs: NOW, busy }).filter(time => timeWords(time.start_ms, row.rules.timezone).startsWith('Tuesday, October 6'));
  assert.deepEqual(tuesday.map(time => timeWords(time.start_ms, row.rules.timezone).split(' at ')[1]), ['9:00 AM PDT', '2:00 PM PDT'], 'only times whose span and buffers miss 12:30-1:00 stay');
  // The made-up row: Saturdays 10-12 Berlin, hour sessions every half hour.
  assert.deepEqual(openTimes(tutor, { nowMs: NOW }).map(time => new Date(time.start_ms).toISOString()), ['2026-10-03T08:00:00.000Z', '2026-10-03T08:30:00.000Z', '2026-10-03T09:00:00.000Z']);
});

test('the mention condition is read from the decision record, and never repeats, never reaches a holder or someone who said no', () => {
  const plain = { status: 'needs_outcome', guidance: [{ step_id: 'scope', answer: { decision_context: { consequential: true, worth_weighing: false, involves_others: true } } }] };
  const weighty = { ...plain, guidance: [{ step_id: 'scope', answer: { decision_context: { consequential: true, worth_weighing: true, involves_others: true } } }] };
  const revised = { ...plain, decision_history: [{ decision: {} }] };
  assert.equal(valueAt(weighty, ['guidance', { step_id: 'scope' }, 'answer', 'decision_context', 'worth_weighing']), true);
  assert.equal(holds(row.mention.when, plain), false, 'an ordinary decision gets nothing');
  assert.equal(holds(row.mention.when, weighty), true);
  assert.equal(holds(row.mention.when, revised), true, 'a decision already revised once is going in circles');
  assert.equal(holds(row.mention.when, { status: 'correction_needed' }), true);
  const fits = extra => mentionFits({ row, record: weighty, holdsAccess: false, seen: null, nowMs: NOW, ...extra });
  assert.equal(fits(), true);
  assert.equal(fits({ holdsAccess: true }), false);
  assert.equal(fits({ seen: { declined_at: '2026-01-01T00:00:00Z' } }), false);
  assert.equal(fits({ seen: { mentioned_at: new Date(NOW - 5 * 86400000).toISOString() } }), false, 'said five days ago');
  assert.equal(fits({ seen: { mentioned_at: new Date(NOW - 31 * 86400000).toISOString() } }), true, 'said a month ago');
});

test('the book grants once per purchase, books only open times, never twice, and frees a cancelled time', () => {
  let now = NOW;
  let counter = 0;
  const book = new BookingBook(sqlite(), { now: () => now, token: () => `${(counter += 1).toString(16).padStart(4, '0')}${'ab'.repeat(20)}` });
  const first = book.grant({ key: 'payment_confirmed:one', bookable_id: row.id, person_ref: 'person-a', email: 'a@example.org' });
  assert.equal(first.created, true);
  assert.equal(book.grant({ key: 'payment_confirmed:one', bookable_id: row.id, person_ref: 'person-a', email: 'a@example.org' }).created, false, 'a repeated payment event makes no second grant');
  const other = book.grant({ key: 'payment_confirmed:two', bookable_id: row.id, person_ref: 'person-b', email: 'b@example.org' }).grant;
  const [time] = openTimes(row, { nowMs: now });
  assert.throws(() => book.book({ grant: first.grant, start_ms: time.start_ms + 60000 }), BookingRefusal, 'a time not in the open list');
  const booked = book.book({ grant: first.grant, start_ms: time.start_ms, case_id: 'case-1' });
  assert.equal(booked.state, 'booked');
  assert.equal(booked.case_id, 'case-1');
  assert.throws(() => book.book({ grant: other, start_ms: time.start_ms }), /just taken/, 'the same time for someone else');
  assert.throws(() => book.book({ grant: first.grant, start_ms: openTimes(row, { nowMs: now, held: book.held(row.id) })[0].start_ms }), /already booked/, 'one session per purchase');
  assert.equal(book.dueReminders().length, 0);
  assert.equal(book.nextReminderAt(), time.start_ms - 1440 * 60000);
  // Moving keeps the booking and its token; the old time opens again.
  const later = openTimes(row, { nowMs: now, held: book.held(row.id, booked.id) }).find(item => item.start_ms > time.start_ms + 86400000);
  const moved = book.move(booked, later.start_ms);
  assert.equal(moved.token, booked.token);
  assert.equal(moved.sequence, 1);
  assert.ok(book.isOpen(row, time.start_ms, []), 'the earlier time is open again');
  // Reminders fall due as time passes, and each is sent once.
  now = later.start_ms - 1439 * 60000;
  assert.deepEqual(book.dueReminders().map(item => item.minutes_before), [1440]);
  book.reminded(booked.id, 1440);
  assert.equal(book.dueReminders().length, 0);
  // Too close to the start to change here.
  assert.throws(() => book.cancel(moved), /too soon/);
  now = NOW;
  const cancelled = book.cancel(moved);
  assert.equal(cancelled.state, 'cancelled');
  assert.equal(book.left(first.grant), 1, 'a cancelled session can be booked again');
  assert.throws(() => book.cancel(cancelled), /already cancelled/);
  // Forgetting a person returns their upcoming sessions and drops their email from what they hold.
  book.book({ grant: other, start_ms: time.start_ms });
  assert.equal(book.forget('person-b').length, 1);
  assert.equal(book.grantByToken(other.token).email, null);
});

test('one public contract purchase key grants each signer and bookable access independently', () => {
  let counter = 0;
  const book = new BookingBook(sqlite(), { now: () => NOW, token: () => `${(counter += 1).toString(16).padStart(4, '0')}${'ab'.repeat(20)}` });
  const key = 'contract-signed:public-share';
  const first = book.grant({ key, bookable_id: row.id, person_ref: 'buyer-a' });
  const second = book.grant({ key, bookable_id: row.id, person_ref: 'buyer-b' });
  assert.equal(first.created, true);
  assert.equal(second.created, true);
  assert.equal(first.grant.key, key, 'the original buyer keeps the existing key and booking link');
  assert.notEqual(second.grant.key, first.grant.key);
  assert.deepEqual(book.grantsFor('buyer-a').map(grant => grant.key), [first.grant.key]);
  assert.deepEqual(book.grantsFor('buyer-b').map(grant => grant.key), [second.grant.key]);
  assert.equal(book.grant({ key, bookable_id: row.id, person_ref: 'buyer-a' }).grant.token, first.grant.token);
  assert.equal(book.grant({ key, bookable_id: row.id, person_ref: 'buyer-b' }).grant.token, second.grant.token);
  const otherAccess = bookables()[1];
  const separateAccess = book.grant({ key, bookable_id: otherAccess.id, person_ref: 'buyer-a' });
  assert.equal(separateAccess.created, true, 'one purchase can include more than one bookable access');
  assert.notEqual(separateAccess.grant.key, first.grant.key);
  book.forget('buyer-a');
  assert.equal(book.grant({ key, bookable_id: row.id, person_ref: 'buyer-b' }).grant.token, second.grant.token, 'a forgotten first buyer cannot duplicate another buyer’s grant');
  assert.equal(book.grant({ key, bookable_id: row.id, person_ref: 'buyer-c' }).created, true);
});

test('a buyer without email gets a named host invitation with no invalid attendee', () => {
  const start = openTimes(row, { nowMs: NOW })[0].start_ms;
  const invite = inviteFor(row, { id: 'booking-passkey', email: null, customer_name: 'Proof Buyer', start_ms: start, end_ms: start + row.rules.session_minutes * 60000, sequence: 0 }, { nowMs: NOW });
  assert.match(invite, /Proof Buyer/);
  assert.doesNotMatch(invite, /MAILTO:(null|undefined)|ATTENDEE/i);
});

test('a recurring contract refills only in its paid period, expires unused calls, and keeps booked calls', () => {
  let now = Date.parse('2026-10-02T19:00:00Z');
  let counter = 0;
  const book = new BookingBook(sqlite(), { now: () => now, token: () => `${(counter += 1).toString(16).padStart(4, '0')}${'ab'.repeat(20)}` });
  const contract = { grants: [row.access], limits: [{ key: row.access, quantity: 2, unit: 'call', per: 'month' }] };
  const firstEffect = { kind: 'payment.confirmed', material: { subscription_id: 'sub_calls', occurred_at: '2026-10-01T00:00:00Z' } };
  const firstPeriod = bookingPeriod(row, contract, firstEffect);
  const first = book.grant({ key: 'sub_calls', bookable_id: row.id, person_ref: 'buyer', contract, period: firstPeriod });
  assert.equal(first.grant.sessions, 2);
  const [time] = openTimes(row, { nowMs: now });
  book.book({ grant: first.grant, start_ms: time.start_ms });
  assert.equal(book.left(first.grant), 1);

  const november = { series_key: 'sub_calls', period_start: Date.parse('2026-11-01T00:00:00Z') / 1000, period_end: Date.parse('2026-12-01T00:00:00Z') / 1000 };
  const next = book.grant({ key: 'invoice:in_nov', bookable_id: row.id, person_ref: 'buyer', contract, period: november });
  assert.equal(next.created, true);
  assert.equal(book.left(first.grant), 1, 'the prior credit remains usable until the new period begins');
  assert.equal(book.left(next.grant), 0, 'a future invoice does not make credits usable early');
  now = Date.parse('2026-11-02T00:00:00Z');
  assert.equal(book.left(first.grant), 0, 'the old unbooked call ends at the period boundary');
  assert.equal(book.bookingsOf(first.grant.key).length, 1, 'the booked call remains');
  assert.equal(book.left(next.grant), 2);
  assert.equal(book.grant({ key: 'invoice:in_nov', bookable_id: row.id, person_ref: 'buyer', contract, period: november }).created, false);
  assert.equal(book.grant({ key: 'invoice:in_nov_duplicate', bookable_id: row.id, person_ref: 'buyer', contract, period: november }).created, false, 'two invoice IDs for one period do not double grant');

  const october = { series_key: 'sub_calls', period_start: Date.parse('2026-10-15T00:00:00Z') / 1000, period_end: november.period_start };
  const late = book.grant({ key: 'invoice:in_oct_late', bookable_id: row.id, person_ref: 'buyer', contract, period: october });
  assert.equal(late.created, true);
  assert.equal(book.left(late.grant), 0, 'a late older invoice cannot restore expired credits');
  assert.equal(book.left(next.grant), 2);
  now = Date.parse('2026-12-02T00:00:00Z');
  assert.equal(book.left(next.grant), 0, 'credits end even when no next webhook arrives');
});

test('only a periodic contract on a subscription has a period grant', () => {
  const contract = { grants: [row.access], limits: [{ key: row.access, quantity: 2, per: 'month' }] };
  const effect = { kind: 'subscription.renewed', material: { subscription_id: 'sub_calls', invoice_ref: 'in_nov', billing_reason: 'subscription_cycle', period_start: 1793491200, period_end: 1796083200 } };
  assert.deepEqual(bookingPeriod(row, contract, effect), { series_key: 'sub_calls', period_start: 1793491200, period_end: 1796083200 });
  assert.equal(bookingPeriod(row, { grants: [row.access], limits: [{ key: row.access, quantity: 2, per: 'contract' }] }, effect), null);
  assert.equal(bookingPeriod(row, contract, { ...effect, material: { ...effect.material, billing_reason: 'subscription_create' } }), null);
  assert.equal(bookingPeriod(row, contract, { ...effect, material: { ...effect.material, period_end: undefined } }), null);
  assert.equal(bookingPeriod(row, contract, { ...effect, material: { ...effect.material, billing_interval: 'week' } }), null);
  assert.equal(bookingPeriod(row, contract, { ...effect, material: { ...effect.material, billing_interval: 'month', billing_interval_count: '2' } }), null);
  assert.equal(bookingPeriod(row, contract, { ...effect, material: { ...effect.material, subscription_id: 'pi_one_time' } }), null);
});

test('a previously issued subscription credit is closed when its first tracked renewal arrives', () => {
  let now = Date.parse('2026-10-02T19:00:00Z');
  let counter = 0;
  const book = new BookingBook(sqlite(), { now: () => now, token: () => `${(counter += 1).toString(16).padStart(4, '0')}${'ab'.repeat(20)}` });
  const contract = { grants: [row.access], limits: [{ key: row.access, quantity: 2, per: 'month' }] };
  const old = book.grant({ key: 'sub_old', bookable_id: row.id, person_ref: 'buyer', contract }).grant;
  const [time] = openTimes(row, { nowMs: now });
  book.book({ grant: old, start_ms: time.start_ms });
  const november = { series_key: 'sub_old', period_start: Date.parse('2026-11-01T00:00:00Z') / 1000, period_end: Date.parse('2026-12-01T00:00:00Z') / 1000 };
  const renewed = book.grant({ key: 'invoice:in_nov', bookable_id: row.id, person_ref: 'buyer', contract, period: november });
  assert.equal(book.left(old), 1);
  now = Date.parse('2026-11-02T00:00:00Z');
  assert.equal(book.left(old), 0);
  assert.equal(book.left(renewed.grant), 2);
  assert.equal(book.bookingsOf(old.key).length, 1);
});

test('messages go to the buyer and the host from the row; the invite names the host as organizer', () => {
  const booking = { id: 'booking_x', token: 'bt', grant_token: 'gt', start_ms: at('2026-10-05T16:00:00Z'), end_ms: at('2026-10-05T19:00:00Z'), email: 'buyer@example.org', sequence: 0 };
  const origin = 'https://trillion.example';
  const bought = messages.bought({ row, grant: { email: 'buyer@example.org', token: 'gt' }, origin, offer: { label: 'The session', price_options: [{ label: '$9' }] } });
  assert.deepEqual(bought.map(message => message.to[0]), ['buyer@example.org', row.host.email]);
  assert.match(bought[0].text, /https:\/\/trillion\.example\/book\/gt/);
  const invite = inviteFor(row, booking, { nowMs: NOW });
  const unfolded = invite.replace(/\r\n /g, "");
  assert.match(unfolded, new RegExp(`ORGANIZER;CN=${row.host.name}:mailto:${row.host.email}`));
  assert.match(unfolded, /ATTENDEE;CUTYPE=INDIVIDUAL;ROLE=REQ-PARTICIPANT;PARTSTAT=NEEDS-ACTION;RSVP=TRUE:mailto:buyer@example\.org/);
  assert.match(invite, /DTSTART:20261005T160000Z/);
  assert.match(invite, /TRIGGER:-PT1440M/);
  const booked = messages.booked({ row, booking, origin, placed: { route: 'invite', invite } });
  assert.equal(booked[0].invite, invite);
  assert.match(booked[0].subject, /Monday, October 5 at 9:00 AM PDT/);
  assert.match(booked[0].text, /\/book\/bt/);
  assert.match(inviteFor(row, { ...booking, sequence: 2 }, { method: 'CANCEL', nowMs: NOW }), /METHOD:CANCEL[\s\S]*STATUS:CANCELLED[\s\S]*SEQUENCE:2/);
});

test('without a calendar connection busy is unknown and the invite route is used; mail goes from the one sender with replies to the host', async () => {
  const booking = { id: 'booking_x', start_ms: at('2026-10-05T16:00:00Z'), end_ms: at('2026-10-05T19:00:00Z'), email: 'buyer@example.org', sequence: 0 };
  const mailed = [];
  const binding = { send: async message => { mailed.push(message); return { messageId: 'email-1' }; } };
  const bare = bookingEffects({ [MAIL_SETTINGS.send_binding]: binding });
  assert.deepEqual(await bare.busy(row, NOW, NOW + 1), { status: 'unknown', busy: [] });
  assert.equal((await bare.place(tutor, booking, NOW)).route, 'invite', 'a session that is not a video call can go by invitation file');
  assert.deepEqual(await bare.place(row, booking, NOW), { route: null, event_id: null, connected: false, error: 'no calendar is connected' }, 'a video call cannot: the file makes no call');
  assert.deepEqual(await bare.mail(row, { to: ['buyer@example.org'], subject: 's', text: 't', invite: 'BEGIN:VCALENDAR' }), { sent: true, id: 'email-1' });
  assert.deepEqual(mailed[0].from, MAIL_SETTINGS.from);
  assert.equal(mailed[0].replyTo, row.host.email);
  assert.equal(mailed[0].attachments[0].filename, 'invite.ics');
  assert.equal(atob(mailed[0].attachments[0].content), 'BEGIN:VCALENDAR');
  assert.deepEqual(await bookingEffects({}).mail(row, { to: ['x@example.org'], subject: 's', text: 't' }), { sent: false, error: `no email-sending binding is bound as ${MAIL_SETTINGS.send_binding}` });
  const refusing = bookingEffects({ [MAIL_SETTINGS.send_binding]: { send: async () => { throw Object.assign(new Error('not verified'), { code: 'E_SENDER_NOT_VERIFIED' }); } } });
  assert.deepEqual(await refusing.mail(row, { to: ['x@example.org'], subject: 's', text: 't' }), { sent: false, error: 'E_SENDER_NOT_VERIFIED: not verified' });
  const words = messages.booked({ row, booking: { ...booking, token: 'bt', video_link: 'https://meet.google.com/x' }, origin: 'https://t.example', placed: { route: 'calendar', event_id: 'event-1' } });
  assert.ok(words.every(message => message.text.includes('Join the video call: https://meet.google.com/x')), 'both people get the link');
});

// One booked session with its day-before reminder, and a host whose mail answers `answer(message)`.
function reminding(answer) {
  let now = NOW;
  let counter = 0;
  const mailed = [];
  const calendar = new HostBookings({
    sql: sqlite(), now: () => now, entitled: async () => true,
    token: () => `${(counter += 1).toString(16).padStart(4, '0')}${'ab'.repeat(20)}`,
    effects: { mail: async (_row, message) => { mailed.push(message.to[0]); return answer(message); } },
  });
  const grant = calendar.book.grant({ key: 'payment_confirmed:remind', bookable_id: row.id, person_ref: 'person-a', email: 'a@example.org' }).grant;
  const [time] = openTimes(row, { nowMs: NOW });
  calendar.book.book({ grant, start_ms: time.start_ms });
  return {
    calendar, mailed, dueMs: time.start_ms - 1440 * 60000,
    setNow: when => { now = when; },
    due: () => calendar.book.rows('SELECT sent_at, tries, due_ms FROM reminders')[0],
  };
}

test('a reminder the mail refused is not stamped: it is due again 15 minutes on, and stamped once it goes out', async () => {
  let refuse = true;
  const { calendar, dueMs, setNow, due } = reminding(() => (refuse ? { sent: false, error: 'refused' } : { sent: true, id: 'mail-1' }));
  setNow(dueMs + 1);
  await calendar.remind('https://app.example');
  assert.equal(due().sent_at, null, 'a refused reminder is not stamped');
  assert.equal(due().tries, 1);
  assert.equal(due().due_ms, dueMs + 1 + 15 * 60000, 'due again 15 minutes on');
  assert.equal(calendar.book.dueReminders().length, 0, 'not due again yet');
  refuse = false;
  setNow(due().due_ms);
  await calendar.remind('https://app.example');
  assert.notEqual(due().sent_at, null, 'stamped once it went out');
});

test('a retry sends only to the recipient the mail did not reach', async () => {
  let refuseBuyer = true;
  const { calendar, mailed, dueMs, setNow, due } = reminding(message => (refuseBuyer && message.to[0] === 'a@example.org' ? { sent: false, error: 'refused' } : { sent: true, id: 'mail-1' }));
  setNow(dueMs + 1);
  await calendar.remind('https://app.example');
  assert.deepEqual(mailed.splice(0), ['a@example.org', row.host.email], 'both are tried the first time');
  refuseBuyer = false;
  setNow(due().due_ms);
  await calendar.remind('https://app.example');
  assert.deepEqual(mailed.splice(0), ['a@example.org'], 'only the buyer, whom the mail did not reach');
  assert.notEqual(due().sent_at, null);
});

test('a reminder the mail keeps refusing stops after four tries and is not sent again', async () => {
  const { calendar, mailed, dueMs, setNow, due } = reminding(() => ({ sent: false, error: 'refused' }));
  setNow(dueMs + 1);
  for (let attempt = 1; attempt <= 4; attempt += 1) {
    await calendar.remind('https://app.example');
    if (attempt < 4) setNow(due().due_ms);
  }
  assert.equal(due().tries, 4);
  assert.notEqual(due().sent_at, null, 'stamped at the fourth try, so it stops');
  mailed.length = 0;
  setNow(due().due_ms + 60 * 60000);
  await calendar.remind('https://app.example');
  assert.equal(mailed.length, 0, 'no fifth try');
});
