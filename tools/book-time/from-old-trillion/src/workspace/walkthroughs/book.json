{
  "kind": "walkthrough-definition",
  "id": "book",
  "revision": 2,
  "order": 33,
  "title": "Book a session",
  "summary": "You can pick a time for a session, pay for it and see every session you have booked.",
  "entry_step": "intro",
  "progress_style": {
    "style": "segmented"
  },
  "triggers": [
    {
      "reason": "screen-first-opened",
      "on_event": {
        "event_kind": "screen-opened",
