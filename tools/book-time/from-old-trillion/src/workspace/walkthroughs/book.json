          "entry": "guide",
          "screen": "book"
        }
      },
      "once_key": "book",
      "requires": [
        {
          "once_key": "first-run"
        }
      ]
    },
    {
      "reason": "replay",
      "on_event": {
        "event_kind": "walkthrough-requested",
        "match": {
          "walkthrough_id": "book"
        }
      }
    }
  ],
  "steps": [
    {
      "id": "intro",
      "content": {
        "content_kind": "text",
        "payload": {
          "title": "Book a time that suits you",
          "body": "Pick a time and pay, and your session is booked. Every session you have booked is listed here too."
        }
      },
      "target_preparation": {
        "surface": {
          "id": "trillion.book"
        }
      },
      "target_ref": {
        "from": "selector",
        "query": "[data-trillion-screen=\"book\"]"
      },
      "cutout": {
        "shapes": [
          {
            "shape": "rounded-rect",
            "padding": 6,
            "radius": 10
          }
        ]
      },
      "placement": {
        "prefer": "below",
        "auto_flip": true,
        "gap": 14
      },
      "nav": {
        "buttons": [
          {
            "role": "skip",
            "label": "Skip"
          },
          {
            "role": "advance",
            "label": "Show me"
          }
        ]
      },
      "centered_when_target_missing": true
    },
    {
      "id": "times",
      "content": {
        "content_kind": "text",
        "payload": {
          "title": "Pick a time",
          "body": "Choose a session and a time that suits you, then pay to book it. Sessions you booked are listed here too."
        }
      },
      "target_preparation": {
        "surface": {
          "id": "trillion.book"
        }
      },
      "target_ref": {
