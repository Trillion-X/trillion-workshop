          "stdin": { "fill": { "from": "input" } },
          "records": { "fd": 3, "rights": [{ "kind": "booking", "operations": ["records:read", "records:list", "records:write"] }, { "kind": "booking-book", "operations": ["records:read", "records:write"] }] }
        },
        "needs": { "expected_seconds": 3, "network_egress": false },
        "licence_class": "licence:maker-own",
        "placements": ["placement:small-container"],
        "maker": "maker:book-time",
        "result_selector": "$.result",
        "provenance": { "source": "bitfield-packages packages/calendar-booker (request-booking action and booking-status contract), ported to the records door" },
        "verify": [{ "kind": "output-number-within", "output_selector": "$.booking.attendees.length", "at_least": 0 }],
        "record_model": {
          "_what": "The record kinds, indexes and links this tool keeps (moved unchanged from trillion-rust's one record model: src/record_model_policy/record-model.json, src/record_indexes/record-indexes.json, product/lists.json field_kinds and product/record-sharing.json links).",
          "kinds": [
            {
              "type": "availability-reservation",
              "erasable": [
                "recipient_identity",
                "calendar",
                "start_ms",
                "end_ms",
                "occupied_start_ms",
