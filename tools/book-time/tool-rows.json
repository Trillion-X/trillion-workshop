        "id": "tool:request-a-booking",
        "label": "Request a booking",
        "status": "active",
        "job": "Book someone into one of my open times and keep the booking",
        "description": "Checks that the start asked for is an open time (same rules as tool:find-open-times, with the person's own booking records counted), then keeps one booking record. The check and the write are one step, so two people asking for the last seat at once cannot both get it. It starts waiting for payment, waiting for the host to confirm, or booked, as the request says. The same idempotency_key answers the booking already kept and books nothing twice. A time that is not open is refused with the open times that day; a person who already holds a seat at that time is refused a second one.",
        "input_schema": {
          "type": "object",
          "required": ["idempotency_key", "start", "timezone", "windows", "duration_minutes"],
          "additionalProperties": false,
          "properties": {
            "idempotency_key": { "type": "string" },
            "start": { "type": "string", "description": "The start instant, like 2026-08-10T14:30:00Z" },
            "timezone": { "type": "string" },
            "windows": { "type": "array", "items": { "type": "object" }, "description": "The weekly windows, as in tool:find-open-times" },
            "duration_minutes": { "type": "integer", "minimum": 1 },
            "step_minutes": { "type": "integer", "minimum": 1 },
            "buffer_before_minutes": { "type": "integer", "minimum": 0 },
            "buffer_after_minutes": { "type": "integer", "minimum": 0 },
            "min_notice_minutes": { "type": "integer", "minimum": 0 },
            "busy": { "type": "array", "items": { "type": "object", "required": ["start", "end"] } },
            "host_ref": { "type": "string" },
            "booking_type": { "type": "string" },
            "title": { "type": "string" },
            "attendees": { "type": "array", "items": { "type": "object" }, "description": "Who is booked, like { name, email }" },
            "needs_payment": { "type": "boolean", "description": "Start as waiting for payment" },
            "needs_confirmation": { "type": "boolean", "description": "Start as waiting for the host to confirm" },
            "free_statuses": { "type": "array", "items": { "type": "string" } },
            "seats_per_slot": { "type": "integer", "minimum": 1, "description": "How many people may book the same time (1 when left out); one person holds one seat of a time" },
            "per_day_max": { "type": "integer", "minimum": 1, "description": "At most this many bookings start on one day" },
            "horizon_days": { "type": "integer", "minimum": 1, "description": "A time more than this many days from now is not open" },
            "pending_blocks_slot": { "type": "boolean", "description": "Whether a booking waiting for the host to confirm holds its time (true when left out); when false the time is checked again when the host confirms" }
          }
        },
        "output_schema": {
          "type": "object",
          "required": ["already_requested", "booking"],
          "properties": {
            "already_requested": { "type": "boolean" },
            "booking": { "type": "object", "required": ["id", "status", "scheduled_start", "scheduled_end"] }
          }
        },
        "invoke": {
          "kind": "container",
          "files": { "package_files": [
            { "package": "book-time", "paths": ["do-work", "read-data"], "at": "/opt/book-time" },
            { "package": "wall-time", "paths": ["read-data"], "at": "/opt/wall-time" },
            { "package": "records-door", "paths": ["do-work", "read-data"], "at": "/opt/records-door" },
