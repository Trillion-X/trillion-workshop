    {
      "id": "package::book-time::tool::check-when-i-am-busy",
      "address": "package::book-time::tool::check-when-i-am-busy",
      "path": ["current-item", "published-record"],
      "payload": {
        "kind": "ai-tool-descriptor",
        "id": "tool:check-when-i-am-busy",
        "label": "Check when I am busy",
        "status": "active",
        "job": "Read when my own calendar shows me busy between two times",
        "description": "Asks the person's own Google calendar when it is busy between two instants, with the person's own calendar account (the held value calendar-account). Answers the busy intervals, or unknown with the reason when the calendar cannot be read: unknown is never an empty free answer, so offer no times it guessed. Changes nothing.",
        "input_schema": {
          "type": "object",
          "required": ["from", "to"],
          "additionalProperties": false,
          "properties": {
            "from": { "type": "string", "description": "Start instant, like 2026-08-10T00:00:00Z" },
            "to": { "type": "string", "description": "End instant" }
          }
        },
        "output_schema": {
          "type": "object",
          "required": ["status", "busy"],
          "properties": {
            "status": { "type": "string", "description": "read or unknown" },
            "busy": { "type": "array", "items": { "type": "object", "required": ["start", "end"] } },
            "error": { "type": "string" }
          }
        },
        "invoke": {
