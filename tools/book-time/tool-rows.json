    {
      "id": "package::book-time::tool::find-open-times",
      "address": "package::book-time::tool::find-open-times",
      "path": ["current-item", "published-record"],
      "payload": {
        "kind": "ai-tool-descriptor",
        "id": "tool:find-open-times",
        "label": "Find open times",
        "status": "active",
        "job": "Find the times someone can book with me, from my weekly hours, minus what is already booked and what my calendar shows busy",
        "description": "Gives the open start times over one or more days, in the person's time zone. A time is open when it fits wholly inside a weekly window on that weekday, is not a start in the taken list, does not overlap a busy interval (widened by the buffers before and after), and starts after the minimum notice. With use_my_bookings, the person's own booking records count too: a booking fills a seat of the time it starts at and blocks every other time it overlaps (a cancelled booking frees its time); a day closes once per_day_max bookings start on it, and nothing past horizon_days is offered. Windows, lengths, buffers, seats and limits are the person's own: nothing is assumed.",
        "input_schema": {
          "type": "object",
          "required": ["timezone", "windows", "from_date", "duration_minutes"],
          "additionalProperties": false,
          "properties": {
            "timezone": { "type": "string", "description": "The IANA zone the windows are written in, like \"America/Chicago\"" },
            "windows": { "type": "array", "items": { "type": "object", "required": ["weekday", "start", "end"], "properties": { "weekday": { "type": "integer", "minimum": 0, "maximum": 6, "description": "0 is Sunday" }, "start": { "type": "string", "description": "HH:MM in the zone" }, "end": { "type": "string", "description": "HH:MM in the zone, up to 24:00" } } } },
            "from_date": { "type": "string", "description": "The first day, YYYY-MM-DD in the zone" },
            "days": { "type": "integer", "minimum": 1, "maximum": 62, "description": "How many days from from_date (1 when left out)" },
            "duration_minutes": { "type": "integer", "minimum": 1 },
            "step_minutes": { "type": "integer", "minimum": 1, "description": "Spacing between offered starts (the duration when left out)" },
            "buffer_before_minutes": { "type": "integer", "minimum": 0 },
            "buffer_after_minutes": { "type": "integer", "minimum": 0 },
            "min_notice_minutes": { "type": "integer", "minimum": 0, "description": "A time must start this long after now" },
            "taken": { "type": "array", "items": { "type": "string" }, "description": "Start instants already booked, like 2026-08-10T14:30:00Z" },
            "busy": { "type": "array", "items": { "type": "object", "required": ["start", "end"], "properties": { "start": { "type": "string" }, "end": { "type": "string" } } }, "description": "Busy intervals (instants), like those tool:check-when-i-am-busy gives" },
            "use_my_bookings": { "type": "boolean", "description": "Also treat the person's booking records as taken" },
            "host_ref": { "type": "string", "description": "With use_my_bookings: only this host's bookings" },
            "free_statuses": { "type": "array", "items": { "type": "string" }, "description": "Booking statuses that free their time (\"cancelled\" when left out)" },
            "seats_per_slot": { "type": "integer", "minimum": 1, "description": "How many people may book the same time (1 when left out); each time shows the seats left" },
            "per_day_max": { "type": "integer", "minimum": 1, "description": "Once this many bookings start on a day, the rest of that day is not offered" },
            "horizon_days": { "type": "integer", "minimum": 1, "description": "Nothing is offered more than this many days from now" },
            "pending_blocks_slot": { "type": "boolean", "description": "Whether a booking waiting for the host to confirm holds its time (true when left out)" }
          }
        },
        "output_schema": {
          "type": "object",
          "required": ["timezone", "count", "slots"],
          "properties": {
            "timezone": { "type": "string" },
            "count": { "type": "integer" },
            "slots": { "type": "array", "items": { "type": "object", "required": ["start", "end", "date", "time"], "properties": { "start": { "type": "string" }, "end": { "type": "string" }, "date": { "type": "string" }, "time": { "type": "string" }, "seats_left": { "type": "integer" } } } }
          }
        },
        "invoke": {
          "kind": "container",
          "files": { "package_files": [
            { "package": "book-time", "paths": ["do-work", "read-data"], "at": "/opt/book-time" },
            { "package": "wall-time", "paths": ["read-data"], "at": "/opt/wall-time" },
            { "package": "records-door", "paths": ["do-work", "read-data"], "at": "/opt/records-door" },
            {"package": "content-identity", "paths": ["read-data"], "at": "/opt/content-identity"},
            {"module": "@noble/hashes", "paths": ["LICENSE", "package.json", "blake3.js", "blake2.js", "_blake.js", "_md.js", "_u64.js", "utils.js"], "at": "/opt/node_modules/@noble/hashes"}
          ] },
          "workdir": "/opt/book-time",
          "internet": false,
          "stdout": "json",
          "argv": ["node", "/opt/records-door/do-work/run-an-export.mjs", "/opt/book-time/do-work/book-time.mjs", "findOpenTimes"],
          "stdin": { "fill": { "from": "input" } },
          "records": { "fd": 3, "rights": [{ "kind": "booking", "operations": ["records:list"] }] }
        },
        "needs": { "expected_seconds": 3, "network_egress": false },
        "licence_class": "licence:maker-own",
        "placements": ["placement:small-container"],
        "maker": "maker:book-time",
        "result_selector": "$.result",
        "provenance": { "source": "bitfield-packages packages/calendar-booker do-work/derive-open-slots.ts" },
        "verify": [{
          "kind": "sample-run",
          "input": { "timezone": "America/Chicago", "windows": [{ "weekday": 1, "start": "09:00", "end": "11:00" }], "from_date": "2026-08-10", "duration_minutes": 45, "step_minutes": 30 },
          "output_selector": "$.slots[0].time",
          "contains": "09:00"
        }],
        "record_model": {
          "_what": "The record kinds, indexes and links this tool keeps (moved unchanged from trillion-rust's one record model: src/record_model_policy/record-model.json, src/record_indexes/record-indexes.json, product/lists.json field_kinds and product/record-sharing.json links).",
          "kinds": [
            {
              "type": "availability-link",
              "erasable": [
                "title",
                "description",
                "location",
                "alias",
                "calendar",
                "cohosts",
                "timezone",
                "windows",
                "duration_min",
                "step_min",
                "buffer_before_min",
                "buffer_after_min",
                "min_notice_min",
                "horizon_days",
                "expires_at",
                "one_off_slots",
                "preferred_times_snapshot"
              ],
              "erase_with": [
                {
                  "type": "availability-reservation",
                  "index": "by-link",
                  "equal": "{key}"
                }
              ],
              "properties": {
                "id": "text",
                "title": "text",
                "calendar": "object",
                "description": "any",
                "location": "any",
                "alias": "any",
                "cohosts": "objects",
                "timezone": "text",
                "windows": "objects",
                "duration_min": "number",
                "step_min": "number",
                "buffer_before_min": "number",
                "buffer_after_min": "number",
                "min_notice_min": "number",
                "horizon_days": "number",
                "expires_at": "any",
                "one_off_slots": "objects",
                "preferred_times_snapshot": "any",
                "repeat": "boolean",
                "per_grant_max": "any",
                "per_day_max": "any",
                "change_notice_min": "number",
                "video_call": "boolean",
                "seats_per_slot": "any",
                "host_mode": "text",
                "host_weight": "number",
                "requires_confirmation": "boolean",
                "pending_blocks_slot": "boolean",
                "state": "text",
                "created_at": "text",
                "updated_at": "text",
                "revision": "number"
              },
              "_read_by": "parts/calendar-booker personal availability links"
            }
          ]
        }
      }
    },
