      "id": "package::book-time::tool::change-a-booking-status",
      "address": "package::book-time::tool::change-a-booking-status",
      "path": ["current-item", "published-record"],
      "payload": {
        "kind": "ai-tool-descriptor",
        "id": "tool:change-a-booking-status",
        "label": "Change a booking's status",
        "status": "active",
        "job": "Confirm, cancel, complete or mark a booking as a no-show, only in the ways a booking may move",
        "description": "Moves one booking record to a new status: waiting bookings can be confirmed or cancelled, a confirmed one can be completed, marked no-show or cancelled, and a finished one never moves. A cancel keeps its time and reason. Asking for the status it already has changes nothing. A move that is not allowed is refused with the moves that are. Only one answer lands on a waiting booking: two answers at once are kept one after the other, and the second meets the booking as the first left it. A waiting booking whose time has passed can be cancelled but not confirmed, and one that did not hold its time is confirmed only if the time is still open.",
        "input_schema": {
          "type": "object",
          "required": ["booking_id", "to"],
          "additionalProperties": false,
          "properties": {
            "booking_id": { "type": "string" },
            "to": { "type": "string", "description": "The new status, like confirmed or cancelled" },
            "reason": { "type": "string", "description": "Kept with a cancel" }
          }
        },
        "output_schema": {
          "type": "object",
          "required": ["changed", "booking"],
          "properties": {
            "changed": { "type": "boolean" },
            "booking": { "type": "object", "required": ["id", "status"] }
          }
        },
        "invoke": {
          "kind": "container",
          "files": { "package_files": [
            { "package": "book-time", "paths": ["do-work", "read-data"], "at": "/opt/book-time" },
            { "package": "wall-time", "paths": ["read-data"], "at": "/opt/wall-time" },
