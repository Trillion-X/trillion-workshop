              "type": "availability-reservation-hold",
              "erase_fields": [
                "calendar",
                "calendar_identity",
                "occupied_start_ms",
                "occupied_end_ms",
                "occupied_start_sort_key",
                "occupied_end_sort_key"
              ],
              "properties": {
                "id": "text",
                "reservation_id": "text",
                "calendar": "object",
                "calendar_identity": "text",
                "interval_kind": "text",
                "occupied_start_ms": "number",
                "occupied_end_ms": "number",
                "occupied_start_sort_key": "text",
                "occupied_end_sort_key": "text",
                "state": "text",
                "updated_at": "text"
