        "kind": "ai-tool-descriptor",
        "id": "tool:plan-sorting-youtube-watch-later-into-playlists",
        "label": "Plan which playlist each Watch Later video goes in",
        "job": "Sort my YouTube Watch Later into playlists: plan which playlist each video goes in",
        "description": "Places each video of one or more channels' Watch Later into the playlists the person's sort settings name, and writes nothing to YouTube. A channel is sorted by rules (a channel-name expression scores 3, a strong title expression 3, a weak one 1; a video goes to every playlist scoring 3 or more, at most max_per_video, else to its best weak match marked low confidence; titles matching hold_back are kept off public playlists with hold_back_reason) or by hand-made lists kept in their order. Within a rules playlist, videos are ordered by views, highest first. The answer is the plan and a summary per channel; with out_dir it also writes sort-plan.json and SORT-PLAN.md, the page to show the person before anything is made.",
        "status": "active",
        "input_schema": {
          "type": "object",
          "anyOf": [{ "required": ["settings_record"] }, { "required": ["settings"] }],
          "properties": {
            "settings_record": {
              "type": ["object", "string"],
              "description": "The person's sort settings row, record:setting:sort-youtube-watch-later-into-playlists~<scope_kind>~<scope_id> in their list:settings, exactly as their own store holds it ({id, type: \"record:setting\", value: {name, tool, scope_kind, scope_id, settings, from, status}}), or the path of a JSON file holding it (a list of rows too, with person naming whose). Read and checked by the shared reader in tools/settings; its tool is this row's id and its settings field holds what settings would."
            },
            "person": { "type": "string", "description": "The scope_id of the person whose row to use when settings_record holds several." },
            "settings": {
              "type": "object",
              "required": ["channels"],
              "description": "The sort settings inline, for a sample run or a test, when no settings_record is given: {\"channels\": [{\"slug\", \"label\", \"email\", \"sign_in_as\", \"authuser\", \"page_id\", \"sort\": \"rules\"|\"hand-made\", \"rules\": {\"max_per_video\", \"hold_back\", \"hold_back_reason\", \"rules\": [{\"key\", \"title\", \"description\", \"channels\", \"strong\", \"weak\"}]}, \"playlists\": [{\"key\", \"title\", \"description\", \"videos\": [[video id, reason]]}]}]}. A channel without sort is only read, never sorted.",
              "properties": { "channels": { "type": "array", "items": { "type": "object", "required": ["slug", "label"] } } }
            },
            "watch_later": { "type": "object", "description": "{slug: [videos]} for each sorted channel, each video {id, url, title, channel, views}, as read_channel.py writes them." },
            "accounts_dir": { "type": "string", "description": "A folder holding <slug>/watch-later.json, used for a channel watch_later does not give." },
            "out_dir": { "type": "string", "description": "Where to write sort-plan.json and SORT-PLAN.md; without it the plan is in the answer." },
            "generated": { "type": "string", "description": "The time the plan says it was made (default: now)." }
          }
        },
        "output_schema": {
          "type": "object",
          "required": ["summary"],
          "properties": {
            "summary": { "type": "array", "items": { "type": "object", "required": ["channel", "watch_later", "unsorted", "held_back", "playlists"] } },
            "plan": { "type": "object", "required": ["generated", "accounts"] },
            "plan_file": { "type": "string" },
            "plan_page": { "type": "string" }
          }
        },
        "invoke": {
          "kind": "computer",
          "capabilities": [],
          "workdir": "/opt/sort-youtube-watch-later-into-playlists",
          "stdout": "json",
          "run": ["python3", "/opt/sort-youtube-watch-later-into-playlists/do-work/plan_sort.py"],
          "stdin": { "fill": { "from": "input" } },
          "files": {
            "package_files": [
              { "package": "sort-youtube-watch-later-into-playlists", "paths": ["do-work", "read-data"], "at": "/opt/sort-youtube-watch-later-into-playlists" },
              { "package": "settings", "paths": ["read-data/settings.py"], "at": "/opt/settings" }
            ]
          }
        },
        "verify": [
          {
            "kind": "sample-run",
            "input": {
              "settings": {
                "channels": [
                  {
                    "slug": "kitchen",
                    "label": "Kitchen Channel",
                    "sort": "rules",
                    "rules": {
                      "max_per_video": 2,
                      "hold_back": "(Secret Recipe)",
                      "hold_back_reason": "kept off public playlists",
                      "rules": [
                        { "key": "bread", "title": "Bread Baking", "description": "Loaves.", "channels": "^(Crumb Club)", "strong": "(sourdough)", "weak": "(flour)" }
                      ]
                    }
                  },
                  { "slug": "watch-only", "label": "Watch Only" }
                ]
              },
              "watch_later": {
                "kitchen": [
                  { "id": "v1", "url": "https://www.youtube.com/watch?v=v1", "title": "Easy sourdough", "channel": "Crumb Club", "views": "1K views" },
                  { "id": "v2", "url": "https://www.youtube.com/watch?v=v2", "title": "Which flour", "channel": "Someone", "views": "10 views" },
                  { "id": "v3", "url": "https://www.youtube.com/watch?v=v3", "title": "The Secret Recipe", "channel": "Someone", "views": "5 views" }
                ]
              },
              "generated": "2026-01-01T00:00:00"
            }
          }
        ],
        "result_selector": "$.result",
        "maker": "maker:sort-youtube-watch-later-into-playlists",
        "licence_class": "licence:maker-own",
        "placements": ["placement:your-computer"]
      }
    },
