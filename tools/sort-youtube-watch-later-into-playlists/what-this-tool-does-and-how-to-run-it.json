            "applied_file": { "type": "string", "description": "Where what was made is kept (read, then updated)." },
            "only_slug": { "type": "string" },
            "only_title": { "type": "string" },
            "limit_playlists": { "type": "integer" },
            "batch": { "type": "integer", "description": "Videos per add (default 25)." }
          }
        },
        "output_schema": {
          "type": "object",
          "description": "The last line: {\"result\": {\"playlists\": [{\"slug\", \"title\", \"id\", \"created\", \"reused\", \"planned\", \"added_now\"}]}} or {\"error\": \"what to change\"}."
