        "kind": "ai-tool-descriptor",
        "id": "tool:see-what-holds-me",
        "label": "See what holds me",
        "status": "active",
        "job": "Tell me whether my setup still has to be finished before anything else opens, and which one thing I must do now",
        "description": "Reads your setup steps (record:setup-steps rows, or the Get started answer you send as setup), your must-do list (record:waiting-on-you rows) and your hold setting, and answers cover { covered, key }: true while any required step is not done (the page draws only setup until then), null when nothing says, and key, the name your gate row gives the cover (required-setup when it gives none, so a missing key never leaves everything open). Beside it, hold: the one row that unblocks the most by your rank rules, every row that may hold in that order, how many times it can still be set aside today, the ways to hand it back and the stakes for turning the hold off. While the cover stands nothing else is held. It reads and changes nothing.",
        "input_schema": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "setup": {
              "type": "object",
              "description": "The Get started answer (ready, policy and requirements, or progress) to use instead of your setup step rows"
            },
            "gate": {
              "type": "object",
              "description": "Your gate row ({ key }) to use instead of setting:required_setup_gate"
            },
            "rules": {
              "type": "object",
              "description": "The hold rules (after_minutes, every_seconds, rank, aside, hand_back, off, words), to use instead of the person's setting:needs_you_hold_rules row"
            },
            "things": {
              "type": "object",
              "description": "{ sections: [{ id, hold?, batch?, cards: [...] }], finishes? } to use instead of your must-do rows"
            },
            "section": {
              "type": "object",
              "description": "The section your must-do rows are cards of ({ id, title, finish, ... })"
            },
            "state": {
              "type": "object",
              "description": "Your hold setting to use instead of setting:needs_you_hold"
            },
            "opens_screens": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Address starts that open one of your screens; a row done in a place outside them holds only with another control"
            },
            "now": {
              "type": "string",
              "description": "The time to decide at (ISO); now when left out"
            }
          }
        },
        "output_schema": {
          "type": "object",
          "required": [
            "cover",
            "hold"
          ],
          "properties": {
            "cover": {
              "type": "object",
              "required": [
                "covered",
                "key"
              ],
              "properties": {
                "covered": {
                  "type": [
                    "boolean",
                    "null"
                  ]
                },
                "key": {
                  "type": "string"
                }
              }
            },
            "hold": {
              "type": "object",
              "required": [
                "on",
                "held",
                "ranked",
                "asides_left",
                "hand_back",
                "stakes"
              ]
            }
          }
        },
        "invoke": {
          "kind": "container",
          "files": {
            "package_files": [
              {
                "package": "hold-one-thing-until-done",
