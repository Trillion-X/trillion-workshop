              "type": "object",
              "description": "Consent records by section id for the shared doer gate."
            },
            "things": {
              "type": "object",
              "description": "Full authoritative waiting answer; preserves every source section and finish control."
            }
          }
        },
        "output_schema": {
          "type": "object",
          "required": [
            "status",
            "body"
          ],
          "properties": {
            "status": {
              "type": "integer"
            },
            "body": {}
          }
        },
