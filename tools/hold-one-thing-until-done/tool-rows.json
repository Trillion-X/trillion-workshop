      "payload": {
        "kind": "ai-tool-descriptor",
        "id": "tool:change-what-holds-me",
        "label": "Change what holds me",
        "status": "active",
        "job": "Set the one thing I must do aside with a reason, hand it back to my AIs, choose what turning the hold off costs me, ask to turn it off, or turn it back on",
        "description": "Changes your hold setting (setting:needs_you_hold) by your hold rules: set-aside needs a reason of the rules' length and lasts the rules' minutes, a few times a day; hand-back gives the rest of the thing to your AIs by one of the rules' ways and leaves the hold; choose-stake picks what turning off costs, in force once the stake before it has run its delay; turn-off takes effect only after the stake's delay and comes back by itself; turn-on is at once. One write of the whole setting, only while it is still what was read: a setting changed meanwhile answers conflict and changes nothing, and the same request_key sent again changes nothing twice. Answers the jobs to hand to your AIs (it sends nothing) and the setting as written.",
        "input_schema": {
          "type": "object",
          "required": [
            "change",
            "request_key"
          ],
          "additionalProperties": false,
          "properties": {
            "change": {
              "type": "string",
              "enum": [
                "set-aside",
                "hand-back",
                "choose-stake",
                "turn-off",
                "turn-on"
              ]
            },
            "request_key": {
              "type": "string",
              "description": "Names this one change"
            },
            "key": {
              "type": "string",
              "description": "The held thing's key (set-aside, hand-back)"
            },
            "title": {
              "type": "string",
              "description": "The held thing's title, for the AIs' job"
            },
            "reason": {
              "type": "string",
              "description": "Why, in your words (set-aside, hand-back)"
            },
            "way": {
              "type": "string",
              "description": "One of the rules' hand-back ways (hand-back)"
            },
            "stake": {
              "type": "string",
              "description": "One of the rules' stakes (choose-stake)"
            },
            "values": {
              "type": "object",
              "description": "The values the stake's fields ask for (choose-stake)"
            },
            "rules": {
              "type": "object",
              "description": "The hold rules (after_minutes, every_seconds, rank, aside, hand_back, off, words), to use instead of the person's setting:needs_you_hold_rules row"
            },
            "now": {
              "type": "string",
              "description": "The time to change at (ISO); now when left out"
            }
