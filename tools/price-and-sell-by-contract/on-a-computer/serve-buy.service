[Unit]
Description={description}
After=network-online.target
Wants=network-online.target

[Service]
# STRIPE_SECRET_KEY is the value held under the vault name {secret_vault_key}: start-a-computer seals it for this computer
# (systemd-creds) at {secret_file}; this unit names only where. The server reads it from the credential at start and sends it
# in the Authorization header of its own Checkout requests.
LoadCredentialEncrypted={secret_name}:{secret_file}
Environment=BUY_SETTINGS={settings_file}
Environment=PATH={node_bin}:/usr/bin:/bin
Type=simple
User={user}
Group={user}
# The Workshop copy at {workshop} stays between starts: the row's pinned commit {workshop_commit} is fetched into it (only what
# the copy lacks) and checked out. This tool has no installed packages, so nothing is installed at start.
ExecStartPre=/bin/sh -c 'test -d {workshop}/.git || git init -q {workshop}'
ExecStartPre=/bin/sh -c 'git -C {workshop} fetch -q --depth 1 {repository} {workshop_commit} && git -C {workshop} checkout -q --detach {workshop_commit}'
ExecStart=/bin/sh -c 'cd {workshop}/{tool_folder} && STRIPE_SECRET_KEY="$(cat "$CREDENTIALS_DIRECTORY/{secret_name}")" && export STRIPE_SECRET_KEY && exec node on-a-computer/serve-buy.mjs'
Restart=on-failure
RestartSec=3
KillSignal=SIGTERM
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths={writable}
ProtectHome=true
PrivateTmp=true
LimitCORE=0

[Install]
WantedBy=multi-user.target
