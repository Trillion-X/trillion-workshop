        "kind": "ai-tool-descriptor",
        "id": "tool:check-a-sites-act-against-its-rows",
        "label": "Check a site's act against its rows",
        "job": "Say how the tools a site's own key may run differ from the ones its rows ask for now",
        "description": "A site's act (the tools its own key may run, a computer row's vault reader whose act is given as { derive_from }) is made from the site's rows when the computer row is applied. This derives it again from the rows as they are now, the same way and at the same Workshop commit (the act's pin, unpacked from the granted Workshop folder), and compares it with the act the row last applied. It answers same; widened (tools, held names, identity or journal the rows now ask for that the applied act does not give, with the rows asking for each), which needs a person and is never applied on its own; narrowed (what the applied act gives that the rows no longer ask for), which may be applied; refused (calls no grant can let the site make as written); needs_a_person and narrowed_only; and difference_id, the BLAKE3 identity of what differs. It reads the computer's row and the site's rows through tool:run-sql-in-my-database by the held connections the row names, and writes nothing.",
        "status": "active",
        "read_only": true,
        "result_selector": "$",
        "input_schema": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "computer",
            "uid",
            "store"
          ],
          "properties": {
            "computer": {
              "type": "string",
              "minLength": 1,
              "description": "The computer row's name."
            },
            "uid": {
              "type": "integer",
              "description": "The uid of the vault reader whose act is checked (the site program's own account)."
            },
            "store": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._-]+$",
              "description": "The held connection of the database the computer rows are kept in."
            }
          }
        },
        "output_schema": {
          "type": "object",
          "required": [
            "same",
            "needs_a_person",
            "narrowed_only",
            "widened",
            "narrowed",
            "refused",
            "difference_id"
          ],
          "properties": {
