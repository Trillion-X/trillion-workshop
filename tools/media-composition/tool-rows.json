        "states": [
         "idle",
         "recording"
        ]
       },
       "message": {
        "session": "session-sample",
        "device": "camera-one",
        "type": "join",
        "role": "primary"
       }
      },
      "output_selector": "$.session.primary",
      "contains": "camera-one"
     }
    ]
