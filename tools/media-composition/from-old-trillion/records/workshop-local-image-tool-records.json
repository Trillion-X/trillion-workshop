{
  "kind": "package-set-records",
  "package_set": "trillion",
  "record_set": "workshop-local-image-tool-records",
  "what_this_is": "The two image tools that run MFLUX on the person's own Apple Silicon Mac through the app job owner (tool:run-an-app-job, with the mflux app declared in tools/media-composition/do-work/apps-here.json): tool:generate-local-image and tool:edit-local-image. Moved here from the connect-a-service folder, whose job is connections, not pictures.",
  "records": [
    {
      "id": "package::ai-tool-catalog::tool::generate-local-image",
      "address": "package::ai-tool-catalog::tool::generate-local-image",
      "path": [
        "current-item",
        "published-record"
      ],
      "payload": {
        "kind": "ai-tool-descriptor",
        "id": "tool:generate-local-image",
        "listed_on": "2026-10-11T08:48:59.646Z",
        "label": "Generate an image locally",
        "job": "Generate an original image from a visual brief with your chosen local image model, for an article hero, thumbnail or illustration",
        "description": "Runs MFLUX on your Apple Silicon Mac through its public, MIT-licensed MCP server. Uses your computer for inference. The selected model is explicit; no paid provider or Trillion inference fallback. First use downloads that model. Returns the completed PNG in your files.",
        "status": "active",
        "input_schema": {
          "type": "object",
          "required": [
            "brief",
            "model"
          ],
          "additionalProperties": false,
          "properties": {
            "brief": {
              "type": "string",
              "minLength": 10,
              "maxLength": 6000,
              "description": "Describe the picture or requested edit. Include the scene and visual style; never copy a page title or subtitle into the image."
            },
            "model": {
              "type": "string",
              "minLength": 1,
              "description": "The local model name you chose, from the available local image models. Its weight license must permit this use."
            },
            "steps": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            },
            "seed": {
              "type": "integer",
              "minimum": 0
            },
            "quantize": {
              "type": "integer",
              "enum": [
                4,
                8
              ]
            },
            "width": {
              "type": "integer",
              "minimum": 256,
              "maximum": 2048
            },
            "height": {
              "type": "integer",
              "minimum": 256,
              "maximum": 2048
            }
          }
        },
        "output_schema": {
          "type": "object",
          "required": [
            "ok",
            "files"
          ],
          "properties": {
            "ok": {
              "const": true
            },
            "files": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": [
                  "identity",
                  "bytes",
                  "media_type"
                ],
                "properties": {
                  "identity": {
                    "type": "string",
                    "pattern": "^1f:[a-f0-9]{64}$"
                  },
                  "bytes": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "media_type": {
                    "const": "image/png"
                  }
                }
              }
            }
          }
        },
        "invoke": {
          "kind": "computer-tool",
          "tool_id": "tool:run-an-app-job",
          "input": {
            "app": "mflux",
            "operation": "generate_image",
            "arguments": {
              "prompt": {
                "fill": {
                  "from": "input",
                  "field": "brief"
                }
              },
              "model": {
                "fill": {
                  "from": "input",
                  "field": "model"
                }
              },
              "steps": {
                "fill": {
                  "from": "input",
                  "field": "steps"
                }
              },
              "seed": {
                "fill": {
                  "from": "input",
                  "field": "seed"
                }
              },
              "quantize": {
                "fill": {
                  "from": "input",
                  "field": "quantize"
                }
              },
              "backend": "thread",
              "timeout": 900,
              "output_path": {
                "output_file": "image"
              },
              "width": {
                "fill": {
                  "from": "input",
                  "field": "width"
                }
              },
              "height": {
                "fill": {
                  "from": "input",
                  "field": "height"
                }
              }
            },
            "files": {
              "inputs": [],
              "outputs": [
                {
                  "key": "image",
                  "name": "image.png",
                  "media_type": "image/png"
                }
              ]
            }
          }
        },
        "needs": {
          "expected_seconds": 300,
          "priority": 6,
          "network_egress": true
        },
        "licence_class": "licence:maker-own",
        "placements": [
          "placement:your-computer"
        ],
        "maker": "maker:media-composition",
        "verify": [
          {
            "kind": "output-number-within",
            "output_selector": "$.files[0].bytes",
            "at_least": 1
          }
        ],
        "provenance": {
          "repository": "https://github.com/alampros/mflux-mcp",
          "commit": "caa3fc3a928039357678d29cf89dd16c473fa8da",
          "licence": "MIT",
          "dependency": {
            "repository": "https://github.com/filipstrand/mflux",
            "release": "v.0.22.0",
            "licence": "MIT"
          },
          "execution": "customer-local",
          "owner": "tool:run-an-app-job"
        }
      }
    },
    {
