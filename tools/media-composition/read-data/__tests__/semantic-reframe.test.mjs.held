import test from 'node:test';
import assert from 'node:assert/strict';
import fs from 'node:fs/promises';
import os from 'node:os';
import path from 'node:path';
import {execFileSync} from 'node:child_process';
import {semanticReframe,semanticTrackToReframe} from '../../do-work/semantic-reframe.mjs';
const sample=(t,cx,method='face')=>({t,cx,cy:.4,confidence:method==='center'?0:1,method});
const result=track=>({kind:'subject_track.v1',detector:'fixture',track});

test('semantic samples use existing reframe format with explicit gaps and no identity claim',()=>{
 const output=semanticTrackToReframe(result([sample(0,.2),sample(.5,.3),sample(1,.5,'center')]),{aspectW:4,aspectH:5});
 assert.deepEqual(output.reframe,{aspect_w:4,aspect_h:5,track:[{t:0,cx:.2,cy:.4},{t:.5,cx:.3,cy:.4},{t:1,cx:.5,cy:.4}]});
 assert.equal(output.support.semantic_samples,2);assert.equal(output.support.fallback_samples,1);assert.equal(output.support.identity_tracking_verified,false);
});
test('brightness/motion, invalid coordinates and reordered samples cannot masquerade as semantic output',()=>{
 for(const track of [[sample(0,.2,'motion')],[sample(0,NaN)],[sample(0,2)],[sample(1,.2),sample(0,.3)],[sample(0,.2),sample(0,.3)]])assert.throws(()=>semanticTrackToReframe(result(track)),/invalid or non-semantic/);
});
test('manual override skips unavailable detector and cancellation remains authoritative',async()=>{
 const manual={aspect_w:9,aspect_h:16,track:[{t:0,cx:.2,cy:.3}]};
 const output=await semanticReframe('/missing',{python:'/missing',manualReframe:manual});assert.deepEqual(output.reframe,manual);assert.notEqual(output.reframe,manual);
 await assert.rejects(semanticReframe('/missing',{manualReframe:manual,signal:AbortSignal.abort(new Error('Stopped'))}),/Stopped/);
});
test('unbounded and invalid source ranges reject before invoking a runtime',async()=>{
 for(const range of [{},{start:-1,end:1},{start:2,end:1},{start:0,end:Infinity},{start:NaN,end:1}])await assert.rejects(semanticReframe('/missing',{python:'/missing',...range}),/source start\/end/);
});
test('real installed detector does not mistake a bright synthetic block for a face',async t=>{
 const root=await fs.mkdtemp(path.join(os.tmpdir(),'semantic-fixture-'));t.after(()=>fs.rm(root,{recursive:true,force:true}));
 const file=path.join(root,'fixture.mp4');
 execFileSync('/opt/homebrew/bin/ffmpeg',['-v','error','-y','-f','lavfi','-i','color=black:s=320x180:r=12:d=1','-vf','drawbox=x=20:y=10:w=70:h=120:color=white:t=fill','-c:v','libx264',file]);
 const output=await semanticReframe(file,{start:0,end:1,fps:4,timeoutMs:30000});
 assert.equal(output.support.subject_detected,false);assert.ok(output.support.total_samples>=3);assert.equal(output.support.fallback_samples,output.support.total_samples);assert.ok(output.samples.every(p=>p.method==='center'&&p.cx===.5&&p.cy===.5));
});
test('installed detector finds public-domain astronaut face only inside the requested source cut',async t=>{
 const root=await fs.mkdtemp(path.join(os.tmpdir(),'semantic-face-'));t.after(()=>fs.rm(root,{recursive:true,force:true}));
 const file=path.join(root,'face.mp4');
 // Read the already-installed sample directly: no skimage fetch/download path.
 const astronaut='/opt/homebrew/anaconda3/lib/python3.10/site-packages/skimage/data/astronaut.png';
 execFileSync('/opt/homebrew/bin/ffmpeg',['-v','error','-y','-loop','1','-i',astronaut,'-t','3','-vf','scale=512:512,pad=1024:512:0:0:black','-r','12','-c:v','libx264','-pix_fmt','yuv420p',file]);
 const output=await semanticReframe(file,{start:1.5,end:2.5,fps:4,timeoutMs:30000});
 assert.equal(output.support.subject_detected,true);assert.equal(output.support.fallback_samples,0);assert.equal(output.support.total_samples,4);
 assert.deepEqual(output.samples.map(p=>p.t),[0,.25,.5,.75]);assert.ok(output.samples.every(p=>p.method==='face'&&p.cx<.3));
 assert.deepEqual(output.reframe.track.map(p=>p.t),[0,.25,.5,.75]);
 await assert.rejects(semanticReframe(file,{start:9,end:10,timeoutMs:30000}),/no decodable frames|cannot seek/);
});
