// Effect-capability primitive (do-work/effect-registry.mjs): the registry the blind compositor
// dispatches to by SELF-DESCRIBING DATA (L090), never a kind enum. Proves the compute capabilities,
// the `template` Johnny path (a new effect = a DATA record, zero compositor code), and the
// field-presence dispatch of resolveEffectFragment (template shape vs effect_id shape).
import { test } from 'node:test';
import assert from 'node:assert/strict';
import { createKeyframeEffects, resolveTemplateEffect, resolveEffectFragment, sampleEnvelope, buildEffectCatalog, validateEffectStack, VIZ_PRODUCERS, createEffectProducers, createComputeEffects, createPulseEffects, colorAdjustFragment, createStabilizeEffect } from '../../do-work/effect-registry.mjs';

const REG = createKeyframeEffects({ fpsNum: 30, zoompanFilter: (z) => `zoompan[${z}]` });
const compileEnvelope = (pts) => `if(lt(__T__,${pts[pts.length - 1]?.t ?? 0}),0,${pts[pts.length - 1]?.value ?? 0})`;

test('createKeyframeEffects returns the compute capabilities (opacity/volume/zoom/rotate)', () => {
  assert.deepEqual(Object.keys(REG).sort(), ['opacity', 'rotate', 'volume', 'zoom']);
  assert.equal(REG.opacity.stream, 'video');
  assert.equal(REG.volume.stream, 'audio');
  assert.match(REG.rotate.filter('if(lt(__T__,1),0,90)'), /^rotate='\(if\(lt\(t,1\),0,90\)\)\*PI\/180':c=black/);
});

test('resolveTemplateEffect substitutes ${param}/${ctx} placeholders (the Johnny path)', () => {
  assert.equal(resolveTemplateEffect('hflip'), 'hflip');
  assert.equal(resolveTemplateEffect('boxblur=${strength}', { strength: 4 }), 'boxblur=4');
  assert.equal(resolveTemplateEffect('scale=${W}:${H}', { W: 1920, H: 1080 }), 'scale=1920:1080');
  assert.equal(resolveTemplateEffect('eq=${missing}'), 'eq=${missing}');
});

test('resolveEffectFragment dispatches by field presence, not a kind enum; returns {stream, fragments[]}', () => {
  // template shape -> a DATA fragment on the declared stream (video default)
  const t = resolveEffectFragment({ template: 'hflip' }, { keyframeEffects: REG, compileEnvelope, vars: {} });
  assert.deepEqual(t, { stream: 'video', fragments: ['hflip'] });
  const ta = resolveEffectFragment({ template: 'volume=0.5', stream: 'audio' }, { keyframeEffects: REG, compileEnvelope, vars: {} });
  assert.equal(ta.stream, 'audio');
  // effect_id shape -> a keyframe-envelope capability, its own stream
  const c = resolveEffectFragment({ effect_id: 'rotate', points: [{ t: 0, value: 0 }, { t: 2, value: 90 }] },
    { keyframeEffects: REG, compileEnvelope, vars: {} });
  assert.equal(c.stream, 'video');
  assert.match(c.fragments[0], /^rotate=/);
});

test('resolveEffectFragment: compute shape reaches ALL 33 compute effects (the emergent ordered-stacking unlock)', () => {
  const round3 = (n) => Math.round(n * 1000) / 1000;
  const CE = createComputeEffects({ round3, W: 1920, H: 1080, safeColor: (c, d) => c || d, colorToRgb255: () => [0, 0, 0], fpsNum: 30, FPS: '24000/1001' });
  const ctx = { keyframeEffects: REG, computeEffects: CE, compileEnvelope, timing: { duration: 5 }, vars: {} };
  // a scalar compute effect (params.amount) -> 1 fragment, video stream
  const s = resolveEffectFragment({ compute: 'sharpen', params: { amount: 0.5 } }, ctx);
  assert.deepEqual(s, { stream: 'video', fragments: ['unsharp=5:5:1'] });
  // an object compute effect
  assert.match(resolveEffectFragment({ compute: 'glow', params: { strength: 0.5 } }, ctx).fragments[0], /^split=2\[glowbase\]/);
  // a timing-dependent compute effect resolves timing from the node OR the ambient timing
  assert.ok(resolveEffectFragment({ compute: 'spotlight', params: { strength: 0.8, track: [{ at: 0, cx: 0.2, cy: 0.3 }, { at: 1, cx: 0.8, cy: 0.7 }] } }, ctx).fragments[0].includes('eval=frame'));
  // an ARRAY-returning compute effect -> N fragments (strobe -> 2)
  assert.equal(resolveEffectFragment({ compute: 'strobe', params: { rate: 8 } }, ctx).fragments.length, 2);
  // a NEUTRAL/null compute effect -> 0 fragments (hue_shift neutral)
  assert.deepEqual(resolveEffectFragment({ compute: 'hue_shift', params: { degrees: 0, cycleRate: 0, saturation: 1 } }, ctx).fragments, []);
});

test('LOOK_STACKS: named multi-effect presets are DATA arrays resolvable through the ordered list', async () => {
  const { LOOK_STACKS, resolveLookStack } = await import('../../do-work/effect-registry.mjs');
  const round3 = (n) => Math.round(n * 1000) / 1000;
  const CE = createComputeEffects({ round3, W: 1920, H: 1080, safeColor: (c, d) => c || d, colorToRgb255: () => [0, 0, 0], fpsNum: 30, FPS: '24000/1001' });
  const ctx = { keyframeEffects: REG, computeEffects: CE, compileEnvelope, timing: { duration: 5 }, vars: {} };
  // resolveLookStack: known -> the array, unknown/absent -> [] (never throws)
  assert.equal(resolveLookStack('vhs').length, 4);
  assert.deepEqual(resolveLookStack('nope'), []);
  assert.deepEqual(resolveLookStack(undefined), []);
  // every node of every preset resolves through the ONE dispatcher (a preset is just an authored stack)
  for (const [name, stack] of Object.entries(LOOK_STACKS)) {
    assert.ok(Array.isArray(stack) && stack.length >= 2, `${name} is a multi-effect stack`);
    for (const node of stack) {
      const r = resolveEffectFragment(node, ctx);
      assert.ok(Array.isArray(r.fragments), `${name} node resolves to fragments[]`);
    }
  }
  // vhs is genuinely multi-effect: compute + an opaque template in one preset (not expressible as one grade)
  assert.ok(LOOK_STACKS.vhs.some((n) => n.compute) && LOOK_STACKS.vhs.some((n) => n.template));
});

test('resolveEffectFragment: EMERGENT-4 per-effect param keyframing (param_envelopes) sampled into enable-gated steps', () => {
  const round3 = (x) => Math.round(Number(x) * 1000) / 1000;
  const CE = createComputeEffects({ round3, W: 1920, H: 1080, safeColor: (c, d) => c || d, colorToRgb255: () => [0, 0, 0], fpsNum: 30, FPS: '24000/1001' });
  const ctx = { keyframeEffects: REG, computeEffects: CE, compileEnvelope };

  // static params is byte-identical to a direct compute call (unchanged flat path)
  const direct = CE.color_adjust({ brightness: 0.2 });
  const staticFrags = resolveEffectFragment({ compute: 'color_adjust', params: { brightness: 0.2 } }, ctx).fragments;
  assert.deepEqual(staticFrags, Array.isArray(direct) ? direct : [direct]);

  // a brightness envelope 0.1 -> 0.4 over dur=3 with 3 steps yields 3 single-filter enable-gated fragments
  const kf = resolveEffectFragment(
    { compute: 'color_adjust', param_envelopes: { brightness: [{ t: 0, value: 0.1 }, { t: 3, value: 0.4 }] }, steps: 3 },
    { ...ctx, timing: { duration: 3 } },
  ).fragments;
  assert.equal(kf.length, 3);
  assert.deepEqual(kf, [
    "eq=brightness=0.15:enable='between(t,0,1)'",
    "eq=brightness=0.25:enable='between(t,1,2)'",
    "eq=brightness=0.35:enable='between(t,2,3)'",
  ]);

  // sampleEnvelope numeric: linear midpoint + hold
  assert.equal(sampleEnvelope([{ t: 0, value: 0.2 }, { t: 2, value: 0.8 }], 1), 0.5);
  assert.equal(sampleEnvelope([{ t: 0, value: 0.2, interp: 'linear' }, { t: 2, value: 0.8, interp: 'hold' }], 1), 0.2);

  // fail closed: no duration, and a multi-filter chain cannot be single-enable-gated
  assert.throws(() => resolveEffectFragment({ compute: 'color_adjust', param_envelopes: { brightness: [{ t: 0, value: 0.1 }, { t: 1, value: 1 }] } }, ctx), /positive timing.duration/);
  assert.throws(() => resolveEffectFragment({ compute: 'zoom_blur', param_envelopes: { strength: [{ t: 0, value: 0.2 }, { t: 1, value: 0.9 }] }, steps: 2 }, { ...ctx, timing: { duration: 1 } }), /multi-filter chain/);
});

test('EMERGENT-5: buildEffectCatalog self-describes the live vocabulary; validateEffectStack dry-run checks an authored stack', () => {
  const round3 = (x) => Math.round(Number(x) * 1000) / 1000;
  const CE = createComputeEffects({ round3, W: 1920, H: 1080, safeColor: (c, d) => c || d, colorToRgb255: () => [0, 0, 0], fpsNum: 30, FPS: '24000/1001' });
  const cat = buildEffectCatalog({ computeEffects: CE, keyframeEffects: REG });
  // catalog is DERIVED from the live maps (no drift): every compute id in the map is advertised, and vice versa
  assert.deepEqual(cat.compute_effects, Object.keys(CE).sort());
  assert.deepEqual(cat.keyframe_effects, ['opacity', 'rotate', 'volume', 'zoom']);
  assert.ok(cat.looks.includes('vhs') && cat.looks.includes('cinematic-bloom'));
  assert.equal(cat.node_shapes.length, 3);

  const opts = { computeEffects: CE, keyframeEffects: REG };
  // a valid agent-authored stack (compute + template + keyframe) passes
  assert.deepEqual(validateEffectStack([
    { compute: 'glow', params: { strength: 0.6 } },
    { template: 'eq=saturation=1.2' },
    { effect_id: 'opacity', points: [{ t: 0, value: 1 }] },
    { compute: 'color_adjust', param_envelopes: { brightness: [{ t: 0, value: 0 }, { t: 1, value: 0.3 }] } },
  ], opts), { ok: true, errors: [] });
  // bad stacks are rejected WITHOUT throwing, with per-index reasons
  assert.equal(validateEffectStack('nope', opts).ok, false);
  assert.match(validateEffectStack([{ compute: 'not_a_real_effect' }], opts).errors[0].message, /unknown compute effect/);
  assert.match(validateEffectStack([{ effect_id: 'nope' }], opts).errors[0].message, /unknown effect_id/);
  assert.match(validateEffectStack([{ foo: 1 }], opts).errors[0].message, /no capability field/);
  assert.match(validateEffectStack([{ compute: 'glow', template: 'hflip' }], opts).errors[0].message, /multiple capability fields/);
  assert.match(validateEffectStack([{ compute: 'glow', param_envelopes: [] }], opts).errors[0].message, /param_envelopes must be an object/);
});

test('resolveEffectFragment fails closed on a node with no capability field, and on unknown effect_id/compute', () => {
  assert.throws(() => resolveEffectFragment({ foo: 1 }, { keyframeEffects: REG, compileEnvelope }), /no capability field/);
  assert.throws(() => resolveEffectFragment({ effect_id: 'nope' }, { keyframeEffects: REG, compileEnvelope }), /unknown keyframe effect/);
  assert.throws(() => resolveEffectFragment({ compute: 'nope' }, { keyframeEffects: REG, computeEffects: {}, compileEnvelope }), /unknown compute effect/);
});

test('VIZ_PRODUCERS is the visualizer taxonomy (waveform/spectrum/cqt/bars) producing source-filter strings', () => {
  assert.deepEqual(Object.keys(VIZ_PRODUCERS).sort(), ['bars', 'cqt', 'spectrum', 'waveform']);
  assert.equal(VIZ_PRODUCERS.waveform({ rw: 640, rh: 120, color: 'cyan', fps: 30 }),
    'showwaves=s=640x120:mode=cline:colors=cyan:rate=30');
  assert.equal(VIZ_PRODUCERS.bars({ rw: 320, rh: 80, color: 'yellow', fps: 24 }),
    'showfreqs=s=320x80:mode=bar:colors=yellow:rate=24');
});

test('createEffectProducers builds the out-of-process producer taxonomy (denoise/matte/translation)', () => {
  const calls = [];
  const execFileSync = (...a) => { calls.push(a); return 'STDOUT\n'; };
  const p = createEffectProducers({ execFileSync, PKG_ROOT: '/pkg', join: (...s) => s.join('/') });
  assert.deepEqual(Object.keys(p).sort(), ['denoise', 'matte', 'translation']);
  // matte rows carry the resolved script path (PKG_ROOT/do-work/segment-person-matte.py) + rembg model arg
  assert.equal(p.matte.person.script, '/pkg/do-work/segment-person-matte.py');
  assert.deepEqual(p.matte.person.args, ['u2net_human_seg']);
  assert.deepEqual(p.matte.salient.args, ['u2netp']);
  // denoise output name is deterministic from the DEEPFILTER model (no dir scan)
  assert.equal(p.denoise.deepfilternet.cleanedName('clip'), 'clip_DeepFilterNet3.wav');
  // glossary translator is PURE (no binary): whole-string hit, else word-by-word, else null (fail-soft)
  const g = { hello: 'hola', world: 'mundo' };
  assert.equal(p.translation.glossary('hello', 'es', { glossary: g }), 'hola');
  assert.equal(p.translation.glossary('hello world', 'es', { glossary: g }), 'hola mundo');
  assert.equal(p.translation.glossary('unknown phrase', 'es', { glossary: g }), null);
  // argos translator shells the DATA binary (default on PATH), returns trimmed stdout
  assert.equal(p.translation.argos('hi', 'es', {}), 'STDOUT');
  assert.equal(calls[0][0], 'argos-translate');
});

test("colorAdjustFragment builds eq= from non-identity terms only, else null", () => {
  const round3 = (n) => Math.round(n * 1000) / 1000;
  assert.equal(colorAdjustFragment({ brightness: 0, contrast: 1, saturation: 1, gamma: 1 }, { round3 }), null);
  assert.equal(colorAdjustFragment({ brightness: 0.1, contrast: 1.2, saturation: 0.8, gamma: 1.3 }, { round3 }),
    "eq=brightness=0.1:contrast=1.2:saturation=0.8:gamma=1.3");
  assert.equal(colorAdjustFragment({ contrast: 1.5 }, { round3 }), "eq=contrast=1.5");
  // gamma must be > 0 and != 1 to emit
  assert.equal(colorAdjustFragment({ gamma: 0 }, { round3 }), null);
});

test("createComputeEffects map: color_adjust / letterbox / scrim resolve to fragments (or null)", () => {
  const round3 = (n) => Math.round(n * 1000) / 1000;
  const safeColor = (c, d) => (c || d);
  const colorToRgb255 = () => [16, 16, 32];
  const CE = createComputeEffects({ round3, W: 1920, H: 1080, safeColor, colorToRgb255 });
  // color_adjust folds colorAdjustFragment
  assert.equal(CE.color_adjust({ contrast: 1.5 }), "eq=contrast=1.5");
  assert.equal(CE.color_adjust({ contrast: 1 }), null);
  // letterbox: 2.39 on a 16:9 frame -> horizontal bars (2 drawbox fragments)
  const lb = CE.letterbox({ aspect: 2.39, color: "black" });
  assert.equal(lb.length, 2);
  assert.equal(lb[0], "drawbox=x=0:y=0:w=iw:h=138:color=black:t=fill");
  assert.equal(lb[1], "drawbox=x=0:y=ih-138:w=iw:h=138:color=black:t=fill");
  // a target == frame aspect yields no bars
  assert.deepEqual(CE.letterbox({ aspect: 1920 / 1080 }), []);
  // scrim: one geq fragment with escaped commas (r(X\,Y)) and the bottom-edge ramp
  const sc = CE.scrim({ edge: "bottom", strength: 0.5, color: "#101020" });
  assert.ok(sc.startsWith("format=rgb24,geq=r='r(X\\,Y)"));
  assert.ok(sc.includes("0.5*Y/H"));
  // #136 split_tone: colorbalance from nonzero channels, clamped -1..1, null when neutral
  assert.equal(
    CE.split_tone({ shadows: { r: -0.3, g: 0.2, b: 0.4 }, highlights: { r: 5, b: -0.3 } }),
    "colorbalance=rs=-0.3:gs=0.2:bs=0.4:rh=1:bh=-0.3",
  );
  assert.equal(CE.split_tone({ shadows: { r: 0, g: 0, b: 0 } }), null);
  assert.equal(CE.split_tone({}), null);
  // #122 glow: split/gblur/screen-blend graph; strength scales sigma (4..20) + opacity (0.25..0.8);
  // undefined strength defaults to gs=0.5 (sigma=12, opacity=0.525)
  assert.equal(
    CE.glow({ strength: 0 }),
    "split=2[glowbase][glowsrc];[glowsrc]gblur=sigma=4[glowblur];[glowbase][glowblur]blend=all_mode=screen:all_opacity=0.25",
  );
  assert.equal(
    CE.glow({ strength: 1 }),
    "split=2[glowbase][glowsrc];[glowsrc]gblur=sigma=20[glowblur];[glowbase][glowblur]blend=all_mode=screen:all_opacity=0.8",
  );
  assert.equal(
    CE.glow({}),
    "split=2[glowbase][glowsrc];[glowsrc]gblur=sigma=12[glowblur];[glowbase][glowblur]blend=all_mode=screen:all_opacity=0.525",
  );
});

test("createPulseEffects.resolve returns ordered fragments (flash, punch, shake x2, glitch, tint per color)", () => {
  const round3 = (n) => Math.round(n * 1000) / 1000;
  const colorToRgb255 = (c) => (c === "#00e5ff" ? [0, 229, 255] : [255, 45, 85]);
  const PE = createPulseEffects({ round3, fpsNum: 24, W: 320, H: 180, colorToRgb255 });
  // empty -> nothing
  assert.deepEqual(PE.resolve([]), []);
  // one of each kind: flash(1) + punch(1) + shake(2: crop+scale) + glitch(1) + tint(1) = 6 fragments, in order
  const frags = PE.resolve([
    { at: 0.3, kind: "flash", strength: 0.6 },
    { at: 0.6, kind: "punch", strength: 0.5 },
    { at: 0.9, kind: "shake", strength: 0.7 },
    { at: 1.2, kind: "glitch", strength: 0.8 },
    { at: 1.5, kind: "tint", strength: 0.6, color: "#ff2d55" },
  ]);
  assert.equal(frags.length, 6);
  assert.ok(frags[0].startsWith("eq=brightness="));
  assert.ok(frags[1].startsWith("zoompan=z='1+"));
  assert.ok(frags[2].startsWith("crop=w=iw*"));
  assert.equal(frags[3], "scale=320:180");
  assert.ok(frags[4].includes("geq=r='r("));
  assert.ok(frags[5].includes("+255*("));
  // a tint pulse ALSO flashes (flash filter = not punch/shake/glitch), existing behavior preserved
  const t = PE.resolve([{ at: 1, kind: "tint", strength: 0.5, color: "#ff2d55" }]);
  assert.equal(t.length, 2); // flash + tint
  assert.ok(t[0].startsWith("eq=brightness="));
});

test("createStabilizeEffect.resolve runs the detect pass then returns the vidstabtransform fragment (fail-soft null)", () => {
  const calls = [];
  const ff = (a) => calls.push(a.join(" "));
  const execFileSync = () => {}; // `test -f trf` passes
  const join = (a, b) => `${a}/${b}`;
  const SE = createStabilizeEffect({ ff, T: "/wd", join, execFileSync });
  // default smoothing (10) + default shakiness (8), trf path built from T + segment.id
  assert.equal(
    SE.resolve({ id: "c1", source: "in.mp4" }, []),
    "vidstabtransform=input=/wd/stab-c1.trf:smoothing=10:crop=black",
  );
  // pass 1 shelled vidstabdetect with the clamped shakiness (20 -> 10) on the seeked source
  assert.equal(calls.length, 1);
  assert.ok(calls[0].includes("vidstabdetect=shakiness=8:result=/wd/stab-c1.trf"));
  // smoothing knob (rounded, min 1) and shakiness clamp both flow through
  const SE2 = createStabilizeEffect({ ff, T: "/wd", join, execFileSync });
  assert.equal(
    SE2.resolve({ id: "c2", source: "in.mp4", stabilize_smoothing: 25.6, stabilize_shakiness: 20 }, ["-ss", "1"]),
    "vidstabtransform=input=/wd/stab-c2.trf:smoothing=26:crop=black",
  );
  // fail-soft: a detect (ff) throw yields null, the clip renders un-stabilized
  const SEfail = createStabilizeEffect({ ff: () => { throw new Error("no vidstab"); }, T: "/wd", join, execFileSync });
  assert.equal(SEfail.resolve({ id: "c3", source: "in.mp4" }, []), null);
});

test("createComputeEffects map: sharpen / camera_shake / motion_blur / trails / wobble / highlight_sweep", () => {
  const round3 = (n) => Math.round(n * 1000) / 1000;
  const CE = createComputeEffects({ round3, W: 1920, H: 1080, safeColor: (c, d) => (c || d), colorToRgb255: () => [16, 16, 32] });
  // #123 sharpen: unsharp mask, amount 0..1 -> 0..2
  assert.equal(CE.sharpen(0.5), "unsharp=5:5:1");
  assert.equal(CE.sharpen(2), "unsharp=5:5:2"); // clamped to 1 -> *2
  // motion_blur: tmix frames default 3, min 2, rounded
  assert.equal(CE.motion_blur(undefined), "tmix=frames=3");
  assert.equal(CE.motion_blur(1), "tmix=frames=3"); // <2 -> default
  assert.equal(CE.motion_blur(4.6), "tmix=frames=5");
  // #156 trails: lagfun decay clamped 0.5..0.98
  assert.equal(CE.trails(0.3), "format=rgb24,lagfun=decay=0.5,format=yuv420p");
  assert.equal(CE.trails(1.5), "format=rgb24,lagfun=decay=0.98,format=yuv420p");
  // #146 camera_shake: animated crop inset; amplitude clamped 0..0.2, fy = round3(fx*1.37)
  const sh = CE.camera_shake({ amplitude: 0.1 });
  assert.ok(sh.startsWith("crop=w=iw*0.8:h=ih*0.8:x='iw*(0.1+0.1*(1)*sin(2*PI*8*t))'"));
  assert.ok(sh.includes("cos(2*PI*10.96*t)")); // fy = 8*1.37
  assert.equal(CE.camera_shake({ amplitude: 0.5 }).startsWith("crop=w=iw*0.6:h=ih*0.6"), true); // 0.5 clamped to 0.2
  // #157 wobble: per-frame sinusoidal X displacement; wl = round3(H/freq), amp clamped to H/4
  const wob = CE.wobble({ amplitude: 20 });
  assert.ok(wob.startsWith("format=rgb24,geq=r='r(min(W-1\\,max(0\\,X+20*sin(2*PI*(Y/360+0.5*T))))"));
  assert.equal(CE.wobble({ amplitude: 1000 }).includes("1000*sin"), false); // clamped to H/4 = 270
  // #153 highlight_sweep: one translucent wiping box; bx/bw from W, geq if() blend
  const hl = CE.highlight_sweep({ x: 0.1, y: 0.2, w: 0.3, h: 0.1 });
  assert.ok(hl.startsWith("format=rgb24,geq=r='if(between(X\\,192\\,768)")); // bx=192, bx+bw=768
  assert.ok(hl.includes("+16*0.5")); // colorToRgb255 -> 16, default opacity 0.5
});

test("createComputeEffects map: warmth_ramp / strobe / scanlines / posterize / zoom_blur / light_leak", () => {
  const round3 = (n) => Math.round(n * 1000) / 1000;
  const CE = createComputeEffects({ round3, W: 1920, H: 1080, safeColor: (c, d) => (c || d), colorToRgb255: () => [16, 16, 32], fpsNum: 30 });
  // #158 warmth_ramp: K ramps from->to over dur, red*(1+K), blue*(1-K). Uniform (params, timing): dur resolves
  // from p.duration | timing.duration | out-in; returns null when unresolved (so the ordered list can invoke it).
  assert.ok(CE.warmth_ramp({ from: -0.5, to: 0.5 }, { duration: 3 }).startsWith("format=rgb24,geq=r='min(255\\,r(X\\,Y)*(1+(-0.5+(1)*min(1\\,max(0\\,(T-0)/3))"));
  assert.equal(CE.warmth_ramp({ from: 0.2, to: 0.4, duration: 5 }, {}).includes("/5))"), true); // dur from p.duration
  assert.equal(CE.warmth_ramp({ from: 0.2, to: 0.4 }, {}), null); // unresolved dur -> null
  // #159 strobe: [decimate fps, restore output fps]
  assert.deepEqual(CE.strobe({ rate: 12 }), ["fps=12", "fps=30"]);
  // #160 scanlines: periodic darkening, default period 4 / roll 0
  assert.ok(CE.scanlines({ depth: 0.5 }).includes("(1-0.5*(0.5+0.5*cos(2*PI*(Y/4+0*T))))"));
  // #162 posterize: levels 2 -> step 255
  assert.ok(CE.posterize({ levels: 2 }).startsWith("format=rgb24,geq=r='min(255\\,round(r(X\\,Y)/255)*255)"));
  // #167 zoom_blur: 8-tap average toward center
  assert.ok(CE.zoom_blur({ strength: 0.5 }).startsWith("format=rgb24,geq=r='(r(min(W-1\\,max(0\\,960+(X-960)*1))"));
  // #168 light_leak: screen-blend colored bloom from a point
  assert.ok(CE.light_leak({ strength: 0.5 }).startsWith("format=rgb24,geq=r='255-(255-r(X\\,Y))*(255-16*("));
});

test("createComputeEffects map: lens_fringe / halftone / tilt_shift / sketch / film_damage", () => {
  const round3 = (n) => Math.round(n * 1000) / 1000;
  const CE = createComputeEffects({ round3, W: 1920, H: 1080, safeColor: (c, d) => (c || d), colorToRgb255: () => [16, 16, 32], fpsNum: 30 });
  // #161 lens_fringe: red pushed outward (1+s*n), blue inward (1-s*n); center 960,540
  assert.ok(CE.lens_fringe({ strength: 0.1 }).startsWith("format=rgb24,geq=r='r(min(W-1\\,max(0\\,960+(X-960)*(1+0.1*"));
  assert.ok(CE.lens_fringe({ strength: 0.1 }).includes("b(min(W-1\\,max(0\\,960+(X-960)*(1-0.1*"));
  assert.equal(CE.lens_fringe({ strength: 5 }).includes("(1+0.2*"), true); // clamped to 0.2
  // #163 halftone: per-cell dot, size 8
  assert.ok(CE.halftone({ size: 8 }).startsWith("format=rgb24,geq=r='if(lt(hypot(mod(X\\,8)-8/2\\,mod(Y\\,8)-8/2)/(8/2)"));
  // #164 tilt_shift: split/gblur/blend; default center 0.5, feather 0.1, blur 8
  assert.ok(CE.tilt_shift({ height: 0.5 }).startsWith("format=rgb24,split[tsSharp][tsSrc];[tsSrc]gblur=sigma=8[tsBlur]"));
  assert.ok(CE.tilt_shift({ height: 0.5 }).includes("max(0\\,max(270-Y\\,Y-810))/108")); // y0=270,y1=810,feaPx=108
  // #165 sketch: edgedetect, mode allowlisted, default colormix/strength 0.5 -> low 0.07 high 0.32
  assert.equal(CE.sketch({}), "format=rgb24,edgedetect=mode=colormix:low=0.07:high=0.32,format=yuv420p");
  assert.ok(CE.sketch({ mode: "bogus" }).includes("mode=colormix")); // unknown mode -> allowlist default
  assert.ok(CE.sketch({ mode: "canny" }).includes("mode=canny"));
  // #169 film_damage: scratches ADD, dust SUBTRACT; strength 0.7 -> ampS 190; fk = floor(T*30)
  assert.ok(CE.film_damage({ scratches: 2 }).startsWith("format=rgb24,geq=r='min(255\\,max(0\\,r(X\\,Y)+190*("));
  assert.ok(CE.film_damage({ scratches: 2 }).includes("floor(T*30)"));
});

test("createComputeEffects map: smooth_motion / hue_shift / border / chroma_key", () => {
  const round3 = (n) => Math.round(n * 1000) / 1000;
  const CE = createComputeEffects({ round3, W: 1920, H: 1080, safeColor: (c, d) => (c || d), colorToRgb255: () => [16, 16, 32], fpsNum: 30, FPS: '24000/1001' });
  // #95 smooth_motion: fixed motion-compensated interp graph at the raw FPS string
  assert.equal(CE.smooth_motion(), "minterpolate=fps=24000/1001:mi_mode=mci:mc_mode=aobmc:me_mode=bidir:vsbmc=1");
  // #171 hue_shift: static degrees, animated cycle (h='deg+/-rate*t'), saturation; neutral -> null
  assert.equal(CE.hue_shift({ degrees: 90 }), "hue=h='90':s=1");
  assert.equal(CE.hue_shift({ degrees: 33, cycleRate: 12.5 }), "hue=h='33+12.5*t':s=1");
  assert.equal(CE.hue_shift({ cycleRate: -15, saturation: 2 }), "hue=h='0-15*t':s=2");
  assert.equal(CE.hue_shift({ degrees: 400 }), "hue=h='360':s=1"); // clamped 360
  assert.equal(CE.hue_shift({ degrees: 0, cycleRate: 0, saturation: 1 }), null); // neutral
  // #124 border: drawbox thickness; color sanitized to ffmpeg chars, else 'white'
  assert.equal(CE.border({ width: 4, color: '#ff0000' }), "drawbox=x=0:y=0:w=iw:h=ih:t=4:color=#ff0000");
  assert.equal(CE.border({ width: 6, color: 'bad;color' }), "drawbox=x=0:y=0:w=iw:h=ih:t=6:color=white");
  assert.equal(CE.border({ width: 1.7 }), "drawbox=x=0:y=0:w=iw:h=ih:t=2:color=white"); // rounded + default color
  // #78 chroma_key: opaque key filter trimmed, then flattened to black via format=yuv420p
  assert.equal(CE.chroma_key('  colorkey=0x00ff00:0.3  '), "colorkey=0x00ff00:0.3,format=yuv420p");
  // edge fades (video -vf half) + freeze/tpad hold (video half)
  assert.equal(CE.fade_in(2.333), "fade=t=in:st=0:d=2.333");
  assert.equal(CE.fade_out(3.333, 2.667), "fade=t=out:st=3.333:d=2.667");
  assert.equal(CE.freeze('start', 1.5), "tpad=start_mode=clone:start_duration=1.5");
  assert.equal(CE.freeze('stop', 2.5), "tpad=stop_mode=clone:stop_duration=2.5");
});

test("createComputeEffects map: timer / progress_bar / countdown_ring (HUD family)", () => {
  const round3 = (n) => Math.round(n * 1000) / 1000;
  const colorToRgb255 = (c) => c === '#ff0000' ? [255, 0, 0] : [16, 16, 32];
  const CE = createComputeEffects({ round3, W: 1920, H: 1080, safeColor: (c, d) => (c && c.match(/^[A-Za-z0-9#@.]+$/)) ? c : d, colorToRgb255, fpsNum: 30, FPS: '24000/1001' });
  // #144 timer: elapsed -> %{pts:hms} (escaped); countdown -> %{eif ceil(D-t)}; corner via pad mapping.
  assert.equal(CE.timer({ mode: 'elapsed' }, { duration: 10 }),
    "drawtext=text='%{pts\\:hms}':expansion=normal:x=32+(w-text_w-64)*1:y=32+(h-text_h-64)*0:fontsize=86:fontcolor=white:box=1:boxcolor=black@0.5:boxborderw=26");
  assert.equal(CE.timer({ mode: 'countdown' }, { out: 12, in: 2 }).includes("%{eif\\:max(0\\,ceil(10-t))\\:d}"), true);
  assert.equal(CE.timer({ mode: 'countdown' }, {}).includes("%{pts\\:hms}"), true); // no duration -> elapsed token
  // #143 progress_bar: bottom band fills L->R; null when duration unresolved.
  assert.equal(CE.progress_bar({ height: 0.02, color: '#ff0000' }, { duration: 8 }),
    "format=rgb24,geq=r='if(gt(Y\\,H-22)*lt(X\\,W*T/8)\\,255\\,r(X\\,Y))':g='if(gt(Y\\,H-22)*lt(X\\,W*T/8)\\,0\\,g(X\\,Y))':b='if(gt(Y\\,H-22)*lt(X\\,W*T/8)\\,0\\,b(X\\,Y))',format=yuv420p");
  assert.equal(CE.progress_bar({ height: 0.02 }, {}), null); // unresolved duration
  assert.ok(CE.progress_bar({ height: 0.02, color: '#ff0000', markers: [0.5], markerColor: '#ff0000' }, { duration: 8 }).includes("gt(lt(abs(X-960)\\,12)\\,0)")); // #145 marker tick
  // #147 countdown_ring: polar arc; default deplete; null when duration unresolved.
  assert.ok(CE.countdown_ring({ color: '#ff0000' }, { duration: 5 }).startsWith("format=rgb24,geq=r='if(between(hypot(X-960\\,Y-540)\\,"));
  assert.ok(CE.countdown_ring({ mode: 'fill', color: '#ff0000' }, { duration: 5 }).includes("lt(mod(atan2(X-960\\,540-Y)+2*PI\\,2*PI)\\,(T/5)*2*PI)"));
  assert.equal(CE.countdown_ring({ color: '#ff0000' }, {}), null); // unresolved duration
  // #126 frame: shrink+center; 'blur' bg vs sanitized pad color; even dims for yuv420p
  assert.equal(CE.frame({ scale: 0.5 }), "scale=960:540,pad=1920:1080:(1920-iw)/2:(1080-ih)/2:color=black");
  assert.equal(CE.frame({ scale: 0.9, background: '#112233' }), "scale=1728:972,pad=1920:1080:(1920-iw)/2:(1080-ih)/2:color=#112233");
  assert.equal(CE.frame({ scale: 0.5, background: 'blur' }).startsWith("split=2[frbg][frfg];[frbg]scale=1920:1080:force_original_aspect_ratio=increase"), true);
  assert.equal(CE.frame({ scale: 0.5, background: 'bad;color' }).endsWith(":color=black"), true); // bad color -> black
});

test("createComputeEffects map: region_filter emit (censor/spotlight split-crop-overlay branches)", () => {
  const round3 = (n) => Math.round(n * 1000) / 1000;
  const CE = createComputeEffects({ round3, W: 1920, H: 1080, safeColor: (c, d) => c || d, colorToRgb255: () => [0, 0, 0], fpsNum: 30, FPS: '24000/1001' });
  const base = { eff: 'boxblur=10', cw: 200, ch: 120, cx: 640, cy: 360, xE: "100+50*t", yE: '200' };
  // #130 inside static no-fade: the exact legacy positional form (crop at cx:cy, overlay at cx:cy)
  assert.equal(CE.region_filter({ ...base, i: 0, mode: 'inside', moving: false, op: null }),
    "split=2[rf0k][rf0r];[rf0r]crop=200:120:640:360,boxblur=10[rf0o];[rf0k][rf0o]overlay=640:360");
  // #138/#139 inside moving: expression position form; rf${i} labels distinct per index
  assert.equal(CE.region_filter({ ...base, i: 2, mode: 'inside', moving: true, op: null }),
    "split=2[rf2k][rf2r];[rf2r]crop=200:120:x='100+50*t':y='200',boxblur=10[rf2o];[rf2k][rf2o]overlay=x='100+50*t':y='200'");
  // #141 inside + fade: obscure sub-chain blends original vs filtered by op
  assert.ok(CE.region_filter({ ...base, i: 1, mode: 'inside', moving: false, op: "clip(T/2\\,0\\,1)" })
    .includes("[rf1c1][rf1filt]blend=all_expr='A*(1-clip(T/2\\,0\\,1))+B*clip(T/2\\,0\\,1)'"));
  // #142 outside (spotlight): filter the whole frame, overlay the untouched crop back on top
  assert.ok(CE.region_filter({ ...base, i: 0, mode: 'outside', moving: true, op: null })
    .startsWith("split=2[rf0b][rf0k];[rf0b]boxblur=10[rf0bg];[rf0k]crop=200:120:x='100+50*t'"));
});

test("createComputeEffects map: spotlight #125 (static + #154 keyframed follow track)", () => {
  const round3 = (n) => Math.round(n * 1000) / 1000;
  const CE = createComputeEffects({ round3, W: 1920, H: 1080, safeColor: (c, d) => c || d, colorToRgb255: () => [0, 0, 0], fpsNum: 30, FPS: '24000/1001' });
  // static: positioned vignette; angle = round3(0.4 + min(1,strength)*1.1)
  assert.equal(CE.spotlight({ strength: 1, cx: 0.3, cy: 0.7 }, { duration: 10 }), "vignette=x0=w*0.3:y0=h*0.7:a=1.5");
  assert.equal(CE.spotlight({ strength: 0.5 }, {}), "vignette=x0=w*0.5:y0=h*0.5:a=0.95"); // no track -> static, default center
  // #154 keyframed track (>=2 pts, resolvable duration): piecewise-linear expr with escaped commas + eval=frame
  const kf = CE.spotlight({ strength: 0.8, track: [{ at: 0, cx: 0.2, cy: 0.3 }, { at: 1, cx: 0.8, cy: 0.7 }] }, { duration: 10 });
  assert.ok(kf.startsWith("vignette=x0='w*(if(lt(t\\,0)\\,0.2\\,"));
  assert.ok(kf.endsWith(":a=1.28:eval=frame"));
  assert.ok(kf.includes('\\,')); // commas escaped (\,) for the -vf join
  assert.equal(/[^\\],/.test(kf), false); // ...and no BARE (unescaped) comma remains
  // <2 valid track points -> falls back to the static path
  assert.equal(CE.spotlight({ strength: 0.8, track: [{ at: 0, cx: 0.2, cy: 0.3 }] }, { duration: 10 }).includes('eval=frame'), false);
});

test("createComputeEffects map: drop_shadow #129 / rounded_corners #128 / ellipse_mask #131 (card + mask family)", () => {
  const round3 = (n) => Math.round(n * 1000) / 1000;
  const colorToRgb255 = (c) => c === '#000000' ? [0, 0, 0] : [255, 255, 255];
  const CE = createComputeEffects({ round3, W: 1920, H: 1080, safeColor: (c, d) => c || d, colorToRgb255, fpsNum: 30, FPS: '24000/1001' });
  // #129 drop_shadow: split into card + blurred offset shadow, overlay card on top (even dims, sanitized colors)
  assert.equal(CE.drop_shadow({ scale: 0.5, color: '#000000', background: '#000000' }),
    "split=2[dscard][dssh];[dssh]scale=960:540,drawbox=x=0:y=0:w=iw:h=ih:color=#000000:t=fill,pad=1920:1080:480:270:color=#000000,gblur=sigma=16[dsshl];[dscard]scale=960:540[dscd];[dsshl][dscd]overlay=480:270");
  assert.ok(CE.drop_shadow({ scale: 0.5, cornerRadius: 0.1, background: '#000000' }).includes(",format=rgb24,geq=r='if(gt(")); // #134 rounded card corners
  assert.equal(CE.drop_shadow({ scale: 0.6, color: 'bad;', background: 'x;' }).includes("color=black:t=fill"), true); // bad color -> black
  // #128 rounded_corners: hard corner geq (no feather); soft (#133) uses a blend ramp
  assert.ok(CE.rounded_corners({ radius: 0.1, background: '#000000' }).startsWith("format=rgb24,geq=r='if(gt(max("));
  assert.ok(CE.rounded_corners({ radius: 0.2, feather: 0.5, background: '#000000' }).includes("sqrt(pow(max(")); // #133 feather -> corner-distance ramp
  // #131 ellipse_mask: outside-ellipse geq; #135 reveal scales radii by a time factor; #132 feather softens
  assert.ok(CE.ellipse_mask({ rx: 0.3, ry: 0.2, background: '#000000' }).startsWith("format=rgb24,geq=r='if(gt(pow((X-960)/576"));
  assert.ok(CE.ellipse_mask({ rx: 0.3, ry: 0.3, reveal: { from: 0, to: 1, start: 0, duration: 2 }, background: '#000000' }).includes("max((min(1\\,max((T-0)/2\\,0))*(1-0)+0)\\,0.02)"));
  assert.ok(CE.ellipse_mask({ rx: 0.3, ry: 0.3, feather: 0.4, background: '#000000' }).startsWith("format=rgb24,geq=r='r(X\\,Y)*(1-min(1"));
});
