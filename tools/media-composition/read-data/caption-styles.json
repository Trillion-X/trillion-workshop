        { "key": "outline", "path": ["outline"], "label": "Outline", "widget": "number", "min": 0, "max": 20, "unit": "px" },
        { "key": "colours.outline", "path": ["colours", "outline"], "label": "Outline colour", "widget": "color" }
      ]
    },
    {
