    },
    {
      "id": "place",
      "title": "Place",
      "settings": [
        { "key": "position", "label": "Position", "widget": "number", "settings": [
          { "key": "position.x", "path": ["position", "x"], "label": "Across", "widget": "number", "prefix": "X", "min": 0, "max": 1, "step": 0.01 },
          { "key": "position.y", "path": ["position", "y"], "label": "Down", "widget": "number", "prefix": "Y", "min": 0, "max": 1, "step": 0.01 }
        ] }
      ]
    },
    {
      "id": "timing",
      "title": "Timing",
      "settings": [
        { "key": "reveal", "path": ["reveal"], "label": "Words", "widget": "segmented", "options": [
          { "value": "karaoke", "label": "Light up as said" },
          { "value": "line", "label": "All at once" }
        ] },
        { "key": "grouping.maxWords", "path": ["grouping", "maxWords"], "label": "Words per caption", "widget": "number", "min": 1, "max": 20 },
        { "key": "grouping.maxSeconds", "path": ["grouping", "maxSeconds"], "label": "Longest caption", "widget": "number", "min": 0.5, "max": 10, "step": 0.1, "unit": "s" },
        { "key": "grouping.maxGap", "path": ["grouping", "maxGap"], "label": "Break at a pause", "widget": "number", "min": 0.1, "max": 3, "step": 0.1, "unit": "s" }
      ]
    }
  ]
}
