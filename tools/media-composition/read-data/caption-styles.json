          { "value": "Arial", "label": "Arial" },
          { "value": "EB Garamond", "label": "EB Garamond" }
        ] },
        { "key": "size", "path": ["size"], "label": "Size", "widget": "number", "prefix": "Aa", "min": 8, "max": 200, "unit": "px" },
