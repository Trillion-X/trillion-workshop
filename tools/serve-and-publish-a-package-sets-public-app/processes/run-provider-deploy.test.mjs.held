test('installed app process environment prepares fixed update and reopen commands', () => {
  const hostileValue = "line one\n'$(touch /tmp/not-allowed)'; fly apps destroy victim";
  assert.deepEqual(installedAppProcessEnvironmentCommandsFromArgs([
    '--prepare-installed-app-process-environment',
    '--provider-application', 'example-public-app',
    '--app-id', 'example-app',
    '--environment-name', 'EXAMPLE_VALUE',
    '--environment-value', hostileValue,
  ]), {
    provider_application: 'example-public-app',
    advance_command: "'env' 'BITFIELD_MACHINE_WIDE_HOME=/var/lib/bitfield' '/opt/bitfield/bin/open-bitfield-app' '--same-app-id' 'example-app' '--advance-log-owned-process-environment' 'EXAMPLE_VALUE=line one\n'\"'\"'$(touch /tmp/not-allowed)'\"'\"'; fly apps destroy victim'",
  });
  assert.equal(installedAppProcessEnvironmentCommandsFromArgs([]), null);
  assert.throws(() => installedAppProcessEnvironmentCommandsFromArgs([
    '--prepare-installed-app-process-environment',
    '--provider-application', 'example-public-app',
    '--app-id', 'example-app',
    '--environment-name', 'ACCOUNT_PUBLIC_URL',
    '--environment-value', 'https://app.example.invalid',
    '--command', 'id',
  ]), /accepts exactly one/);
  for (const [application, appId, name, value, pattern] of [
    ['--help', 'example-app', 'EXAMPLE_VALUE', 'ok', /application is invalid/],
    ['example-public-app', '../other-app', 'EXAMPLE_VALUE', 'ok', /app_id is invalid/],
    ['example-public-app', 'example-app', 'VALUE;touch', 'ok', /environment_name is invalid/],
    ['example-public-app', 'example-app', 'EXAMPLE_VALUE', `before\0after`, /environment_value is invalid/],
  ]) {
    assert.throws(() => installedAppProcessEnvironmentCommandsFromArgs([
      '--prepare-installed-app-process-environment',
      '--provider-application', application,
      '--app-id', appId,
      '--environment-name', name,
      '--environment-value', value,
    ]), pattern);
  }
});

test('provider machine environment is changed only through bounded semantic values', () => {
  const descriptor = {
    kind: 'package-owned-deployment-request',
