test('provider readback refuses to erase a machine shape it cannot preserve', async () => {
  await assert.rejects(
    currentContainerBaseResult('example-public-app', {
      credential: 'secret',
      fetchImplementation: async () => ({
        ok: true,
        json: async () => [{
          id: 'machine-1',
          config: {
            image: 'registry.fly.io/example-public-app:current',
            guest: { memory_mb: 8192 },
          },
        }],
      }),
    }),
    /no supported current machine CPU and memory shape/,
  );

  await assert.rejects(
    currentContainerBaseResult('example-public-app', {
      credential: 'secret',
      fetchImplementation: async () => ({
        ok: true,
        json: async () => [{
          id: 'machine-1',
          config: {
            image: 'registry.fly.io/example-public-app:current',
            guest: { cpu_kind: 'performance', cpus: 64, memory_mb: 1 },
          },
        }],
      }),
    }),
    /no supported current machine CPU and memory shape/,
  );

  await assert.rejects(
    currentContainerBaseResult('example-public-app', {
      credential: 'secret',
      fetchImplementation: async () => ({
        ok: true,
        json: async () => [{
          id: 'machine-1',
          config: {
            image: 'registry.fly.io/example-public-app:current',
            guest: { cpu_kind: 'shared-cpu', cpus: 2, memory_mb: 4096 },
          },
        }],
      }),
    }),
    /no supported current machine CPU and memory shape/,
  );
});

