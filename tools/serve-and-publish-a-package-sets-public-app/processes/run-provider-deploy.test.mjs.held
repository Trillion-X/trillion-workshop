test('package-set DATA cannot smuggle executable behavior through the deployment owner', () => {
  assert.throws(() => packageOwnedDeploymentPlan({
    kind: 'package-owned-deployment-request', schema: 'hosted-public-app.deployment-request/v2',
    profile: 'fly-remote-only',
    parameters: { application: 'example-public-app', config_file: 'fly.toml' },
    command: 'sh', args: ['-c', 'anything'],
  }), /may contain only/);
  assert.throws(() => packageOwnedDeploymentPlan({
    kind: 'package-owned-deployment-request', schema: 'hosted-public-app.deployment-request/v2',
    profile: 'unowned-provider', parameters: {},
  }), /profile is not owned/);
  assert.throws(() => packageOwnedDeploymentPlan({
    kind: 'package-owned-deployment-request', schema: 'hosted-public-app.deployment-request/v2',
    profile: 'fly-remote-only',
    parameters: { application: 'example-public-app', config_file: '../../other/fly.toml' },
  }), /config_file is invalid/);
  assert.throws(() => packageOwnedDeploymentPlan({
    kind: 'package-owned-deployment-request', schema: 'hosted-public-app.deployment-request/v2',
    profile: 'fly-remote-only',
    parameters: { application: 'example-public-app', config_file: 'fly.toml', argv: ['attacker'] },
  }), /request contract/);
});

test('result extraction failure removes stale output', async () => {
  // zero / two URLs
  for (const stdout of ['', 'https://one.example/ https://two.example/']) {
    const { resultFile } = fixture();
    writeFileSync(resultFile, 'stale\n');
    const { spawnChild } = recordingSpawn([stdout]);
    await assert.rejects(
      runProviderDeployment({ descriptor: releaseRow('vercel'), spawnChild, parentEnv: {}, resultFile, writeStdout() {}, writeStderr() {} }),
      /exactly one valid deployment URL/,
    );
    assert.equal(existsSync(resultFile), false);
  }
  // missing template var
  assert.throws(
    () => deploymentResultFromExtraction({ strategy: 'fixed-hostname', hostname_template: 'https://{app_name}.fly.dev' }, { stdout: '', stderr: '' }),
    /vars\.app_name is missing/,
  );
  // unsupported strategy
  assert.throws(
    () => deploymentResultFromExtraction({ strategy: 'guess-it' }, { stdout: '', stderr: '' }),
    /strategy is not supported/,
  );
});

test('a non-zero child exit rejects and never commits a result', async () => {
  const { resultFile } = fixture();
  writeFileSync(resultFile, 'stale\n');
  function spawnChild() {
    const step = child();
    queueMicrotask(() => step.emit('close', 1, null));
    return step;
  }
  await assert.rejects(
    runProviderDeployment({ descriptor: releaseRow('vercel'), spawnChild, parentEnv: {}, resultFile, writeStdout() {}, writeStderr() {} }),
    /deploy step exited 1/,
  );
  assert.equal(existsSync(resultFile), false);
});

test('deployment requests carry no secret value and results never leak environment values', async () => {
  const secret = 'SUPER-SECRET-TOKEN-VALUE';
  for (const provider of ['vercel', 'fly', 'cloudflare', 'railway']) {
    const row = releaseRow(provider);
    const serialized = JSON.stringify(row);
    assert.ok(!serialized.includes(secret), `${provider} row must not contain a secret value`);
    const plan = packageOwnedDeploymentPlan(row);
    for (const name of plan.env_passthrough ?? []) {
      // passthrough entries are variable NAMES (uppercase identifiers), never values.
      assert.match(name, /^[A-Z][A-Z0-9_]*$/, `${provider} env_passthrough entry ${name} must be a bare env name`);
    }
  }
  // A secret present in the parent env must not appear in the committed artifact.
  const { resultFile } = fixture();
  const result = await runProviderDeployment({
    descriptor: releaseRow('fly'),
    spawnChild: recordingSpawn([]).spawnChild,
    parentEnv: { FLY_API_TOKEN: secret },
    resultFile,
    writeStdout() {},
    writeStderr() {},
    ...provenRelease(),
  });
  assert.ok(!JSON.stringify(result).includes(secret));
  assert.ok(!readFileSync(resultFile, 'utf8').includes(secret));
});
