      application: 'example-public-app',
      machine: 'd8956e5b766d08',
      environment_name: 'ACCOUNT_PUBLIC_URL',
      environment_value: 'https://app.example.invalid',
    },
  };
  assert.deepEqual(packageOwnedDeploymentPlan(descriptor).steps, [{
    command: 'fly',
    args: [
      'machine', 'update', 'd8956e5b766d08',
      '--env', 'ACCOUNT_PUBLIC_URL=https://app.example.invalid',
      '--app', 'example-public-app', '--yes',
    ],
  }]);
  for (const [field, value] of [
    ['application', '--help'],
    ['machine', '../other-machine'],
    ['environment_name', 'VALUE;touch'],
    ['environment_value', `before\0after`],
  ]) {
