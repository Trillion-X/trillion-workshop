test('runtime refresh reads two provider images, builds once, and deploys through existing owners', () => {
  const packageRoot = realpathSync(path.resolve(path.dirname(fileURLToPath(import.meta.url)), '..'));
  const manifest = JSON.parse(readFileSync(path.join(packageRoot, 'things-to-store-and-run.json'), 'utf8'));
  const workflow = manifest.things.find((thing) =>
    thing?.payload?.id === 'action:hosted-public-app.refresh-container-runtime')?.payload;
  assert.ok(workflow);
  assert.deepEqual(workflow.input_schema.required, [
    'runtime_provider_application',
    'provider_application',
  ]);
  const byId = Object.fromEntries(workflow.steps.map((step) => [step.id, step]));
  assert.equal(byId.read_runtime_image.kind, 'action');
  assert.equal(byId.read_runtime_image.config.definition_id, 'action:hosted-public-app.read-current-container-base');
  assert.equal(byId.read_application_image.kind, 'action');
  assert.equal(byId.read_application_image.config.definition_id, 'action:hosted-public-app.read-current-container-base');
  assert.equal(byId.build_container.config.name, 'native-artifact.build-current-container-artifact');
  assert.equal(byId.deploy_container.kind, 'action');
  assert.equal(byId.deploy_container.config.definition_id, 'action:hosted-public-app.deploy-container-artifact');
  assert.doesNotMatch(JSON.stringify(workflow), /source_path|deployment_target|process_sequence|replace-current-native/);
});

test('post-deploy readback uses provider and boot HTTP endpoints without fly or curl children', async () => {
  const urls = [];
  const result = await nativeContainerDeploymentResult('example-public-app', {
    credential: 'secret',
