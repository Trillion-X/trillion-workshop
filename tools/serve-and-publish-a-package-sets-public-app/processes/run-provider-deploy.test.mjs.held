import { applyHostedProductDelta, configWithCurrentServingSettings, currentContainerBaseApplicationFromArgs, currentContainerBaseResult, deploymentRequestFromArgs, deploymentResultFromExtraction, installedAppProcessEnvironmentCommandsFromArgs, invokeHostedProductLogOperation, machineSizeRequestFromArgs, nativeContainerDeploymentRequestFromArgs, nativeContainerDeploymentResult, packageOwnedDeploymentPlan, providerEnvironmentSecret, retireProviderApplicationRequestFromArgs, runProviderDeployment, selectContainerArtifactDockerfileFromArgs } from './run-provider-deploy.mjs';

test('a hosted derived-state refresh uses only the selected shared-product log', async () => {
  const machine = { id: 'd8956e5b766d08', state: 'started', config: { env: {
    BITFIELD_HOSTED_ACCOUNT_WORKER_JSON: JSON.stringify({ package_set: 'example', product_volume_name: 'product' }),
    BITFIELD_PROCESS_WORKSPACE_MOUNTS_JSON: JSON.stringify({ product: { root: '/var/lib/bitfield/shared-product', access: 'read_only' } }),
    BITFIELD_RUNTIME_KIT_HOME: '/opt/bitfield',
  } } };
  const commands = [];
  const spawnChild = (_command, args) => {
    commands.push(args);
    const child = new EventEmitter();
    child.stdout = new PassThrough();
    child.stderr = new PassThrough();
    setImmediate(() => {
      child.stdout.end(args.some((part) => part.includes('--print-process-admission-policy')) ? '{"schema":"test.policy"}\n' : '');
      child.stderr.end();
      child.emit('close', 0, null);
    });
    return child;
  };
  const options = { fetchImplementation: async () => ({ ok: true, json: async () => [machine] }), readProviderCredential: () => 'held-by-owner', spawnChild, createId: () => 'chosen' };
  const request = { operation_label: 'engine.operation.refresh-derived-state' };
  assert.deepEqual(await invokeHostedProductLogOperation({ application: 'example', request }, options), { operation_label: request.operation_label, outcome: 'refreshed' });
  assert.ok(commands.some((args) => args.some((part) => part.includes('--refresh-derived-state-in-log'))));
  assert.ok(commands.some((args) => args.some((part) => part.includes('--print-process-admission-policy'))));
  assert.ok(commands.some((args) => args.some((part) => part.includes('BITFIELD_PROCESS_ADMISSION_POLICY_JSON='))));
  assert.ok(commands.some((args) => args.some((part) => part.includes('/var/lib/bitfield/shared-product/stored-data/envelope.log'))));
  assert.ok(!commands.some((args) => args.some((part) => part.includes('engine-operation'))));
  machine.config.env.BITFIELD_PROCESS_WORKSPACE_MOUNTS_JSON = JSON.stringify({ product: { root: '/var/lib/bitfield', access: 'read_only' } });
  await assert.rejects(invokeHostedProductLogOperation({ application: 'example', request }, options), /isolated shared-product log/);
});

test('a hosted package delta uses the account worker product mount and the native atomic writer', async () => {
  const request = { schema: 'bitfield.package_delta/v1', partition: 'example', package_ref: 'screen-arrangement', proposal_multihash: '1f:proposal', operations: [], ownership_proofs: [] };
  const receipt = { schema: 'bitfield.package_delta_receipt/v1', partition: 'example', package_ref: request.package_ref, proposal_multihash: request.proposal_multihash, outcome: 'applied' };
  const machine = { id: 'd8956e5b766d08', state: 'started', config: { env: {
    BITFIELD_HOSTED_ACCOUNT_WORKER_JSON: JSON.stringify({ package_set: 'example', product_volume_name: 'product' }),
    BITFIELD_PROCESS_WORKSPACE_MOUNTS_JSON: JSON.stringify({ product: { root: '/var/lib/bitfield/shared-product', access: 'read_only' } }),
    BITFIELD_RUNTIME_KIT_HOME: '/opt/bitfield',
  } } };
  const commands = [];
  const runnerHash = `1f:${'a'.repeat(64)}`;
  const runnerPath = `/var/lib/bitfield/.bitfield/runtime-kit/app-log-storage-folders/app-log-storage-for-bitfield-app-${Buffer.from('example').toString('hex')}/runtime-kit/process-files-by-content-hash/app-state-from-log/bytes-${Buffer.from(runnerHash).toString('hex')}/bin/bitfield-runner`;
  const installedStatus = { same_app_id: 'example', decision: 'already-open', requested_process_restart_fingerprint: {
    executable_inputs: [{ name: 'shell-process-role.environment-path.BITFIELD_RUNNER_BINARY', path: runnerPath, multihash: runnerHash, byte_length: 100 }],
  } };
  const spawnChild = (_command, args) => {
    commands.push(args);
    const child = new EventEmitter();
    child.stdout = new PassThrough();
    child.stderr = new PassThrough();
    setImmediate(() => {
      if (args.some((part) => part.includes('--status-report-only'))) child.stdout.write(`${JSON.stringify(installedStatus)}\n`);
      if (args.some((part) => part.includes('--apply-package-delta-to-log'))) child.stdout.write(`${JSON.stringify(receipt)}\n`);
      child.stdout.end();
      child.stderr.end();
      child.emit('close', 0, null);
    });
    return child;
  };
  const options = { fetchImplementation: async () => ({ ok: true, json: async () => [machine] }), readProviderCredential: () => 'held-by-owner', spawnChild, createId: () => 'chosen' };
  assert.deepEqual(await applyHostedProductDelta({ application: 'example', machine: machine.id, request }, options), receipt);
  assert.equal(commands.length, 4);
  assert.ok(commands[0].find((part) => part.includes('--status-report-only')));
  assert.deepEqual(commands[1].slice(0, 3), ['ssh', 'sftp', 'put']);
  assert.ok(commands[2].find((part) => part.includes('/var/lib/bitfield/shared-product/stored-data/envelope.log')));
  assert.ok(commands[2].find((part) => part.includes(runnerPath)));
  assert.ok(commands[3].find((part) => part.includes('rm -f')));
  machine.config.env.BITFIELD_PROCESS_WORKSPACE_MOUNTS_JSON = JSON.stringify({ product: { root: '/var/lib/bitfield', access: 'read_only' } });
  await assert.rejects(applyHostedProductDelta({ application: 'example', machine: machine.id, request }, options), /isolated shared-product log/);
  assert.equal(commands.length, 4);
});

test('a signed layer uses the current serving image and the package-owned registry credential route', () => {
  const parameters = {
    application: 'example',
    base_image: `registry.fly.io/example:serving@sha256:${'a'.repeat(64)}`,
    image: 'registry.fly.io/example:stdout-isolated',
    layer_file: 'signed-layer.tar',
  };
  const plan = packageOwnedDeploymentPlan({ kind: 'package-owned-deployment-request', profile: 'fly-append-image-layer', parameters });
  assert.deepEqual(plan.steps, [
    { current_image: parameters.base_image, application: 'example' },
    { command: 'fly', args: ['auth', 'docker'] },
    { command: 'crane', args: ['append', '--base', parameters.base_image, '--new_layer', 'signed-layer.tar', '--new_tag', parameters.image] },
  ]);
  assert.throws(() => packageOwnedDeploymentPlan({ kind: 'package-owned-deployment-request', profile: 'fly-append-image-layer', parameters: { ...parameters, layer_file: '../escape.tar' } }));
  assert.throws(() => packageOwnedDeploymentPlan({ kind: 'package-owned-deployment-request', profile: 'fly-append-image-layer', parameters: { ...parameters, image: 'registry.fly.io/other:stdout-isolated' } }));
  assert.deepEqual(deploymentResultFromExtraction(plan.result_extraction, {}), { schema: 'published-container-image/v1', image: parameters.image });
});

test('a machine image update names one machine and one app image', () => {
  const plan = packageOwnedDeploymentPlan({ kind: 'package-owned-deployment-request', profile: 'fly-machine-image', parameters: { application: 'example', machine: 'd8956e5b766d08', image: 'registry.fly.io/example:stdout-isolated' } });
  assert.deepEqual(plan.steps, [{ command: 'fly', args: ['machine', 'update', 'd8956e5b766d08', '--image', 'registry.fly.io/example:stdout-isolated', '--app', 'example', '--skip-health-checks', '--yes'] }]);
});
import { PUBLIC_FALLBACK_COMMAND, execMachineCommand, proveTheReleaseStarts, publicFallbackReadinessFromAnswer, readinessFromBootAnswer } from './prove-a-release-starts-before-it-goes-live.mjs';

test('release readiness uses the same exact command through SSH when machine exec refuses it', async () => {
  let observed;
  const command = ['/opt/bitfield/bin/node', '-e', 'process.stdout.write("ready")'];
  const reply = await execMachineCommand(async () => { throw new Error('machine exec refused'); },
    'example-app', 'abc123def45678', command, async (request) => {
      observed = request;
      return { stdout: 'ready' };
    });
  assert.equal(reply.stdout, 'ready');
  assert.deepEqual(observed, { application: 'example-app', machineId: 'abc123def45678', command });
});
import { verifyReleaseViewportPaint, viewportPaintDecision, viewportScene } from './verify-release-viewport-paint.mjs';

test('a built image is tested before it can replace the serving image', () => {
  const plan = packageOwnedDeploymentPlan({
    kind: 'package-owned-deployment-request', profile: 'fly-built-image-trial',
    parameters: { application: 'member-app' },
  });
  assert.equal(plan.site_root, 'required');
  assert.deepEqual(plan.steps.map((step) => step.proof ?? (step.carry ? 'carry' : step.command)),
    ['carry', 'fly', 'the-release-starts', 'fly']);
  assert.ok(plan.steps[1].args.includes('--build-only'));
  assert.ok(plan.steps[1].args.includes('--push'));
  assert.equal(plan.steps[2].image, 'registry.fly.io/member-app:{release_label}');
  assert.ok(plan.steps[3].args.includes('--image'));
});

test('the built-image trial refuses to build without a matching signed-in journey', async () => {
  let spawned = false;
  await assert.rejects(runProviderDeployment({
    descriptor: { kind: 'package-owned-deployment-request', profile: 'fly-built-image-trial',
      parameters: { application: 'member-app' } },
    spawnChild: () => { spawned = true; throw new Error('should not build'); },
    parentEnv: {},
    resultFile: null,
    releaseMemberReadiness: { application: 'another-app', storage: { session: 'present' },
      authenticatedSelector: '[data-member-auth]', journeys: [{ name: 'Articles' }] },
  }), /matching signed-in member journey/);
  assert.equal(spawned, false);
});

test('the release browser paints through its private HTTP and WebSocket tunnel', async () => {
  const server = createHttpServer((request, response) => {
    response.setHeader('content-type', 'text/html');
    response.end('<div id="root" aria-busy="true"></div><script>const ws=new WebSocket("ws://"+location.host+"/ws");ws.onopen=()=>ws.send("scene");ws.onmessage=()=>{document.querySelector("#root").removeAttribute("aria-busy");document.querySelector("#root").innerHTML="<svg width=300 height=200><circle cx=100 cy=100 r=80 fill=red /></svg>"}</script>');
  });
  const webSocketServer = new WebSocketServer({ server });
  webSocketServer.on('connection', (socket) => socket.on('message', () => socket.send('ready')));
  await new Promise((resolve) => server.listen(0, '127.0.0.1', resolve));
  try {
    const answer = await verifyReleaseViewportPaint({
      application: 'example', privateIp: 'fdaa::1', host: 'trial.example', waitMs: 3_000,
      openTunnel: async () => ({ port: server.address().port, close: () => {} }),
    });
    assert.equal(answer.ready, true, answer.reason);
  } finally {
    for (const client of webSocketServer.clients) client.terminate();
    await new Promise((resolve) => webSocketServer.close(resolve));
    await new Promise((resolve) => server.close(resolve));
  }
});

test('the release browser refuses a painted missing-page-description error', async () => {
  const server = createHttpServer((_request, response) => {
    response.writeHead(503, { 'content-type': 'text/plain' });
    response.end('This host has not been configured with a page description: no page description could be read at all.');
  });
  await new Promise((resolve) => server.listen(0, '127.0.0.1', resolve));
  try {
    const answer = await verifyReleaseViewportPaint({
      application: 'example', privateIp: 'fdaa::1', host: 'trial.example', waitMs: 3_000,
      openTunnel: async () => ({ port: server.address().port, close: () => {} }),
    });
    assert.equal(answer.ready, false);
    assert.match(answer.reason, /HTTP 503/);
  } finally {
    server.closeAllConnections();
    await new Promise((resolve) => server.close(resolve));
  }
});

test('the candidate browser checks authenticated member panes when an owned fixture is supplied', async () => {
  const server = createHttpServer((_request, response) => {
    response.setHeader('content-type', 'text/html');
    response.end(`<!doctype html><body style="background:#111;color:white"><main id="root"><svg width="300" height="200"><circle cx="100" cy="100" r="80" fill="red"/></svg><div id="member"></div></main><script>
      if (localStorage.getItem('test-session') === 'active') {
        const member = document.querySelector('#member');
        member.innerHTML = '<div data-member-auth>Member home</div><button data-navigation-item class="nav-articles">Articles</button><button data-navigation-item class="nav-feed">Feed</button><section id="pane"></section>';
        for (const name of ['articles', 'feed']) document.querySelector('.nav-' + name).addEventListener('click', () => {
          document.querySelector('#pane').innerHTML = '<article id="' + name + '" style="width:320px;height:180px;background:linear-gradient(red,blue)">' + name + ' loaded</article>';
        });
      }
    </script></body>`);
  });
  await new Promise((resolve) => server.listen(0, '127.0.0.1', resolve));
  try {
    const readiness = {
      storage: { 'test-session': 'active' },
      authenticatedSelector: '[data-member-auth]',
      journeys: [
        { name: 'Articles', clickSelector: '.nav-articles', readySelector: '#articles', timeoutMs: 2_000 },
        { name: 'Feed', clickSelector: '.nav-feed', readySelector: '#feed', timeoutMs: 2_000 },
      ],
    };
    const answer = await verifyReleaseViewportPaint({
      application: 'example', privateIp: 'fdaa::1', host: 'trial.example', waitMs: 3_000,
      openTunnel: async () => ({ port: server.address().port, close: () => {} }),
      memberReadiness: readiness,
    });
    assert.equal(answer.ready, true, answer.reason);
    assert.deepEqual(answer.journeys, [{ name: 'Articles', ready: true }, { name: 'Feed', ready: true }]);
    assert.equal(JSON.stringify(answer).includes('active'), false);

    const failed = await verifyReleaseViewportPaint({
      application: 'example', privateIp: 'fdaa::1', host: 'trial.example', waitMs: 3_000,
      openTunnel: async () => ({ port: server.address().port, close: () => {} }),
      memberReadiness: { ...readiness, journeys: [{ ...readiness.journeys[0], readySelector: '#missing', timeoutMs: 1_000 }] },
    });
    assert.equal(failed.ready, false);
    assert.match(failed.reason, /member journey Articles failed/);
  } finally {
    server.closeAllConnections();
    await new Promise((resolve) => server.close(resolve));
  }
});

test('the candidate browser refuses a signed-in account page that loops on HTTP 503', async () => {
  const server = createHttpServer((request, response) => {
    response.setHeader('content-type', 'text/html');
    if (request.url === '/account') {
      response.writeHead(503);
      response.end('<meta http-equiv="refresh" content="3"><main>Opening your workspace. This page will continue on its own.</main>');
      return;
    }
    response.end('<main id="root" style="background:#111;color:white;min-height:400px"><svg width="300" height="200"><circle cx="100" cy="100" r="80" fill="red"/></svg><div data-member-auth>Member home</div><a href="/account" id="account-link">Account</a></main>');
  });
  await new Promise((resolve) => server.listen(0, '127.0.0.1', resolve));
  try {
    const answer = await verifyReleaseViewportPaint({
      application: 'example', privateIp: 'fdaa::1', host: 'trial.example', waitMs: 3_000,
      openTunnel: async () => ({ port: server.address().port, close: () => {} }),
      memberReadiness: {
        storage: { 'test-session': 'active' }, authenticatedSelector: '[data-member-auth]',
        journeys: [{ name: 'Account', clickSelector: '#account-link', readySelector: '#account-ready', timeoutMs: 2_000 }],
      },
    });
    assert.equal(answer.ready, false);
    assert.match(answer.reason, /member journey Account failed: member page failed: \/account returned HTTP 503/);
  } finally {
    server.closeAllConnections();
    await new Promise((resolve) => server.close(resolve));
  }
});

test('the candidate browser refuses an HTTP 200 error shell around a blank member scene', async () => {
  const server = createHttpServer((request, response) => {
    response.setHeader('content-type', 'text/html');
    if (request.url === '/account') {
      response.end('<body style="background:#111;color:white"><main><h1>Your workspace could not be shown</h1><p>Your workspace view is not available yet.</p><section id="workspace" style="display:block;width:800px;height:500px;background:#111"></section></main></body>');
      return;
    }
    response.end('<body style="background:#fff;color:#111"><main id="root" style="margin:20px;padding:30px;background:#ddd;width:900px;height:600px"><div data-member-auth>Member home</div><a href="/account" id="account-link">Account</a></main></body>');
  });
  await new Promise((resolve) => server.listen(0, '127.0.0.1', resolve));
  try {
    const answer = await verifyReleaseViewportPaint({
      application: 'example', privateIp: 'fdaa::1', host: 'trial.example', waitMs: 3_000,
      openTunnel: async () => ({ port: server.address().port, close: () => {} }),
      memberReadiness: {
        storage: { 'test-session': 'active' }, authenticatedSelector: '[data-member-auth]',
        journeys: [{ name: 'Account', clickSelector: '#account-link', readySelector: '#workspace', timeoutMs: 2_000 }],
      },
    });
    assert.equal(answer.ready, false);
    assert.match(answer.reason, /selected member scene is blank/);
  } finally {
    server.closeAllConnections();
    await new Promise((resolve) => server.close(resolve));
  }
});

test('the release paint predicate rejects offscreen content and accepts visible textless media', async () => {
  const browser = await chromium.launch({ headless: true });
  try {
    const page = await browser.newPage({ viewport: { width: 800, height: 600 } });
    await page.setContent('<div id="root"><div style="position:absolute;top:900px">Welcome back</div></div>');
    assert.equal((await page.evaluate(viewportScene)).visibleContent, false);
    assert.equal(viewportPaintDecision({ responseStatus: 200, visibleContent: false, busy: false, distinctColors: 20, foregroundFraction: 0.2 }).ready, false);
    await page.setContent('<div id="root"><svg width="300" height="200"><circle cx="100" cy="100" r="80" fill="red"/></svg></div>');
    assert.equal((await page.evaluate(viewportScene)).visibleContent, true);
    assert.equal(viewportPaintDecision({ responseStatus: 200, visibleContent: true, busy: false, distinctColors: 20, foregroundFraction: 0.2 }).ready, true);
    assert.equal(viewportPaintDecision({ responseStatus: 200, visibleContent: true, busy: true, distinctColors: 20, foregroundFraction: 0.2 }).ready, false);
    assert.match(viewportPaintDecision({ responseStatus: 503, visibleContent: true, busy: false, distinctColors: 20, foregroundFraction: 0.2 }).reason, /HTTP 503/);
  } finally {
    await browser.close();
  }
});

test('the release check accepts a bounded summary of a large healthy boot answer', () => {
  assert.deepEqual(readinessFromBootAnswer(200, { target_count: 115 }), {
    ready: true, status: 200, reason: 'ready with 115 targets', final: true,
  });
  assert.equal(readinessFromBootAnswer(200, { target_count: 0 }).ready, false);
  assert.equal(readinessFromBootAnswer(503, { target_count: 0, boot_status: 'recovering', message: 'warming up' }).final, false);
  assert.equal(readinessFromBootAnswer(503, { target_count: 0, code: 'BITFIELD_BOOT_RESTRICTED_RECOVERY' }).final, true);
});

test('a public recovery check refuses missing or unreadable fallback files', () => {
  assert.equal(publicFallbackReadinessFromAnswer('{"ready":true,"reason":"public recovery files present"}').ready, true);
  assert.equal(publicFallbackReadinessFromAnswer('{"ready":false,"reason":"page has no fallback_body_file"}').ready, false);
  assert.equal(publicFallbackReadinessFromAnswer('').ready, false);
});

test('the trial command reads the actual page description and recovery files', () => {
  const root = mkdtempSync(path.join(tmpdir(), 'public-recovery-trial-'));
  try {
    const description = path.join(root, 'page-description.json');
    const body = path.join(root, 'fallback.html');
    const archive = path.join(root, 'archive.json');
    writeFileSync(body, '<main>Readable recovery page</main>');
    writeFileSync(archive, JSON.stringify({ rows: [] }));
    writeFileSync(description, JSON.stringify({ pages: [{ fallback_body_file: 'fallback.html', fallback_pages_file: 'archive.json' }] }));
    const runCheck = () => {
      const run = spawnSync(PUBLIC_FALLBACK_COMMAND[0], PUBLIC_FALLBACK_COMMAND.slice(1), {
        encoding: 'utf8',
        env: {
          ...process.env,
          BITFIELD_RUNTIME_KIT_HOME: path.dirname(path.dirname(process.execPath)),
          BITFIELD_PUBLIC_PAGE_DESCRIPTION_FILE: description,
        },
      });
      assert.equal(run.status, 0, run.stderr);
      return publicFallbackReadinessFromAnswer(run.stdout);
    };
    assert.equal(runCheck().ready, true);
    writeFileSync(description, JSON.stringify({ pages: [{ fallback_pages_file: 'archive.json' }] }));
    assert.match(runCheck().reason, /no fallback_body_file/);
    writeFileSync(description, JSON.stringify({ pages: [{ fallback_body_file: 'fallback.html', fallback_pages_file: 'archive.json' }] }));
    writeFileSync(body, '');
    assert.match(runCheck().reason, /fallback body is blank/);
  } finally {
    rmSync(root, { recursive: true, force: true });
  }
});

test('trial boot can prove readiness while provider state still says created', async () => {
  const live = {
    id: 'live-machine', state: 'started', region: 'ord',
    config: { image: 'registry.fly.io/example-public-app:before', metadata: { fly_process_group: 'app' } },
  };
  const trial = { id: 'trial-machine', state: 'created' };
  const removed = [];
  const kept = [];
  let retainAnswer = JSON.stringify([{ app_id: 'example', kept: '/var/lib/bitfield/stored-data/files/1f' }]);
  const fetchImplementation = async (url, options) => {
    const pathname = new URL(url).pathname;
    const method = options.method;
    let answer;
    if (method === 'GET' && pathname.endsWith('/machines')) answer = [live, trial];
    else if (method === 'POST' && pathname.endsWith('/machines')) answer = trial;
    else if (method === 'GET' && pathname.endsWith('/machines/trial-machine')) answer = trial;
    else if (method === 'POST' && pathname.endsWith('/exec')) {
      const command = JSON.stringify(JSON.parse(options.body).command);
      answer = command.includes('fallback_body_file')
        ? { stdout: JSON.stringify({ ready: true, reason: 'public recovery files present' }) }
        : command.includes('runtime-app-footprint.json')
          ? { stdout: JSON.stringify({ records: [{ footprint: 'within', allocated_bytes: 1 }], memory_in_use_bytes: 1 }) }
          : command.includes('--retain-current-source')
            ? (kept.push(pathname), { stdout: retainAnswer })
            : { stdout: JSON.stringify({ status: 200, summary: { target_count: 1 } }) };
    } else if (method === 'DELETE' && pathname.includes('/machines/trial-machine')) {
      removed.push(pathname);
      answer = {};
    } else throw new Error(`unexpected provider request: ${method} ${pathname}`);
    return { ok: true, text: async () => JSON.stringify(answer) };
  };
  const result = await proveTheReleaseStarts({
    application: 'example-public-app', image: 'registry.fly.io/example-public-app:after',
    credential: 'test-credential', fetchImplementation,
    verifyPaint: async () => ({ ready: true, reason: 'visible test scene' }),
    wait: async () => {}, attempts: 2, intervalMs: 0,
  });
  assert.equal(result.trial.ready, true);
  assert.deepEqual(result.measured, { memory_in_use_bytes: 1, opener_peak_bytes: 0, allocated_bytes: 1 });
  assert.equal(removed.length, 1);
  // The live machine keeps its outgoing source before the image is swapped.
  assert.deepEqual(kept, ['/v1/apps/example-public-app/machines/live-machine/exec']);
  assert.deepEqual(result.retained, [{ app_id: 'example', kept: '/var/lib/bitfield/stored-data/files/1f' }]);

  // A live machine that cannot keep it refuses the release.
  kept.length = 0;
  retainAnswer = 'Error: verify the kept copy';
  await assert.rejects(proveTheReleaseStarts({
    application: 'example-public-app', image: 'registry.fly.io/example-public-app:after',
    credential: 'test-credential', fetchImplementation,
    verifyPaint: async () => ({ ready: true, reason: 'visible test scene' }),
    wait: async () => {}, attempts: 2, intervalMs: 0,
  }), /did not keep its current source/);

  // The same image again replaces nothing, so nothing is kept.
  kept.length = 0;
  const same = await proveTheReleaseStarts({
    application: 'example-public-app', image: 'registry.fly.io/example-public-app:before',
    credential: 'test-credential', fetchImplementation,
    verifyPaint: async () => ({ ready: true, reason: 'visible test scene' }),
    wait: async () => {}, attempts: 2, intervalMs: 0,
  });
  assert.equal(same.retained, null);
  assert.deepEqual(kept, []);
});

test('a missing CAS hash refuses release and cleans the disposable trial', async () => {
  const hash = `1f:${'f'.repeat(64)}`;
  const live = {
    id: 'live-machine', state: 'started', region: 'ord',
    config: {
      image: 'registry.fly.io/example-public-app:before',
      metadata: { fly_process_group: 'app' },
      env: {
        BITFIELD_HOSTED_ACCOUNT_WORKER_JSON: JSON.stringify({ package_set: 'example', product_volume_name: 'product' }),
        BITFIELD_PROCESS_WORKSPACE_MOUNTS_JSON: JSON.stringify({ product: { root: '/var/lib/bitfield/shared-product', access: 'read_only' } }),
      },
      mounts: [{ name: 'app_data', volume: 'live-volume', path: '/var/lib/bitfield' }],
    },
  };
  const trial = { id: 'trial-machine', state: 'created' };
  const events = [];
  let trialExists = true;
  let result;
  const fetchImplementation = async (url, options) => {
    const pathname = new URL(url).pathname;
    const method = options.method;
    let answer;
    if (method === 'GET' && pathname.endsWith('/machines')) answer = trialExists ? [live, trial] : [live];
    else if (method === 'POST' && pathname.endsWith('/volumes')) {
      events.push('fork');
      answer = { id: 'trial-volume', state: 'created' };
    }
    else if (method === 'POST' && pathname.endsWith('/machines')) answer = trial;
    else if (method === 'GET' && pathname.endsWith('/machines/trial-machine')) answer = trial;
    else if (method === 'POST' && pathname.endsWith('/exec')) {
      const machineId = pathname.split('/').at(-2);
      const command = JSON.parse(options.body).command;
      if (command[0] === 'sync') {
        assert.deepEqual(command, ['sync', '-f', '/var/lib/bitfield']);
        events.push('flush');
        answer = { stdout: '' };
      } else if (command[0] === '/opt/bitfield/bin/node') {
        const stdout = machineId === 'live-machine'
          ? JSON.stringify({ status: 200, summary: { target_count: 1 } })
          : JSON.stringify({ status: 503, summary: { target_count: 0, message: `missing content ${hash}` } });
        events.push(`${machineId}:readiness`);
        answer = { stdout };
      } else if (command[0] === '/bin/sh') {
        answer = { stdout: JSON.stringify({ ready: true, reason: 'public files present' }) };
      } else {
        assert.equal(command[0], '/opt/bitfield/bin/bitfield-stored-data');
        assert.equal(command[1], 'storage');
        assert.equal(command[3], '--bitfield-root');
        assert.equal(command[4], '/var/lib/bitfield/shared-product');
        assert.ok(command.includes(hash));
        assert.ok(command.includes('inspect-hash') || command.includes('inspect-referenced'));
        assert.equal(command.some((part) => ['--apply', 'seed', 'copy-hash'].includes(part)), false);
        events.push(`${machineId}:${command[2]}`);
        answer = { stdout: `storage.${command[2]}\n  requested_hash=${hash}\n  found=${machineId === 'live-machine'}\n` };
      }
    } else if (method === 'DELETE' && pathname.endsWith('/machines/trial-machine')) {
      events.push('cleanup:machine');
      trialExists = false;
      answer = {};
    } else if (method === 'DELETE' && pathname.endsWith('/volumes/trial-volume')) {
      events.push('cleanup:volume');
      answer = {};
    } else throw new Error(`unexpected provider request: ${method} ${pathname}`);
    return { ok: true, text: async () => JSON.stringify(answer) };
  };
  await assert.rejects(proveTheReleaseStarts({
    application: 'example-public-app', image: 'registry.fly.io/example-public-app:after',
    credential: 'test-credential', fetchImplementation,
    verifyPaint: async () => ({ ready: true, reason: 'visible test scene' }),
    wait: async () => {}, attempts: 1, intervalMs: 0,
  }), (error) => {
    result = error.result;
    assert.match(error.message, /release refused/);
    return true;
  });
  assert.match(result.trial.reason, /missing content/);
  assert.ok(events.indexOf('flush') < events.indexOf('fork'));
  assert.deepEqual(events.slice(-2), ['cleanup:machine', 'cleanup:volume']);
});

test('interrupting a release trial destroys its machine and fork', async () => {
  const signalSource = new EventEmitter();
  const removed = [];
  let trialExists = true;
  const live = { id: 'live', state: 'started', region: 'ord', config: {
    image: 'registry.fly.io/example-public-app:before', metadata: { fly_process_group: 'app' },
    mounts: [{ name: 'app_data', volume: 'live-volume', path: '/data' }],
  } };
  const trial = { id: 'trial', state: 'created' };
  const fetchImplementation = async (url, options) => {
    const pathname = new URL(url).pathname;
    const method = options.method;
    let answer;
    if (method === 'GET' && pathname.endsWith('/machines')) answer = trialExists ? [live, trial] : [live];
    else if (method === 'POST' && pathname.endsWith('/machines')) { answer = trial; signalSource.emit('SIGINT'); }
    else if (method === 'POST' && pathname.endsWith('/volumes')) answer = { id: 'trial-volume', state: 'created' };
    else if (method === 'DELETE' && pathname.endsWith('/machines/trial')) { removed.push('trial'); trialExists = false; answer = {}; }
    else if (method === 'DELETE' && pathname.endsWith('/volumes/trial-volume')) { removed.push('trial-volume'); answer = {}; }
    else if (method === 'POST' && pathname.endsWith('/exec')) answer = { stdout: JSON.stringify({ status: 200, summary: { target_count: 1 } }) };
    else throw new Error(`unexpected provider request: ${method} ${pathname}`);
    return { ok: true, text: async () => JSON.stringify(answer) };
  };
  await assert.rejects(proveTheReleaseStarts({
    application: 'example-public-app', image: 'registry.fly.io/example-public-app:after',
    credential: 'test-credential', fetchImplementation, signalSource,
    wait: async () => {}, attempts: 2, intervalMs: 0,
  }), /release trial interrupted/);
  assert.deepEqual(removed, ['trial', 'trial-volume']);
  assert.equal(signalSource.listenerCount('SIGINT'), 0);
});

test('a release trial reports the exact fork when Fly refuses every delete', async () => {
  const signalSource = new EventEmitter();
  let trialExists = true;
  let deleteAttempts = 0;
  const live = { id: 'live', state: 'started', region: 'ord', config: {
    image: 'registry.fly.io/example-public-app:before', metadata: { fly_process_group: 'app' },
    mounts: [{ name: 'app_data', volume: 'live-volume', path: '/data' }],
  } };
  const trial = { id: 'trial', state: 'created' };
  const fetchImplementation = async (url, options) => {
    const pathname = new URL(url).pathname;
    const method = options.method;
    if (method === 'DELETE' && pathname.endsWith('/volumes/trial-volume')) {
      deleteAttempts += 1;
      return { ok: false, status: 500, text: async () => 'volume still attached' };
    }
    let answer;
    if (method === 'GET' && pathname.endsWith('/machines')) answer = trialExists ? [live, trial] : [live];
    else if (method === 'POST' && pathname.endsWith('/machines')) { answer = trial; signalSource.emit('SIGINT'); }
    else if (method === 'POST' && pathname.endsWith('/volumes')) answer = { id: 'trial-volume', state: 'created' };
    else if (method === 'GET' && pathname.endsWith('/volumes/trial-volume')) answer = { id: 'trial-volume', state: 'created' };
    else if (method === 'DELETE' && pathname.endsWith('/machines/trial')) { trialExists = false; answer = {}; }
    else if (method === 'POST' && pathname.endsWith('/exec')) answer = { stdout: JSON.stringify({ status: 200, summary: { target_count: 1 } }) };
    else throw new Error(`unexpected provider request: ${method} ${pathname}`);
    return { ok: true, text: async () => JSON.stringify(answer) };
  };
  await assert.rejects(proveTheReleaseStarts({
    application: 'example-public-app', image: 'registry.fly.io/example-public-app:after',
    credential: 'test-credential', fetchImplementation, signalSource,
    wait: async () => {}, attempts: 1, intervalMs: 0,
  }), /release trial left volume trial-volume.*billable state/);
  assert.equal(deleteAttempts, 12);
  assert.equal(signalSource.listenerCount('SIGINT'), 0);
});

test('an unavailable live app does not excuse an unavailable trial release', async () => {
  const live = {
    id: 'live-machine', state: 'started', region: 'ord',
    config: { image: 'registry.fly.io/example-public-app:before', metadata: { fly_process_group: 'app' } },
  };
