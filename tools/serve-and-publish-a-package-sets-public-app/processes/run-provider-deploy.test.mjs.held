test('remote Fly deployment carries the declared machine size into the release', () => {
  const plan = packageOwnedDeploymentPlan({
    kind: 'package-owned-deployment-request',
    profile: 'fly-remote-only',
    parameters: {
      application: 'example-public-app',
      vm_size: 'shared-cpu-2x',
      memory_megabytes: '4096',
    },
  });
  const carried = 'fly.current-serving-settings.json';
  assert.deepEqual(plan.steps[0], { carry: 'current-serving-settings', application: 'example-public-app', config_file: carried });
  assert.deepEqual(plan.steps[1].args, [
    'deploy', '--config', carried, '--app', 'example-public-app', '--remote-only', '--build-only', '--push',
    '--image-label', '{release_label}',
  ]);
  assert.deepEqual(plan.steps[2], {
    proof: 'the-release-starts', application: 'example-public-app', image: 'registry.fly.io/example-public-app:{release_label}',
  });
  assert.deepEqual(plan.steps[3].args, [
    'deploy', '--config', carried, '--vm-size', 'shared-cpu-2x', '--vm-memory', '4096',
    '--app', 'example-public-app', '--image', 'registry.fly.io/example-public-app:{release_label}', '--yes', '--now',
  ]);
  assert.deepEqual(plan.steps[4].args, [
    'scale', 'vm', 'shared-cpu-2x', '--memory', '4096', '--app', 'example-public-app',
  ]);
  assert.throws(() => packageOwnedDeploymentPlan({
    kind: 'package-owned-deployment-request',
    profile: 'fly-remote-only',
    parameters: { application: 'example-public-app', memory_megabytes: '4096' },
  }), /requires vm_size and memory_megabytes together/);
});

test('Fly publication can build locally when the remote builder is unavailable', () => {
  const plan = packageOwnedDeploymentPlan({
    kind: 'package-owned-deployment-request',
    profile: 'fly-remote-only',
    parameters: { application: 'example-public-app', build_service: 'local' },
  });
  assert.deepEqual(plan.steps[1].args, [
    'deploy', '--config', 'fly.current-serving-settings.json',
    '--app', 'example-public-app', '--local-only', '--build-only', '--push',
    '--image-label', '{release_label}',
  ]);
  assert.equal(plan.steps[2].proof, 'the-release-starts');
});

test('an immutable container artifact enters through the same provider deployment owner', () => {
  const root = mkdtempSync(path.join(tmpdir(), 'hosted-native-container-workspace-'));
  try {
    writeFileSync(path.join(root, 'container-artifact.tar'), tarWithFile('Dockerfile', 'FROM example.invalid/base\n'));
    const result = nativeContainerDeploymentRequestFromArgs([
      '--prepare-container-artifact', 'container-artifact.tar',
      '--application', 'example-public-app',
    ], root, { credential: 'workspace-only-secret' });
    assert.deepEqual(result, {
      application: 'example-public-app',
      descriptor: {
        kind: 'package-owned-deployment-request',
        profile: 'fly-remote-only',
        parameters: { application: 'example-public-app' },
      },
      siteRoot: realpathSync(path.join(root, 'site')),
    });
    assert.equal(readFileSync(path.join(root, 'site', 'Dockerfile'), 'utf8'), 'FROM example.invalid/base\n');
    assert.equal(
      readFileSync(path.join(root, 'site', 'fly-config', 'config.yml'), 'utf8'),
      'access_token: workspace-only-secret\nlast_login: 1970-01-01T00:00:00Z\n',
    );
    assert.equal(statSync(path.join(root, 'site', 'fly-config')).mode & 0o777, 0o755);
    assert.equal(statSync(path.join(root, 'site', 'fly-config', 'config.yml')).mode & 0o777, 0o644);
  } finally {
    rmSync(root, { recursive: true, force: true });
  }
});

test('provider readback uses the HTTP API and never launches a descendant provider command', async () => {
  assert.equal(currentContainerBaseApplicationFromArgs([
    '--read-current-container-base', '--application', 'example-public-app',
  ]), 'example-public-app');
  const calls = [];
  const result = await currentContainerBaseResult('example-public-app', {
    credential: 'secret',
    fetchImplementation: async (url, options) => {
      calls.push({ url, options });
      return { ok: true, json: async () => [{ id: 'machine-1', config: { image: 'registry.fly.io/example-public-app:current', metadata: { fly_release_version: '7' }, guest: { cpu_kind: 'performance', cpus: 2, memory_mb: 8192 } } }] };
    },
  });
  assert.deepEqual(calls, [{
    url: 'https://api.machines.dev/v1/apps/example-public-app/machines',
    options: { headers: { authorization: 'Bearer secret' } },
  }]);
  assert.deepEqual(result, {
    kind: 'hosted-current-container-base-handle',
    owner_ref: 'hosted-public-app',
    provider_application: 'example-public-app',
    image: 'registry.fly.io/example-public-app:current',
    release: '7',
    machine: 'machine-1',
    vm_size: 'performance-2x',
