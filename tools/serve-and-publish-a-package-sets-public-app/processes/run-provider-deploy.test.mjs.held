});

test('native deployment requires a vault-mounted member trial before promoting the image', () => {
  const manifest = JSON.parse(readFileSync(new URL('../things-to-store-and-run.json', import.meta.url), 'utf8'));
  const definition = manifest.things.find((thing) => thing.address === 'package::hosted-public-app::workflow-action::deploy-container-artifact')?.payload;
  assert.equal(definition.steps.some((step) => step.id === 'read_current_shape'), false);
  const ask = definition.steps.find((step) => step.id === 'deploy');
  assert.equal(ask.config.name, 'compute.process_sequence');
  const [prepare, readConfiguration, selectDockerfile, deploy, readCurrent] = ask.config.input.steps;
  assert.equal(prepare.process.argv[0], 'node');
  assert.deepEqual(readConfiguration.process.argv.slice(0, 3), ['fly', 'config', 'save']);
  assert.equal(readConfiguration.process.argv.includes('--config'), false);
  assert.deepEqual(selectDockerfile.process.argv, [
    'node', 'run-provider-deploy.mjs', '--select-container-artifact-dockerfile', 'site/fly.toml',
  ]);
  assert.deepEqual(deploy.process.argv, [
    'node', 'run-provider-deploy.mjs', '--deploy-prepared-container-artifact',
    { $kind: 'binding', select: { from: 'input', path: 'provider_application' } },
    '--member-readiness-file', 'member-readiness.json',
  ]);
  assert.ok(definition.input_schema.required.includes('member_readiness_credential_key'));
  assert.equal(definition.steps.find((step) => step.id === 'member_readiness_mount')?.config.definition_id,
    'action:resolve-one-credential-mount');
  assert.equal(ask.config.input.inputs[2].select.key, 'member_readiness_mount');
  assert.equal(definition.edges.some((edge) => edge.from === 'read_current_shape'), false);
  assert.equal(deploy.process.timeout_ms, 30 * 60 * 1000);
  assert.deepEqual(deploy.process.env, { FLY_CONFIG_DIR: 'fly-config' });
  assert.deepEqual(deploy.workspace_bindings.environment,
    [{ key: 'FLY_CONFIG_DIR', parts: [{ kind: 'workspace_path', segments: ['fly-config'] }] }]);
  assert.equal(readCurrent.process.argv[0], 'node');
  assert.equal(JSON.stringify(definition).includes('/opt/homebrew'), false);
  assert.equal(JSON.stringify(definition).includes('"PATH"'), false);

  const role = JSON.parse(readFileSync(new URL('../../../package-sets/trillion/local-process-role.json', import.meta.url), 'utf8'));
  const fly = role.process_roles[0].process_admission.runtime_aliases.fly;
  assert.equal(fly.kind, 'external_provider');
  assert.equal(fly.provider.provider_entrypoint[0], '/flyctl');
  assert.match(fly.provider.immutable_runtime_artifact, /^docker\.io\/flyio\/flyctl@sha256:[0-9a-f]{64}$/);
  assert.equal(Object.hasOwn(fly, 'executable_path'), false);
  const selection = JSON.parse(readFileSync(new URL('../../../package-sets/trillion/local-process-role-selection.json', import.meta.url), 'utf8'));
  assert.ok(selection.runtime_alias_selections.some((entry) => entry.name === 'fly' && entry.mode === 'add_external_provider'));
});

test('container deployment keeps provider configuration but replaces a retained image with the supplied Dockerfile', () => {
  const root = mkdtempSync(path.join(tmpdir(), 'container-deploy-config-'));
  try {
    const config = path.join(root, 'site/fly.toml');
    mkdirSync(path.join(root, 'site'));
    writeFileSync(config, [
      'app = "example-public-app"',
      '[build]',
      '  image = "registry.fly.io/example-public-app@sha256:deadbeef"',
      '[mounts]',
      '  source = "customer_data"',
      '  destination = "/var/lib/customer"',
      '',
    ].join('\n'));
    assert.deepEqual(selectContainerArtifactDockerfileFromArgs([
      '--select-container-artifact-dockerfile', 'site/fly.toml',
    ], root), { configuration: 'site/fly.toml', dockerfile: 'Dockerfile' });
    const selected = readFileSync(config, 'utf8');
    assert.match(selected, /\[build\]\n  dockerfile = "Dockerfile"/);
    assert.doesNotMatch(selected, /registry\.fly\.io|\n\s*image\s*=/);
    assert.match(selected, /source = "customer_data"/);
    assert.match(selected, /destination = "\/var\/lib\/customer"/);
  } finally {
    rmSync(root, { recursive: true, force: true });
  }
});

