});

test('the Fly request extracts a fixed hostname with no output parsing', async () => {
  const { resultFile } = fixture();
  const parentEnv = { HOME: '/home/example', PATH: '/usr/bin', FLY_API_TOKEN: 'fly-secret', OTHER: 'x' };
  const { spawned, spawnChild } = recordingSpawn([]);
  const tried = [];
  const result = await runProviderDeployment({
    descriptor: releaseRow('fly'),
    spawnChild,
    parentEnv,
    resultFile,
    writeStdout() {},
    writeStderr() {},
    createId: () => 'ABC-123',
    ...provenRelease(tried),
  });
  assert.deepEqual(result, { schema: 'publication-deployment-result/v1', share_url: 'https://example-public-app.fly.dev/' });
  // Built and pushed under one label, tried, then that same image released.
  assert.deepEqual(spawned[0].args, [
    'deploy', '--config', 'fly.toml', '--app', 'example-public-app', '--remote-only', '--build-only', '--push',
    '--image-label', 'release-abc123',
  ]);
  assert.deepEqual(tried, ['registry.fly.io/example-public-app:release-abc123']);
  assert.deepEqual(spawned[1].args, [
    'deploy', '--config', 'fly.toml', '--app', 'example-public-app',
    '--image', 'registry.fly.io/example-public-app:release-abc123', '--yes', '--now',
  ]);
  assert.deepEqual(spawned[0].options.env, { HOME: '/home/example', PATH: '/usr/bin', FLY_API_TOKEN: 'fly-secret' });
});

test('the deployment owner passes its in-memory member fixture to the candidate trial', async () => {
  const { spawned, spawnChild } = recordingSpawn([]);
  const memberReadiness = {
    storage: { 'fixture-session-key': 'fixture-session-value' },
    authenticatedSelector: '[data-member-home]',
    journeys: [{ name: 'Articles', clickSelector: '[data-navigation-item="articles"]', readySelector: '[data-articles-ready]' }],
  };
  let observed;
  await runProviderDeployment({
    descriptor: releaseRow('fly'), spawnChild, parentEnv: { PATH: '/usr/bin' }, resultFile: null,
    writeStdout() {}, writeStderr() {},
    ...provenRelease(), releaseMemberReadiness: memberReadiness,
    proveRelease: async (input) => {
      observed = input.memberReadiness;
      return { application: 'example-public-app', image: input.image, previous_image: 'registry.fly.io/example-public-app:before', live: { ready: true }, trial: { ready: true } };
    },
  });
  assert.deepEqual(observed, memberReadiness);
  assert.equal(JSON.stringify(spawned).includes('fixture-session-value'), false);
});

function provenRelease(tried = [], { refuse = false, liveFailsAfter = false } = {}) {
  return {
    readProviderCredential: () => 'test-credential',
    readCurrentServingImage: async () => 'registry.fly.io/example-public-app:before',
    proveRelease: async ({ image }) => {
      tried.push(image);
      if (refuse) throw new Error('release refused, the new version did not fully start');
      return { application: 'example-public-app', image, previous_image: 'registry.fly.io/example-public-app:before', live: { ready: true }, trial: { ready: true } };
    },
    confirmRelease: async ({ proof, restore }) => {
      if (!liveFailsAfter) return { restored: false };
      await restore(proof.previous_image);
      throw new Error('the previous version was released back');
    },
  };
}

test('a newer serving image arriving during the trial is never overwritten', async () => {
  const { spawned, spawnChild } = recordingSpawn([]);
  await assert.rejects(runProviderDeployment({
    descriptor: releaseRow('fly'), spawnChild, parentEnv: { PATH: '/usr/bin' }, resultFile: null,
    writeStdout() {}, writeStderr() {}, ...provenRelease([]),
    readCurrentServingImage: async () => 'registry.fly.io/example-public-app:newer',
  }), /serving image changed during release trial/);
  assert.equal(spawned.length, 1);
  assert.ok(spawned[0].args.includes('--build-only'));
});

test('a release composed from an older image cannot replace a newer base', async () => {
  const { spawned, spawnChild } = recordingSpawn([]);
  await assert.rejects(runProviderDeployment({
    descriptor: releaseRow('fly'), spawnChild, parentEnv: { PATH: '/usr/bin' }, resultFile: null,
    writeStdout() {}, writeStderr() {}, ...provenRelease([]),
    expectedServingImage: 'registry.fly.io/example-public-app:reviewed-base',
  }), /serving image changed since the reviewed deployment was composed/);
  assert.equal(spawned.length, 1);
  assert.ok(spawned[0].args.includes('--build-only'));
});

test('a release whose trial start fails never reaches the live app', async () => {
  const { spawned, spawnChild } = recordingSpawn([]);
  await assert.rejects(runProviderDeployment({
    descriptor: releaseRow('fly'), spawnChild, parentEnv: { PATH: '/usr/bin' }, resultFile: null,
    writeStdout() {}, writeStderr() {}, ...provenRelease([], { refuse: true }),
  }), /release refused/);
  // Only the build ran; no command released anything.
  assert.equal(spawned.length, 1);
  assert.ok(spawned[0].args.includes('--build-only'));
});

test('a release that breaks live after going out puts the previous image back', async () => {
  const { spawned, spawnChild } = recordingSpawn([]);
  await assert.rejects(runProviderDeployment({
    descriptor: releaseRow('fly'), spawnChild, parentEnv: { PATH: '/usr/bin' }, resultFile: null,
    writeStdout() {}, writeStderr() {}, ...provenRelease([], { liveFailsAfter: true }),
  }), /released back/);
  const restored = spawned.at(-1).args;
  assert.equal(restored[restored.indexOf('--image') + 1], 'registry.fly.io/example-public-app:before');
});

test('a release keeps the live machines serving settings and size over the stored config', () => {
  const stored = {
    app: 'example-public-app',
    build: { dockerfile: 'Dockerfile' },
    env: { EXISTING: 'kept' },
    http_service: { internal_port: 8080, auto_stop_machines: true, auto_start_machines: true, min_machines_running: 0 },
    vm: [{ memory: '4096mb', cpu_kind: 'shared', cpus: 2 }],
  };
  const serving = {
    config: {
      metadata: { fly_process_group: 'app' },
      env: { BITFIELD_APP_ENTRY_SCENE_HOSTS: 'app.example.test', FLY_PROCESS_GROUP: 'app', PRIMARY_REGION: 'ord' },
      services: [{ autostop: false, autostart: true, min_machines_running: 1 }],
      guest: { cpu_kind: 'performance', cpus: 2, memory_mb: 8192 },
    },
  };
  const trial = { config: { metadata: { purpose: 'trial-start-of-a-release' }, guest: { cpu_kind: 'shared', cpus: 1, memory_mb: 256 } } };
  const carried = configWithCurrentServingSettings(stored, [trial, serving]);
  assert.deepEqual(carried.http_service, { internal_port: 8080, auto_stop_machines: false, auto_start_machines: true, min_machines_running: 1 });
  assert.deepEqual(carried.vm, [{ memory: '8192mb', cpu_kind: 'performance', cpus: 2 }]);
  assert.deepEqual(carried.env, { EXISTING: 'kept', BITFIELD_APP_ENTRY_SCENE_HOSTS: 'app.example.test' });
  assert.deepEqual(carried.build, stored.build);
  // Nothing serving: the stored config is used as it is.
  assert.equal(configWithCurrentServingSettings(stored, []), stored);
  assert.throws(() => configWithCurrentServingSettings(null, []), /no stored config/);
});

test('retiring an application is one bounded provider step with the app name as its only argument', async () => {
  const descriptor = {
    kind: 'package-owned-deployment-request',
    profile: 'fly-retire-application',
    parameters: { application: 'example-public-app' },
  };
  const { spawned, spawnChild } = recordingSpawn([]);
  await runProviderDeployment({
    descriptor, spawnChild, parentEnv: { PATH: '/usr/bin', FLY_API_TOKEN: 'secret' }, resultFile: null,
  });
  assert.deepEqual(spawned[0].args, ['apps', 'destroy', 'example-public-app', '--yes']);
  assert.throws(
    () => packageOwnedDeploymentPlan({ ...descriptor, parameters: { application: 'x; fly apps list' } }),
    /application is invalid/,
  );
});

test('the retirement CLI constructs the fixed provider profile from one semantic application', () => {
  assert.deepEqual(
    retireProviderApplicationRequestFromArgs(['--retire-provider-application', 'example-public-app']),
    {
      kind: 'package-owned-deployment-request',
      profile: 'fly-retire-application',
      parameters: { application: 'example-public-app' },
    },
  );
  assert.equal(retireProviderApplicationRequestFromArgs([]), null);
  assert.throws(
    () => retireProviderApplicationRequestFromArgs(['--retire-provider-application', 'x; fly apps list']),
    /one semantic provider application/,
  );
  assert.throws(
    () => retireProviderApplicationRequestFromArgs(['--retire-provider-application', 'example-public-app', '--request', '{}']),
    /accepts only one/,
  );
});

test('the running-app retirement action exposes only one semantic application binding', () => {
  const manifest = JSON.parse(readFileSync(new URL('../things-to-store-and-run.json', import.meta.url), 'utf8'));
  const definition = manifest.things.find((thing) =>
    thing.address === 'package::hosted-public-app::workflow-action::retire-provider-application')?.payload;
  assert.ok(definition);
  assert.deepEqual(definition.input_schema, {
    type: 'object',
    required: ['provider_application'],
    properties: { provider_application: { type: 'string' } },
    additionalProperties: false,
  });
  const serialized = JSON.stringify(definition);
  assert.match(serialized, /--retire-provider-application/);
  assert.doesNotMatch(serialized, /--request|site-root|"profile"|"command"/);
  const ask = definition.steps.find((step) => step.id === 'retire');
  assert.equal(ask.config.name, 'compute.process_sequence');
  const [prepare, retire] = ask.config.input.steps;
  assert.deepEqual(prepare.process.argv.slice(0, 3), [
    'node', 'run-provider-deploy.mjs', '--retire-provider-application',
  ]);
  assert.deepEqual(retire.process.argv.slice(0, 3), ['fly', 'apps', 'destroy']);
  assert.equal(retire.process.argv.at(-1), '--yes');
  assert.deepEqual(retire.process.env, { FLY_CONFIG_DIR: 'fly-config' });
});

test('the running-app environment action exposes semantic values, never a remote command', () => {
  const manifest = JSON.parse(readFileSync(new URL('../things-to-store-and-run.json', import.meta.url), 'utf8'));
  const definition = manifest.things.find((thing) =>
    thing.address === 'package::hosted-public-app::workflow-action::advance-installed-app-process-environment')?.payload;
  assert.ok(definition);
  assert.deepEqual(definition.input_schema, {
    type: 'object',
    required: ['provider_application', 'provider_credential_key', 'app_id', 'environment_name', 'environment_value'],
    properties: {
      provider_application: { type: 'string' },
      provider_credential_key: { type: 'string' },
      app_id: { type: 'string' },
      environment_name: { type: 'string' },
      environment_value: { type: 'string' },
    },
    additionalProperties: false,
  });
  const mount = definition.steps.find((step) => step.id === 'credential_mount');
  assert.equal(mount.config.definition_id, 'action:resolve-one-credential-mount');
  assert.equal(mount.config.inputs.mount.mount_path, 'fly-config/config.yml');
  const prepare = definition.steps.find((step) => step.id === 'prepare');
  assert.equal(prepare.config.name, 'compute.process');
  assert.deepEqual(prepare.config.input.argv.slice(0, 5), [
    'node', 'run-provider-deploy.mjs', '--prepare-installed-app-process-environment',
    '--provider-application',
    { $kind: 'binding', select: { from: 'input', path: 'provider_application' } },
  ]);
  const process = definition.steps.find((step) => step.id === 'advance_and_reopen');
  assert.equal(process.config.name, 'compute.process_sequence');
  assert.deepEqual(process.config.input.steps.map((step) => step.process.argv.slice(0, 3)), [
    ['fly', 'ssh', 'console'],
    ['fly', 'apps', 'restart'],
  ]);
  assert.ok(process.config.input.steps.every((step) => step.process.env.FLY_CONFIG_DIR === 'fly-config'));
  const serialized = JSON.stringify(definition);
  assert.doesNotMatch(serialized, /open-bitfield-app|\/opt\/bitfield|"executable"/);
});

