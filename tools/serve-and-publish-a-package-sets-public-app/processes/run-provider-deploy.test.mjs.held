  const { spawned, spawnChild } = recordingSpawn(['https://published.example/\n']);
  const result = await runProviderDeployment({
    descriptor: releaseRow('vercel'),
    spawnChild,
    parentEnv,
    resultFile,
    writeStdout() {},
    writeStderr() {},
    createId: () => 'test-id',
  });

  assert.deepEqual(result, { schema: 'publication-deployment-result/v1', share_url: 'https://published.example/' });
  // Same command/args the pinned script used, and the full parent env (no
  // env_passthrough on the Vercel row) — identical to the retired invocation.
  assert.deepEqual(spawned, [{
    command: 'npx',
    args: ['--yes', 'vercel@56.4.1', 'deploy', '--prebuilt', '--prod', '--yes'],
    options: { stdio: ['ignore', 'pipe', 'pipe'], env: { PATH: '/usr/bin', VERCEL_TOKEN: 'redacted-secret' } },
  }]);
  assert.deepEqual(JSON.parse(readFileSync(resultFile, 'utf8')), {
    schema: 'publication-deployment-result/v1',
    share_url: 'https://published.example/',
  });
  assert.deepEqual(readdirSync(root), ['deployment-result.json']); // L136-EXEMPT: a test reading its own workspace
});

