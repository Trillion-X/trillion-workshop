  assert.deepEqual(
    packageOwnedDeploymentPlan({
      ...descriptor,
      parameters: { ...descriptor.parameters, command: 'fly apps destroy victim' },
    }).steps,
    packageOwnedDeploymentPlan(descriptor).steps,
  );
});

