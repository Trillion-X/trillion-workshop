    const pathname = new URL(url).pathname;
    const method = options.method;
    let answer;
    if (method === 'GET' && pathname.endsWith('/machines')) answer = [live, trial];
    else if (method === 'POST' && pathname.endsWith('/machines')) answer = trial;
    else if (method === 'GET' && pathname.endsWith('/machines/trial-machine')) answer = trial;
    else if (method === 'POST' && pathname.endsWith('/exec')) {
      answer = { stdout: JSON.stringify({ status: 503, summary: { target_count: 0, message: 'not ready' } }) };
    } else if (method === 'DELETE' && pathname.includes('/machines/trial-machine')) answer = {};
    else throw new Error(`unexpected provider request: ${method} ${pathname}`);
    return { ok: true, text: async () => JSON.stringify(answer) };
  };
  await assert.rejects(proveTheReleaseStarts({
    application: 'example-public-app', image: 'registry.fly.io/example-public-app:after',
    credential: 'test-credential', fetchImplementation,
    wait: async () => {}, attempts: 1, intervalMs: 0,
  }), /release refused/);
});

test('a built image can be retried through the same trial and live confirmation owner', () => {
  const image = 'registry.fly.io/example-public-app:release-abc123';
  const plan = packageOwnedDeploymentPlan({
    kind: 'package-owned-deployment-request', profile: 'fly-prebuilt-image',
    parameters: { application: 'example-public-app', image },
  });
  assert.equal(plan.steps[1].proof, 'the-release-starts');
  assert.equal(plan.steps[1].image, image);
  assert.ok(plan.steps[2].args.includes(image));
  assert.throws(() => packageOwnedDeploymentPlan({
    kind: 'package-owned-deployment-request', profile: 'fly-prebuilt-image',
    parameters: { application: 'example-public-app', image: 'registry.fly.io/other-app:release-abc123' },
  }), /does not belong/);
});

function relativeStaticImportClosure(entrypoint) {
  const visited = new Set();
  const visit = (file) => {
    const real = realpathSync(file);
    if (visited.has(real)) return;
    visited.add(real);
    const source = readFileSync(real, 'utf8');
    const imports = source.matchAll(/(?:import|export)\s+(?:[\s\S]*?\s+from\s+)?['"]([^'"]+)['"]/g);
    for (const match of imports) {
      if (!match[1].startsWith('.')) continue;
      visit(path.resolve(path.dirname(real), match[1]));
    }
  };
  visit(entrypoint);
  return [...visited];
}

test('the provider deploy entrypoint static closure stays inside its owning package', () => {
  const packageRoot = realpathSync(path.resolve(path.dirname(fileURLToPath(import.meta.url)), '..'));
  const closure = relativeStaticImportClosure(fileURLToPath(new URL('./run-provider-deploy.mjs', import.meta.url)));
  assert.ok(closure.some((file) => file.endsWith('provider-credential.mjs')));
  assert.ok(!closure.some((file) => file.endsWith('ask-the-host-provider-for-a-certificate.mjs')));
  for (const file of closure) {
    assert.ok(
      file === packageRoot || file.startsWith(`${packageRoot}${path.sep}`),
      `deploy entrypoint imported source outside hosted-public-app: ${file}`,
    );
  }
});

// Provider/application instances belong to package-set DATA, never this generic
// package's manifest. These deliberately fictional fixtures exercise the open
// descriptor seam without installing one customer's deploy into every set.
const RELEASE_FIXTURES = {
  vercel: {
    kind: 'package-owned-deployment-request', schema: 'hosted-public-app.deployment-request/v2',
    profile: 'vercel-prebuilt-production', parameters: {},
  },
  cloudflare: {
    kind: 'package-owned-deployment-request', schema: 'hosted-public-app.deployment-request/v2',
    profile: 'cloudflare-pages', parameters: { application: 'example-public-app', artifact_directory: 'artifact' },
  },
  fly: {
    kind: 'package-owned-deployment-request', schema: 'hosted-public-app.deployment-request/v2',
    profile: 'fly-remote-only', parameters: { application: 'example-public-app', config_file: 'fly.toml' },
  },
  railway: {
    kind: 'package-owned-deployment-request', schema: 'hosted-public-app.deployment-request/v2',
    profile: 'railway-service', parameters: { application: 'example-public-app', domain: 'example-public-app.invalid' },
  },
};

function releaseRow(provider) {
  const row = RELEASE_FIXTURES[provider];
  assert.ok(row, `test release fixture for ${provider} must exist`);
  return structuredClone(row);
}

function fixture() {
  const root = mkdtempSync(path.join(tmpdir(), 'hosted-provider-deploy-'));
  return { root, resultFile: path.join(root, 'deployment-result.json') };
}

function child() {
  const result = new EventEmitter();
  result.stdin = new PassThrough();
  result.stdout = new PassThrough();
  result.stderr = new PassThrough();
  return result;
}

/** Spawn mock: records every invocation and drives each child to a clean exit
 * on the next microtask so a multi-step release runs to completion. */
function recordingSpawn(stdoutByStep = []) {
  const spawned = [];
  function spawnChild(command, args, options) {
    const step = child();
    spawned.push({ command, args, options });
    const data = stdoutByStep[spawned.length - 1];
    queueMicrotask(() => {
      if (typeof data === 'string') step.stdout.end(data);
      step.emit('close', 0, null);
    });
    return step;
  }
  return { spawned, spawnChild };
}

function tarWithFile(name, bytes, mode = 0o644) {
  const content = Buffer.from(bytes);
  const header = Buffer.alloc(512);
  header.write(name, 0, 100, 'utf8');
  header.write(`${mode.toString(8).padStart(7, '0')}\0`, 100, 8, 'ascii');
  header.write(`${content.length.toString(8).padStart(11, '0')}\0`, 124, 12, 'ascii');
  header[156] = '0'.charCodeAt(0);
  header.write('ustar\0', 257, 6, 'ascii');
  return Buffer.concat([
    header,
    content,
    Buffer.alloc((512 - (content.length % 512)) % 512),
    Buffer.alloc(1024),
  ]);
}

test('deployment receives its bounded semantic request without an intermediary file', () => {
  const root = mkdtempSync(path.join(tmpdir(), 'hosted-publication-workspace-'));
  try {
    const siteRoot = path.join(root, 'site');
    mkdirSync(siteRoot);
    assert.deepEqual(
      deploymentRequestFromArgs(['--request', JSON.stringify(releaseRow('fly')), '--site-root', 'site'], root),
      { descriptor: releaseRow('fly'), siteRoot: realpathSync(siteRoot) },
    );
  } finally {
    rmSync(root, { recursive: true, force: true });
  }
});

test('runtime diagnostics is a fixed read-only command, not a caller-authored remote shell', () => {
  const descriptor = {
    kind: 'package-owned-deployment-request',
    profile: 'fly-runtime-diagnostics',
    parameters: { application: 'example-public-app' },
  };
  const plan = packageOwnedDeploymentPlan(descriptor);
  assert.deepEqual(plan.steps, [
    {
      command: 'fly',
      args: [
        'ssh', 'console', '--app', 'example-public-app', '--command',
        "find /var/lib/bitfield -type f -name 'bitfield-runner-stderr.latest.log' -exec tail -200 {} \\;",
      ],
    },
  ]);
  const ignoredCallerCommand = packageOwnedDeploymentPlan({
    ...descriptor,
    parameters: { ...descriptor.parameters, command: 'id' },
  });
  assert.deepEqual(ignoredCallerCommand.steps, plan.steps);
});

