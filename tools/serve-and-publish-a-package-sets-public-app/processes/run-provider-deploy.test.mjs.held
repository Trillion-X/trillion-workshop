    });
    assert.deepEqual(spawned[0].options.env, { PATH: '/usr/bin', FLY_API_TOKEN: 'secret' });
    assert.equal(readdirSync(root).length, 0); // L136-EXEMPT: a test reading its own workspace
  } finally {
    rmSync(root, { recursive: true, force: true });
  }
});

test('a Fly secret reaches the provider only through stdin', async () => {
  const descriptor = {
    kind: 'package-owned-deployment-request',
    profile: 'fly-secret-from-environment',
    parameters: { application: 'example-public-app', secret_name: 'PROVIDER_SECRET' },
  };
  const { spawned, spawnChild } = recordingSpawn([]);
  const input = [];
  const wrappedSpawn = (...args) => {
    const process = spawnChild(...args);
    process.stdin.on('data', (chunk) => input.push(String(chunk)));
    return process;
  };
  await runProviderDeployment({
    descriptor,
    spawnChild: wrappedSpawn,
    parentEnv: {
      HOME: '/home/example',
      PATH: '/usr/bin',
      FLY_API_TOKEN: 'fly-token',
      PROVIDER_SECRET: 'provider-secret-value',
    },
    resultFile: null,
    writeStdout() {},
    writeStderr() {},
  });
  assert.deepEqual(spawned[0].args, ['secrets', 'import', '--app', 'example-public-app']);
  assert.deepEqual(spawned[0].options.env, {
    HOME: '/home/example', PATH: '/usr/bin', FLY_API_TOKEN: 'fly-token',
  });
  assert.deepEqual(spawned[0].options.stdio, ['pipe', 'pipe', 'pipe']);
  assert.deepEqual(input, ['PROVIDER_SECRET=provider-secret-value\n']);
  assert.equal(JSON.stringify(spawned).includes('provider-secret-value'), false);
});

test('a Fly secret operation fails before provider contact when its value is absent', async () => {
  const descriptor = {
    kind: 'package-owned-deployment-request',
    profile: 'fly-secret-from-environment',
    parameters: { application: 'example-public-app', secret_name: 'PROVIDER_SECRET' },
  };
  let spawned = false;
  await assert.rejects(
    runProviderDeployment({
      descriptor,
      spawnChild() { spawned = true; return child(); },
      parentEnv: { PATH: '/usr/bin', FLY_API_TOKEN: 'fly-token' },
      resultFile: null,
    }),
    /deployment secret environment PROVIDER_SECRET is missing/,
  );
  assert.equal(spawned, false);
});

test('a provider environment secret is read without returning provider error content', async () => {
  const source = {
    provider: 'vercel', project: 'prj_example1234', organization: 'team_example1234',
    environment: 'production', name: 'SOURCE_SECRET', destination_name: 'DESTINATION_SECRET',
  };
  const calls = [];
  assert.equal(await providerEnvironmentSecret(source, {
    token: 'vercel-token',
    fetchImplementation: async (url, options) => {
      calls.push({ url: String(url), options });
      return { ok: true, status: 200, json: async () => ({ env: { SOURCE_SECRET: 'secret-value' } }) };
    },
  }), 'secret-value');
  assert.deepEqual(calls, [{
    url: 'https://api.vercel.com/v3/env/pull/prj_example1234/production?source=hosted-public-app%3Acopy-provider-environment-secret&teamId=team_example1234',
    options: { headers: { authorization: 'Bearer vercel-token' } },
  }]);
  await assert.rejects(
    providerEnvironmentSecret(source, {
      token: 'vercel-token',
      fetchImplementation: async () => ({ ok: false, status: 403, text: async () => 'provider-secret-output' }),
    }),
    /status 403/,
  );
});

test('a provider environment secret transfers directly to Fly stdin', async () => {
  const descriptor = {
    kind: 'package-owned-deployment-request',
    profile: 'copy-provider-environment-secret',
    parameters: {
      source_provider: 'vercel',
      source_project: 'prj_example1234',
      source_organization: 'team_example1234',
      source_environment: 'production',
      source_secret_name: 'SOURCE_SECRET',
      destination_provider: 'fly',
      destination_application: 'example-public-app',
      destination_secret_name: 'DESTINATION_SECRET',
    },
  };
  const { spawned, spawnChild } = recordingSpawn([]);
  const input = [];
  const wrappedSpawn = (...args) => {
    const process = spawnChild(...args);
    process.stdin.on('data', (chunk) => input.push(String(chunk)));
    return process;
  };
  const result = await runProviderDeployment({
    descriptor,
    spawnChild: wrappedSpawn,
    parentEnv: { HOME: '/home/example', PATH: '/usr/bin', FLY_API_TOKEN: 'fly-token' },
    fetchImplementation: async () => ({
      ok: true, status: 200, json: async () => ({ env: { SOURCE_SECRET: 'provider-secret-value' } }),
    }),
    readVercelCredential: () => 'vercel-token',
    resultFile: null,
    writeStdout() {},
    writeStderr() {},
  });
  assert.deepEqual(result, {
    schema: 'publication-deployment-result/v1',
    share_url: 'https://example-public-app.fly.dev/',
  });
  assert.deepEqual(spawned[0].args, ['secrets', 'import', '--app', 'example-public-app']);
  assert.deepEqual(spawned[0].options.env, {
    HOME: '/home/example', PATH: '/usr/bin', FLY_API_TOKEN: 'fly-token',
  });
  assert.deepEqual(input, ['DESTINATION_SECRET=provider-secret-value\n']);
  assert.equal(JSON.stringify(spawned).includes('provider-secret-value'), false);
  assert.equal(JSON.stringify(result).includes('provider-secret-value'), false);
});

test('deployment cannot follow a site-root link outside its contained workspace', () => {
  const root = mkdtempSync(path.join(tmpdir(), 'hosted-publication-workspace-'));
  const outside = mkdtempSync(path.join(tmpdir(), 'hosted-publication-outside-'));
  try {
    symlinkSync(outside, path.join(root, 'redirected-site'));
    assert.throws(
      () => deploymentRequestFromArgs(['--request', JSON.stringify(releaseRow('fly')), '--site-root', 'redirected-site'], root),
      /ordinary directory/,
    );
  } finally {
    rmSync(root, { recursive: true, force: true });
    rmSync(outside, { recursive: true, force: true });
  }
});

function packageSourceFiles(root) {
  const files = [];
  for (const entry of readdirSync(root, { withFileTypes: true })) { // L136-EXEMPT: a test reading its own workspace
    if (entry.isDirectory()) {
      if (!['__tests__', 'built-stored-bytes', 'node_modules'].includes(entry.name)) {
        files.push(...packageSourceFiles(path.join(root, entry.name)));
      }
    } else if (entry.isFile() && /\.(?:mjs|js|ts|tsx)$/.test(entry.name) && !entry.name.includes('.test.')) {
      files.push(path.join(root, entry.name));
    }
  }
  return files;
}

// Private workspaces are permitted inside the publication owner. The prohibited
// lifecycle is caller-addressable build/output state, not temporary file IO.
test('hosted-public-app source has no separately addressable app-build lifecycle', () => {
  const packageRoot = realpathSync(path.resolve(path.dirname(fileURLToPath(import.meta.url)), '..'));
  const removedConcepts = [
    '--artifact-root',
    'build-input-identity',
    'package-set-builds',
    'disposable-hosted-build',
    'preview-built-public-entry',
    '--release-descriptor-file',
  ];
  for (const file of packageSourceFiles(packageRoot)) {
    const source = readFileSync(file, 'utf8');
    for (const removedConcept of removedConcepts) {
      assert.equal(source.includes(removedConcept), false, `${file} reintroduced ${removedConcept}`);
    }
  }
});

test('extraction parity: one-https-url-on-stdout matches the retired Vercel rule exactly', () => {
  const rule = { strategy: 'one-https-url-on-stdout', source: 'stdout' };
  assert.deepEqual(
    deploymentResultFromExtraction(rule, { stdout: 'https://published.example/\n', stderr: '' }),
    { schema: 'publication-deployment-result/v1', share_url: 'https://published.example/' },
  );
  for (const stdout of [
    '',
    'https://one.example/ https://two.example/',
    'https://published.example/',
    'https://published.example/?token=secret',
    'https://published.example/#fragment',
    'https://published.example:8443/',
  ]) {
    assert.throws(() => deploymentResultFromExtraction(rule, { stdout, stderr: '' }));
  }
});

test('the Vercel request reproduces the retired deploy behavior', async () => {
  const { root, resultFile } = fixture();
