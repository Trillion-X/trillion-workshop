// EVERY INSTALLED PACKAGE SET'S OWN DESCRIPTION IS RENDERED, not a fixture's.
//
// The four dead-engine suites all serve a tenant that is deliberately NOT the product, because
// that is the only way to prove the shells are generic: a pass against production copy could
// come from accidental agreement. That design has a hole exactly its own shape. Nothing ever
// renders the description a real package set ships, so a typo in the live JSON, a fallback body
// moved on disk, or a stylesheet path that stopped resolving would leave all four suites GREEN
// and answer 503 to a visitor.
//
// "Does the generic server run" and "can this tenant's DATA actually serve" are different questions.
// This file asks the second one for every installed set with a description, so a second package set
// is covered the day it is installed rather than the day
// somebody remembers to add it here.
//
// It asserts NO copy. Asserting the live headline would make an editorial change a test failure,
// which teaches people to edit tests to ship words. It asserts only that the tenant's OWN
// declared values reach its OWN page: whatever `title` says appears as the title, whatever
// `fallback_body_file` contains appears in the body, whatever `shell_css_file` contains appears
// in the styles. The description is the expected value, so this cannot go stale.

import { spawn } from 'node:child_process';
import { mkdtemp, readFile, readdir, rm, writeFile } from 'node:fs/promises';
import { existsSync } from 'node:fs';
import { tmpdir } from 'node:os';
import { join } from 'node:path';
import { createServer } from 'node:net';
import { request as httpRequest } from 'node:http';
import { theBuiltEntryServer, PACKAGE_SETS_DIR } from './built-entry-server.mjs';
import { describedFileAt } from '../read-data/described-file-at.mjs';

let failures = 0;
function check(name, ok, detail = '') {
  console.log(`  ${ok ? 'PASS' : 'FAIL'}  ${name}${ok || !detail ? '' : `, ${detail}`}`);
  if (!ok) failures += 1;
}

function freePort() {
  return new Promise((resolve, reject) => {
    const probe = createServer();
    probe.on('error', reject);
    probe.listen(0, '127.0.0.1', () => {
      const { port } = probe.address();
      probe.close(() => resolve(port));
    });
  });
}

function get(port, path, host) {
  return new Promise((resolve, reject) => {
    const req = httpRequest(
      { host: '127.0.0.1', port, path, method: 'GET', headers: { Host: host, Accept: 'text/html' } },
      (response) => {
        let body = '';
        response.setEncoding('utf8');
        response.on('data', (c) => { body += c; });
        response.on('end', () => resolve({ status: response.statusCode, body }));
      },
    );
    req.on('error', reject);
    req.end();
  });
}

async function waitForListening(port, host) {
  for (let attempt = 0; attempt < 60; attempt += 1) {
    try {
      const answer = await get(port, '/', host);
      if (answer.status) return true;
    } catch {
      await new Promise((r) => setTimeout(r, 100));
    }
  }
  return false;
}

// EVERY SET THAT SHIPS A DESCRIPTION, not every set that has already been BUILT.
//
// This used to walk the built servers and look for a description beside each one, so a set was
// checked only once it had its own binary. That is backwards for the thing under test: the
// DESCRIPTION is what is being checked, one canonical binary serves every set, and the state where
// a set has a description and no binary yet is exactly the state a migration passes through. Under
// the old predicate a set's first description, the one most likely to be wrong, was the one nobody
// checked.
const { server: SERVER, note: serverNote, reason: noServerReason } = await theBuiltEntryServer();
if (!SERVER) {
  // Exit 1 rather than skip, matching every other suite here: a test that passes when its
  // subject is absent cannot fail.
  console.log(`FAIL: ${noServerReason}`);
  process.exit(1);
}
console.log(serverNote);

const describedSets = (await readdir(PACKAGE_SETS_DIR))
  .map((set) => ({ set, descriptionFile: join(PACKAGE_SETS_DIR, set, 'deploy', 'page-description.json') }))
  .filter(({ descriptionFile }) => existsSync(descriptionFile));
if (describedSets.length === 0) {
  console.log(`FAIL: no package set under ${PACKAGE_SETS_DIR} ships a deploy/page-description.json.`);
  console.log('A set may legitimately serve from engine records instead, but then this suite has'
    + ' nothing to check and saying so beats reporting green.');
  process.exit(1);
}

let setsChecked = 0;
for (const { set, descriptionFile } of describedSets) {
  const server = SERVER;
  console.log(`\n${set}`);
  setsChecked += 1;

  const described = JSON.parse(await readFile(descriptionFile, 'utf8'));
  const page = Array.isArray(described?.pages) ? described.pages[0] : undefined;
  check('its description parses and yields a page', Boolean(page),
    'pages[] is missing or empty, which is the shape the server requires');
  if (!page) continue;

  const host = Array.isArray(page.hosts) && page.hosts.length > 0
    ? page.hosts[0]
    : `${set}.description-proof.test`;
  const staticDir = await mkdtemp(join(tmpdir(), 'set-description-proof-'));
  const installRoot = await mkdtemp(join(tmpdir(), 'set-description-install-'));
  await writeFile(join(staticDir, 'index.html'),
    '<!DOCTYPE html>\n<html><head></head><body>'
    + '<!--BITFIELD_ENTRY_ROOT_START--><div id="root"></div><!--BITFIELD_ENTRY_ROOT_END-->'
    + '</body></html>\n', 'utf8');

  const port = await freePort();
  const deadEnginePort = await freePort();
  const child = spawn(process.execPath, [server], {
    env: {
      ...process.env,
      BITFIELD_PUBLIC_ENTRY_LISTEN_HOST: '127.0.0.1',
      BITFIELD_PUBLIC_ENTRY_LISTEN_PORT: String(port),
      BITFIELD_PUBLIC_ENTRY_SHELL_URL: `http://127.0.0.1:${deadEnginePort}`,
      BITFIELD_BROWSER_STATIC_DIR: staticDir,
      BITFIELD_HOST_ENTRY_SCENE_HOSTS: host,
      BITFIELD_PUBLIC_PAGE_DESCRIPTION_FILE: descriptionFile,
      BITFIELD_INSTALL_ROOT: installRoot,
      BITFIELD_BOOT_WAIT_MS: '1000',
    },
    stdio: ['ignore', 'pipe', 'pipe'],
  });
  child.stdout.on('data', () => {});
  child.stderr.on('data', () => {});

  try {
    const up = await waitForListening(port, host);
    check('the generic server boots with this set', up, 'it never answered');
    if (!up) continue;

    // The expected values come FROM the description, so editorial changes never break this.
    const landing = await get(port, '/', host);
    check('its own host is served rather than refused', landing.status === 200,
      `got ${landing.status}, which for 503 means this set describes no entry for ${host}`);
    check('its own title reaches the page',
      !page.title || landing.body.includes(page.title),
      'the title in the description is absent from the rendered document');

    const noscriptRoute = page?.island?.noscript_route;
    let fallback = landing;
    if (noscriptRoute) {
      fallback = await get(port, noscriptRoute, host);
      check('the route it advertises to no-script visitors serves',
        fallback.status === 200, `${noscriptRoute} answered ${fallback.status}`);
    }
    {
      // THE FILE CHECKS ARE NOT NESTED UNDER THE NO-SCRIPT ROUTE, and they used to be. Any set can
      // declare a body and a stylesheet, but only a set with a client island declares a route for
      // visitors who cannot run it, so a set whose landing IS server-rendered markup had both files
      // silently unchecked: the same mistake as the server's own, a property of one page shape
      // gating something every shape has. The page to inspect is the one those files land on, which
      // is the no-script route when there is one and the landing itself when there is not.
      // WHERE the description says is the SERVER's rule, not this suite's, so it comes from the
      // one owner both of them read. Checking `existsSync(named)` raw was right only while every
      // description named absolute paths, and it went red the day two of them stopped.
      const bodyAt = describedFileAt(page.fallback_body_file, descriptionFile).path;
      const shellCssAt = describedFileAt(page.shell_css_file, descriptionFile).path;
      if (page.fallback_body_file) {
        check('its fallback_body_file is on disk where the description says',
          Boolean(bodyAt) && existsSync(bodyAt), `${page.fallback_body_file} -> ${bodyAt}`);
        if (bodyAt && existsSync(bodyAt)) {
          const body = await readFile(bodyAt, 'utf8');
          const firstTag = body.trim().split('\n')[0].slice(0, 60);
          check('and its contents reach that page',
            fallback.body.includes(firstTag),
            'the body file was not rendered into the page it belongs to');
        }
      }
      if (page.shell_css_file) {
        check('its shell_css_file is on disk where the description says',
          Boolean(shellCssAt) && existsSync(shellCssAt), `${page.shell_css_file} -> ${shellCssAt}`);
        if (shellCssAt && existsSync(shellCssAt)) {
          const css = await readFile(shellCssAt, 'utf8');
          const firstRule = css.split('\n').find((line) => line.trim().startsWith('.')
            || line.trim().startsWith(':root'));
          check('and its stylesheet reaches that page',
            !firstRule || fallback.body.includes(firstRule.trim().slice(0, 40)),
            'the shell stylesheet was not inlined into the page');
        }
      }
    }
  } finally {
    child.kill('SIGKILL');
    await rm(staticDir, { recursive: true, force: true });
    await rm(installRoot, { recursive: true, force: true });
  }
}

console.log('');
if (setsChecked === 0) {
  console.log('FAIL: no installed package set shipped a deploy/page-description.json to check.');
  process.exit(1);
}
if (failures > 0) {
  console.log(`FAIL: ${failures} check(s) across ${setsChecked} package set(s)`);
  process.exit(1);
}
console.log(`PASS: every installed package set serves the description it ships (${setsChecked})`);
