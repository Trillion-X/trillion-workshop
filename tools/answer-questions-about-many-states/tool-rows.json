    {
      "payload": {
        "kind": "ai-tool-descriptor",
        "id": "tool:read-a-bulk-answer-run",
        "label": "Read how far a bulk answer run is, and its answers",
        "job": "How far is my bulk question run, and give me its answers",
        "description": "Says a run's status (queued, running, finished, cancelled or failed with why), how many states are answered and, once it is finished or cancelled, its answers as byte pages: {total, blake3, offset, length, base64, next_after_byte}. Ask again with after_byte set to next_after_byte until it is null, join the bytes, check the length and BLAKE3, and parse: {model, layout, questions, states, answers: [{state, answers: {question id: answer}}], seconds}. Keep what matters as rows in the person's lists; the run's folder is working space.",
        "status": "active",
        "input_schema": {
          "type": "object",
          "required": [
            "job_id",
            "jobs_folder"
          ],
          "properties": {
            "job_id": {
              "type": "string",
              "pattern": "^1f:[0-9a-f]{64}$",
              "description": "The job_id start answered: the BLAKE3 content identity of the whole request."
            },
            "jobs_folder": {
              "type": "string",
              "description": "The folder on the person's computer that holds runs while they work and until their answers are read."
            },
            "after_byte": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "output_schema": {
          "type": "object",
          "description": "{\"result\": {\"job_id\", \"status\", \"states_done\", \"states\", \"seconds\"?, \"error\"?, \"byte_page\"?}} or {\"error\": \"what to change\"}."
        },
        "invoke": {
          "kind": "container",
          "workdir": "/opt/answer-questions-about-many-states",
          "stdout": "json",
          "argv": [
            "python3",
            "-I",
            "/opt/answer-questions-about-many-states/do-work/answer_many_states.py",
            "read"
          ],
          "stdin": {
            "fill": {
              "from": "input"
            }
          },
          "programs": {
            "python3": {
              "fetch": {
                "macos-aarch64": {
                  "url": "https://github.com/astral-sh/python-build-standalone/releases/download/20261026/cpython-3.12.16%2B20261026-aarch64-apple-darwin-install_only.tar.gz",
                  "version": "3.12.16+20261026",
                  "blake3": "0f7f781e6615560e029797902ac4b869616a0ea137c4a010ff4fec5ab65275de",
                  "executable": "bin/python3.12",
                  "checked_against": "https://github.com/astral-sh/python-build-standalone/releases/download/20261026/SHA256SUMS"
                }
              },
              "runtime_read_dirs": [
                "../lib"
              ]
            }
          },
          "files": {
