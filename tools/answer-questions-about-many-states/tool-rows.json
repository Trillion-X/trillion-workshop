    {
      "payload": {
        "kind": "ai-tool-descriptor",
        "id": "tool:answer-questions-about-many-states",
        "label": "Answer the same questions about many states, in bulk, on this Mac",
        "job": "Ask the same set of questions about every one of these lines or records, all at once, with my classifier model",
        "description": "Starts a bulk run in the background: every state (text, or JSON written compactly) is asked every question, with the questions run once as a cached prefix and the states batched against them on Apple's GPU through MLX. The answer for each state and question is the classifier's probabilities over its options (choice: each option; score: each level, with the expected level; noul: the probability of yes). The job id is the BLAKE3 identity of the whole request, so the same request names the same run and a finished one is not run again. Read it with tool:read-a-bulk-answer-run; stop it with tool:cancel-a-bulk-answer-run.",
        "status": "active",
        "input_schema": {
          "type": "object",
          "required": [
            "model",
            "questions",
            "states",
            "settings",
            "jobs_folder"
          ],
          "properties": {
            "model": {
              "type": "object",
              "required": [
                "classifier",
                "weights"
              ],
              "description": "The model row from the person's list: which classifier family it is and where its weights are. No model is built in.",
              "properties": {
                "id": {
                  "type": "string",
                  "description": "The row's own id, carried into the answers."
                },
                "classifier": {
                  "type": "string",
                  "enum": [
                    "questions-first-decider"
                  ],
                  "description": "The classifier family: questions-first-decider is a Qwen3.5 hybrid decider whose questions are a cacheable prefix (decider.schema(questions).batch(states))."
                },
                "weights": {
                  "type": "object",
                  "description": "{\"folder\": a local folder} or {\"hugging_face\": {\"repo\", \"revision\"}} with a pinned revision."
                }
              }
            },
            "questions": {
              "type": "object",
              "minProperties": 1,
              "description": "{question id: {type: choice|score|noul, instructions, criteria?}}: choice criteria name 2 to 255 options, score criteria are 2 to 10 ordered levels, noul criteria may describe true and false.",
              "additionalProperties": {
                "type": "object",
                "required": [
                  "instructions"
                ],
                "properties": {
                  "type": {
                    "type": "string",
                    "enum": [
                      "choice",
                      "score",
                      "noul",
                      "bool"
                    ]
                  },
                  "instructions": {},
                  "criteria": {}
                }
              }
            },
            "states": {
              "type": "array",
              "minItems": 1,
              "description": "The states to ask about: strings, or JSON values (written compactly, long arrays numbered)."
            },
            "settings": {
              "type": "object",
              "required": [
                "layout",
                "dtype",
                "tokens_per_batch",
                "max_state_tokens",
                "page_bytes"
              ],
              "description": "The tool's settings, from the person's settings row; none has a default.",
              "properties": {
                "layout": {
                  "type": "string",
                  "enum": [
                    "independent",
                    "packed"
                  ],
                  "description": "independent: one row per question, so no question sees another (the decider's default); packed: every question in one prefix, one row per state, several times fewer tokens."
                },
                "dtype": {
                  "type": "string",
                  "enum": [
                    "bfloat16",
                    "float32"
                  ]
                },
                "tokens_per_batch": {
                  "type": "integer",
                  "minimum": 1,
                  "description": "How many tokens one GPU pass may hold."
                },
                "max_state_tokens": {
                  "type": "integer",
                  "minimum": 1,
                  "description": "The most tokens of a state the model reads; a longer state is cut there, as the decider does."
                },
                "page_bytes": {
                  "type": "integer",
                  "minimum": 1,
                  "description": "How many bytes of answers one read returns."
                }
              }
            },
            "jobs_folder": {
              "type": "string",
              "description": "The folder on the person's computer that holds runs while they work and until their answers are read."
            }
          }
        },
        "output_schema": {
          "type": "object",
          "description": "{\"result\": {\"job_id\", \"status\": \"queued\" | \"running\" | \"finished\" | \"cancelled\", \"states_done\", \"states\", \"already\"?}} or {\"error\": \"what to change\"}."
        },
        "invoke": {
          "kind": "container",
          "workdir": "/opt/answer-questions-about-many-states",
          "stdout": "json",
          "argv": [
            "python3",
            "-I",
            "/opt/answer-questions-about-many-states/do-work/answer_many_states.py",
            "start"
          ],
