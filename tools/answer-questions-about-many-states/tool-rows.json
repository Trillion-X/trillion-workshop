        "id": "tool:get-a-classifier-ready-on-this-mac",
        "label": "Get a questions-first classifier ready on this Mac",
        "job": "Get my question classifier model ready to run on my Mac",
        "description": "Takes the model's value in the request ({classifier, weights}: a pinned Hugging Face revision, or a local folder), fetches and checks the weights, and names each checked file plus the whole set by BLAKE3. It copies those verified files into one private output tree; the engine keeps the files in this account’s Files and returns their exact identities under files.snapshot. The answer holds the original model file manifest, so another computer can verify the snapshot before using it. A gated model needs the person’s own `huggingface-cli login`. Run it once per model on a computer that has the model. Nothing is written to the person's records.",
        "input_schema": {
          "type": "object",
          "required": [
            "model"
          ],
          "properties": {
            "model": {
              "type": "object",
              "required": [
                "classifier",
                "weights"
              ],
              "description": "The model's value, read by the caller from the person's list: `classifier` names the family (questions-first-decider) and `weights` says where the weights are ({\"folder\": a folder on this Mac} or {\"hugging_face\": {\"repo\", \"revision\"}} with a pinned revision). No model is built in.",
              "properties": {
                "classifier": {
                  "type": "string"
                },
                "weights": {
                  "type": "object"
                }
              }
            }
          }
        },
        "output_schema": {
          "type": "object",
          "description": "Returns {classifier, identity, files: [{name, bytes, blake3}], ready}. The engine also keeps the verified snapshot tree in Files as files.snapshot: [{name, identity, bytes, media_type}]."
        },
        "invoke": {
          "kind": "computer",
          "capabilities": [
            "start-a-program"
          ],
          "workdir": "/opt/answer-questions-about-many-states",
          "internet": true,
