                  "version": "3.12.16+20261026",
                  "blake3": "0f7f781e6615560e029797902ac4b869616a0ea137c4a010ff4fec5ab65275de",
                  "executable": "bin/python3.12",
                  "checked_against": "https://github.com/astral-sh/python-build-standalone/releases/download/20261026/SHA256SUMS"
                }
              },
              "runtime_read_dirs": [
                "../lib"
              ]
            }
          },
          "packages": {
            "anyio": {
              "version": "4.16.0",
              "archive": "zip",
