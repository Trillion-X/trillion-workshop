            "answers": {
              "type": "boolean"
            },
            "after": {
              "type": "string",
              "maxLength": 200
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200
            }
          }
        },
        "output_schema": {
          "type": "object",
          "description": "{run, status, states, states_done, ...measurements, answers?: [{state, answers}], next_after?}"
        },
