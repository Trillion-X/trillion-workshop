              {
                "package": "answer-questions-about-many-states",
                "paths": [
                  "do-work"
                ],
                "at": "/opt/answer-questions-about-many-states"
              }
            ]
          },
          "needs": [
            "a Mac with Apple silicon: the pinned wheels are published for macOS arm64 only, so tools:list says runs_here false elsewhere"
          ],
          "say": "The engine runs this on the person's own Mac with the pinned Python this row names, the request on standard input. It reads the job folder only, so it needs no wheel."
        },
        "result_selector": "$.result",
        "verify": [
          {
