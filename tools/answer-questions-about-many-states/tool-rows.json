  "record_set": "answer-questions-about-many-states-tool-rows",
  "what_this_is": "The Workshop rows for the answer-questions-about-many-states folder: get a questions-first classifier ready on the person's Mac, start a bulk run of one question set over many states, read its status and paged answers, and cancel it.",
  "records": [
    {
      "payload": {
        "kind": "ai-tool-descriptor",
        "id": "tool:get-a-classifier-ready-on-this-mac",
        "label": "Get a questions-first classifier ready on this Mac",
        "job": "Get my question classifier model ready to run on my Mac",
        "description": "Fetches the weights a model row names (a pinned Hugging Face revision, or a local folder), checks they are a classifier family this tool runs (questions-first-decider: config.json, decider_config.json, the tokenizer and safetensors weights), and names them: the BLAKE3 identity of every file and of the whole set, to keep beside the model row. A gated model needs the person's own `huggingface-cli login`. Run it once per model row before start.",
        "status": "active",
        "input_schema": {
          "type": "object",
          "required": [
            "model"
          ],
          "properties": {
            "model": {
              "type": "object",
              "required": [
                "classifier",
                "weights"
              ],
              "description": "The model row from the person's list: which classifier family it is and where its weights are. No model is built in.",
              "properties": {
                "id": {
                  "type": "string",
                  "description": "The row's own id, carried into the answers."
                },
                "classifier": {
                  "type": "string",
                  "enum": [
                    "questions-first-decider"
                  ],
                  "description": "The classifier family: questions-first-decider is a Qwen3.5 hybrid decider whose questions are a cacheable prefix (decider.schema(questions).batch(states))."
                },
                "weights": {
                  "type": "object",
                  "description": "{\"folder\": a local folder} or {\"hugging_face\": {\"repo\", \"revision\"}} with a pinned revision."
                }
              }
            }
          }
        },
        "output_schema": {
          "type": "object",
          "description": "{\"result\": {\"model\", \"classifier\", \"folder\", \"identity\", \"files\": [{\"name\", \"bytes\", \"blake3\"}], \"ready\"}} or {\"error\": \"what to change\"}."
        },
        "invoke": {
          "kind": "container",
          "workdir": "/opt/answer-questions-about-many-states",
          "stdout": "json",
          "argv": [
            "python3",
            "-I",
            "/opt/answer-questions-about-many-states/do-work/answer_many_states.py",
            "get-ready"
