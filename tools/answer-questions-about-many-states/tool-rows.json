              }
            ]
          },
          "get_it": [
            "clone the Workshop repository (package.json repository.url)",
            "python3 -m pip install -U mlx==0.32.3 mlx-lm==0.32.2 transformers==5.22.2 numpy tokenizers blake3 huggingface_hub"
          ],
          "needs": [
            "a Mac with Apple silicon",
            "python3 with mlx 0.32.3, mlx-lm 0.32.2, transformers 5.22.2, numpy, tokenizers, blake3 and huggingface_hub (the get_it commands)"
          ],
          "programs": {
            "python3": {
              "warm": "python-script",
              "fetch": {
                "macos-aarch64": {
