{
  "kind": "package-set-records",
  "record_set": "answer-questions-about-many-states-tool-rows",
  "what_this_is": "The Workshop rows for the answer-questions-about-many-states folder, all run by the engine: get a question classifier ready on the person's Mac, answer a question set about a state set in bulk on its GPU, read a run, and stop it. Inputs and results are rows of the person's lists.",
  "records": [
    {
      "payload": {
        "kind": "ai-tool-descriptor",
        "id": "tool:get-a-classifier-ready-on-this-mac",
        "label": "Get a question classifier ready on this Mac",
        "job": "Get my question classifier model ready to run on my Mac",
        "description": "Fetches the weights a row of the person's Question classifiers list names (a Hugging Face repository at a pinned revision) into this tool's kept folder on their Mac, once: each file is checked against the size and SHA-256 the repository lists, and only the files the classifier family needs are fetched. Writes the BLAKE3 identity of the set back to the row. Run it once per classifier before its first run. A gated model's weights cannot be fetched yet (no account is sent).",
        "input_schema": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "classifier"
          ],
          "properties": {
            "classifier": {
              "type": "string",
              "maxLength": 200,
              "description": "A row id of the person's Question classifiers list."
            }
          }
        },
        "output_schema": {
          "type": "object",
          "description": "{classifier, identity, files: [{name, bytes, sha256}], ready}"
        },
        "invoke": {
          "kind": "computer",
          "capabilities": [],
          "workdir": "/opt/answer-questions-about-many-states",
          "internet": true,
          "stdout": "json",
          "argv": [
            "python3",
            "-I",
            "/opt/answer-questions-about-many-states/do-work/run_in_engine.py",
            "get-ready",
            {
              "fill": {
                "from": "task",
                "field": "kept_folder"
              }
            }
          ],
          "stdin": {
            "fill": {
              "from": "input"
            }
          },
          "records": {
            "fd": 3,
            "rights": [
              {
                "kind": "list",
                "id": "list:classifiers",
                "operations": [
                  "records:read",
                  "records:write"
                ]
              },
              {
                "kind": "record:classifier",
                "operations": [
                  "records:read",
                  "records:write"
                ]
              }
            ],
            "most_writes": 128
          },
          "files": {
            "package_files": [
              {
                "package": "answer-questions-about-many-states",
                "paths": [
                  "do-work",
                  "read-data"
                ],
                "at": "/opt/answer-questions-about-many-states"
              },
              {
                "package": "conversations",
                "paths": [
                  "read-data/content_identity.py"
                ],
                "at": "/opt/conversations"
              }
            ]
          },
          "kept_folder": true,
          "max_run_ms": 3600000
        },
        "needs": {
          "expected_seconds": 600,
          "network_egress": true
        },
        "verify": [
          {
            "kind": "needs-a-machine",
            "requires": "the internet to huggingface.co and a classifier row naming a public repository at a pinned revision",
            "proved_on": null
          }
        ],
        "result_selector": "$.result",
        "maker": "maker:answer-questions-about-many-states",
        "licence_class": "licence:permissive",
        "placements": [
          "placement:your-computer"
        ],
        "provenance": {
          "source": "This folder's MLX port of the Qwen3.5 hybrid backbone and of the decider's questions-first cache (Mapika/decider-2b, Apache-2.0, snapshot b37f7e1ba3fbc9238004cf531fabbee2619973fd), with the decider lane's Metal gated-delta scan; the model's own licence applies to its weights."
        },
        "status": "active"
      }
    },
    {
      "payload": {
        "kind": "ai-tool-descriptor",
        "id": "tool:answer-questions-about-many-states",
        "label": "Answer a question set about many states, in bulk, on this Mac",
        "job": "Ask the same set of questions about every one of these lines or records, all at once, with my classifier model",
        "description": "Asks every question of one set in the person's Classifier questions list about every state of one set in their States to classify list, with a classifier from their Question classifiers list and a row of their Classifier settings, on Apple's GPU through MLX: the questions are run once as a cached prefix and the states are batched against them. Every state's answers (each option's probability, per question) are written as a row of their Classifier answers list as each batch finishes, and the run's own row in Classifier runs keeps how far it is and what it measured (load, prepare, answer and wall seconds, decisions per second). A run is named by the identity of everything it asks: the same rows answer the same run, a finished run is not run again, and a stopped or interrupted run goes on from the states it has not answered. Set Stop on the run's row (or use tool:stop-a-bulk-answer-run) to end it after the batch in hand.",
        "input_schema": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "classifier",
            "questions",
            "states",
            "settings"
          ],
          "properties": {
            "classifier": {
              "type": "string",
              "maxLength": 200,
              "description": "A row id of the Question classifiers list, made ready with tool:get-a-classifier-ready-on-this-mac."
            },
            "questions": {
              "type": "string",
              "maxLength": 200,
              "description": "The name of a question set (the Set field of Classifier questions)."
            },
            "states": {
              "type": "string",
              "maxLength": 200,
              "description": "The name of a state set (the Set field of States to classify)."
            },
            "settings": {
              "type": "string",
              "maxLength": 200,
              "description": "A row id of the Classifier settings list."
            }
          }
        },
        "output_schema": {
          "type": "object",
          "description": "{run, status: finished | stopped, states, states_done, decisions, load_seconds, prepare_seconds, answer_seconds, wall_seconds, decisions_per_second, padded_suffix_tokens, machine, already?}"
        },
        "invoke": {
          "kind": "computer",
          "capabilities": [
            "start-a-program"
          ],
          "workdir": "/opt/answer-questions-about-many-states",
          "internet": false,
          "stdout": "json",
          "argv": [
