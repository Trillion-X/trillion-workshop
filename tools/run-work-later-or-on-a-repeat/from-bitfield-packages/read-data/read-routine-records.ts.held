import {
  readPlaceableSurfaces,
  type PlaceableSurfaceRecord,
} from '@/packages/ui';

export type RoutineRecordRow = { address?: string; payload?: unknown } | Record<string, unknown>;

export interface RoutinePresentation {
  kind: 'routine-presentation';
  owner_ref: string;
  name?: string;
  purpose?: string;
  canonical_schedule_id?: string;
  internal_schedule_ids?: string[];
  output_kinds?: string[];
  provider_refs?: string[];
}

export interface RoutineControl {
  kind: 'routine-control';
  owner_ref: string;
  state: 'armed' | 'paused';
  schedule_address_label?: string;
  schedule_payload?: Record<string, unknown>;
  observed_at?: string;
}

export interface RoutineProducedRecord {
  kind: string;
  label: string;
  address: string | null;
  payload: Record<string, unknown>;
  row: RoutineRecordRow;
  latestRun: boolean;
}

export interface RoutineEvidenceSurface {
  surface: PlaceableSurfaceRecord;
  recordKinds: string[];
  records: RoutineProducedRecord[];
  latestRecordRefs: string[];
}

export interface RoutineView {
  id: string;
  ownerRef: string;
  name: string;
  purpose: string;
  cadence: string;
  status: 'armed' | 'paused' | 'blocked' | 'unscheduled';
  statusLabel: string;
  statusReason: string;
  listStatusLabel: string | null;
  listWarning: string | null;
  lastRunLabel: string;
  lastRunAt: string | null;
  scheduleId: string | null;
  scheduleAddressLabel: string | null;
  schedulePayload: Record<string, unknown> | null;
  ownerDispatch: { name: string; input: unknown } | null;
  recentRuns: Array<{ operation: string; observedAt: string | null; relativeTime: string; fullTimestamp: string; recordId: string }>;
  producedRecords: RoutineProducedRecord[];
  evidenceSurfaces: RoutineEvidenceSurface[];
  unmappedProducedRecords: RoutineProducedRecord[];
  evidenceHasExactLineage: boolean;
  evidenceExplanation: string | null;
  providers: Array<{ ref: string; slug: string; name: string }>;
  internalScheduleCount: number;
  technical: {
    actionId: string;
    actionLabel: string;
    scheduleId: string | null;
    scheduleLabel: string | null;
    internalSchedules: Array<{ id: string; label: string }>;
  };
}

export function readRoutineProviderIconRegistry(publishedRows: readonly RoutineRecordRow[]): Record<string, unknown>[] {
  return publishedRows
    .map(payload)
    .filter((value): value is Record<string, unknown> => value?.kind === 'provider-icon');
}

export interface RoutineProjectionInput {
  schedules?: RoutineRecordRow[];
  published?: RoutineRecordRow[];
  receipts?: RoutineRecordRow[];
  scheduledRecords?: RoutineRecordRow[];
  now?: string;
}

function payload(row: RoutineRecordRow): Record<string, unknown> | null {
  if (!row || typeof row !== 'object' || Array.isArray(row)) return null;
  const carrier = row as Record<string, unknown>;
  const value = carrier.payload ?? carrier;
  return value && typeof value === 'object' && !Array.isArray(value)
    ? value as Record<string, unknown>
    : null;
}

function text(value: unknown): string {
  return typeof value === 'string' ? value.trim() : '';
}

function list(value: unknown): unknown[] {
  return Array.isArray(value) ? value : [];
}

function humanize(value: string): string {
  const cleaned = value
    .replace(/^action:/, '')
    .replace(/\/v\d+$/, '')
    .replace(/[._:-]+/g, ' ')
    .replace(/\bcrm\b/gi, '')
    .replace(/\s+/g, ' ')
    .trim();
  return cleaned.replace(/\b\w/g, (letter) => letter.toUpperCase()) || 'Routine';
}

function sentenceCase(value: string): string {
  const words = value
    .replace(/^action:/, '')
    .replace(/(?:[/_-])v\d+$/, '')
    .replace(/[._:/-]+/g, ' ')
    .replace(/\s+/g, ' ')
    .trim()
    .toLowerCase()
    .split(' ')
    .filter(Boolean)
    .map((word) => ['ai', 'crm', 'dm'].includes(word) ? word.toUpperCase() : word);
  if (words.length === 0) return 'Routine';
  words[0] = words[0].charAt(0).toUpperCase() + words[0].slice(1);
  return words.join(' ');
}

function actionLabel(value: string): string {
  return sentenceCase(value);
}

export function identityTextFromAddress(address: unknown): string | null {
  const raw = text(address);
  if (!/^1f45[0-9a-f]+$/i.test(raw)) return null;
  try {
    const bytes = raw.slice(4).match(/.{2}/g)?.map((pair) => Number.parseInt(pair, 16)) ?? [];
    const decoded = new TextDecoder().decode(new Uint8Array(bytes));
    return decoded.length > 0 ? decoded : null;
  } catch {
    return null;
  }
}

function clockLabel(hourRaw: number, minuteRaw: number, includeSuffix: boolean): string {
  const suffix = hourRaw >= 12 ? 'PM' : 'AM';
  const hour = hourRaw % 12 || 12;
  const minute = minuteRaw > 0 ? `:${String(minuteRaw).padStart(2, '0')}` : '';
  return `${hour}${minute}${includeSuffix ? ` ${suffix}` : ''}`;
}

function scheduleCadence(schedule: Record<string, unknown> | null): string {
  if (!schedule) return 'Not scheduled yet';
  const cadence = schedule.cadence as Record<string, unknown> | undefined;
  const window = schedule.local_window as Record<string, unknown> | undefined;
  const unit = text(cadence?.unit);
  const interval = Number(cadence?.interval ?? 1);
  const start = text(window?.start);
  const duration = Number(window?.duration_minutes ?? 0);
  if (!unit || !start) return 'Scheduled';
  const [hourRaw, minuteRaw] = start.split(':').map(Number);
  const endMinutes = hourRaw * 60 + (minuteRaw || 0) + duration;
  const endHourRaw = Math.floor(endMinutes / 60) % 24;
  const endMinute = endMinutes % 60;
  const startSuffix = hourRaw >= 12 ? 'PM' : 'AM';
  const endSuffix = endHourRaw >= 12 ? 'PM' : 'AM';
  const startLabel = clockLabel(hourRaw, minuteRaw || 0, duration === 0 || startSuffix !== endSuffix);
  const end = duration > 0 ? `-${clockLabel(endHourRaw, endMinute, true)}` : '';
  const unitLabel = unit === 'daily' || unit === 'day' ? 'day' : unit === 'weekly' || unit === 'week' ? 'week' : unit === 'monthly' || unit === 'month' ? 'month' : unit;
  const frequency = interval === 1 && unitLabel === 'day'
    ? 'Daily'
    : interval === 1
      ? `Every ${unitLabel}`
      : `Every ${interval} ${unitLabel}s`;
  return `${frequency} ${startLabel}${end}`;
}

function timestamp(value: unknown): number {
  const parsed = Date.parse(text(value));
  return Number.isNaN(parsed) ? 0 : parsed;
}

function dateParts(time: number, timezone: string): { year: string; month: string; day: string } {
  const parts = new Intl.DateTimeFormat('en-US', {
    timeZone: timezone,
    year: 'numeric',
    month: '2-digit',
    day: '2-digit',
  }).formatToParts(new Date(time));
  const read = (kind: Intl.DateTimeFormatPartTypes) => parts.find((part) => part.type === kind)?.value ?? '';
  return { year: read('year'), month: read('month'), day: read('day') };
}

function shortTime(time: number, timezone: string): string {
  return new Intl.DateTimeFormat('en-US', {
    timeZone: timezone,
    hour: 'numeric',
    minute: '2-digit',
  }).format(new Date(time));
}

function fullTimestamp(time: number, timezone: string): string {
  return new Intl.DateTimeFormat('en-US', {
    timeZone: timezone,
    year: 'numeric',
    month: 'short',
    day: 'numeric',
    hour: 'numeric',
    minute: '2-digit',
    second: '2-digit',
    timeZoneName: 'short',
  }).format(new Date(time));
}

export function relativeTimestamp(value: unknown, nowMs: number, timezone = 'UTC'): string {
  const observedMs = timestamp(value);
  if (observedMs === 0) return 'Time not recorded';
  const elapsedMs = Math.max(0, nowMs - observedMs);
  const observedDate = dateParts(observedMs, timezone);
  const today = dateParts(nowMs, timezone);
  const yesterday = dateParts(nowMs - 86_400_000, timezone);
  const sameDate = observedDate.year === today.year && observedDate.month === today.month && observedDate.day === today.day;
  const wasYesterday = observedDate.year === yesterday.year && observedDate.month === yesterday.month && observedDate.day === yesterday.day;
  if (sameDate) {
    const minutes = Math.floor(elapsedMs / 60_000);
    if (minutes < 1) return 'Just now';
    if (minutes < 60) return `${minutes} minute${minutes === 1 ? '' : 's'} ago`;
    const hours = Math.floor(minutes / 60);
    return `${hours} hour${hours === 1 ? '' : 's'} ago`;
  }
  if (wasYesterday) return `Yesterday ${shortTime(observedMs, timezone)}`;
  return new Intl.DateTimeFormat('en-US', {
    timeZone: timezone,
    month: 'short',
    day: 'numeric',
    hour: 'numeric',
    minute: '2-digit',
  }).format(new Date(observedMs));
}

function chooseSchedule(rows: Array<{ row: RoutineRecordRow; value: Record<string, unknown> }>, canonicalId: string): { row: RoutineRecordRow; value: Record<string, unknown> } | null {
  const candidates = canonicalId
    ? rows.filter(({ value }) => text(value.schedule_id) === canonicalId)
    : rows;
  return [...(candidates.length > 0 ? candidates : rows)].sort((left, right) => {
    const revision = Number(right.value.schedule_revision ?? 0) - Number(left.value.schedule_revision ?? 0);
    if (revision !== 0) return revision;
    const leftProof = /proof|diagnostic|test/i.test(text(left.value.schedule_id)) ? 1 : 0;
    const rightProof = /proof|diagnostic|test/i.test(text(right.value.schedule_id)) ? 1 : 0;
    return leftProof - rightProof || text(left.value.schedule_id).localeCompare(text(right.value.schedule_id));
  })[0] ?? null;
}

function recordLabel(value: Record<string, unknown>): string {
  const explicit = text(value.title) || text(value.name) || text(value.date);
  if (explicit) return sentenceCase(explicit);
  if (/receipt/i.test(text(value.kind))) return 'Receipt from this run';
  return sentenceCase(text(value.kind).replace(/(?:[._/-])?(?:record|result)$/i, ''));
}

function decodedRowAddress(row: RoutineRecordRow): string | null {
  const raw = (row as Record<string, unknown>).address;
  return identityTextFromAddress(raw) ?? (text(raw) || null);
}

function producedWriteRows(value: Record<string, unknown>): Array<{ address: string; payload: Record<string, unknown> }> {
  return list(value.produced_records)
    .map((item) => {
      if (!item || typeof item !== 'object' || Array.isArray(item)) return null;
      const write = item as Record<string, unknown>;
      const writePayload = write.payload;
      const address = text(write.address);
      return address && writePayload && typeof writePayload === 'object' && !Array.isArray(writePayload)
        ? { address, payload: writePayload as Record<string, unknown> }
        : null;
    })
    .filter((item): item is { address: string; payload: Record<string, unknown> } => item !== null);
}

function normalizedActionIdentity(value: unknown): string {
  return text(value).replace(/^action:/, '');
}

function routineOutputBelongsToOwner(
  value: Record<string, unknown>,
  ownerRef: string,
  recordOwner: ReadonlyMap<string, string>,
): boolean {
  const provenance = value.provenance && typeof value.provenance === 'object' && !Array.isArray(value.provenance)
    ? value.provenance as Record<string, unknown>
    : null;
  return text(value.owner_ref) === ownerRef
    || recordOwner.get(text(value.run_id)) === ownerRef
    || normalizedActionIdentity(provenance?.pipeline) === normalizedActionIdentity(ownerRef);
}

function isRoutineRunReceipt(value: Record<string, unknown>): boolean {
  return text(value.role) === 'receipt' || /(?:^|[-_.:/])receipt$/i.test(text(value.kind));
}

function receiptError(value: Record<string, unknown>): string {
  const error = value.error;
  if (typeof error === 'string') return text(error);
  if (error && typeof error === 'object' && !Array.isArray(error)) {
    const record = error as Record<string, unknown>;
    return text(record.message) || text(record.reason);
  }
  return text(value.error_message) || text(value.failure_reason);
}

function plainReceiptExplanation(value: Record<string, unknown> | null): string | null {
  if (!value) return null;
  const error = receiptError(value);
  if (error) return `The last run reported: ${error.replace(/[._-]+/g, ' ')}.`;
  const counts = value.counts;
  if (!counts || typeof counts !== 'object' || Array.isArray(counts)) return null;
  const numericCounts = Object.entries(counts as Record<string, unknown>)
    .filter((entry): entry is [string, number] => typeof entry[1] === 'number' && Number.isFinite(entry[1]));
  const scanned = numericCounts.find(([key]) => /_scanned$/.test(key));
  if (scanned) {
    const subject = scanned[0].replace(/_scanned$/, '').replace(/_/g, ' ');
    return scanned[1] === 0
      ? `The last run scanned 0 ${subject}, so it had no new records to add.`
      : `The last run scanned ${scanned[1]} ${subject} and produced no new records.`;
  }
  if (numericCounts.length > 0 && numericCounts.every(([, count]) => count === 0)) {
    return 'The last run reported zero results, so it had no new records to add.';
  }
  return null;
}

export function projectRoutines(input: RoutineProjectionInput): RoutineView[] {
  const publishedRows = list(input.published) as RoutineRecordRow[];
  const published = publishedRows.map((row) => ({ row, value: payload(row) })).filter((item): item is { row: RoutineRecordRow; value: Record<string, unknown> } => item.value !== null);
  const schedules = (list(input.schedules) as RoutineRecordRow[]).map((row) => ({ row, value: payload(row) })).filter((item): item is { row: RoutineRecordRow; value: Record<string, unknown> } => item.value?.kind === 'recurring-window-schedule');
  const actions = new Map(published.filter(({ value }) => value.kind === 'action').map(({ value }) => [text(value.id), value]));
  const presentations = new Map(published.filter(({ value }) => value.kind === 'routine-presentation').map(({ value }) => [text(value.owner_ref), value as unknown as RoutinePresentation]));
  const controls = new Map(published.filter(({ value }) => value.kind === 'routine-control').map(({ value }) => [text(value.owner_ref), value as unknown as RoutineControl]));
  const providerDescriptors = new Map(published
    .filter(({ value }) => value.kind === 'service-connection-descriptor')
    .map(({ value }) => [text(value.vendor), value]));
  const placeableSurfaces = readPlaceableSurfaces({ records: publishedRows });
  const scheduledRecords = (list(input.scheduledRecords) as RoutineRecordRow[]).map(payload).filter((value): value is Record<string, unknown> => value !== null);
  const receipts = (list(input.receipts) as RoutineRecordRow[]).map(payload).filter((value): value is Record<string, unknown> => value !== null);
  const nowMs = input.now ? timestamp(input.now) : Date.now();
  const scheduleByOwner = new Map<string, Array<{ row: RoutineRecordRow; value: Record<string, unknown> }>>();
  for (const schedule of schedules) {
    const action = schedule.value.action as Record<string, unknown> | undefined;
    const owner = text(action?.owner_ref);
    if (!owner) continue;
    const bucket = scheduleByOwner.get(owner) ?? [];
    bucket.push(schedule);
    scheduleByOwner.set(owner, bucket);
  }
  const owners = new Set(presentations.keys());
  const recordOwner = new Map(scheduledRecords.map((record) => [text(record.record_id), text(record.owner_ref) || text((record.fields as Record<string, unknown> | undefined)?.routine_owner_ref)]));
  return [...owners].map((ownerRef) => {
    const presentation = presentations.get(ownerRef);
    const control = controls.get(ownerRef);
    const selected = chooseSchedule(scheduleByOwner.get(ownerRef) ?? [], text(presentation?.canonical_schedule_id));
    const schedule = selected?.value ?? control?.schedule_payload ?? null;
    const timezone = text(schedule?.timezone) || 'UTC';
    const action = actions.get(ownerRef) ?? null;
    const scheduleAction = schedule?.action as Record<string, unknown> | undefined;
    const dispatch = scheduleAction?.owner_dispatch as Record<string, unknown> | undefined;
    const ownerDispatch = text(dispatch?.name) ? { name: text(dispatch?.name), input: dispatch?.input ?? null } : null;
    const outputKinds = Array.isArray(presentation?.output_kinds) ? presentation.output_kinds : [];
    const providerRefs = Array.isArray(presentation?.provider_refs) ? presentation.provider_refs : [];
    const providers = providerRefs
      .map((ref) => text(ref))
      .filter(Boolean)
      .map((ref) => {
        const descriptor = providerDescriptors.get(ref);
        const slug = text(descriptor?.vendor);
        const name = text(descriptor?.name);
        return slug && name ? { ref, slug, name } : null;
      })
      .filter((provider): provider is { ref: string; slug: string; name: string } => provider !== null);
    const routineOutputRecords = published
      .filter(({ value }) => {
        if (!outputKinds.includes(text(value.kind))) return false;
        return routineOutputBelongsToOwner(value, ownerRef, recordOwner);
      });
    const routineRunReceipts = routineOutputRecords
      .filter(({ value }) => isRoutineRunReceipt(value))
      .sort((left, right) => timestamp(right.value.observed_at) - timestamp(left.value.observed_at));
    const evidenceExplanation = plainReceiptExplanation(routineRunReceipts[0]?.value ?? null);
    const routineProducedRecords = routineOutputRecords
      .filter(({ value }) => !isRoutineRunReceipt(value))
      .map(({ row, value }) => ({
        kind: text(value.kind),
        label: recordLabel(value),
        address: decodedRowAddress(row),
        payload: value,
        row,
        latestRun: false,
      }))
      .slice(-20)
      .reverse();
    const recentRuns = receipts
      .filter((receipt) => recordOwner.get(text(receipt.record_id)) === ownerRef)
      .sort((left, right) => timestamp(right.observed_at) - timestamp(left.observed_at))
      .map((receipt) => {
        const observedAt = text(receipt.observed_at) || null;
        const observedMs = timestamp(observedAt);
        return {
          operation: text(receipt.operation) || 'completed',
          observedAt,
          relativeTime: relativeTimestamp(observedAt, nowMs, timezone),
          fullTimestamp: observedMs > 0 ? fullTimestamp(observedMs, timezone) : 'Time not recorded',
          recordId: text(receipt.record_id),
        };
      })
      .slice(0, 20);
    const lineageCarrier = routineOutputRecords
      .filter(({ value }) => Array.isArray(value.produced_records))
      .sort((left, right) => timestamp(right.value.observed_at) - timestamp(left.value.observed_at))[0] ?? null;
    const exactWrites = lineageCarrier ? producedWriteRows(lineageCarrier.value) : [];
    const exactAddresses = new Set(exactWrites.map((write) => write.address));
    const exactByAddress = new Map(published.map(({ row, value }) => [decodedRowAddress(row), { row, value }]));
    const exactProducedRecords: RoutineProducedRecord[] = exactWrites.map((write) => {
      const current = exactByAddress.get(write.address);
      const value = current?.value ?? write.payload;
      return {
        kind: text(value.kind),
        label: recordLabel(value),
        address: write.address,
        payload: value,
        row: current?.row ?? { address: write.address, payload: value },
        latestRun: true,
      };
    });
    const lineageAddress = lineageCarrier ? decodedRowAddress(lineageCarrier.row) : null;
    const producedRecords = routineProducedRecords.map((record) => ({
      ...record,
      latestRun: Boolean(
        (record.address && exactAddresses.has(record.address))
        || (lineageCarrier && lineageAddress !== null && record.address === lineageAddress),
      ),
    })).concat(exactProducedRecords.filter((record) => (
      !routineProducedRecords.some((candidate) => candidate.address && candidate.address === record.address)
    )));
    const surfaceConsumedKinds = new Set<string>();
    const evidenceSurfaces = placeableSurfaces
      .filter((surface) => !surface.disabled && surface.packageEntry && surface.acceptsMaterialKinds.some((kind) => outputKinds.includes(kind)))
      .sort((left, right) => left.order - right.order)
      .map((surface) => {
        const recordKinds = surface.acceptsMaterialKinds.filter((kind) => outputKinds.includes(kind));
        recordKinds.forEach((kind) => surfaceConsumedKinds.add(kind));
        const records = producedRecords.filter((record) => recordKinds.includes(record.kind));
        return {
          surface,
          recordKinds,
          records,
          latestRecordRefs: records
            .filter((record) => record.latestRun)
            .map((record) => record.address)
            .filter((address): address is string => Boolean(address)),
        };
      });
    const unmappedProducedRecords = producedRecords.filter((record) => !surfaceConsumedKinds.has(record.kind));
    const receiptRecordIds = new Set(receipts.map((receipt) => text(receipt.record_id)));
    const pendingRun = scheduledRecords
      .filter((record) => recordOwner.get(text(record.record_id)) === ownerRef && text(record.record_id).startsWith('routine-run::') && !receiptRecordIds.has(text(record.record_id)))
      .sort((left, right) => timestamp((right.fields as Record<string, unknown> | undefined)?.requested_at) - timestamp((left.fields as Record<string, unknown> | undefined)?.requested_at))[0] ?? null;
    const pendingRequestedAt = text((pendingRun?.fields as Record<string, unknown> | undefined)?.requested_at);
    const pendingAgeMs = pendingRequestedAt ? nowMs - timestamp(pendingRequestedAt) : 0;
    const stalled = pendingRun !== null && pendingAgeMs >= 120_000;
    const paused = control?.state === 'paused';
    const active = action?.is_active !== false;
    const status: RoutineView['status'] = paused ? 'paused' : !schedule ? 'unscheduled' : active && !stalled ? 'armed' : 'blocked';
    const statusLabel = {
      armed: 'Armed',
      paused: 'Paused',
      blocked: 'Blocked',
      unscheduled: 'Not scheduled yet',
    }[status];
    const statusReason = stalled
      ? "Engine didn't respond. Retrying automatically."
      : status === 'unscheduled' ? 'No schedule is active yet.' : '';
    const listStatusLabel = status === 'paused'
      ? 'Paused'
      : status === 'unscheduled'
        ? 'Not scheduled'
        : null;
    const listWarning = status === 'blocked' ? statusReason : null;
    const last = recentRuns[0] ?? null;
    const allScheduleIds = new Set(schedules.map(({ value }) => text(value.schedule_id)).filter(Boolean));
    const internalScheduleIds = (Array.isArray(presentation?.internal_schedule_ids) ? presentation.internal_schedule_ids : [])
      .filter((scheduleId) => typeof scheduleId === 'string' && allScheduleIds.has(scheduleId));
    return {
      id: ownerRef,
      ownerRef,
      name: text(presentation?.name) || text(schedule?.name) || humanize(text(action?.name) || ownerRef),
      purpose: text(presentation?.purpose),
      cadence: scheduleCadence(schedule),
      status,
      statusLabel,
      statusReason,
      listStatusLabel,
      listWarning,
      lastRunLabel: last ? `Last ran ${last.relativeTime}` : 'No runs yet',
      lastRunAt: last?.observedAt ?? null,
      scheduleId: text(schedule?.schedule_id) || null,
      scheduleAddressLabel: selected ? identityTextFromAddress((selected.row as Record<string, unknown>).address) : text(control?.schedule_address_label) || null,
      schedulePayload: schedule,
      ownerDispatch,
      recentRuns,
      producedRecords,
      evidenceSurfaces,
      unmappedProducedRecords,
      evidenceHasExactLineage: lineageCarrier !== null,
      evidenceExplanation,
      providers,
      internalScheduleCount: internalScheduleIds.length,
      technical: {
        actionId: ownerRef,
        actionLabel: actionLabel(ownerRef),
        scheduleId: text(schedule?.schedule_id) || null,
        scheduleLabel: text(schedule?.schedule_id) ? sentenceCase(text(schedule?.schedule_id)) : null,
        internalSchedules: internalScheduleIds.map((scheduleId) => ({
          id: scheduleId,
          label: sentenceCase(scheduleId),
        })),
      },
    };
  }).sort((left, right) => left.name.localeCompare(right.name));
}

export function replaceOccurrenceBindings(value: unknown, runId: string): unknown {
  if (Array.isArray(value)) return value.map((item) => replaceOccurrenceBindings(item, runId));
  if (!value || typeof value !== 'object') return value;
  const record = value as Record<string, unknown>;
  if (record.$kind === 'timed-action.occurrence-binding') return runId;
  return Object.fromEntries(Object.entries(record).map(([key, item]) => [key, replaceOccurrenceBindings(item, runId)]));
}

export function buildRoutineRunNowWrite(routine: RoutineView, now = new Date()): { recordId: string; writes: Array<Record<string, unknown>> } {
  if (!routine.ownerDispatch) throw new Error('This routine has no runnable action.');
  const stamp = now.toISOString().replace(/[^0-9]/g, '');
  const ownerKey = encodeURIComponent(routine.ownerRef);
  const recordId = `routine-run::${ownerKey}::${stamp}`;
  const dueAt = now.toISOString();
  const dispatch = replaceOccurrenceBindings(routine.ownerDispatch, recordId) as { name: string; input: unknown };
  return {
    recordId,
    writes: [
      { address: `timed-action.scheduled-action.record::${recordId}`, path: ['current-item', 'scheduled-action-record'], payload: { kind: 'scheduled-action-record', role: 'record', record_id: recordId, owner_ref: routine.ownerRef, fields: { title: routine.name, group: 'Routines', routine_owner_ref: routine.ownerRef, requested_at: dueAt } } },
      { address: `timed-action.scheduled-action.time-window::${recordId}:time-window`, path: ['current-item', 'scheduled-action-time-window'], payload: { kind: 'scheduled-action-time-window', time_window_id: `${recordId}:time-window`, record_id: recordId, start: dueAt, timezone: text(routine.schedulePayload?.timezone) || 'UTC' } },
      { address: `timed-action.scheduled-action.action::${recordId}:run-now`, path: ['current-item', 'scheduled-action-action'], payload: { kind: 'scheduled-action-action', action_id: `${recordId}:run-now`, record_id: recordId, operation: 'run-now', dispatch } },
    ],
  };
}
