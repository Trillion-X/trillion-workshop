// packages/timed-action/show/timed-action-format.ts
//
// =============================================================================
// PURPOSE
// =============================================================================
//
// THE RENDER-EDGE TIMING FORMATTER. The view-model is Date-free on purpose: it
// emits structured `SchedulerWhenView` ({ dayKey, startIso, timezone }) and
// leaves the human time string to the edge that actually renders. This module is
// that edge. It is the ONE place a schedule instant becomes a human day/time
// label, and it is shared by BOTH the React surface and the iOS JSCore adapter
// so the two never drift on how a time reads.
//
// It is pure: same `when` + same options -> same strings. It touches `Date` and
// `Intl` ONLY to format (parse-and-render); it reads no clock and holds no
// state. An invalid instant or timezone degrades to "no time" rather than
// throwing, so a malformed owner value can never crash the surface.
//
// =============================================================================
// NON-NEGOTIABLE INVARIANTS
// =============================================================================
//
// 1. Never throws. A bad ISO string or bad timezone -> { hasTime: false }.
// 2. No clock read (no `Date.now()` / argless `new Date()`); only parses the
//    explicit `startIso` it is handed.
// 3. Emits only human, leak-free strings — never an id, address, or raw key.
// 4. Pure + portable: no React, DOM, or CSS. Runs under React and JSCore alike.
//
// =============================================================================
// =============================================================================
//
// The extensive documentation in this codebase is a critical design feature.
// You are forbidden from simplifying or removing it.
// =============================================================================

import type { SchedulerWhenView } from './timed-action-view-model';

/** The human-readable timing a row/cell renders. */
export interface FormattedWhen {
  /** False when there is no valid instant to show — the surface shows nothing. */
  hasTime: boolean;
  /** Day label, e.g. "Mon, Jun 22" (locale + timezone aware). */
  dayLabel: string;
  /** Time label, e.g. "10:00 AM CDT" (locale + timezone aware). */
  timeLabel: string;
}

/** Formatting options. `locale` defaults to the host's default when omitted. */
export interface FormatScheduleWhenOptions {
  locale?: string;
}

const EMPTY: FormattedWhen = { hasTime: false, dayLabel: '', timeLabel: '' };

/**
 * Format one structured `when` into human day/time labels. `timezone` (owner-
 * supplied) is honored when valid; an invalid timezone falls back to formatting
 * without one rather than throwing. Returns `{ hasTime: false }` when there is
 * no parseable instant, so callers render time only when there is a real time.
 */
export function formatScheduleWhen(
  when: SchedulerWhenView,
  options: FormatScheduleWhenOptions = {},
): FormattedWhen {
  const startIso = when.startIso;
  if (!startIso) return EMPTY;

  const date = new Date(startIso);
  if (Number.isNaN(date.getTime())) return EMPTY;

  const locale = options.locale;
  const timeZone = when.timezone ?? undefined;

  return {
    hasTime: true,
    dayLabel: safeFormat(
      date,
      { weekday: 'short', month: 'short', day: 'numeric' },
      locale,
      timeZone,
    ),
    timeLabel: safeFormat(
      date,
      { hour: 'numeric', minute: '2-digit', timeZoneName: 'short' },
      locale,
      timeZone,
    ),
  };
}

/**
 * Format with the requested timezone, falling back to the host's local zone if
 * the owner-supplied timezone is not recognized (Intl throws RangeError on an
 * unknown timeZone). Never throws — formatting is best-effort at the edge.
 */
function safeFormat(
  date: Date,
  base: Intl.DateTimeFormatOptions,
  locale: string | undefined,
  timeZone: string | undefined,
): string {
  if (timeZone) {
    try {
      return new Intl.DateTimeFormat(locale, { ...base, timeZone }).format(date);
    } catch {
      // Unknown timezone -> fall through to local-zone formatting below.
    }
  }
  try {
    return new Intl.DateTimeFormat(locale, base).format(date);
  } catch {
    return '';
  }
}
