// packages/timed-action/show/timed-action-fixtures.ts
//
// =============================================================================
// PURPOSE
// =============================================================================
//
// Render-state + adversarial FIXTURES for the content scheduler. These are
// already-folded projections (the shape `readScheduledActionGraph` produces and
// the view-model consumes) plus the owner-label maps that go with them. They
// drive two things:
//
//   • Visual proof — the render-state matrix (empty / sparse / dense / loading /
//     error / offline) the UI must survive, captured for the proof gallery.
//   • The boundary gate — the adversarial fixtures carry ONLY raw ids,
//     addresses, UUIDs, and internal-vocabulary tokens with NO owner labels, so
//     the boundary test can prove the Translation Spine drops every one of them
//     to a neutral fallback and leaks nothing.
//
// These are TEST / PROOF fixtures, never live product data. They exist only in
// `show/` for tests and the proof gallery and are never written to surface-state
// (L117: no fake production data).
//
// =============================================================================
// NON-NEGOTIABLE INVARIANTS
// =============================================================================
//
// 1. Fixtures are folded-projection shaped — the view-model's actual input.
// 2. The dense fixture uses INVENTED channel/status/group vocabulary as DATA to
//    prove the surface is generic (no hardcoded business names anywhere).
// 3. The adversarial fixtures intentionally carry leaky tokens with NO owner
//    labels; the spine MUST humanize them away — that is what UR06 proves.
// 4. Pure data: no React, DOM, Date, or runtime imports.
//
// =============================================================================
// =============================================================================
//
// The extensive documentation in this codebase is a critical design feature.
// You are forbidden from simplifying or removing it.
// =============================================================================

import type { OwnerLabels } from './timed-action-translate';

/** One named fixture: a human title, a folded projection, and optional labels. */
export interface SchedulerFixture {
  /** Stable id for the proof gallery + test iteration. */
  id: string;
  /** Human description of the render state being proven. */
  title: string;
  /** The folded projection handed to `buildSchedulerModel` (or null/garbage). */
  projection: unknown;
  /** Owner id -> human label map for this fixture (omitted = none supplied). */
  ownerLabels?: OwnerLabels;
}

// -----------------------------------------------------------------------------
// Owner labels for the "happy" proof fixtures (sparse / dense). Keys are opaque
// owner ids; values are the human labels the owner package chose. The adversarial
// fixtures deliberately ship NO labels so every token must fall back.
// -----------------------------------------------------------------------------
const PROOF_OWNER_LABELS: OwnerLabels = {
  'post-launch': 'Launch announcement',
  'post-recap': 'Weekly recap',
  'post-promo': 'Summer promo',
  'post-reply': 'Community reply',
  'post-legal': 'Policy update',
  'chan-news': 'Newsletter',
  'chan-social': 'Social',
  'chan-support': 'Support inbox',
  'reason-reconnect': 'Account needs reconnecting',
  'act-publish': 'Publish now',
  'act-reconnect': 'Reconnect account',
  'act-review': 'Send for review',
};

function projection(items: unknown[], projectionId = 'default'): unknown {
  return { projection_id: projectionId, items, groups: {}, proof: {} };
}

// -----------------------------------------------------------------------------
// SPARSE — a single scheduled post with one channel, no blockers.
// -----------------------------------------------------------------------------
const SPARSE = projection([
  {
    record_id: 'post-launch',
    label: 'post-launch',
    group: 'Queue',
    fields: { status: 'scheduled' },
    relationships: [{ target_id: 'chan-news', relation_role: 'target' }],
    time_window: { start: '2026-06-23T14:00:00.000Z', timezone: 'America/Chicago' },
    due_state: 'scheduled',
    actions: [
      {
        action_id: 'act-publish',
        label: null,
        dispatch: { name: 'slot::workflow', input: { operation: 'execute_definition', definition_id: 'package::content-distribution::workflow-action::run-publish-intent', input: {} } },
      },
    ],
    owner_evidence: [],
  },
]);

// -----------------------------------------------------------------------------
// DENSE — several posts across multiple groups, mixed (and invented) statuses,
// multiple channels, a blocker, and varied actions. Proves the surface holds up
// under volume AND that arbitrary owner vocabulary flows through as data.
// -----------------------------------------------------------------------------
const DENSE = projection([
  {
    record_id: 'post-launch',
    label: 'post-launch',
    group: 'Newsletter',
    fields: { status: 'due' },
    relationships: [
      { target_id: 'chan-news', relation_role: 'target' },
      { target_id: 'chan-social', relation_role: 'target' },
    ],
    time_window: { start: '2026-06-22T15:00:00.000Z', timezone: 'America/Chicago' },
    due_state: 'due',
    actions: [
      {
        action_id: 'act-publish',
        label: null,
        dispatch: { name: 'slot::workflow', input: { operation: 'execute_definition', definition_id: 'package::content-distribution::workflow-action::run-publish-intent', input: {} } },
      },
    ],
    owner_evidence: [],
  },
  {
    record_id: 'post-recap',
    label: 'post-recap',
    group: 'Newsletter',
    // An invented status the surface has never seen — must humanize generically.
    fields: { status: 'awaiting_legal_review' },
    relationships: [{ target_id: 'chan-news', relation_role: 'target' }],
    time_window: { start: '2026-06-24T13:30:00.000Z', timezone: 'America/Chicago' },
    due_state: 'scheduled',
    actions: [
      {
        action_id: 'act-review',
        label: null,
        dispatch: { name: 'slot::workflow', input: { operation: 'execute_definition', definition_id: 'package::content-distribution::workflow-action::send-for-review', input: {} } },
      },
    ],
    owner_evidence: [],
  },
  {
    record_id: 'post-promo',
    label: 'post-promo',
    group: 'Social',
    fields: { status: 'disconnected' },
    relationships: [{ target_id: 'chan-social', relation_role: 'target' }],
    time_window: { start: '2026-06-22T18:00:00.000Z', timezone: 'America/Chicago' },
    due_state: 'scheduled',
    actions: [
      {
        action_id: 'act-reconnect',
        label: null,
        dispatch: { name: 'slot::workflow', input: { operation: 'execute_definition', definition_id: 'package::content-distribution::workflow-action::reconnect-account', input: {} } },
      },
    ],
    owner_evidence: [
      {
        allowed: false,
        tone: 'error',
        reason_refs: ['reason-reconnect'],
        next_action_refs: ['act-reconnect'],
      },
    ],
  },
  {
    record_id: 'post-reply',
    label: 'post-reply',
    group: 'Social',
    fields: { status: 'published' },
    relationships: [{ target_id: 'chan-support', relation_role: 'target' }],
    time_window: { start: '2026-06-21T17:15:00.000Z', timezone: 'America/Chicago' },
    due_state: 'scheduled',
    actions: [],
    owner_evidence: [],
  },
  {
    record_id: 'post-legal',
    label: 'post-legal',
    group: 'Newsletter',
    fields: { status: 'scheduled' },
    relationships: [{ target_id: 'chan-news', relation_role: 'target' }],
    time_window: { start: '2026-06-25T16:00:00.000Z', timezone: 'America/Chicago' },
    due_state: 'scheduled',
    actions: [
      {
        action_id: 'act-review',
        label: null,
        dispatch: { name: 'slot::workflow', input: { operation: 'execute_definition', definition_id: 'package::content-distribution::workflow-action::send-for-review', input: {} } },
      },
    ],
    owner_evidence: [
      {
        allowed: false,
        tone: 'warning',
        reason_refs: [],
        next_action_refs: ['act-review'],
      },
    ],
  },
]);

// -----------------------------------------------------------------------------
// ADVERSARIAL — every owner handle is a leaky internal token and NO owner labels
// are supplied. The spine must drop every one of these to a neutral fallback;
// the boundary test (UR06) asserts none of them survive into visible text.
// -----------------------------------------------------------------------------
const ADVERSARIAL = projection([
  {
    // record_id and label are both raw ids -> title must fall to "This post".
    record_id: 'a1b2c3d4-e5f6-7890-abcd-ef0123456789',
    label: 'a1b2c3d4-e5f6-7890-abcd-ef0123456789',
    // group is an internal address -> must fall to the neutral group ("Other").
    group: 'package::timed-action::group::queue',
    // status is a raw key -> statusView humanizes it without leaking.
    fields: { status: 'partially_published' },
    relationships: [
      // target id is a UUID -> must fall to "This destination".
      { target_id: '11111111-2222-3333-4444-555555555555', relation_role: 'target' },
    ],
    time_window: { start: '2026-06-22T20:00:00.000Z', timezone: 'America/Chicago' },
    due_state: 'scheduled',
    actions: [
      {
        // action_id is a colon path; label is internal vocabulary -> "Continue".
        action_id: 'prop:extension:run',
        label: 'payload.fact_ref',
        dispatch: { name: 'slot::workflow', input: { operation: 'execute_definition', definition_id: 'slot::workflow::descriptor', input: {} } },
      },
    ],
    owner_evidence: [
      {
        allowed: false,
        tone: 'error',
        // reason ref is an envelope token -> blocker must fall to "Needs attention".
        reason_refs: ['envelope.fact.blocked'],
        next_action_refs: ['prop:extension:run'],
      },
    ],
  },
]);

/**
 * The full render-state + adversarial matrix. Iterated by the boundary test and
 * captured for the visual-proof gallery. Loading is `null` (data not present
 * yet); error is a malformed projection (`items` is not a list).
 */
export const schedulerFixtures: SchedulerFixture[] = [
  { id: 'empty', title: 'Empty schedule (ready, no posts)', projection: projection([]) },
  { id: 'sparse', title: 'Sparse schedule (one scheduled post)', projection: SPARSE, ownerLabels: PROOF_OWNER_LABELS },
  { id: 'dense', title: 'Dense schedule (many posts, mixed states, a blocker)', projection: DENSE, ownerLabels: PROOF_OWNER_LABELS },
  { id: 'loading', title: 'Loading (data not present yet)', projection: null },
  { id: 'error', title: 'Error (malformed projection)', projection: { items: 'not-a-list' } },
  { id: 'adversarial', title: 'Adversarial (raw ids + addresses, no owner labels)', projection: ADVERSARIAL },
];

/** Lookup one fixture by id (test + gallery convenience). */
export function schedulerFixture(id: string): SchedulerFixture | undefined {
  return schedulerFixtures.find((fixture) => fixture.id === id);
}
