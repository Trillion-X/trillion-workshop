// packages/timed-action/show/TimedActionSurface.tsx
//
// =============================================================================
// PURPOSE
// =============================================================================
//
// THE REACT / DESKTOP / BROWSER SURFACE. The one component that renders the
// content scheduler for the web + desktop host. It consumes the canonical,
// host-agnostic `buildSchedulerModel` (the exact same model the iOS JSCore
// adapter renders) and composes it ENTIRELY out of named shared `ui` primitives
// — never a raw <div>/<span>, never a className, never inline styling.
//
// Layout is a three-pane workbench on desktop and queue-first on mobile:
//
//   DESKTOP (wide)                         MOBILE (narrow)
//   ┌────────┬──────────────┬─────────┐    ┌──────────────────┐
//   │ rail   │ calendar/    │ sidecar │    │ mode + summary   │
//   │ mode + │ queue center │ detail  │    │ group filter     │
//   │ filter │ (grouped or  │ + tabs  │    │ queue list …     │
//   │ + stat │  day grid)   │ + acts  │    │ (tap → sheet)    │
//   └────────┴──────────────┴─────────┘    └──────────────────┘
//                                          FloatingPanel = detail + primary act
//
// =============================================================================
// NON-NEGOTIABLE INVARIANTS
// =============================================================================
//
// 1. ZERO raw DOM + ZERO styling. Every node is a named `@/packages/ui/show/*`
//    primitive. No <div>/<span>/<section>, no className, no style prop. (L065/L066)
// 2. ZERO `status ===` / `state ===` VALUE BRANCHING. The honest render mode
//    (loading/ready/error) is dispatched by a LOOKUP keyed by `model.status`;
//    the view mode (queue/calendar) by a LOOKUP keyed by `mode`. An item's state
//    is ALWAYS rendered via `item.status.label` / `item.status.tone` — never
//    compared to a literal. Tone -> primitive variant is a DATA map. (L090)
// 3. NO PACKAGE/DOMAIN VOCABULARY + NO HARDCODED BUSINESS OUTCOME. Every visible
//    string already passed the Translation Spine inside the view-model
//    (`statusView` for machine states, `translate` for owner labels) or is static
//    product copy from `schedulerCopy`. A "won/lost"-style outcome can only
//    appear as emergent owner DATA flowing through `item.status`, never a literal
//    here. (L098, L114, L118)
// 4. THREE HONEST STATES, layout-preserving. Loading keeps the workbench shell
//    and shows a spinner; error shows a calm SafeErrorCard; empty shows an
//    EmptyPlaceholder — all inside the same shell so nothing jumps. No fake data.
// 5. FAILED DESTINATIONS BESIDE SUCCESSFUL. Each item shows its publish targets
//    (destinations) and its blockers (what needs attention) together, on the
//    card and in the sidecar, so a partial failure is never hidden.
//
// =============================================================================
// =============================================================================
//
// The extensive documentation in this codebase is a critical design feature.
// You are forbidden from simplifying or removing it.
// =============================================================================

import React from 'react';
import { CalendarClock } from 'lucide-react';

import {
  buildSchedulerModel,
  type SchedulerModel,
  type SchedulerStatus,
  type SchedulerItemView,
  type SchedulerActionView,
} from './timed-action-view-model';
import type { OwnerLabels, StatusTone } from './timed-action-translate';
import { formatScheduleWhen } from './timed-action-format';
import {
  buildSchedulerActionRequest,
  canRequestSchedulerAction,
  type SchedulerActionRequest,
} from './timed-action-actions';

import { Container } from '@/packages/ui/show/container';
import { Text } from '@/packages/ui/show/text';
import { Card } from '@/packages/ui/show/card';
import { Button } from '@/packages/ui/show/button';
import { Badge } from '@/packages/ui/show/badge';
import { StatusDot } from '@/packages/ui/show/status-dot';
import { SeverityRow } from '@/packages/ui/show/severity-row';
import { StatStrip } from '@/packages/ui/show/stat-strip';
import { SegmentedControl } from '@/packages/ui/show/segmented-control';
import { SelectablePillBar } from '@/packages/ui/show/selectable-pill-bar';
import { CalendarGrid } from '@/packages/ui/show/calendar-grid';
import { Tabs, TabsList, TabsTrigger, TabsContent } from '@/packages/ui/show/tabs';
import { EmptyPlaceholder } from '@/packages/ui/show/empty-placeholder';
import { SafeErrorCard } from '@/packages/ui/show/safe-error-card';
import { Spinner } from '@/packages/ui/show/spinner';
import { ScrollableSurface } from '@/packages/ui/show/scrollable-surface';
import { Divider } from '@/packages/ui/show/divider/Divider';
import { useNarrowViewport } from '@/packages/ui/show/use-narrow-viewport/useNarrowViewport';
import { FloatingPanel } from '@/packages/screen-arrangement/show/FloatingPanel';

// -----------------------------------------------------------------------------
// DATA MAPS: tone -> primitive variant. These replace every `status === …`
// branch. statusView already classified the state into one of five tones; we
// only translate that tone into the variant each primitive understands. Adding a
// new state needs ZERO change here — its tone already routes through these maps.
// -----------------------------------------------------------------------------

/** Status tone -> Badge variant (identity for the five shared tones). */
const BADGE_VARIANT: Record<StatusTone, 'neutral' | 'info' | 'success' | 'warning' | 'error'> = {
  neutral: 'neutral',
  info: 'info',
  success: 'success',
  warning: 'warning',
  error: 'error',
};

/** Status tone -> StatusDot status (neutral has no dot lane -> idle). */
const DOT_STATUS: Record<StatusTone, 'success' | 'warning' | 'error' | 'info' | 'accent' | 'idle'> = {
  neutral: 'idle',
  info: 'info',
  success: 'success',
  warning: 'warning',
  error: 'error',
};

/** Status tone -> SeverityRow severity (collapses the five tones onto three lanes). */
const SEVERITY: Record<StatusTone, 'critical' | 'warning' | 'info'> = {
  neutral: 'info',
  info: 'info',
  success: 'info',
  warning: 'warning',
  error: 'critical',
};

// -----------------------------------------------------------------------------
// Public props. The surface is pure-ish: it owns view state (mode, selection,
// filter) but produces no I/O. `onAction` receives a ready-to-route request the
// host sends; the surface never sends. `projection` is the already-folded graph
// (undefined while it loads -> the loading model). `ownerLabels` is the owner's
// id->label DATA; `locale` formats time at the render edge.
// -----------------------------------------------------------------------------
export interface TimedActionSurfaceProps {
  /** The folded scheduled-action projection (undefined -> loading). */
  projection: unknown;
  /** Sink for a built, routable owner-action request. The host sends it. */
  onAction?: (request: SchedulerActionRequest) => void;
  /** The record to pre-select in the sidecar (desktop) / open (mobile). */
  selectedRecordId?: string | null;
  /** Owner-supplied id -> human label DATA map. */
  ownerLabels?: OwnerLabels;
  /** Locale for render-edge time formatting. */
  locale?: string;
}

/** The two view modes — a closed Physics set (calendar overview vs. linear queue). */
type ScheduleMode = 'queue' | 'calendar';

export function TimedActionSurface(props: TimedActionSurfaceProps): React.ReactElement {
  const { projection, onAction, selectedRecordId, ownerLabels, locale } = props;
  const model = React.useMemo(
    () => buildSchedulerModel(projection, { ownerLabels }),
    [projection, ownerLabels],
  );
  return (
    <SchedulerWorkbench
      model={model}
      onAction={onAction}
      initialSelected={selectedRecordId ?? null}
      locale={locale}
    />
  );
}

export default TimedActionSurface;

// =============================================================================
// Workbench — owns view state, then dispatches the honest render state by LOOKUP.
// =============================================================================

interface WorkbenchProps {
  model: SchedulerModel;
  onAction?: (request: SchedulerActionRequest) => void;
  initialSelected: string | null;
  locale?: string;
}

/** The shared context every render branch receives. */
interface RenderContext extends WorkbenchProps {
  narrow: boolean;
  mode: ScheduleMode;
  setMode: (mode: ScheduleMode) => void;
  groupFilter: readonly string[];
  toggleGroup: (id: string) => void;
  selectAllGroups: () => void;
  activeDay: string | null;
  setActiveDay: (key: string | null) => void;
  selectedId: string | null;
  setSelectedId: (id: string | null) => void;
}

function SchedulerWorkbench(props: WorkbenchProps): React.ReactElement {
  const narrow = useNarrowViewport();
  const [mode, setMode] = React.useState<ScheduleMode>('queue');
  const [groupFilter, setGroupFilter] = React.useState<readonly string[]>([]);
  const [activeDay, setActiveDay] = React.useState<string | null>(null);
  const [selectedId, setSelectedId] = React.useState<string | null>(props.initialSelected);

  const toggleGroup = React.useCallback((id: string) => {
    setGroupFilter((prev) => (prev.includes(id) ? prev.filter((x) => x !== id) : [...prev, id]));
  }, []);
  const selectAllGroups = React.useCallback(() => setGroupFilter([]), []);

  const ctx: RenderContext = {
    ...props,
    narrow,
    mode,
    setMode,
    groupFilter,
    toggleGroup,
    selectAllGroups,
    activeDay,
    setActiveDay,
    selectedId,
    setSelectedId,
  };

  // No `model.status === …` anywhere: the render branch is a DATA lookup.
  const Render = STATUS_RENDERERS[props.model.status] ?? ReadyState;
  return <Render {...ctx} />;
}

/** The three honest render states, selected by `model.status` (never compared). */
const STATUS_RENDERERS: Record<SchedulerStatus, (ctx: RenderContext) => React.ReactElement> = {
  loading: LoadingState,
  error: ErrorState,
  ready: ReadyState,
};

// =============================================================================
// Shell — the workbench frame reused by every state so layout never jumps.
// =============================================================================

function WorkbenchShell(props: {
  narrow: boolean;
  rail?: React.ReactNode;
  center: React.ReactNode;
  sidecar?: React.ReactNode;
}): React.ReactElement {
  if (props.narrow) {
    return (
      <Container layout="vertical" height="full" gap="none">
        {props.center}
      </Container>
    );
  }
  return (
    <Container layout="horizontal" height="full" gap="none">
      {props.rail ? (
        <Container layout="vertical" minWidth="16rem" maxWidth="sm" padding="md" gap="lg" overflow="y-auto">
          {props.rail}
        </Container>
      ) : null}
      <Container flex="1" minWidth="0" overflow="hidden">
        {props.center}
      </Container>
      {props.sidecar ? (
        <Container layout="vertical" minWidth="22rem" maxWidth="sm" overflow="hidden">
          {props.sidecar}
        </Container>
      ) : null}
    </Container>
  );
}

// =============================================================================
// Loading + Error states.
// =============================================================================

function LoadingState(ctx: RenderContext): React.ReactElement {
  const { loading } = ctx.model.copy;
  return (
    <WorkbenchShell
      narrow={ctx.narrow}
      rail={<RailSkeleton model={ctx.model} mode={ctx.mode} onMode={ctx.setMode} />}
      center={
        <Container layout="vertical" height="full" alignItems="center" justifyContent="center" gap="md" padding="xl">
          <Spinner size="lg" aria-label={loading.title} />
          <Text variant="heading-xs" color="strong" align="center">{loading.title}</Text>
          <Text variant="body" color="muted" align="center">{loading.body}</Text>
        </Container>
      }
    />
  );
}

function ErrorState(ctx: RenderContext): React.ReactElement {
  const { error } = ctx.model.copy;
  return (
    <WorkbenchShell
      narrow={ctx.narrow}
      center={
        <Container layout="vertical" height="full" alignItems="center" justifyContent="center" padding="xl">
          <SafeErrorCard title={error.title} message={error.body} retryLabel={error.recoveryAction} />
        </Container>
      }
    />
  );
}

// =============================================================================
// Ready state — the full workbench.
// =============================================================================

function ReadyState(ctx: RenderContext): React.ReactElement {
  const { model } = ctx;

  // Empty schedule: keep the shell, show a calm placeholder (no fake rows).
  if (model.items.length === 0) {
    return (
      <WorkbenchShell
        narrow={ctx.narrow}
        rail={ctx.narrow ? undefined : <Rail ctx={ctx} />}
        center={
          <Container layout="vertical" height="full" alignItems="center" justifyContent="center" gap="sm" padding="xl">
            <EmptyPlaceholder icon={CalendarClock} message={model.copy.empty.title} />
            <Text variant="body" color="muted" align="center">{model.copy.empty.body}</Text>
          </Container>
        }
      />
    );
  }

  const visibleItems = selectVisibleItems(ctx);
  const Center = CENTER_BY_MODE[ctx.mode] ?? QueueCenter;

  // Desktop auto-selects the first visible item so the sidecar is never blank;
  // mobile only opens the sheet on an explicit tap.
  const desktopSelected =
    findItem(model, ctx.selectedId) ?? visibleItems[0] ?? model.items[0] ?? null;
  const mobileSelected = findItem(model, ctx.selectedId);

  if (ctx.narrow) {
    return (
      <Container layout="vertical" height="full" gap="none">
        <Container layout="vertical" padding="md" gap="md">
          <ModeControl model={model} mode={ctx.mode} onMode={ctx.setMode} />
          <ScheduleStats model={model} />
          <GroupFilter ctx={ctx} />
        </Container>
        <Divider />
        <Container flex="1" minHeight="0" overflow="hidden">
          <Center ctx={ctx} items={visibleItems} />
        </Container>
        <FloatingPanel
          open={mobileSelected !== null}
          onClose={() => ctx.setSelectedId(null)}
          title={model.copy.modes.queue}
        >
          {mobileSelected ? <DetailPanel ctx={ctx} item={mobileSelected} sticky /> : null}
        </FloatingPanel>
      </Container>
    );
  }

  return (
    <WorkbenchShell
      narrow={false}
      rail={<Rail ctx={ctx} />}
      center={<Center ctx={ctx} items={visibleItems} />}
      sidecar={
        <ScrollableSurface>
          <Container layout="vertical" padding="lg" gap="lg">
            {desktopSelected ? (
              <DetailPanel ctx={ctx} item={desktopSelected} />
            ) : (
              <Text variant="body" color="muted">{model.copy.empty.body}</Text>
            )}
          </Container>
        </ScrollableSurface>
      }
    />
  );
}

/** Center pane selected by view mode — a DATA lookup, never `mode === …`. */
const CENTER_BY_MODE: Record<ScheduleMode, (p: { ctx: RenderContext; items: SchedulerItemView[] }) => React.ReactElement> = {
  queue: QueueCenter,
  calendar: CalendarCenter,
};

// =============================================================================
// Rail (desktop left) — mode, group filter, summary stats.
// =============================================================================

function Rail({ ctx }: { ctx: RenderContext }): React.ReactElement {
  return (
    <>
      <ModeControl model={ctx.model} mode={ctx.mode} onMode={ctx.setMode} />
      <ScheduleStats model={ctx.model} />
      <GroupFilter ctx={ctx} />
    </>
  );
}

function RailSkeleton(props: {
  model: SchedulerModel;
  mode: ScheduleMode;
  onMode: (mode: ScheduleMode) => void;
}): React.ReactElement {
  return <ModeControl model={props.model} mode={props.mode} onMode={props.onMode} />;
}

function ModeControl(props: {
  model: SchedulerModel;
  mode: ScheduleMode;
  onMode: (mode: ScheduleMode) => void;
}): React.ReactElement {
  const { modes } = props.model.copy;
  return (
    <SegmentedControl
      ariaLabel={modes.queue}
      value={props.mode}
      items={[
        { id: 'queue', label: modes.queue },
        { id: 'calendar', label: modes.calendar },
      ]}
      onValueChange={(value) => props.onMode(value === 'calendar' ? 'calendar' : 'queue')}
    />
  );
}

function ScheduleStats({ model }: { model: SchedulerModel }): React.ReactElement {
  const { proof } = model;
  return (
    <StatStrip
      stats={[
        { label: 'Scheduled', value: String(proof.scheduled_count) },
        { label: 'Needs attention', value: String(proof.blocker_count) },
        { label: 'Channels', value: String(proof.target_count) },
      ]}
    />
  );
}

function GroupFilter({ ctx }: { ctx: RenderContext }): React.ReactElement {
  return (
    <SelectablePillBar
      ariaLabel="Filter by group"
      items={ctx.model.groups.map((group) => ({ id: group.id, label: group.title }))}
      selectedIds={ctx.groupFilter}
      onSelectAll={ctx.selectAllGroups}
      onToggle={ctx.toggleGroup}
    />
  );
}

// =============================================================================
// Queue center — grouped, vertically scrolling list of item cards.
// =============================================================================

function QueueCenter({ ctx, items }: { ctx: RenderContext; items: SchedulerItemView[] }): React.ReactElement {
  const sections = ctx.model.groups
    .map((group) => ({ group, items: items.filter((item) => group.itemIds.includes(item.id)) }))
    .filter((section) => section.items.length > 0);

  return (
    <ScrollableSurface>
      <Container layout="vertical" padding="md" gap="lg">
        {sections.map((section) => (
          <Container key={section.group.id} layout="vertical" gap="sm">
            <Text variant="overline" color="muted">{section.group.title}</Text>
            <Container layout="vertical" gap="sm">
              {section.items.map((item) => (
                <QueueCard
                  key={item.id}
                  item={item}
                  selected={item.id === ctx.selectedId}
                  locale={ctx.locale}
                  onSelect={() => ctx.setSelectedId(item.id)}
                />
              ))}
            </Container>
          </Container>
        ))}
      </Container>
    </ScrollableSurface>
  );
}

function QueueCard(props: {
  item: SchedulerItemView;
  selected: boolean;
  locale?: string;
  onSelect: () => void;
}): React.ReactElement {
  const { item } = props;
  const when = formatScheduleWhen(item.when, { locale: props.locale });
  return (
    <Card variant="surface" padding="sm" layout="column" interactive selected={props.selected}>
      <Container as="button" layout="vertical" gap="sm" width="full" alignItems="stretch" onClick={props.onSelect}>
        <Container layout="horizontal" gap="sm" alignItems="center">
          <StatusDot status={DOT_STATUS[item.status.tone]} />
          <Badge variant={BADGE_VARIANT[item.status.tone]} size="sm">{item.status.label}</Badge>
          {when.hasTime ? <Text variant="caption" color="muted">{when.dayLabel} · {when.timeLabel}</Text> : null}
        </Container>
        <Text variant="body" color="strong" weight="medium" clamp="2">{item.title}</Text>
        <TargetRow targets={item.targets} />
        {item.hasBlockers ? <BlockerRow item={item} compact /> : null}
      </Container>
    </Card>
  );
}

// =============================================================================
// Calendar center — day-bucket grid + the selected day's items.
// =============================================================================

function CalendarCenter({ ctx, items }: { ctx: RenderContext; items: SchedulerItemView[] }): React.ReactElement {
  const buckets = dayBuckets(items);
  const cells = buckets.map((bucket) => ({
    key: bucket.key,
    selected: bucket.key === ctx.activeDay,
  }));
  const activeBucket = buckets.find((bucket) => bucket.key === ctx.activeDay) ?? buckets[0] ?? null;
  const dayItems = activeBucket ? activeBucket.items : items;

  return (
    <ScrollableSurface>
      <Container layout="vertical" padding="md" gap="lg">
        {cells.length > 0 ? (
          <CalendarGrid
            ariaLabel={ctx.model.copy.modes.calendar}
            cells={cells}
            density="comfortable"
            onSelectCell={(key) => ctx.setActiveDay(key)}
            renderCell={(cell) => {
              const bucket = buckets.find((entry) => entry.key === cell.key);
              if (!bucket) return null;
              const label = formatScheduleWhen(bucket.items[0].when, { locale: ctx.locale }).dayLabel;
              return (
                <Container layout="vertical" gap="xs" alignItems="center">
                  <Text variant="caption" color={cell.selected ? 'strong' : 'muted'}>{label}</Text>
                  <Badge variant="neutral" size="sm">{String(bucket.items.length)}</Badge>
                </Container>
              );
            }}
          />
        ) : null}
        <Divider />
        <Container layout="vertical" gap="sm">
          {dayItems.map((item) => (
            <QueueCard
              key={item.id}
              item={item}
              selected={item.id === ctx.selectedId}
              locale={ctx.locale}
              onSelect={() => ctx.setSelectedId(item.id)}
            />
          ))}
        </Container>
      </Container>
    </ScrollableSurface>
  );
}

// =============================================================================
// Detail panel (sidecar on desktop, bottom-sheet body on mobile).
// =============================================================================

function DetailPanel(props: { ctx: RenderContext; item: SchedulerItemView; sticky?: boolean }): React.ReactElement {
  const { ctx, item } = props;
  const when = formatScheduleWhen(item.when, { locale: ctx.locale });
  return (
    <Container layout="vertical" gap="lg">
      <Container layout="vertical" gap="sm">
        <Container layout="horizontal" gap="sm" alignItems="center">
          <StatusDot status={DOT_STATUS[item.status.tone]} />
          <Badge variant={BADGE_VARIANT[item.status.tone]} size="md">{item.status.label}</Badge>
        </Container>
        <Text variant="heading-xs" color="strong">{item.title}</Text>
        {when.hasTime ? <Text variant="body" color="muted">{when.dayLabel} · {when.timeLabel}</Text> : null}
      </Container>

      <ActionRow ctx={ctx} item={item} sticky={props.sticky} />

      <Tabs value="preview" onValueChange={() => undefined}>
        <TabsList>
          <TabsTrigger value="preview">{ctx.model.copy.actionsFallback.preview}</TabsTrigger>
          <TabsTrigger value="readiness">Readiness</TabsTrigger>
          <TabsTrigger value="results">Results</TabsTrigger>
        </TabsList>
        <TabsContent value="preview">
          <Container layout="vertical" gap="sm">
            <Text variant="body" color="default">{item.title}</Text>
            <TargetRow targets={item.targets} />
          </Container>
        </TabsContent>
        <TabsContent value="readiness">
          {item.hasBlockers ? (
            <BlockerRow item={item} />
          ) : (
            <Text variant="body" color="success">Ready to publish</Text>
          )}
        </TabsContent>
        <TabsContent value="results">
          <Container layout="vertical" gap="sm">
            <Badge variant={BADGE_VARIANT[item.status.tone]} size="md">{item.status.label}</Badge>
            <TargetRow targets={item.targets} />
            {item.hasBlockers ? <BlockerRow item={item} /> : null}
          </Container>
        </TabsContent>
      </Tabs>
    </Container>
  );
}

function ActionRow(props: { ctx: RenderContext; item: SchedulerItemView; sticky?: boolean }): React.ReactElement | null {
  const { ctx, item } = props;
  if (item.actions.length === 0) return null;
  const fire = (action: SchedulerActionView) => {
    if (!canRequestSchedulerAction(action)) return;
    const request = buildSchedulerActionRequest(action, {
      recordId: item.id,
      projectionId: ctx.model.projectionId,
    });
    ctx.onAction?.(request);
  };
  return (
    <Container layout="horizontal" gap="sm" wrap>
      {item.actions.map((action, index) => (
        <Button
          key={action.id}
          variant={index === 0 ? 'primary' : 'secondary'}
          size="sm"
          disabled={!canRequestSchedulerAction(action)}
          onClick={() => fire(action)}
        >
          {action.label}
        </Button>
      ))}
    </Container>
  );
}

// =============================================================================
// Shared rows: targets (destinations) + blockers (needs attention), side by side.
// =============================================================================

function TargetRow({ targets }: { targets: SchedulerItemView['targets'] }): React.ReactElement | null {
  if (targets.length === 0) return null;
  return (
    <Container layout="horizontal" gap="xs" wrap>
      {targets.map((target) => (
        <Badge key={target.id} variant="muted-outline" size="sm">{target.label}</Badge>
      ))}
    </Container>
  );
}

function BlockerRow({ item, compact }: { item: SchedulerItemView; compact?: boolean }): React.ReactElement | null {
  if (item.blockers.length === 0) return null;
  if (compact) {
    return (
      <Container layout="horizontal" gap="xs" wrap>
        {item.blockers.map((blocker) => (
          <Badge key={blocker.id} variant={BADGE_VARIANT[blocker.tone]} size="sm">{blocker.label}</Badge>
        ))}
      </Container>
    );
  }
  return (
    <Container layout="vertical" gap="xs">
      {item.blockers.map((blocker) => (
        <SeverityRow key={blocker.id} severity={SEVERITY[blocker.tone]}>{blocker.label}</SeverityRow>
      ))}
    </Container>
  );
}

// =============================================================================
// Pure selection helpers (no clock, no I/O).
// =============================================================================

/** Items visible under the current group filter (empty filter = all groups). */
function selectVisibleItems(ctx: RenderContext): SchedulerItemView[] {
  const { model, groupFilter } = ctx;
  if (groupFilter.length === 0) return model.items;
  const allowed = new Set<string>();
  for (const group of model.groups) {
    if (groupFilter.includes(group.id)) {
      for (const id of group.itemIds) allowed.add(id);
    }
  }
  return model.items.filter((item) => allowed.has(item.id));
}

/** Find an item by id, or null. */
function findItem(model: SchedulerModel, id: string | null): SchedulerItemView | null {
  if (!id) return null;
  return model.items.find((item) => item.id === id) ?? null;
}

/** Bucket items by their calendar day, preserving first-appearance (start) order. */
function dayBuckets(items: SchedulerItemView[]): Array<{ key: string; items: SchedulerItemView[] }> {
  const order: string[] = [];
  const map = new Map<string, SchedulerItemView[]>();
  for (const item of items) {
    const key = item.when.dayKey;
    if (!key) continue;
    if (!map.has(key)) {
      map.set(key, []);
      order.push(key);
    }
    map.get(key)!.push(item);
  }
  return order.map((key) => ({ key, items: map.get(key)! }));
}
