import React from 'react';
import { ExternalLink } from 'lucide-react';
import {
  Button,
  Card,
  Container,
  DisplayMark,
  DisclosureSection,
  EmptyPlaceholder,
  Icon,
  PlaceableSurfaceHost,
  ProviderMark,
  SafeErrorCard,
  ScrollableSurface,
  Spinner,
  StatusDot,
  Text,
  emitPlaceableSurfaceIntent,
  placeableSurfacePayloadFromRecord,
  type ProviderIconRegistryRow,
} from '@/packages/ui';
import type {
  RoutineEvidenceSurface,
  RoutineProducedRecord,
  RoutineView,
} from '../read-data/read-routine-records';

export interface RoutinesSurfaceProps {
  routines: RoutineView[] | null;
  error?: string | null;
  busyId?: string | null;
  notice?: string | null;
  providerIconRegistry?: readonly ProviderIconRegistryRow[];
  onRunNow: (routine: RoutineView) => void;
  onPause: (routine: RoutineView) => void;
  onResume: (routine: RoutineView) => void;
  onRetry: () => void;
}

const STATUS_DOT_VARIANT: Record<RoutineView['status'], 'success' | 'warning' | 'idle'> = {
  armed: 'success',
  paused: 'idle',
  blocked: 'warning',
  unscheduled: 'idle',
};

const STATUS_TEXT_COLOR: Record<RoutineView['status'], 'success' | 'warning' | 'muted'> = {
  armed: 'success',
  paused: 'muted',
  blocked: 'warning',
  unscheduled: 'muted',
};

export function RoutinesSurface(props: RoutinesSurfaceProps): React.ReactElement {
  const [expandedId, setExpandedId] = React.useState<string | null>(null);
  const frameRef = React.useRef<HTMLDivElement>(null);
  const frame = (content: React.ReactNode) => (
    <div ref={frameRef} style={{ width: '100%', height: '100%', minWidth: 0, overflow: 'hidden' }}>
      {content}
    </div>
  );

  if (props.error) {
    return frame(<SafeErrorCard title="Routines could not load." message={props.error} retryLabel="Try again" onRetry={props.onRetry} />);
  }
  if (props.routines === null) {
    return frame(
      <Container height="full" layout="vertical" alignItems="center" justifyContent="center" gap="sm">
        <Spinner size="lg" aria-label="Loading routines" />
        <Text variant="body" color="muted">Loading routines.</Text>
      </Container>,
    );
  }
  if (props.routines.length === 0) {
    return frame(
      <Container height="full" layout="vertical" alignItems="center" justifyContent="center" padding="xl">
        <EmptyPlaceholder message="No routines yet." />
      </Container>,
    );
  }

  return frame(
    <ScrollableSurface>
      <Container layout="vertical" padding="sm" gap="sm" minWidth="0">
        <Text variant="heading-sm" color="strong">Routines</Text>
        {props.notice ? <Text className="sr-only" aria-live="polite">{props.notice}</Text> : null}
        {props.routines.map((routine, index) => {
          const expanded = expandedId === routine.id;
          const detailId = `routine-detail-${index}`;
          const toggle = () => setExpandedId((current) => current === routine.id ? null : routine.id);
          const busy = props.busyId === routine.id;

          return (
            <Card
              key={routine.id}
              variant="ghost"
              padding="none"
              layout="row"
              alignItems="center"
              interactive
              className="outline-none ring-0 shadow-none"
              data-routine-row={routine.id}
              data-routine-expanded={expanded ? 'true' : 'false'}
              onClick={(event) => {
                if ((event.target as HTMLElement).closest('button, a')) return;
                toggle();
              }}
            >
              <Container layout="vertical" gap="xs" minWidth="0" flex={1}>
                <Container layout="horizontal" gap="sm" alignItems="center" justifyContent="between" width="full" minWidth="0">
                  <Container
                    as="button"
                    type="button"
                    layout="horizontal"
                    gap="xs"
                    alignItems="center"
                    flex="1"
                    minWidth="0"
                    aria-expanded={expanded}
                    aria-controls={detailId}
                    onClick={toggle}
                    style={{ textAlign: 'left', background: 'transparent', border: 0, padding: 0 }}
                  >
                    <StatusDot status={STATUS_DOT_VARIANT[routine.status]} size="md" label={routine.statusLabel} />
                    <Text as="span" variant="body-xs" color="strong" weight="semibold" truncate>{routine.name}</Text>
                    {expanded ? <Text as="span" variant="body-xs" color={STATUS_TEXT_COLOR[routine.status]} wrap="nowrap">{routine.statusLabel}</Text> : null}
                    {!expanded && routine.listStatusLabel ? (
                      <Text as="span" variant="caption" color="muted" wrap="nowrap" data-routine-list-status>{routine.listStatusLabel}</Text>
                    ) : null}
                  </Container>
                  <Container layout="horizontal" gap="xs" alignItems="center">
                    <Button
                      variant="primary"
                      size="sm"
                      disabled={!routine.ownerDispatch || busy || routine.status === 'paused'}
                      onClick={(event) => {
                        event.stopPropagation();
                        props.onRunNow(routine);
                      }}
                    >
                      {busy ? 'Starting now' : 'Run now'}
                    </Button>
                    {expanded ? (
                      <Button
                        variant="secondary"
                        size="sm"
                        disabled={routine.status !== 'paused' && !routine.scheduleAddressLabel}
                        onClick={(event) => {
                          event.stopPropagation();
                          if (routine.status === 'paused') props.onResume(routine);
                          else props.onPause(routine);
                        }}
                      >
                        {routine.status === 'paused' ? 'Resume' : 'Pause'}
                      </Button>
                    ) : null}
                  </Container>
                </Container>
                {routine.listWarning ? <Text variant="body-xs" color="muted">{routine.listWarning}</Text> : null}
                {expanded ? (
                  <div id={detailId} data-routine-detail={routine.id} onClick={(event) => event.stopPropagation()}>
                    <RoutineDetail routine={routine} providerIconRegistry={props.providerIconRegistry ?? []} />
                  </div>
                ) : null}
              </Container>
            </Card>
          );
        })}
      </Container>
    </ScrollableSurface>,
  );
}

function lowerFirst(value: string): string {
  return value.length > 0 ? value.charAt(0).toLowerCase() + value.slice(1) : value;
}

function firstViewId(surface: RoutineEvidenceSurface['surface']): string | undefined {
  const views = surface.surfaceInput?.views as Record<string, unknown> | undefined;
  const list = Array.isArray(views?.views) ? views.views : [];
  const first = list[0];
  return first && typeof first === 'object' && !Array.isArray(first) && typeof (first as Record<string, unknown>).id === 'string'
    ? (first as Record<string, unknown>).id as string
    : undefined;
}

function inlineSurfaceInput(evidence: RoutineEvidenceSurface): Record<string, unknown> {
  const addresses = evidence.records.map((record) => record.address).filter((address): address is string => Boolean(address));
  return {
    ...(evidence.surface.surfaceInput ?? {}),
    record_scope: {
      addresses: addresses.length > 0 ? addresses : ['routine-evidence::no-produced-records'],
      kinds: evidence.recordKinds,
    },
    latest_record_refs: evidence.latestRecordRefs,
    ...(firstViewId(evidence.surface) ? { initial_view_id: firstViewId(evidence.surface) } : {}),
  };
}

function readableRecordDetails(record: RoutineProducedRecord): string[] {
  const counts = record.payload.counts;
  if (counts && typeof counts === 'object' && !Array.isArray(counts)) {
    return Object.entries(counts as Record<string, unknown>)
      .filter(([, value]) => typeof value === 'number' || typeof value === 'string')
      .slice(0, 4)
      .map(([key, value]) => `${String(value)} ${key.replace(/_/g, ' ')}`);
  }
  return Object.entries(record.payload)
    .filter(([key, value]) => !['kind', 'id', 'title', 'name'].includes(key) && ['string', 'number', 'boolean'].includes(typeof value))
    .slice(0, 3)
    .map(([key, value]) => `${key.replace(/_/g, ' ')}: ${String(value)}`);
}

function stableScopeToken(value: string): string {
  let left = 0x811c9dc5;
  let right = 0xc8013ea4;
  for (let index = 0; index < value.length; index += 1) {
    const code = value.charCodeAt(index);
    left = Math.imul(left ^ code, 0x01000193);
    right = Math.imul(right ^ code, 0x85ebca6b);
  }
  return `${(left >>> 0).toString(16).padStart(8, '0')}${(right >>> 0).toString(16).padStart(8, '0')}`;
}

function scopedWorkspaceId(evidence: RoutineEvidenceSurface): string {
  const scopeKey = JSON.stringify({
    addresses: evidence.records.map((record) => record.address).filter(Boolean).sort(),
    kinds: [...evidence.recordKinds].sort(),
    latest: [...evidence.latestRecordRefs].sort(),
  });
  return `${evidence.surface.id}::workspace::${stableScopeToken(scopeKey)}`;
}

function EvidenceSurface({ evidence, hasExactLineage }: { evidence: RoutineEvidenceSurface; hasExactLineage: boolean }): React.ReactElement {
  const surface = evidence.surface;
  const packageEntry = surface.packageEntry;
  const recordCount = evidence.records.length;
  const openWorkspace = () => {
    const payload = placeableSurfacePayloadFromRecord(surface);
    emitPlaceableSurfaceIntent({
      ...payload,
      id: scopedWorkspaceId(evidence),
      // This is a self-describing scoped instance, not the unscoped catalog
      // surface. A null material target prevents catalog fallback from focusing
      // a different visual-database tab; packageEntry mounts the same owner.
      materialTarget: null,
      surfaceInput: inlineSurfaceInput(evidence),
    });
  };
  if (!packageEntry) return <></>;
  return (
    <Card variant="nested" padding="none" layout="column" data-routine-evidence-surface={surface.id}>
      <Container layout="horizontal" alignItems="center" justifyContent="between" padding="sm" gap="sm">
        <Container layout="vertical" gap="xs" minWidth="0">
          <Text variant="body-xs" color="strong" weight="semibold">{surface.label}</Text>
          <Text variant="caption" color="muted">
            {recordCount === 0
              ? 'No records from this routine are in this table yet.'
              : hasExactLineage
                ? `${recordCount} record${recordCount === 1 ? '' : 's'} created by this run.`
                : `${recordCount} record${recordCount === 1 ? '' : 's'} from this routine.`}
          </Text>
        </Container>
        <Button
          variant="ghost"
          size="icon-xs"
          aria-label={`Open ${surface.label} in workspace`}
          title={`Open ${surface.label} in workspace`}
          onClick={openWorkspace}
        >
          <Icon icon={ExternalLink} size="xs" color="muted" />
        </Button>
      </Container>
      <div style={{ height: 248, minHeight: 248, overflow: 'hidden', borderTop: '1px solid var(--glass-border-muted)' }}>
        <PlaceableSurfaceHost
          packageName={packageEntry.packageName}
          entryName={packageEntry.entryName}
          target={surface.target}
          materialTarget={surface.materialTarget}
          surfaceInput={inlineSurfaceInput(evidence)}
          fill
          interactive
          unavailableText="This evidence surface is not available yet."
        />
      </div>
    </Card>
  );
}

function RecordPreview({ record }: { record: RoutineProducedRecord }): React.ReactElement {
  const details = readableRecordDetails(record);
  return (
    <Card variant="nested" padding="sm" layout="row" alignItems="center" gap="sm" data-routine-record-preview={record.kind}>
      <DisplayMark spec={{ name: record.label, shape: 'rounded' }} size="sm" />
      <Container layout="vertical" gap="xs" minWidth="0">
        <Text variant="body-xs" color="strong" weight="semibold">{record.label}</Text>
        <Text variant="caption" color="muted">{details.length > 0 ? details.join(' · ') : record.kind}</Text>
      </Container>
    </Card>
  );
}

function RoutineDetail({
  routine,
  providerIconRegistry,
}: {
  routine: RoutineView;
  providerIconRegistry: readonly ProviderIconRegistryRow[];
}): React.ReactElement {
  return (
    <Container layout="vertical" padding="md" gap="sm" minWidth="0">
      {routine.purpose ? <Text variant="body" color="default">{routine.purpose}</Text> : null}
      {routine.providers.length > 0 ? (
        <Container layout="horizontal" gap="sm" alignItems="center" wrap="wrap" data-routine-providers={routine.id}>
          <Text variant="body-xs" color="muted">Uses</Text>
          {routine.providers.map((provider) => (
            <Container key={provider.ref} layout="horizontal" gap="xs" alignItems="center" data-provider-mention={provider.slug}>
              <ProviderMark providerSlug={provider.slug} providerName={provider.name} registry={providerIconRegistry} size="sm" decorative />
              <Text as="span" variant="body-xs" color="strong">{provider.name}</Text>
            </Container>
          ))}
        </Container>
      ) : null}
      <Text variant="body-xs" color="muted">
        {routine.cadence === 'Not scheduled yet' ? 'Not scheduled yet.' : `Runs ${lowerFirst(routine.cadence)}.`}
      </Text>
      {routine.recentRuns.length === 0 ? (
        <Text variant="body-xs" color="muted">No runs yet.</Text>
      ) : routine.recentRuns.map((run) => (
        <Container key={run.recordId} layout="horizontal" gap="sm" alignItems="center" title={run.fullTimestamp}>
          <StatusDot status="success" size="md" label="Completed" />
          <Text variant="body-xs" color="muted">Ran {lowerFirst(run.relativeTime)}.</Text>
        </Container>
      ))}
      <Container layout="vertical" gap="sm" minWidth="0" data-routine-inline-evidence={routine.id}>
        <Text variant="body" color="strong" weight="semibold">
          {routine.evidenceHasExactLineage ? 'What this run produced' : 'Routine evidence'}
        </Text>
        {routine.evidenceSurfaces.map((evidence) => (
          <EvidenceSurface key={evidence.surface.id} evidence={evidence} hasExactLineage={routine.evidenceHasExactLineage} />
        ))}
        {routine.unmappedProducedRecords.map((record, index) => (
          <RecordPreview key={`${record.kind}:${record.address ?? index}`} record={record} />
        ))}
        {routine.evidenceSurfaces.length === 0 && routine.unmappedProducedRecords.length === 0 ? (
          <Text variant="body-xs" color="muted">
            {routine.evidenceHasExactLineage ? 'This run produced no records.' : 'No records from this routine are available yet.'}
          </Text>
        ) : null}
        {routine.producedRecords.length === 0 && routine.evidenceExplanation ? (
          <Text variant="body-xs" color="muted" data-routine-evidence-explanation>
            Why: {routine.evidenceExplanation}
          </Text>
        ) : null}
      </Container>
      <DisclosureSection title="Technical proof" collapsible defaultOpen={false}>
        <Container layout="vertical" gap="sm">
          <Container layout="vertical" gap="xs">
            <Text variant="body" color="strong">Action: {routine.technical.actionLabel}</Text>
            <Text variant="body-xs" color="muted">{routine.technical.actionId}</Text>
          </Container>
          <Container layout="vertical" gap="xs">
            <Text variant="body" color="strong">Schedule: {routine.technical.scheduleLabel ?? 'No active schedule'}</Text>
            {routine.technical.scheduleId ? <Text variant="body-xs" color="muted">{routine.technical.scheduleId}</Text> : null}
          </Container>
          {routine.internalScheduleCount > 0 ? (
            <Container layout="vertical" gap="xs">
              <Text variant="body" color="strong">{routine.internalScheduleCount} internal step{routine.internalScheduleCount === 1 ? '' : 's'}</Text>
              {routine.technical.internalSchedules.map((schedule) => (
                <Container key={schedule.id} layout="vertical" gap="xs">
                  <Text variant="body" color="strong">Internal step: {schedule.label}</Text>
                  <Text variant="body-xs" color="muted">{schedule.id}</Text>
                </Container>
              ))}
            </Container>
          ) : null}
        </Container>
      </DisclosureSection>
    </Container>
  );
}
