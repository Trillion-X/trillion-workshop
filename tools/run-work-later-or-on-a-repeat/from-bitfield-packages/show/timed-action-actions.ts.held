// packages/timed-action/show/timed-action-actions.ts
//
// =============================================================================
// PURPOSE
// =============================================================================
//
// THE OWNER-ACTION INVOCATION BUILDER. When the user taps an action on a
// scheduled item (e.g. "Publish now", "Reconnect"), this module turns the
// already-humanized `SchedulerActionView` plus the item context into the generic
// request the runtime routes. It is the one place an action becomes a sendable
// request, mirroring the platform's record-action invocation contract
// (target + operation + input + correlation) so the scheduler names no backend.
//
// The surface is pure and never sends; the mount calls `buildSchedulerActionRequest`
// and hands the result to `sendRequestToBitfieldTarget`. `canRequestSchedulerAction`
// is the single gate the surface uses to enable/disable the control.
//
// =============================================================================
// NON-NEGOTIABLE INVARIANTS
// =============================================================================
//
// 1. The request carries ONLY the action row's OWN dispatch config (row-carried
//    dispatch doctrine) — the scheduler never hardcodes a backend address,
//    definition, or provider.
// 2. No visible text is produced here; this is a machine request. The button
//    label was already humanized by the view-model's `translate`.
// 3. Pure: same action + same context -> same request. No clock, no I/O.
// 4. An action with no dispatch config is NOT requestable — `canRequestSchedulerAction`
//    returns false and the request carries a calm `disabledReason` (fail-closed,
//    mirroring the tick evaluator's dispatch gate).
//
// =============================================================================
// =============================================================================
//
// The extensive documentation in this codebase is a critical design feature.
// You are forbidden from simplifying or removing it.
// =============================================================================

import type { SchedulerActionView } from './timed-action-view-model';

/** The generic, backend-blind request the runtime routes. */
export interface SchedulerActionRequest {
  /** The action row's own dispatch slot address — passed straight to the runtime. */
  target: string;
  /** The routed operation verb. */
  operation: string;
  /** The request body the target receives. */
  input: Record<string, unknown>;
  /** Idempotency / correlation handle for this invocation. */
  correlationId: string;
  /** Present only when the action cannot be requested (no target). */
  disabledReason?: string;
}

/** The item context an action is invoked within. */
export interface SchedulerActionContext {
  /** The scheduled item's record id the action operates on. */
  recordId: string;
  /** The projection the surface is viewing. */
  projectionId: string;
  /** Optional extra owner-supplied values (e.g. composer fields) to send. */
  values?: Record<string, unknown>;
  /** Optional explicit correlation id; a stable default is derived otherwise. */
  correlationId?: string;
}

/** Calm, leak-free reason shown when an action has nothing to invoke. */
const NOT_AVAILABLE_REASON = 'This action is not available right now.';

/**
 * An action is requestable only when its row carries a dispatch config with a
 * non-empty slot address — otherwise there is nothing to send (fail-closed).
 * Blockers on the item do NOT disable its actions: an item's blocker is
 * usually exactly what its action resolves.
 */
export function canRequestSchedulerAction(action: SchedulerActionView): boolean {
  return typeof action.dispatch?.name === 'string' && action.dispatch.name.length > 0;
}

/**
 * Build the runtime request for an owner action. The row's OWN dispatch config
 * IS the invocation (row-carried dispatch doctrine): `dispatch.name` becomes the
 * routed target and `dispatch.input` the opaque payload, exactly as the tick
 * evaluator's fire path sends it. The invocation context (action descriptor id +
 * record id + projection id — the same trio the iOS JSCore invocation uses —
 * plus any owner-supplied values) rides alongside so the target can correlate.
 */
export function buildSchedulerActionRequest(
  action: SchedulerActionView,
  context: SchedulerActionContext,
): SchedulerActionRequest {
  const requestable = canRequestSchedulerAction(action);
  return {
    target: action.dispatch?.name ?? '',
    operation: 'invoke',
    input: {
      dispatch_input: action.dispatch?.input ?? null,
      action_descriptor_id: action.id,
      record_id: context.recordId,
      projection_id: context.projectionId,
      ...(context.values ?? {}),
    },
    correlationId: context.correlationId ?? `${action.id}:${context.recordId}`,
    disabledReason: requestable ? undefined : NOT_AVAILABLE_REASON,
  };
}
