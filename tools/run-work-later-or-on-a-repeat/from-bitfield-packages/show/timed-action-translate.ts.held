// packages/timed-action/show/timed-action-translate.ts
//
// =============================================================================
// PURPOSE
// =============================================================================
//
// THE TRANSLATION SPINE (owner-label half). This module is one of exactly TWO
// sources of visible text in the content scheduler:
//
//   • statusView(rawState, schedulerStatusOverrides)  -> every MACHINE STATE
//     (re-exported here so callers import the bound pair from one place).
//   • translate(field, ownerLabels)                   -> every OWNER LABEL
//     (channel name, account handle, metric name, blocker description, action
//     verb, group name, schedule field) becomes human text HERE and nowhere
//     else.
//
// A "field" is a self-describing request: a kind (data) plus the raw owner
// material (an inline label and/or a key into the owner-supplied label map).
// translate resolves the human label, and — this is the structural guarantee —
// if the only material available is an id, address, payload key, or any other
// internal token, it REFUSES to emit it and returns a neutral, field-typed
// fallback instead. The renderer cannot leak an internal string because the
// only door from owner material to visible text is this function, and this
// function will not carry one through.
//
// =============================================================================
// NON-NEGOTIABLE INVARIANTS
// =============================================================================
//
// 1. translate NEVER returns a raw id / address / payload key / enum. A leaky
//    candidate is dropped and the field-typed neutral fallback is returned.
// 2. Visible text comes from owner-supplied labels or the neutral fallback map
//    (DATA) — never from a hardcoded business string in a branch.
// 3. The fallback is keyed by field kind via a Map lookup, never by `kind ===`
//    chains (L090): a new field kind is a new DATA row, not new branch code.
// 4. Pure and JSCore-safe: no React, DOM, Date, CSS, or runtime imports. The
//    same function serves the React surface and the iOS JSCore adapter.
//
// =============================================================================
// =============================================================================
//
// The extensive documentation in this codebase is a critical design feature.
// You are forbidden from simplifying or removing it.
// =============================================================================

// Re-export the machine-state half of the spine so a caller imports both halves
// from one module. statusView is bound to schedulerStatusOverrides by callers
// (see timed-action-copy.ts for the override DATA map).
export { statusView } from '@/packages/ui/show/status-vocabulary';
export type { StatusView, StatusTone, StatusOverrides } from '@/packages/ui/show/status-vocabulary';

/**
 * The owner-supplied label map. Keys are opaque owner ids (kept internal); the
 * values are the human labels the owner package chose. translate reads values
 * out of this map — it never shows a key.
 */
export type OwnerLabels = Record<string, string | null | undefined>;

/**
 * A request to turn owner material into one human label. `kind` selects the
 * neutral fallback; `label` is an inline owner-supplied label (preferred when
 * present and clean); `key` is a lookup into OwnerLabels when the label lives in
 * the map rather than inline.
 */
export interface TranslateField {
  kind: string;
  label?: string | null;
  key?: string | null;
}

// -----------------------------------------------------------------------------
// Neutral fallback DATA (field kind -> calm, human, field-appropriate phrase).
// Adding a field kind is a new row here, never a new branch in translate().
// Every value is in plain product language and contains zero internal terms.
// -----------------------------------------------------------------------------
const NEUTRAL_FALLBACKS: ReadonlyArray<readonly [string, string]> = [
  ['channel', 'This channel'],
  ['account', 'This account'],
  ['metric', 'Metric'],
  ['target', 'This destination'],
  ['campaign', 'This campaign'],
  ['blocker', 'Needs attention'],
  ['action', 'Continue'],
  ['group', 'Other'],
  ['post', 'This post'],
  ['field', 'Detail'],
];

const NEUTRAL_FALLBACK_BY_KIND = new Map<string, string>(NEUTRAL_FALLBACKS);

// The generic fallback when a field kind has no dedicated row. Still human,
// still leak-free — never an id or "unknown".
const GENERIC_FALLBACK = 'Detail';

/**
 * The structural id-guard. A candidate visible string is rejected (so translate
 * falls back to the neutral phrase) when it looks like an internal token rather
 * than a human label. These patterns mirror the boundary test's raw-id set so
 * the function defends exactly what the gate forbids:
 *   • UUID-shaped runs (`a1b2c3d4-e5f6-...`)
 *   • address separators (`::`)
 *   • internal vocabulary (payload / fact / envelope / slot / descriptor / ref
 *     / address / package)
 *   • a bare dotted/colon key path with no spaces (e.g. `prop:extension:name`,
 *     `fields.value`) — a human label has spaces or is a single plain word.
 */
function looksLikeRawId(value: string): boolean {
  if (/[0-9a-f]{8}-[0-9a-f]{4}/i.test(value)) return true;
  if (value.includes('::')) return true;
  if (!/\s/.test(value) && /-\d{4}-\d{2}-\d{2}(?:$|[-_:])/.test(value)) return true;
  if (/\b(payload|fact|envelope|slot|descriptor|address)\b/i.test(value)) return true;
  if (/(^|\s)(ref|package)\b/i.test(value)) return true;
  // A token path: contains `:` or a `.`-joined identifier and no whitespace.
  if (!/\s/.test(value) && (value.includes(':') || /^[a-z0-9_]+(\.[a-z0-9_]+)+$/i.test(value))) {
    return true;
  }
  return false;
}

/** A candidate is usable visible text only if it is a clean, non-leaky string. */
function cleanLabel(value: string | null | undefined): string | null {
  if (typeof value !== 'string') return null;
  const trimmed = value.trim();
  if (trimmed === '') return null;
  if (looksLikeRawId(trimmed)) return null;
  return trimmed;
}

/** The neutral, field-typed fallback for a kind (DATA lookup, never a branch). */
export function neutralFallback(kind: string): string {
  return NEUTRAL_FALLBACK_BY_KIND.get(kind) ?? GENERIC_FALLBACK;
}

/**
 * Turn one owner-material request into human text. Resolution order:
 *   1. inline `field.label`, if present and clean
 *   2. `ownerLabels[field.key]`, if the key resolves to a clean label
 *   3. the neutral field-typed fallback
 * Never returns a raw id/address/key — a leaky candidate is dropped to (3).
 */
export function translate(field: TranslateField, ownerLabels: OwnerLabels = {}): string {
  const inline = cleanLabel(field.label);
  if (inline) return inline;

  if (field.key != null) {
    const fromMap = cleanLabel(ownerLabels[field.key]);
    if (fromMap) return fromMap;
  }

  return neutralFallback(field.kind);
}
