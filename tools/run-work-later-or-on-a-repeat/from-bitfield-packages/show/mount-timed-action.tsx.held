// packages/timed-action/show/mount-timed-action.tsx
//
// =============================================================================
// PURPOSE
// =============================================================================
//
// THE WEB / DESKTOP MOUNT. The thin adapter the host calls to put the content
// scheduler on screen. It passes the host-folded projection THROUGH UNCHANGED —
// `undefined` stays `undefined` so the surface renders its honest loading state
// instead of a fabricated empty one. It also forwards the owner-label DATA, the
// render-edge locale, the pre-selection, and the action sink the host sends with.
//
// The mount owns NO view logic and NO clock: folding happened upstream (the
// mount that owns the clock folds via readScheduledActionGraph and hands the
// folded projection in `context.projection`); formatting happens at the render
// edge inside the surface. This file is only wiring.
//
// =============================================================================
// =============================================================================
//
// The extensive documentation in this codebase is a critical design feature.
// You are forbidden from simplifying or removing it.
// =============================================================================

import React from 'react';
import { useBitfieldData } from '@bitfield/runtime-kit/react';
import { sendRequestToBitfieldTarget } from '@bitfield/runtime-kit';
import { mountReactSurface } from '../../../ui/show/react-surface-mount';
import { TimedActionSurface } from './TimedActionSurface';
import { RoutinesSurface } from './RoutinesSurface';
import {
  buildRoutineRunNowWrite,
  projectRoutines,
  readRoutineProviderIconRegistry,
  type RoutineRecordRow,
  type RoutineView,
} from '../read-data/read-routine-records';

type TimedActionContext = React.ComponentProps<typeof TimedActionSurface>;

type MountArgs = {
  el: HTMLElement;
  props?: TimedActionMountProps;
};

type TimedActionMountProps = TimedActionContext & {
  surfaceInput?: unknown;
  surface_input?: unknown;
};

function readSurfaceInput(props: TimedActionMountProps): Record<string, unknown> | undefined {
  const candidate = props.surfaceInput ?? props.surface_input;
  return candidate && typeof candidate === 'object' && !Array.isArray(candidate)
    ? (candidate as Record<string, unknown>)
    : undefined;
}

function readProjectionAddress(surfaceInput: unknown): string | null {
  if (surfaceInput && typeof surfaceInput === 'object' && !Array.isArray(surfaceInput)) {
    const addr = (surfaceInput as Record<string, unknown>).projection_address;
    if (typeof addr === 'string' && addr.length > 0) return addr;
  }
  return null;
}

function rowsFromReply(reply: { payload: Uint8Array }): RoutineRecordRow[] {
  const parsed = JSON.parse(new TextDecoder().decode(reply.payload));
  const rows = parsed?.items ?? parsed?.output?.items ?? [];
  if (!Array.isArray(rows)) throw new Error('The routine owner returned no record list.');
  return rows;
}

async function findRows(kind: string, payloadKinds: string[] = []): Promise<RoutineRecordRow[]> {
  return rowsFromReply(await sendRequestToBitfieldTarget({
    target: 'slot::find-current-items',
    payload: {
      operation: 'find-current-items',
      in: kind,
      include: ['address', 'payload'],
      ...(payloadKinds.length > 0
        ? { where: { all: [{ field: 'kind', in: payloadKinds }] } }
        : {}),
    },
  }));
}

function rowPayload(row: RoutineRecordRow): Record<string, unknown> | null {
  if (!row || typeof row !== 'object' || Array.isArray(row)) return null;
  const carrier = row as Record<string, unknown>;
  const value = carrier.payload ?? carrier;
  return value && typeof value === 'object' && !Array.isArray(value)
    ? value as Record<string, unknown>
    : null;
}

async function findRoutinePublishedRows(): Promise<RoutineRecordRow[]> {
  const owners = await findRows('published-record', [
    'action',
    'routine-presentation',
    'routine-control',
    'service-connection-descriptor',
    'provider-icon',
    'placeable-surface',
  ]);
  const outputKinds = [...new Set(owners.flatMap((row) => {
    const value = rowPayload(row);
    return value?.kind === 'routine-presentation' && Array.isArray(value.output_kinds)
      ? value.output_kinds.filter((kind): kind is string => typeof kind === 'string' && kind.length > 0)
      : [];
  }))];
  if (outputKinds.length === 0) return owners;
  return [...owners, ...await findRows('published-record', outputKinds)];
}

function RoutinesSurfaceReader() {
  const [routines, setRoutines] = React.useState<RoutineView[] | null>(null);
  const [providerIconRegistry, setProviderIconRegistry] = React.useState<Record<string, unknown>[]>([]);
  const [error, setError] = React.useState<string | null>(null);
  const [busyId, setBusyId] = React.useState<string | null>(null);
  const [notice, setNotice] = React.useState<string | null>(null);

  const refresh = React.useCallback(async () => {
    try {
      const [schedules, published, receipts, scheduledRecords] = await Promise.all([
        findRows('recurring-window-schedule'),
        findRoutinePublishedRows(),
        findRows('scheduled-action-receipt'),
        findRows('scheduled-action-record'),
      ]);
      setRoutines(projectRoutines({ schedules, published, receipts, scheduledRecords }));
      setProviderIconRegistry(readRoutineProviderIconRegistry(published));
      setError(null);
    } catch (reason) {
      setError(reason instanceof Error ? reason.message : 'The routine records could not be read.');
    }
  }, []);

  React.useEffect(() => { void refresh(); }, [refresh]);

  const runNow = React.useCallback(async (routine: RoutineView) => {
    setBusyId(routine.id);
    setNotice(null);
    try {
      const request = buildRoutineRunNowWrite(routine);
      await sendRequestToBitfieldTarget({
        target: 'slot::workflow',
        payload: {
          operation: 'execute_definition',
          definition_id: 'action:timed-action.write-scheduled-action',
          include_steps: false,
          include_output: true,
          input: { operation: 'run-now', record_id: request.recordId, writes: request.writes },
        },
      });
      setNotice(`${routine.name} is queued for the next engine tick.`);
      await refresh();
      window.setTimeout(() => { void refresh(); }, 5000);
      window.setTimeout(() => { void refresh(); setBusyId(null); }, 15000);
      window.setTimeout(() => { void refresh(); }, 30000);
      window.setTimeout(() => { void refresh(); }, 60000);
    } catch (reason) {
      setBusyId(null);
      setError(reason instanceof Error ? reason.message : 'The routine could not be started.');
    }
  }, [refresh]);

  const setPaused = React.useCallback(async (routine: RoutineView, paused: boolean) => {
    if (!routine.scheduleAddressLabel || !routine.schedulePayload) return;
    const observedAt = new Date().toISOString();
    const controlAddress = `package::timed-action::routine-control::${encodeURIComponent(routine.ownerRef)}`;
    const writes: Array<Record<string, unknown>> = [
      {
        address: controlAddress,
        path: ['current-item', 'published-record'],
        payload: { kind: 'routine-control', owner_ref: routine.ownerRef, state: paused ? 'paused' : 'armed', schedule_address_label: routine.scheduleAddressLabel, schedule_payload: routine.schedulePayload, observed_at: observedAt },
      },
      paused
        ? { address: routine.scheduleAddressLabel, path: ['current-item', 'recurring-window-schedule'] }
        : { address: routine.scheduleAddressLabel, path: ['current-item', 'recurring-window-schedule'], payload: routine.schedulePayload },
    ];
    try {
      await sendRequestToBitfieldTarget({
        target: 'slot::workflow',
        payload: { operation: 'execute_definition', definition_id: 'action:timed-action.write-scheduled-action', include_steps: false, include_output: true, input: { operation: paused ? 'pause-routine' : 'resume-routine', record_id: routine.ownerRef, writes } },
      });
      setNotice(`${routine.name} is ${paused ? 'paused' : 'armed again'}.`);
      await refresh();
    } catch (reason) {
      setError(reason instanceof Error ? reason.message : 'The routine schedule could not be changed.');
    }
  }, [refresh]);

  return React.createElement(RoutinesSurface, {
    routines,
    error,
    busyId,
    notice,
    providerIconRegistry,
    onRunNow: runNow,
    onPause: (routine: RoutineView) => { void setPaused(routine, true); },
    onResume: (routine: RoutineView) => { void setPaused(routine, false); },
    onRetry: () => { setError(null); void refresh(); },
  });
}

function TimedActionSurfaceReader({
  props,
}: {
  props: TimedActionMountProps;
}) {
  const surfaceInput = readSurfaceInput(props);
  if (surfaceInput?.mode === 'routines') {
    return React.createElement(RoutinesSurfaceReader);
  }
  const projectionAddress = readProjectionAddress(surfaceInput);
  return projectionAddress
    ? React.createElement(TimedActionAddressProjectionReader, { props, projectionAddress })
    : React.createElement(TimedActionDefaultProjectionReader, { props });
}

function TimedActionProjection({
  props,
  liveProjection,
}: {
  props: TimedActionMountProps;
  liveProjection: unknown;
}) {
  const projection = props.projection ?? liveProjection;
  return React.createElement(TimedActionSurface, {
    projection,
    onAction: props.onAction,
    selectedRecordId: props.selectedRecordId ?? null,
    ownerLabels: props.ownerLabels,
    locale: props.locale,
  });
}

function TimedActionAddressProjectionReader({
  props,
  projectionAddress,
}: {
  props: TimedActionMountProps;
  projectionAddress: string;
}) {
  const liveProjection = useBitfieldData({
    input: 'record-by-address',
    params: { address: projectionAddress },
  });
  return React.createElement(TimedActionProjection, { props, liveProjection });
}

function TimedActionDefaultProjectionReader({ props }: { props: TimedActionMountProps }) {
  const liveProjection = useBitfieldData('scheduled-action-view');
  return React.createElement(TimedActionProjection, { props, liveProjection });
}

function renderTimedAction(props: TimedActionMountProps = {}) {
  return React.createElement(TimedActionSurfaceReader, { props });
}

// Preserve the legacy adapter for non-DOM callers while the package entry uses
// the same host-owned React mount seam as every other browser surface.
export function bitfieldMount(_target: unknown, props: TimedActionMountProps = {}) {
  return renderTimedAction(props);
}

export default function mount({ el, props = {} }: MountArgs) {
  return mountReactSurface(el, renderTimedAction(props));
}
