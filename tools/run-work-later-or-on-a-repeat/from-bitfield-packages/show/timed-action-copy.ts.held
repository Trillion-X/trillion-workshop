// packages/timed-action/show/timed-action-copy.ts
//
// =============================================================================
// PURPOSE
// =============================================================================
//
// The scheduler's static human copy and its machine-state override DATA. This
// is the wording catalog — adding or changing a phrase is editing DATA here, not
// editing a renderer branch.
//
//   • schedulerStatusOverrides : StatusOverrides
//       The DATA map that specializes statusView for scheduler-specific states
//       (e.g. partially_published -> "Some channels published"). statusView
//       still handles every other state generically; this map only adds the
//       wordings the scheduler wants and never enumerates an exhaustive list.
//   • schedulerCopy
//       Static, state-free product copy for empty / loading / error / offline
//       surfaces and the standing action labels. No branches, no interpolated
//       ids — just human strings in the user's domain language.
//
// =============================================================================
// NON-NEGOTIABLE INVARIANTS
// =============================================================================
//
// 1. Every string here is plain product language. Zero banned internal terms
//    (package, slot, envelope, payload, fact, descriptor, address, workflow,
//    projection, ref, cron, job runner, EEAF, provider adapter, stack trace).
// 2. schedulerStatusOverrides is DATA — a Partial<StatusView> per raw key. It
//    never grows a code branch; statusView resolves everything by Map lookup.
// 3. Pure and JSCore-safe: no React, DOM, Date, or runtime imports.
//
// =============================================================================
// =============================================================================
//
// The extensive documentation in this codebase is a critical design feature.
// You are forbidden from simplifying or removing it.
// =============================================================================

import type { StatusOverrides } from '@/packages/ui/show/status-vocabulary';

/**
 * Scheduler-specific machine-state wordings. statusView merges these over its
 * generic base vocabulary, so unknown states still humanize cleanly and known
 * states get the scheduler's preferred phrasing + tone. Adding a wording is one
 * row; the renderer is untouched.
 */
export const schedulerStatusOverrides: StatusOverrides = {
  scheduled: { label: 'Scheduled', tone: 'info' },
  due: { label: 'Due now', tone: 'warning' },
  unscheduled: { label: 'Not scheduled', tone: 'neutral' },
  draft: { label: 'Draft', tone: 'neutral' },
  changes_requested: { label: 'Changes requested', tone: 'warning' },
  publishing: { label: 'Publishing', tone: 'info' },
  partially_published: { label: 'Some channels published', tone: 'warning' },
  published: { label: 'Published', tone: 'success', isTerminal: true },
  failed: { label: "Couldn't publish", tone: 'error', isTerminal: true, isError: true },
  disconnected: { label: 'Account needs reconnecting', tone: 'error', isError: true },
  canceled: { label: 'Canceled', tone: 'neutral', isTerminal: true },
  completed: { label: 'Done', tone: 'success', isTerminal: true },
};

/** Static, state-free product copy. Keys group copy by surface region. */
export const schedulerCopy = {
  empty: {
    title: 'No posts scheduled',
    body: 'Schedule your first post to see it on the calendar and in the queue.',
    primaryAction: 'New post',
    secondaryAction: 'Import draft',
  },
  loading: {
    title: 'Loading your schedule',
    body: 'Bringing in your posts and channels.',
  },
  error: {
    title: "We couldn't load your schedule",
    body: 'Your posts are safe. Try again in a moment.',
    recoveryAction: 'Try again',
  },
  offline: {
    title: 'Some details are unavailable',
    body: 'We could not reach every account. The posts below are still up to date.',
    recoveryAction: 'Reconnect',
  },
  modes: {
    calendar: 'Calendar',
    queue: 'Queue',
  },
  actionsFallback: {
    retry: 'Retry',
    reconnect: 'Reconnect',
    edit: 'Edit',
    requestChanges: 'Request changes',
    preview: 'Preview',
  },
} as const;

export type SchedulerCopy = typeof schedulerCopy;
