// packages/timed-action/show/timed-action-view-model.ts
//
// =============================================================================
// PURPOSE
// =============================================================================
//
// THE VIEW-MODEL. The single pure function that turns the already-folded
// scheduled-action projection into the render-ready model that BOTH the React
// surface and the iOS JSCore adapter consume. It is the one place that:
//
//   • decides the three honest outcomes (loading / ready / error),
//   • routes every visible string through the Translation Spine
//     (statusView for machine states, translate for owner labels), and
//   • emits a machine-readable `proof` of what it produced.
//
// It folds NOTHING and reads NO clock. Folding (which needs "now") happens in
// the mount that owns the clock (see mount-timed-action.tsx); this function
// consumes the folded projection and is therefore Date-free and portable: the
// exact same shaping runs under React (browser) and under JSCore (iOS).
//
// =============================================================================
// NON-NEGOTIABLE INVARIANTS
// =============================================================================
//
// 1. PURE + DATE-FREE: no React, no DOM, no CSS, no `new Date()`/`Date.now()`.
//    The same output for the same input on every host.
// 2. EVERY visible string is produced by the spine — `statusView(rawKey,
//    schedulerStatusOverrides)` for states, `translate(field, ownerLabels)` for
//    owner labels, or the static `schedulerCopy` DATA. A raw id / address /
//    state key NEVER reaches a visible field; translate drops leaky candidates
//    to a neutral fallback and the headline state is humanized by statusView.
// 3. DATA-DRIVEN, NOT ENUMERATED (L090): the headline state is chosen by an
//    ordered list of state SOURCES tried by presence — never a `state ===` or
//    `switch` over status values. A new state needs zero code here: statusView
//    humanizes it and an override row gives it preferred wording.
// 4. ARBITRARY OWNER VOCABULARY: any channel/account/group/metric label or
//    status name flows through as DATA. The view-model never hardcodes a
//    business name (no "Instagram", no "Published" literal, no provider).
//
// =============================================================================
// =============================================================================
//
// The extensive documentation in this codebase is a critical design feature.
// You are forbidden from simplifying or removing it.
// =============================================================================

import { statusView, translate, type OwnerLabels, type StatusView } from './timed-action-translate';
import { schedulerStatusOverrides, schedulerCopy, type SchedulerCopy } from './timed-action-copy';

// -----------------------------------------------------------------------------
// Folded-projection input contract (what readScheduledActionGraph produces).
// These mirror the read-data fold; we accept them as `unknown` at the door and
// validate defensively so a malformed value becomes the error model, never a
// thrown exception reaching the surface.
// -----------------------------------------------------------------------------

/** One owner-evidence row carried on a folded item (a blocker when allowed=false). */
interface FoldedEvidence {
  allowed?: boolean;
  tone?: string | null;
  reason_refs?: unknown;
  next_action_refs?: unknown;
}

/** One owner-action descriptor carried on a folded item. The row carries its
 * OWN complete dispatch config as DATA (row-carried dispatch doctrine) — the
 * view-model passes it through opaquely; it is never rendered. */
interface FoldedAction {
  action_id?: string | null;
  label?: string | null;
  dispatch?: { name?: string | null; input?: unknown } | null;
}

/** One relationship row (e.g. a publish target / channel) on a folded item. */
interface FoldedRelationship {
  target_id?: string | null;
  relation_role?: string | null;
}

/** One folded scheduled-action item as produced by readScheduledActionGraph. */
interface FoldedItem {
  record_id: string;
  label?: string | null;
  group?: string | null;
  fields?: Record<string, unknown> | null;
  relationships?: FoldedRelationship[] | null;
  time_window?: { start?: string | null; timezone?: string | null } | null;
  due_state?: string | null;
  actions?: FoldedAction[] | null;
  owner_evidence?: FoldedEvidence[] | null;
  blocked_action_count?: number | null;
  receipt?: { operation?: string | null } | null;
  next_action_refs?: unknown;
}

/** The folded projection envelope. */
interface FoldedProjection {
  projection_id?: string | null;
  items?: FoldedItem[] | null;
  groups?: Record<string, string[]> | null;
  proof?: Record<string, unknown> | null;
}

// -----------------------------------------------------------------------------
// View-model output contract (what the surface and the JSCore adapter render).
// Every string field below is already humanized through the spine. The `id` /
// `dispatch` machine handles are present for keys + invocation and are NEVER
// rendered as text by the surface.
// -----------------------------------------------------------------------------

/** A render-ready publish target (channel / account / destination) chip. */
export interface SchedulerTargetView {
  /** Stable key for React/selection — never rendered as text. */
  id: string;
  /** Humanized destination label (owner label or neutral fallback). */
  label: string;
}

/** A render-ready blocker ("needs attention") with optional repair action. */
export interface SchedulerBlockerView {
  /** Stable key — never rendered as text. */
  id: string;
  /** Humanized reason the user can act on. */
  label: string;
  /** Tone for the chip; defaults to the warning lane. */
  tone: StatusView['tone'];
}

/** A render-ready owner action the user can invoke on an item. */
export interface SchedulerActionView {
  /** Stable key — never rendered as text. */
  id: string;
  /** Humanized verb the button shows. */
  label: string;
  /** The row's OWN dispatch config (machine) — passed to the runtime verbatim,
   * never shown. `name` is any slot address; `input` is its opaque payload. */
  dispatch: { name: string; input: unknown } | null;
}

/** Structured, machine-readable schedule timing — formatted at the render edge. */
export interface SchedulerWhenView {
  /** Calendar-day bucket key `YYYY-MM-DD` (pure string slice) — never shown raw. */
  dayKey: string | null;
  /** The instant the item is scheduled for (ISO) — formatted by the edge, not shown raw. */
  startIso: string | null;
  /** The owner-supplied timezone for edge formatting — never shown raw. */
  timezone: string | null;
}

/** One fully-humanized scheduled item the surface renders. */
export interface SchedulerItemView {
  /** Stable record key — never rendered as text. */
  id: string;
  /** Humanized post title. */
  title: string;
  /** Humanized group name. */
  group: string;
  /** The headline machine state, humanized + toned by statusView. */
  status: StatusView;
  /** Structured timing for the render edge to format. */
  when: SchedulerWhenView;
  /** Humanized publish targets. */
  targets: SchedulerTargetView[];
  /** Humanized blockers (empty when nothing needs attention). */
  blockers: SchedulerBlockerView[];
  /** Humanized owner actions. */
  actions: SchedulerActionView[];
  /** True when at least one blocker needs attention. */
  hasBlockers: boolean;
}

/** One group section (ordered) referencing its item ids. */
export interface SchedulerGroupView {
  /** Stable group key — never rendered as text. */
  id: string;
  /** Humanized group title. */
  title: string;
  /** Member item ids in display order. */
  itemIds: string[];
}

/** Machine-readable proof of what the view-model produced (for tests + audit). */
export interface SchedulerProof {
  status: SchedulerStatus;
  group_count: number;
  item_count: number;
  visible_action_count: number;
  blocker_count: number;
  target_count: number;
  scheduled_count: number;
  /** State keys observed (raw machine keys) — proof that humanization covered them. */
  observed_state_keys: string[];
  /** The single visible-text boundary in force. */
  translation_boundary: 'statusView+translate';
}

export type SchedulerStatus = 'loading' | 'ready' | 'error';

/** The complete render-ready model. The surface always receives a well-formed one. */
export interface SchedulerModel {
  status: SchedulerStatus;
  projectionId: string;
  /** Static product copy (empty / loading / error / offline / modes / actions). */
  copy: SchedulerCopy;
  items: SchedulerItemView[];
  groups: SchedulerGroupView[];
  /** A calm, leak-free message for the loading / error / empty surfaces. */
  message: string;
  proof: SchedulerProof;
}

/** Options for shaping. `ownerLabels` is the owner-supplied id→label DATA map. */
export interface BuildSchedulerModelOptions {
  ownerLabels?: OwnerLabels;
}

// -----------------------------------------------------------------------------
// State-source resolution (L090): the headline state key is chosen by the FIRST
// source that yields a value, tried in order. We never compare the VALUES — we
// only check which source is present, then hand the raw key to statusView, which
// humanizes any key (known via overrides, unknown via its generic base). Adding
// a new state is zero code here.
// -----------------------------------------------------------------------------
const STATE_SOURCES: ReadonlyArray<(item: FoldedItem) => string | null> = [
  // 1. The owner's explicit workflow or publish status, when set.
  (item) => cleanKey(item.fields?.status),
  // 2. The folded schedule-timing state (already folds terminal receipt ops).
  (item) => cleanKey(item.due_state),
];

function cleanKey(value: unknown): string | null {
  if (typeof value !== 'string') return null;
  const trimmed = value.trim();
  return trimmed === '' ? null : trimmed;
}

/** Resolve the single headline state key for an item by source presence. */
function resolveStateKey(item: FoldedItem): string {
  for (const source of STATE_SOURCES) {
    const key = source(item);
    if (key) return key;
  }
  // Last-resort: an unscheduled item with no status and no timing.
  return 'unscheduled';
}

// -----------------------------------------------------------------------------
// Builders for each humanized sub-view. Each routes its visible text through the
// spine and keeps machine handles (ids, target refs) out of visible fields.
// -----------------------------------------------------------------------------

function buildTargets(item: FoldedItem, ownerLabels: OwnerLabels): SchedulerTargetView[] {
  const relationships = Array.isArray(item.relationships) ? item.relationships : [];
  const out: SchedulerTargetView[] = [];
  for (const rel of relationships) {
    if (rel?.relation_role !== 'target') continue;
    const id = cleanKey(rel.target_id);
    if (!id) continue;
    out.push({ id, label: translate({ kind: 'target', key: id }, ownerLabels) });
  }
  return out;
}

function toTone(value: unknown): StatusView['tone'] {
  // A blocker carries an owner-supplied tone hint; we accept only the known
  // tone lane names and otherwise default to the attention (warning) lane.
  // This is a presentation lane, not a business state — no humanized string.
  const tone = cleanKey(value);
  if (tone === 'info' || tone === 'success' || tone === 'warning' || tone === 'error' || tone === 'neutral') {
    return tone;
  }
  return 'warning';
}

function buildBlockers(item: FoldedItem, ownerLabels: OwnerLabels): SchedulerBlockerView[] {
  const evidence = Array.isArray(item.owner_evidence) ? item.owner_evidence : [];
  const out: SchedulerBlockerView[] = [];
  for (const row of evidence) {
    if (row?.allowed !== false) continue;
    const reasonRefs = Array.isArray(row.reason_refs) ? row.reason_refs : [];
    const reasonKey = cleanKey(reasonRefs[0]);
    const id = reasonKey ?? `${item.record_id}:blocker:${out.length}`;
    out.push({
      id,
      label: translate({ kind: 'blocker', key: reasonKey ?? undefined }, ownerLabels),
      tone: toTone(row.tone),
    });
  }
  return out;
}

function buildActions(item: FoldedItem, ownerLabels: OwnerLabels): SchedulerActionView[] {
  const actions = Array.isArray(item.actions) ? item.actions : [];
  const out: SchedulerActionView[] = [];
  for (const action of actions) {
    const id = cleanKey(action?.action_id);
    if (!id) continue;
    const dispatchName = cleanKey(action?.dispatch?.name);
    out.push({
      id,
      label: translate({ kind: 'action', label: action.label, key: id }, ownerLabels),
      dispatch: dispatchName ? { name: dispatchName, input: action?.dispatch?.input ?? null } : null,
    });
  }
  return out;
}

function buildWhen(item: FoldedItem): SchedulerWhenView {
  const start = cleanKey(item.time_window?.start);
  // Pure string slice for the calendar-day bucket — no Date construction.
  const dayKey = start && start.length >= 10 ? start.slice(0, 10) : null;
  return { dayKey, startIso: start, timezone: cleanKey(item.time_window?.timezone) };
}

function buildItem(item: FoldedItem, ownerLabels: OwnerLabels): SchedulerItemView {
  const stateKey = resolveStateKey(item);
  const blockers = buildBlockers(item, ownerLabels);
  return {
    id: item.record_id,
    title: translate({ kind: 'post', label: item.label, key: item.record_id }, ownerLabels),
    group: translate({ kind: 'group', label: cleanKey(item.group) ?? undefined }, ownerLabels),
    status: statusView(stateKey, schedulerStatusOverrides),
    when: buildWhen(item),
    targets: buildTargets(item, ownerLabels),
    blockers,
    actions: buildActions(item, ownerLabels),
    hasBlockers: blockers.length > 0,
  };
}

// -----------------------------------------------------------------------------
// Group ordering: preserve the order groups first appear among the (already
// start-sorted) items, so the surface and the proof are deterministic.
// -----------------------------------------------------------------------------
function buildGroups(items: SchedulerItemView[]): SchedulerGroupView[] {
  // Bucket by the humanized group title (the only group handle the item view
  // exposes), preserving first-appearance order among the already start-sorted
  // items. Two source groups that humanize to the same title intentionally
  // collapse into one visible section.
  const order: string[] = [];
  const byTitle = new Map<string, string[]>();
  for (const item of items) {
    const title = item.group;
    if (!byTitle.has(title)) {
      byTitle.set(title, []);
      order.push(title);
    }
    byTitle.get(title)!.push(item.id);
  }
  return order.map((title) => ({ id: title, title, itemIds: byTitle.get(title)! }));
}

// -----------------------------------------------------------------------------
// The three honest outcomes.
// -----------------------------------------------------------------------------

function isFoldedProjection(value: unknown): value is FoldedProjection {
  return typeof value === 'object' && value !== null && Array.isArray((value as FoldedProjection).items);
}

function loadingModel(): SchedulerModel {
  return {
    status: 'loading',
    projectionId: 'default',
    copy: schedulerCopy,
    items: [],
    groups: [],
    message: schedulerCopy.loading.title,
    proof: emptyProof('loading'),
  };
}

function errorModel(): SchedulerModel {
  return {
    status: 'error',
    projectionId: 'default',
    copy: schedulerCopy,
    items: [],
    groups: [],
    message: schedulerCopy.error.title,
    proof: emptyProof('error'),
  };
}

function emptyProof(status: SchedulerStatus): SchedulerProof {
  return {
    status,
    group_count: 0,
    item_count: 0,
    visible_action_count: 0,
    blocker_count: 0,
    target_count: 0,
    scheduled_count: 0,
    observed_state_keys: [],
    translation_boundary: 'statusView+translate',
  };
}

/**
 * Build the render-ready model from the folded projection. Three outcomes:
 *   • `null`/`undefined`  -> loading model (data not present yet)
 *   • folded projection    -> ready model (possibly an empty schedule)
 *   • anything else        -> error model with a calm message
 *
 * Never throws and never returns undefined — the surface always gets a model.
 */
export function buildSchedulerModel(
  projection: unknown,
  options: BuildSchedulerModelOptions = {},
): SchedulerModel {
  if (projection === null || projection === undefined) return loadingModel();
  if (!isFoldedProjection(projection)) return errorModel();

  const ownerLabels = options.ownerLabels ?? {};
  const rawItems = Array.isArray(projection.items) ? projection.items : [];
  const items = rawItems.filter((row): row is FoldedItem => !!row && typeof row.record_id === 'string')
    .map((row) => buildItem(row, ownerLabels));
  const groups = buildGroups(items);

  const observedStateKeys = Array.from(
    new Set(rawItems.filter((row) => !!row && typeof row.record_id === 'string').map((row) => resolveStateKey(row))),
  );
  const visibleActionCount = items.reduce((sum, item) => sum + item.actions.length, 0);
  const blockerCount = items.reduce((sum, item) => sum + item.blockers.length, 0);
  const targetCount = items.reduce((sum, item) => sum + item.targets.length, 0);
  const scheduledCount = items.reduce((sum, item) => sum + (item.when.startIso ? 1 : 0), 0);

  return {
    status: 'ready',
    projectionId: cleanKey(projection.projection_id) ?? 'default',
    copy: schedulerCopy,
    items,
    groups,
    message: items.length === 0 ? schedulerCopy.empty.title : '',
    proof: {
      status: 'ready',
      group_count: groups.length,
      item_count: items.length,
      visible_action_count: visibleActionCount,
      blocker_count: blockerCount,
      target_count: targetCount,
      scheduled_count: scheduledCount,
      observed_state_keys: observedStateKeys,
      translation_boundary: 'statusView+translate',
    },
  };
}
