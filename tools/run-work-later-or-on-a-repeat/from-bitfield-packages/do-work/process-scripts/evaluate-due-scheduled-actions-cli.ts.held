// timed-action compute.process CLI — the mountable wrapper around the pure
// due-and-unfired evaluator. The workflow-def `evaluate-due-scheduled-actions` mounts
// this .built.mjs and calls it with the queried scheduled-action work-items + receipts
// (from two find-current-items asks) as one JSON payload; it writes the due set to an
// output file the loop step iterates. Real node -> Date + full JS, which the workflow
// binding transform set cannot do (no filter_where / no dt_* — verified workflow-core
// context.rs:959). Pure logic lives in ../evaluate-due-scheduled-actions.ts (one SSOT).
//
// USAGE (compute.process — JSON in argv, result to an OUTPUT FILE):
//   evaluate-due-scheduled-actions-cli --input-json '{"work_items":[...],"receipts":[...],"now":"..."}' --output-json due.json
// or a file:
//   evaluate-due-scheduled-actions-cli --input-file scan.json --output-json due.json
// `--result-path due` writes only that sub-value. `now` is optional (defaults to the
// real clock); pass the clock-tick timestamp for determinism.

import { readFileSync, writeFileSync } from 'node:fs';
import { pathToFileURL } from 'node:url';
import { evaluateDueScheduledActions } from '../evaluate-due-scheduled-actions';

function parseArgs(argv: readonly string[]): Record<string, string> {
  const flags: Record<string, string> = {};
  for (let i = 0; i < argv.length; i += 1) {
    const a = argv[i];
    if (a.startsWith('--')) flags[a.slice(2)] = argv[i + 1] ?? '';
  }
  return flags;
}

function projectPath(value: unknown, path: string): unknown {
  if (!path) return value;
  let cur: unknown = value;
  for (const seg of path.split('.')) {
    if (cur == null) return null;
    cur = Array.isArray(cur) ? cur[Number(seg)] : (cur as Record<string, unknown>)[seg];
  }
  return cur;
}

// A find-current-items reply item is `{address, payload}` when queried with
// include:["payload"] (find_query.rs:1495-1502), or `{address, payload_json_text}` with
// include:["payload_json_text"]. Extract the record payload either way. This lets the
// workflow-def pass each find step's raw `output.items` straight through — no per-element
// json_parse binding (the workflow transform set has no such op).
function payloadsFromFindItems(items: unknown): unknown[] {
  if (!Array.isArray(items)) return [];
  return items
    .map((it) => {
      if (it == null || typeof it !== 'object') return null;
      const rec = it as { payload?: unknown; payload_json_text?: unknown };
      if (rec.payload !== undefined) return rec.payload;
      if (typeof rec.payload_json_text === 'string') {
        try {
          return JSON.parse(rec.payload_json_text);
        } catch {
          return null;
        }
      }
      return null;
    })
    .filter((p) => p != null);
}

// Accept EITHER the already-assembled graph ({records, time_windows, actions, receipts})
// or the four raw find-current-items outputs ({records_items, time_windows_items,
// actions_items, receipts_items} — each an array of {address, payload} items, or a
// {items:[...]} envelope). Normalize to the graph the pure evaluator consumes.
function normalizeInput(input: Record<string, unknown>): Record<string, unknown> {
  const rawItems = (key: string) => {
    const v = input[key];
    if (Array.isArray(v)) return v;
    if (v && typeof v === 'object' && Array.isArray((v as { items?: unknown }).items)) return (v as { items: unknown[] }).items;
    return null;
  };
  const rolePairs: [string, string][] = [
    ['records', 'records_items'],
    ['time_windows', 'time_windows_items'],
    ['actions', 'actions_items'],
    ['receipts', 'receipts_items'],
  ];
  const out: Record<string, unknown> = { now: input.now };
  for (const [clean, rawKey] of rolePairs) {
    if (Array.isArray(input[clean])) out[clean] = input[clean];
    else {
      const items = rawItems(rawKey);
      out[clean] = items ? payloadsFromFindItems(items) : [];
    }
  }
  return out;
}

// The four per-role flags the workflow-def passes — each a stringified find-current-items
// `output.items` array (mirrors measure-compute-cli's --facts-json/--defs-json pattern).
const ROLE_FLAGS: [string, string][] = [
  ['records-items-json', 'records_items'],
  ['time-windows-items-json', 'time_windows_items'],
  ['actions-items-json', 'actions_items'],
  ['receipts-items-json', 'receipts_items'],
];

export function main(argv: readonly string[]): void {
  const flags = parseArgs(argv);
  let parsed: Record<string, unknown>;
  if (ROLE_FLAGS.some(([f]) => flags[f] != null)) {
    // Per-role find-output flags (the workflow-def path).
    parsed = {};
    for (const [flag, key] of ROLE_FLAGS) parsed[key] = flags[flag] ? JSON.parse(flags[flag]) : [];
  } else {
    const raw = flags['input-json'] != null ? flags['input-json'] : flags['input-file'] ? readFileSync(flags['input-file'], 'utf8') : '';
    if (!raw) {
      process.stderr.write('usage: evaluate-due-scheduled-actions-cli (--records-items-json ... --time-windows-items-json ... --actions-items-json ... --receipts-items-json ... | --input-json <json> | --input-file <path>) [--now <iso>] [--output-json <path>] [--result-path <dotted>]\n');
      process.exit(2);
      return;
    }
    parsed = JSON.parse(raw) as Record<string, unknown>;
  }
  if (flags['now']) parsed.now = flags['now'];
  const input = normalizeInput(parsed);
  const result = evaluateDueScheduledActions(input);
  const projected = projectPath(result, flags['result-path'] ?? '');
  const out = JSON.stringify(projected);
  if (flags['output-json']) writeFileSync(flags['output-json'], out, 'utf8');
  else process.stdout.write(out + '\n');
}

const invoked = process.argv[1] ? pathToFileURL(process.argv[1]).href : '';
if (invoked && import.meta.url === invoked) {
  try {
    main(process.argv.slice(2));
  } catch (err) {
    process.stderr.write(`evaluate-due-scheduled-actions-cli: ${(err as Error).message}\n`);
    process.exit(1);
  }
}
