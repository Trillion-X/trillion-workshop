// Build the timed-action compute.process scripts into bundled .built.mjs artifacts
// that things-to-store-and-run.json ships as `stored_bytes` (mounted by the workflow
// compute steps via blob_ref). `evaluate-due-scheduled-actions-cli` bundles the pure
// due-and-unfired evaluator (../evaluate-due-scheduled-actions.ts — single SSOT) into one
// node-ready ESM with node builtins external. THIS MUST BE RE-RUN AFTER ANY change to
// evaluate-due-scheduled-actions.ts or the CLI — the live compute.process mounts the
// .built.mjs, NOT the .ts source (L085).
// Run: node packages/timed-action/do-work/process-scripts/build-process-scripts.mjs
import { build } from 'esbuild';
import { fileURLToPath } from 'node:url';

const here = fileURLToPath(new URL('.', import.meta.url));
const repoRoot = fileURLToPath(new URL('../../../../', import.meta.url));

// [entryDir, name, ext] — bundle each entry -> sibling .built.mjs.
const SCRIPTS = [
  [here, 'evaluate-due-scheduled-actions-cli', 'ts'],
  [here, 'materialize-recurring-windows-cli', 'ts'],
  [here, 'materialize-scheduled-action-view-cli', 'ts'],
];

for (const [dir, name, ext] of SCRIPTS) {
  const res = await build({
    entryPoints: [dir + name + '.' + ext],
    bundle: true,
    format: 'esm',
    platform: 'node',
    target: ['node18'],
    outfile: dir + name + '.built.mjs',
    alias: { '@': repoRoot.replace(/\/$/, '') },
    resolveExtensions: ['.ts', '.tsx', '.mjs', '.js', '.json'],
    metafile: true,
  });
  const out = Object.keys(res.metafile.outputs)[0];
  console.log('built', out, res.metafile.outputs[out].bytes, 'bytes');
}
