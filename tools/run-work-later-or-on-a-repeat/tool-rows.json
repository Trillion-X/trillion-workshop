        "id": "tool:when-to-run-next",
        "listed_on": "2026-09-28T17:54:38Z",
        "label": "Work out what is due and when to run next (schedules)",
        "job": "Scheduler: from recurring schedules (every day or week at a local time in a time zone, daylight saving handled) and one-off timed actions, work out what is due to run now and the next time to run",
        "description": "Give now plus schedules (schedule_id, timezone as an IANA name, start_local_date, cadence {unit: day | week, interval?, weekdays?: 0=Sunday..6}, local_window {start: HH:MM, duration_minutes}, dst {gap: skip | next-valid, fold: earlier | later | both}, action with its owner_dispatch) and their occurrence_states, and/or one-off time_windows, actions and receipts. Returns recurring_due, scheduled_due, the occurrences to record before running them, and next_wake_at: the next time anything is due, counting what is due now as done.",
        "input_schema": {
          "type": "object",
          "required": [
            "now"
          ],
          "additionalProperties": false,
          "properties": {
            "now": {
              "type": [
                "string",
                "number"
              ],
              "description": "The time to work from: ISO text or epoch milliseconds"
            },
            "schedules": {
              "type": "array",
              "items": {
                "type": "object"
              },
              "description": "Recurring schedules"
            },
            "occurrence_states": {
              "type": "array",
              "items": {
                "type": "object"
              },
              "description": "What was recorded for earlier occurrences (only a proven owner_outcome moves a schedule on)"
            },
            "time_windows": {
              "type": "array",
              "items": {
                "type": "object"
              },
              "description": "One-off times: {record_id, start}"
            },
            "actions": {
              "type": "array",
              "items": {
                "type": "object"
              },
              "description": "One-off actions: {record_id, action_id, dispatch: {name, input}}"
            },
            "receipts": {
              "type": "array",
              "items": {
                "type": "object"
              },
              "description": "One-off actions already done: {record_id, operation}"
            },
            "max_calendar_scan_days": {
              "type": "integer"
            },
            "resume_from_ms": {
              "type": "number",
              "description": "Occurrences starting before this instant (epoch ms) count as passed: keep only the states from the last occurrence you proved and move this to its start, and the state stays bounded; a schedule first seen now starts from now"
            }
          }
        },
        "output_schema": {
          "type": "object",
          "required": [
            "now",
            "recurring_due",
            "scheduled_due",
            "next_wake_at"
          ],
          "properties": {
            "now": {
              "type": "string"
            },
            "recurring_due": {
              "type": "array"
            },
            "materializations": {
              "type": "array"
            },
            "scheduled_due": {
              "type": "array"
            },
            "next_wake_at": {
              "type": [
                "string",
                "null"
              ]
            },
            "rejected_schedules": {
              "type": "array"
            },
            "skipped_resolutions": {
              "type": "array"
            }
          }
        },
        "invoke": {
          "kind": "container",
          "internet": false,
          "workdir": "/opt/run-work-later-or-on-a-repeat",
          "stdout": "json",
          "argv": [
