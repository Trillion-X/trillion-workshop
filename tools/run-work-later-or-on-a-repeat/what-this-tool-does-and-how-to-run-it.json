        "listed_on": "2026-10-14T00:00:00Z",
        "label": "Plan future recurrence windows",
        "job": "Enumerate a bounded set of future recurrence slots from generic schedule data, including local-time daylight-saving policies and explicit coverage.",
        "description": "Give an explicit replay-stable now, recurring schedules, and max_occurrences_per_schedule. Returns future_occurrences in start order, rejected_schedules, skipped_resolutions, and per-schedule coverage showing count and calendar-scan limits. Recurrence is open-ended; a bounded plan never claims the schedule itself is exhausted. This is a pure plan: it writes no occurrence state, creates no materialization intents, and runs no action.",
        "input_schema": {
          "type": "object",
          "required": [
            "now",
            "schedules",
            "max_occurrences_per_schedule"
          ],
