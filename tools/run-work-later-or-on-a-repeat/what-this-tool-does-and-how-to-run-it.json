              },
              "description": "Generic timed-action recurrence schedule DATA, including timezone, cadence, local window, DST policies, and owner dispatch."
            },
            "max_occurrences_per_schedule": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000,
              "description": "Maximum future occurrence rows returned for each valid schedule."
            },
            "max_calendar_scan_days": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4096,
              "description": "Bound the local calendar dates scanned per schedule."
            }
          }
        },
