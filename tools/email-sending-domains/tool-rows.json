              }
            }
          }
        },
        "invoke": {
          "kind": "http",
          "url": "https://api.resend.com/api-keys",
          "method": "GET",
          "timeout_seconds": 30,
          "credential_injections": [
            { "hosts": ["api.resend.com"], "secret_name_from_input": "key_name", "placement": { "kind": "header", "name": "Authorization", "prefix": "Bearer " } }
          ]
        },
        "result_selector": "$",
        "needs": { "expected_seconds": 5, "network_egress": true },
        "maker": "maker:email-sending-domains",
        "licence_class": "licence:maker-own",
        "placements": ["placement:your-computer"],
        "provenance": { "provider": "Resend", "api": "https://resend.com/docs/api-reference/api-keys/list-api-keys" }
      }
    },
    {
      "payload": {
        "kind": "ai-tool-descriptor",
        "id": "tool:remove-a-sending-key",
        "label": "Remove a sending key",
        "job": "Turn off one key of my email-sending account, by its id, so it can never send again",
        "description": "Removes one key of the person's email-sending account (Resend) by its id (the id tool:make-a-sending-key or tool:list-sending-keys answered), with the key they connected. Anything still holding the removed key can no longer send. The vault's copy is removed with the vault's own remove.",
        "status": "active",
        "input_schema": {
          "type": "object",
          "additionalProperties": false,
          "required": ["key_name", "api_key_id"],
          "properties": { "key_name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,62}$" }, "api_key_id": { "type": "string", "pattern": "^[A-Za-z0-9-]{1,64}$" } }
        },
        "output_schema": { "type": "object" },
        "invoke": {
          "kind": "http",
          "url": "https://api.resend.com/api-keys/{api_key_id}",
          "method": "DELETE",
          "timeout_seconds": 30,
          "credential_injections": [
            { "hosts": ["api.resend.com"], "secret_name_from_input": "key_name", "placement": { "kind": "header", "name": "Authorization", "prefix": "Bearer " } }
          ]
        },
        "result_selector": "$",
        "needs": { "expected_seconds": 5, "network_egress": true },
        "maker": "maker:email-sending-domains",
        "licence_class": "licence:maker-own",
        "placements": ["placement:your-computer"],
        "provenance": { "provider": "Resend", "api": "https://resend.com/docs/api-reference/api-keys/delete-api-key" }
      }
    },
    {
