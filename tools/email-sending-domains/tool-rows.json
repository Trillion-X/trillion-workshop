{
  "kind": "package-set-records",
  "record_set": "email-sending-domains-tool-rows",
  "what_this_is": "The Workshop rows for the email-sending-domains folder: which domains the person's email-sending account (Resend) may send from, adding one, reading one and asking the account to check its DNS records again, and a sending-only key kept in the vault, listing those keys and removing one. The person's held key reaches the list's one process on a private pipe (credential_mounts fd 3) and the http rows' Authorization header only; none sends email or changes DNS.",
  "records": [
    {
      "payload": {
        "kind": "ai-tool-descriptor",
        "id": "tool:list-email-sending-domains",
        "label": "List email sending domains",
        "job": "See which domains my email-sending account can send from and whether each is verified",
        "description": "Reads the domains of the person's connected email-sending account (Resend) with the key they connected, and answers each domain's name and status and how many there are. It never shows the key and sends no email.",
        "status": "active",
        "input_schema": { "type": "object", "additionalProperties": false, "properties": {} },
        "output_schema": {
          "type": "object",
          "required": ["domains", "count"],
          "properties": {
            "domains": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["name", "status"],
                "properties": { "name": { "type": "string" }, "status": { "type": "string" } }
              }
            },
            "count": { "type": "integer" }
          }
        },
        "invoke": {
          "kind": "container",
          "internet": true,
          "workdir": "/opt/email-sending-domains",
          "stdout": "json",
          "argv": ["node", "/opt/email-sending-domains/do-work/list-email-sending-domains.mjs"],
          "files": {
            "package_files": { "package": "email-sending-domains", "paths": ["do-work"], "at": "/opt/email-sending-domains" }
          },
          "credential_mounts": [{ "secret_name": "resend-api-key", "fd": 3 }]
        },
        "result_selector": "$",
        "needs": { "expected_seconds": 5, "network_egress": true },
        "maker": "maker:email-sending-domains",
        "licence_class": "licence:maker-own",
        "placements": ["placement:your-computer"],
        "verify": [
          {
            "kind": "sample-run",
            "input": {},
            "replies": [
              {
                "request": {
                  "method": "GET",
                  "url": "https://api.resend.com/domains"
                },
                "status": 200,
                "body": {
                  "object": "list",
                  "has_more": false,
                  "data": [
                    {
                      "id": "00000000-0000-4000-8000-000000000001",
                      "name": "example.com",
                      "status": "verified",
                      "created_at": "2026-10-01 12:00:00.000000+00",
                      "region": "us-east-1"
                    },
                    {
                      "id": "00000000-0000-4000-8000-000000000002",
                      "name": "mail.example.test",
                      "status": "pending",
                      "created_at": "2026-11-01 12:00:00.000000+00",
                      "region": "us-east-1"
                    }
                  ]
                }
              }
            ],
            "shape_read_at": "2026-11-03"
          }
        ]
      }
    },
    {
      "payload": {
        "kind": "ai-tool-descriptor",
        "id": "tool:make-a-sending-key-with-resend",
        "label": "Make a sending key with Resend",
        "job": "Make a new key that can only send email from my email-sending account, kept under its own name",
        "description": "Asks the person's email-sending account (Resend), with the key they connected, for a new key that may only send email (from one domain when domain_id names one), and keeps the new key in the person's vault under keep_as. The new key is never shown: the answer holds its id and the held word in its place. A keep_as already held is never replaced, and then nothing is asked. Give the new key's name as Resend should show it.",
        "status": "active",
        "input_schema": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "keep_as"],
          "properties": {
            "name": { "type": "string", "minLength": 1, "maxLength": 50 },
            "keep_as": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,62}$" },
            "domain_id": { "type": "string" }
          }
        },
        "output_schema": {
          "type": "object",
          "required": ["id", "token"],
          "properties": { "id": { "type": "string" }, "token": { "type": "string" } }
        },
        "invoke": {
          "kind": "http",
          "url": "https://api.resend.com/api-keys",
          "method": "POST",
          "timeout_seconds": 30,
          "body_template": {
            "name": { "from": "name" },
            "permission": { "const": "sending_access" },
            "domain_id": { "from": "domain_id", "optional": true }
          },
          "credential_injections": [
            { "secret_name": "resend-api-key", "placement": { "kind": "header", "name": "Authorization", "prefix": "Bearer " } }
          ],
          "reply_holds_values": [{ "from": "token", "secret_name_from_input": "keep_as" }]
        },
        "result_selector": "$",
        "needs": { "expected_seconds": 5, "network_egress": true },
        "maker": "maker:email-sending-domains",
        "licence_class": "licence:maker-own",
        "placements": ["placement:your-computer"],
        "provenance": { "provider": "Resend", "api": "https://resend.com/docs/api-reference/api-keys/create-api-key" }
      }
    },
    {
      "payload": {
        "kind": "ai-tool-descriptor",
        "id": "tool:list-sending-keys-with-resend",
        "label": "List sending keys with Resend",
        "job": "See the keys my email-sending account has: each one's id, name and when it was made",
        "description": "Lists the keys of the person's email-sending account (Resend), with the key they connected: each key's id, name and when it was made, never a key itself (the provider shows a key only once, when it is made). It only reads.",
        "status": "active",
        "input_schema": { "type": "object", "additionalProperties": false, "properties": {} },
        "output_schema": {
          "type": "object",
          "required": ["data"],
          "properties": {
            "data": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": { "id": { "type": "string" }, "name": { "type": "string" }, "created_at": { "type": "string" } }
              }
            }
          }
        },
        "invoke": {
          "kind": "http",
          "url": "https://api.resend.com/api-keys",
          "method": "GET",
          "timeout_seconds": 30,
          "credential_injections": [
            { "secret_name": "resend-api-key", "placement": { "kind": "header", "name": "Authorization", "prefix": "Bearer " } }
          ]
        },
        "result_selector": "$",
        "needs": { "expected_seconds": 5, "network_egress": true },
        "maker": "maker:email-sending-domains",
        "licence_class": "licence:maker-own",
        "placements": ["placement:your-computer"],
        "provenance": { "provider": "Resend", "api": "https://resend.com/docs/api-reference/api-keys/list-api-keys" }
      }
    },
    {
      "payload": {
        "kind": "ai-tool-descriptor",
        "id": "tool:remove-a-sending-key-with-resend",
        "label": "Remove a sending key with Resend",
        "job": "Turn off one key of my email-sending account, by its id, so it can never send again",
        "description": "Removes one key of the person's email-sending account (Resend) by its id (the id tool:make-a-sending-key-with-resend or tool:list-sending-keys-with-resend answered), with the key they connected. Anything still holding the removed key can no longer send. The vault's copy is removed with the vault's own remove.",
        "status": "active",
        "input_schema": {
          "type": "object",
          "additionalProperties": false,
          "required": ["api_key_id"],
          "properties": { "api_key_id": { "type": "string", "pattern": "^[A-Za-z0-9-]{1,64}$" } }
        },
        "output_schema": { "type": "object" },
        "invoke": {
          "kind": "http",
          "url": "https://api.resend.com/api-keys/{api_key_id}",
          "method": "DELETE",
          "timeout_seconds": 30,
          "credential_injections": [
            { "secret_name": "resend-api-key", "placement": { "kind": "header", "name": "Authorization", "prefix": "Bearer " } }
          ]
        },
        "result_selector": "$",
        "needs": { "expected_seconds": 5, "network_egress": true },
        "maker": "maker:email-sending-domains",
        "licence_class": "licence:maker-own",
        "placements": ["placement:your-computer"],
        "provenance": { "provider": "Resend", "api": "https://resend.com/docs/api-reference/api-keys/delete-api-key" }
      }
    },
    {
      "payload": {
        "kind": "ai-tool-descriptor",
        "id": "tool:add-an-email-sending-domain",
        "label": "Add an email sending domain",
        "job": "Add a domain my email-sending account should send from, and see the DNS records it needs",
        "description": "Asks the person's email-sending account (Resend), with the key they connected, to add a domain to send from, and answers the domain's id, status and the DNS records its owner must add (each record's kind, name, type, value and priority). Nothing is added to DNS here; tool:check-an-email-sending-domain asks the account to look again once the records are in.",
        "status": "active",
        "input_schema": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name"],
          "properties": {
            "name": { "type": "string", "minLength": 3, "maxLength": 253 },
            "region": { "type": "string", "enum": ["us-east-1", "eu-west-1", "sa-east-1", "ap-northeast-1"] }
          }
        },
        "output_schema": {
          "type": "object",
          "required": ["id", "name", "status"],
          "properties": {
            "id": { "type": "string" }, "name": { "type": "string" }, "status": { "type": "string" },
            "records": { "type": "array", "items": {
                "type": "object",
                "properties": {
                  "record": { "type": "string" }, "name": { "type": "string" }, "type": { "type": "string" },
                  "value": { "type": "string" }, "ttl": { "type": "string" }, "priority": { "type": "integer" },
                  "status": { "type": "string" }
                }
              } }
          }
        },
        "invoke": {
          "kind": "http",
          "url": "https://api.resend.com/domains",
          "method": "POST",
          "timeout_seconds": 30,
          "body_template": {
            "name": { "from": "name" },
            "region": { "from": "region", "optional": true }
          },
          "credential_injections": [
            { "secret_name": "resend-api-key", "placement": { "kind": "header", "name": "Authorization", "prefix": "Bearer " } }
          ]
        },
        "result_selector": "$",
        "needs": { "expected_seconds": 5, "network_egress": true },
        "maker": "maker:email-sending-domains",
        "licence_class": "licence:maker-own",
        "placements": ["placement:your-computer"],
        "provenance": { "provider": "Resend", "api": "https://resend.com/docs/api-reference/domains/create-domain" }
      }
    },
    {
      "payload": {
        "kind": "ai-tool-descriptor",
        "id": "tool:read-an-email-sending-domain",
        "label": "Read an email sending domain",
        "job": "See whether a domain of my email-sending account is verified, and the state of each DNS record it needs",
        "description": "Reads one domain of the person's email-sending account (Resend), by its id, with the key they connected: its name, status and each DNS record it needs with that record's own status. It only reads.",
        "status": "active",
        "input_schema": {
          "type": "object",
          "additionalProperties": false,
          "required": ["domain_id"],
          "properties": { "domain_id": { "type": "string", "pattern": "^[A-Za-z0-9-]{1,64}$" } }
        },
        "output_schema": {
          "type": "object",
          "required": ["id", "name", "status"],
          "properties": {
            "id": { "type": "string" }, "name": { "type": "string" }, "status": { "type": "string" },
            "records": { "type": "array", "items": {
                "type": "object",
                "properties": {
                  "record": { "type": "string" }, "name": { "type": "string" }, "type": { "type": "string" },
                  "value": { "type": "string" }, "ttl": { "type": "string" }, "priority": { "type": "integer" },
                  "status": { "type": "string" }
                }
              } }
          }
        },
        "invoke": {
          "kind": "http",
          "url": "https://api.resend.com/domains/{domain_id}",
          "method": "GET",
          "timeout_seconds": 30,
          "credential_injections": [
            { "secret_name": "resend-api-key", "placement": { "kind": "header", "name": "Authorization", "prefix": "Bearer " } }
          ]
        },
        "result_selector": "$",
        "needs": { "expected_seconds": 5, "network_egress": true },
        "maker": "maker:email-sending-domains",
        "licence_class": "licence:maker-own",
        "placements": ["placement:your-computer"],
        "provenance": { "provider": "Resend", "api": "https://resend.com/docs/api-reference/domains/get-domain" }
      }
    },
    {
      "payload": {
        "kind": "ai-tool-descriptor",
        "id": "tool:check-an-email-sending-domain",
        "label": "Check an email sending domain",
        "job": "Ask my email-sending account to check a domain's DNS records again so it can be verified",
        "description": "Asks the person's email-sending account (Resend), with the key they connected, to check one domain's DNS records again, by the domain's id. The check runs on the account's side; tool:read-an-email-sending-domain shows the result.",
        "status": "active",
        "input_schema": {
          "type": "object",
          "additionalProperties": false,
          "required": ["domain_id"],
          "properties": { "domain_id": { "type": "string", "pattern": "^[A-Za-z0-9-]{1,64}$" } }
        },
        "output_schema": { "type": "object", "properties": { "id": { "type": "string" } } },
        "invoke": {
          "kind": "http",
          "url": "https://api.resend.com/domains/{domain_id}/verify",
          "method": "POST",
          "timeout_seconds": 30,
          "credential_injections": [
            { "secret_name": "resend-api-key", "placement": { "kind": "header", "name": "Authorization", "prefix": "Bearer " } }
          ]
        },
        "result_selector": "$",
        "needs": { "expected_seconds": 5, "network_egress": true },
        "maker": "maker:email-sending-domains",
        "licence_class": "licence:maker-own",
        "placements": ["placement:your-computer"],
        "provenance": { "provider": "Resend", "api": "https://resend.com/docs/api-reference/domains/verify-domain" }
      }
    }
  ]
}
