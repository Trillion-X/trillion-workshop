// Where shares go and what the AI does with them: one list over the person's pursuits (each with its room) and saved
// instructions, read and changed through the REST route and the two MCP tools, with saved_instructions reading the same
// actions.
import test from 'node:test';
import assert from 'node:assert/strict';
import { handleAgentsRequest, handoffIdFor, instructionsInTreeOrder, makeAgents, startersFrom } from '../../../shared-code/src/agents.mjs';
import { agentStoreForTests } from './agent-store-for-tests.mjs';
import inboundWords from '../../../keep-and-wake-ai-sessions-on-this-computer/src/inbound-words.json' with { type: 'json' };
import { executionModeRecipes } from '../src/execution-modes.mjs';
import { connectedTo, filesPrivatelyOf, handleShareDestinationsRequest, isPersonShareHandOff, isShareDestinationsPath, makeShareDestinations, memoryShareHistory, personShareHandOff, shareDestinationTools } from '../src/share-destinations.mjs';
import { actionForAddress, startingAction } from '../src/share-starting-action.mjs';
import { handleMcpMessage, makeTools } from '../../../list-and-run-trillions-tools-for-any-ai/from-old-trillion/src/tools.mjs.held';
import starterRows from '../records/saved-instruction-starters.json' with { type: 'json' };

// The workflows this person's AI can find, as /workflows/describe answers them: shaped like the shipped rows.
const workflows = {
  'workflow:research-brief-and-study': { id: 'workflow:research-brief-and-study', label: 'Research brief and study', input_schema: { type: 'object', required: ['subject'], properties: { subject: { type: 'string', minLength: 3 } } } },
  'workflow:l078-research-to-plan': { id: 'workflow:l078-research-to-plan', label: 'Research to plan', input_schema: { type: 'object', required: ['capability'], properties: { capability: { type: 'string', minLength: 3 } } } },
  'workflow:skill-article-prompts-to-skills': { id: 'workflow:skill-article-prompts-to-skills', label: 'Article prompts to skills', input_schema: { type: 'object', properties: { request: { type: 'string' } } } },
  // The real Trillion X mode workflow, so what a share starts is checked against its real input shape.
  'workflow:trillion-x-mode': executionModeRecipes().find(recipe => recipe.id === 'workflow:trillion-x-mode'),
};

// One person: their saved instructions (the agents owner), their pursuits as GET /pursuits answers them (tree order,
// depth, each room's space_id and the other people in it), and the kept arrangement.
// The Workshop's tools: one takes what is shared (a tool place), one does not.
const tellTheMakers = { tool_id: 'tool:tell-the-makers', label: 'Tell the people who make it', job: 'Tell the people who make it about anything', input_schema: { type: 'object', properties: { things: { type: 'array' }, note: { type: 'string' }, picture: { type: 'string' }, browser: { type: 'string' } } } };
const countWords = { tool_id: 'tool:count-words', label: 'Count words', job: 'Count the words', input_schema: { type: 'object', properties: { text: { type: 'string' } } } };
const community = { id: 'pursuit:community', title: 'Trillion community', depth: 0, space_id: 'space-community', others: ['Ana', 'Bo', 'Cy'], people_count: 4 };
const pottery = { id: 'pursuit:pottery', title: 'Pottery group', depth: 0, space_id: 'space-pottery', others: ['Sam'], people_count: 2 };

function person(pursuits = [community, pottery], refuses = null, tools = [countWords], hooks = {}) {
  const agents = makeAgents({ store: agentStoreForTests(), starters: hooks.starters ?? startersFrom(starterRows) });
  let kept = null;
  const listed = [...pursuits];
  // What a delivery sent to this person's own routes, in order; a path matching `refuses` is refused as a route would.
  const sent = [];
  const send = async (path, body) => {
    if (refuses?.test(path)) throw new Error('That space is closed.');
    sent.push({ path, body });
    if (path === '/workflows/describe') {
      const workflow = workflows[body.workflow_id];
      if (!workflow) throw new Error(`There is no workflow ${body.workflow_id}.`);
      return { workflow };
    }
    if (path === '/workflows/start') return { run_id: `run:${body.request_key}`, workflow_id: body.workflow_id, state: 'working' };
    if (path === '/tools/run') return hooks.toolReply ? hooks.toolReply(body) : { task_id: `task:${body.request_key}`, state: 'completed', output: { said: 'Sent.' } };
    const reply = hooks.send?.(path, body);
    if (reply !== undefined) return reply;
    return path === '/saved-examples' ? { id: `example:${sent.length}` } : path === '/handoffs' ? { handoff: { handoff_id: `h_${sent.length}` } } : {};
  };
  const shares = makeShareDestinations({ store: { choices: () => structuredClone(kept), putChoices: value => { kept = structuredClone(value); } }, history: memoryShareHistory(), instructions: agents, pursuits: async () => listed, focus: async () => hooks.focus ?? null, filesPrivately: hooks.filesPrivately ?? true, tools: async () => tools, send, readLink: hooks.readLink ?? (async () => null), later: hooks.later ?? (() => {}), connect: hooks.connect ?? null, aiWorkOf: hooks.aiWorkOf ?? (() => null), standing: hooks.standing ?? (() => null) });
  const route = async (method, body) => {
    const response = await handleShareDestinationsRequest(shares, new Request('https://person/share-destinations', { method, ...(body === undefined ? {} : { headers: { 'content-type': 'application/json' }, body: JSON.stringify(body) }) }));
    return { status: response.status, body: await response.json() };
  };
  const deliver = async body => {
    const response = await handleShareDestinationsRequest(shares, new Request('https://person/share-destinations/deliver', { method: 'POST', body: JSON.stringify(body) }));
    return { status: response.status, body: await response.json() };
  };
  return { agents, shares, route, listed, sent, deliver };
}

test('share destination reads and edits await the same current Marketplace starter provider as saved instructions',async()=>{
  let rows=[{id:'published',label:'Published action',words:'Use the published action.'}];
  const p=person([],null,[],{starters:async()=>rows});
  assert.deepEqual((await p.route('GET')).body.actions.map(row=>row.id),['published']);
  const edited=await p.route('POST',{actions:[{id:'mine',label:'Private action',words:'Use my edited action.'}],folders:[]});
  assert.equal(edited.status,200);assert.deepEqual(edited.body.actions.map(row=>row.id),['mine']);
  rows=[{id:'updated',label:'Updated default',words:'Use the updated default.'}];
  assert.deepEqual((await p.route('GET')).body.actions.map(row=>row.id),['mine']);
  assert.deepEqual((await p.route('POST',{actions:[],folders:[]})).body.actions,[]);
  await p.agents.instructions({instructions:null});
  assert.deepEqual((await p.route('GET')).body.actions.map(row=>row.id),['updated']);
  rows=[];
  assert.deepEqual((await p.route('GET')).body.actions,[],'withdrawn starter sections remain empty in the sibling sharing consumer');
});

test('a new person reads their own Trillion first and on, each pursuit with its room folded in, shown and off, and the starter actions', async () => {
  const { route } = person();
  const { status, body } = await route('GET');
  assert.equal(status, 200);
  assert.deepEqual(body.destinations, [
    { id: 'private', label: 'My Trillion', description: 'Only you and your AIs', depth: 0, to: { private: true }, others_count: 0, on_by_default: true },
    // More people than names_shown read as the first names and how many more.
    { id: 'pursuit:community', label: 'Trillion community', description: 'Ana, Bo and 1 more', depth: 0, to: { pursuit_id: 'pursuit:community', space_id: 'space-community' }, others_count: 3, on_by_default: false },
    { id: 'pursuit:pottery', label: 'Pottery group', description: 'With Sam', depth: 0, to: { pursuit_id: 'pursuit:pottery', space_id: 'space-pottery' }, others_count: 1, on_by_default: false },
  ]);
  assert.deepEqual(body.actions.map(action => action.id), instructionsInTreeOrder(startersFrom(starterRows)).map(action => action.id));
  assert.ok(body.actions.some(action => action.id === 'why-was-this-posted' && action.label === 'Why was this posted?'));
  assert.deepEqual(body.default_action_by_site, [{ host_suffix: 'instagram.com', action_id: 'study-content-format' }, { host_suffix: 'gettrillion.ai', action_id: 'make-it-mine' }]);
  assert.equal(body.all_destinations.length, 3);
});

test('the places come in the pursuits owner order with its depth, each pursuit once; a private pursuit has no room and no people line', async () => {
  const { route } = person([
    { id: 'pursuit:life', title: 'A meaningful life', depth: 0 },
    { id: 'pursuit:build', title: 'Build it', depth: 1, space_id: 'space-build', others: [], people_count: 1 },
    { id: 'pursuit:customers', title: 'Paying customers', depth: 2 },
    { id: 'pursuit:books', title: 'Books', depth: 1 },
    { id: 'pursuit:bakery', title: 'Bakery company', depth: 0, space_id: 'space-bakery', others: ['Casey', 'Jordan'], people_count: 3 },
    { id: 'pursuit:old', title: 'Put away', depth: 0, status: 'archived' },
  ]);
  const { body } = await route('GET');
  assert.deepEqual(body.destinations.map(place => [place.id, place.depth, place.description, place.to]), [
    ['private', 0, 'Only you and your AIs', { private: true }],
    ['pursuit:life', 0, null, { pursuit_id: 'pursuit:life' }],
    ['pursuit:build', 1, null, { pursuit_id: 'pursuit:build', space_id: 'space-build' }],
    ['pursuit:customers', 2, null, { pursuit_id: 'pursuit:customers' }],
    ['pursuit:books', 1, null, { pursuit_id: 'pursuit:books' }],
    ['pursuit:bakery', 0, 'With Casey and Jordan', { pursuit_id: 'pursuit:bakery', space_id: 'space-bakery' }],
  ]);
});

test('the pursuit the workspace is focused on comes first with what is under it and starts picked; else the last share\'s pursuit comes first', async () => {
  const tree = [
    { id: 'pursuit:life', title: 'A meaningful life', depth: 0 },
    { id: 'pursuit:build', title: 'Build it', depth: 1, space_id: 'space-build' },
    { id: 'pursuit:customers', title: 'Paying customers', depth: 2 },
    { id: 'pursuit:books', title: 'Books', depth: 1 },
  ];
  const focused = person(tree, null, [countWords], { focus: 'space-build' });
  const { body } = await focused.route('GET');
  assert.deepEqual(body.destinations.map(place => [place.id, place.depth, place.on_by_default]), [
    ['private', 0, true], ['pursuit:build', 0, true], ['pursuit:customers', 1, false], ['pursuit:life', 0, false], ['pursuit:books', 1, false],
  ]);
  const unfocused = person(tree);
  await unfocused.deliver({ to: ['pursuit:books'], items: [{ kind: 'record', record: 'decision:1' }], request_key: 'last' });
  const after = (await unfocused.route('GET')).body.destinations;
  assert.deepEqual(after.map(place => [place.id, place.on_by_default]).slice(0, 2), [['private', true], ['pursuit:books', false]]);
});

test('hiding and switching on are kept by pursuit; the order stays the owner\'s; a choice saved by a room id belongs to its pursuit', async () => {
  const { route } = person();
  const { body } = await route('POST', { destinations: [{ id: 'pursuit:pottery', shown: true, on_by_default: true }, { id: 'private', shown: true, on_by_default: false }, { id: 'space-community', shown: false, on_by_default: false }] });
  assert.deepEqual(body.destinations.map(place => [place.id, place.on_by_default]), [['private', false], ['pursuit:pottery', true]]);
  assert.deepEqual(body.all_destinations.map(place => [place.id, place.shown]), [['private', true], ['pursuit:community', false], ['pursuit:pottery', true]]);
  assert.deepEqual((await route('GET')).body.destinations.map(place => place.id), ['private', 'pursuit:pottery']);
});

test('a place left out keeps what it has; a pursuit made later appears in its place, shown and off; one that ended is gone', async () => {
  const { route, listed } = person();
  await route('POST', { destinations: [{ id: 'pursuit:pottery', shown: true, on_by_default: true }] });
  listed.unshift({ id: 'pursuit:new', title: 'New project', depth: 0 });
  listed.splice(listed.findIndex(pursuit => pursuit.id === 'pursuit:community'), 1);
  const { body } = await route('GET');
  assert.deepEqual(body.destinations.map(place => [place.id, place.on_by_default]), [['private', true], ['pursuit:new', false], ['pursuit:pottery', true]]);
});

test('their own Trillion can never be hidden, and a refused save changes nothing', async () => {
  const { route } = person();
  const before = (await route('GET')).body;
  const refused = await route('POST', { destinations: [{ id: 'private', shown: false }], actions: [{ label: 'Only', words: 'Only this' }] });
  assert.equal(refused.status, 400);
  assert.match(refused.body.error, /always offered/);
  assert.deepEqual((await route('GET')).body, before);
  const unknownAction = await route('POST', { actions: [{ id: 'mine', label: 'Mine', words: 'Do mine' }], default_action_by_site: [{ host_suffix: 'x.com', action_id: 'study-content-format' }] });
  assert.equal(unknownAction.status, 400);
  assert.deepEqual((await route('GET')).body, before);
  assert.equal((await route('POST', {})).status, 400);
  assert.equal((await route('POST', { default_action_by_site: [{ host_suffix: 'not a site', action_id: 'no-clue' }] })).status, 400);
});

test('actions are the saved instructions: edited here, saved_instructions reads them, and the other way round', async () => {
  const { route, agents } = person();
  const { body } = await route('POST', {
    actions: [{ id: 'why-was-this-posted', label: 'Why was this posted?', words: 'Find out why this was posted.' }, { label: 'Summarise it', words: 'Summarise it in three lines.' }],
    default_action_by_site: [{ host_suffix: 'www.YouTube.com', action_id: 'why-was-this-posted' }],
  });
  assert.deepEqual(body.actions.map(action => action.label), ['Why was this posted?', 'Summarise it']);
  // The folders kept from the starters stay, since the save left folders out.
  assert.deepEqual(agents.instructions({}).instructions.filter(row => row.kind !== 'folder'), body.actions.map(({ folder, ...action }) => action));
  assert.deepEqual(body.default_action_by_site, [{ host_suffix: 'youtube.com', action_id: 'why-was-this-posted' }]);

  agents.instructions({ instructions: [{ label: 'Summarise it', words: 'Summarise it in three lines.' }] });
  const after = (await route('GET')).body;
  assert.deepEqual(after.actions.map(action => action.label), ['Summarise it']);
  // The site default whose action was removed is left out.
  assert.deepEqual(after.default_action_by_site, []);
});

test('actions are one list the person arranges: a folder holds actions, the order given is kept, and the tree is read actions first, then folders', async () => {
  const { route, agents } = person();
  const { body } = await route('POST', {
    folders: [{ id: 'work', label: 'Work' }, { id: 'product', label: 'Product', folder: 'work' }],
    actions: [
      { id: 'later', label: 'Read later', words: 'Keep it for later.' },
      { id: 'direction', label: 'Product direction', words: 'Say what this means for where the product is going.', folder: 'product' },
      { id: 'summary', label: 'Summarise it', words: 'Summarise it in three lines.', folder: 'work' },
    ],
  });
  // Within a folder its actions come first, then the folders inside it, so the first action is the first at the top.
  assert.deepEqual(body.actions.map(action => [action.id, action.folder]), [['later', null], ['summary', 'work'], ['direction', 'product']]);
  assert.deepEqual(body.folders, [{ id: 'work', label: 'Work', folder: null }, { id: 'product', label: 'Product', folder: 'work' }]);
  // saved_instructions reads the same rows, folders included.
  assert.deepEqual(agents.instructions({}).instructions.filter(row => row.kind === 'folder').map(row => row.id), ['work', 'product']);

  // A place that saves the actions without knowing folders (an older app) moves nothing; folder: null moves to the top.
  const resaved = (await route('POST', { actions: [...body.actions.map(({ id, label, words }) => ({ id, label, words })), { label: 'New one', words: 'Do the new thing.' }] })).body;
  assert.deepEqual(resaved.actions.map(action => [action.label, action.folder]), [['Read later', null], ['New one', null], ['Summarise it', 'work'], ['Product direction', 'product']]);
  assert.equal(resaved.folders.length, 2);
  const moved = (await route('POST', { actions: resaved.actions.map(action => (action.id === 'direction' ? { ...action, folder: null, label: 'Where the product goes' } : action)) })).body;
  assert.deepEqual(moved.actions.map(action => [action.label, action.folder]), [['Read later', null], ['New one', null], ['Where the product goes', null], ['Summarise it', 'work']]);

  // A folder that is not in the list, or one inside itself, is refused and nothing changes.
  const before = (await route('GET')).body;
  assert.equal((await route('POST', { actions: [{ label: 'Lost', words: 'x', folder: 'nowhere' }] })).status, 400);
  assert.equal((await route('POST', { folders: [{ id: 'a', label: 'A', folder: 'b' }, { id: 'b', label: 'B', folder: 'a' }] })).status, 400);
  assert.deepEqual((await route('GET')).body, before);

  // A folder that still holds an action cannot go until the action moves; an empty folder can.
  assert.equal((await route('POST', { folders: [{ id: 'product', label: 'Product' }] })).status, 400);
  const removed = (await route('POST', { folders: [{ id: 'work', label: 'Work' }] })).body;
  assert.deepEqual(removed.folders.map(folder => folder.id), ['work']);
  assert.deepEqual(removed.actions.map(action => action.label), ['Read later', 'New one', 'Where the product goes', 'Summarise it']);
});

test('a share address picks the longest matching site', () => {
  const defaults = [{ host_suffix: 'instagram.com', action_id: 'study' }, { host_suffix: 'help.instagram.com', action_id: 'why' }];
  assert.equal(actionForAddress(defaults, 'https://www.instagram.com/reel/abc'), 'study');
  assert.equal(actionForAddress(defaults, 'https://help.instagram.com/x'), 'why');
  assert.equal(actionForAddress(defaults, 'https://notinstagram.com/x'), null);
  assert.equal(actionForAddress(defaults, 'not an address'), null);
});

test('the MCP tools share_destinations and save_share_destinations reach the same route', async () => {
  const { shares } = person();
  assert.equal(isShareDestinationsPath('/share-destinations'), true);
  const call = async (path, body, method = body === undefined ? 'GET' : 'POST') => {
    assert.equal(isShareDestinationsPath(path), true);
    const response = await handleShareDestinationsRequest(shares, new Request(`https://person${path}`, { method, ...(body === undefined ? {} : { body: JSON.stringify(body) }) }));
    const result = await response.json();
    if (!response.ok) throw new Error(result.error);
    return result;
  };
  const tools = makeTools({ call, askPerson: async () => null });
  const listed = (await handleMcpMessage({ jsonrpc: '2.0', id: 1, method: 'tools/list' }, tools)).result.tools;
  const read = listed.find(tool => tool.name === 'share_destinations');
  assert.equal(read.annotations.readOnlyHint, true);
  assert.equal(listed.find(tool => tool.name === 'save_share_destinations').annotations.readOnlyHint, false);
  assert.deepEqual(shareDestinationTools(call).map(tool => tool.name), ['share_destinations', 'save_share_destinations', 'shares_sent', 'deliver_share']);
  assert.deepEqual(listed.find(tool => tool.name === 'deliver_share').inputSchema.required, ['items', 'request_key']);

  const first = await handleMcpMessage({ jsonrpc: '2.0', id: 2, method: 'tools/call', params: { name: 'share_destinations', arguments: {} } }, tools);
  assert.notEqual(first.result.isError, true);
  assert.equal(first.result.structuredContent.destinations[0].id, 'private');

  const saved = await handleMcpMessage({ jsonrpc: '2.0', id: 3, method: 'tools/call', params: { name: 'save_share_destinations', arguments: { destinations: [{ id: 'pursuit:community', shown: true, on_by_default: true }] } } }, tools);
  assert.deepEqual(saved.result.structuredContent.destinations.map(place => [place.id, place.on_by_default]), [['private', true], ['pursuit:community', true], ['pursuit:pottery', false]]);

  const refused = await handleMcpMessage({ jsonrpc: '2.0', id: 4, method: 'tools/call', params: { name: 'save_share_destinations', arguments: { destinations: [{ id: 'private', shown: false }] } } }, tools);
  assert.equal(refused.result.isError, true);
});

const shared = [
  { kind: 'page', url: 'https://www.instagram.com/p/abc/', title: 'A post' },
  { kind: 'selection', text: 'chosen words' },
  { kind: 'video', name: 'clip.mp4', file: '1f:abc' },
];

test('deliver_share hands a share to their own Trillion with the action its site starts on and their words', async () => {
  const { deliver, sent } = person();
  const { status, body } = await deliver({ to: ['private'], items: shared, own_words: ' my note ', request_key: 'k1', from_agent: 'send-to-trillion', to_agent: 'agent-1', input: { sent_from: 'browser', items: 'not these' } });
  assert.equal(status, 200);
  // The job handed on is named back, so the box it was sent from can show it being done.
  assert.deepEqual(body, { delivered: [{ id: 'private', label: 'My Trillion' }], stopped_at: null, handoff_ids: ['h_2'], workflow_runs: [] });
  // Studying a format keeps the shared link as a saved example first, with the words shared beside it.
  assert.deepEqual(sent.map(call => call.path), ['/saved-examples', '/handoffs']);
  assert.deepEqual(sent[0].body, { url: 'https://www.instagram.com/p/abc/', title: 'A post', words: 'chosen words', added_from: 'share' });
  const study = startersFrom(starterRows).find(action => action.id === 'study-content-format');
  assert.deepEqual(sent[1].body, {
    job: `${study.words}\n\nmy note`, request_key: 'k1', from_agent: 'send-to-trillion', to_agent: 'agent-1',
    input: { sent_from: 'browser', saved_instructions: ['study-content-format'], own_words: 'my note', items: shared, saved_examples: ['example:1'] },
    // A share is the person speaking: their own words' priority, and their words as what they see of the job.
    priority: inboundWords.priority.from_person, said: 'my note',
  });
});

test('deliver_share hands their AI chat instructions with the share, and nothing when that scope is off', async () => {
  const { withMeetingSettings } = await import('../parts/record-audio/read-data/meeting-settings.mjs');
  const on = person(undefined, null, undefined, { standing: () => withMeetingSettings({}, { instructionText: 'Answer in French.' }) });
  await on.deliver({ to: ['private'], items: shared, request_key: 'k-on' });
  assert.equal(on.sent.find(call => call.path === '/handoffs').body.input.standing_instructions, 'Answer in French.');
  const off = person(undefined, null, undefined, { standing: () => withMeetingSettings({}, { instructionText: 'Answer in French.', instructionScopes: ['drafts'] }) });
  await off.deliver({ to: ['private'], items: shared, request_key: 'k-off' });
  assert.equal('standing_instructions' in off.sent.find(call => call.path === '/handoffs').body.input, false);
});

test('a share the person\'s own share sheet hands off itself speaks with their voice, at the hand-off route', async () => {
  const store = agentStoreForTests();
  const agents = makeAgents({ store });
  // The job as the store keeps it (its priority is how every AI and the person's own AIs order what they take).
  const handOff = async body => {
    const { handoff } = await (await handleAgentsRequest(agents, new Request('https://person/handoffs', { method: 'POST', body: JSON.stringify(body) }),
      { shapeHandOff: input => (isPersonShareHandOff(input) ? personShareHandOff(input) : input) })).json();
    return store.openHandoffs().find(item => item.handoff_id === handoff.handoff_id);
  };
  const screenshot = { kind: 'image', name: 'Screenshot 2026-10-03 at 10.22.20.png', file: '1f:aa' };
  const words = await handOff({ job: 'two things the share sheet should remember', request_key: 'phone-1', from_agent: 'send-to-trillion-ios',
    input: { sent_from: 'ios-share-sheet', own_words: 'two things the share sheet should remember', items: [screenshot] } });
  assert.equal(words.priority, inboundWords.priority.from_person);
  assert.equal(words.said, 'two things the share sheet should remember');
  const picture = await handOff({ job: 'Keep this in my Trillion and work out whether it helps a pursuit.', request_key: 'phone-2', from_agent: 'send-to-trillion-ios',
    input: { sent_from: 'ios-share-sheet', own_words: null, items: [screenshot, { kind: 'link', url: 'https://www.instagram.com/reel/x/' }] } });
  assert.equal(picture.said, 'Shared Screenshot 2026-10-03 at 10.22.20.png, https://www.instagram.com/reel/x/');
  assert.equal(picture.priority, inboundWords.priority.from_person);
  const other = await handOff({ job: 'Summarize this mail', request_key: 'mail-1', input: { sent_from: 'somewhere else' } });
  assert.equal(other.priority, 0, 'work that did not come from the person\'s share sheet keeps its own priority');
  assert.equal(other.said, 'Summarize this mail', 'work handed off without words for the person keeps a short title from its job');
});

test('deliver_share files each shared record under each chosen pursuit and gives its room one mixed selection without copying files', async () => {
  const { deliver, sent } = person();
  const { body } = await deliver({ to: ['pursuit:community', 'pursuit:pottery'], items: shared, own_words: 'my note', action: 'why-was-this-posted', request_key: 'k2' });
  assert.deepEqual(body.delivered.map(place => place.id), ['pursuit:community', 'pursuit:pottery']);
  const added = [{ kind: 'link', title: 'A post', url: 'https://www.instagram.com/p/abc/' }, { kind: 'text', text: 'chosen words' }, { kind: 'file', file: '1f:abc' }, { kind: 'text', text: 'my note' }];
  assert.deepEqual(sent, [
    { path: '/scope/record', body: { record: 'file:1f:abc', add: { pursuits: ['pursuit:community'] } } },
    { path: '/spaces/space-community/share', body: { items: added, request_key: 'k2' } },
    { path: '/scope/record', body: { record: 'file:1f:abc', add: { pursuits: ['pursuit:pottery'] } } },
    { path: '/spaces/space-pottery/share', body: { items: added, request_key: 'k2' } },
  ]);
});

test('deliver_share sends hundreds of mixed references and one sender note through the same Space route', async () => {
  const { deliver, sent } = person();
  const items = Array.from({ length: 240 }, (_, index) => index % 3 === 0
    ? { kind: 'file', file: `1f:clip-${index}` }
    : index % 3 === 1 ? { kind: 'workflow', workflow_id: `workflow:review-${index}` }
      : { kind: 'text', text: `Note ${index}` });
  const answer = await deliver({ to: ['pursuit:community'], items, own_words: 'Review all of these', request_key: 'many-mixed' });
  assert.equal(answer.status, 200);
  // Every shared file is filed under the pursuit; the room gets the whole selection in one request.
  assert.equal(sent.filter(call => call.path === '/scope/record').length, 80);
  const rooms = sent.filter(call => call.path === '/spaces/space-community/share');
  assert.equal(rooms.length, 1);
  assert.equal(rooms[0].body.request_key, 'many-mixed');
  assert.equal(rooms[0].body.items.length, 241);
  assert.deepEqual(rooms[0].body.items.slice(0, 3), items.slice(0, 3));
  assert.deepEqual(rooms[0].body.items.at(-1), { kind: 'text', text: 'Review all of these' });
  assert.equal((await deliver({ to: ['pursuit:community'], items: Array(1001).fill({ kind: 'text', text: 'too many' }), request_key: 'too-many' })).status, 400);
  assert.equal(sent.length, 81, 'the over-limit request reaches no Space');
});

test('the generic sender stops a multibyte share at the wire-byte limit before any delivery', async () => {
  const { shares, sent } = person();
  const oversized = JSON.stringify({ to: ['pursuit:community'], items: [{ kind: 'text', text: '界'.repeat(700_000) }], request_key: 'unicode-large' });
  assert.ok(oversized.length < 2_000_000, 'character counting alone would admit this body');
  assert.ok(new TextEncoder().encode(oversized).byteLength > 2_000_000);
  const rejected = await handleShareDestinationsRequest(shares, new Request('https://person/share-destinations/deliver', { method: 'POST', body: oversized }));
  assert.equal(rejected.status, 400);
  assert.match((await rejected.json()).error, /Request too large/);
  assert.equal(sent.length, 0);

  const accepted = await handleShareDestinationsRequest(shares, new Request('https://person/share-destinations/deliver', {
    method: 'POST', body: JSON.stringify({ to: ['pursuit:community'], items: [{ kind: 'text', text: 'Look at the clip 😀' }], request_key: 'unicode-small' }),
  }));
  assert.equal(accepted.status, 200);
  assert.equal(sent[0].path, '/spaces/space-community/share');
  assert.deepEqual(sent[0].body.items, [{ kind: 'text', text: 'Look at the clip 😀' }]);
});

test('delayed link cards fill the exact picked Space items across interleaved private records', async () => {
  const pending = [];
  const selected = [
    { kind: 'link', url: 'https://example.com/first' },
    { kind: 'record', record: 'pursuit:launch' },
    { kind: 'link', url: 'https://example.com/second' },
    { kind: 'file', file: '1f:video' },
    { kind: 'link', url: 'https://example.com/third' },
  ];
  const ids = ['first-link', 'private-pursuit', 'second-link', 'private-file', 'third-link'];
  const { deliver, sent } = person(undefined, null, [countWords], {
    send: path => path === '/spaces/space-community/share'
      ? { placed: ids.map(item_id => ({ item_id })), shared: [{ ids: ['third-link'] }] }
      : undefined,
    readLink: async url => ({ url, host: 'example.com', title: url.split('/').at(-1), images: [], videos: [] }),
    later: work => pending.push(work),
  });
  const answer = await deliver({ to: ['pursuit:community'], items: selected, request_key: 'interleaved-cards' });
  assert.equal(answer.status, 200);
  await Promise.all(pending);
  assert.deepEqual(sent.find(call => call.path === '/spaces/space-community/share'), { path: '/spaces/space-community/share', body: { items: selected, request_key: 'interleaved-cards' } });
  assert.deepEqual(sent.filter(call => call.path.endsWith('/fill')).map(call => [call.body.item_id, call.body.body.url]), [
    ['first-link', 'https://example.com/first'],
    ['second-link', 'https://example.com/second'],
    ['third-link', 'https://example.com/third'],
  ]);
});

test('a large link selection is delivered whole while automatic page reads stay bounded', async () => {
  const pending = [];
  const fetched = [];
  const items = Array.from({ length: 20 }, (_, index) => ({ kind: 'link', url: `https://example.com/${index}` }));
  const { deliver, sent } = person(undefined, null, [countWords], {
    send: path => path === '/spaces/space-community/share'
      ? { placed: items.map((_, index) => ({ item_id: `link-${index}` })) }
      : undefined,
    readLink: async url => { fetched.push(url); return { url, host: 'example.com', title: url, images: [], videos: [] }; },
    later: work => pending.push(work),
  });
  const answer = await deliver({ to: ['pursuit:community'], items, request_key: 'bounded-cards' });
  assert.equal(answer.status, 200);
  assert.equal(sent[0].body.items.length, 20, 'links alone file nothing privately');
  await Promise.all(pending);
  assert.deepEqual(fetched, items.slice(0, 4).map(item => item.url));
  assert.equal(sent.filter(call => call.path.endsWith('/fill')).length, 4);
});

