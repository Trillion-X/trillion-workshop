test('deliver_share refuses an unknown place, an unknown action or a malformed share before sending anything', async () => {
  const { deliver, sent, route } = person();
  await route('POST', { destinations: [{ id: 'pursuit:pottery', shown: false }] });
  for (const [given, error] of [
    [{ to: ['private', 'space-gone'], items: shared, request_key: 'k' }, /space-gone.*not one of the places/],
    [{ to: ['pursuit:pottery'], items: shared, request_key: 'k' }, /pursuit:pottery.*not one of the places/],
    [{ to: ['private'], items: shared, action: 'removed', request_key: 'k' }, /No action removed/],
    [{ to: ['private', 'pursuit:community'], items: [{ kind: 'share' }], own_words: 'Send this', request_key: 'bad-link' }, /shared link needs its link code/],
    [{ to: ['pursuit:community'], items: [{ kind: 'workflow' }], request_key: 'bad-workflow' }, /shared workflow needs its id/],
    [{ to: ['pursuit:community'], items: [{ kind: 'tool' }], request_key: 'bad-tool' }, /shared tool needs its id/],
    [{ to: ['pursuit:community'], items: [{ kind: 'text', text: '' }], request_key: 'empty-words' }, /Shared words cannot be empty/],
    [{ to: ['pursuit:community'], items: [{ kind: 'mystery', title: 'Never silently omit me' }], request_key: 'unknown-kind' }, /pursuit share item must name/],
    [{ to: ['pursuit:community'], items: [{ kind: 'link', url: 'file:///private/clip' }], request_key: 'bad-url' }, /http or https/],
    [{ to: ['pursuit:community'], items: [{ kind: 'text', text: 'Last', title: 'x'.repeat(301) }], request_key: 'long-title' }, /title holds at most 300/],
    [{ to: 'private', items: shared, request_key: 'k' }, /to is a list/],
    [{ to: ['private'], items: [], request_key: 'k' }, /items is a list/],
    [{ to: ['private'], items: shared }, /request_key/],
  ]) {
    const { status, body } = await deliver(given);
    assert.equal(status, 400, JSON.stringify(given));
    assert.match(body.error, error);
  }
  assert.deepEqual(sent, []);
});

test('deliver_share stops at a place that refuses and names it, the places before it keep what they got', async () => {
  const { deliver, sent } = person(undefined, /space-pottery/);
