});

test('a withdrawn Space retry is reported as stopped and fetches no link card', async () => {
  const scheduled = [];
  const { deliver, sent, shares } = person(undefined, null, [countWords], {
    send: path => path.endsWith('/share') ? { placed: [{ item_id: 'item-old', withdrawn: true }] } : undefined,
    later: task => scheduled.push(task),
  });
  const { status, body } = await deliver({
    to: ['pursuit:community', 'pursuit:pottery'], items: [{ kind: 'link', url: 'https://example.com/once' }], request_key: 'withdrawn-old-key',
  });
  assert.equal(status, 200);
  assert.deepEqual(body.delivered, []);
  assert.equal(body.stopped_at.id, 'pursuit:community');
  assert.match(body.stopped_at.error, /taken back.*new share/i);
  assert.deepEqual(sent.map(call => call.path), ['/spaces/space-community/share']);
  assert.equal(scheduled.length, 0);
  assert.deepEqual(shares.shares({}).shares[0].sent_to, []);
});

test('the action a share starts on is the first address with a site default, else the first action', () => {
  const actions = [{ id: 'next-move', words: 'w1' }, { id: 'study', words: 'w2' }];
  const bySite = [{ host_suffix: 'instagram.com', action_id: 'study' }];
  assert.equal(startingAction(['https://example.com/', 'https://www.instagram.com/reel/x/'], actions, bySite).id, 'study');
  assert.equal(startingAction(['https://notinstagram.com/p/x/'], actions, bySite).id, 'next-move');
  assert.equal(startingAction([], [], bySite), null);
});

test('a share\'s sender is where it was shared from, else the sending app\'s registered name, never its agent id', async () => {
  const { shares } = person();
  const send = async (body, app) => {
    const response = await handleShareDestinationsRequest(shares, new Request('https://person/share-destinations/deliver', { method: 'POST', headers: app ? { 'x-trillion-app': app } : {}, body: JSON.stringify(body) }));
    assert.equal(response.status, 200);
  };
  const items = [{ kind: 'selection', text: 'chosen words', url: 'https://example.com/a' }, { kind: 'post', text: 'A post', pictures: ['https://example.com/p.jpg'] }, { kind: 'picture', file: '1f:abc', name: 'Picture of the page.jpg' }];
  await send({ to: ['private'], items, own_words: 'look', request_key: 'named-by-app', from_agent: 'send-to-trillion' }, 'Send to Trillion');
  await send({ to: ['private'], items, own_words: 'look', request_key: 'named-by-device', from_agent: 'send-to-trillion', from: 'Chrome' }, 'Send to Trillion');
  await send({ to: ['private'], items, own_words: 'look', request_key: 'unnamed', from_agent: 'send-to-trillion' });
  const byId = Object.fromEntries(shares.shares({}).shares.map(row => [row.share_id, row]));
  assert.equal(byId['named-by-app'].from, 'Send to Trillion');
  assert.equal(byId['named-by-device'].from, 'Chrome');
  assert.equal(byId.unnamed.from, null);
  // Every thing sent is kept in the row, in order, for Shared before to draw.
  assert.deepEqual(byId['named-by-app'].items, items);
});

test('a workflow action starts its workflow on the share, filled from the share and checked first, and hands the AI the run', async () => {
  const { deliver, sent, route } = person();
  const research = startersFrom(starterRows).find(action => action.id === 'research-this');
  assert.equal(research.workflow.workflow_id, 'workflow:research-brief-and-study');
  // The starter workflow actions sit in their own folder, offered with every other action.
  const listed = (await route('GET')).body;
  assert.deepEqual(listed.actions.filter(action => action.workflow).map(action => [action.id, action.folder]), [['research-this', 'workflows'], ['test-this', 'workflows'], ['plan-to-build-this', 'workflows'], ['turn-into-skills', 'workflows']]);
  assert.ok(listed.folders.some(folder => folder.id === 'workflows'));

  const { status, body } = await deliver({ to: ['private'], items: shared, action: 'research-this', own_words: 'who made this?', request_key: 'w1' });
  assert.equal(status, 200, JSON.stringify(body));
  assert.deepEqual(body, { delivered: [{ id: 'private', label: 'My Trillion' }], stopped_at: null, handoff_ids: ['h_3'], workflow_runs: ['run:w1'] });
  assert.deepEqual(sent.map(call => call.path), ['/workflows/describe', '/workflows/start', '/handoffs']);
  assert.deepEqual(sent[1].body, { workflow_id: 'workflow:research-brief-and-study', input: { subject: 'who made this?\n\nA post\n\nchosen words\n\nhttps://www.instagram.com/p/abc/' }, request_key: 'w1' });
  assert.match(sent[2].body.job, /^Research what I sent/);
  assert.match(sent[2].body.job, /started the workflow Research brief and study as run run:w1/);
  assert.deepEqual(sent[2].body.input.workflow_runs, [{ workflow_id: 'workflow:research-brief-and-study', run_id: 'run:w1' }]);
});

test('a workflow action that cannot start on a share refuses it before anything is sent, and a space alone starts none', async () => {
  const { deliver, sent, route } = person();
  const current = (await route('GET')).body;
  await route('POST', { actions: [...current.actions, { id: 'gone', label: 'Gone', words: 'Run the gone one.', workflow: { workflow_id: 'workflow:gone' } }, { id: 'empty', label: 'Empty', words: 'Plan it.', workflow: { workflow_id: 'workflow:l078-research-to-plan', input: { capability: { fill: { from: 'share', field: 'own_words' } } } } }] });
  for (const [action, error] of [['gone', /Gone starts workflow:gone, which cannot be started: There is no workflow workflow:gone/], ['empty', /Empty cannot start Research to plan with this share: .*capability/]]) {
    const { status, body } = await deliver({ to: ['private', 'pursuit:community'], items: shared, action, request_key: `r-${action}` });
    assert.equal(status, 400, action);
    assert.match(body.error, error);
  }
  assert.deepEqual(sent.map(call => call.path), ['/workflows/describe', '/workflows/describe']);
  sent.length = 0;
  const { body } = await deliver({ to: ['pursuit:community'], items: shared, action: 'gone', request_key: 'space-only' });
  assert.deepEqual(body.workflow_runs, []);
  assert.ok(!sent.some(call => call.path.startsWith('/workflows')));
});

test('an action keeps the workflow it starts when a place saves only its name and words; null takes it off', async () => {
  const { route, agents } = person();
  const current = (await route('GET')).body;
  const renamed = current.actions.map(({ id, label, words, folder }) => ({ id, label: id === 'research-this' ? 'Look into this' : label, words, folder }));
  const after = (await route('POST', { actions: renamed })).body;
  const research = after.actions.find(action => action.id === 'research-this');
  assert.equal(research.label, 'Look into this');
  assert.deepEqual(research.workflow, { workflow_id: 'workflow:research-brief-and-study', input: { subject: { fill: { from: 'share', field: 'words' } } } });
  // saved_instructions reads the same row, workflow and all.
  assert.deepEqual(agents.instructions({}).instructions.find(row => row.id === 'research-this').workflow, research.workflow);
  const off = (await route('POST', { actions: after.actions.map(action => (action.id === 'research-this' ? { ...action, workflow: null } : action)) })).body;
  assert.equal(off.actions.find(action => action.id === 'research-this').workflow, undefined);
  const refused = await route('POST', { actions: [{ label: 'Bad', words: 'Bad.', workflow: { input: {} } }] });
  assert.equal(refused.status, 400);
  assert.match(refused.body.error, /workflow is \{ workflow_id, input \}/);
});

test('deliver_share hands one share to each chosen AI once, asking each to do every chosen action', async () => {
  const { deliver, sent, shares } = person();
  const { status, body } = await deliver({ to: ['private'], items: shared, action: ['why-was-this-posted', 'which-pursuit'], to_agent: ['agent-a', 'agent-b', 'agent-a'], own_words: 'both of you', request_key: 'many' });
  assert.equal(status, 200, JSON.stringify(body));
  const handed = sent.filter(call => call.path === '/handoffs');
  assert.deepEqual(handed.map(call => [call.body.to_agent, call.body.request_key]), [['agent-a', 'many:agent-a'], ['agent-b', 'many:agent-b']]);
  const [why, which] = ['why-was-this-posted', 'which-pursuit'].map(id => startersFrom(starterRows).find(action => action.id === id));
  assert.equal(handed[0].body.job, `${why.label}: ${why.words}\n\n${which.label}: ${which.words}\n\nboth of you`);
  assert.deepEqual(handed[0].body.input.saved_instructions, ['why-was-this-posted', 'which-pursuit']);
  assert.deepEqual(body.handoff_ids, handed.map((_, index) => `h_${sent.indexOf(handed[index]) + 1}`));
  // The share list names every action it asked for.
  assert.deepEqual(shares.shares({}).shares[0].actions.map(action => action.id), ['why-was-this-posted', 'which-pursuit']);
  // One AI and one action are as before: the share's own key, and the action's words alone.
  sent.length = 0;
  await deliver({ to: ['private'], items: shared, action: 'which-pursuit', to_agent: 'agent-a', request_key: 'one' });
  assert.deepEqual([sent[0].body.request_key, sent[0].body.to_agent, sent[0].body.job], ['one', 'agent-a', which.words]);
  const refused = await deliver({ to: ['private'], items: shared, action: ['which-pursuit', 'gone'], request_key: 'bad' });
  assert.equal(refused.status, 400);
  assert.match(refused.body.error, /No action gone/);
  assert.match((await deliver({ to: ['private'], items: shared, to_agent: [3], request_key: 'bad-agent' })).body.error, /to_agent is one id or a list/);
});

test('a tool that takes what is shared is a place: listed with its job, and sent the share in the fields it takes', async () => {
  const needsAnotherInput = { ...tellTheMakers, tool_id: 'tool:needs-a-secret-extra', input_schema: { type: 'object', required: ['things', 'choice'], properties: { things: { type: 'array' }, choice: { type: 'string' } } } };
  const { route, deliver, sent } = person(undefined, null, [countWords, tellTheMakers, needsAnotherInput]);
  const listed = (await route('GET')).body.destinations;
  assert.deepEqual(listed.at(-1), { id: 'tool-place:tool:tell-the-makers', label: 'Tell the people who make it', description: 'Tell the people who make it about anything', depth: 0, to: { tool_id: 'tool:tell-the-makers' }, others_count: 0, on_by_default: false });
  assert.ok(!listed.some(place => place.to.tool_id === 'tool:count-words'));
  assert.ok(!listed.some(place => place.to.tool_id === needsAnotherInput.tool_id), 'a share cannot fill the extra required field');
  const items = [{ kind: 'image', name: 'Screen.png', file: '1f:screen' }, { kind: 'link', url: 'https://example.com/a', title: 'A page' }];
  const { body } = await deliver({ to: ['tool-place:tool:tell-the-makers', 'private'], items, own_words: 'the caret jumps', action: 'which-pursuit', request_key: 'report', from: 'iPhone', input: { screen: 'https://app.example/x', where: 'Home' } });
  assert.deepEqual(body.delivered.map(place => place.id), ['tool-place:tool:tell-the-makers', 'private']);
  assert.deepEqual(sent[0], { path: '/tools/run', body: { tool_id: 'tool:tell-the-makers', request_key: 'report', wait_seconds: 20, input: {
    things: [{ kind: 'image', label: 'Screen.png', id: '1f:screen' }, { kind: 'link', label: 'A page', address: 'https://example.com/a' }],
    note: 'the caret jumps', picture: '1f:screen', browser: 'iPhone',
  } } });
  // A tool place a plan without the Workshop cannot list is simply not offered.
  const bare = person(undefined, null, []);
  assert.ok(!(await bare.route('GET')).body.destinations.some(place => place.to.tool_id));
});

test('a completed tool delivery retains its exact source and work receipt without copying private output', async () => {
  const h = person([], null, [tellTheMakers], { toolReply: body => ({ task_id: `task:${body.request_key}`, state: 'completed', execution_ref: 'execution:one',
    output: { said: 'Received.', source_ref: 'record:report:one', work_ref: 'work:one', handoff_id: 'work:one', list_id: 'reports', row_id: 'one', origin: 'synthetic', intake_state: 'work_created', private_notes: 'do-not-copy', token: 'do-not-copy' } }) });
  const { body } = await h.deliver({ to: ['tool-place:tool:tell-the-makers'], items: [{ kind: 'words', text: 'A report' }], request_key: 'receipt' });
  assert.equal(body.stopped_at, null);
  assert.equal(body.delivered[0].receipt.task_id, 'task:receipt');
  assert.equal(body.delivered[0].receipt.work_ref, 'work:one');
  assert.equal(body.delivered[0].receipt.source_ref, 'record:report:one');
  const kept = await h.shares.shares({});
  assert.deepEqual(kept.shares[0].sent_to[0].receipt, body.delivered[0].receipt);
  assert.ok(!JSON.stringify(body).includes('do-not-copy'));
  assert.ok(!JSON.stringify(kept).includes('do-not-copy'));
});

test('a pending tool task is not a delivered report and its receipt survives until the same share completes', async () => {
  let state = 'working';
  const keys = [];
  const h = person([], null, [tellTheMakers], { toolReply: body => { keys.push(body.request_key); return { task_id: 'task:pending', state, output: state === 'completed' ? { source_ref: 'record:report:done' } : null }; } });
  const input = { to: ['tool-place:tool:tell-the-makers'], items: [{ kind: 'words', text: 'A report' }], request_key: 'same-report' };
  const first = (await h.deliver(input)).body;
  assert.deepEqual(first.delivered, []);
  assert.equal(first.stopped_at.receipt.task_id, 'task:pending');
  assert.match(first.stopped_at.error, /still unconfirmed/);
  assert.equal((await h.shares.shares({})).shares[0].stopped_at.receipt.state, 'working');
  state = 'completed';
  const second = (await h.deliver(input)).body;
  assert.equal(second.stopped_at, null);
  assert.equal(second.delivered[0].receipt.source_ref, 'record:report:done');
  assert.equal((await h.shares.shares({})).shares[0].stopped_at, undefined);
  assert.deepEqual(keys, ['same-report', 'same-report']);
});

test('a share kept before actions and runs were lists reads back as lists', async () => {
  const history = memoryShareHistory();
  history.keep({ share_id: 'old', at: '2026-10-01T00:00:00.000Z', items: [{ kind: 'link', url: 'https://example.com/' }], action: { id: 'which-pursuit', label: 'Which pursuit is this for?' }, workflow_run: { workflow_id: 'workflow:x', run_id: 'run:1' }, sent_to: [] });
  const agents = makeAgents({ store: agentStoreForTests(), starters: startersFrom(starterRows) });
  const shares = makeShareDestinations({ store: { choices: () => null, putChoices: () => {} }, history, instructions: agents, pursuits: async () => [], send: async () => ({}), readLink: async () => null, later: () => {} });
  const [row] = shares.shares({}).shares;
  assert.deepEqual(row.actions, [{ id: 'which-pursuit', label: 'Which pursuit is this for?' }]);
  assert.deepEqual(row.workflow_runs, [{ workflow_id: 'workflow:x', run_id: 'run:1' }]);
  assert.equal(row.action, undefined);
});

test('a share handed to several AIs lists each AI job it became (finding 24)', async () => {
  const jobs = new Map();
  const { deliver, shares } = person(undefined, null, undefined, { aiWorkOf: id => jobs.get(id) ?? null });
  const { body } = await deliver({ to: ['private'], items: shared, action: 'which-pursuit', to_agent: ['agent-a', 'agent-b'], request_key: 'several' });
  assert.equal(body.handoff_ids.length, 2);
  body.handoff_ids.forEach((id, index) => jobs.set(id, { handoff_id: id, state: index ? 'waiting' : 'finished', taken_by: index ? null : 'agent-a', finished_at: null, outcome: null }));
  const [row] = shares.shares({}).shares;
  assert.deepEqual(row.ai_works.map(work => [work.handoff_id, work.state]), [[body.handoff_ids[0], 'finished'], [body.handoff_ids[1], 'waiting']]);
  assert.equal(row.ai_work.handoff_id, body.handoff_ids[0]);
});

test('each listed share says what AI work it became, read by the request key its kept folder is named by', async () => {
  const history = memoryShareHistory();
  history.keep({ share_id: 'kept:/Shared from iPhone/KEY-1', at: '2026-10-03T19:00:00.000Z', items: [{ kind: 'file', name: 'IMG_1627.jpeg' }], sent_to: [], kept_in: '/Shared from iPhone/KEY-1' });
  history.keep({ share_id: 'kept:/Shared from iPhone/KEY-2', at: '2026-10-03T18:00:00.000Z', items: [{ kind: 'text', text: 'note' }], sent_to: [], kept_in: '/Shared from iPhone/KEY-2' });
  const agents = makeAgents({ store: agentStoreForTests(), starters: startersFrom(starterRows) });
  const done = { handoff_id: handoffIdFor('KEY-1'), state: 'finished', taken_by: 'agent-retired-trillion', finished_at: '2026-10-03T20:00:00.000Z', outcome: 'Kept and filed.' };
  const shares = makeShareDestinations({ store: { choices: () => null, putChoices: () => {} }, history, instructions: agents, pursuits: async () => [], send: async () => ({}), readLink: async () => null, later: () => {}, aiWorkOf: id => (id === done.handoff_id ? done : null) });
  const [taken, waiting] = shares.shares({}).shares;
  assert.deepEqual(taken.ai_work, done);
  assert.equal(waiting.ai_work, undefined);
});

test('a pursuit with nobody else files records privately and is given its room by the first share of links or words (the space routes take its id); a room id still finds its pursuit', async () => {
  const books = { id: 'pursuit:books', title: 'Books', depth: 0 };
  const { deliver, sent } = person([books, pottery], null, [countWords]);
  const records = await deliver({ to: ['pursuit:books'], items: [{ kind: 'file', file: '1f:draft' }], request_key: 'only-records' });
  assert.deepEqual(records.body.delivered, [{ id: 'pursuit:books', label: 'Books' }]);
  assert.deepEqual(sent, [{ path: '/scope/record', body: { record: 'file:1f:draft', add: { pursuits: ['pursuit:books'] } } }]);
  sent.length = 0;
  const words = await deliver({ to: ['pursuit:books'], items: [{ kind: 'link', url: 'https://example.com/a' }], own_words: 'for chapter two', request_key: 'with-words' });
  assert.equal(words.body.stopped_at, null);
  assert.deepEqual(sent.map(call => call.path), ['/spaces/pursuit%3Abooks/share']);
  sent.length = 0;
  const byRoom = await deliver({ to: ['space-pottery'], items: [{ kind: 'text', text: 'see you at six' }], request_key: 'old-app' });
  assert.deepEqual(byRoom.body.delivered, [{ id: 'pursuit:pottery', label: 'Pottery group' }]);
  assert.deepEqual(sent.map(call => call.path), ['/spaces/space-pottery/share']);
});

test('a sign-in held to some rooms shares into them and files nothing privately', async () => {
  const { deliver, sent } = person(undefined, null, [countWords], { filesPrivately: false });
  await deliver({ to: ['pursuit:community'], items: [{ kind: 'file', file: '1f:clip' }], request_key: 'room-key' });
  assert.deepEqual(sent.map(call => call.path), ['/spaces/space-community/share']);
});

// ---- Trillion routes a share itself: no place picked ----

const pages = [{ kind: 'page', url: 'https://example.com/post/1', title: 'Pickleball serve drill' }, { kind: 'selection', text: 'keep the serve low' }];
const pickleball = { id: 'pursuit:pickleball', title: 'Pickleball club', depth: 0, now: 'Plan the serve drill night', others: ['Sam'], people_count: 2 };
const connections = { search: async () => ({ results: [{ id: 'record:note-1', title: 'Serve notes' }, { id: 'person:ana', title: 'Ana' }] }), scope: async ref => (ref === 'note-1' ? { pursuits: [{ id: 'pursuit:pickleball', title: 'Pickleball club' }] } : { pursuits: [] }) };

test('deliver_share with no place routes itself: their own Trillion, the route-it-yourself job on Trillion X mode, and what it connects to', async () => {
  const { deliver, sent } = person([pickleball], null, [countWords], { connect: connections });
  const { status, body } = await deliver({ items: pages, request_key: 'route-1', own_words: 'worth a try?' });
  assert.equal(status, 200);
  assert.deepEqual(body.delivered, [{ id: 'private', label: 'My Trillion' }]);
  assert.equal(body.stopped_at, null);
  assert.deepEqual(body.workflow_runs, ['run:route-1']);
  assert.deepEqual(body.connected.pursuits, [{ id: 'pursuit:pickleball', title: 'Pickleball club' }]);
  assert.deepEqual(body.connected.people, [{ id: 'person:ana', name: 'Ana' }, { name: 'Sam' }]);
  assert.deepEqual(body.connected.records, [{ id: 'note-1', title: 'Serve notes' }]);
  assert.deepEqual(sent.map(call => call.path), ['/workflows/describe', '/workflows/start', '/handoffs']);
  const start = sent[1].body;
  assert.equal(start.workflow_id, 'workflow:trillion-x-mode');
  assert.match(start.input.request, /worth a try\?/);
  assert.match(start.input.request, /keep the serve low/);
  assert.match(start.input.scope, /Pickleball club \(pursuit:pickleball\)/);
  assert.ok(start.input.constraints.length > 0);
  const handoff = sent[2].body;
  assert.match(handoff.job, /routing this share itself/);
  assert.deepEqual(handoff.input.connected, body.connected);
  assert.equal(handoff.input.routed_by_trillion, true);
  assert.deepEqual(handoff.input.saved_instructions, ['route-it-yourself']);
});

test('an empty to routes itself the same as a left out one, and a to that is not a list is still refused', async () => {
  const { deliver } = person([pickleball], null, [countWords], { connect: connections });
  const empty = await deliver({ to: [], items: pages, request_key: 'route-2' });
  assert.equal(empty.status, 200);
  assert.deepEqual(empty.body.workflow_runs, ['run:route-2']);
  const wrong = await deliver({ to: 'private', items: pages, request_key: 'route-3' });
  assert.equal(wrong.status, 400);
  assert.match(wrong.body.error, /to is a list of place ids/);
});

test('routing itself never throws for nothing to do: a file alone still starts Trillion X mode, and the same key is the same delivery', async () => {
  const { deliver, sent } = person([], null, [countWords]);
  const file = [{ kind: 'video', name: 'clip.mp4', file: '1f:abc' }];
  const first = await deliver({ items: file, request_key: 'route-4' });
  assert.equal(first.status, 200);
  assert.match(sent.find(call => call.path === '/workflows/start').body.input.request, /clip\.mp4/);
  assert.deepEqual(first.body.connected, { pursuits: [], people: [], records: [] });
  assert.match(sent.find(call => call.path === '/workflows/start').body.input.scope, /Nothing is connected/);
  const again = await deliver({ items: file, request_key: 'route-4' });
  assert.equal(again.status, 200);
  // The owner keeps one hand-off and one run per key; every send of the same share names the same keys.
  assert.deepEqual([...new Set(sent.filter(call => call.path === '/handoffs' || call.path === '/workflows/start').map(call => call.body.request_key))], ['route-4']);
  assert.equal(sent.filter(call => call.path === '/workflows/start').every(call => call.body.request_key === 'route-4'), true);
});

test('routing itself yields to a site default, to a named action, to the person\'s edit of it and to turning it off', async () => {
  const site = person([], null, [countWords], { connect: connections });
  await site.deliver({ items: [{ kind: 'page', url: 'https://www.instagram.com/p/abc/', title: 'A post' }], request_key: 'route-5' });
  assert.ok(site.sent.some(call => call.path === '/saved-examples'), 'instagram still studies the format');
  assert.ok(!site.sent.some(call => call.path === '/workflows/start'));

  const named = person([], null, [countWords]);
  await named.deliver({ items: pages, action: 'why-was-this-posted', request_key: 'route-6' });
  assert.ok(!named.sent.some(call => call.body?.workflow_id === 'workflow:trillion-x-mode'));
  assert.deepEqual(named.sent.find(call => call.path === '/handoffs').body.input.saved_instructions, ['why-was-this-posted']);

  const edited = person([], null, [countWords]);
  const listed = (await edited.route('GET')).body;
  assert.deepEqual([listed.route_itself.on, listed.route_itself.edited, listed.route_itself.action.id], [true, false, 'route-it-yourself']);
  await edited.route('POST', { actions: [...listed.actions, { ...listed.route_itself.action, words: 'Only file this, nothing else.' }] });
  assert.equal((await edited.route('GET')).body.route_itself.edited, true);
  await edited.deliver({ items: pages, request_key: 'route-7' });
  assert.match(edited.sent.find(call => call.path === '/handoffs').body.job, /Only file this, nothing else\./);

  const off = person([], null, [countWords]);
  await off.route('POST', { route_itself: false });
  assert.equal((await off.route('GET')).body.route_itself.on, false);
  await off.deliver({ items: pages, request_key: 'route-8' });
  assert.ok(!off.sent.some(call => call.body?.workflow_id === 'workflow:trillion-x-mode'));
});

test('connectedTo is bounded and never throws: a search that fails or hangs leaves what the pursuits list found', async () => {
  const pursuits = [pickleball, { id: 'pursuit:other', title: 'Taxes', now: 'File them' }];
  const failing = await connectedTo(pages, '', { pursuits, search: async () => { throw new Error('exceeded its memory limit'); }, scope: async () => { throw new Error('no'); } });
  assert.deepEqual(failing.pursuits, [{ id: 'pursuit:pickleball', title: 'Pickleball club' }]);
  const hanging = await connectedTo(pages, '', { pursuits, search: () => new Promise(() => {}), scope: null });
  assert.deepEqual(hanging.pursuits.map(pursuit => pursuit.id), ['pursuit:pickleball']);
  const many = Array.from({ length: 40 }, (_, index) => ({ id: `record:r${index}`, title: `Serve ${index}` }));
  const asked = [];
  const bounded = await connectedTo(pages, '', { pursuits, search: async () => ({ results: many }), scope: async ref => { asked.push(ref); return { pursuits: [] }; } });
  assert.ok(bounded.records.length <= 6 && asked.length <= 3);
  assert.deepEqual(await connectedTo([{ kind: 'text', text: 'hi' }], '', {}), { pursuits: [], people: [], records: [] });
});

// A delivery files privately only for a sign-in whose reach includes the private Trillion: a pursuit-limited sign-in (the
// PersonStore owner read its reach from the request headers) files nothing privately, and so does a sign-in with no reach.
test('a delivering sign-in files privately only when its reach includes the private Trillion', () => {
  assert.equal(filesPrivatelyOf({ made: { private: true, spaces: 'all' } }), true);
  assert.equal(filesPrivatelyOf({ made: { private: false, spaces: ['pursuit:books'] } }), false, 'a pursuit-limited sign-in files nothing privately');
  assert.equal(filesPrivatelyOf({ made: null }), false);
  assert.equal(filesPrivatelyOf(null), false, 'no claims files nothing privately');
});
