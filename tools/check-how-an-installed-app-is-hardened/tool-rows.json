{
  "records": [
    {
      "payload": {
        "kind": "ai-tool-descriptor",
        "status": "active",
        "licence_class": "licence:maker-own",
        "maker": "maker:check-how-an-installed-app-is-hardened",
        "listed_on": "2026-11-03T16:00:00Z",
        "id": "tool:check-an-app",
        "placements": [
          "placement:your-computer"
        ],
        "needs": {
          "expected_seconds": 10,
          "network_egress": false
        },
        "label": "Check how an installed app is hardened",
        "job": "Read how an installed macOS app is hardened, from its files and the system's codesign without launching it, and say in words what falls short: Electron fuses left weak, a missing hardened runtime, forbidden entitlements, an integrity hash nothing enforces",
        "description": "Give app: the full path of an installed app bundle (such as /Applications/Sample.app) inside the folder the person granted for reading. The app is never launched; only its Electron framework binary, its Info.plist and the system's codesign output are read. Returns app, findings (each { kind, name?, state?, said }) and ok (true when there are none). What cannot be read (no app bundle, unsigned, no fuse block, an unknown fuse version) is a finding, never assumed fine.",
        "input_schema": {
          "type": "object",
          "required": [
            "app"
          ],
          "additionalProperties": false,
          "properties": {
            "app": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "output_schema": {
          "type": "object",
          "required": [
            "findings",
            "ok"
          ],
          "properties": {
            "app": {
              "type": "string"
            },
            "findings": {
              "type": "array"
            },
            "ok": {
              "type": "boolean"
            }
          }
        },
        "invoke": {
          "kind": "computer",
          "capabilities": [
            "read-a-folder"
          ],
          "workdir": "/opt/check-how-an-installed-app-is-hardened",
          "stdout": "json",
          "argv": [
            "node",
            "/opt/records-door/do-work/run-an-export.mjs",
            "/opt/check-how-an-installed-app-is-hardened/read-data/app-hardening.mjs",
            "audit"
          ],
          "stdin": {
            "fill": {
              "from": "input"
            }
          },
          "files": {
            "package_files": [
              {
                "package": "check-how-an-installed-app-is-hardened",
                "paths": [
                  "read-data"
                ],
                "at": "/opt/check-how-an-installed-app-is-hardened"
              },
              {
                "package": "records-door",
                "paths": [
                  "do-work",
                  "read-data"
                ],
                "at": "/opt/records-door"
              },
              {
                "package": "content-identity",
                "paths": [
                  "read-data"
                ],
                "at": "/opt/content-identity"
              },
              {
                "module": "@noble/hashes",
                "paths": [
                  "LICENSE",
                  "package.json",
                  "blake3.js",
                  "blake2.js",
                  "_blake.js",
                  "_md.js",
                  "_u64.js",
                  "utils.js"
                ],
                "at": "/opt/node_modules/@noble/hashes"
              }
            ]
          }
        },
        "result_selector": "$.result",
        "verify": [{"kind":"sample-run","input":{"app":"{grant:read-a-folder}/Applications/Sample.app"},"files":[{"grant":"read-a-folder","path":"Applications/Sample.app/Contents/Info.plist","text":"<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<plist version=\"1.0\"><dict><key>CFBundleName</key><string>Sample</string></dict></plist>\n"}]}]
      }
    }
  ]
}
