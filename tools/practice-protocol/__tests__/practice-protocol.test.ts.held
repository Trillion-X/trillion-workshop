import React from 'react';
import { cleanup, fireEvent, render, screen, waitFor } from '@testing-library/react';
import { sendRequestToBitfieldTarget } from '@bitfield/runtime-kit';
import { useBitfieldData } from '@bitfield/runtime-kit/react';
import { afterEach, beforeEach, describe, expect, it, vi } from '../../../test-helpers/vitest-shim.mjs';
import { buildRequestProtocolEventInput } from '../do-work/request-protocol-event.ts';
import { practiceProtocolViews, readPracticeProtocolState } from '../read-data/read-practice-protocol.ts';
import { PracticeProtocolSurface } from '../show/PracticeProtocolSurface.tsx';

vi.mock('@bitfield/runtime-kit', () => ({
  sendRequestToBitfieldTarget: vi.fn(async () => ({ ok: true })),
}));

vi.mock('@bitfield/runtime-kit/react', () => ({
  useBitfieldData: vi.fn(),
}));

const now = new Date('2026-06-20T12:00:00.000Z');

function seededRows() {
  return [
    { payload: { kind: 'practice-protocol', protocolId: 'protocol:1', label: 'Decision Practice', summary: 'One focused sequence.' } },
    { payload: { kind: 'practice-protocol-step', stepId: 'step:prepare', protocolId: 'protocol:1', label: 'Prepare evidence', cue: 'Gather the facts.', evidenceNeeded: 'One note or clip.', sortOrder: 1 } },
    { payload: { kind: 'practice-protocol-step', stepId: 'step:act', protocolId: 'protocol:1', label: 'Run the action', cue: 'Execute the planned move.', sortOrder: 2 } },
    { payload: { kind: 'practice-protocol-state', stateId: 'state:1', protocolId: 'protocol:1', learnerId: 'learner:1', currentStepId: 'step:act', completedStepIds: ['step:prepare'], updatedAt: now.toISOString() } },
  ];
}

describe('practice-protocol', () => {
  beforeEach(() => {
    vi.mocked(sendRequestToBitfieldTarget).mockClear();
    vi.mocked(useBitfieldData).mockReset();
  });

  afterEach(() => {
    cleanup();
  });

  it('projects the current practice step over generic records', () => {
    const view = practiceProtocolViews(readPracticeProtocolState(seededRows()), 'learner:1')[0];

    expect(view?.currentStep?.label).toBe('Run the action');
    expect(view?.completedCount).toBe(1);
    expect(view?.totalSteps).toBe(2);
  });

  it('builds a practice event request with a caller-supplied target', () => {
    const input = buildRequestProtocolEventInput({
      requestId: 'practice-protocol-event-request:1',
      learnerId: ' learner:1 ',
      protocolId: ' protocol:1 ',
      stepId: ' step:act ',
      target: ' action:owner.handle-practice ',
      event: { action: 'start' },
      now,
    });

    expect(input.request_record).toMatchObject({
      kind: 'practice-protocol-event-request',
      learnerId: 'learner:1',
      protocolId: 'protocol:1',
      stepId: 'step:act',
      target: 'action:owner.handle-practice',
    });
  });

  it('renders the current step action through the package owner action', async () => {
    vi.mocked(useBitfieldData).mockReturnValue(seededRows());

    render(React.createElement(PracticeProtocolSurface, { learnerId: 'learner:1', eventTarget: 'action:owner.handle-practice' }));

    expect(screen.getAllByText('Run the action')).toHaveLength(2);
    fireEvent.click(screen.getByRole('button', { name: 'Start step' }));

    await waitFor(() => expect(sendRequestToBitfieldTarget).toHaveBeenCalledTimes(1));
    expect(vi.mocked(sendRequestToBitfieldTarget).mock.calls[0]?.[0]).toMatchObject({
      target: 'slot::workflow',
      payload: {
        definition_id: 'action:practice-protocol.request-protocol-event',
        input: {
          request_record: {
            learnerId: 'learner:1',
            protocolId: 'protocol:1',
            stepId: 'step:act',
            target: 'action:owner.handle-practice',
          },
        },
      },
    });
  });

  it('keeps owner boundaries out of the practice shell', () => {
    const text = JSON.stringify(seededRows());

    expect(text).not.toMatch(/tennis|score|mastery|streak|video|coach feedback/i);
  });
});
