        "id": "tool:check-a-cuts-speech-against-its-plan",
        "label": "Hear a made cut against its plan: loudness, long silences and every spoken line (runs on your computer)",
        "status": "active",
        "job": "Listen to the cut you made from my plan: how loud it is, where it goes silent too long, whether every line I planned is heard and starts and ends where it should, and show me a few frames",
        "description": "Reads a made cut and its timeline (the one tool:assemble-a-plan-into-a-cut writes: each segment's kind, text, start and length). Measures its integrated loudness and every silence longer than the person's limit, reads each spoken segment with a speech reader (mlx-whisper, or any command the person gives) and compares it with the plan's line: the share of the words heard, the words missing, and whether it starts and ends on the plan's words. Takes the frames the person names (the first, middle or last segment of a kind) and lays them side by side. The report keeps listened_by, who listened to the cut end to end, which only a person sets. Exit 2 when a segment is to check, so it can stand as a check row of the cutter.",
        "input_schema": {
          "type": "object",
          "properties": {
            "input": {
              "type": "string",
              "description": "The made cut, put where {input} is."
            },
            "timeline": {
              "type": "string",
              "description": "Its timeline.json, put where {timeline} is."
            },
            "output": {
              "type": "string",
              "description": "The folder the frames and the report (verify.json) go to, put where {output} is."
            },
            "kinds": {
              "type": "string",
              "description": "Comma list of the spoken segment kinds to read, put where {kinds} is."
            },
            "frames": {
              "type": "string",
              "description": "Comma list of frames to take, each kind:first, kind:middle or kind:last, put where {frames} is."
            }
          },
          "required": [
            "input",
            "timeline",
            "output",
            "kinds"
          ]
        },
        "output_schema": {
          "type": "object",
          "description": "The last line printed: {\"result\": {\"report\", \"lufs\", \"silences\", \"to_check\": [segment index], \"frames\", \"listened_by\"}}."
        },
        "invoke": {
          "kind": "on-your-computer",
          "get_it": [
            "clone the Workshop repository (package.json repository.url)",
            "python3 -m pip install -U numpy soundfile",
            "brew install ffmpeg",
            "python3 -m pip install -U mlx-whisper   # Apple silicon only; or give --reader, a command that prints the words of a wav"
          ],
          "run": "python3 tools/check-a-rendered-video/do-work/check_cut_speech.py --cut {input} --timeline {timeline} --work {output} --kinds {kinds} --frames {frames}",
          "needs": [
            "python",
            "ffmpeg",
            "a speech reader: mlx-whisper on Apple silicon, or a command given with --reader"
          ],
          "files": {
            "package_files": [
              {
                "package": "check-a-rendered-video",
                "paths": [
                  "do-work/check_cut_speech.py",
                  "do-work/speech_reading.py"
                ],
                "at": "/opt/check-a-rendered-video"
              }
            ]
          },
          "say": "This runs on the person's own computer, from the root of the Workshop checkout. Tell the person the loudness, each long silence with its length, and each segment to check with the words missing or heard at its ends; show them the frames. Say plainly when listened_by is null: nobody has listened to this cut yet. Never set listened_by yourself."
        },
