{
  "package": "converge-installed-apps-to-their-current-handle",
  "things": [
    {
      "type": "record",
      "address": "package::converge-installed-apps-to-their-current-handle::contract",
      "path": ["packages", "converge-installed-apps-to-their-current-handle", "contract"],
      "payload": {
        "kind": "package-contract",
        "package": "converge-installed-apps-to-their-current-handle",
        "owns": [
          "making one caller-named installed app match its own current open handle, since an advance APPENDS a handle and changes nothing already running",
          "releasing one caller-named installed app's writer without opening anything, so a replacement bundle can be admitted while the old exclusive envelope writer is absent",
          "the predicate that defines success: the opener's own status report re-observed as a live, current resident owner after the open, and a published address answering whenever one exists, never two commands exiting zero; an app with no HTTP shell is not invisible",
          "confirming the close landed BEFORE opening, because a reopen issued too early no-ops as already-open and keeps the stale bundle resident while everything reports success",
          "treating a not-running app as a legal starting state rather than an error",
          "reporting a failed close or open alongside the address observations, so the caller can see what actually happened"
        ],
        "does_not_own": [
          "arbitrary process execution: the argv is fixed in this package's source and the caller supplies only a validated app id",
          "retrying, watching or scheduling; a loop here would be a second scheduler, which is the shape that already made the engine a second owner of scheduling once",
          "deciding WHICH app to converge, or what changed in its handle, which it never learns",
          "changing native bytes or current handles; this owner only reopens the current signed handle and reports the resulting live state",
          "proving that whatever changed in the handle behaves correctly, which is the changed component's own tests"
        ]
      }
    },
    {
      "type": "record",
      "address": "package::converge-installed-apps-to-their-current-handle::checks",
      "path": ["packages", "converge-installed-apps-to-their-current-handle", "checks"],
      "payload": {
        "kind": "package-checks-descriptor",
        "checks": ["tests/converge-installed-apps-to-their-current-handle.test.mjs"]
      }
    },
