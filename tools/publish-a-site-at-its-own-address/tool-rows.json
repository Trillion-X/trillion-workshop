 "records": [
  {
   "payload": {
    "kind": "ai-tool-descriptor",
    "id": "tool:publish_site",
    "listed_on": "2026-11-04T12:00:00Z",
    "label": "Publish a site",
    "status": "active",
    "job": "Publish a website's pages and files so it can be given its own address",
    "description": "Keeps a site's files (files by path, index.html first, text or data: URLs; or site, the name of a site.json in your files such as copy_a_site leaves) under a new installation in your files, or a new version of one already published (installation). Returns the installation id, how many files and bytes, and a name its page title suggests. Give it an address with name_site or attach_domain. A site that already has an address also gets llms.txt, the list of its pages AI apps read, unless it ships its own.",
    "input_schema": {
     "type": "object",
     "additionalProperties": false,
     "properties": {
      "files": {
       "type": "object",
       "description": "The site's files by path, like {\"index.html\": \"<h1>Hi</h1>\"}"
      },
      "site": {
       "type": "string",
       "description": "The name of a site.json in your files"
      },
      "installation": {
       "type": "string",
       "pattern": "^[0-9a-f]{32}$",
       "description": "The site's installation id, as publish_site answered it"
      }
     }
    },
    "output_schema": {
     "type": "object",
     "required": [
      "installation",
      "files",
      "bytes"
     ],
     "properties": {
      "installation": {
       "type": "string"
      },
      "files": {
       "type": "integer",
       "minimum": 1
      },
      "bytes": {
       "type": "integer",
       "minimum": 0
      },
      "suggested_name": {
       "type": "string"
      },
      "llms": {
       "type": "boolean"
      }
     }
    },
    "invoke": {
     "kind": "container",
     "workdir": "/opt/publish-a-site-at-its-own-address",
     "stdout": "json",
     "argv": [
      "node",
      "/opt/records-door/do-work/run-an-export.mjs",
      "/opt/publish-a-site-at-its-own-address/read-data/site-addresses.mjs",
      "publishSite"
     ],
     "stdin": {
      "fill": {
       "from": "input"
      }
     },
