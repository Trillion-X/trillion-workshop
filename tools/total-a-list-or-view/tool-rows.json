  "record_set": "total-a-list-or-view-tool-rows",
  "what_this_is": "The Workshop row for tools/total-a-list-or-view: totals over one of a person's lists or saved views, run over their records through the records door by the list owner's own aggregate code. Nothing in it names a list, field or measure; the person's list and the measures in tools/keep-and-wake-ai-sessions-on-this-computer/src/lists.json `aggregates` are the data.",
  "records": [
    {
      "payload": {
        "kind": "ai-tool-descriptor",
        "id": "tool:total-a-list-or-view",
        "label": "Total a list or a view",
        "status": "active",
        "job": "Add up a list, or one of its saved views, without reading its rows: how many rows, the sum, average, smallest or largest of a number field, over the whole list or for each value of one field",
        "description": "Totals over one of my lists or one of its saved views, without sending the rows: measures: [{ op, field? }] where op is count (rows), filled or distinct (any field), or sum, average, median, min or max (a number field), each answered once for the whole list and, with group_by, once for each value of that field (at most 100 groups; a field holding several tags counts the row once per tag). With view_id only the rows that view keeps are totalled, read the way the page shows the view. The answer says how many rows it counted and complete: false when it stopped before the end, so a partial total is never taken for the whole. This run is granted this one list and its row kind only and reads nothing else. Old trillion's read_list_aggregates (POST /lists/<id>/aggregate).",
        "input_schema": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "list_id",
            "type",
            "measures"
          ],
          "properties": {
            "list_id": {
              "type": "string",
              "pattern": "^list:.+",
              "description": "The list's record id, like list:orders; this run's right to read the list is filled from it"
            },
            "type": {
              "type": "string",
              "pattern": "^record:.+",
              "description": "The kind of the list's rows, record: and the list's row_type (record:order); this run's right to read the rows is filled from it"
            },
            "measures": {
              "type": "array",
              "minItems": 1,
              "maxItems": 20,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "op"
                ],
                "properties": {
                  "op": {
                    "type": "string",
                    "description": "count, filled, distinct, sum, average, median, min or max"
                  },
                  "field": {
                    "type": "string",
                    "description": "The field to total (not needed for count)"
                  }
                }
              }
            },
            "group_by": {
              "type": "string",
              "description": "A field of the list: one set of totals for each value it holds"
            },
            "view_id": {
              "type": "string",
              "description": "One of the list's saved views: only the rows it keeps are totalled"
            }
          }
        },
        "output_schema": {
          "type": "object",
          "required": [
            "list_id",
            "rows_counted",
            "complete",
            "measures"
          ],
          "properties": {
            "list_id": {
              "type": "string"
            },
            "view_id": {
              "type": "string"
            },
            "rows_counted": {
              "type": "integer"
            },
            "complete": {
              "type": "boolean"
            },
            "measures": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "op",
                  "value"
                ],
                "properties": {
                  "field": {},
                  "op": {
                    "type": "string"
                  },
                  "label": {
                    "type": "string"
                  },
                  "value": {}
                }
              }
            },
            "group_by": {
              "type": "string"
            },
            "groups_more": {
              "type": "boolean"
            },
            "groups": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "key",
                  "rows",
                  "measures"
                ],
                "properties": {
