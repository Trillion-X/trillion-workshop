        "id": "tool:approve-a-pairing-code",
        "listed_on": "2026-11-03T12:00:00Z",
        "label": "Approve a pairing code",
        "job": "Let a waiting sender's messages through by approving the pairing code they were given",
        "description": "Give code (case and spaces do not matter) and, optionally, source_id. A code works once, only before it expires, and only for the source it was issued for. Returns source_id, sender and said; an unknown, used or expired code is refused with what to do. It reaches no database: give the pairing facts the person keeps as facts, and keep what the answer's keep lists.",
        "input_schema": {
          "type": "object",
          "required": [
            "code"
          ],
          "additionalProperties": false,
          "properties": {
            "code": {
              "type": "string",
              "minLength": 1
            },
            "source_id": {
              "type": "string"
            },
            "facts": {
              "type": "object",
              "description": "The pairing facts the person keeps, by name (pairing-waiting:<source>:<code> and pairing-paired:<source>:<sender>), read by the caller from wherever the person keeps them. Left out, none are kept yet."
            }
          }
        },
        "output_schema": {
          "type": "object",
          "required": [
            "source_id",
            "sender",
            "said"
          ],
          "properties": {
            "source_id": {
              "type": "string"
            },
            "sender": {
              "type": "string"
            },
            "said": {
              "type": "string"
            },
            "keep": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "name",
                  "value"
                ]
              },
              "description": "The facts this call wrote, to keep in the person's own database (the newest value per name is current)"
            }
          }
        },
        "invoke": {
          "kind": "container",
          "internet": false,
          "argv": [
            "node",
            "/opt/workflows/do-work/run-a-function.mjs",
            "/opt/pair-unknown-senders/read-data/pairing-tools.mjs",
            "approvePairing"
          ],
          "stdin": {
            "fill": {
