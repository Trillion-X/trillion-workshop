        "id": "tool:pair-an-unknown-sender",
        "listed_on": "2026-11-03T12:00:00Z",
        "label": "Give an unknown sender a pairing code",
        "job": "Hold a message from a sender the person has not paired yet and give that sender a short code the person can approve",
        "description": "Give source_id (the event source the message came in on) and sender (the sender's own id on that source). Returns { paired: true } when the sender is already paired; otherwise code (8 characters with no 0, O, 1 or I), expires_at (an hour from now) and said. Asking again for the same sender gives the same code; a source with 3 codes waiting gives no more ({ full: true, said }).",
        "input_schema": {
          "type": "object",
          "required": [
            "source_id",
            "sender"
          ],
          "additionalProperties": false,
          "properties": {
            "source_id": {
              "type": "string",
              "minLength": 1
            },
            "sender": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "output_schema": {
          "type": "object",
          "properties": {
            "paired": {
              "type": "boolean"
            },
            "full": {
              "type": "boolean"
            },
            "code": {
              "type": "string"
            },
            "expires_at": {
              "type": "string"
            },
            "said": {
              "type": "string"
            }
          }
        },
        "invoke": {
          "kind": "container",
          "files": {
            "package_files": [
              {
                "package": "pair-unknown-senders",
                "paths": [
                  "read-data"
                ],
                "at": "/opt/pair-unknown-senders"
              },
              {
                "package": "records-door",
                "paths": [
                  "do-work",
                  "read-data"
                ],
                "at": "/opt/records-door"
              },
              {
                "package": "content-identity",
                "paths": [
                  "read-data"
                ],
                "at": "/opt/content-identity"
              },
              {
                "module": "@noble/hashes",
                "paths": [
                  "LICENSE",
                  "package.json",
                  "blake3.js",
                  "blake2.js",
                  "_blake.js",
                  "_md.js",
                  "_u64.js",
                  "utils.js"
                ],
                "at": "/opt/node_modules/@noble/hashes"
              }
            ]
          },
          "workdir": "/opt/pair-unknown-senders",
          "internet": false,
          "stdout": "json",
          "argv": [
            "node",
            "/opt/records-door/do-work/run-an-export.mjs",
            "/opt/pair-unknown-senders/read-data/pairing-tools.mjs",
            "requestPairing"
          ],
          "stdin": {
            "fill": {
              "from": "input"
            }
          },
          "records": {
            "fd": 3,
            "rights": [
              {
                "kind": "sender-pairing",
                "operations": [
                  "records:read",
                  "records:list",
                  "records:write"
                ]
              }
            ]
          }
        },
        "result_selector": "$.result",
        "provenance": {
          "source": "moved from Trillion-X/trillion src/sender-pairing.mjs"
        },
