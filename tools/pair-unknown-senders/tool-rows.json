        "id": "tool:pair-an-unknown-sender",
        "listed_on": "2026-11-03T12:00:00Z",
        "label": "Give an unknown sender a pairing code",
        "job": "Hold a message from a sender the person has not paired yet and give that sender a short code the person can approve",
        "description": "Give source_id (the event source the message came in on) and sender (the sender's own id on that source). Returns { paired: true } when the sender is already paired; otherwise code (8 characters with no 0, O, 1 or I), expires_at (an hour from now) and said. Asking again for the same sender gives the same code; a source with 3 codes waiting gives no more ({ full: true, said }). It reaches no database: give the pairing facts the person keeps as facts, and keep what the answer's keep lists.",
        "input_schema": {
          "type": "object",
          "required": [
            "source_id",
            "sender"
          ],
          "additionalProperties": false,
          "properties": {
            "source_id": {
              "type": "string",
              "minLength": 1
            },
            "sender": {
              "type": "string",
              "minLength": 1
            },
            "facts": {
              "type": "object",
              "description": "The pairing facts the person keeps, by name (pairing-waiting:<source>:<code> and pairing-paired:<source>:<sender>), read by the caller from wherever the person keeps them. Left out, none are kept yet."
            }
          }
        },
        "output_schema": {
          "type": "object",
          "properties": {
            "paired": {
              "type": "boolean"
            },
            "full": {
              "type": "boolean"
            },
            "code": {
              "type": "string"
            },
            "expires_at": {
              "type": "string"
            },
            "said": {
              "type": "string"
            },
            "keep": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "name",
                  "value"
                ]
              },
              "description": "The facts this call wrote, to keep in the person's own database (the newest value per name is current)"
            }
          }
        },
        "invoke": {
          "kind": "container",
          "internet": false,
          "argv": [
            "node",
            "/opt/workflows/do-work/run-a-function.mjs",
            "/opt/pair-unknown-senders/read-data/pairing-tools.mjs",
            "requestPairing"
          ],
          "stdin": {
            "fill": {
              "from": "input"
            }
          },
          "files": {
            "package_files": [
              {
                "package": "workflows",
                "paths": [
                  "do-work/run-a-function.mjs"
                ],
                "at": "/opt/workflows"
              },
              {
                "package": "pair-unknown-senders",
                "paths": [
                  "read-data/pairing-tools.mjs",
                  "read-data/sender-pairing.mjs",
                  "read-data/sender-pairing.json"
                ],
                "at": "/opt/pair-unknown-senders"
              }
            ]
          }
        },
        "result_selector": "$.result",
        "provenance": {
          "source": "moved from Trillion-X/trillion src/sender-pairing.mjs"
        },
        "verify": [
          {
            "kind": "sample-run",
            "input": {
              "source_id": "events:sample",
              "sender": "sender-one"
            }
          }
        ]
      }
