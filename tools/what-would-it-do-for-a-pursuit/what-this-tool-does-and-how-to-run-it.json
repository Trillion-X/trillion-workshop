        "id": "tool:what-would-it-do",
        "label": "What would it do for my pursuit",
        "job": "Say what the platform would do for a pursuit in the person's own words: the closest tools and workflows, and where to start",
        "description": "Checks the pursuit's words (3 to 300 characters), then picks the Marketplace tools and workflows closest to it from the moves table, with each recording that shows it working. Give pursuit and pursuit_vector (the pursuit's own embedding, from the caller), moves (the moves table with its rows), rows (the Marketplace rows the answer may name) and recordings. Give person and database to keep the answer one day in the person's own database; without them nothing is kept. It changes nothing else.",
        "input_schema": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "pursuit",
            "pursuit_vector",
            "moves",
            "rows"
          ],
          "properties": {
            "pursuit": {
              "type": "string",
              "minLength": 3,
              "maxLength": 300,
              "description": "What they are pursuing, in their own words."
            },
            "pursuit_vector": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 1,
              "description": "The pursuit's embedding, from the caller's own model; the same dimension as the moves table."
            },
            "moves": {
              "type": "object",
              "required": [
                "dimensions",
                "rows",
                "vectors",
                "moves"
              ],
              "description": "The moves table: dimensions, rows (ids), vectors (rows' vectors, flat), moves (each with id, label, vector, rows)."
            },
            "rows": {
              "type": "array",
              "items": {
                "type": "object"
              },
              "description": "The Marketplace rows the answer may name: id, kind (workflow, tool or recording), label, job."
            },
            "recordings": {
              "type": "array",
              "items": {
                "type": "object"
              },
              "description": "The recordings listed right now: id, video, shows (the row ids a recording shows)."
            },
            "person": {
              "type": "string",
              "description": "The person the answer is kept for; needed with database to keep it."
            },
            "database": {
              "type": "string",
              "minLength": 1,
              "description": "The person's own pursuit database (such as ethos_for_who_runs_it) that keeps the answer one day."
            }
          }
        },
        "output_schema": {
          "type": "object",
          "required": [
            "pursuit",
            "first_moves",
            "workflows",
            "tools",
            "screens",
