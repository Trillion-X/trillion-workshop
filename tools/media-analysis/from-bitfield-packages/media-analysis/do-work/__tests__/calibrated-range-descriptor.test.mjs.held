import assert from 'node:assert/strict';
import { readFileSync } from 'node:fs';
import { resolve } from 'node:path';
import test from 'node:test';

const root = process.cwd();
const manifestPath = resolve(root, 'packages/media-analysis/things-to-store-and-run.json');
const submitSourcePath = resolve(root, 'packages/media-analysis/do-work/submit-media-analysis.ts');

function stringValues(value) {
  if (typeof value === 'string') return [value];
  if (Array.isArray(value)) return value.flatMap(stringValues);
  if (value && typeof value === 'object') return Object.values(value).flatMap(stringValues);
  return [];
}

test('calibrated-range descriptor stays generic and composes through compute.process', () => {
  const manifest = JSON.parse(readFileSync(manifestPath, 'utf8'));
  const descriptor = manifest.things.find((thing) => thing.address === 'package::media-analysis::process-descriptor::evidence-to-calibrated-range');
  assert.equal(descriptor.payload.runner, 'compute.process');
  assert.equal(descriptor.payload.action_id, 'action:submit-media-analysis-request');
  assert.deepEqual(descriptor.payload.workflow_input_bindings['options.analysis_command.process_descriptor'], { from_input: '/process_descriptor' });
  assert.equal(descriptor.payload.input_schema.type, 'object');
  assert.equal(descriptor.payload.input_schema.properties.evidence_refs.items instanceof Object, true);
  assert.equal(descriptor.payload.output_schema.type, 'object');
  assert.deepEqual(descriptor.payload.output_schema.required, ['evidence_refs', 'range_bindings', 'confidence_binding', 'provenance_binding', 'result']);
  const contract = manifest.things.find((thing) => thing.address === 'package::media-analysis::contract::calibrated-range');
  assert.equal(contract.payload.schema_ref, 'package::media-analysis::process-descriptor::evidence-to-calibrated-range#/payload/output_schema');
  assert.equal(stringValues({ input: descriptor.payload.input_schema, output: descriptor.payload.output_schema }).some((value) => /^(?:required|open)$/i.test(value)), false);
});

test('touched submit path dispatches through Envelope and imports no stateful content-media-evidence helper', () => {
  const source = readFileSync(submitSourcePath, 'utf8');
  assert.match(source, /sendRequestToBitfieldTarget/);
  assert.doesNotMatch(source, /content-media-evidence/);
});

test('owner manifests contain none of the scenario-only vocabulary', () => {
  const forbidden = /nutrition|diet|body-fat|calorie|macro|shredded|58-days|zz-name-one|zz-phrase-one/i;
  for (const path of [
    'packages/workout-log/things-to-store-and-run.json',
    'packages/training-plan/things-to-store-and-run.json',
    'packages/media-analysis/things-to-store-and-run.json',
  ]) {
    assert.doesNotMatch(readFileSync(resolve(root, path), 'utf8'), forbidden, path);
  }
});
