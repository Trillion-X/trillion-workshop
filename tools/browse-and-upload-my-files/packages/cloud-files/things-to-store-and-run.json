    {
      "type": "record",
      "address": "package::cloud-files::contract::origin-budget-policy",
      "address_mode": "identity_text",
      "path": [
        "current-item",
        "published-record"
      ],
      "payload": {
        "kind": "package-record-contract",
        "record_kind": "cloud-files.origin-budget-policy",
        "required_fields": [
          "kind",
          "monthly_budget",
          "first_payment_budget",
          "originals_cloud_only",
          "no_home_live_dependency",
          "selected_provider",
          "all_in_monthly_cost",
          "selection_reason",
          "candidate_states",
          "all_in_quote_gate"
        ],
        "optional_fields": [],
        "authority_contract": "The app owner's standing approval covers provider selection and purchase. selected_provider names the rank-1 cloud-files.origin row; the choice and its all-in monthly cost are recorded here, never asked for.",
        "budget_contract": "monthly_budget is the historical planning target. all_in_monthly_cost states the real recurring bill at the measured corpus size so an overrun is visible, never hidden; it is not an approval limit.",
        "quote_contract": "An eligible quote must state region, stock, recurring bill, setup, tax, transfer terms, cancellation, support, and recovery implications before provider admission.",
        "placement_contract": "A decision record is one app's choice and lives in that app's package set, never in this package."
      }
    },
    {
      "type": "record",
      "address": "package::cloud-files::contract::origin",
      "address_mode": "identity_text",
      "path": [
        "current-item",
        "published-record"
      ],
      "payload": {
        "kind": "package-record-contract",
        "record_kind": "cloud-files.origin",
        "required_fields": [
          "kind",
          "id",
          "interface",
          "vendor",
          "price"
        ],
        "optional_fields": [
          "credential"
        ],
        "selection_contract": "A host binds, among the origins an app has chosen in its `cloud-files.origin-settings` rows, the lowest `rank` whose interface it can run and whose credential it holds, and names the ones it skipped with the reason. An origin row describes a vendor's storage (interface, price, credential names); which origins an app uses, in what order and for what, is that app's own DATA. Adding a vendor is one row; the host code names shapes (interface), never vendors.",
        "credential_contract": "credential names vault secrets by name only (secret_name); the value is placed by the credentials vault at request time and never appears in DATA, source, argv, environment or logs.",
        "settings_contract": "Which origins an app keeps its files in, in what order (`rank`), what each is for (`label`, `role`), and which bucket or account it uses (`settings`) is that app's own DATA: a `cloud-files.origin-settings` row in its package set, joined to an origin by origin_id. An origin row never names an app."
      }
    },
    {
      "type": "record",
      "address": "package::cloud-files::origin::backblaze-b2",
      "address_mode": "identity_text",
      "path": [
        "current-item",
