    {
      "type": "record",
      "address": "package::cloud-files::contract::origin-protection-profile",
      "address_mode": "identity_text",
      "path": [
        "current-item",
        "published-record"
      ],
      "payload": {
        "kind": "package-record-contract",
        "record_kind": "cloud-files.origin-protection-profile",
        "required_fields": [
          "kind",
          "failure_classes",
          "recovery_point_objective",
          "recovery_time_objective",
          "new_cloud_write_backup_policy",
          "resilience_claim_admitted"
        ],
        "optional_fields": [],
        "failure_class_contract": "failure_classes is an open map from a failure class slug to {protection_state, mechanism, candidate_consequence, basis}. protection_state is closed by physics: none, undecided, or protected. mechanism is an open DATA slug naming the protection that exists and is null unless protection_state is protected. A new failure class or a new mechanism is a new key or value, never a code or test change.",
        "objective_contract": "recovery_point_objective and recovery_time_objective are null until a founder statement sets them. Null means undecided, never zero and never a default. A decided value carries its own basis next to itself.",
        "backup_policy_contract": "new_cloud_write_backup_policy says what happens to a byte that exists only in the cloud: {state, policy, basis}. While state is undecided, policy is null and the source copy of any uploaded byte must remain where it is; no cloud-only byte is admitted.",
        "resilience_contract": "resilience_claim_admitted is exactly the predicate that every failure class has protection_state protected. It may not be true while any class is none or undecided. The value is stored for readers and its derivation is enforced by test.",
        "authority_contract": "This record discloses protection state. It authorizes no purchase, selects no provider, admits no replica, parity, snapshot, or backup owner into cloud-files, and creates no spend. Every basis that names a founder statement carries its date inline; every other basis begins with the word undecided.",
        "durability_seam_contract": "This record is origin policy. The optional durability field on live-namespace locator rows is observed per-copy state for one representation. Neither is derived from the other, and a locator claiming a durability better than this profile's protection state is a defect in the locator, not evidence of protection.",
        "placement_contract": "A decision record is one app's choice and lives in that app's package set, never in this package."
      }
