  "summary_rewrites": {
    "exact": {
      "Archive one canonical layout_preset owner record.": "Save a page layout preset.",
      "Write prop:screen_look:name on the screen-look owner.": "Save the selected page look.",
      "Write prop:settings:sidebar_placement on the canonical configuration owner.": "Save where the sidebar goes."
    },
    "prefixes": [
      {
        "prefix": "accept the newest package files",
        "contains": "compute.process",
        "replacement": "Accept package files for the package set you choose."
      },
      {
        "prefix": "publish package material",
        "contains": "compute.process",
        "replacement": "Publish package files."
      },
      {
        "prefix": "publish the hosted public app",
        "contains": "compute.process",
        "replacement": "Publish the hosted Package Store website."
      }
    ],
    "replacements": [
      {
        "pattern": "\\bsigned\\b",
        "flags": "gi",
        "replacement": ""
      },
      {
        "pattern": "\\bpackage material\\b",
        "flags": "gi",
        "replacement": "package files"
      },
      {
        "pattern": "\\bcatalog data\\b",
        "flags": "gi",
        "replacement": "package list"
      },
      {
        "pattern": "\\bcatalog\\b",
        "flags": "gi",
        "replacement": "package list"
      },
      {
        "pattern": "\\bpackage-file metadata\\b",
        "flags": "gi",
        "replacement": "package file details"
      },
      {
        "pattern": "\\bpackage-file approval\\b",
        "flags": "gi",
        "replacement": "approval before adding package files"
      },
      {
        "pattern": "\\bcompute\\.process\\b",
        "flags": "gi",
        "replacement": "visible work step"
      },
      {
        "pattern": "\\bproofs?\\b",
        "flags": "gi",
        "replacement": "records"
      },
      {
        "pattern": "\\bpolicy\\b",
        "flags": "gi",
        "replacement": "rules"
      },
      {
        "pattern": "\\brefs?\\b",
        "flags": "gi",
        "replacement": "records"
      }
    ]
  },
