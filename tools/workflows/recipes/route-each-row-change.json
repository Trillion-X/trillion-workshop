          "uses": [
            {
              "id": "workflow:route-each-row-change:read-one-store",
              "name": "Read the workflow rows of one store whose conditions could keep the change",
              "kind": "workflow",
              "is_active": true,
              "version": 1,
              "steps": [
                {
                  "id": "read",
                  "kind": "ask",
                  "config": {
                    "name": "tool:run-sql-in-my-database",
                    "input": {
                      "credential_name": {
                        "$kind": "binding",
                        "select": {
                          "from": "loop",
                          "path": "store"
                        }
                      },
                      "sql": "WITH fact AS (SELECT $1::text AS place, $2::text AS change, $3::text AS \"where\", CASE WHEN jsonb_typeof(nullif($4::text, '')::jsonb) = 'array' THEN nullif($4::text, '')::jsonb ELSE '[]'::jsonb END AS kinds),\nconditions AS (\n  SELECT r.recipe, r.definition, c.value AS c, c.ordinality AS n\n  FROM workflow_recipes r CROSS JOIN LATERAL jsonb_array_elements(CASE WHEN jsonb_typeof(r.fires_when) = 'array' THEN r.fires_when ELSE '[]'::jsonb END) WITH ORDINALITY c),\ncan_hold AS (\n  SELECT k.* FROM conditions k, fact f\n  WHERE NOT EXISTS (\n    SELECT 1\n    FROM jsonb_array_elements(CASE WHEN k.c #>> '{condition,tree,kind}' = 'group' AND k.c #>> '{condition,tree,combinator}' = 'and' AND coalesce(k.c #>> '{condition,tree,negate}', 'false') = 'false' AND jsonb_typeof(k.c #> '{condition,tree,rules}') = 'array' THEN k.c #> '{condition,tree,rules}' ELSE '[]'::jsonb END) rule\n    JOIN jsonb_array_elements(CASE WHEN jsonb_typeof(k.c #> '{condition,fields}') = 'array' THEN k.c #> '{condition,fields}' ELSE '[]'::jsonb END) field ON field ->> 'id' = rule ->> 'field'\n    WHERE rule ->> 'kind' = 'rule' AND jsonb_typeof(rule #> '{params,values}') = 'array'\n      AND CASE coalesce(field -> 'path', jsonb_build_array(field -> 'id'))\n        WHEN '[\"place\"]' THEN rule ->> 'operator' = 'is_any_of' AND NOT coalesce(rule #> '{params,values}' ? f.place, false)\n        WHEN '[\"change\"]' THEN rule ->> 'operator' = 'is_any_of' AND NOT coalesce(rule #> '{params,values}' ? f.change, false)\n        WHEN '[\"where\"]' THEN rule ->> 'operator' = 'is_any_of' AND NOT coalesce(rule #> '{params,values}' ? f.\"where\", false)\n        WHEN '[\"kinds\"]' THEN rule ->> 'operator' = 'has_any_of' AND NOT (rule #> '{params,values}' ?| ARRAY(SELECT jsonb_array_elements_text(f.kinds)))\n        ELSE false END))\nSELECT recipe AS id, jsonb_strip_nulls(jsonb_build_object('recipe', recipe,\n  'fires_when', jsonb_agg(jsonb_strip_nulls(jsonb_build_object('label', c -> 'label', 'condition', c -> 'condition', 'made_by', c -> 'made_by', 'state', c -> 'state', 'weight', c -> 'weight', 'input', c -> 'input')) ORDER BY n),\n  'kept_in', CASE WHEN jsonb_typeof(min(definition::text)::jsonb) = 'object' THEN $5::text END)) AS value\nFROM can_hold GROUP BY recipe ORDER BY recipe",
