              "id": "workflow:route-each-row-change:read-one-store",
              "name": "Read the workflow rows of one store whose conditions could keep the change",
              "kind": "workflow",
              "is_active": true,
              "version": 1,
              "steps": [
                {
                  "id": "read",
                  "kind": "ask",
                  "config": {
                    "name": "tool:run-sql-in-my-database",
                    "input": {
                      "credential_name": {
                        "$kind": "binding",
                        "select": {
                          "from": "loop",
                          "path": "store"
                        }
                      },
                      "sql": "WITH part AS (SELECT jsonb_build_object('place', $1::text, 'change', $2::text, 'where', $3::text, 'kinds', nullif($4::text, '')::jsonb, 'after', nullif($6::text, '')::jsonb) AS p),\nconditions AS (\n  SELECT r.recipe, r.definition, c.value AS c, c.ordinality AS n\n  FROM workflow_recipes r CROSS JOIN LATERAL jsonb_array_elements(CASE WHEN jsonb_typeof(r.fires_when) = 'array' THEN r.fires_when ELSE '[]'::jsonb END) WITH ORDINALITY c),\njudged AS (\n  SELECT k.recipe, k.definition, k.c, k.n, k.c #>> '{condition,tree,combinator}' AS combinator, array_agg(m.misses) FILTER (WHERE m.misses IS NOT NULL) AS misses\n  FROM conditions k\n  LEFT JOIN LATERAL (\n    SELECT CASE\n      WHEN rule ->> 'kind' IS DISTINCT FROM 'rule' OR coalesce(rule ->> 'negate', 'false') <> 'false' OR field IS NULL OR path[1] = 'before' THEN false\n      WHEN rule ->> 'operator' = 'is_any_of' AND field ->> 'kind' = 'choice' AND jsonb_typeof(rule #> '{params,values}') = 'array'\n        THEN coalesce(jsonb_typeof(v), 'null') IN ('string', 'number', 'boolean', 'null') AND NOT rule #> '{params,values}' @> jsonb_build_array(coalesce(v, 'null'::jsonb))\n      WHEN rule ->> 'operator' = 'has_any_of' AND field ->> 'kind' = 'tags' AND jsonb_typeof(rule #> '{params,values}') = 'array'\n        THEN coalesce(jsonb_typeof(v), 'null') IN ('null', 'string')\n          OR (jsonb_typeof(v) = 'array' AND NOT EXISTS (SELECT 1 FROM jsonb_array_elements(v) e WHERE jsonb_typeof(e) <> 'string' OR rule #> '{params,values}' @> jsonb_build_array(e)))\n      WHEN rule ->> 'operator' = 'is_not_empty' AND field ->> 'kind' IN ('text', 'tags', 'choice')\n        THEN v IS NULL OR v IN ('null'::jsonb, '\"\"'::jsonb, '[]'::jsonb)\n      ELSE false END AS misses\n    FROM jsonb_array_elements(CASE WHEN k.c #>> '{condition,tree,kind}' = 'group' AND coalesce(k.c #>> '{condition,tree,negate}', 'false') = 'false' AND jsonb_typeof(k.c #> '{condition,tree,rules}') = 'array' THEN k.c #> '{condition,tree,rules}' ELSE '[]'::jsonb END) rule\n    LEFT JOIN LATERAL (SELECT f FROM jsonb_array_elements(CASE WHEN jsonb_typeof(k.c #> '{condition,fields}') = 'array' THEN k.c #> '{condition,fields}' ELSE '[]'::jsonb END) f WHERE f ->> 'id' = rule ->> 'field' LIMIT 1) fd(field) ON true\n    CROSS JOIN LATERAL (SELECT ARRAY(SELECT jsonb_array_elements_text(CASE WHEN jsonb_typeof(field -> 'path') = 'array' THEN field -> 'path' ELSE jsonb_build_array(field ->> 'id') END)) AS path) pa\n    CROSS JOIN LATERAL (SELECT (SELECT p FROM part) #> pa.path AS v) va) m ON true\n  GROUP BY k.recipe, k.definition, k.c, k.n),\ncan_hold AS (\n  SELECT * FROM judged\n  WHERE NOT ((combinator = 'and' AND true = ANY(coalesce(misses, '{}'))) OR (combinator = 'or' AND cardinality(coalesce(misses, '{}')) > 0 AND false <> ALL(misses))))\nSELECT recipe AS id, jsonb_strip_nulls(jsonb_build_object('recipe', recipe,\n  'fires_when', jsonb_agg(jsonb_strip_nulls(jsonb_build_object('label', c -> 'label', 'condition', c -> 'condition', 'made_by', c -> 'made_by', 'state', c -> 'state', 'weight', c -> 'weight', 'input', c -> 'input')) ORDER BY n),\n  'kept_in', CASE WHEN jsonb_typeof(min(definition::text)::jsonb) = 'object' THEN $5::text END)) AS value\nFROM can_hold GROUP BY recipe ORDER BY recipe",
                      "params": [
