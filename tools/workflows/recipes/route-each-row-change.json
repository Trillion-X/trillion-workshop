{
  "_what": "One workflow every change the person's store tells wakes. Whatever tells a change (a Postgres table the person's AI attached record_row_change() to, read by the noticer; or any store the person's AI taught to tell its changes, workflow:tell-me-when-something-changes) tells a row-changes fact that carries the change itself: where (the vault name of what is watched), table_name (what changed, in the store's own name), op, at, key (the change's own key in the store's words), and before and after as JSON text when each fits a fact field. This run makes the change one part, asks tool:choose-the-workflows-that-fire which workflows' fires_when conditions keep that part, and tells one workflow-chosen fact for each choice {workflow, condition, where, table_name, op, key, before, after}. It reads nothing from any store and names no reader tool: a fact is at most 8 text fields of 1,024 bytes (the engine's fact inbox, src/wake/host-events.json), so a change too big to carry arrives without before or after, and a chosen workflow that needs them reads them by key in the store's own language. It starts no workflow itself: each chosen workflow starts from its own wake on that fact, under its own switch and its own rights, with the input its condition names. The event id is the change's own key plus the workflow and the condition, so a retried run tells each choice once.",
  "records": [
    {
      "payload": {
        "kind": "workflow-recipe",
        "id": "workflow:route-each-row-change",
        "label": "Tell the workflows a row change calls for",
        "job": "When a row of the person's own database is added, changed or removed, tell every workflow whose conditions say it follows that kind of change, so each starts from its own wake with that change",
        "produces": "one workflow-chosen fact for each workflow a row change calls for",
        "input_schema": {
          "type": "object",
          "properties": {
            "fact": {
              "type": "object",
              "description": "The row-changes fact that woke this run: where, table_name, op, at, key, and before and after as JSON text when they fit"
            }
          }
        },
        "wakes": [
          {
            "id": "a-row-changed",
            "on": {
              "fact": {
                "kind": "row-changes",
                "from": [
                  "run"
                ]
              }
            },
            "budget": {
              "steps": 4,
              "wall_ms": 300000
            },
            "input": {
              "start_at": "choose"
            }
          }
        ],
        "definition": {
          "id": "workflow:route-each-row-change",
          "name": "Tell the workflows a row change calls for",
          "kind": "workflow",
          "is_active": true,
          "version": 1,
          "steps": [
            {
              "id": "choose",
              "kind": "ask",
              "config": {
                "name": "tool:choose-the-workflows-that-fire",
                "input": {
                  "parts": [
                    {
                      "where": {
                        "$kind": "binding",
                        "select": {
                          "from": "input",
                          "path": "fact.where"
                        }
                      },
                      "table_name": {
                        "$kind": "binding",
                        "select": {
                          "from": "input",
                          "path": "fact.table_name"
                        }
                      },
                      "op": {
                        "$kind": "binding",
                        "select": {
                          "from": "input",
                          "path": "fact.op"
                        }
                      },
                      "before": {
                        "$kind": "binding",
                        "select": {
                          "from": "input",
                          "path": "fact.before"
                        },
                        "transform": [
                          {
                            "op": "op:core.json_parse"
                          }
                        ]
                      },
                      "after": {
                        "$kind": "binding",
                        "select": {
                          "from": "input",
                          "path": "fact.after"
                        },
                        "transform": [
                          {
                            "op": "op:core.json_parse"
                          }
                        ]
                      }
                    }
                  ],
                  "within": [
                    "workflow:route-each-row-change"
                  ]
                }
              }
            },
            {
              "id": "start-each",
              "kind": "loop",
              "config": {
                "source": {
                  "$kind": "binding",
                  "select": {
                    "from": "steps",
                    "key": "choose",
                    "path": "output.chosen"
                  }
                },
                "item_var": "chosen",
                "definition_id": "workflow:route-each-row-change:tell-one",
                "parallel": true
              }
            }
          ],
          "edges": [
            {
              "from": "choose",
              "to": "start-each",
              "kind": "always"
            }
          ],
          "uses": [
            {
              "id": "workflow:route-each-row-change:tell-one",
              "name": "Tell that one chosen workflow its change",
              "kind": "workflow",
              "is_active": true,
              "version": 1,
              "steps": [
                {
                  "id": "tell",
                  "kind": "ask",
                  "config": {
                    "name": "wake:arrive",
                    "input": {
                      "kind": "workflow-chosen",
                      "event_id": {
                        "$kind": "binding",
                        "select": {
                          "from": "input",
                          "path": "fact.key"
                        },
                        "resolve_nested_bindings": true,
                        "transform": [
                          {
                            "op": "op:core.concat",
                            "args": {
                              "values": [
                                {
                                  "$kind": "binding",
                                  "select": {
                                    "from": "input",
                                    "path": "fact.key"
                                  }
                                },
                                ":",
                                {
                                  "$kind": "binding",
                                  "select": {
                                    "from": "loop",
                                    "path": "chosen.workflow"
                                  }
                                },
                                ":",
                                {
                                  "$kind": "binding",
                                  "select": {
                                    "from": "loop",
                                    "path": "chosen.condition"
                                  }
                                }
                              ]
                            }
                          }
                        ]
                      },
                      "payload": {
                        "workflow": {
                          "$kind": "binding",
                          "select": {
                            "from": "loop",
                            "path": "chosen.workflow"
                          }
                        },
                        "condition": {
                          "$kind": "binding",
                          "select": {
                            "from": "loop",
                            "path": "chosen.condition"
                          }
                        },
                        "where": {
                          "$kind": "binding",
                          "select": {
                            "from": "input",
                            "path": "fact.where"
                          }
                        },
                        "table_name": {
                          "$kind": "binding",
                          "select": {
                            "from": "input",
                            "path": "fact.table_name"
                          }
                        },
                        "op": {
                          "$kind": "binding",
                          "select": {
                            "from": "input",
                            "path": "fact.op"
                          }
                        },
                        "key": {
                          "$kind": "binding",
                          "select": {
                            "from": "input",
                            "path": "fact.key"
                          }
                        },
                        "before": {
                          "$kind": "binding",
                          "select": {
                            "from": "input",
                            "path": "fact.before"
                          }
                        },
                        "after": {
                          "$kind": "binding",
                          "select": {
                            "from": "input",
                            "path": "fact.after"
                          }
                        }
                      }
                    }
                  }
                }
              ],
              "edges": []
            }
          ]
        },
        "records": {
          "rights": [
            {
              "at": "@own-records",
              "id": "workflow-chosen",
              "operations": [
                "wake:arrive"
              ]
            }
          ],
          "runs": [
            "tool:choose-the-workflows-that-fire"
          ]
        }
      }
    }
  ]
}
