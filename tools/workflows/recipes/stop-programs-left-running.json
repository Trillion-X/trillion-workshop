{
  "_what": "Stops the programs a session that ended left running, judged only by the person's own rule rows, every ten minutes. Made for the case of Nov 19 2026: eight shells a closed session left behind ran a test loop at full speed for two days, the computer's load stayed far above what it could take, and every check before a push timed out. The workflow names no program: what counts as left behind and what is never stopped are rows of the person's own store (table program_rules, kind left-behind or never-stop), read at every sweep; a store with no never-stop row refuses the sweep. The first two steps make the two tables it keeps (program_rules, program_stops) with create table if not exists in the store's own language (PostgreSQL), so a store that has neither works from its first sweep. Their names are fixed in the SQL, not taken from input: a table name cannot be a statement parameter, and building it into the text from input would let the input change the statement.",
  "records": [
    {
      "payload": {
        "kind": "workflow-recipe",
        "id": "workflow:stop-programs-left-running",
        "label": "Stop programs left running",
        "job": "Every ten minutes, find the programs a session that ended left running on this computer, by the person's own left-behind rows and never-stop rows, ask each to end, keep one row per stop and tell the person once per sweep that stopped anything.",
        "produces": "One program_stops row per program asked to end (what, which row and why, when it was asked, when it ended, and its outcome), and at most one notice per sweep, only when a program ended.",
        "input_schema": {
          "type": "object",
          "required": [
            "store"
          ],
          "properties": {
            "store": {
              "type": "object",
              "required": [
                "where",
                "language",
                "credential_name"
              ],
              "properties": {
                "where": {
                  "type": "string",
                  "description": "Where the person keeps their rule rows and stop rows: the store's own address"
                },
                "language": {
                  "type": "string",
                  "description": "How that store is spoken to, in its own terms"
                },
                "credential_name": {
                  "type": "string",
                  "description": "The vault name of the login the run uses to read the rules and write the stops"
                }
              }
            }
          }
        },
        "wakes": [
          {
            "id": "every-ten-minutes",
            "on": {
              "fact": {
                "kind": "due-time",
                "from": [
                  "run"
                ],
                "match": {
                  "schedule_id": "schedule:workflow:stop-programs-left-running:every-ten-minutes"
                },
                "watch": {
                  "schedules": [
                    {
                      "schedule_id": "schedule:workflow:stop-programs-left-running:every-ten-minutes",
                      "source_generation": 1,
                      "schedule_revision": 1,
                      "timezone": "UTC",
                      "start_local_date": "1970-01-01",
                      "local_window": {
                        "start": "00:00",
                        "duration_minutes": 1
                      },
                      "dst": {
                        "gap": "next-valid",
                        "fold": "earlier"
                      },
                      "action": {
                        "operation": "tell-the-engine",
                        "owner_ref": "workflow:stop-programs-left-running",
                        "owner_dispatch": {
                          "name": "workflow:stop-programs-left-running",
                          "input": {}
                        },
                        "completion": {
                          "mode": "synchronous-owner-return"
                        }
                      },
                      "cadence": {
                        "unit": "minute",
                        "interval": 10
                      }
                    }
                  ]
                }
              }
            },
            "budget": {
              "steps": 60,
              "wall_ms": 300000
            },
            "input": {
              "start_at": "make-rules-table"
            }
          }
        ],
        "definition": {
          "id": "workflow:stop-programs-left-running",
          "name": "Stop programs left running",
          "kind": "workflow",
          "is_active": true,
          "version": 1,
          "steps": [
            {
              "id": "make-rules-table",
              "kind": "ask",
              "config": {
                "name": "tool:run-sql-in-my-database",
                "input": {
                  "credential_name": {
                    "$kind": "binding",
                    "select": {
                      "from": "input",
                      "path": "store.credential_name"
                    }
                  },
                  "sql": "create table if not exists program_rules (id text primary key, kind text not null check (kind in ('left-behind', 'never-stop')), rule jsonb not null)"
                },
                "context": {
                  "step_id": "make-rules-table"
                }
              }
            },
            {
              "id": "make-stops-table",
              "kind": "ask",
              "config": {
                "name": "tool:run-sql-in-my-database",
                "input": {
                  "credential_name": {
                    "$kind": "binding",
                    "select": {
                      "from": "input",
                      "path": "store.credential_name"
                    }
                  },
                  "sql": "create table if not exists program_stops (address text primary key, stop jsonb not null, kept_at timestamptz not null default now())"
                },
                "context": {
                  "step_id": "make-stops-table"
                }
              }
            },
            {
              "id": "list",
              "kind": "ask",
              "config": {
                "name": "tool:list-running-programs",
                "input": {
                  "most": 2000,
                  "commands": true
                },
                "context": {
                  "step_id": "list"
                }
              }
            },
            {
              "id": "read-left-behind",
              "kind": "ask",
              "config": {
                "name": "tool:run-sql-in-my-database",
                "input": {
                  "credential_name": {
                    "$kind": "binding",
                    "select": {
                      "from": "input",
                      "path": "store.credential_name"
                    }
                  },
                  "sql": "select jsonb_agg(rule order by id) as rules from program_rules where kind = $1",
                  "params": [
                    "left-behind"
                  ]
                },
                "context": {
                  "step_id": "read-left-behind"
                }
              }
            },
            {
              "id": "read-never-stop",
              "kind": "ask",
              "config": {
                "name": "tool:run-sql-in-my-database",
                "input": {
                  "credential_name": {
                    "$kind": "binding",
                    "select": {
                      "from": "input",
                      "path": "store.credential_name"
                    }
                  },
                  "sql": "select jsonb_agg(rule order by id) as rules from program_rules where kind = $1",
                  "params": [
                    "never-stop"
                  ]
                },
                "context": {
                  "step_id": "read-never-stop"
                }
              }
            },
            {
              "id": "choose",
              "kind": "ask",
              "config": {
                "name": "tool:choose-programs-left-running",
                "input": {
                  "programs": {
                    "$kind": "binding",
                    "select": {
                      "from": "steps",
                      "key": "list",
                      "path": "output.programs"
                    }
                  },
                  "complete": {
                    "$kind": "binding",
                    "select": {
                      "from": "steps",
                      "key": "list",
                      "path": "output.complete"
                    }
                  },
                  "left_behind": {
                    "$kind": "binding",
                    "select": {
                      "from": "steps",
                      "key": "read-left-behind",
                      "path": "output.rows.0.rules"
                    }
                  },
                  "never_stop": {
                    "$kind": "binding",
                    "select": {
                      "from": "steps",
                      "key": "read-never-stop",
                      "path": "output.rows.0.rules"
                    }
                  }
                },
                "context": {
                  "step_id": "choose"
                }
              }
            },
            {
              "id": "stop",
              "kind": "ask",
              "config": {
                "name": "tool:stop-programs-left-running",
                "input": {
                  "programs": {
                    "$kind": "binding",
                    "select": {
                      "from": "steps",
                      "key": "choose",
                      "path": "output.picked"
                    }
                  }
                },
                "context": {
                  "step_id": "stop"
                }
              }
            },
            {
              "id": "keep-each",
              "kind": "loop",
              "config": {
                "source": {
                  "$kind": "binding",
                  "select": {
                    "from": "steps",
                    "key": "stop",
                    "path": "output.stops"
                  }
                },
                "item_var": "stop",
                "definition_id": "workflow:stop-programs-left-running:keep-one",
                "parallel": false
              }
            },
            {
              "id": "tell",
              "kind": "loop",
              "config": {
                "source": {
                  "$kind": "binding",
                  "select": {
                    "from": "steps",
                    "key": "stop",
                    "path": "output.notices"
                  }
                },
                "item_var": "notice",
                "definition_id": "workflow:stop-programs-left-running:tell-one",
                "parallel": false
              }
            }
          ],
          "edges": [
            {
              "from": "make-rules-table",
              "to": "make-stops-table",
              "kind": "always"
            },
            {
              "from": "make-stops-table",
              "to": "list",
              "kind": "always"
            },
            {
              "from": "list",
              "to": "read-left-behind",
              "kind": "always"
            },
            {
              "from": "read-left-behind",
              "to": "read-never-stop",
              "kind": "always"
            },
            {
              "from": "read-never-stop",
              "to": "choose",
              "kind": "always"
            },
            {
              "from": "choose",
              "to": "stop",
              "kind": "always"
            },
            {
              "from": "stop",
              "to": "keep-each",
              "kind": "always"
            },
            {
              "from": "keep-each",
              "to": "tell",
              "kind": "always"
            }
          ],
          "uses": [
            {
              "id": "workflow:stop-programs-left-running:keep-one",
              "name": "Keep one stop",
              "kind": "workflow",
              "is_active": true,
              "version": 1,
              "steps": [
                {
                  "id": "keep",
                  "kind": "ask",
                  "config": {
                    "name": "tool:run-sql-in-my-database",
                    "input": {
                      "credential_name": {
                        "$kind": "binding",
                        "select": {
                          "from": "input",
                          "path": "store.credential_name"
                        }
                      },
                      "sql": "insert into program_stops (address, stop) values ($1, $2::jsonb) on conflict (address) do nothing",
                      "params": [
                        {
                          "$kind": "binding",
                          "select": {
                            "from": "loop",
                            "path": "stop.address"
                          }
                        },
                        {
                          "$kind": "binding",
                          "select": {
                            "from": "loop",
                            "path": "stop"
                          }
                        }
                      ]
                    },
                    "context": {
                      "step_id": "keep"
                    }
                  }
                }
              ],
              "edges": []
            },
            {
              "id": "workflow:stop-programs-left-running:tell-one",
              "name": "Tell the sweep",
              "kind": "workflow",
              "is_active": true,
              "version": 1,
              "steps": [
                {
                  "id": "make-devices",
                  "kind": "ask",
                  "config": {
                    "name": "tool:run-sql-in-my-database",
                    "input": {
                      "credential_name": {
                        "$kind": "binding",
                        "select": {
                          "from": "input",
                          "path": "store.credential_name"
                        }
                      },
                      "sql": "create table if not exists devices (id text primary key, platform text not null check (platform in ('live', 'web-push', 'apns')), token text, app_build text, registered_at timestamptz not null default now(), last_seen_at timestamptz not null default now())"
                    },
                    "context": {
                      "step_id": "make-devices"
                    }
                  }
                },
                {
                  "id": "make-notices",
                  "kind": "ask",
                  "config": {
                    "name": "tool:run-sql-in-my-database",
                    "input": {
                      "credential_name": {
                        "$kind": "binding",
                        "select": {
                          "from": "input",
                          "path": "store.credential_name"
                        }
                      },
                      "sql": "create table if not exists notices (id bigint generated always as identity primary key, device_id text references devices (id), title text not null default '', body text not null default '', url text, made_at timestamptz not null default now(), read_at timestamptz, acted_at timestamptz)"
                    },
                    "context": {
                      "step_id": "make-notices"
                    }
                  }
                },
                {
                  "id": "widen-notices",
                  "kind": "ask",
                  "config": {
                    "name": "tool:run-sql-in-my-database",
                    "input": {
                      "credential_name": {
                        "$kind": "binding",
                        "select": {
                          "from": "input",
                          "path": "store.credential_name"
                        }
                      },
                      "sql": "alter table notices add column if not exists kind text, add column if not exists key text"
                    },
                    "context": {
                      "step_id": "widen-notices"
                    }
                  }
                },
                {
                  "id": "tell",
                  "kind": "ask",
                  "config": {
                    "name": "tool:run-sql-in-my-database",
                    "input": {
                      "credential_name": {
                        "$kind": "binding",
                        "select": {
                          "from": "input",
                          "path": "store.credential_name"
                        }
                      },
                      "sql": "insert into notices (title, body, kind, key) select coalesce($2::text, ''), coalesce($3::text, ''), $1::text, $4::text where $4::text is null or not exists (select 1 from notices where key = $4::text)",
                      "params": [
                        {
                          "$kind": "binding",
                          "select": {
                            "from": "loop",
                            "path": "notice.kind"
                          }
                        },
                        {
                          "$kind": "binding",
                          "select": {
                            "from": "loop",
                            "path": "notice.title"
                          }
                        },
                        {
                          "$kind": "binding",
                          "select": {
                            "from": "loop",
                            "path": "notice.body"
                          }
                        },
                        {
                          "$kind": "binding",
                          "select": {
                            "from": "loop",
                            "path": "notice.key"
                          }
                        }
                      ]
                    },
                    "context": {
                      "step_id": "tell"
                    }
                  }
                }
              ],
              "edges": [
                {
                  "from": "make-devices",
                  "to": "make-notices",
                  "kind": "always"
                },
                {
                  "from": "make-notices",
                  "to": "widen-notices",
                  "kind": "always"
                },
                {
                  "from": "widen-notices",
                  "to": "tell",
                  "kind": "always"
                }
              ]
            }
          ]
        },
        "records": {
          "runs": [
            "tool:choose-programs-left-running",
            "tool:list-running-programs",
            "tool:run-sql-in-my-database",
            "tool:stop-programs-left-running"
          ]
        }
      }
    }
  ]
}
