                                "minLength": 1,
                                "pattern": "\\S"
                              },
                              "included": {
                                "type": "string",
                                "minLength": 1,
                                "pattern": "\\S"
                              },
                              "ends_when": {
                                "type": "string",
                                "minLength": 1,
                                "pattern": "\\S"
                              },
                              "one_time_price_minor": {
