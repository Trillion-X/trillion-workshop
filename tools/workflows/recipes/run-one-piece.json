                        },
                        {
                          "$kind": "binding",
                          "select": {
                            "from": "input",
                            "path": "fact.piece"
                          }
                        },
                        {
                          "$kind": "binding",
                          "select": {
                            "from": "loop",
                            "path": "chosen.workflow"
                          }
                        },
                        {
                          "$kind": "binding",
                          "select": {
                            "from": "input",
                            "path": "fact.event_id"
                          }
                        },
                        {
                          "$kind": "binding",
                          "select": {
                            "from": "input",
                            "path": "fact.event_id"
                          }
                        }
                      ],
                      "credential_name": {
