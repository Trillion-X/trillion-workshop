          ],
          "edges": [
            {
              "to": "choose",
              "from": "read-candidates",
              "kind": "always"
            },
            {
              "to": "start-each",
              "from": "choose",
              "kind": "always"
            }
          ],
          "steps": [
            {
              "id": "read-candidates",
              "kind": "ask",
              "config": {
                "name": "tool:run-sql-in-my-database",
                "input": {
                  "sql": "WITH c AS (\n  SELECT w.recipe, e.value AS cond\n  FROM workflow_recipes w CROSS JOIN LATERAL jsonb_array_elements(CASE WHEN jsonb_typeof(w.fires_when) = 'array' THEN w.fires_when ELSE '[]'::jsonb END) e\n  WHERE w.fires_when IS NOT NULL),\nkept AS (\n  SELECT recipe, cond FROM c\n  WHERE EXISTS (SELECT 1 FROM jsonb_array_elements(coalesce(cond #> '{condition,fields}', '[]'::jsonb)) f WHERE coalesce(f -> 'path', jsonb_build_array(f -> 'id')) <> '[\"kinds\"]'::jsonb)\n     OR EXISTS (SELECT 1 FROM jsonb_path_query(cond, 'strict $.condition.tree.** ? (@.field == \"kinds\").params.values[*]') v WHERE v #>> '{}' IN (SELECT jsonb_array_elements_text(coalesce(nullif($1::text, '')::jsonb, '[]'::jsonb))))\n     OR jsonb_array_length(coalesce(cond #> '{condition,fields}', '[]'::jsonb)) = 0)\nSELECT recipe AS id, jsonb_build_object('recipe', recipe, 'fires_when', jsonb_agg(jsonb_strip_nulls(jsonb_build_object('label', cond->'label', 'condition', cond->'condition', 'made_by', cond->'made_by', 'state', cond->'state', 'weight', cond->'weight', 'input', cond->'input')))) AS value\nFROM kept GROUP BY recipe\n",
                  "params": [
                    {
                      "$kind": "binding",
                      "select": {
                        "from": "input",
                        "path": "fact.branch_kinds"
                      }
                    }
                  ],
                  "credential_name": {
                    "$kind": "binding",
                    "select": {
                      "from": "input",
                      "path": "store.credential_name"
                    }
                  }
                },
                "context": {
                  "step_id": "read-candidates"
                }
              }
            },
            {
              "id": "choose",
              "kind": "ask",
              "config": {
                "name": "tool:choose-the-workflows-that-fire",
                "input": {
                  "own": {
                    "$kind": "binding",
                    "select": {
                      "key": "read-candidates",
                      "from": "steps",
                      "path": "output.rows"
                    }
                  },
                  "parts": [
                    {
                      "kinds": {
                        "$kind": "binding",
                        "select": {
                          "from": "input",
                          "path": "fact.branch_kinds"
                        },
                        "transform": [
                          {
                            "op": "op:core.json_parse"
                          }
                        ]
                      },
                      "piece": {
                        "$kind": "binding",
                        "select": {
