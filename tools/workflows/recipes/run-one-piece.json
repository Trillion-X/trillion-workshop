                  "kind": "ask",
                  "config": {
                    "name": "tool:run-sql-in-my-database",
                    "input": {
                      "sql": "INSERT INTO piece_citations (product_id, piece, chosen_workflow, run_ref, output_ref) VALUES ($1::text, $2::text, $3::text, $4::text, $5::text) ON CONFLICT (run_ref, chosen_workflow) DO NOTHING",
                      "params": [
                        {
                          "$kind": "binding",
                          "select": {
                            "from": "input",
                            "path": "fact.product_key"
