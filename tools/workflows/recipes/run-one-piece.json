          "version": 1,
          "is_active": false
        },
        "wakes": [
          {
            "id": "a-piece-to-run",
            "on": {
              "fact": {
                "from": [
                  "run"
                ],
                "kind": "piece-to-run"
              }
            },
            "budget": {
              "steps": 60,
              "wall_ms": 600000
            },
            "input": {
              "start_at": "read-candidates"
            }
          }
        ],
        "fires_when": []
      }
    }
