                        }
                      }
                    },
                    "context": {
                      "step_id": "read-definition"
                    }
                  }
                },
                {
                  "id": "tell",
                  "kind": "ask",
                  "config": {
                    "name": "wake:arrive",
                    "input": {
                      "kind": "workflow-chosen-from-rows",
                      "payload": {
                        "piece": {
                          "$kind": "binding",
                          "select": {
                            "from": "input",
                            "path": "fact.piece"
                          }
                        },
                        "kept_at": {
                          "$kind": "binding",
                          "select": {
                            "key": "read-definition",
                            "from": "steps",
                            "path": "output.rows.0.kept_at"
                          }
                        },
                        "kept_in": {
                          "$kind": "binding",
                          "select": {
                            "key": "read-definition",
                            "from": "steps",
                            "path": "output.rows.0.kept_in"
                          }
                        },
                        "workflow": {
                          "$kind": "binding",
                          "select": {
                            "from": "loop",
                            "path": "chosen.workflow"
                          }
                        },
                        "condition": {
                          "$kind": "binding",
                          "select": {
                            "from": "loop",
                            "path": "chosen.condition"
                          }
                        },
                        "product_key": {
                          "$kind": "binding",
                          "select": {
                            "from": "input",
                            "path": "fact.product_key"
                          }
                        }
                      },
                      "event_id": {
                        "$kind": "binding",
                        "select": {
                          "from": "input",
