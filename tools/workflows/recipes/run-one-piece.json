                          "path": "fact.piece"
                        }
                      },
                      "place": "product-piece",
                      "words": {
                        "$kind": "binding",
                        "select": {
                          "from": "input",
                          "path": "fact.words"
                        }
                      },
                      "product_key": {
                        "$kind": "binding",
                        "select": {
                          "from": "input",
                          "path": "fact.product_key"
                        }
                      }
                    }
                  ],
                  "within": [
                    "workflow:run-one-piece"
                  ],
                  "installed": true
                },
                "context": {
                  "step_id": "choose"
                }
              }
            },
            {
              "id": "start-each",
              "kind": "loop",
              "config": {
                "source": {
                  "$kind": "binding",
                  "select": {
                    "key": "choose",
                    "from": "steps",
                    "path": "output.chosen"
                  }
                },
                "item_var": "chosen",
                "parallel": true,
                "definition_id": "workflow:run-one-piece:start-one-chosen"
              }
            }
          ],
          "wakes": [
            {
              "id": "a-piece-to-run",
              "on": {
