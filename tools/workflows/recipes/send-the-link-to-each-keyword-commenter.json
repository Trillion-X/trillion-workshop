              "id": "read",
              "kind": "ask",
              "config": {
                "name": "tool:run-a-composio-action",
                "input": {
                  "proxy": {
                    "method": "GET",
                    "endpoint": {
                      "$kind": "binding",
                      "select": {
                        "from": "input",
                        "path": "account.media_endpoint"
                      }
                    },
                    "parameters": [
                      {
                        "name": "fields",
                        "type": "query",
                        "value": "id,timestamp,comments.limit(100){id,text,username,timestamp,from}"
                      },
                      {
                        "name": "limit",
                        "type": "query",
                        "value": "10"
