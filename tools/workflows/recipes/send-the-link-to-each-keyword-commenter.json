                      "sql": "UPDATE replies_kept SET state = CASE WHEN $2 <> '' THEN 'sent' ELSE 'failed' END, sent_at = now(), answer = jsonb_build_object('message_id', $2), links = $3::jsonb WHERE comment_id = $1 RETURNING comment_id, state",
                      "params": [
