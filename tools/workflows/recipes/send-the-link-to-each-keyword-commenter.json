                    "$kind": "binding",
                    "select": {
                      "key": "who",
                      "from": "steps",
                      "path": "output.rows.0.composio.project_id"
                    }
                  }
                },
                "context": {
                  "title": "Read up to 100 comments on each of the 10 newest posts",
                  "step_id": "read",
                  "done_when": "data is the list of posts with comments"
                }
              }
            },
            {
              "id": "pick",
              "kind": "ask",
              "config": {
                "name": "tool:run-sql-in-my-database",
                "input": {
                  "sql": "WITH c AS (SELECT cm FROM jsonb_array_elements($1::text::jsonb) m, jsonb_array_elements(coalesce(m->'comments'->'data','[]'::jsonb)) cm),\nx AS (SELECT cm->>'id' AS cid, upper(coalesce(cm->>'text','')) AS t, coalesce(cm->>'username', cm->'from'->>'username') AS u, (cm->>'timestamp')::timestamptz AS ts FROM c),\npick AS (SELECT DISTINCT ON (x.cid) x.cid, x.ts, r.id AS rid FROM x JOIN reply_rules r ON r.enabled = 'on' AND CASE WHEN r.mode = 'all' THEN (SELECT bool_and(x.t ~ ('\\m' || upper(w) || '\\M')) FROM unnest(r.words) w) ELSE (SELECT bool_or(x.t ~ ('\\m' || upper(w) || '\\M')) FROM unnest(r.words) w) END\n  WHERE x.u IS DISTINCT FROM $2 AND x.ts > now() - interval '7 days' AND NOT EXISTS (SELECT 1 FROM replies_kept k WHERE k.comment_id = x.cid) ORDER BY x.cid, r.\"order\"),\nlate AS (UPDATE replies_kept SET state = 'past-7-days' WHERE account = $2 AND state = 'waiting' AND commented_at <= now() - interval '7 days' RETURNING comment_id),\nretry AS (UPDATE replies_kept SET state = 'waiting' WHERE account = $2 AND state IN ('sending','failed') AND sent_at < now() - interval '30 minutes' AND coalesce(tries, 0) < 3 AND commented_at > now() - interval '7 days' RETURNING comment_id),\nqueue AS (SELECT cid, rid, ts FROM pick UNION ALL SELECT comment_id, rule_id, commented_at FROM replies_kept WHERE account = $2 AND state = 'waiting' AND commented_at > now() - interval '7 days'),\nroom AS (SELECT greatest(0, coalesce((SELECT most_per_hour FROM reply_caps WHERE account = $2), 0) - (SELECT count(*) FROM replies_kept k WHERE k.account = $2 AND k.state IN ('sending','sent') AND k.sent_at > now() - interval '1 hour')) AS n),\ngo AS (SELECT cid FROM queue ORDER BY ts, cid LIMIT (SELECT n FROM room)),\nadded AS (INSERT INTO replies_kept (comment_id, rule_id, account, commented_at, state, sent_at, tries)\n  SELECT cid, rid, $2, ts, CASE WHEN cid IN (SELECT cid FROM go) THEN 'sending' ELSE 'waiting' END, CASE WHEN cid IN (SELECT cid FROM go) THEN now() END, CASE WHEN cid IN (SELECT cid FROM go) THEN 1 ELSE 0 END FROM pick\n  ON CONFLICT DO NOTHING RETURNING comment_id, rule_id, state),\nmoved AS (UPDATE replies_kept k SET state = 'sending', sent_at = now(), tries = coalesce(k.tries, 0) + 1 WHERE k.account = $2 AND k.state = 'waiting' AND k.comment_id IN (SELECT cid FROM go) RETURNING k.comment_id, k.rule_id)\nSELECT s.comment_id, s.rule_id, (SELECT reply FROM reply_rules r WHERE r.id = s.rule_id) || CASE WHEN s.delayed THEN coalesce(' ' || (SELECT delay_ack FROM reply_caps WHERE account = $2), '') ELSE '' END AS reply FROM (SELECT comment_id, rule_id, false AS delayed FROM added WHERE state = 'sending' UNION ALL SELECT comment_id, rule_id, true AS delayed FROM moved) s",
                  "params": [
                    {
                      "$kind": "binding",
                      "select": {
                        "key": "read",
                        "from": "steps",
                        "path": "output.data.data"
                      },
                      "transform": [
                        {
                          "op": "op:core.stringify",
                          "args": {
                            "format": "json"
                          }
                        }
                      ]
                    },
                    {
                      "$kind": "binding",
                      "select": {
                        "from": "input",
                        "path": "account.bare"
                      }
                    }
                  ],
                  "credential_name": {
                    "$kind": "binding",
                    "select": {
                      "from": "input",
                      "path": "store.credential_name"
                    }
                  }
                },
                "context": {
                  "title": "Queue each new keyword comment once and take the oldest the hour has room for",
                  "step_id": "pick",
                  "done_when": "every matching comment has a replies_kept row; rows are the oldest waiting comments, at most reply_caps.most_per_hour sent in the last hour (Meta's 750 private replies per hour); the rest stay 'waiting' for the next run; any still waiting 7 days after the comment are marked past-7-days; a comment still 'sending' or 'failed' 30 minutes after its try goes back to waiting, at most 3 tries (Instagram allows one private reply per comment, so a retry never sends twice)"
                }
              }
            },
            {
              "id": "each",
              "kind": "loop",
              "config": {
                "source": {
                  "$kind": "binding",
                  "select": {
                    "key": "pick",
                    "from": "steps",
                    "path": "output.rows"
                  }
                },
                "item_var": "item",
                "definition_id": "workflow:send-the-link-to-each-keyword-commenter#each",
                "max_iterations": 50
              }
            }
          ]
        },
