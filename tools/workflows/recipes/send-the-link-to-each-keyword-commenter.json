          "steps": [
            {
              "id": "who",
              "kind": "ask",
              "config": {
                "name": "tool:run-sql-in-my-database",
                "input": {
                  "sql": "SELECT account, composio FROM posting_rules WHERE account = $1",
                  "params": [
