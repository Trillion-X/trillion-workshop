                "name": "tool:run-sql-in-my-database",
                "input": {
                  "sql": "SELECT r.channel, r.position, r.route_kind, r.tool_or_target, $2::text AS recipient, $3::text AS text, coalesce($4::text, md5($1::text || '|' || coalesce($2::text, '') || '|' || coalesce($3::text, ''))) AS reply_key, coalesce($6::boolean, false) AS dry_run, $7::text AS credential_name, $8::text AS notices_credential FROM send_routes r WHERE r.channel = $1::text AND r.enabled AND r.position >= coalesce($5::int, 1) ORDER BY r.position",
                  "params": [
                    {
                      "$kind": "binding",
                      "select": {
                        "from": "input",
                        "path": "channel"
                      }
                    },
                    {
                      "$kind": "binding",
                      "select": {
                        "from": "input",
                        "path": "to"
                      }
                    },
                    {
                      "$kind": "binding",
                      "select": {
                        "from": "input",
                        "path": "text"
                      }
                    },
                    {
                      "$kind": "binding",
                      "select": {
                        "from": "input",
                        "path": "reply_key"
                      }
                    },
                    {
                      "$kind": "binding",
                      "select": {
                        "from": "input",
                        "path": "start_position"
                      }
                    },
                    {
                      "$kind": "binding",
                      "select": {
                        "from": "input",
                        "path": "dry_run"
                      }
                    },
                    {
                      "$kind": "binding",
                      "select": {
                        "from": "input",
                        "path": "store.credential_name"
                      }
                    },
                    {
                      "$kind": "binding",
                      "select": {
                        "from": "input",
                        "path": "notices_store.credential_name"
                      }
                    }
                  ],
                  "credential_name": {
                    "$kind": "binding",
                    "select": {
                      "from": "input",
                      "path": "store.credential_name"
                    }
                  }
                },
                "context": {
                  "step_id": "plan"
                }
              }
            },
            {
              "id": "attempts",
              "kind": "loop",
              "config": {
                "source": {
                  "$kind": "binding",
                  "select": {
                    "key": "plan",
                    "from": "steps",
                    "path": "output.rows"
                  }
                },
                "item_var": "route",
                "parallel": false,
                "definition_id": "workflow:send-a-reply-through-its-channel:try-one-route"
              }
            },
            {
              "id": "outcome",
              "kind": "ask",
              "config": {
                "name": "tool:run-sql-in-my-database",
                "input": {
                  "sql": "WITH k AS (SELECT coalesce($1::text, md5($2::text || '|' || coalesce($3::text, '') || '|' || coalesce($4::text, ''))) AS reply_key), s AS (SELECT a.tool_or_target FROM send_route_attempts a, k WHERE a.reply_key = k.reply_key AND a.outcome = 'sent' ORDER BY a.id DESC LIMIT 1), l AS (SELECT a.outcome, a.error FROM send_route_attempts a, k WHERE a.reply_key = k.reply_key ORDER BY a.id DESC LIMIT 1) SELECT (SELECT count(*) FROM s) > 0 AND NOT coalesce($5::boolean, false) AS sent, coalesce((SELECT tool_or_target FROM s), '') AS tool, CASE WHEN coalesce($5::boolean, false) THEN 'dry run: nothing sent' WHEN (SELECT count(*) FROM s) > 0 THEN 'sent through ' || (SELECT tool_or_target FROM s) WHEN (SELECT outcome FROM l) = 'handed-to-person' THEN 'handed to the person to send by hand; open until sent' ELSE coalesce(nullif(left((SELECT error FROM l), 300), ''), 'no enabled route for this channel') END AS said",
                  "params": [
                    {
                      "$kind": "binding",
                      "select": {
                        "from": "input",
                        "path": "reply_key"
                      }
                    },
                    {
                      "$kind": "binding",
                      "select": {
                        "from": "input",
                        "path": "channel"
                      }
                    },
                    {
                      "$kind": "binding",
                      "select": {
                        "from": "input",
                        "path": "to"
                      }
                    },
                    {
                      "$kind": "binding",
                      "select": {
                        "from": "input",
                        "path": "text"
                      }
                    },
                    {
                      "$kind": "binding",
                      "select": {
                        "from": "input",
                        "path": "dry_run"
                      }
                    }
                  ],
                  "credential_name": {
                    "$kind": "binding",
                    "select": {
                      "from": "input",
                      "path": "store.credential_name"
                    }
                  }
                },
                "context": {
                  "step_id": "outcome"
                }
              }
            },
            {
              "id": "done",
              "kind": "return",
              "config": {
                "value": {
                  "said": {
                    "$kind": "binding",
                    "select": {
                      "key": "outcome",
                      "from": "steps",
                      "path": "output.rows.0.said"
                    }
                  },
                  "sent": {
                    "$kind": "binding",
                    "select": {
                      "key": "outcome",
                      "from": "steps",
                      "path": "output.rows.0.sent"
                    }
                  },
                  "tool": {
                    "$kind": "binding",
                    "select": {
                      "key": "outcome",
                      "from": "steps",
                      "path": "output.rows.0.tool"
                    }
                  }
                }
              }
            }
          ],
          "version": 2,
          "is_active": true
        }
      }
    }
  ]
