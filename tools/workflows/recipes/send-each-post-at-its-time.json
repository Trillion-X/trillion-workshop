            {
              "id": "refuse-ungated-queue",
              "kind": "return",
              "config": {
                "value": {
                  "refused": "This pursuit queue has no consent gate (post_go_state_consent), so nothing in it was read for sending.",
                  "database": {
                    "$kind": "binding",
