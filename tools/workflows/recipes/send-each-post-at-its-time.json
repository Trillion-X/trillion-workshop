                      ]
                    }
                  ],
                  "database": {
                    "$kind": "binding",
                    "select": {
                      "from": "input",
                      "path": "store.where"
                    }
                  }
                },
                "context": {
                  "use": {
                    "purpose": "publish",
                    "surface": "social/instagram"
                  },
                  "title": "Write each post as its sends answered it",
                  "step_id": "keep-sent-posts"
                }
              }
