            {
              "id": "send-list",
              "kind": "ask",
              "config": {
                "name": "tool:run-sql-in-my-database",
                "input": {
                  "sql": "WITH posts AS (\n  SELECT x->>'address' AS post_id, (x->>'version')::int AS version,\n         (x->>'allowed')::boolean AS allowed, x->'value' AS v\n    FROM jsonb_array_elements($1::jsonb) x),\ndests AS (\n  SELECT p.post_id, p.version, p.allowed, p.v, d.dest\n    FROM posts p CROSS JOIN LATERAL jsonb_array_elements_text(coalesce(p.v->'destinations', '[]'::jsonb)) AS d(dest)),\ncons AS (\n  SELECT x->>'post_id' AS post_id, x->>'destination' AS dest, (x->>'allowed')::boolean AS ok\n    FROM jsonb_array_elements($2::jsonb) x),\nconn AS (\n  SELECT x->>'address' AS address, x->'value' AS value\n    FROM jsonb_array_elements($3::jsonb) x)\nSELECT d.post_id, d.version, d.dest AS account_id, d.v->>'armed_at' AS armed_at,\n       c.value->>'place' AS place,\n       jsonb_build_object('id', d.post_id, 'type', 'post', 'value', d.v) AS record_post,\n       jsonb_build_object('id', 'connection:' || replace(d.dest, ':', '%3A'), 'type', 'connection', 'value', c.value) AS record_link,\n       (d.allowed AND coalesce(cs.ok, false) AND c.value IS NOT NULL AND c.value->>'place' IS NOT NULL\n         AND coalesce(d.v->'deliveries'->d.dest->>'status', 'not sent') NOT IN ('posted', 'not known')) AS sendable,\n       CASE WHEN NOT d.allowed THEN 'the gate refused this post (no product fits)'\n            WHEN NOT coalesce(cs.ok, false) THEN 'the consent check refused this destination'\n            WHEN c.value IS NULL THEN 'no connection record for this destination'\n            WHEN c.value->>'place' IS NULL THEN 'no place takes this connection'\n            WHEN coalesce(d.v->'deliveries'->d.dest->>'status', 'not sent') IN ('posted', 'not known') THEN 'already sent or not known'\n            ELSE NULL END AS why\n  FROM dests d\n  LEFT JOIN cons cs ON cs.post_id = d.post_id AND cs.dest = d.dest\n  LEFT JOIN conn c ON c.address = 'connection:' || replace(d.dest, ':', '%3A')\n ORDER BY d.post_id, d.dest",
                  "params": [
