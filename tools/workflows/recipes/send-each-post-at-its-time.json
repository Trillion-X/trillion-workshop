                "input": {
                  "sql": "WITH dests AS (\n  SELECT DISTINCT d.dest\n    FROM jsonb_array_elements($1::jsonb) p,\n         jsonb_array_elements_text(coalesce(p->'value'->'destinations', '[]'::jsonb)) AS d(dest)\n   WHERE d.dest ~ '^[A-Za-z0-9_.!~*''():-]+$')\nSELECT 'connection:' || replace(dests.dest, ':', '%3A') AS address,\n       to_jsonb(sc) || jsonb_build_object('place', pp.slug) AS value\n  FROM dests\n  JOIN service_connection sc ON sc.connection_id = dests.dest\n  LEFT JOIN post_place pp ON pp.connection_vendor = sc.vendor",
