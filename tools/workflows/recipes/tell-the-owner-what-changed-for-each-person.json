        "definition": {
          "id": "workflow:tell-the-owner-what-changed-for-each-person",
          "name": "Tell me what changed for each person, with one ready message",
          "kind": "workflow",
          "is_active": true,
          "version": 1,
          "steps": [
            {
              "id": "read-what-is-due",
              "kind": "ask",
              "config": {
                "name": "tool:run-sql-in-my-database",
                "input": {
                  "credential_name": {
                    "$kind": "binding",
                    "select": {
                      "from": "input",
                      "path": "history.credential_name"
                    }
                  },
                  "sql": "WITH due AS (SELECT * FROM due_tells()),\nlatest AS (\n  SELECT DISTINCT ON (d.thing_scheme, d.thing_value, s.place, s.key) d.thing_scheme, d.thing_value, s.after\n  FROM due d CROSS JOIN LATERAL history(d.thing_scheme, d.thing_value) h JOIN statements s ON s.id = h.id\n  WHERE h.stands AND s.key IS NOT NULL AND s.after ? 'starts_at'\n  ORDER BY d.thing_scheme, d.thing_value, s.place, s.key, s.at DESC, s.id DESC),\nnext_call AS (\n  SELECT thing_scheme, thing_value, min((after ->> 'starts_at')::timestamptz) AS starts_at FROM latest\n  WHERE coalesce(after ->> 'cancelled_at', '') = '' AND (after ->> 'starts_at')::timestamptz > now() GROUP BY 1, 2)\nSELECT d.thing_scheme, d.thing_value, d.through, d.meanings, d.words,\n  (SELECT string_agg(k.value, ', ' ORDER BY k.value) FROM known_as(d.thing_scheme, d.thing_value) k WHERE k.scheme = $1::text) AS addresses,\n  (SELECT m.value FROM history(d.thing_scheme, d.thing_value) h JOIN mentions m ON m.statement = h.id AND m.scheme = $1::text\n     WHERE h.stands ORDER BY h.at DESC, h.id DESC LIMIT 1) AS address,\n  n.starts_at AS next_call_at,\n  coalesce(n.starts_at < now() + make_interval(mins => $2::int), false) AS soon,\n  (SELECT jsonb_agg(jsonb_build_object('at', h.at, 'meaning', h.meaning, 'words', h.words, 'stands', h.stands, 'said_as', h.said_as, 'after', h.after) ORDER BY h.at, h.id)\n     FROM history(d.thing_scheme, d.thing_value) h)::text AS history\nFROM due d LEFT JOIN next_call n ON n.thing_scheme = d.thing_scheme AND n.thing_value = d.thing_value\nORDER BY d.through",
                  "params": [
                    {
                      "$kind": "binding",
                      "select": {
                        "from": "input",
                        "path": "address_scheme"
                      }
                    },
                    {
                      "$kind": "binding",
                      "select": {
                        "from": "input",
                        "path": "soon_minutes"
                      }
                    }
                  ]
                },
                "context": {
                  "step_id": "read-what-is-due"
                }
              }
            },
