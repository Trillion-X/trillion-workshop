                  }
                },
                "item_var": "due",
                "definition_id": "workflow:tell-the-owner-what-changed-for-each-person:one",
                "parallel": false
              }
            }
          ],
          "edges": [
            {
              "from": "read-what-is-due",
              "to": "tell-each",
              "kind": "always"
            }
          ],
