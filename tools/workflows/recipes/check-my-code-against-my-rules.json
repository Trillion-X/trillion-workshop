{
  "records": [
    {
      "payload": {
        "kind": "workflow-recipe",
        "id": "workflow:check-my-code-against-my-rules",
        "label": "Check my code against my rules",
        "job": "Check each repository's commit the person names, as its host serves it, against rules the person wrote down, each hour, and tell the person when something breaks a rule: which file, which line, why the rule exists, and where a retired name moved to when that is recorded. The repositories, their rules and their recorded findings are the input the person switches the wake on with, one check per repository, so one workflow and one switch check any number of repositories.",
        "produces": "Nothing when every rule holds. Otherwise one notice kept in the person's store (notices) per repository that broke a rule, kind needs-you, titled with its archive, whose body is that run's count of findings, rules and files. The same findings in the same archive are one notice, however many hours they stay: each notice is kept under the archive and what was found (the check's `found`), so the person is told again only when that changes.",
        "input_schema": {
          "type": "object",
          "required": [
            "checks",
            "store"
          ],
          "properties": {
            "checks": {
              "type": "array",
              "minItems": 1,
              "description": "One check per repository: {archive, rules, recorded?, under?, subjects_from?, credential_name?}, as tool:check-an-archive-against-my-rules takes them",
              "items": {
                "type": "object",
                "required": [
                  "archive",
                  "rules"
                ],
                "properties": {
                  "archive": {
                    "type": "string",
                    "description": "The https address of the commit archive to check, such as the host's archive of a branch, so each hour reads its newest commit"
                  },
                  "rules": {
                    "type": "array",
                    "description": "The rules, as tool:check-an-archive-against-my-rules takes them"
                  },
                  "recorded": {
                    "type": "object",
                    "description": "Findings already written down: { known_findings: { <rule id>: [path or path:line] } }"
                  },
                  "under": {
                    "type": "string",
                    "description": "Only the files under this folder of the archive are judged"
                  },
                  "subjects_from": {
                    "type": "object",
                    "description": "Sets computed every run from two other archives, as tool:check-an-archive-against-my-rules takes them, such as the tool ids another repository stopped declaring since an older commit the input names"
                  },
                  "credential_name": {
                    "type": "string",
                    "description": "The held name of a token that may read a private repository's archive, sent only to the archive's own host"
                  }
                }
              }
            },
            "store": {
              "type": "object",
              "required": [
                "where",
                "language",
                "credential_name"
              ],
              "properties": {
                "where": {
                  "type": "string",
                  "description": "Where the person keeps the notices their workflows tell them (table notices): the store's own address"
                },
                "language": {
                  "type": "string",
                  "description": "How that store is spoken to, in its own terms"
                },
                "credential_name": {
                  "type": "string",
                  "description": "The vault name of the login the run uses to keep a notice"
                }
              }
            }
          }
        },
        "wakes": [
          {
            "id": "hourly",
            "on": {
              "fact": {
                "kind": "due-time",
                "from": [
                  "run"
                ],
                "match": {
                  "schedule_id": "schedule:workflow:check-my-code-against-my-rules:hourly"
                },
                "watch": {
                  "schedules": [
                    {
                      "schedule_id": "schedule:workflow:check-my-code-against-my-rules:hourly",
                      "source_generation": 1,
                      "schedule_revision": 1,
                      "timezone": "UTC",
                      "start_local_date": "1970-01-01",
                      "local_window": {
                        "start": "00:00",
                        "duration_minutes": 1
                      },
                      "dst": {
                        "gap": "next-valid",
                        "fold": "earlier"
                      },
                      "action": {
                        "operation": "tell-the-engine",
                        "owner_ref": "workflow:check-my-code-against-my-rules",
                        "owner_dispatch": {
                          "name": "workflow:check-my-code-against-my-rules",
                          "input": {}
                        },
                        "completion": {
                          "mode": "synchronous-owner-return"
                        }
                      },
                      "cadence": {
                        "unit": "hour"
                      }
                    }
                  ]
                }
              }
            },
            "budget": {
              "steps": 4,
              "wall_ms": 600000
            },
            "input": {
              "start_at": "check-each"
            }
          }
        ],
        "definition": {
          "id": "workflow:check-my-code-against-my-rules",
          "name": "Check my code against my rules",
          "kind": "workflow",
          "is_active": true,
          "version": 2,
          "steps": [
            {
              "id": "check-each",
              "kind": "loop",
              "config": {
                "source": {
                  "$kind": "binding",
                  "select": {
                    "from": "input",
                    "path": "checks"
                  }
                },
                "item_var": "check",
                "definition_id": "workflow:check-my-code-against-my-rules:check-one",
                "parallel": true
              }
            }
          ],
          "edges": [],
          "uses": [
            {
              "id": "workflow:check-my-code-against-my-rules:check-one",
              "name": "Check one repository and tell when a rule breaks",
              "kind": "workflow",
              "is_active": true,
              "version": 1,
              "steps": [
                {
                  "id": "check",
                  "kind": "ask",
                  "config": {
                    "name": "tool:check-an-archive-against-my-rules",
                    "input": {
                      "archive": {
                        "$kind": "binding",
                        "select": {
                          "from": "loop",
                          "path": "check.archive"
                        }
                      },
                      "rules": {
                        "$kind": "binding",
                        "select": {
                          "from": "loop",
                          "path": "check.rules"
                        }
                      },
                      "recorded": {
                        "$kind": "binding",
                        "select": {
                          "from": "loop",
                          "path": "check.recorded"
                        }
                      },
                      "under": {
                        "$kind": "binding",
                        "select": {
                          "from": "loop",
                          "path": "check.under"
                        }
                      },
                      "subjects_from": {
                        "$kind": "binding",
                        "select": {
                          "from": "loop",
                          "path": "check.subjects_from"
                        }
                      },
                      "credential_name": {
                        "$kind": "binding",
                        "select": {
                          "from": "loop",
                          "path": "check.credential_name"
                        }
                      }
                    },
                    "context": {
                      "step_id": "check"
                    }
                  }
                },
                {
                  "id": "make-devices",
                  "kind": "ask",
                  "config": {
                    "name": "tool:run-sql-in-my-database",
                    "input": {
                      "credential_name": {
                        "$kind": "binding",
                        "select": {
                          "from": "input",
                          "path": "store.credential_name"
                        }
                      },
                      "sql": "create table if not exists devices (id text primary key, platform text not null check (platform in ('live', 'web-push', 'apns')), token text, app_build text, registered_at timestamptz not null default now(), last_seen_at timestamptz not null default now())"
                    },
                    "context": {
                      "step_id": "make-devices"
                    }
                  }
                },
                {
                  "id": "make-notices",
                  "kind": "ask",
                  "config": {
                    "name": "tool:run-sql-in-my-database",
                    "input": {
                      "credential_name": {
                        "$kind": "binding",
                        "select": {
                          "from": "input",
                          "path": "store.credential_name"
                        }
                      },
                      "sql": "create table if not exists notices (id bigint generated always as identity primary key, device_id text references devices (id), title text not null default '', body text not null default '', url text, made_at timestamptz not null default now(), read_at timestamptz, acted_at timestamptz)"
                    },
                    "context": {
                      "step_id": "make-notices"
                    }
                  }
                },
                {
                  "id": "widen-notices",
                  "kind": "ask",
                  "config": {
                    "name": "tool:run-sql-in-my-database",
                    "input": {
                      "credential_name": {
                        "$kind": "binding",
                        "select": {
                          "from": "input",
                          "path": "store.credential_name"
                        }
                      },
                      "sql": "alter table notices add column if not exists kind text, add column if not exists key text"
                    },
                    "context": {
                      "step_id": "widen-notices"
                    }
                  }
                },
                {
                  "id": "tell",
                  "kind": "ask",
                  "config": {
                    "name": "tool:run-sql-in-my-database",
                    "input": {
                      "credential_name": {
                        "$kind": "binding",
                        "select": {
                          "from": "input",
                          "path": "store.credential_name"
                        }
                      },
                      "sql": "insert into notices (title, body, kind, key) select coalesce($2::text, ''), coalesce($3::text, ''), $1::text, $4::text where $4::text is null or not exists (select 1 from notices where key = $4::text)",
                      "params": [
                        "needs-you",
                        {
                          "$kind": "binding",
                          "select": {
                            "from": "loop",
                            "path": "check.archive"
                          },
                          "resolve_nested_bindings": true,
                          "transform": [
                            {
                              "op": "op:core.concat",
                              "args": {
                                "values": [
                                  "My rules found something in ",
                                  {
                                    "$kind": "binding",
                                    "select": {
                                      "from": "loop",
                                      "path": "check.archive"
                                    }
                                  }
                                ]
                              }
                            }
                          ]
                        },
                        {
                          "$kind": "binding",
                          "select": {
                            "from": "steps",
                            "key": "check",
                            "path": "output.said"
                          }
                        },
                        {
                          "$kind": "binding",
                          "select": {
                            "from": "loop",
                            "path": "check.archive"
                          },
                          "resolve_nested_bindings": true,
                          "transform": [
                            {
                              "op": "op:core.concat",
                              "args": {
                                "values": [
                                  "check-my-code ",
                                  {
                                    "$kind": "binding",
                                    "select": {
                                      "from": "loop",
                                      "path": "check.archive"
                                    }
                                  },
                                  "\n",
                                  {
                                    "$kind": "binding",
                                    "select": {
                                      "from": "steps",
                                      "key": "check",
                                      "path": "output.found"
                                    }
                                  }
                                ]
                              }
                            }
                          ]
                        }
                      ]
                    },
                    "context": {
                      "step_id": "tell"
                    }
                  }
                }
              ],
              "edges": [
                {
                  "from": "check",
                  "to": "make-devices",
                  "kind": "on_result",
                  "config": {
                    "$kind": "binding",
                    "select": {
                      "from": "input",
                      "path": "output.passed"
                    },
                    "transform": [
                      {
                        "op": "op:core.eq",
                        "args": {
                          "value": false
                        }
                      }
                    ]
                  }
                },
                {
                  "from": "make-devices",
                  "to": "make-notices",
                  "kind": "always"
                },
                {
                  "from": "make-notices",
                  "to": "widen-notices",
                  "kind": "always"
                },
                {
                  "from": "widen-notices",
                  "to": "tell",
                  "kind": "always"
                }
              ]
            }
          ]
        },
        "records": {
          "runs": [
            "tool:check-an-archive-against-my-rules",
            "tool:run-sql-in-my-database"
          ]
        }
      }
    }
  ]
}
