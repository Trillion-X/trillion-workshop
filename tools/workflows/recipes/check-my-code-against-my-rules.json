{
  "records": [
    {
      "payload": {
        "kind": "workflow-recipe",
        "id": "workflow:check-my-code-against-my-rules",
        "label": "Check my code against my rules",
        "job": "Check one repository's commit, as its host serves it, against rules the person wrote down, each hour, and tell the person when something breaks a rule: which file, which line, why the rule exists, and where a retired name moved to when that is recorded. Which repository, which rules and which recorded findings are the input the person switches the wake on with, so one workflow checks any number of repositories, one switch each.",
        "produces": "Nothing when every rule holds. Otherwise one notice to the person, kind needs-you, titled with the archive, whose body is the run's count of findings, rules and files.",
        "input_schema": {
          "type": "object",
          "required": [
            "archive",
            "rules"
          ],
          "properties": {
            "archive": {
              "type": "string",
              "description": "The https address of the commit archive to check, such as the host's archive of a branch, so each hour reads its newest commit"
            },
            "rules": {
              "type": "array",
              "description": "The rules, as tool:check-an-archive-against-my-rules takes them"
            },
            "recorded": {
              "type": "object",
              "description": "Findings already written down: { known_findings: { <rule id>: [path or path:line] } }"
            },
            "under": {
              "type": "string",
              "description": "Only the files under this folder of the archive are judged"
            },
            "subjects_from": {
              "type": "object",
              "description": "Sets computed every run from two other archives, as tool:check-an-archive-against-my-rules takes them, such as the tool ids another repository stopped declaring since an older commit the input names"
            }
          }
        },
        "wakes": [
          {
            "id": "hourly",
            "on": {
              "fact": {
                "kind": "due-time",
                "from": [
                  "run"
                ],
                "match": {
                  "schedule_id": "schedule:workflow:check-my-code-against-my-rules:hourly"
                },
                "watch": {
                  "schedules": [
                    {
                      "schedule_id": "schedule:workflow:check-my-code-against-my-rules:hourly",
                      "source_generation": 1,
                      "schedule_revision": 1,
                      "timezone": "UTC",
                      "start_local_date": "1970-01-01",
                      "local_window": {
                        "start": "00:00",
                        "duration_minutes": 1
                      },
                      "dst": {
                        "gap": "next-valid",
                        "fold": "earlier"
                      },
                      "action": {
                        "operation": "tell-the-engine",
                        "owner_ref": "workflow:check-my-code-against-my-rules",
                        "owner_dispatch": {
                          "name": "workflow:check-my-code-against-my-rules",
                          "input": {}
                        },
                        "completion": {
                          "mode": "synchronous-owner-return"
                        }
                      },
                      "cadence": {
                        "unit": "hour"
                      }
                    }
                  ]
                }
              }
            },
            "budget": {
              "steps": 4,
              "wall_ms": 600000
            },
            "input": {
              "start_at": "check"
            }
          }
        ],
        "definition": {
          "id": "workflow:check-my-code-against-my-rules",
          "name": "Check my code against my rules",
          "kind": "workflow",
          "is_active": true,
          "version": 1,
          "steps": [
            {
              "id": "check",
              "kind": "ask",
              "config": {
                "name": "tool:check-an-archive-against-my-rules",
                "input": {
                  "archive": {
                    "$kind": "binding",
                    "select": {
                      "from": "input",
                      "path": "archive"
                    }
                  },
                  "rules": {
                    "$kind": "binding",
                    "select": {
                      "from": "input",
                      "path": "rules"
                    }
                  },
                  "recorded": {
                    "$kind": "binding",
                    "select": {
                      "from": "input",
                      "path": "recorded"
                    }
                  },
                  "under": {
                    "$kind": "binding",
                    "select": {
                      "from": "input",
                      "path": "under"
                    }
                  },
                  "subjects_from": {
                    "$kind": "binding",
                    "select": {
                      "from": "input",
                      "path": "subjects_from"
                    }
                  }
                },
                "context": {
                  "step_id": "check"
                }
              }
            },
            {
              "id": "tell",
              "kind": "ask",
              "config": {
                "name": "tool:tell-the-person",
                "input": {
                  "title": {
                    "$kind": "binding",
                    "select": {
                      "from": "input",
                      "path": "archive"
                    },
                    "resolve_nested_bindings": true,
                    "transform": [
                      {
                        "op": "op:core.concat",
                        "args": {
                          "values": [
                            "My rules found something in ",
                            {
                              "$kind": "binding",
                              "select": {
                                "from": "input",
                                "path": "archive"
                              }
                            }
                          ]
                        }
                      }
                    ]
                  },
                  "body": {
                    "$kind": "binding",
                    "select": {
                      "from": "steps",
                      "key": "check",
                      "path": "output.said"
                    }
                  },
                  "kind": "needs-you"
                },
                "context": {
                  "step_id": "tell"
                }
              }
            }
          ],
          "edges": [
            {
              "from": "check",
              "to": "tell",
              "kind": "on_result",
              "config": {
                "$kind": "binding",
                "select": {
                  "from": "input",
                  "path": "output.passed"
                },
                "transform": [
                  {
                    "op": "op:core.eq",
                    "args": {
                      "value": false
                    }
                  }
                ]
              }
            }
          ]
        },
        "records": {
          "runs": [
            "tool:check-an-archive-against-my-rules",
            "tool:tell-the-person"
          ]
        }
      }
    }
  ]
}
