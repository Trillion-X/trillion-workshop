            },
            {
              "to": "sign",
              "from": "keep",
              "kind": "always"
            }
          ],
          "steps": [
            {
              "id": "when",
              "kind": "ask",
              "config": {
                "name": "tool:read-when-the-proof-session-ends",
                "input": {},
                "context": {
                  "step_id": "when"
                }
              }
            },
            {
              "id": "ask",
