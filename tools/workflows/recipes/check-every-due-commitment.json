{
  "about": "workflow:check-every-due-commitment: rendered from its workflow_recipes row.",
  "records": [
    {
      "payload": {
        "source_kept_at": "2026-11-22 00:27:24.806416+00",
        "kind": "workflow-recipe",
        "id": "workflow:check-every-due-commitment",
        "label": "Tell one fact per due commitment check (inactive until the 15-minute wake is switched on)",
        "job": "Every 15 minutes, list each commitment not yet delivered whose proof task has a check, and tell one fact per check to workflow:run-one-check.",
        "produces": "For each due commitment check the watcher ran: a recorded pass, fail, or unknown on its commitment or ruling.",
        "source": {},
        "input_schema": {
          "type": "object",
          "required": [
            "own"
          ],
          "properties": {
            "own": {
              "type": "object",
              "required": [
                "credential_name"
              ],
              "properties": {
                "credential_name": {
                  "type": "string"
                }
              }
            }
          },
          "additionalProperties": false
        },
        "definition": {
          "id": "workflow:check-every-due-commitment",
          "kind": "workflow",
          "name": "Tell one fact per due commitment check",
          "uses": [],
          "edges": [
            {
              "to": "fan-out",
              "from": "read-due",
              "kind": "always"
            }
          ],
          "steps": [
            {
              "id": "read-due",
              "kind": "ask",
              "config": {
                "name": "tool:run-sql-in-my-database",
                "input": {
                  "sql": "SELECT c.id AS commitment_id, t.id AS task_id, t.check_spec FROM client_commitments c JOIN calendar_tasks t ON t.id = ANY(c.task_refs) WHERE c.delivered_evidence IS NULL AND t.check_spec IS NOT NULL AND (c.due_at IS NULL OR now() > c.due_at - interval '48 hours')",
                  "params": [],
                  "credential_name": {
                    "$kind": "binding",
                    "select": {
                      "from": "input",
                      "path": "own.credential_name"
                    }
                  }
                }
              },
              "context": {
                "step_id": "read-due"
              }
            },
            {
              "id": "fan-out",
              "kind": "loop",
              "config": {
                "inputs": {
                  "own": {
                    "$kind": "binding",
                    "select": {
                      "from": "input",
                      "path": "own"
                    }
                  },
                  "fact": {
                    "target": {
                      "id": {
                        "$kind": "binding",
                        "select": {
                          "from": "loop",
                          "path": "check.task_id"
                        }
                      },
                      "table": "calendar_tasks"
                    },
                    "check_spec": {
                      "$kind": "binding",
                      "select": {
                        "from": "loop",
                        "path": "check.check_spec"
                      }
                    },
                    "commitment_id": {
                      "$kind": "binding",
                      "select": {
                        "from": "loop",
                        "path": "check.commitment_id"
                      }
                    }
                  },
                  "fact_id": {
                    "$kind": "binding",
                    "select": {
                      "from": "loop",
                      "path": "check.task_id"
                    },
                    "transform": [
                      {
                        "op": "op:core.concat",
                        "args": {
                          "values": [
                            "check-due:",
                            {
                              "$kind": "binding",
                              "select": {
                                "from": "loop",
                                "path": "check.commitment_id"
                              }
                            },
                            ":",
                            {
                              "$kind": "binding",
                              "select": {
                                "from": "loop",
                                "path": "check.task_id"
                              }
                            }
                          ]
                        }
                      }
                    ],
                    "resolve_nested_bindings": true
                  }
                },
                "source": {
                  "$kind": "binding",
                  "select": {
                    "key": "read-due",
                    "from": "steps",
                    "path": "output.rows"
                  }
                },
                "item_var": "check",
                "parallel": false,
                "definition_id": "workflow:run-one-check"
              },
              "context": {
                "step_id": "fan-out"
              }
            }
          ],
          "version": 1,
          "is_active": true
        },
        "wakes": [
          {
            "id": "every-fifteen-minutes",
            "on": {
              "fact": {
                "from": [
                  "run"
                ],
                "kind": "due-time",
                "match": {
                  "schedule_id": "schedule:workflow:check-every-due-commitment:every-fifteen-minutes"
                },
                "watch": {
                  "schedules": [
                    {
                      "dst": {
                        "gap": "next-valid",
                        "fold": "earlier"
                      },
                      "action": {
                        "operation": "tell-the-engine",
                        "owner_ref": "workflow:check-every-due-commitment",
                        "completion": {
                          "mode": "synchronous-owner-return"
                        },
                        "owner_dispatch": {
                          "name": "workflow:check-every-due-commitment",
                          "input": {}
                        }
                      },
                      "cadence": {
                        "unit": "minute",
                        "interval": 15
                      },
                      "timezone": "UTC",
                      "schedule_id": "schedule:workflow:check-every-due-commitment:every-fifteen-minutes",
                      "local_window": {
                        "start": "00:00",
                        "duration_minutes": 1
                      },
                      "start_local_date": "1970-01-01",
                      "schedule_revision": 1,
                      "source_generation": 1
                    }
                  ]
                }
              }
            },
            "budget": {
              "steps": 40,
              "wall_ms": 120000
            },
            "input": {
              "start_at": "read-due"
            }
          }
        ]
      }
    }
  ]
}
