                      "minLength": 1,
                      "pattern": "\\S"
                    },
                    "benefit": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "\\S"
                    },
                    "evidence": {
                      "type": "object",
                      "properties": {
                        "kind": {
                          "enum": [
                            "demonstration",
                            "measured-comparison",
                            "permitted-customer-example"
                          ]
                        },
                        "observable_support": {
                          "type": "string",
                          "minLength": 1,
                          "pattern": "\\S"
                        },
                        "use_rights_or_ownership": {
                          "type": "string",
                          "minLength": 1,
