          "references": [
            {
              "url": "https://www.youtube.com/watch?v=URPHuHLGAxg",
              "other_parts": [
                "https://www.youtube.com/watch?v=XAJWy_CUgsM"
              ],
              "basis": "Count these two linked uploads once. They teach a hook, product in use or validation, benefits, and a call to action. The second part applies the components to examples."
            },
            {
              "url": "https://www.youtube.com/watch?v=TbvHsRinR9E",
              "basis": "This segment of a different series lays out the hook and angle, problem and solution, feature or benefit, proof or objection, and requested action."
            },
            {
              "url": "https://www.youtube.com/watch?v=jp0v-vJu55c",
              "basis": "The interview explains choosing a hook and showing the benefit with a demonstration, testimonial, or story for the intended audience. It supports the core hook-and-benefit method, not a fixed script order."
            }
          ]
        },
        "steps": [
          {
            "id": "outline-one-benefit-or-hold-the-claim",
            "title": "Outline one benefit or hold the claim",
            "do": "In the same answer, name the product, the intended viewer, and a situation they recognize. Outline one short video around one practical benefit. If there is a real demonstration, measured comparison, or genuine customer example you may use, describe what it actually shows, what you may use, and the limit of the claim. Give the opening, the supported benefit, and one next action that fits the viewer. Say what to check before considering release. If evidence or permission is missing, keep the intended benefit as an internal question, not a promise in the opening or next action. Write a neutral opening, name the gap, and say how to verify it. Return a planning outline only. Do not publish, contact customers, or buy placement.",
            "submit": {
              "type": "object",
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "decision": {
                      "const": "outline-with-existing-evidence"
                    },
                    "product": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "\\S"
                    },
                    "intended_viewer": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "\\S"
                    },
