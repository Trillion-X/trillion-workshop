{
  "_what": "Sends a saved mail draft only when the owner's own yes tells an owner-said-yes fact naming it (draft_id, provider, connection_id, to), from the owner's own mail account (tool:send-a-mail-draft, which sends a draft once), then keeps a sent statement in the owner's history (source owner, told sent:<draft_id>), so the next notice reads that it went. Nothing else sends.",
  "records": [
    {
      "payload": {
        "kind": "workflow-recipe",
        "id": "workflow:send-what-the-owner-said-yes-to",
        "label": "Send the message I said yes to",
        "job": "When the owner says yes to a ready message, send that saved mail draft from the owner's own account, once, and keep that it was sent in the owner's history, so the next notice knows it went",
        "produces": "the draft sent from the owner's mail account, and one sent statement in the owner's history",
        "input_schema": {
          "type": "object",
          "properties": {
            "fact": {
              "type": "object",
              "description": "The owner-said-yes fact the owner's tap told: draft_id, provider, connection_id (the mail account), to"
            },
            "history": {
              "type": "object",
              "description": "Where the person's history is: credential_name, the vault name of its database connection"
            }
          }
        },
        "wakes": [
          {
            "id": "the-owner-said-yes",
            "on": {
              "fact": {
                "kind": "owner-said-yes",
                "from": [
                  "sender"
                ]
              }
            },
            "budget": {
              "steps": 4,
              "wall_ms": 300000
            },
            "input": {
              "start_at": "send",
              "history": {
                "credential_name": "own-rows-postgres-connection"
              }
            }
          }
        ],
        "definition": {
          "id": "workflow:send-what-the-owner-said-yes-to",
          "name": "Send the message I said yes to",
          "kind": "workflow",
          "is_active": true,
          "version": 1,
          "steps": [
            {
              "id": "send",
              "kind": "ask",
              "config": {
                "name": "tool:send-a-mail-draft",
                "input": {
                  "provider": {
                    "$kind": "binding",
                    "select": {
                      "from": "input",
                      "path": "fact.provider"
                    }
                  },
                  "connection": {
                    "connection_id": {
                      "$kind": "binding",
                      "select": {
                        "from": "input",
                        "path": "fact.connection_id"
                      }
                    }
                  },
                  "draft_id": {
                    "$kind": "binding",
                    "select": {
                      "from": "input",
                      "path": "fact.draft_id"
                    }
                  }
                },
                "context": {
                  "step_id": "send"
                }
              }
            },
            {
              "id": "keep-that-it-went",
              "kind": "ask",
              "config": {
                "name": "tool:run-sql-in-my-database",
                "input": {
                  "credential_name": {
                    "$kind": "binding",
                    "select": {
                      "from": "input",
                      "path": "history.credential_name"
                    }
                  },
                  "sql": "INSERT INTO statements (source, told, place, change, at, key, after, meaning)\nVALUES ('owner', 'sent:' || $1::text, 'message', 'added', clock_timestamp(), $2::text, jsonb_build_object('to', $3::text, 'draft_id', $1::text), 'sent')\nON CONFLICT (source, told) DO NOTHING RETURNING id",
                  "params": [
                    {
                      "$kind": "binding",
                      "select": {
                        "from": "input",
                        "path": "fact.draft_id"
                      }
                    },
                    {
                      "$kind": "binding",
                      "select": {
                        "from": "steps",
                        "key": "send",
                        "path": "output.message_id"
                      }
                    },
                    {
                      "$kind": "binding",
                      "select": {
                        "from": "input",
                        "path": "fact.to"
                      }
                    }
                  ]
                },
                "context": {
                  "step_id": "keep-that-it-went"
                }
              }
            }
          ],
          "edges": [
            {
              "from": "send",
              "to": "keep-that-it-went",
              "kind": "always"
            }
          ]
        },
        "records": {
          "runs": [
            "tool:run-sql-in-my-database",
            "tool:send-a-mail-draft"
          ]
        }
      }
    }
  ]
}
