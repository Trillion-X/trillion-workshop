{
  "_what": "Tells the person when one of their wakes stops, as a needs-you notice kept in the person's own store (notices, the table workflow:read-my-notices and the person's devices read). It wakes on the wake-failed fact the engine keeps (engine commit e9f19e41c) and names no store of its own (the switch's input names it): the fact carries the tool, the wake and the cause. The notice says what stopped and what to read before switching the wake on again. Its second wake, a-waiter-is-held-back, hears a waiter that cannot see what it watches (tool:notice-when-something-shows-up tells it as something-showed-up, became-unreachable, named with the same tool, wake, cause and said a stopped wake's fact has), so the same notice tells the person. Nov 20 2026, 7:29:55 to 7:41 AM CST: one session idle in a transaction held every row change on the Mac back for 11 minutes and nothing said so.",
  "records": [
    {
      "payload": {
        "kind": "workflow-recipe",
        "id": "workflow:tell-when-a-wake-stops",
        "label": "Tell me when a wake stops",
        "job": "Tell the person when one of their wakes stops, with its cause, and what to read before switching it on again. It keeps each notice in the person's own store (notices, the table workflow:read-my-notices reads), named by the switch's input; it names no store of its own: it hears the wake-failed fact the engine keeps whenever a wake turns failed.",
        "produces": "One notice kept in the person's store per wake-failed fact, once per fact, kind needs-you, titled '<tool> <wake> stopped: <cause>', whose body says what the cause means, in the run's own words when it gave them.",
        "input_schema": {
          "type": "object",
          "properties": {
            "fact": {
              "type": "object",
              "description": "The wake-failed fact the engine kept: tool (the tool the wake belongs to), wake (the wake's id), cause (where it stopped, a cause id) and said (why, in the run's own words, when it gave them)"
            },
            "store": {
              "type": "object",
              "required": [
                "where",
                "language",
                "credential_name"
              ],
              "properties": {
                "where": {
                  "type": "string",
                  "description": "Where the person keeps the notices their workflows tell them (table notices): the store's own address"
                },
                "language": {
                  "type": "string",
                  "description": "How that store is spoken to, in its own terms"
                },
                "credential_name": {
                  "type": "string",
                  "description": "The vault name of the login the run uses to keep a notice"
                }
              }
            }
          }
        },
        "wakes": [
          {
            "id": "a-wake-stopped",
            "on": {
              "fact": {
                "kind": "wake-failed",
                "from": [
                  "wake"
                ]
              }
            },
            "budget": {
              "steps": 16,
              "wall_ms": 1920000
            },
            "input": {
              "start_at": "make-devices"
            },
            "retry": {
              "attempts": 6,
              "first_ms": 60000,
              "factor": 2,
              "most_ms": 900000
            },
            "on_failure": {
              "tool": "tool:run-sql-in-my-database",
              "input": {
                "sql": "insert into notices (title, body, kind) values ('The alarm that tells you a wake stopped did not run', 'One of your wakes stopped, and workflow:tell-when-a-wake-stops, which tells you so, failed six times over half an hour. Open your causes screen (wake:list) to see which wake stopped and why.', 'needs-you')"
              },
              "from_input": {
                "credential_name": "store.credential_name"
              }
            }
          },
          {
            "id": "a-waiter-is-held-back",
            "on": {
              "fact": {
                "kind": "something-showed-up",
                "from": [
                  "run"
                ],
                "match": {
                  "condition": "became-unreachable",
                  "tool": "tool:notice-when-something-shows-up"
                }
              }
            },
            "budget": {
              "steps": 16,
              "wall_ms": 1920000
            },
            "input": {
              "start_at": "make-devices"
            },
            "retry": {
              "attempts": 6,
              "first_ms": 60000,
              "factor": 2,
              "most_ms": 900000
            },
            "on_failure": {
              "tool": "tool:run-sql-in-my-database",
              "input": {
                "sql": "insert into notices (title, body, kind) values ('The alarm that tells you a wake stopped did not run', 'One of your wakes stopped, and workflow:tell-when-a-wake-stops, which tells you so, failed six times over half an hour. Open your causes screen (wake:list) to see which wake stopped and why.', 'needs-you')"
              },
              "from_input": {
                "credential_name": "store.credential_name"
              }
            }
          }
        ],
        "definition": {
          "id": "workflow:tell-when-a-wake-stops",
          "name": "Tell me when a wake stops",
          "kind": "workflow",
          "is_active": true,
          "version": 1,
          "steps": [
            {
              "id": "make-devices",
              "kind": "ask",
              "config": {
                "name": "tool:run-sql-in-my-database",
                "input": {
                  "credential_name": {
                    "$kind": "binding",
                    "select": {
                      "from": "input",
                      "path": "store.credential_name"
                    }
                  },
                  "sql": "create table if not exists devices (id text primary key, platform text not null check (platform in ('live', 'web-push', 'apns')), token text, app_build text, registered_at timestamptz not null default now(), last_seen_at timestamptz not null default now())"
                },
                "context": {
                  "step_id": "make-devices"
                }
              }
            },
            {
              "id": "make-notices",
              "kind": "ask",
              "config": {
                "name": "tool:run-sql-in-my-database",
                "input": {
                  "credential_name": {
                    "$kind": "binding",
                    "select": {
                      "from": "input",
                      "path": "store.credential_name"
                    }
                  },
                  "sql": "create table if not exists notices (id bigint generated always as identity primary key, device_id text references devices (id), title text not null default '', body text not null default '', url text, made_at timestamptz not null default now(), read_at timestamptz, acted_at timestamptz)"
                },
                "context": {
                  "step_id": "make-notices"
                }
              }
            },
            {
              "id": "widen-notices",
              "kind": "ask",
              "config": {
                "name": "tool:run-sql-in-my-database",
                "input": {
                  "credential_name": {
                    "$kind": "binding",
                    "select": {
                      "from": "input",
                      "path": "store.credential_name"
                    }
                  },
                  "sql": "alter table notices add column if not exists kind text, add column if not exists key text"
                },
                "context": {
                  "step_id": "widen-notices"
                }
              }
            },
            {
              "id": "tell",
              "kind": "ask",
              "config": {
                "name": "tool:run-sql-in-my-database",
                "input": {
                  "credential_name": {
                    "$kind": "binding",
                    "select": {
                      "from": "input",
                      "path": "store.credential_name"
                    }
                  },
                  "sql": "insert into notices (title, body, kind, key) select coalesce($2::text, ''), coalesce('It stopped because: ' || $5::text || '.', $3::text, ''), $1::text, $4::text where $4::text is null or not exists (select 1 from notices where key = $4::text)",
                  "params": [
                    "needs-you",
                    {
                      "$kind": "binding",
                      "select": {
                        "from": "input",
                        "path": "fact.tool"
                      },
                      "resolve_nested_bindings": true,
                      "transform": [
                        {
                          "op": "op:core.concat",
                          "args": {
                            "values": [
                              {
                                "$kind": "binding",
                                "select": {
                                  "from": "input",
                                  "path": "fact.tool"
                                }
                              },
                              " ",
                              {
                                "$kind": "binding",
                                "select": {
                                  "from": "input",
                                  "path": "fact.wake"
                                }
                              },
                              " stopped: ",
                              {
                                "$kind": "binding",
                                "select": {
                                  "from": "input",
                                  "path": "fact.cause"
                                }
                              }
                            ]
                          }
                        }
                      ]
                    },
                    {
                      "$kind": "binding",
                      "select": {
                        "from": "input",
                        "path": "fact.cause"
                      },
                      "resolve_nested_bindings": true,
                      "transform": [
                        {
                          "op": "op:core.contains",
                          "args": {
                            "value": "declaration_changed_switch_on_again"
                          }
                        },
                        {
                          "op": "op:core.if",
                          "args": {
                            "then": "Its tool row changed since you switched it on. Read what it asks for now (wake:list shows it) and switch it on again only if you still want that.",
                            "else": {
                              "$kind": "binding",
                              "select": {
                                "from": "input",
                                "path": "fact.cause"
                              },
                              "resolve_nested_bindings": true,
                              "transform": [
                                {
                                  "op": "op:core.concat",
                                  "args": {
                                    "values": [
                                      "It stopped because: ",
                                      {
                                        "$kind": "binding",
                                        "select": {
                                          "from": "input",
                                          "path": "fact.cause"
                                        }
                                      },
                                      "."
                                    ]
                                  }
                                }
                              ]
                            }
                          }
                        }
                      ]
                    },
                    {
                      "$kind": "binding",
                      "select": {
                        "from": "input",
                        "path": "fact_id"
                      }
                    },
                    {
                      "$kind": "binding",
                      "select": {
                        "from": "input",
                        "path": "fact.said"
                      }
                    }
                  ]
                },
                "context": {
                  "step_id": "tell"
                }
              }
            }
          ],
          "edges": [
            {
              "from": "make-devices",
              "to": "make-notices",
              "kind": "always"
            },
            {
              "from": "make-notices",
              "to": "widen-notices",
              "kind": "always"
            },
            {
              "from": "widen-notices",
              "to": "tell",
              "kind": "always"
            }
          ]
        },
        "records": {
          "runs": [
            "tool:run-sql-in-my-database"
          ]
        }
      }
    }
  ]
}
