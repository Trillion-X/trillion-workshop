{
  "_what": "Tells the person when one of their wakes stops, through tool:tell-the-person (every way they chose for needs-you). It wakes on the wake-failed fact the engine keeps (engine commit e9f19e41c) and names no store: the fact carries the tool, the wake and the cause. The notice says what stopped and what to read before switching the wake on again.",
  "records": [
    {
      "payload": {
        "kind": "workflow-recipe",
        "id": "workflow:tell-when-a-wake-stops",
        "label": "Tell me when a wake stops",
        "job": "Tell the person when one of their wakes stops, with its cause, and what to read before switching it on again. It names no store: it hears the wake-failed fact the engine keeps whenever a wake turns failed.",
        "produces": "One notice to the person per wake-failed fact, kind needs-you, titled '<tool> <wake> stopped: <cause>', whose body says what the cause means.",
        "input_schema": {
          "type": "object",
          "properties": {
            "fact": {
              "type": "object",
              "description": "The wake-failed fact the engine kept: tool (the tool the wake belongs to), wake (the wake's id), cause (why it stopped)"
            }
          }
        },
        "wakes": [
          {
            "id": "a-wake-stopped",
            "on": {
              "fact": {
                "kind": "wake-failed",
                "from": [
                  "wake"
                ]
              }
            },
            "budget": {
              "steps": 2,
              "wall_ms": 120000
            },
            "input": {
              "start_at": "tell"
            }
          }
        ],
        "definition": {
          "id": "workflow:tell-when-a-wake-stops",
          "name": "Tell me when a wake stops",
          "kind": "workflow",
          "is_active": true,
          "version": 1,
          "steps": [
            {
              "id": "tell",
              "kind": "ask",
              "config": {
                "name": "tool:tell-the-person",
                "input": {
                  "title": {
                    "$kind": "binding",
                    "select": {
                      "from": "input",
                      "path": "fact.tool"
                    },
                    "resolve_nested_bindings": true,
                    "transform": [
                      {
                        "op": "op:core.concat",
                        "args": {
                          "values": [
                            {
                              "$kind": "binding",
                              "select": {
                                "from": "input",
                                "path": "fact.tool"
                              }
                            },
                            " ",
                            {
                              "$kind": "binding",
                              "select": {
                                "from": "input",
                                "path": "fact.wake"
                              }
                            },
                            " stopped: ",
                            {
                              "$kind": "binding",
                              "select": {
                                "from": "input",
                                "path": "fact.cause"
                              }
                            }
                          ]
                        }
                      }
                    ]
                  },
                  "body": {
                    "$kind": "binding",
                    "select": {
                      "from": "input",
                      "path": "fact.cause"
                    },
                    "resolve_nested_bindings": true,
                    "transform": [
                      {
                        "op": "op:core.contains",
                        "args": {
                          "value": "declaration_changed_switch_on_again"
                        }
                      },
                      {
                        "op": "op:core.if",
                        "args": {
                          "then": "Its tool row changed since you switched it on. Read what it asks for now (wake:list shows it) and switch it on again only if you still want that.",
                          "else": {
                            "$kind": "binding",
                            "select": {
                              "from": "input",
                              "path": "fact.cause"
                            },
                            "resolve_nested_bindings": true,
                            "transform": [
                              {
                                "op": "op:core.concat",
                                "args": {
                                  "values": [
                                    "It stopped because: ",
                                    {
                                      "$kind": "binding",
                                      "select": {
                                        "from": "input",
                                        "path": "fact.cause"
                                      }
                                    },
                                    "."
                                  ]
                                }
                              }
                            ]
                          }
                        }
                      }
                    ]
                  },
                  "kind": "needs-you"
                },
                "context": {
                  "step_id": "tell"
                }
              }
            }
          ],
          "edges": []
        },
        "records": {
          "runs": [
            "tool:tell-the-person"
          ]
        }
      }
    }
  ]
}
