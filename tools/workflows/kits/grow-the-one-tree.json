  "instructions": [
    "1. Pour the example tree-branches rows into the list you keep your processes and their triggers in (see pour), or make list:tree-branches from them: each row names a workflow and when it fires.",
    "2. Pour or make list:content-pillars, list:content-formats and list:content-pieces from their example rows, and make list:tree-outputs empty; the run writes it.",
    "3. Say \"Run workflow:grow-the-one-tree\" with the seed (its words and where it came from), owner.task_list, owner.pursuit and visibility; the AI starts it with tool:start-a-recipe-run (row workflow:grow-the-one-tree).",
    "4. Read the choose-branches answer: the parts the seed was split into and, for each, the branch rows that fire. Turn a branch Off in its row if it should not run for seeds like this.",
    "5. Each output lands once in its owner list with a tree-outputs row naming the branch that made it; later branches read tree-outputs before they make anything.",
    "6. Open the root task in the Calendar tasks table: the show step says which root task to open and how many children are Done."
  ],
  "worked_examples": [
    {
      "title": "One seed fires two branches",
      "ask": "Grow the tree from this: new staff learn our order sheet faster from filled-in rows than from the how-to.",
      "mcp": {
        "server": "trillion",
        "tool": "run_resource_operation",
        "input": {
          "address": "@workshop-tools",
          "method": "tools:run",
          "input": {
            "tool": "tool:start-a-recipe-run",
            "input": {
              "row": "workflow:grow-the-one-tree",
              "seed": {
                "words": "New staff learn our order sheet faster from filled-in rows than from the how-to.",
                "came_from": "voice note, 2026-11-12"
              },
              "owner": {
                "task_list": "record:calendar-task-list:example",
                "pursuit": "pursuit:example-content"
              },
              "visibility": "public"
            }
          }
        }
      },
      "workflow": "workflow:grow-the-one-tree",
      "step": "choose-branches",
      "given": "list:tree-branches holds the four example rows (turn-what-you-said-into-content fires when the seed is the person's own words; research-what-everyone-says fires when a seed makes a claim).",
      "hands_back": "Parts: one claim (\"filled-in rows teach faster than a how-to\") and material for content (the person's own words). Branches that fire: record:tree-branches:turn-what-you-said-into-content (agents 1, public) and record:tree-branches:research-what-everyone-says (agents 1, internal). The root task record:calendar-task:tree-hand-people-the-rows gets two child tasks, one per branch."
    }
  ],
  "pour": {
    "tool": "tool:pour-example-rows-into-my-list",
    "least_coverage": 0.8,
    "how": "Name the list you already keep for the same job and read it with records:read (its fields and row type). Run tool:pour-example-rows-into-my-list with that list as into and this kit list as kit_list: it matches each kit field to one of yours (your map, the same id, the same label, or a name in alike), pours nothing under 80% and names the fields with no home, and otherwise answers the one records:write that adds the example rows beside your own.",
    "example": {
      "kit_list": "list:tree-branches",
      "into": {
        "list": "list:my-procedures",
        "row_type": "record:procedure",
        "fields": [
