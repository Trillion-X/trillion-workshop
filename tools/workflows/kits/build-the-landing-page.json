  "workflows": [
    "workflow:build-the-landing-page",
    "workflow:set-up-a-business-on-trillion"
  ],
  "tools": [
    "tool:start-a-recipe-run",
    "tool:check-copy",
    "tool:copy-a-site",
    "tool:publish_site",
    "tool:name_site",
    "tool:attach_domain",
    "tool:critique-a-public-page",
    "tool:pour-example-rows-into-my-list"
  ],
  "instructions": [
    "1. Pour the example word checks into the list where you keep your writing rules (see pour), or make list:word-checks from them; run workflow:set-up-a-business-on-trillion first so record:business-setup:facts exists.",
    "2. Say \"Run workflow:build-the-landing-page\".",
    "3. The AI reads the facts, writes seven page-block rows (headline, what you get, who it is for, price, one proof line, buy button label, one question), checks them with tool:check-copy, publishes the site, names it, attaches your domain and critiques the live page.",
    "4. Set the DNS record the attach step names at your DNS host; fix each issue the critique lists in the page-block rows and publish again.",
    "5. Read the stage row it ticks in list:business-setup-checklist and any gap rows in list:business-setup-gaps."
  ],
  "worked_examples": [
    {
      "title": "A hype word in the headline fails the word check",
      "ask": "Check my landing page words.",
      "mcp": {
        "server": "trillion",
        "tool": "run_resource_operation",
        "input": {
          "address": "@workshop-tools",
          "method": "tools:run",
          "input": {
            "tool": "tool:start-a-recipe-run",
            "input": {
              "row": "workflow:build-the-landing-page"
            }
          }
        }
      },
      "workflow": "workflow:build-the-landing-page",
      "step": "check-the-page-words",
      "given": "The write-the-page-rows step wrote seven blocks; block 1 (record:page-block:1) says \"A revolutionary way to order bread\" and list:word-checks has the On row no-hype (words amazing, game-changer, revolutionary, kind copy). tool:check-copy is run on the blocks with kind copy; read from the step's run_tool in the workflow row.",
      "hands_back": "The submit shape of step check-the-page-words: {\"failing\":[\"record:page-block:1\"]}. The block is rewritten and its row updated before publish-the-site runs."
    }
  ],
  "pour": {
    "tool": "tool:pour-example-rows-into-my-list",
    "least_coverage": 0.8,
    "how": "Name the list you already keep for the same job and read it with records:read (its fields and row type). Run tool:pour-example-rows-into-my-list with that list as into and this kit list as kit_list: it matches each kit field to one of yours (your map, the same id, the same label, or a name in alike), pours nothing under 80% and names the fields with no home, and otherwise answers the one records:write that adds the example rows beside your own.",
    "example": {
      "kit_list": "list:word-checks",
      "into": {
        "list": "list:my-word-checks",
        "row_type": "record:my-word-check",
        "fields": [
          {
            "id": "my_id",
            "label": "Rule"
          },
          {
            "id": "my_says",
            "label": "Says"
          },
          {
            "id": "my_words",
            "label": "Words"
          },
          {
            "id": "my_kinds",
            "label": "Kinds"
          },
          {
            "id": "my_because",
            "label": "Because"
          },
          {
            "id": "my_on",
            "label": "On"
          }
        ]
      },
      "field_map": {}
    }
  }
}
