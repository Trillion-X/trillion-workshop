          "id": "hand-the-replies-to-the-person-1",
          "values": {
            "stage": "replies",
            "step": "hand-the-replies-to-the-person",
            "undecided": "No live tool sends an Instagram direct-message reply.",
            "chosen": "Handed 3 checked replies to the person to send by hand.",
            "evidence": "The live catalog has no send tool for Instagram direct messages.",
