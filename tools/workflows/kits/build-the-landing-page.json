{
  "drafted_from": "workflow:build-the-landing-page's row in tools/workflows/recipes/workflows.json (its input schema, steps and submit shapes)",
  "start_here": "Say to your AI: \"Run workflow:build-the-landing-page for Sunrise Bakery; the business facts are already in record:business-setup:facts and my domain is example.com.\"",
  "lists": [
    {
      "list": "list:word-checks",
      "label": "Word checks",
      "row_type": "record:word-check",
      "holds": "One rule for every line a person reads; a reply that breaks an On rule is rewritten before it is handed over.",
      "fields": [
        {
          "id": "id",
          "kind": "text",
          "label": "Rule"
        },
        {
          "id": "says",
          "kind": "long-text",
          "label": "Says",
          "alike": [
            "rule",
            "guideline",
            "description"
          ]
        },
        {
          "id": "words",
          "kind": "tags",
          "label": "Words",
          "alike": [
            "banned words",
            "phrases"
          ]
        },
        {
          "id": "kinds",
          "kind": "tags",
          "label": "Kinds",
          "alike": [
            "applies to"
          ]
        },
        {
          "id": "because",
          "kind": "tags",
          "label": "Because",
          "alike": [
            "why",
            "reason"
          ]
        },
        {
          "id": "on",
          "kind": "choice",
          "label": "On",
          "alike": [
            "active",
            "enabled"
          ]
        }
      ],
      "example_rows": [
        {
          "id": "no-hype",
          "values": {
            "id": "no-hype",
            "says": "No hype words in a reply.",
            "words": [
              "amazing",
              "game-changer",
              "revolutionary"
            ],
            "kinds": [
              "copy"
            ],
            "because": [
              "replies read as a person, not an ad"
            ],
            "on": "On"
          }
        },
        {
          "id": "no-promise",
          "values": {
            "id": "no-promise",
            "says": "Never promise a result or a date the business has not set.",
            "words": [
              "guaranteed",
              "100%"
            ],
            "kinds": [
              "copy"
            ],
            "because": [
              "a promise in a DM is a promise"
            ],
            "on": "On"
          }
        }
      ],
      "alike": [
        "a brand voice guide",
        "a style guide spreadsheet",
        "a banned-words list"
      ]
    },
    {
