  "instructions": [
    "1. Pour the example comment leads into the list you keep audience questions in (see pour), or make list:comment-leads from them; make list:content-pieces too if you keep no content calendar.",
    "2. Say \"Run workflow:answer-commenters-with-videos\" with accounts (platform and handle or link for each), pursuit and owner_list; most_per_run is optional.",
    "3. The first watch is a quiet baseline: the next run reads the comments under every new post and writes one comment-leads row per comment worth a video.",
    "4. Each lead gets a video through workflow:make-one-piece-of-content-from-audience-to-publish; approve the reply when it asks (Instagram and YouTube send, other places wait as reply-ready).",
    "5. Read the numbers on each lead row after measure-and-feed-back; the angles that win go into the next week's plan."
  ],
  "worked_examples": [
    {
      "title": "A question under a channel's video becomes a lead",
      "ask": "Answer the commenters on @ExampleChannel with videos, at most 5.",
      "mcp": {
        "server": "trillion",
        "tool": "run_resource_operation",
        "input": {
          "address": "@workshop-tools",
          "method": "tools:run",
          "input": {
            "tool": "tool:start-a-recipe-run",
            "input": {
              "row": "workflow:answer-commenters-with-videos",
              "accounts": [
                {
                  "platform": "youtube",
                  "handle_or_link": "https://www.youtube.com/@ExampleChannel",
                  "why": "Its viewers ask the questions my audience asks."
                }
              ],
              "pursuit": "pursuit:example-content",
              "owner_list": "record:calendar-task-list:example",
              "most_per_run": 5
            }
          }
        }
      },
      "workflow": "workflow:answer-commenters-with-videos",
      "step": "pick-commenters",
      "given": "The keep-posts-and-comments step kept two comments under https://www.youtube.com/watch?v=EXAMPLE123: \"how do you train a new baker in one morning??\" (question) and \"Pre-orders never work for small shops, people just walk in\" (disagreement).",
      "hands_back": "lead_ids [\"record:comment-leads:post-123-1\", \"record:comment-leads:post-123-2\"], each row holding the comment word for word, its kind, the link, one sentence on the video it could be and state Picked; skipped []."
    }
  ],
  "pour": {
    "tool": "tool:pour-example-rows-into-my-list",
    "least_coverage": 0.8,
    "how": "Name the list you already keep for the same job and read it with records:read (its fields and row type). Run tool:pour-example-rows-into-my-list with that list as into and this kit list as kit_list: it matches each kit field to one of yours (your map, the same id, the same label, or a name in alike), pours nothing under 80% and names the fields with no home, and otherwise answers the one records:write that adds the example rows beside your own.",
    "example": {
      "kit_list": "list:comment-leads",
      "into": {
        "list": "list:my-audience-questions",
        "row_type": "record:audience-question",
        "fields": [
          {
            "id": "comment_text",
            "label": "Comment text"
