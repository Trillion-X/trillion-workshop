  "workflows": [
    "workflow:keep-my-calendar-tasks-and-proposals"
  ],
  "tools": [
    "tool:run-workflow-definition",
    "tool:answer-the-calendar-page-route"
  ],
  "instructions": [
    "1. Keep the store's login in your vault under a name you choose, and say where the store is and how it is spoken to.",
    "2. Say what you want kept (a task, a proposal to review, a calendar choice) and run workflow:keep-my-calendar-tasks-and-proposals with store and the changes.",
    "3. The first run makes the store's own objects once and proves them on the example attempts: every change must be kept, repeated or refused as the intent says, or the run stops and says which.",
    "4. Read the calendar back with tool:answer-the-calendar-page-route (GET only). Keeping a proposal or a task never goes through that tool."
  ],
  "worked_examples": [
    {
      "title": "Propose a task, approve it, read the tasks back",
      "ask": "Propose the task Book the offsite from meeting standup and approve it.",
      "mcp": {
        "server": "{cli}",
        "tool": "do_one_thing_in_my_account",
        "input": {
          "method": "tools:run",
          "input": {
            "tool": "tool:run-workflow-definition",
            "input": {
              "row": "workflow:keep-my-calendar-tasks-and-proposals",
              "store": {
                "where": "postgresql database example_shop on my own computer",
                "language": "SQL (PostgreSQL)",
                "credential_name": "example-shop-postgres-connection"
              },
              "changes": [
                {
                  "op": "propose",
                  "source_id": "meeting:standup",
                  "items": [
                    {
                      "title": "Book the offsite"
                    }
                  ]
                },
                {
                  "op": "approve",
                  "of": [
                    "meeting:standup",
                    "Book the offsite"
                  ]
                }
              ]
            }
          }
        }
      },
      "workflow": "workflow:keep-my-calendar-tasks-and-proposals",
      "step": "keep",
      "given": "The look step found the proposals and tasks kept by an earlier run in the store's own objects.",
      "hands_back": "kept_changes [\"kept\", \"kept\"] and found with the proposal approved and its task read back."
    }
  ],
  "pour": {
    "tool": "tool:pour-example-rows-into-my-list",
    "least_coverage": 0.8,
    "how": "Name the list you already keep for the same job and read its fields and row type from your own store. Run tool:pour-example-rows-into-my-list with that list as into and this kit list as kit_list: it matches each kit field to one of yours (your map, the same id, the same label, or a name in alike), pours nothing under 80% and names the fields with no home, and otherwise answers the example rows to keep beside your own.",
    "example": {
      "kit_list": "list:calendar-tasks",
      "into": {
        "list": "list:my-tasks",
        "row_type": "record:task",
        "fields": [
          {
            "id": "title",
            "label": "Task"
          },
          {
            "id": "description",
            "label": "Description"
          },
          {
            "id": "priority",
            "label": "Priority"
          },
          {
            "id": "duration_minutes",
            "label": "Minutes"
          },
          {
            "id": "status",
            "label": "Status"
          },
          {
            "id": "starts_at",
            "label": "Starts"
          },
          {
            "id": "ends_at",
            "label": "Ends"
          }
        ]
      }
    }
  }
