  "workflows": [
    "workflow:run-a-course-from-list-rows",
    "workflow:set-up-a-business-on-trillion"
  ],
  "tools": [
    "tool:check-copy",
    "tool:send-due-email-lessons-with-resend",
    "tool:sign-someone-up-for-an-email-course-with-resend",
    "tool:stop-an-email-course",
    "tool:work-out-where-a-learner-stands"
  ],
  "instructions": [
    "1. Pour the example word-check rows into your own rules list (see pour) or make list:word-checks; tool:check-copy reads the rows that are On.",
    "2. Write the facts row with workflow:set-up-a-business-on-trillion (it holds owner_email, used for the one test sign-up).",
    "3. Say \"Run workflow:run-a-course-from-list-rows\". It writes lessons record:lesson:five-day-start-1 to -5, checks the words, signs the owner up once with the owner's own consent, sends the lessons that are due once a day, reads where a learner stands, and stops a learner who sends the stop token.",
    "4. Read record:setup-stage:course on the checklist: Done only when every step is Done or Not applicable and no gap is open."
  ],
  "worked_examples": [
    {
      "title": "Five lessons written as rows",
      "ask": "Write the five lessons of my five-day-start course.",
      "mcp": {
        "server": "trillion",
        "tool": "run_resource_operation",
        "input": {
          "address": "@workshop-tools",
          "method": "tools:run",
          "input": {
            "tool": "tool:start-a-recipe-run",
            "input": {
              "row": "workflow:run-a-course-from-list-rows"
            }
          }
        }
      },
      "workflow": "workflow:run-a-course-from-list-rows",
      "step": "write-the-lessons",
      "given": "Read from the step in tools/workflows/recipes/workflows.json: it writes one record:lesson row per day with records:write at @own-records ({\"day\":n,\"subject\":...,\"text\":...,\"article_url\":...}), each text ending with {{unsubscribeUrl}} and {{mailingAddress}}. Synthetic subjects: \"Day 1: Flour, water, salt\", through \"Day 5: Your first sell-out Saturday\".",
      "hands_back": "{\"lessons\":[{\"id\":\"record:lesson:five-day-start-1\",\"day\":1},{\"id\":\"record:lesson:five-day-start-2\",\"day\":2},{\"id\":\"record:lesson:five-day-start-3\",\"day\":3},{\"id\":\"record:lesson:five-day-start-4\",\"day\":4},{\"id\":\"record:lesson:five-day-start-5\",\"day\":5}]}"
    }
  ],
  "pour": {
    "tool": "tool:pour-example-rows-into-my-list",
    "least_coverage": 0.8,
    "how": "Name the list you already keep for the same job and read it with records:read (its fields and row type). Run tool:pour-example-rows-into-my-list with that list as into and this kit list as kit_list: it matches each kit field to one of yours (your map, the same id, the same label, or a name in alike), pours nothing under 80% and names the fields with no home, and otherwise answers the one records:write that adds the example rows beside your own.",
    "example": {
      "kit_list": "list:business-setup-checklist",
      "into": {
        "list": "list:my-business-setup-checklist",
        "row_type": "record:setup-stage",
        "fields": [
          {
