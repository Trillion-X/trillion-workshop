    "id": "tool:request-a-connection-action",
    "label": "Ask for an action on a connection",
    "job": "Ask for an action on a connection (for example recording a status), kept as a request record for whatever owns the action to pick up",
    "description": "Give action (id, target, and optionally operation, definition_id, input_mapping: for each name a selector that reads the input, and status_mapping), input (what the action is given) and optionally correlation_id. Returns the target and payload of the request and the request_id it was kept under (connection-action-request:<correlation_id>). An action with no id or no target comes back as available false with the reason, and nothing is kept.",
    "input_schema": {
     "type": "object",
     "required": [
      "action"
     ],
     "additionalProperties": false,
     "properties": {
      "action": {
       "type": "object",
       "description": "The action: id and target, with the optional fields above"
      },
      "input": {
       "type": "object",
       "description": "What the action is given"
      },
      "correlation_id": {
       "type": "string",
       "description": "Ties the request to what asked for it; the request is kept under it"
      }
     }
    },
    "output_schema": {
     "type": "object",
     "required": [
      "available"
     ],
     "properties": {
      "available": {
       "type": "boolean"
      },
      "reason": {
       "type": "string"
      },
      "target": {
       "type": "string"
      },
      "payload": {
       "type": "object"
      },
      "request_id": {
       "type": "string"
      }
     }
