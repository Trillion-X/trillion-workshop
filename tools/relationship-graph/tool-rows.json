    "id": "tool:keep-who-is-connected",
    "label": "Keep the map of who is connected to whom",
    "job": "Keep a map of who is connected to whom, built from the connection records the person already has, as records of its own",
    "description": "Give how.record_selectors: how to read connections from the person's connection records, each with match (which records are connections) and connection {identity, endpoints [{role, value}], attributes [{name, value}]}, where a value reads the record: {\"method\": \"json-path\", \"params\": {\"path\": [\"from\"]}}, {\"method\": \"literal\", \"params\": {\"value\": ...}}, {\"method\": \"record-address\"}; a match is {\"method\": \"json-field-equals\", \"params\": {\"path\": [\"type\"], \"value\": \"introduction\"}}, \"equals\", \"exists\", \"and\" or \"include-all\". Reads every record of kind connection, keeps one graph-node record (id graph-node:<id>) for each person or company and one graph-connection record (id graph-connection:<id>) for each connection, and returns how many it kept and any record that could not be read.",
    "input_schema": {
     "type": "object",
     "required": [
      "how"
     ],
     "additionalProperties": false,
     "properties": {
      "how": {
       "type": "object",
       "required": [
        "record_selectors"
       ],
       "description": "How to read connections from the connection records"
      }
     }
    },
    "output_schema": {
     "type": "object",
     "required": [
      "node_count",
      "connection_count",
      "kept_count",
      "issues"
     ],
     "properties": {
      "node_count": {
       "type": "number"
      },
      "connection_count": {
       "type": "number"
      },
      "kept_count": {
       "type": "number"
      },
      "issues": {
       "type": "array",
       "items": {
        "type": "object"
       }
      }
     }
    },
