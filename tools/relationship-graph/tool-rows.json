     "kind": "container",
     "files": {
      "package_files": [
       {
        "package": "relationship-graph",
        "paths": [
         "do-work",
         "read-data"
        ],
        "at": "/opt/relationship-graph",
        "exclude": [
         "__tests__"
        ]
       },
       {
        "package": "records-door",
        "paths": [
         "do-work",
         "read-data"
        ],
        "at": "/opt/records-door"
       },
       {"package": "content-identity", "paths": ["read-data"], "at": "/opt/content-identity"},
       {"module": "@noble/hashes", "paths": ["LICENSE", "package.json", "blake3.js", "blake2.js", "_blake.js", "_md.js", "_u64.js", "utils.js"], "at": "/opt/node_modules/@noble/hashes"}
      ]
     },
     "workdir": "/opt/relationship-graph",
     "internet": false,
     "stdout": "json",
     "argv": [
      "node",
      "/opt/records-door/do-work/run-an-export.mjs",
      "/opt/relationship-graph/do-work/keep-who-is-connected.mjs",
      "keepWhoIsConnected"
     ],
     "stdin": {
      "fill": {
       "from": "input"
      }
     },
     "records": {
      "fd": 3,
      "rights": [
       {
        "kind": "connection",
        "operations": [
         "records:list"
        ]
       },
       {
        "kind": "graph-node",
        "prefix": "graph-node:",
        "operations": [
         "records:write"
        ]
       },
       {
        "kind": "graph-connection",
        "prefix": "graph-connection:",
        "operations": [
         "records:write"
        ]
       }
      ]
     }
    },
    "provenance": {
     "source": "bitfield-packages packages/relationship-graph: build-graph-query-request lowered the map into graph operations for the old runtime's graph slot; here the operations become records kept through the records door"
    },
    "verify": [
