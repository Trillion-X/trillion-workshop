           "params": {
            "path": [
             "type"
            ],
            "value": "introduction"
           }
          },
          "connection": {
           "identity": {
            "method": "json-path",
            "params": {
             "path": [
              "id"
             ]
            }
           },
           "endpoints": [
            {
             "role": "introducer",
             "value": {
              "method": "json-path",
              "params": {
               "path": [
                "by"
               ]
              }
             }
            },
            {
             "role": "introduced",
             "value": {
              "method": "json-path",
              "params": {
               "path": [
                "to"
               ]
              }
             }
            }
           ],
           "attributes": [
            {
             "name": "at",
             "value": {
              "method": "json-path",
              "params": {
               "path": [
                "at"
               ]
              }
             }
            }
           ]
          }
         }
        ]
       }
      },
      "output_selector": "$.kept_count",
      "contains": "0"
     }
    ],
    "result_selector": "$.result"
   }
