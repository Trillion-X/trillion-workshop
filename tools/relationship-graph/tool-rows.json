{
 "kind": "tool-rows",
 "record_set": "relationship-graph-tool-rows",
 "what_this_is": "The Workshop rows for the tools in tools/relationship-graph: what each tool does, what it takes and gives back, and how it runs.",
 "records": [
  {
   "id": "package::relationship-graph::tool::map-who-is-connected",
