{
  "name": "trillion-workshop",
  "description": "The open-source tools Trillion offers to every person's AI: one folder per tool, with its code, rows and tests.",
  "license": "Apache-2.0",
  "type": "module",
  "imports": {
    "#tools/*": "./tools/*"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Trillion-X/trillion-workshop.git"
  },
  "engines": {
    "node": ">=22.6"
  },
  "exports": {
    "./package.json": "./package.json",
    "./licence-classes.json": "./licence-classes.json",
    "./tools/*": "./tools/*",
    "./test-helpers/python-environment.mjs": "./test-helpers/python-environment.mjs",
    "./test-helpers/passkey-account.mjs": "./test-helpers/passkey-account.mjs",
    "./test-helpers/import-source-for-tests.mjs": "./test-helpers/import-source-for-tests.mjs",
    "./test-helpers/sign-in-methods.json": "./test-helpers/sign-in-methods.json"
  },
  "files": [
    "tools",
    "licence-classes.json",
    "LICENSE",
    "README.md",
    "test-helpers/passkey-account.mjs",
    "test-helpers/import-source-for-tests.mjs",
    "test-helpers/chromium.mjs",
    "test-helpers/customer-signup-observation.mjs",
    "test-helpers/sign-in-methods.json",
    "test-helpers/workshop-self-resolve.mjs",
    "test-helpers/python-*"
  ],
  "scripts": {
    "test": "node --import ./test-helpers/own-tmpdir.mjs --test --test-force-exit 'test/**/*.test.mjs' 'test/**/*.test.ts' 'tools/**/*.test.mjs' 'tools/**/*.test.ts'",
    "check-kits": "node test-helpers/every-item-kit.mjs",
    "catalogue": "node test-helpers/write-tool-catalogue.mjs"
  },
  "dependencies": {
    "@babel/parser": "7.28.5",
    "@base-ui/react": "1.8.0",
    "@cloudflare/puppeteer": "1.4.0",
    "@electric-sql/pglite": "0.5.9",
    "@floating-ui/dom": "1.8.0",
    "@noble/ciphers": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@opencoredev/social-sdk": "0.5.0",
    "@passwordless-id/webauthn": "2.4.0",
    "@radix-ui/react-popover": "1.1.21",
    "@radix-ui/react-tooltip": "1.2.14",
    "@sqlite.org/sqlite-wasm": "3.53.4-build2",
    "@tailwindcss/node": "4.2.4",
    "@tanstack/react-virtual": "3.14.8",
    "@whiskeysockets/baileys": "7.0.0-rc14",
    "ajv": "^8.20.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "diff": "8.0.4",
    "esbuild": "^0.28.2",
    "fflate": "0.8.2",
    "framer-motion": "14.1.0",
    "grapesjs": "0.23.6",
    "hls.js": "1.6.13",
    "libheif-js": "1.23.2",
    "lucide-react": "1.26.0",
    "marked": "^18.0.14",
    "pdfjs-dist": "6.3.289",
    "playwright": "1.63.0",
    "playwright-core": "^1.63.0",
    "pngjs": "^7.0.0",
    "postal-mime": "4.0.0",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "react-dropzone": "14.3.8",
    "shiki": "^4.6.0",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "4.2.4",
    "tldts": "7.4.19",
    "undici": "7.29.0",
    "uqr": "0.1.3",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "esprima": "4.0.1",
    "miniflare": "5.20260925.0-alpha",
    "typescript": "5.9.3"
  },
  "peerDependencies": {
    "@whiskeysockets/baileys": "^7.0.0-rc13"
  },
  "peerDependenciesMeta": {
    "@whiskeysockets/baileys": {
      "optional": true
    }
  }
}
