{
  "name": "trillion-workshop",
  "description": "The open-source tools Trillion offers to every person's AI: one folder per tool, with its code, rows and tests.",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/Trillion-X/trillion-workshop.git"
  },
  "engines": {
    "node": ">=22.6"
  },
  "exports": {
    "./package.json": "./package.json",
    "./licence-classes.json": "./licence-classes.json",
    "./tools/*": "./tools/*"
  },
  "files": [
    "tools",
    "licence-classes.json",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "test": "node --test 'test/**/*.test.mjs' 'tools/**/*.test.mjs' 'tools/**/*.test.ts'"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.9",
    "@noble/ciphers": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@opencoredev/social-sdk": "0.5.0",
    "esbuild": "^0.28.2",
    "fflate": "0.8.2",
    "marked": "^18.0.14",
    "uqr": "0.1.3"
  },
  "devDependencies": {
    "playwright": "1.63.0"
  },
  "peerDependencies": {
    "@whiskeysockets/baileys": "^7.0.0-rc13"
  },
  "peerDependenciesMeta": {
    "@whiskeysockets/baileys": {
      "optional": true
    }
  }
}
